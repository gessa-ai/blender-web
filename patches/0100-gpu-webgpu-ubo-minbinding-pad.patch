     return false;
   }
+  const size_t alloc = std::max(size_in_bytes_, kUboMinBindingPad);
   return buffer_.create(ctx->device_get(),
                         webgpu::BufferKind::Uniform,
                         webgpu::UsageType::Dynamic,
-                        size_in_bytes_,
+                        alloc,
                         nullptr,
                         false);
