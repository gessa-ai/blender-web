+static std::atomic<int> g_web_split_phase{int(WebSplitSchedulerPhase::Bootstrap)};
+static std::atomic<uint32_t> g_web_split_request_generation{0};
+static std::atomic<uint32_t> g_web_split_park_request_generation{0};
+static std::atomic<uint32_t> g_web_split_parked_generation{0};
+static std::atomic<uint32_t> g_web_split_prepared_request_generation{0};
+static std::atomic<uint32_t> g_web_split_prepared_generation{0};
+static std::atomic<uint32_t> g_web_split_apply_request_generation{0};
+static std::atomic<uint32_t> g_web_split_applied_generation{0};
+static std::atomic<uint32_t> g_web_split_page_ready_request_generation{0};
+static std::atomic<uint32_t> g_web_split_page_ready_generation{0};
+static std::atomic<uint32_t> g_web_split_resume_request_generation{0};
+static std::atomic<uint32_t> g_web_split_resumed_generation{0};
+static std::atomic<uint32_t> g_web_split_error_generation{0};
+static std::atomic<uint32_t> g_web_split_offending_generation{0};
+static std::atomic<int> g_web_split_error_code{int(WebSplitSchedulerError::None)};
+static std::atomic<int> g_web_split_target_threads{0};
+static std::atomic<int> g_web_split_active_threads{1};
+static std::atomic<int> g_web_split_openexr_threads{0};
+static std::atomic<int> g_web_split_oiio_threads{1};
+/* Preserve the exact image-policy attempt and rollback observations. The
+ * current-value fields above intentionally follow rollback, so they cannot by
+ * themselves explain an APPLY failure. */
+static std::atomic<int> g_web_split_apply_openexr_set{-1};
+static std::atomic<int> g_web_split_apply_openexr_threads{-1};
+static std::atomic<int> g_web_split_apply_oiio_set{-1};
+static std::atomic<int> g_web_split_apply_oiio_threads{-1};
+static std::atomic<int> g_web_split_rollback_openexr_set{-1};
+static std::atomic<int> g_web_split_rollback_openexr_threads{-1};
+static std::atomic<int> g_web_split_rollback_oiio_set{-1};
+static std::atomic<int> g_web_split_rollback_oiio_threads{-1};
+static std::atomic<int> g_web_split_reload_required{0};
+static std::atomic<int> g_web_split_prepared_workers{0};
+static std::atomic<int> g_web_split_prepared_acknowledgements{0};
+static std::atomic<int> g_web_split_prepared_instances{0};
+static std::atomic<int> g_web_split_prepared_local_instances{0};
+static std::atomic<int> g_web_split_prepared_pending{0};
+static std::atomic<int> g_web_split_prepared_protocol_errors{0};
+static std::atomic<uint32_t> g_web_split_prepared_stabilization_epoch{0};
+static std::atomic<int> g_web_split_page_ready_workers{0};
+static std::atomic<int> g_web_split_page_ready_acknowledgements{0};
+static std::atomic<int> g_web_split_page_ready_instances{0};
+static std::atomic<int> g_web_split_page_ready_local_instances{0};
+static std::atomic<int> g_web_split_page_ready_pending{0};
+static std::atomic<int> g_web_split_page_ready_protocol_errors{0};
+static std::atomic<int> g_web_split_page_ready_late_workers{0};
+static std::atomic<uint32_t> g_web_split_page_ready_stabilization_epoch{0};
+
+static int wm_web_split_fail(const uint32_t generation, const WebSplitSchedulerError error)
+{
+  g_web_split_offending_generation.store(generation, std::memory_order_relaxed);
+  g_web_split_error_code.store(int(error), std::memory_order_relaxed);
+  g_web_split_phase.store(int(WebSplitSchedulerPhase::Error), std::memory_order_relaxed);
+  const uint32_t transaction_generation = g_web_split_request_generation.load(
+      std::memory_order_acquire);
+  /* The terminal error generation is the phase ACK and must be the last write. */
+  g_web_split_error_generation.store(transaction_generation != 0 ? transaction_generation :
+                                                                  generation,
+                                     std::memory_order_release);
+  return -int(error);
+}
+
+static WebSplitSchedulerPhase wm_web_split_phase_get()
+{
+  return WebSplitSchedulerPhase(g_web_split_phase.load(std::memory_order_acquire));
+}
+
+static bool wm_web_split_worker_payload_valid(const int workers,
+                                              const int acknowledgements,
+                                              const int instances,
+                                              const int local_instances,
+                                              const int pending,
+                                              const int protocol_errors)
+{
+  return ::wm_web_split_worker_payload_valid(
+      {workers, acknowledgements, instances, local_instances, pending, protocol_errors});
+}
+
+static void wm_web_split_publish_step(const WebSplitControlStepResult &result)
+{
+  wm_web_split_publish_control_step(
+      result,
+      [](const WebSplitControlStepResult &published) {
+        if (published.reload_required) {
+          g_web_split_reload_required.store(1, std::memory_order_relaxed);
+        }
+        if (published.terminal) {
+          g_web_split_offending_generation.store(published.generation, std::memory_order_relaxed);
+          g_web_split_error_code.store(int(published.error), std::memory_order_relaxed);
+        }
+        g_web_split_phase.store(int(published.phase), std::memory_order_relaxed);
+      },
+      [&result](const uint32_t generation) {
+        switch (result.phase) {
+          case WebSplitSchedulerPhase::Parked:
+            g_web_split_parked_generation.store(generation, std::memory_order_release);
+            break;
+          case WebSplitSchedulerPhase::Prepared:
+            g_web_split_prepared_generation.store(generation, std::memory_order_release);
+            break;
+          case WebSplitSchedulerPhase::Applied:
+            g_web_split_applied_generation.store(generation, std::memory_order_release);
+            break;
+          case WebSplitSchedulerPhase::PageReady:
+            g_web_split_page_ready_generation.store(generation, std::memory_order_release);
+            break;
+          case WebSplitSchedulerPhase::Resumed:
+            g_web_split_resumed_generation.store(generation, std::memory_order_release);
+            break;
+          case WebSplitSchedulerPhase::Error:
+            g_web_split_error_generation.store(generation, std::memory_order_release);
+            break;
+          default:
+            BLI_assert_unreachable();
+        }
+      });
+}
+
+static bool wm_web_split_control_tick(bContext *C)
+{
+  const WebSplitSchedulerPhase phase = wm_web_split_phase_get();
+  switch (phase) {
+    case WebSplitSchedulerPhase::ParkRequested: {
+      const uint32_t generation = g_web_split_park_request_generation.load(
+          std::memory_order_acquire);
+      wmWindowManager *wm = CTX_wm_manager(C);
+      const bool jobs_running = wm == nullptr || WM_jobs_has_running(wm);
+      const bool scheduler_valid = BLI_task_scheduler_num_threads() == 1 &&
+                                   BLI_task_scheduler_active_threads() == 1 &&
+                                   BLI_system_num_threads_override_get() == 1;
+      if (jobs_running || !scheduler_valid) {
+        wm_web_split_publish_step(wm_web_split_control_step_reduce(
+            {phase, generation, jobs_running, scheduler_valid, true, true, {true, true, true, true, true}}));
+        return true;
+      }
+      const IMBWebThreadPolicyStatus bootstrap_image = IMB_web_thread_policy_apply(0, 1);
+      g_web_split_openexr_threads.store(bootstrap_image.openexr_threads,
+                                        std::memory_order_relaxed);
+      g_web_split_oiio_threads.store(bootstrap_image.oiio_threads, std::memory_order_relaxed);
+      const bool image_valid = bootstrap_image.openexr_set &&
+                               bootstrap_image.openexr_threads == 0 && bootstrap_image.oiio_set &&
+                               bootstrap_image.oiio_threads == 1;
+      wm_web_split_publish_step(wm_web_split_control_step_reduce(
+          {phase, generation, false, true, image_valid, true, {true, true, true, true, true}}));
+      return true;
+    }
+    case WebSplitSchedulerPhase::PreparedRequested: {
+      const uint32_t generation = g_web_split_prepared_request_generation.load(
+          std::memory_order_acquire);
+      wm_web_split_publish_step(wm_web_split_control_step_reduce(
+          {phase, generation, false, true, true, true, {true, true, true, true, true}}));
+      return true;
+    }
+    case WebSplitSchedulerPhase::ApplyRequested: {
+      const uint32_t generation = g_web_split_apply_request_generation.load(
+          std::memory_order_acquire);
+      const int target_threads = g_web_split_target_threads.load(std::memory_order_acquire);
+      if (!BLI_task_scheduler_reconfigure(target_threads)) {
+        const bool rollback_ok = BLI_task_scheduler_num_threads() == 1 &&
+                                 BLI_task_scheduler_active_threads() == 1 &&
+                                 BLI_system_num_threads_override_get() == 1;
+        wm_web_split_publish_step(wm_web_split_control_step_reduce(
+            {phase, generation, false, true, true, true, {false, false, rollback_ok, true, true}}));
+        return true;
+      }
+
+      const IMBWebThreadPolicyStatus image_status = IMB_web_thread_policy_apply(target_threads,
+                                                                                target_threads);
+      g_web_split_apply_openexr_set.store(image_status.openexr_set ? 1 : 0,
+                                           std::memory_order_relaxed);
+      g_web_split_apply_openexr_threads.store(image_status.openexr_threads,
+                                               std::memory_order_relaxed);
+      g_web_split_apply_oiio_set.store(image_status.oiio_set ? 1 : 0,
+                                       std::memory_order_relaxed);
+      g_web_split_apply_oiio_threads.store(image_status.oiio_threads,
+                                           std::memory_order_relaxed);
+      g_web_split_openexr_threads.store(image_status.openexr_threads, std::memory_order_relaxed);
+      g_web_split_oiio_threads.store(image_status.oiio_threads, std::memory_order_relaxed);
+      if (!image_status.openexr_set || image_status.openexr_threads != target_threads ||
+          !image_status.oiio_set || image_status.oiio_threads != target_threads)
+      {
+        const IMBWebThreadPolicyStatus image_rollback = IMB_web_thread_policy_apply(0, 1);
+        g_web_split_rollback_openexr_set.store(image_rollback.openexr_set ? 1 : 0,
+                                                std::memory_order_relaxed);
+        g_web_split_rollback_openexr_threads.store(image_rollback.openexr_threads,
+                                                    std::memory_order_relaxed);
+        g_web_split_rollback_oiio_set.store(image_rollback.oiio_set ? 1 : 0,
+                                            std::memory_order_relaxed);
+        g_web_split_rollback_oiio_threads.store(image_rollback.oiio_threads,
+                                                std::memory_order_relaxed);
+        const bool scheduler_rollback = BLI_task_scheduler_reconfigure(1);
+        g_web_split_openexr_threads.store(image_rollback.openexr_threads,
+                                          std::memory_order_relaxed);
+        g_web_split_oiio_threads.store(image_rollback.oiio_threads, std::memory_order_relaxed);
+        if (!image_rollback.openexr_set || image_rollback.openexr_threads != 0 ||
+            !image_rollback.oiio_set || image_rollback.oiio_threads != 1 ||
+            !scheduler_rollback || BLI_task_scheduler_num_threads() != 1 ||
+            BLI_task_scheduler_active_threads() != 1 ||
+            BLI_system_num_threads_override_get() != 1)
+        {
+          wm_web_split_publish_step(wm_web_split_control_step_reduce(
+              {phase, generation, false, true, true, true, {true, false, false, false, true}}));
+          return true;
+        }
+        wm_web_split_publish_step(wm_web_split_control_step_reduce(
+            {phase, generation, false, true, true, true, {true, false, true, true, true}}));
+        return true;
+      }
+      if (BLI_task_scheduler_num_threads() != target_threads ||
+          BLI_task_scheduler_active_threads() != target_threads ||
+          BLI_system_num_threads_override_get() != target_threads)
+      {
+        wm_web_split_publish_step(wm_web_split_control_step_reduce(
+            {phase, generation, false, true, true, false, {true, true, true, true, true}}));
+        return true;
+      }
+      if (!BLI_task_scheduler_web_split_mark_ready()) {
+        /* The ready bit is one-way. A failed transition cannot be rolled back
+         * faithfully and requires a fresh process before any input resumes. */
+        g_web_split_active_threads.store(BLI_task_scheduler_active_threads(),
+                                         std::memory_order_relaxed);
+        wm_web_split_publish_step(wm_web_split_control_step_reduce(
+            {phase, generation, false, true, true, true, {true, true, true, true, false}}));
+        return true;
+      }
+
+      g_web_split_active_threads.store(BLI_task_scheduler_active_threads(),
+                                       std::memory_order_relaxed);
+      const WebSplitApplyResult reduced = wm_web_split_apply_reduce(
+          generation, {true, true, true, true, true});
+      BLI_assert(reduced.error == WebSplitSchedulerError::None &&
+                 reduced.applied_generation == generation);
+      wm_web_split_publish_step(wm_web_split_control_step_reduce(
+          {phase, generation, false, true, true, true, {true, true, true, true, true}}));
+      return true;
+    }
+    case WebSplitSchedulerPhase::PageReadyRequested: {
+      const uint32_t generation = g_web_split_page_ready_request_generation.load(
+          std::memory_order_acquire);
+      wm_web_split_publish_step(wm_web_split_control_step_reduce(
+          {phase, generation, false, true, true, true, {true, true, true, true, true}}));
+      return true;
+    }
+    case WebSplitSchedulerPhase::ResumeRequested: {
+      const uint32_t generation = g_web_split_resume_request_generation.load(
+          std::memory_order_acquire);
+      wm_web_split_publish_step(wm_web_split_control_step_reduce(
+          {phase, generation, false, true, true, true, {true, true, true, true, true}}));
+      return true;
+    }
+    case WebSplitSchedulerPhase::Parked:
+    case WebSplitSchedulerPhase::Prepared:
+    case WebSplitSchedulerPhase::Applied:
+    case WebSplitSchedulerPhase::PageReady:
+    case WebSplitSchedulerPhase::Error:
+      return true;
+    case WebSplitSchedulerPhase::Bootstrap:
+    case WebSplitSchedulerPhase::Resumed:
+      return false;
+  }
+  return true;
+}
+
+}  // namespace
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE int BW_web_split_request_park(const uint32_t generation)
+{
+  const WebSplitSchedulerError validation = wm_web_split_validate_park(
+      wm_web_split_phase_get(),
+      generation,
+      g_web_split_request_generation.load(std::memory_order_acquire));
+  if (validation != WebSplitSchedulerError::None) {
+    return wm_web_split_fail(generation, validation);
+  }
+  g_web_split_request_generation.store(generation, std::memory_order_relaxed);
+  g_web_split_park_request_generation.store(generation, std::memory_order_relaxed);
+  g_web_split_phase.store(int(WebSplitSchedulerPhase::ParkRequested), std::memory_order_release);
+  return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int BW_web_split_request_apply(const uint32_t generation,
+                                                    const int target_threads)
+{
+  const WebSplitSchedulerError validation = wm_web_split_validate_apply(
+      wm_web_split_phase_get(),
+      generation,
+      g_web_split_request_generation.load(std::memory_order_acquire),
+      g_web_split_prepared_generation.load(std::memory_order_acquire),
+      target_threads);
+  if (validation != WebSplitSchedulerError::None) {
+    return wm_web_split_fail(generation, validation);
+  }
+  g_web_split_target_threads.store(target_threads, std::memory_order_relaxed);
+  g_web_split_apply_request_generation.store(generation, std::memory_order_relaxed);
+  g_web_split_phase.store(int(WebSplitSchedulerPhase::ApplyRequested),
+                          std::memory_order_release);
+  return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int BW_web_split_request_prepared(const uint32_t generation,
+                                                       const int workers,
+                                                       const int acknowledgements,
+                                                       const int instances,
+                                                       const int local_instances,
+                                                       const int pending,
+                                                       const int protocol_errors,
+                                                       const uint32_t stabilization_epoch)
+{
+  const WebSplitSchedulerError validation = wm_web_split_validate_prepared(
+      wm_web_split_phase_get(),
+      generation,
+      g_web_split_request_generation.load(std::memory_order_acquire),
+      g_web_split_parked_generation.load(std::memory_order_acquire),
+      {workers, acknowledgements, instances, local_instances, pending, protocol_errors},
+      stabilization_epoch);
+  if (validation != WebSplitSchedulerError::None) {
+    return wm_web_split_fail(generation, validation);
+  }
+  g_web_split_prepared_workers.store(workers, std::memory_order_relaxed);
+  g_web_split_prepared_acknowledgements.store(acknowledgements, std::memory_order_relaxed);
+  g_web_split_prepared_instances.store(instances, std::memory_order_relaxed);
+  g_web_split_prepared_local_instances.store(local_instances, std::memory_order_relaxed);
+  g_web_split_prepared_pending.store(pending, std::memory_order_relaxed);
+  g_web_split_prepared_protocol_errors.store(protocol_errors, std::memory_order_relaxed);
+  g_web_split_prepared_stabilization_epoch.store(stabilization_epoch,
+                                                  std::memory_order_relaxed);
+  g_web_split_prepared_request_generation.store(generation, std::memory_order_relaxed);
+  g_web_split_phase.store(int(WebSplitSchedulerPhase::PreparedRequested),
+                          std::memory_order_release);
+  return 1;
+}
+
+EMSCRIPTEN_KEEPALIVE int BW_web_split_request_page_ready(const uint32_t generation,
+                                                         const int workers,
+                                                         const int acknowledgements,
+                                                         const int instances,
+                                                         const int local_instances,
+                                                         const int pending,
+                                                         const int protocol_errors,
+                                                         const int late_workers,
+                                                         const uint32_t stabilization_epoch)
+{
+  const WebSplitSchedulerError validation = wm_web_split_validate_page_ready(
+      wm_web_split_phase_get(),
+      generation,
+      g_web_split_request_generation.load(std::memory_order_acquire),
+      g_web_split_applied_generation.load(std::memory_order_acquire),
+      {workers, acknowledgements, instances, local_instances, pending, protocol_errors},
+      g_web_split_prepared_workers.load(std::memory_order_acquire),
+      late_workers,
+      g_web_split_prepared_stabilization_epoch.load(std::memory_order_acquire),
+      stabilization_epoch);
+  if (validation != WebSplitSchedulerError::None) {
+    return wm_web_split_fail(generation, validation);
+  }
+  g_web_split_page_ready_workers.store(workers, std::memory_order_relaxed);
+  g_web_split_page_ready_acknowledgements.store(acknowledgements, std::memory_order_relaxed);
+  g_web_split_page_ready_instances.store(instances, std::memory_order_relaxed);
+  g_web_split_page_ready_local_instances.store(local_instances, std::memory_order_relaxed);
