+bool WGPUFrameBuffer::submit_scissored_color_clear(
+    const GPUAttachment &attachment,
+    int force_layer,
+    const double4 &clear_value,
+    const webgpu::FramebufferClearPlan &plan)
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr || attachment.tex == nullptr || plan.width == 0 || plan.height == 0) {
+    return false;
+  }
+  webgpu::WGPUTexture *texture = as_wgpu(attachment.tex);
+  wgpu::TextureView view = attachment_view(attachment, force_layer);
+  if (view == nullptr || !texture->subresource_range().valid()) {
+    return false;
+  }
+
+  const GPUTextureFormatFlag format_flags = attachment.tex->format_flag_get();
+  const webgpu::FramebufferClearShaderType shader_type =
+      webgpu::framebuffer_clear_color_shader_type(bool(format_flags & GPU_FORMAT_INTEGER),
+                                                  bool(format_flags & GPU_FORMAT_SIGNED));
+  wgpu::ShaderModule *module = nullptr;
+  switch (shader_type) {
+    case webgpu::FramebufferClearShaderType::Uint:
+      module = &scissored_clear_uint_module_;
+      break;
+    case webgpu::FramebufferClearShaderType::Sint:
+      module = &scissored_clear_sint_module_;
+      break;
+    case webgpu::FramebufferClearShaderType::Float:
+      module = &scissored_clear_float_module_;
+      break;
+    case webgpu::FramebufferClearShaderType::Depth:
+      return false;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  if (*module == nullptr) {
+    wgpu::ShaderSourceWGSL source = {};
+    source.code = webgpu::framebuffer_clear_shader_source(shader_type);
+    wgpu::ShaderModuleDescriptor descriptor = {};
+    descriptor.nextInChain = &source;
+    *module = device.CreateShaderModule(&descriptor);
+  }
+  if (*module == nullptr) {
+    return false;
+  }
+
+  const wgpu::TextureFormat format = texture->wgpu_format();
+  const uint32_t sample_count = texture->subresource_range().texture.GetSampleCount();
+  if (format == wgpu::TextureFormat::Undefined || sample_count == 0) {
+    return false;
+  }
+  const uint64_t pipeline_key = uint64_t(uint32_t(format)) | (uint64_t(sample_count) << 32);
+  wgpu::RenderPipeline pipeline;
+  const auto found = scissored_color_clear_pipelines_.find(pipeline_key);
+  if (found != scissored_color_clear_pipelines_.end()) {
+    pipeline = found->second;
+  }
+  else {
+    wgpu::ColorTargetState target = {};
+    target.format = format;
+    target.writeMask = wgpu::ColorWriteMask::All;
+    wgpu::FragmentState fragment = {};
+    fragment.module = *module;
+    fragment.entryPoint = "fs_main";
+    fragment.targetCount = 1;
+    fragment.targets = &target;
+    wgpu::RenderPipelineDescriptor descriptor = {};
+    descriptor.layout = nullptr;
+    descriptor.vertex.module = *module;
+    descriptor.vertex.entryPoint = "vs_main";
+    descriptor.primitive.topology = wgpu::PrimitiveTopology::TriangleList;
+    descriptor.multisample.count = sample_count;
+    descriptor.fragment = &fragment;
+    pipeline = device.CreateRenderPipeline(&descriptor);
+    scissored_color_clear_pipelines_[pipeline_key] = pipeline;
+  }
+  if (pipeline == nullptr) {
+    return false;
+  }
+
+  uint32_t clear_payload[4] = {};
+  if (shader_type == webgpu::FramebufferClearShaderType::Uint) {
+    for (int component = 0; component < 4; component++) {
+      clear_payload[component] = uint32_t(clear_value[component]);
+    }
+  }
+  else if (shader_type == webgpu::FramebufferClearShaderType::Sint) {
+    int32_t signed_payload[4];
+    for (int component = 0; component < 4; component++) {
+      signed_payload[component] = int32_t(clear_value[component]);
+    }
+    std::memcpy(clear_payload, signed_payload, sizeof(clear_payload));
+  }
+  else {
+    float float_payload[4];
+    for (int component = 0; component < 4; component++) {
+      float_payload[component] = float(clear_value[component]);
+    }
+    std::memcpy(clear_payload, float_payload, sizeof(clear_payload));
+  }
+
+  wgpu::BufferDescriptor uniform_descriptor = {};
+  uniform_descriptor.size = sizeof(clear_payload);
+  uniform_descriptor.usage = wgpu::BufferUsage::Uniform;
+  uniform_descriptor.mappedAtCreation = true;
+  wgpu::Buffer uniform = device.CreateBuffer(&uniform_descriptor);
+  if (uniform == nullptr) {
+    return false;
+  }
+  void *mapped = uniform.GetMappedRange(0, sizeof(clear_payload));
+  if (mapped == nullptr) {
+    uniform.Unmap();
+    return false;
+  }
+  std::memcpy(mapped, clear_payload, sizeof(clear_payload));
+  uniform.Unmap();
+
+  wgpu::BindGroupEntry entry = {};
+  entry.binding = 0;
+  entry.buffer = uniform;
+  entry.offset = 0;
+  entry.size = sizeof(clear_payload);
+  wgpu::BindGroupDescriptor bind_descriptor = {};
+  bind_descriptor.layout = pipeline.GetBindGroupLayout(0);
+  bind_descriptor.entryCount = 1;
+  bind_descriptor.entries = &entry;
+  wgpu::BindGroup bind_group = device.CreateBindGroup(&bind_descriptor);
+  if (bind_group == nullptr) {
+    return false;
+  }
+
+  wgpu::RenderPassColorAttachment color = {};
+  color.view = view;
+  color.depthSlice = attachment_depth_slice(attachment, force_layer);
+  color.loadOp = wgpu::LoadOp::Load;
+  color.storeOp = wgpu::StoreOp::Store;
+  color.clearValue = {0.0, 0.0, 0.0, 0.0};
+  wgpu::RenderPassDescriptor pass_descriptor = {};
+  pass_descriptor.colorAttachmentCount = 1;
+  pass_descriptor.colorAttachments = &color;
+  wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+  wgpu::RenderPassEncoder pass = encoder.BeginRenderPass(&pass_descriptor);
+  pass.SetPipeline(pipeline);
+  pass.SetScissorRect(plan.x, plan.y, plan.width, plan.height);
+  pass.SetBindGroup(0, bind_group);
+  pass.Draw(3, 1, 0, 0);
+  pass.End();
+  wgpu::CommandBuffer command = encoder.Finish();
+  ctx->queue_get().Submit(1, &command);
+  return true;
+}
+
+bool WGPUFrameBuffer::submit_scissored_depth_stencil_clear(
+    const GPUAttachment &attachment,
+    int force_layer,
+    bool clear_depth,
+    float clear_depth_value,
+    bool clear_stencil,
+    uint clear_stencil_value,
+    const webgpu::FramebufferClearPlan &plan)
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr || attachment.tex == nullptr || (!clear_depth && !clear_stencil) ||
+      plan.width == 0 || plan.height == 0)
+  {
+    return false;
+  }
+  webgpu::WGPUTexture *texture = as_wgpu(attachment.tex);
+  wgpu::TextureView view = attachment_view(attachment, force_layer);
+  if (view == nullptr || !texture->subresource_range().valid()) {
+    return false;
+  }
+  const wgpu::TextureFormat format = texture->wgpu_format();
+  const bool combined = ELEM(format,
+                             wgpu::TextureFormat::Depth24PlusStencil8,
+                             wgpu::TextureFormat::Depth32FloatStencil8);
+  if (clear_stencil && !combined) {
+    return false;
+  }
+  const uint32_t sample_count = texture->subresource_range().texture.GetSampleCount();
+  if (format == wgpu::TextureFormat::Undefined || sample_count == 0) {
+    return false;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  if (scissored_clear_depth_module_ == nullptr) {
+    wgpu::ShaderSourceWGSL source = {};
+    source.code = webgpu::framebuffer_clear_shader_source(
+        webgpu::FramebufferClearShaderType::Depth);
+    wgpu::ShaderModuleDescriptor descriptor = {};
+    descriptor.nextInChain = &source;
+    scissored_clear_depth_module_ = device.CreateShaderModule(&descriptor);
+  }
+  if (scissored_clear_depth_module_ == nullptr) {
+    return false;
+  }
+
+  const uint64_t pipeline_key = uint64_t(uint32_t(format)) | (uint64_t(sample_count) << 32) |
+                                (uint64_t(clear_depth ? 1u : 0u) << 48) |
+                                (uint64_t(clear_stencil ? 1u : 0u) << 49);
+  wgpu::RenderPipeline pipeline;
+  const auto found = scissored_depth_clear_pipelines_.find(pipeline_key);
+  if (found != scissored_depth_clear_pipelines_.end()) {
+    pipeline = found->second;
+  }
+  else {
+    wgpu::FragmentState fragment = {};
+    fragment.module = scissored_clear_depth_module_;
+    fragment.entryPoint = "fs_main";
+    wgpu::DepthStencilState depth_stencil = {};
+    depth_stencil.format = format;
+    depth_stencil.depthWriteEnabled = clear_depth ? wgpu::OptionalBool::True :
+                                                   wgpu::OptionalBool::False;
+    depth_stencil.depthCompare = wgpu::CompareFunction::Always;
+    if (combined) {
+      depth_stencil.stencilFront.compare = wgpu::CompareFunction::Always;
+      depth_stencil.stencilFront.failOp = wgpu::StencilOperation::Keep;
+      depth_stencil.stencilFront.depthFailOp = clear_stencil ?
+                                                   wgpu::StencilOperation::Replace :
+                                                   wgpu::StencilOperation::Keep;
+      depth_stencil.stencilFront.passOp = clear_stencil ? wgpu::StencilOperation::Replace :
+                                                         wgpu::StencilOperation::Keep;
+      depth_stencil.stencilBack = depth_stencil.stencilFront;
+      depth_stencil.stencilReadMask = 0xffu;
+      depth_stencil.stencilWriteMask = clear_stencil ? 0xffu : 0u;
+    }
+    wgpu::RenderPipelineDescriptor descriptor = {};
+    descriptor.layout = nullptr;
+    descriptor.vertex.module = scissored_clear_depth_module_;
+    descriptor.vertex.entryPoint = "vs_main";
+    descriptor.primitive.topology = wgpu::PrimitiveTopology::TriangleList;
+    descriptor.multisample.count = sample_count;
+    descriptor.fragment = &fragment;
+    descriptor.depthStencil = &depth_stencil;
+    pipeline = device.CreateRenderPipeline(&descriptor);
+    scissored_depth_clear_pipelines_[pipeline_key] = pipeline;
+  }
+  if (pipeline == nullptr) {
+    return false;
+  }
+
+  const float depth_payload[4] = {
+      std::isfinite(clear_depth_value) ? clear_depth_value : 1.0f, 0.0f, 0.0f, 0.0f};
+  wgpu::BufferDescriptor uniform_descriptor = {};
+  uniform_descriptor.size = sizeof(depth_payload);
+  uniform_descriptor.usage = wgpu::BufferUsage::Uniform;
+  uniform_descriptor.mappedAtCreation = true;
+  wgpu::Buffer uniform = device.CreateBuffer(&uniform_descriptor);
+  if (uniform == nullptr) {
+    return false;
+  }
+  void *mapped = uniform.GetMappedRange(0, sizeof(depth_payload));
+  if (mapped == nullptr) {
+    uniform.Unmap();
+    return false;
+  }
+  std::memcpy(mapped, depth_payload, sizeof(depth_payload));
+  uniform.Unmap();
+
+  wgpu::BindGroupEntry entry = {};
+  entry.binding = 0;
+  entry.buffer = uniform;
+  entry.offset = 0;
+  entry.size = sizeof(depth_payload);
+  wgpu::BindGroupDescriptor bind_descriptor = {};
+  bind_descriptor.layout = pipeline.GetBindGroupLayout(0);
+  bind_descriptor.entryCount = 1;
+  bind_descriptor.entries = &entry;
+  wgpu::BindGroup bind_group = device.CreateBindGroup(&bind_descriptor);
+  if (bind_group == nullptr) {
+    return false;
+  }
+
+  wgpu::RenderPassDepthStencilAttachment depth_stencil = {};
+  depth_stencil.view = view;
+  depth_stencil.depthLoadOp = wgpu::LoadOp::Load;
+  depth_stencil.depthStoreOp = wgpu::StoreOp::Store;
+  depth_stencil.depthClearValue = 1.0f;
+  if (combined) {
+    depth_stencil.stencilLoadOp = wgpu::LoadOp::Load;
+    depth_stencil.stencilStoreOp = wgpu::StoreOp::Store;
+    depth_stencil.stencilClearValue = 0u;
+  }
+  wgpu::RenderPassDescriptor pass_descriptor = {};
+  pass_descriptor.depthStencilAttachment = &depth_stencil;
+  wgpu::CommandEncoder encoder = device.CreateCommandEncoder();
+  wgpu::RenderPassEncoder pass = encoder.BeginRenderPass(&pass_descriptor);
+  pass.SetPipeline(pipeline);
+  pass.SetScissorRect(plan.x, plan.y, plan.width, plan.height);
+  pass.SetBindGroup(0, bind_group);
+  if (clear_stencil) {
+    pass.SetStencilReference(clear_stencil_value);
+  }
+  pass.Draw(3, 1, 0, 0);
+  pass.End();
+  wgpu::CommandBuffer command = encoder.Finish();
+  ctx->queue_get().Submit(1, &command);
+  return true;
+}
+
+void WGPUFrameBuffer::submit_scissored_clear(GPUFrameBufferBits buffers,
+                                              Span<double4> colors,
+                                              float clear_depth,
+                                              uint clear_stencil,
+                                              const webgpu::FramebufferClearPlan &plan)
+{
+  uint32_t pass_count = 1;
+  for (int index = 0; index < GPU_FB_MAX_ATTACHMENT; index++) {
+    const GPUAttachment &attachment = attachments_[index];
+    if (attachment.tex != nullptr && attachment.layer < 0) {
+      pass_count = std::max(
+          pass_count,
+          as_wgpu(attachment.tex)->attachment_layer_count(std::max(attachment.mip, 0)));
+    }
+  }
+
+  for (uint32_t pass_layer = 0; pass_layer < pass_count; pass_layer++) {
+    if (buffers & GPU_COLOR_BIT) {
+      if (colors.is_empty()) {
+        return;
+      }
+      for (int slot = 0; slot < GPU_FB_MAX_COLOR_ATTACHMENT; slot++) {
+        Texture *texture = color_tex(slot);
+        if (texture == nullptr) {
+          continue;
+        }
+        const GPUAttachment &attachment = attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot];
+        int force_layer;
+        const webgpu::FramebufferClearPassStatus status =
+            webgpu::framebuffer_clear_pass_layer(
+                attachment.layer,
+                as_wgpu(texture)->attachment_layer_count(std::max(attachment.mip, 0)),
+                pass_layer,
+                force_layer);
+        if (status == webgpu::FramebufferClearPassStatus::Invalid) {
+          return;
+        }
+        if (status == webgpu::FramebufferClearPassStatus::Inactive) {
+          continue;
+        }
+        const double4 &color =
+            colors[(colors.size() == 1) ? 0 : std::min<int>(slot, colors.size() - 1)];
+        if (!submit_scissored_color_clear(attachment, force_layer, color, plan)) {
+          return;
+        }
+      }
+    }
+
+    Texture *depth_texture = depth_tex();
+    if (depth_texture == nullptr || !(buffers & (GPU_DEPTH_BIT | GPU_STENCIL_BIT))) {
+      continue;
+    }
+    const GPUAttachment &attachment = depth_attachment();
+    int force_layer;
+    const webgpu::FramebufferClearPassStatus status = webgpu::framebuffer_clear_pass_layer(
+        attachment.layer,
+        as_wgpu(depth_texture)->attachment_layer_count(std::max(attachment.mip, 0)),
+        pass_layer,
+        force_layer);
+    if (status == webgpu::FramebufferClearPassStatus::Invalid) {
+      return;
+    }
+    if (status == webgpu::FramebufferClearPassStatus::Inactive) {
+      continue;
+    }
+    const wgpu::TextureAspect selected_aspect =
+        as_wgpu(depth_texture)->subresource_range().aspect;
+    const bool clear_depth_aspect = selected_aspect != wgpu::TextureAspect::StencilOnly &&
+                                    bool(buffers & GPU_DEPTH_BIT);
+    const bool clear_stencil_aspect = selected_aspect != wgpu::TextureAspect::DepthOnly &&
+                                      bool(buffers & GPU_STENCIL_BIT) &&
+                                      depth_texture->format_get() ==
+                                          TextureFormat::SFLOAT_32_DEPTH_UINT_8;
+    if ((clear_depth_aspect || clear_stencil_aspect) &&
