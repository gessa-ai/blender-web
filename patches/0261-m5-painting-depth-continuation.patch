+static void image_paint_readback_timer_remove(bContext *C, PaintOperation *pop)
+{
+  if (pop->readback_timer != nullptr) {
+    WM_event_timer_remove(
+        CTX_wm_manager(C), pop->readback_window, pop->readback_timer);
+    pop->readback_timer = nullptr;
+  }
+  pop->readback_window = nullptr;
+  pop->readback_tick_count = 0;
+}
+
+static bool image_paint_readback_timer_ensure(bContext *C, PaintOperation *pop)
+{
+  if (pop->readback_timer != nullptr) {
+    return true;
+  }
+  pop->readback_window = CTX_wm_window(C);
+  if (pop->readback_window == nullptr) {
+    return false;
+  }
+  pop->readback_timer = WM_event_timer_add(
+      CTX_wm_manager(C), pop->readback_window, TIMER, 0.01f);
+  return pop->readback_timer != nullptr;
