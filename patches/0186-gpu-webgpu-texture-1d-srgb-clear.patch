+uint8_t srgb_clear_component_to_unorm8(float linear)
+{
+  if (!std::isfinite(linear)) {
+    return 0;
+  }
+  linear = std::clamp(linear, 0.0f, 1.0f);
+  const float encoded = linear < 0.0031308f ? linear * 12.92f :
+                                                   1.055f * std::pow(linear, 1.0f / 2.4f) - 0.055f;
+  return uint8_t(std::lround(std::clamp(encoded, 0.0f, 1.0f) * 255.0f));
+}
+
 size_t promoted_byte_size(uint32_t width, uint32_t height, uint32_t comp_bytes)
 {
   return size_t(width) * height * 4u * comp_bytes;
