   void append_resource_bind_entries(WGPUShader *shader,
                                      std::vector<wgpu::BindGroupEntry> &entries);
 
+  /* Apply the dynamic stencil reference to an open render pass, from the frontend's mutable
+   * state, mirroring vk_context.cc's dynamic stencil state. The pipeline carries only the
+   * static stencil compare/write masks and ops (wgpu_pipeline.cc); the reference is a
+   * render-pass dynamic value (WebGPU has no reference in the pipeline). Without this every
+   * stencil-tested draw compares against 0; the workbench opaque gbuffer prepass uses
+   * GPU_STENCIL_NEQUAL at reference 0xFF (compare-mask OBJECT_IN_FRONT), so a 0 reference
+   * fails the test for every fragment and the whole solid pass writes nothing. Call after
+   * SetPipeline, before the draw. No-op when the frontend has no stencil test bound. */
+  void apply_stencil_reference(const wgpu::RenderPassEncoder &pass) const;
+
   /* A cached wgpu::Sampler for a GPUSamplerState (created lazily, retained for the
    * context lifetime so the handle outlives every BindGroup that references it). */
   wgpu::Sampler get_sampler(const GPUSamplerState &state);
