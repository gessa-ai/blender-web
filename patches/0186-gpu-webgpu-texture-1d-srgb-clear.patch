+/** Encode one linear clear color component exactly as an sRGB render attachment,
+ * then quantize it to the byte written by a non-renderable texture fallback.
+ * Non-finite inputs follow the fallback clear policy and become zero. */
+uint8_t srgb_clear_component_to_unorm8(float linear);
+
 /** Pack three float channels into WebGPU's 32-bit RGB9E5 shared-exponent layout.
  * Negative and NaN channels become zero; positive infinity clamps to the largest
  * finite representable value. */
