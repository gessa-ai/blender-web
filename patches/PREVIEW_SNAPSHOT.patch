diff --git a/source/blender/draw/tests/draw_debug_test.cc b/source/blender/draw/tests/draw_debug_test.cc
new file mode 100644
index 0000000000000000000000000000000000000000..11300c18311716d85209c276ec110259af0ccf8f
--- /dev/null
+++ b/source/blender/draw/tests/draw_debug_test.cc
@@ -0,0 +1,85 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#include "MEM_guardedalloc.h"
+
+#include "GPU_context.hh"
+#include "GPU_state.hh"
+
+#include "DRW_gpu_wrapper.hh"
+#include "draw_debug.hh"
+#include "draw_manager.hh"
+#include "draw_shader.hh"
+#include "draw_testing.hh"
+
+namespace blender::draw {
+
+struct DebugColorCounts {
+  int red = 0;
+  int green = 0;
+};
+
+static void test_draw_debug_lifetime_rebind()
+{
+  constexpr int2 extent(16, 16);
+
+  Texture depth("debug_depth");
+  Texture color("debug_color");
+  Texture line_data("debug_line_data");
+  depth.ensure_2d(gpu::TextureFormat::SFLOAT_32_DEPTH, extent);
+  color.ensure_2d(gpu::TextureFormat::UNORM_8_8_8_8, extent);
+  line_data.ensure_2d(gpu::TextureFormat::UNORM_8_8_8_8, extent);
+
+  Framebuffer framebuffer("debug_lifetime_fb");
+  framebuffer.ensure(GPU_ATTACHMENT_TEXTURE(depth),
+                     GPU_ATTACHMENT_TEXTURE(color),
+                     GPU_ATTACHMENT_TEXTURE(line_data));
+
+  View view("debug_lifetime_view");
+  view.sync(float4x4::identity(), float4x4::identity());
+
+  GPU_render_begin();
+  drw_debug_clear();
+  drw_debug_line(float3(-0.9f, -0.5f, 0.0f),
+                 float3(0.9f, -0.5f, 0.0f),
+                 float4(1.0f, 0.0f, 0.0f, 1.0f),
+                 1);
+  drw_debug_line(float3(-0.9f, 0.5f, 0.0f),
+                 float3(0.9f, 0.5f, 0.0f),
+                 float4(0.0f, 1.0f, 0.0f, 1.0f),
+                 2);
+
+  auto render_and_count = [&]() {
+    framebuffer.bind();
+    framebuffer.clear_color(float4(0.0f));
+    framebuffer.clear_depth(1.0f);
+    DebugDraw::get().display_to_view(view);
+    GPU_finish();
+
+    uchar4 *pixels = color.read<uchar4>(GPU_DATA_UBYTE);
+    DebugColorCounts counts;
+    for (const uchar4 pixel : Span<uchar4>(pixels, extent.x * extent.y)) {
+      counts.red += pixel.x > 127 && pixel.y < 64;
+      counts.green += pixel.y > 127 && pixel.x < 64;
+    }
+    MEM_delete(pixels);
+    return counts;
+  };
+
+  const DebugColorCounts frame_1 = render_and_count();
+  const DebugColorCounts frame_2 = render_and_count();
+  const DebugColorCounts frame_3 = render_and_count();
+  GPU_render_end();
+  DRW_shaders_free();
+
+  EXPECT_GT(frame_1.red, 0);
+  EXPECT_GT(frame_1.green, 0);
+  EXPECT_EQ(frame_2.red, 0);
+  EXPECT_GT(frame_2.green, 0);
+  EXPECT_EQ(frame_3.red, 0);
+  EXPECT_EQ(frame_3.green, 0);
+}
+DRAW_WEBGPU_TEST(draw_debug_lifetime_rebind)
+
+}  // namespace blender::draw
