+bool WGPUFrameBuffer::materialize_layered_loadstore_clears()
+{
+  uint32_t materialize_mask = 0;
+  for (int index = 0; index < GPU_FB_MAX_ATTACHMENT; index++) {
+    const GPUAttachment &attachment = attachments_[index];
+    if (attachment.tex == nullptr || load_store_[index].load_action != GPU_LOADACTION_CLEAR) {
+      continue;
+    }
+    const webgpu::FramebufferLoadClearScope scope = webgpu::framebuffer_load_clear_scope(
+        attachment.layer,
+        as_wgpu(attachment.tex)->attachment_layer_count(std::max(attachment.mip, 0)));
+    if (scope == webgpu::FramebufferLoadClearScope::Invalid) {
+      return false;
+    }
+    if (scope == webgpu::FramebufferLoadClearScope::MaterializeAllLayers) {
+      materialize_mask |= 1u << index;
+    }
+  }
+
+  for (int index = 0; index < GPU_FB_MAX_ATTACHMENT; index++) {
+    if ((materialize_mask & (1u << index)) == 0) {
+      continue;
+    }
+    const GPULoadStore &load_store = load_store_[index];
+    double4 clear_value(load_store.clear_value[0],
+                        load_store.clear_value[1],
+                        load_store.clear_value[2],
+                        load_store.clear_value[3]);
+    if (index < GPU_FB_COLOR_ATTACHMENT0) {
+      /* begin_load_pass() uses zero for the shared depth/stencil load action's
+       * stencil value; retain that established backend behavior here. */
+      clear_value[1] = 0.0;
+    }
+    clear_attachment(static_cast<GPUAttachmentType>(index), clear_value);
+    load_store_[index].load_action = GPU_LOADACTION_LOAD;
+  }
+  return true;
+}
