+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "testing/testing.h"
+
+#include "wm_web_split_protocol.hh"
+
+namespace blender::windowmanager::tests {
+
+static const WebSplitWorkerPayload valid_workers{8, 8, 8, 1, 0, 0};
+
+TEST(wm_web_split, ExactPhaseGenerationAndEpochValidation)
+{
+  EXPECT_EQ(wm_web_split_validate_park(WebSplitSchedulerPhase::Bootstrap, 0, 0),
+            WebSplitSchedulerError::InvalidGeneration);
+  EXPECT_EQ(wm_web_split_validate_park(WebSplitSchedulerPhase::Parked, 1, 0),
+            WebSplitSchedulerError::InvalidPhase);
+  EXPECT_EQ(wm_web_split_validate_park(WebSplitSchedulerPhase::Bootstrap, 1, 2),
+            WebSplitSchedulerError::WrongGeneration);
+  EXPECT_EQ(wm_web_split_validate_park(WebSplitSchedulerPhase::Bootstrap, 1, 0),
+            WebSplitSchedulerError::None);
+
+  EXPECT_EQ(wm_web_split_validate_prepared(
+                WebSplitSchedulerPhase::Parked, 7, 7, 7, valid_workers, 1),
+            WebSplitSchedulerError::None);
+  EXPECT_EQ(wm_web_split_validate_prepared(
+                WebSplitSchedulerPhase::Parked, 7, 7, 6, valid_workers, 1),
+            WebSplitSchedulerError::WrongGeneration);
+  EXPECT_EQ(wm_web_split_validate_prepared(
+                WebSplitSchedulerPhase::Parked, 7, 7, 7, valid_workers, 0),
+            WebSplitSchedulerError::InvalidWorkerPayload);
+  EXPECT_EQ(wm_web_split_validate_apply(WebSplitSchedulerPhase::Prepared, 7, 7, 7, 8),
+            WebSplitSchedulerError::None);
+  EXPECT_EQ(wm_web_split_validate_apply(WebSplitSchedulerPhase::Prepared, 7, 7, 7, 4),
+            WebSplitSchedulerError::WrongTarget);
+
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Applied, 7, 7, 7, valid_workers, 8, 0, 1, 1),
+            WebSplitSchedulerError::InvalidWorkerPayload);
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Applied, 7, 7, 7, valid_workers, 8, 0, 1, 2),
+            WebSplitSchedulerError::None);
+  const WebSplitWorkerPayload nine_workers{9, 9, 9, 1, 0, 0};
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Applied, 7, 7, 7, nine_workers, 8, 0, 1, 2),
+            WebSplitSchedulerError::InvalidWorkerPayload);
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Applied, 7, 7, 7, nine_workers, 8, 1, 1, 2),
+            WebSplitSchedulerError::None);
+  EXPECT_EQ(wm_web_split_validate_resume(WebSplitSchedulerPhase::Applied, 7, 7, 7),
+            WebSplitSchedulerError::InvalidPhase);
+  EXPECT_EQ(wm_web_split_validate_resume(WebSplitSchedulerPhase::PageReady, 7, 7, 7),
+            WebSplitSchedulerError::None);
+}
+
+TEST(wm_web_split, ImageMismatchRollbackReloadAndAckLast)
+{
+  const WebSplitApplyResult rollback = wm_web_split_apply_reduce(3, {true, false, true, true, true});
+  EXPECT_EQ(rollback.error, WebSplitSchedulerError::ImagePolicyApplyFailed);
+  EXPECT_EQ(rollback.scheduler_threads, 1);
+  EXPECT_EQ(rollback.override_threads, 1);
+  EXPECT_EQ(rollback.openexr_threads, 0);
+  EXPECT_EQ(rollback.oiio_threads, 1);
+  EXPECT_FALSE(rollback.native_ready);
+  EXPECT_EQ(rollback.applied_generation, 0u);
+
+  const WebSplitApplyResult reload = wm_web_split_apply_reduce(4, {true, false, false, false, true});
+  EXPECT_EQ(reload.error, WebSplitSchedulerError::RollbackFailed);
+  EXPECT_TRUE(reload.reload_required);
+  EXPECT_EQ(reload.applied_generation, 0u);
+
+  const WebSplitApplyResult ready_fail = wm_web_split_apply_reduce(5, {true, true, true, true, false});
+  EXPECT_EQ(ready_fail.error, WebSplitSchedulerError::ReadyTransitionFailed);
+  EXPECT_TRUE(ready_fail.reload_required);
+  EXPECT_EQ(ready_fail.applied_generation, 0u);
+
+  const WebSplitApplyResult success = wm_web_split_apply_reduce(5, {true, true, true, true, true});
+  EXPECT_EQ(success.error, WebSplitSchedulerError::None);
+  EXPECT_EQ(success.scheduler_threads, 8);
+  EXPECT_EQ(success.override_threads, 8);
+  EXPECT_EQ(success.openexr_threads, 8);
+  EXPECT_EQ(success.oiio_threads, 8);
+  EXPECT_TRUE(success.native_ready);
+  EXPECT_EQ(success.applied_generation, 5u);
+}
+
+TEST(wm_web_split, ProductionControlStepTerminalAckAndResumeNextTick)
+{
+  const WebSplitApplyEffects success_effects{true, true, true, true, true};
+  const WebSplitControlStepResult job = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ParkRequested, 12, true, true, true, true, success_effects});
+  EXPECT_TRUE(job.consume_tick);
+  EXPECT_TRUE(job.terminal);
+  EXPECT_EQ(job.phase, WebSplitSchedulerPhase::Error);
+  EXPECT_EQ(job.error, WebSplitSchedulerError::JobRunning);
+  EXPECT_EQ(job.generation, 12u);
+
+  int publication_index = 0;
+  int payload_index = 0;
+  int ack_index = 0;
+  uint32_t offending_generation = 0;
+  uint32_t error_generation = 0;
+  wm_web_split_publish_control_step(
+      job,
+      [&](const WebSplitControlStepResult &published) {
+        payload_index = ++publication_index;
+        offending_generation = published.generation;
+      },
+      [&](const uint32_t generation) {
+        ack_index = ++publication_index;
+        error_generation = generation;
+      });
+  EXPECT_EQ(payload_index, 1);
+  EXPECT_EQ(ack_index, 2);
+  EXPECT_EQ(offending_generation, 12u);
+  EXPECT_EQ(error_generation, 12u);
+
+  int ordinary_ticks = 0;
+  const WebSplitControlStepResult resume = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ResumeRequested, 12, false, true, true, true, success_effects});
+  if (!resume.consume_tick) {
+    ordinary_ticks++;
+  }
+  EXPECT_TRUE(resume.consume_tick);
+  EXPECT_TRUE(resume.publish_ack);
+  EXPECT_EQ(resume.phase, WebSplitSchedulerPhase::Resumed);
+  const WebSplitControlStepResult following = wm_web_split_control_step_reduce(
+      {resume.phase, 12, false, true, true, true, success_effects});
+  if (!following.consume_tick) {
+    ordinary_ticks++;
+  }
+  EXPECT_FALSE(following.consume_tick);
+  EXPECT_EQ(ordinary_ticks, 1);
+}
+
+TEST(wm_web_split, ProductionControlStepApplyFailureRollbackAndReload)
+{
+  const auto rollback = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ApplyRequested, 9, false, true, true, true,
+       {true, false, true, true, true}});
+  EXPECT_TRUE(rollback.consume_tick);
+  EXPECT_TRUE(rollback.publish_ack);
+  EXPECT_TRUE(rollback.terminal);
+  EXPECT_EQ(rollback.phase, WebSplitSchedulerPhase::Error);
+  EXPECT_EQ(rollback.error, WebSplitSchedulerError::ImagePolicyApplyFailed);
+  EXPECT_FALSE(rollback.reload_required);
+
+  const auto reload = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ApplyRequested, 10, false, true, true, true,
+       {true, false, false, false, true}});
+  EXPECT_TRUE(reload.terminal);
+  EXPECT_EQ(reload.error, WebSplitSchedulerError::RollbackFailed);
+  EXPECT_TRUE(reload.reload_required);
+
+  const auto scheduler_failure = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ApplyRequested, 11, false, true, true, true,
+       {false, false, true, true, true}});
+  EXPECT_EQ(scheduler_failure.error, WebSplitSchedulerError::SchedulerApplyFailed);
+  EXPECT_FALSE(scheduler_failure.reload_required);
+
+  const auto success = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ApplyRequested, 12, false, true, true, true,
+       {true, true, true, true, true}});
+  EXPECT_FALSE(success.terminal);
+  EXPECT_EQ(success.phase, WebSplitSchedulerPhase::Applied);
+  EXPECT_EQ(success.generation, 12u);
+}
+
+TEST(wm_web_split, ProductionControlStepCompletePhaseAndFailureMatrix)
+{
+  const WebSplitApplyEffects ok{true, true, true, true, true};
+  const auto park_success = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ParkRequested, 20, false, true, true, true, ok});
+  EXPECT_EQ(park_success.phase, WebSplitSchedulerPhase::Parked);
+  EXPECT_TRUE(park_success.publish_ack);
+  EXPECT_FALSE(park_success.terminal);
+  EXPECT_EQ(park_success.generation, 20u);
+  const auto park_scheduler = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ParkRequested, 20, false, false, true, true, ok});
+  EXPECT_EQ(park_scheduler.error, WebSplitSchedulerError::BootstrapSchedulerMismatch);
+  EXPECT_TRUE(park_scheduler.terminal);
+  const auto park_image = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ParkRequested, 20, false, true, false, true, ok});
+  EXPECT_EQ(park_image.error, WebSplitSchedulerError::ImagePolicyApplyFailed);
+  EXPECT_TRUE(park_image.terminal);
+
+  const auto prepared = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::PreparedRequested, 20, false, true, true, true, ok});
+  const auto page_ready = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::PageReadyRequested, 20, false, true, true, true, ok});
+  EXPECT_EQ(prepared.phase, WebSplitSchedulerPhase::Prepared);
+  EXPECT_EQ(page_ready.phase, WebSplitSchedulerPhase::PageReady);
+  EXPECT_TRUE(prepared.publish_ack);
+  EXPECT_TRUE(page_ready.publish_ack);
+
+  const auto rollback_failure = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ApplyRequested, 20, false, true, true, true,
+       {false, false, false, true, true}});
+  EXPECT_EQ(rollback_failure.error, WebSplitSchedulerError::RollbackFailed);
+  EXPECT_TRUE(rollback_failure.reload_required);
+  const auto ready_failure = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ApplyRequested, 20, false, true, true, true,
+       {true, true, true, true, false}});
+  EXPECT_EQ(ready_failure.error, WebSplitSchedulerError::ReadyTransitionFailed);
+  EXPECT_TRUE(ready_failure.reload_required);
+  const auto observed_mismatch = wm_web_split_control_step_reduce(
+      {WebSplitSchedulerPhase::ApplyRequested, 20, false, true, true, false, ok});
+  EXPECT_EQ(observed_mismatch.error, WebSplitSchedulerError::SchedulerApplyFailed);
+  EXPECT_TRUE(observed_mismatch.reload_required);
+
+  for (const WebSplitSchedulerPhase stable : {WebSplitSchedulerPhase::Parked,
+                                               WebSplitSchedulerPhase::Prepared,
+                                               WebSplitSchedulerPhase::Applied,
+                                               WebSplitSchedulerPhase::PageReady,
+                                               WebSplitSchedulerPhase::Error})
+  {
+    const auto step = wm_web_split_control_step_reduce(
+        {stable, 20, false, true, true, true, ok});
+    EXPECT_TRUE(step.consume_tick);
+    EXPECT_FALSE(step.publish_ack);
+    int writes = 0;
+    wm_web_split_publish_control_step(step, [&](const auto &) { writes++; }, [&](auto) { writes++; });
+    EXPECT_EQ(writes, 0);
+  }
+  for (const WebSplitSchedulerPhase ordinary : {WebSplitSchedulerPhase::Bootstrap,
+                                                 WebSplitSchedulerPhase::Resumed})
+  {
+    EXPECT_FALSE(wm_web_split_control_step_reduce(
+                     {ordinary, 20, false, true, true, true, ok})
+                     .consume_tick);
+  }
+}
+
+TEST(wm_web_split, CompleteValidatorRejectionMatrix)
+{
+  const WebSplitWorkerPayload bad_counter{8, 7, 8, 1, 0, 0};
+  EXPECT_EQ(wm_web_split_validate_prepared(
+                WebSplitSchedulerPhase::Bootstrap, 7, 7, 7, valid_workers, 1),
+            WebSplitSchedulerError::InvalidPhase);
+  EXPECT_EQ(wm_web_split_validate_prepared(
+                WebSplitSchedulerPhase::Parked, 7, 6, 7, valid_workers, 1),
+            WebSplitSchedulerError::WrongGeneration);
+  EXPECT_EQ(wm_web_split_validate_prepared(
+                WebSplitSchedulerPhase::Parked, 7, 7, 7, bad_counter, 1),
+            WebSplitSchedulerError::InvalidWorkerPayload);
+
+  EXPECT_EQ(wm_web_split_validate_apply(WebSplitSchedulerPhase::Parked, 7, 7, 7, 8),
+            WebSplitSchedulerError::InvalidPhase);
+  EXPECT_EQ(wm_web_split_validate_apply(WebSplitSchedulerPhase::Prepared, 7, 6, 7, 8),
+            WebSplitSchedulerError::WrongGeneration);
+
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Prepared, 7, 7, 7, valid_workers, 8, 0, 1, 2),
+            WebSplitSchedulerError::InvalidPhase);
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Applied, 7, 6, 7, valid_workers, 8, 0, 1, 2),
+            WebSplitSchedulerError::WrongGeneration);
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Applied, 7, 7, 7, bad_counter, 8, 0, 1, 2),
+            WebSplitSchedulerError::InvalidWorkerPayload);
+  const WebSplitWorkerPayload seven_workers{7, 7, 7, 1, 0, 0};
+  EXPECT_EQ(wm_web_split_validate_page_ready(
+                WebSplitSchedulerPhase::Applied, 7, 7, 7, seven_workers, 8, -1, 1, 2),
+            WebSplitSchedulerError::InvalidWorkerPayload);
+
+  EXPECT_EQ(wm_web_split_validate_resume(WebSplitSchedulerPhase::PageReady, 7, 6, 7),
+            WebSplitSchedulerError::WrongGeneration);
+}
+
+TEST(wm_web_split, ProductionPublisherAckLastForEveryPublishedPhase)
+{
+  for (const WebSplitControlStepResult result : {
+           WebSplitControlStepResult{true, true, false, WebSplitSchedulerPhase::Parked,
+                                     WebSplitSchedulerError::None, 30, false},
+           WebSplitControlStepResult{true, true, false, WebSplitSchedulerPhase::Prepared,
+                                     WebSplitSchedulerError::None, 30, false},
+           WebSplitControlStepResult{true, true, false, WebSplitSchedulerPhase::Applied,
+                                     WebSplitSchedulerError::None, 30, false},
+           WebSplitControlStepResult{true, true, false, WebSplitSchedulerPhase::PageReady,
+                                     WebSplitSchedulerError::None, 30, false},
+           WebSplitControlStepResult{true, true, false, WebSplitSchedulerPhase::Resumed,
+                                     WebSplitSchedulerError::None, 30, false},
+           WebSplitControlStepResult{true, true, true, WebSplitSchedulerPhase::Error,
+                                     WebSplitSchedulerError::JobRunning, 30, false},
+       })
+  {
+    int order = 0;
+    int payload = 0;
+    int ack = 0;
+    wm_web_split_publish_control_step(
+        result, [&](const auto &) { payload = ++order; }, [&](auto) { ack = ++order; });
+    EXPECT_EQ(payload, 1);
+    EXPECT_EQ(ack, 2);
+  }
+}
+
+}  // namespace blender::windowmanager::tests
