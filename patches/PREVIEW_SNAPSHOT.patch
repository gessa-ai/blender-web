+  BLI_mutex_lock(&engine->update_render_passes_mutex);
+  const bool consumed = film.read_passes_async_consume(*render_layer);
+  if (consumed) {
+    render_read_result_vector_clear(render_layer, RE_GetActiveRenderView(engine->re));
+  }
+  BLI_mutex_unlock(&engine->update_render_passes_mutex);
+
+  if (!consumed) {
+    RE_engine_set_error_message(engine, "EEVEE render-pass readback could not be consumed.");
+    film.read_passes_async_cancel();
+    return RenderStepStatus::Failed;
+  }
+  return RenderStepStatus::Complete;
+}
+
+void Instance::render_read_result_async_cancel()
+{
+  film.read_passes_async_cancel();
