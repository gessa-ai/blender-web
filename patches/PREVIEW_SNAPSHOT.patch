+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * Implements the M3 shader chain: shaderc(GLSL->SPIR-V 1.3) -> Tint(SPIR-V->WGSL)
+ * with the normative sampler_mappings. See wgpu_shader_compiler.hh. */
+
+#include "wgpu_shader_compiler.hh"
+
+#include "wgpu_shader_cache.hh"
+
+#include <algorithm>
+#include <cctype>
+#include <cstdlib>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+#include <sstream>
+#include <unordered_set>
+
+#include <shaderc/shaderc.hpp>
+
+#include "src/tint/api/common/binding_point.h"
+#include "src/tint/lang/core/ir/module.h"
+#include "src/tint/lang/spirv/reader/reader.h"
+#include "src/tint/lang/wgsl/enums.h"
+#include "src/tint/lang/wgsl/inspector/inspector.h"
+#include "src/tint/lang/wgsl/program/program.h"
+#include "src/tint/lang/wgsl/reader/reader.h"
+#include "src/tint/lang/wgsl/writer/writer.h"
+
+namespace blender::gpu::webgpu {
+
+namespace {
+
+/* A static create-info census can compile a small builtin set during GPU fixture
+ * initialization, before the test activates its isolated cache directory, and
+ * again recursively in the outer create-info loop. Suppress fixture markers
+ * until the exact census directory is active, then report the first in-census
+ * compile for each exact identity. Normal browser diagnostics retain per-call
+ * rows. */
+bool emit_cache_result(const std::string &name)
+{
+  const char *census_dir = std::getenv("BW_SHADER_CACHE_CENSUS_DIR");
+  if (census_dir == nullptr) {
+    return true;
+  }
+  const char *active_dir = std::getenv("BW_SHADER_CACHE_DIR");
+  if (active_dir == nullptr || active_dir[0] == '\0' || std::strcmp(active_dir, census_dir) != 0) {
+    return false;
+  }
+  static std::mutex mutex;
+  static std::unordered_set<std::string> emitted_names;
+  std::lock_guard lock(mutex);
+  return emitted_names.insert(name).second;
+}
+
+}  // namespace
+
+std::vector<uint32_t> compile_glsl_to_spirv(const std::string &glsl,
+                                            int shaderc_kind,
+                                            const std::string &name,
+                                            bool optimize,
+                                            std::string &error)
+{
+  shaderc::Compiler compiler;
+  shaderc::CompileOptions options;
+
+  /* HARD constraint (notes/gpu-dawn-probe.md §4a): Tint's IR SPIR-V reader
+   * hardcodes SPV_ENV_VULKAN_1_1, so we MUST emit SPIR-V 1.3. Blender's Vulkan
+   * backend uses vulkan_1_2 (SPIR-V 1.5) -> would be rejected by Tint. */
+  options.SetTargetEnvironment(shaderc_target_env_vulkan, shaderc_env_version_vulkan_1_1);
+  options.SetSourceLanguage(shaderc_source_language_glsl);
+  options.SetOptimizationLevel(optimize ? shaderc_optimization_level_performance :
+                                          shaderc_optimization_level_zero);
+  /* Match Blender's raised id-bound (vk_shader_compiler.cc:238). */
+  /* (shaderc has no public SetMaxIdBound; the default suffices for these.) */
+
+  shaderc::SpvCompilationResult result = compiler.CompileGlslToSpv(
+      glsl, static_cast<shaderc_shader_kind>(shaderc_kind), name.c_str(), "main", options);
+
+  if (result.GetCompilationStatus() != shaderc_compilation_status_success) {
+    error = "shaderc [" + name + "]: " + result.GetErrorMessage();
+    return {};
+  }
+  return {result.cbegin(), result.cend()};
+}
+
+bool translate_spirv_to_wgsl(const std::vector<uint32_t> &spirv,
+                             const std::vector<SamplerRemap> &sampler_mappings,
+                             std::string &out_wgsl,
+                             std::string &error)
+{
+  tint::spirv::reader::Options reader_opts;
+  for (const SamplerRemap &m : sampler_mappings) {
+    reader_opts.sampler_mappings[tint::BindingPoint{m.from.group, m.from.binding}] =
+        tint::BindingPoint{m.to.group, m.to.binding};
+  }
+
+  auto ir = tint::spirv::reader::ReadIR(spirv, reader_opts);
+  if (ir != tint::Success) {
+    std::stringstream ss;
+    ss << ir.Failure();
+    error = "tint ReadIR: " + ss.str();
+    return false;
+  }
+  tint::wgsl::writer::Options writer_opts;
+  /* Align the WGSL writer's "current environment" with our real WebGPU target so
+   * Tint emits the language features Blender's shaders legitimately use instead of
+   * rejecting them at ProgramFromIR:
+   *   - clip_distances / dual_source_blending: two WebGPU extensions the backend
+   *     requests on the device (GHOST_ContextWGPU, adapter-guarded). The writer's
+   *     default allowed_features set is empty, so it otherwise rejects the `enable`
+   *     directive ("extension '...' is not allowed in the current environment").
+   *     Kept TARGETED (not AllowedFeatures::Everything) so any other extension
+   *     stays an honest failure rather than emitting WGSL a conformant device
+   *     would reject.
+   *   - allow_non_uniform_derivatives: several shaders call textureSample / fwidth
+   *     / dpdx / dpdy in non-uniform control flow; WebGPU permits this via a
+   *     diagnostic(off, derivative_uniformity) directive (core WGSL, no device
+   *     feature).
+   *   - disable_unreachable_code_warning: ProgramFromIR otherwise surfaces this
+   *     non-fatal warning as a hard failure. */
+  writer_opts.allowed_features.extensions.insert(tint::wgsl::Extension::kClipDistances);
+  writer_opts.allowed_features.extensions.insert(tint::wgsl::Extension::kDualSourceBlending);
+  writer_opts.allow_non_uniform_derivatives = true;
+  writer_opts.disable_unreachable_code_warning = true;
+  auto prog = tint::wgsl::writer::ProgramFromIR(ir.Get(), writer_opts);
+  if (prog != tint::Success) {
+    std::stringstream ss;
+    ss << prog.Failure();
+    error = "tint ProgramFromIR: " + ss.str();
+    return false;
+  }
+  tint::Program program = prog.Move();
+  auto gen = tint::wgsl::writer::Generate(program, writer_opts);
+  if (gen != tint::Success) {
+    std::stringstream ss;
+    ss << gen.Failure();
+    error = "tint Generate: " + ss.str();
+    return false;
+  }
+  out_wgsl = gen.Get().wgsl;
+  return true;
+}
+
+/* Tint requires every SPIR-V combined sampler to split into a distinct WGSL
+ * sampler variable even when multiple reader mappings select the same binding.
+ * That defeats the interface map's >16-sampler fallback on Apple adapters. Once
+ * Tint has produced valid WGSL, merge those sampler variables textually while
+ * retaining every distinct texture variable. WGSL sampler variables are opaque;
+ * replacing one with another of the same WGSL sampler type is type-preserving. */
+static void compact_duplicate_sampler_halves(std::string &wgsl, const InterfaceMap &interface)
+{
+  std::unordered_set<uint32_t> targets;
+  for (const SamplerRemap &mapping : interface.sampler_mappings) {
+    targets.insert(mapping.to.binding);
+  }
+  if (targets.size() == interface.sampler_mappings.size()) {
+    return;
+  }
+
+  uint32_t normal_binding = UINT32_MAX;
+  uint32_t comparison_binding = UINT32_MAX;
+  for (const wgpu::BindGroupLayoutEntry &entry : interface.entries) {
+    if (entry.sampler.type == wgpu::SamplerBindingType::Comparison) {
+      comparison_binding = std::min(comparison_binding, entry.binding);
+    }
+    else if (entry.sampler.type == wgpu::SamplerBindingType::Filtering ||
+             entry.sampler.type == wgpu::SamplerBindingType::NonFiltering)
+    {
+      normal_binding = std::min(normal_binding, entry.binding);
+    }
+  }
+
+  struct Alias {
+    std::string from;
+    std::string to;
+  };
+  std::vector<Alias> aliases;
+  std::string normal_name;
+  std::string comparison_name;
+  std::string rebuilt;
+  rebuilt.reserve(wgsl.size());
+  size_t begin = 0;
+  while (begin < wgsl.size()) {
+    const size_t end = wgsl.find('\n', begin);
+    const size_t count = end == std::string::npos ? wgsl.size() - begin : end - begin + 1;
+    std::string line = wgsl.substr(begin, count);
+    const size_t var_pos = line.find(" var ");
+    const size_t sampler_pos = line.find(" : sampler");
+    const bool comparison = line.find(" : sampler_comparison") != std::string::npos;
+    if (var_pos != std::string::npos && sampler_pos != std::string::npos &&
+        line.find("@group(0u) @binding(") != std::string::npos)
+    {
+      const size_t name_begin = var_pos + 5;
+      const std::string name = line.substr(name_begin, sampler_pos - name_begin);
+      std::string &keeper = comparison ? comparison_name : normal_name;
+      const uint32_t binding = comparison ? comparison_binding : normal_binding;
+      if (keeper.empty()) {
+        keeper = name;
+        const size_t binding_begin = line.find("@binding(") + 9;
+        const size_t binding_end = line.find('u', binding_begin);
+        if (binding != UINT32_MAX && binding_end != std::string::npos) {
+          line.replace(binding_begin, binding_end - binding_begin, std::to_string(binding));
+        }
+        rebuilt += line;
+      }
+      else {
+        aliases.push_back({name, keeper});
+      }
+    }
+    else {
+      rebuilt += line;
+    }
+    if (end == std::string::npos) {
+      break;
+    }
+    begin = end + 1;
+  }
+
+  const auto is_ident = [](char c) {
+    return std::isalnum(static_cast<unsigned char>(c)) || c == '_';
+  };
+  for (const Alias &alias : aliases) {
+    size_t pos = 0;
+    while ((pos = rebuilt.find(alias.from, pos)) != std::string::npos) {
+      const bool left_ok = pos == 0 || !is_ident(rebuilt[pos - 1]);
+      const size_t after = pos + alias.from.size();
+      const bool right_ok = after == rebuilt.size() || !is_ident(rebuilt[after]);
+      if (left_ok && right_ok) {
+        rebuilt.replace(pos, alias.from.size(), alias.to);
+        pos += alias.to.size();
+      }
+      else {
+        pos = after;
+      }
+    }
+  }
+  wgsl = std::move(rebuilt);
+}
+
+/* Return the resources transitively used by an entry point and the subset of texture
+ * bindings it actually pairs with a sampler. Looking for textual declarations or
+ * references to the generated sampler variable is insufficient:
+ * unoptimized WGSL can forward both halves of a combined GLSL sampler through helper
+ * functions even when the ultimate operation is textureLoad/textureDimensions. Tint's
+ * resolved-program inspector performs the transitive data-flow analysis used by the
+ * WebGPU toolchain itself and reports only real textureSample* pairs. Parse the final
+ * WGSL here (including cache hits), so cold and warm boots derive the identical layout. */
+static bool reflect_entry_point_bindings(const std::string &wgsl,
+                                         const std::string &name,
+                                         std::vector<uint32_t> &r_resource_bindings,
+                                         std::vector<uint32_t> &r_sampled_texture_bindings,
+                                         std::string &error)
+{
+  if (wgsl.empty()) {
+    return true;
+  }
+
+  tint::Source::File file(name, wgsl);
+  tint::wgsl::reader::Options options;
+  options.allowed_features = tint::wgsl::AllowedFeatures::Everything();
+  tint::Program program = tint::wgsl::reader::Parse(&file, options);
+  if (!program.IsValid()) {
+    std::stringstream ss;
+    ss << program.Diagnostics();
+    error = "tint WGSL reflection parse [" + name + "]: " + ss.str();
+    return false;
+  }
+
+  tint::inspector::Inspector inspector(program);
+  for (const tint::inspector::ResourceBinding &resource : inspector.GetResourceBindings("main")) {
+    if (resource.bind_group == 0) {
+      r_resource_bindings.push_back(resource.binding);
+    }
+  }
+  for (const tint::inspector::SamplerTexturePair &pair : inspector.GetSamplerTextureUses("main")) {
+    if (pair.texture_binding_point.group == 0) {
+      r_sampled_texture_bindings.push_back(pair.texture_binding_point.binding);
+    }
+  }
+  if (inspector.has_error()) {
+    error = "tint WGSL reflection [" + name + "]: " + inspector.error();
+    return false;
+  }
+  return true;
+}
+
+CompileResult compile_shader(const ShaderStageSources &sources,
+                             const std::vector<ResourceDesc> &resources,
+                             const CompileOptions &options)
+{
+  CompileResult out;
+
+  /* 1. Interface map: binding numbers + sampler_mappings + BGL. Cheap and derived
+   * purely from `resources`, so it is rebuilt on every boot (warm and cold) - only
+   * the expensive shaderc+Tint translation is cached. */
+  out.interface = build_interface_map(resources, options.sampler_base);
+  if (!out.interface.ok) {
+    out.error = "interface map: " + out.interface.error;
+    return out;
+  }
+  const std::vector<SamplerRemap> &maps = out.interface.sampler_mappings;
+
+  /* 2+3. Compile + translate each present stage. */
+  std::string err;
+  auto run_stage = [&](const std::string &glsl, int kind, std::string &wgsl_out) -> bool {
+    if (glsl.empty()) {
+      return true;
+    }
+    std::vector<uint32_t> spirv = compile_glsl_to_spirv(
+        glsl, kind, sources.name, options.optimize, err);
+    if (spirv.empty()) {
+      return false;
+    }
+    return translate_spirv_to_wgsl(spirv, maps, wgsl_out, err);
+  };
+
+  /* WARM-BOOT CACHE (M4.T29): the emitted WGSL is a pure function of the per-stage
+   * GLSL (which already carries every #define) plus the translation inputs
+   * (optimize flag, sampler_base, sampler_mappings). On the web build the whole
+   * first-draw shader set is translated INLINE on the WM worker (the async
+   * ShaderCompiler is bypassed under use_main_context_workaround), and shaderc
+   * alone measures ~81% of the ~16 s boot compile block (notes/gpu-r51-shader-
+   * latency.md). So look the WGSL up before paying shaderc+Tint; on a hit, hand the
+   * stored WGSL straight back. The browser createShaderModule that the caller runs
+   * next is unaffected - it recompiles the identical WGSL and hits ITS own cache.
+   * The cache is inert (every call a no-op, cold behaviour byte-for-byte
+   * unchanged) wherever the OPFS mount is absent, e.g. the native gpu build. */
+  const ShaderCacheKey ckey = cache_key(
+      sources, options.optimize, out.interface.sampler_base, maps);
+  const bool cache_hit = cache_lookup(
+      ckey, out.vertex_wgsl, out.fragment_wgsl, out.compute_wgsl);
+  if (emit_cache_result(sources.name)) {
+    /* Shader dependency warnings are emitted through chained stderr writes on
+     * parallel compiler threads. Start with a newline so this single flushed
+     * marker cannot be appended to an in-flight warning fragment. */
+    printf("\nBW_SHADER_CACHE_RESULT %s %s\n",
+           cache_hit ? "HIT" : "MISS",
+           sources.name.c_str());
+    fflush(stdout);
+  }
+  if (!cache_hit) {
+    if (!run_stage(sources.vertex, shaderc_vertex_shader, out.vertex_wgsl) ||
+        !run_stage(sources.fragment, shaderc_fragment_shader, out.fragment_wgsl) ||
+        !run_stage(sources.compute, shaderc_compute_shader, out.compute_wgsl))
+    {
+      out.error = err;
+      return out;
+    }
+    compact_duplicate_sampler_halves(out.vertex_wgsl, out.interface);
+    compact_duplicate_sampler_halves(out.fragment_wgsl, out.interface);
+    compact_duplicate_sampler_halves(out.compute_wgsl, out.interface);
+    cache_store(ckey, out.vertex_wgsl, out.fragment_wgsl, out.compute_wgsl);
+  }
+
+  /* Exact sampler/texture use reflection is deliberately outside the cache-miss
+   * branch. The cache stores translation output only; layout inference must not
+   * depend on whether this boot paid for shaderc + Tint translation. */
+  if (!reflect_entry_point_bindings(out.vertex_wgsl,
+                                    sources.name + " vertex",
+                                    out.vertex_resource_bindings,
+                                    out.sampled_texture_bindings,
+                                    err) ||
+      !reflect_entry_point_bindings(out.fragment_wgsl,
+                                    sources.name + " fragment",
+                                    out.fragment_resource_bindings,
+                                    out.sampled_texture_bindings,
+                                    err) ||
+      !reflect_entry_point_bindings(out.compute_wgsl,
+                                    sources.name + " compute",
+                                    out.compute_resource_bindings,
+                                    out.sampled_texture_bindings,
+                                    err))
+  {
+    out.error = err;
+    return out;
+  }
+  std::sort(out.sampled_texture_bindings.begin(), out.sampled_texture_bindings.end());
+  out.sampled_texture_bindings.erase(
+      std::unique(out.sampled_texture_bindings.begin(), out.sampled_texture_bindings.end()),
+      out.sampled_texture_bindings.end());
+  auto sort_unique = [](std::vector<uint32_t> &bindings) {
+    std::sort(bindings.begin(), bindings.end());
+    bindings.erase(std::unique(bindings.begin(), bindings.end()), bindings.end());
+  };
+  sort_unique(out.vertex_resource_bindings);
+  sort_unique(out.fragment_resource_bindings);
+  sort_unique(out.compute_resource_bindings);
+
+  out.ok = true;
+  return out;
+}
+
+}  // namespace blender::gpu::webgpu
