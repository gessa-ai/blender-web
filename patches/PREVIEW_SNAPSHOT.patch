+/* A storage texture's shader declaration, bind-group layout, and bound texture must name the same
+ * physical format. EEVEE promotes storage-backed RG11B10Ufloat to RGBA16Float, read-write
+ * RG16Float to RGBA16Float, and its render-and-storage RG16Unorm GBuffer normal plane to
+ * RGBA32Float on this backend. Write-only RG16Float textures retain their native physical format.
+ * Apply the same access-aware promotions to every interface derived from the create-info. */
+static TextureFormat storage_image_format(TextureFormat format, const Qualifier qualifiers)
+{
+  if (format == TextureFormat::UFLOAT_11_11_10) {
+    return TextureFormat::SFLOAT_16_16_16_16;
+  }
+  if (format == TextureFormat::SFLOAT_16_16 && bool(qualifiers & Qualifier::read) &&
+      bool(qualifiers & Qualifier::write))
+  {
+    return TextureFormat::SFLOAT_16_16_16_16;
+  }
+  if (format == TextureFormat::UNORM_16_16) {
+    return TextureFormat::SFLOAT_32_32_32_32;
+  }
+  return format;
+}
