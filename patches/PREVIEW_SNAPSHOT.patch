+/** \name Upload / clear
+ * \{ */
+
+void WGPUTexture::update_sub(int mip,
+                             int offset[3],
+                             int extent[3],
+                             eGPUDataFormat format,
+                             const void *data,
+                             uint unpack_row_length)
+{
+  /* Queue.WriteTexture writes backing bytes and has no view-format interpretation.
+   * Root uploads are exact (including physical 1D-array axis remapping); arbitrary
+   * updates through an sRGB/linear alias need an explicit conversion path and stay
+   * rejected rather than silently writing the wrong representation. */
+  BLI_assert_msg(!is_texture_view(),
+                 "WGPUTexture::update_sub through a format view is not supported");
+  if (is_texture_view() || !subresources_.valid() || data == nullptr || mip < 0 ||
+      uint32_t(mip) >= subresources_.mip_count) {
+    return;
+  }
+  const Repr repr = snorm16_emulated_ ? Repr::Snorm16 : repr_of(format_);
+
+  if (repr == Repr::Compressed) {
+    /* The pinned frontend labels already-compressed BC blocks as GPU_DATA_FLOAT (there is no
+     * GPU_DATA_COMPRESSED enum). Preserve those bytes exactly; no numeric conversion applies. */
+    if (format != GPU_DATA_FLOAT || !compressed_texture_type_supported(type_) ||
+        offset[0] < 0 || offset[1] < 0 || offset[2] < 0 || extent[0] <= 0)
+    {
+      return;
+    }
+    const uint32_t ex = uint32_t(extent[0]);
+    const uint32_t ey = uint32_t(std::max(extent[1], 1));
+    const uint32_t ez = uint32_t(std::max(extent[2], 1));
+
+    ResolvedReadRegion target;
+    WGPUContext *ctx = active_context();
+    if (ctx == nullptr || !resolve_subresource(mip, -1, target)) {
+      return;
+    }
+
+    uint32_t layer_offset = 0;
+    uint32_t layer_count = 1;
+    if (ELEM(type_, GPU_TEXTURE_2D_ARRAY, GPU_TEXTURE_CUBE, GPU_TEXTURE_CUBE_ARRAY)) {
+      layer_offset = uint32_t(offset[2]);
+      layer_count = ez;
+    }
+    else if (offset[2] != 0 || ez != 1) {
+      return;
+    }
+
+    const uint32_t ox = uint32_t(offset[0]);
+    const uint32_t oy = uint32_t(offset[1]);
+    const uint64_t end_x = uint64_t(ox) + ex;
+    const uint64_t end_y = uint64_t(oy) + ey;
+    const uint64_t end_layer = uint64_t(layer_offset) + layer_count;
+    if ((ox % 4) != 0 || (oy % 4) != 0 || end_x > target.width || end_y > target.height ||
+        end_layer > subresources_.layer_count ||
+        ((ex % 4) != 0 && end_x != target.width) ||
+        ((ey % 4) != 0 && end_y != target.height))
+    {
+      return;
+    }
+
+    CompressedUploadLayout compressed_layout;
+    if (!compressed_upload_layout(
+            format_, ex, ey, layer_count, unpack_row_length, compressed_layout))
+    {
+      return;
+    }
+    const uint64_t physical_end_x = uint64_t(ox) + compressed_layout.copy_width;
+    const uint64_t physical_end_y = uint64_t(oy) + compressed_layout.copy_height;
+    const uint64_t physical_target_width = (uint64_t(target.width) + 3u) & ~uint64_t(3u);
+    const uint64_t physical_target_height = (uint64_t(target.height) + 3u) & ~uint64_t(3u);
+    if (physical_end_x > physical_target_width || physical_end_y > physical_target_height) {
+      return;
+    }
+
+    wgpu::TexelCopyTextureInfo dst = {};
+    dst.texture = target.texture;
+    dst.mipLevel = target.mip_level;
+    dst.origin = {ox, oy, target.origin_z + layer_offset};
+    dst.aspect = wgpu::TextureAspect::All;
+
+    wgpu::TexelCopyBufferLayout layout = {};
+    layout.offset = 0;
+    layout.bytesPerRow = compressed_layout.bytes_per_row;
+    layout.rowsPerImage = compressed_layout.rows_per_image;
+
+    wgpu::Extent3D write_size = {
+        compressed_layout.copy_width, compressed_layout.copy_height, layer_count};
+    webgpu::queue_write_texture_scoped(ctx->instance_get(),
+                                       ctx->device_get(),
+                                       ctx->queue_get(),
+                                       ctx->queue_scheduler_get(),
+                                       dst,
+                                       data,
+                                       compressed_layout.data_size,
+                                       layout,
+                                       write_size,
+                                       "compressed texture upload",
+                                       [](bool) {});
+    return;
+  }
+
+  /* Resolve the physical copy box and every host/device byte product before allocating or
+   * inspecting caller memory. The public API represents 1D-array layers on its Y axis, while
+   * WebGPU stores them as physical 2D-array layers. */
+  if (extent[0] <= 0 || offset[0] < 0 || offset[1] < 0 || offset[2] < 0) {
+    return;
+  }
+  const uint32_t ex = uint32_t(extent[0]);
+  const uint32_t ey = uint32_t(std::max(extent[1], 1));
+  const uint32_t ez = uint32_t(std::max(extent[2], 1));
+
+  WGPUContext *ctx = active_context();
+  ResolvedReadRegion target;
+  if (ctx == nullptr || !resolve_subresource(mip, -1, target)) {
+    return;
+  }
+
+  wgpu::Origin3D relative_origin = {
+      uint32_t(offset[0]), uint32_t(offset[1]), uint32_t(offset[2])};
+  wgpu::Extent3D write_size = {ex, ey, ez};
+  if (subresources_.backing_type == GPU_TEXTURE_1D_ARRAY) {
+    /* A logical 1D-array upload has width x layers x one samples. Do not silently consume an
+     * ignored Z extent as the former pre-allocation sample-count path did. */
+    if (offset[2] != 0 || ez != 1) {
+      return;
+    }
+    relative_origin.y = 0;
+    relative_origin.z = uint32_t(offset[1]);
+    write_size.height = 1;
+    write_size.depthOrArrayLayers = ey;
+  }
+  const wgpu::Extent3D target_size = {target.width, target.height, target.depth};
+  if (!texture_region_fits(relative_origin, write_size, target_size)) {
+    return;
+  }
+
+  const uint32_t upload_device_texel_bytes =
+      ELEM(repr, Repr::Depth32F, Repr::Depth32FS8) ?
+          uint32_t(sizeof(float)) :
+          device_texel_bytes(format_, conv_, repr);
+  const size_t host_texel_bytes =
+      ELEM(repr, Repr::Depth32F, Repr::Depth32FS8) ? sizeof(float) :
+                                                     to_bytesize(format_, format);
+  TextureUploadLayout layout;
+  if (!texture_upload_layout(
+          ex, ey, ez, upload_device_texel_bytes, host_texel_bytes, unpack_row_length, layout))
+  {
+    return;
+  }
+
+  const wgpu::Origin3D physical_origin = {target.origin_x + relative_origin.x,
+                                          target.origin_y + relative_origin.y,
+                                          target.origin_z + relative_origin.z};
+
+  /* WebGPU forbids buffer→depth copies. Upload float depth through a tiny
+   * depth-only render pass backed by a read-only storage buffer. */
+  if (repr == Repr::Depth32F || repr == Repr::Depth32FS8) {
+    if (format != GPU_DATA_FLOAT) {
+      return;
+    }
+    const uint8_t *source = static_cast<const uint8_t *>(data);
+    const size_t layer_samples = size_t(write_size.width) * write_size.height;
+    std::vector<float> packed(layer_samples);
+    for (uint32_t layer = 0; layer < write_size.depthOrArrayLayers; layer++) {
+      for (uint32_t row = 0; row < write_size.height; row++) {
+        const size_t source_row = size_t(layer) * write_size.height + row;
+        std::memcpy(packed.data() + size_t(row) * write_size.width,
+                    source + source_row * layout.source_row_stride,
+                    size_t(write_size.width) * sizeof(float));
+      }
+      if (!ctx->upload_depth_render(this,
+                                    mip,
+                                    int(relative_origin.z + layer),
+                                    relative_origin.x,
+                                    relative_origin.y,
+                                    write_size.width,
+                                    write_size.height,
+                                    packed.data()))
+      {
+        return;
+      }
+    }
+    return;
+  }
+  if (repr == Repr::Unsupported) {
+    return;
+  }
+
+  std::vector<uint8_t> device_data(layout.device_data_size);
+  const uint8_t *src = static_cast<const uint8_t *>(data);
+  /* Non-zero unpack_row_length that differs from the sub-region width means the
+   * source rows are strided (the caller uploads a window of a larger image): gather
+   * `ex` texels per row from the wider source stride. Matches vk_texture.cc. */
+  const size_t tight_source_row = size_t(ex) * host_texel_bytes;
+  if (layout.source_row_stride != tight_source_row) {
+    for (size_t row = 0; row < layout.row_count; row++) {
+      convert_host_to_device(device_data.data() + row * layout.bytes_per_row,
+                             src + row * layout.source_row_stride,
+                             ex,
+                             format);
+    }
+  }
+  else {
+    convert_host_to_device(device_data.data(), src, layout.sample_count, format);
+  }
+
+  wgpu::TexelCopyTextureInfo dst = {};
+  dst.texture = subresources_.texture;
+  dst.mipLevel = target.mip_level;
+  dst.origin = physical_origin;
+  dst.aspect = wgpu::TextureAspect::All;
+
+  wgpu::TexelCopyBufferLayout copy_layout = {};
+  copy_layout.offset = 0;
+  copy_layout.bytesPerRow = layout.bytes_per_row; /* writeTexture needs no 256 align. */
+  copy_layout.rowsPerImage = write_size.height;
+
+  webgpu::queue_write_texture_scoped(ctx->instance_get(),
+                                     ctx->device_get(),
+                                     ctx->queue_get(),
+                                     ctx->queue_scheduler_get(),
+                                     dst,
+                                     device_data.data(),
+                                     device_data.size(),
+                                     copy_layout,
+                                     write_size,
+                                     "texture upload",
+                                     [](bool) {});
+}
+
+void WGPUTexture::update_sub(int offset[3],
+                             int extent[3],
+                             eGPUDataFormat format,
+                             GPUPixelBuffer *pixbuf)
+{
+  BLI_assert(pixbuf != nullptr);
+  if (pixbuf == nullptr) {
+    return;
+  }
+
+  if (extent[0] <= 0) {
+    return;
+  }
+  const uint32_t ex = uint32_t(extent[0]);
+  const uint32_t ey = uint32_t(std::max(extent[1], 1));
+  const uint32_t ez = uint32_t(std::max(extent[2], 1));
+  const Repr repr = snorm16_emulated_ ? Repr::Snorm16 : repr_of(format_);
+  const uint32_t device_bytes = ELEM(repr, Repr::Depth32F, Repr::Depth32FS8) ?
+                                    uint32_t(sizeof(float)) :
+                                    device_texel_bytes(format_, conv_, repr);
+  const size_t host_bytes = ELEM(repr, Repr::Depth32F, Repr::Depth32FS8) ?
+                                sizeof(float) :
+                                to_bytesize(format_, format);
+  TextureUploadLayout layout;
+  if (!texture_upload_layout(ex, ey, ez, device_bytes, host_bytes, 0, layout)) {
+    return;
+  }
+  const void *data = unwrap_webgpu(pixbuf)->data_for_upload(layout.source_data_size);
+  if (data == nullptr) {
+    return;
+  }
+
+  /* Reuse the normal host upload path. Besides format conversion, WriteTexture
+   * accepts tightly-packed rows and therefore avoids CopyBufferToTexture's
+   * 256-byte bytesPerRow requirement for arbitrary Cycles tile widths. */
+  update_sub(0, offset, extent, format, data, 0);
+}
+
+static wgpu::TextureFormat aspect_view_format(const WGPUTexture::SubresourceRange &range)
+{
+  if (range.aspect == wgpu::TextureAspect::StencilOnly) {
+    if (range.backing_format == wgpu::TextureFormat::Depth32FloatStencil8 ||
+        range.backing_format == wgpu::TextureFormat::Depth24PlusStencil8)
+    {
+      return wgpu::TextureFormat::Stencil8;
+    }
+  }
+  else if (range.aspect == wgpu::TextureAspect::DepthOnly) {
+    if (range.backing_format == wgpu::TextureFormat::Depth32FloatStencil8) {
+      return wgpu::TextureFormat::Depth32Float;
+    }
+    if (range.backing_format == wgpu::TextureFormat::Depth24PlusStencil8) {
+      return wgpu::TextureFormat::Depth24Plus;
+    }
+  }
+  return range.view_format;
+}
+
+wgpu::TextureView WGPUTexture::create_view_scoped(
+    const wgpu::TextureViewDescriptor &descriptor,
+    const char *label,
+    const TextureViewValidationScope validation_scope) const
+{
+  if (!subresources_.valid()) {
+    return nullptr;
+  }
+  const wgpu::Texture texture = subresources_.texture;
+  const auto create = [&]() { return texture.CreateView(&descriptor); };
+  if (validation_scope == TextureViewValidationScope::EnclosingCommand) {
+    /* `command_encode_submit_scoped()` pushed the complete error-scope set before entering its
+     * encoding body and will reject this non-null error object before queue submission. */
+    return create();
+  }
+
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr || ctx->instance_get() == nullptr || ctx->device_get() == nullptr) {
+    return nullptr;
+  }
+  return transient_resource_create_scoped(
+      ctx->instance_get(),
+      ctx->device_get(),
+      ctx->queue_scheduler_get(),
+      label,
+      create,
+      [](const bool /*valid*/) {});
+}
+
+wgpu::TextureView WGPUTexture::attachment_view(
+    int mip, int layer, const TextureViewValidationScope validation_scope) const
+{
+  ResolvedReadRegion region;
+  if (!subresources_.valid() ||
+      !(subresources_.texture.GetUsage() & wgpu::TextureUsage::RenderAttachment) ||
+      !resolve_subresource(mip, layer, region) || region.depth != 1)
+  {
+    return nullptr;
+  }
+  wgpu::TextureViewDescriptor d = {};
+  d.format = subresources_.view_format;
+  d.dimension = (subresources_.texture.GetDimension() == wgpu::TextureDimension::e3D) ?
+                    wgpu::TextureViewDimension::e3D :
+                    wgpu::TextureViewDimension::e2D;
+  d.baseMipLevel = region.mip_level;
+  d.mipLevelCount = 1;
+  if (d.dimension != wgpu::TextureViewDimension::e3D) {
+    d.baseArrayLayer = region.origin_z;
+    d.arrayLayerCount = 1;
+  }
+  /* A combined depth-stencil render attachment needs the combined view. Sampling
+   * and readback continue to use the range's selected single aspect. */
+  d.aspect = (subresources_.backing_format == wgpu::TextureFormat::Depth32FloatStencil8 ||
+              subresources_.backing_format == wgpu::TextureFormat::Depth24PlusStencil8) ?
+                 wgpu::TextureAspect::All :
+                 subresources_.aspect;
+  return create_view_scoped(d, "texture attachment view", validation_scope);
+}
+
+uint32_t WGPUTexture::attachment_depth_slice(int mip, int layer) const
+{
+  ResolvedReadRegion region;
+  if (subresources_.texture.GetDimension() != wgpu::TextureDimension::e3D ||
+      !resolve_subresource(mip, layer, region) || region.depth != 1)
+  {
+    return wgpu::kDepthSliceUndefined;
+  }
+  return region.origin_z;
+}
+
+uint32_t WGPUTexture::attachment_layer_count(int mip) const
+{
+  ResolvedReadRegion region;
+  return resolve_subresource(mip, -1, region) ? region.depth : 0u;
+}
+
+wgpu::TextureView WGPUTexture::sampled_attachment_view(
+    int mip, int layer, const TextureViewValidationScope validation_scope) const
+{
+  ResolvedReadRegion region;
+  if (!subresources_.valid() ||
+      !(subresources_.texture.GetUsage() & wgpu::TextureUsage::TextureBinding) ||
+      !resolve_subresource(mip, layer, region) || region.depth != 1)
+  {
+    return nullptr;
+  }
+  SubresourceRange sampled_range = subresources_;
+  if (sampled_range.aspect == wgpu::TextureAspect::All &&
+      (format_flag_ & GPU_FORMAT_DEPTH))
+  {
+    sampled_range.aspect = wgpu::TextureAspect::DepthOnly;
+  }
+  wgpu::TextureViewDescriptor d = {};
+  d.format = aspect_view_format(sampled_range);
+  d.dimension = (subresources_.texture.GetDimension() == wgpu::TextureDimension::e3D) ?
+                    wgpu::TextureViewDimension::e3D :
+                    wgpu::TextureViewDimension::e2D;
+  d.baseMipLevel = region.mip_level;
+  d.mipLevelCount = 1;
+  if (d.dimension != wgpu::TextureViewDimension::e3D) {
+    d.baseArrayLayer = region.origin_z;
+    d.arrayLayerCount = 1;
+  }
+  d.aspect = sampled_range.aspect;
+  return create_view_scoped(d, "sampled texture attachment view", validation_scope);
+}
+
+wgpu::TextureView WGPUTexture::image_view()
+{
+  /* Storage-image binds frequently use GPU_texture_create_view for one mip of a
+   * source texture (the generic 2D mipmap compute binds mip_in/out1/out2 this way).
+   * A Blender texture view owns no device texture; resolve its aliased source just
+   * like sampled_view does. Returning null dropped all three storage-texture entries
+   * and left only the compute UBO in a layout that expected four entries. */
+  if (!subresources_.valid()) {
+    return nullptr;
+  }
+  /* A storage-image binding requires a SINGLE mip level and a non-cube view
+   * dimension (WebGPU forbids cube storage textures; none exist at the pin). */
+  wgpu::TextureViewDimension dim = to_wgpu_view_dimension(type_);
+  if (dim == wgpu::TextureViewDimension::Cube ||
+      dim == wgpu::TextureViewDimension::CubeArray)
+  {
+    dim = wgpu::TextureViewDimension::e2DArray;
+  }
+  wgpu::TextureViewDescriptor d = {};
+  d.format = subresources_.view_format;
+  d.dimension = dim;
+  d.baseMipLevel = subresources_.base_mip;
+  d.mipLevelCount = 1;
+  d.baseArrayLayer = subresources_.base_layer;
+  if (dim == wgpu::TextureViewDimension::e2D) {
+    d.arrayLayerCount = 1;
+  }
+  else if (dim == wgpu::TextureViewDimension::e2DArray) {
+    /* Texture::init_view stores the requested subset length in this view's
+     * layer_count(). Do not expose all source layers after baseArrayLayer: a
+     * 4-layer source viewed as start=2,len=1 must remain exactly one layer. Base
+     * cube types are collapsed to e2DArray above and store their face count in d_. */
+    d.arrayLayerCount = subresources_.layer_count;
+  }
+  /* Native 2D and 2D-array/cube-array views now carry explicit, exact layer
+   * counts. Other dimensions retain their existing defaults. */
+  d.aspect = subresources_.aspect;
+  return create_view_scoped(d, "storage texture view");
+}
+
+wgpu::TextureView WGPUTexture::sampled_view(wgpu::TextureViewDimension override_dim)
+{
+  /* Views pin their backing handle and carry flattened mip/layer offsets, so binding
+   * remains valid after the source Blender wrapper is freed. */
+  if (!subresources_.valid()) {
+    return nullptr;
+  }
+  /* Whole-texture sampled view (all mips + layers from the offset) at the native view
+   * dimension. Cube textures (stored as 2D + 6 layers) get an explicit Cube view so
+   * WGSL `texture_cube` sampling binds. */
+  SubresourceRange sampled_range = subresources_;
+  if (sampled_range.aspect == wgpu::TextureAspect::All &&
+      (format_flag_ & GPU_FORMAT_DEPTH))
+  {
+    sampled_range.aspect = wgpu::TextureAspect::DepthOnly;
+  }
+  wgpu::TextureViewDescriptor d = {};
+  d.format = aspect_view_format(sampled_range);
+  /* View dimension: the caller may force the dimension the shader's binding declares
+   * (interface map) instead of the texture's native type. DRW fills an unbound sampler
+   * slot with a 1x1 g_dummy_texture_array (GPU_TEXTURE_2D_ARRAY) even where the shader
+   * samples a plain texture_2d, and WebGPU rejects an e2DArray view against an e2D binding
+   * (the M4 viewport-composite blocker: OCIO_Display / 2D-image-rect draws dropped). */
+  const wgpu::TextureViewDimension dim = (override_dim != wgpu::TextureViewDimension::Undefined) ?
+                                             override_dim :
+                                             to_wgpu_view_dimension(type_);
+  d.dimension = dim;
+  d.baseMipLevel = subresources_.base_mip;
+  d.mipLevelCount = subresources_.mip_count;
+  d.baseArrayLayer = subresources_.base_layer;
+  /* A non-array (single-plane) view must expose EXACTLY one layer — the UNDEFINED default
+   * takes all remaining layers, which Dawn rejects for e2D/e1D/e3D on a multi-layer source
+   * (the array dummy). A genuine array/cube view keeps the default (all layers). */
+  if (dim == wgpu::TextureViewDimension::e2D || dim == wgpu::TextureViewDimension::e1D ||
+      dim == wgpu::TextureViewDimension::e3D)
+  {
+    d.arrayLayerCount = 1;
+  }
+  else {
+    d.arrayLayerCount = subresources_.layer_count;
+  }
+  d.aspect = sampled_range.aspect;
+
+  /* WebGPU's stable TextureComponentSwizzle feature is the direct equivalent of
+   * Vulkan's VkComponentMapping used by GPU_texture_swizzle_set. Apply it only to
+   * sampled views: storage images, attachments, copies, and readback address the
+   * backing channels and deliberately retain identity mapping. */
+  wgpu::TextureComponentSwizzleDescriptor swizzle_desc = {};
+  swizzle_desc.swizzle.r = to_wgpu_component_swizzle(swizzle_[0]);
+  swizzle_desc.swizzle.g = to_wgpu_component_swizzle(swizzle_[1]);
+  swizzle_desc.swizzle.b = to_wgpu_component_swizzle(swizzle_[2]);
+  swizzle_desc.swizzle.a = to_wgpu_component_swizzle(swizzle_[3]);
+  if (swizzle_desc.swizzle.r == wgpu::ComponentSwizzle::Undefined ||
+      swizzle_desc.swizzle.g == wgpu::ComponentSwizzle::Undefined ||
+      swizzle_desc.swizzle.b == wgpu::ComponentSwizzle::Undefined ||
+      swizzle_desc.swizzle.a == wgpu::ComponentSwizzle::Undefined)
+  {
+    return nullptr;
+  }
+  const bool identity = swizzle_desc.swizzle.r == wgpu::ComponentSwizzle::R &&
+                        swizzle_desc.swizzle.g == wgpu::ComponentSwizzle::G &&
+                        swizzle_desc.swizzle.b == wgpu::ComponentSwizzle::B &&
+                        swizzle_desc.swizzle.a == wgpu::ComponentSwizzle::A;
+  if (!identity) {
+    WGPUContext *ctx = active_context();
+    if (ctx == nullptr ||
+        !ctx->device_get().HasFeature(wgpu::FeatureName::TextureComponentSwizzle))
+    {
+      /* A null bind is visible and fail-closed; silently sampling identity channels
+       * would corrupt image alpha, paint masks, volume fields, and EEVEE vectors. */
+      return nullptr;
+    }
+    d.nextInChain = &swizzle_desc;
+  }
+  return create_view_scoped(d, "sampled texture view");
+}
+
+void WGPUTexture::adopt_external(const wgpu::Texture &texture,
+                                 wgpu::TextureFormat wgpu_format,
+                                 int width,
+                                 int height)
+{
+  /* Wrap an externally-owned device texture (the window surface's per-frame
+   * GetCurrentTexture()) as this gpu::Texture. No allocate(): the surface owns the
+   * device texture. Only the fields the framebuffer color path reads are set —
+   * texture_/wgpu_format_ (attachment view + pipeline target format) and w_/h_
+   * (update_size); format_/format_flag_ are set to a plain colour so the depth
+   * branch in begin_load_pass never misfires. */
+  /* A surface wrapper is re-used for successive acquired textures. Purge the old logical
+   * source before replacing its handle so a same-sized new surface texture cannot consume
+   * bytes latched for the previous acquisition. */
+  readback::forget_source(readback::SourceKind::Texture, this);
+  texture_ = texture;
+  subresources_ = {};
+  wgpu_format_ = wgpu_format;
+  conv_ = ConvClass::Direct;
+  source_buffer_ = nullptr;
+  snorm16_emulated_ = false;
+  is_texture_view_ = false;
+  w_ = std::max(width, 1);
+  h_ = std::max(height, 1);
+  d_ = 1;
+  type_ = GPU_TEXTURE_2D;
+  mipmaps_ = 1;
+  mip_min_ = 0;
+  mip_max_ = 0;
+  format_ = TextureFormat::UNORM_8_8_8_8;
+  format_flag_ = GPU_FORMAT_NORMALIZED_INTEGER;
+  gpu_image_usage_flags_ = GPU_TEXTURE_USAGE_ATTACHMENT;
+
+  if (texture_ != nullptr) {
+    subresources_.texture = texture_;
+    subresources_.backing_format = wgpu_format;
+    subresources_.view_format = wgpu_format;
+    subresources_.aspect = wgpu::TextureAspect::All;
+    subresources_.backing_type = GPU_TEXTURE_2D;
+    subresources_.base_mip = 0;
+    subresources_.mip_count = 1;
+    subresources_.base_layer = 0;
+    subresources_.layer_count = 1;
+    subresources_.physical_extent = {uint32_t(w_), uint32_t(h_), 1};
+  }
+}
+
+void WGPUTexture::clear(const double4 data)
+{
+  if (!subresources_.valid()) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+
+  /* Depth/stencil clears use an exact-aspect render pass. Renderable colour clears
+   * also use a render pass so direct clears follow the backing format while FBO
+   * clears follow the attachment view format. Only non-renderable colour formats
+   * fall back to a packed host texel replicated with WriteTexture. */
+  if (format_flag_ & GPU_FORMAT_DEPTH) {
+    /* Depth/stencil clear to a uniform value: a render pass with only a
+     * depth-stencil attachment and loadOp=Clear (no draw, no pipeline, no shader).
+     * Requires RenderAttachment usage (GPU_TEXTURE_USAGE_ATTACHMENT). Proven live
+     * in sandbox/wgpu-texture-formats/ (Depth32Float clear+readback). */
+    wgpu::Device device = ctx->device_get();
+    /* GPU_texture_clear is defined for relative mip zero only. For a view this is
+     * its absolute base mip; mip_range_set controls sampling and must not widen a
+     * direct clear. */
+    constexpr int mip = 0;
+    webgpu::command_encode_submit_scoped(
+        ctx->instance_get(),
+        device,
+        ctx->queue_get(),
+        ctx->queue_scheduler_get(),
+        "depth texture clear",
+        [&](auto &encoder) {
+              const uint32_t layers = ELEM(subresources_.backing_type,
+                                           GPU_TEXTURE_1D_ARRAY,
+                                           GPU_TEXTURE_2D_ARRAY,
+                                           GPU_TEXTURE_CUBE,
+                                           GPU_TEXTURE_CUBE_ARRAY) ?
+                                          subresources_.layer_count :
+                                          1u;
+              for (uint32_t layer = 0; layer < layers; layer++) {
+                wgpu::TextureView view = attachment_view(
+                    mip, int(layer), TextureViewValidationScope::EnclosingCommand);
+                if (view == nullptr) {
+                  return false;
+                }
+                wgpu::RenderPassDepthStencilAttachment dsa = {};
+                dsa.view = view;
+                /* Match public Texture::clear: root, DepthOnly, and StencilOnly wrappers of
+                 * a combined format all clear the backing depth plane over relative mip zero
+                 * and the wrapper's exact layer range. `use_stencil` selects sampler
+                 * interpretation; it does not change public direct-clear semantics.
+                 * Framebuffer clear APIs are the distinct path that may mutate stencil.
+                 * Never inspect data[1], which is not part of this direct contract. */
+                dsa.depthLoadOp = wgpu::LoadOp::Clear;
+                dsa.depthStoreOp = wgpu::StoreOp::Store;
+                dsa.depthClearValue = std::isfinite(float(data[0])) ? float(data[0]) : 1.0f;
+                if (subresources_.backing_format ==
+                        wgpu::TextureFormat::Depth32FloatStencil8 ||
+                    subresources_.backing_format == wgpu::TextureFormat::Depth24PlusStencil8)
+                {
+                  dsa.stencilLoadOp = wgpu::LoadOp::Load;
+                  dsa.stencilStoreOp = wgpu::StoreOp::Store;
+                  dsa.stencilClearValue = 0u;
+                }
+                wgpu::RenderPassDescriptor rp = {};
+                rp.depthStencilAttachment = &dsa;
+                wgpu::RenderPassEncoder pass = encoder.BeginRenderPass(&rp);
+                if (pass == nullptr) {
+                  return false;
+                }
+                pass.End();
+              }
+          return true;
+        },
+        [](bool) {});
+    return;
+  }
+
+  const Repr repr = snorm16_emulated_ ? Repr::Snorm16 : repr_of(format_);
+  if (repr == Repr::Compressed || repr == Repr::Unsupported) {
+    return;
+  }
+  const int logical = to_component_len(format_);
+  const int channels = device_channels(format_, conv_);
+  const uint32_t texel_bytes = device_texel_bytes(format_, conv_, repr);
+  const bool integer = repr_is_integer(repr);
+  bool logical_components_finite = true;
+  for (int c = 0; c < logical; c++) {
+    logical_components_finite &= std::isfinite(data[c]);
+  }
+
+  /* A format view selects its relative mip-zero/layer subresource, but numeric
+   * conversion follows the backing image format. Framebuffer attachment clears
+   * remain view-format operations and use attachment_view() in WGPUFrameBuffer. */
+  const bool can_render_clear =
+      bool(subresources_.texture.GetUsage() & wgpu::TextureUsage::RenderAttachment) &&
+      subresources_.backing_type != GPU_TEXTURE_1D && logical_components_finite;
+  if (can_render_clear) {
+    wgpu::Device device = ctx->device_get();
+    /* Public direct clears affect relative mip zero only. */
+    constexpr int mip = 0;
+    webgpu::command_encode_submit_scoped(
+        ctx->instance_get(),
+        device,
+        ctx->queue_get(),
+        ctx->queue_scheduler_get(),
+        "renderable texture clear",
+        [&](auto &encoder) {
+              ResolvedReadRegion mip_region;
+              if (!resolve_subresource(mip, -1, mip_region)) {
+                return false;
+              }
+              const uint32_t layers = subresources_.backing_type == GPU_TEXTURE_3D ?
+                                          mip_region.depth :
+                                      ELEM(subresources_.backing_type,
+                                           GPU_TEXTURE_1D_ARRAY,
+                                           GPU_TEXTURE_2D_ARRAY,
+                                           GPU_TEXTURE_CUBE,
+                                           GPU_TEXTURE_CUBE_ARRAY) ?
+                                          subresources_.layer_count :
+                                          1u;
+              for (uint32_t layer = 0; layer < layers; layer++) {
+                ResolvedReadRegion clear_region;
+                if (!resolve_subresource(mip, int(layer), clear_region) ||
+                    clear_region.depth != 1)
+                {
+                  return false;
+                }
+                wgpu::TextureViewDescriptor view_desc = {};
+                view_desc.format = subresources_.backing_format;
+                view_desc.dimension =
+                    (subresources_.texture.GetDimension() == wgpu::TextureDimension::e3D) ?
+                        wgpu::TextureViewDimension::e3D :
+                        wgpu::TextureViewDimension::e2D;
+                view_desc.baseMipLevel = clear_region.mip_level;
+                view_desc.mipLevelCount = 1;
+                if (view_desc.dimension != wgpu::TextureViewDimension::e3D) {
+                  view_desc.baseArrayLayer = clear_region.origin_z;
+                  view_desc.arrayLayerCount = 1;
+                }
+                view_desc.aspect = wgpu::TextureAspect::All;
+                wgpu::TextureView view = create_view_scoped(
+                    view_desc,
+                    "renderable texture clear view",
+                    TextureViewValidationScope::EnclosingCommand);
+                if (view == nullptr) {
+                  return false;
+                }
+                wgpu::RenderPassColorAttachment color = {};
+                color.view = view;
+                color.depthSlice = attachment_depth_slice(mip, int(layer));
+                color.loadOp = wgpu::LoadOp::Clear;
+                color.storeOp = wgpu::StoreOp::Store;
+                color.clearValue = {logical > 0 ? data[0] : 0.0,
+                                    logical > 1 ? data[1] : 0.0,
+                                    logical > 2 ? data[2] : 0.0,
+                                    logical > 3 ? data[3] : 1.0};
+                wgpu::RenderPassDescriptor rp = {};
+                rp.colorAttachmentCount = 1;
+                rp.colorAttachments = &color;
+                wgpu::RenderPassEncoder pass = encoder.BeginRenderPass(&rp);
+                if (pass == nullptr) {
+                  return false;
+                }
+                pass.End();
+              }
+          return true;
+        },
+        [](bool) {});
+    return;
+  }
+
+  /* Build a single clear texel in the device layout. */
+  std::vector<uint8_t> texel(texel_bytes, 0);
+  if (repr == Repr::PackedR11G11B10) {
+    const auto finite_or_zero = [](const double value) {
+      return std::isfinite(value) ? float(value) : 0.0f;
+    };
+    uint32_t packed = pack_r11g11b10_ufloat(
+        finite_or_zero(data[0]), finite_or_zero(data[1]), finite_or_zero(data[2]));
+    std::memcpy(texel.data(), &packed, 4);
+  }
+  else if (repr == Repr::PackedRGB9E5) {
+    const uint32_t packed =
+        pack_rgb9e5_ufloat(float(data[0]), float(data[1]), float(data[2]));
+    std::memcpy(texel.data(), &packed, 4);
+  }
+  else {
+    const uint32_t dbytes = repr_comp_bytes(repr);
+    const bool encode_srgb =
+        subresources_.backing_format == wgpu::TextureFormat::RGBA8UnormSrgb;
+    for (int c = 0; c < channels; c++) {
+      uint8_t *dc = texel.data() + size_t(c) * dbytes;
+      double v = (c < logical) ? data[c] : 1.0;
+      /* F16/F32 can represent non-finite debug sentinels exactly enough for
+       * WriteTexture. Integer and normalized formats cannot, so use zero rather
+       * than feeding NaN through an undefined numeric conversion. */
+      if (!std::isfinite(v) && !ELEM(repr, Repr::F16, Repr::F32)) {
+        v = 0.0;
+      }
+      if (integer) {
+        dev_write_int(dc, repr, int64_t(v));
+      }
+      else if (encode_srgb && c < 3) {
+        /* A 1D WebGPU texture cannot be a render attachment. Apply the same OETF
+         * before WriteTexture that an sRGB render-pass clear applies in hardware. */
+        dc[0] = srgb_clear_component_to_unorm8(float(v));
+      }
+      else {
+        dev_write_float(dc, repr, float(v));
+      }
+    }
+  }
+
+  /* Public direct clears affect relative mip zero only, including through a view. */
+  constexpr int mip = 0;
+  {
+    ResolvedReadRegion region;
+    if (!resolve_subresource(mip, -1, region)) {
+      return;
+    }
+    const uint32_t ex = region.width;
+    const uint32_t ey = region.height;
+    const uint32_t ez = region.depth;
+    TextureUploadLayout clear_layout;
+    if (!texture_upload_layout(
+            ex, ey, ez, texel_bytes, texel_bytes, 0, clear_layout))
+    {
+      return;
+    }
+
+    std::vector<uint8_t> buffer(clear_layout.device_data_size);
+    for (size_t i = 0; i < clear_layout.sample_count; i++) {
+      std::memcpy(buffer.data() + i * texel_bytes, texel.data(), texel_bytes);
+    }
+
+    wgpu::TexelCopyTextureInfo dst = {};
+    dst.texture = region.texture;
+    dst.mipLevel = region.mip_level;
+    dst.origin = {region.origin_x, region.origin_y, region.origin_z};
+    dst.aspect = wgpu::TextureAspect::All;
+
+    wgpu::TexelCopyBufferLayout layout = {};
+    layout.offset = 0;
+    layout.bytesPerRow = clear_layout.bytes_per_row;
+    layout.rowsPerImage = ey;
+
+    wgpu::Extent3D write_size = {ex, ey, ez};
+    webgpu::queue_write_texture_scoped(ctx->instance_get(),
+                                       ctx->device_get(),
+                                       ctx->queue_get(),
+                                       ctx->queue_scheduler_get(),
+                                       dst,
+                                       buffer.data(),
+                                       buffer.size(),
+                                       layout,
+                                       write_size,
+                                       "raw texture clear",
+                                       [](bool) {});
+  }
+}
+
+/** \} */
+
+/* -------------------------------------------------------------------- */
+/** \name Read / copy / mipmap / view state
+ * \{ */
+
+bool WGPUTexture::resolve_read_region(int mip, ResolvedReadRegion &r_region) const
+{
+  return resolve_read_region(mip, -1, r_region);
+}
+
+bool WGPUTexture::resolve_read_region(int mip,
+                                      int layer,
+                                      ResolvedReadRegion &r_region) const
+{
+  if (!resolve_subresource(mip, layer, r_region)) {
+    return false;
+  }
+  if (r_region.aspect == wgpu::TextureAspect::All && (format_flag_ & GPU_FORMAT_DEPTH)) {
+    r_region.aspect = wgpu::TextureAspect::DepthOnly;
+  }
+  return true;
+}
+
+bool WGPUTexture::resolve_subresource(int mip,
+                                      int layer,
+                                      ResolvedReadRegion &r_region) const
+{
+  if (!subresources_.valid() || mip < 0 || uint32_t(mip) >= subresources_.mip_count ||
+      layer < -1)
+  {
+    return false;
+  }
+  const uint32_t absolute_mip = subresources_.base_mip + uint32_t(mip);
+  if (absolute_mip >= subresources_.texture.GetMipLevelCount()) {
+    return false;
+  }
+  const wgpu::Extent3D physical = physical_extent_at(subresources_.texture,
+                                                     subresources_.backing_type,
+                                                     absolute_mip,
+                                                     subresources_.layer_count);
+
+  r_region = {};
+  r_region.texture = subresources_.texture;
+  r_region.mip_level = absolute_mip;
+  r_region.width = physical.width;
+  r_region.height = physical.height;
+  r_region.depth = physical.depthOrArrayLayers;
+  r_region.aspect = subresources_.aspect;
+
+  switch (subresources_.backing_type) {
+    case GPU_TEXTURE_1D_ARRAY:
+    case GPU_TEXTURE_2D_ARRAY:
+    case GPU_TEXTURE_CUBE:
+    case GPU_TEXTURE_CUBE_ARRAY:
+      if (layer >= 0 && uint32_t(layer) >= subresources_.layer_count) {
+        return false;
+      }
+      r_region.origin_z = subresources_.base_layer + uint32_t(std::max(layer, 0));
+      r_region.depth = (layer >= 0) ? 1u : subresources_.layer_count;
+      break;
+    case GPU_TEXTURE_3D:
+      if (layer >= 0 && uint32_t(layer) >= physical.depthOrArrayLayers) {
+        return false;
+      }
+      if (layer >= 0) {
+        r_region.origin_z = uint32_t(layer);
+        r_region.depth = 1;
+      }
+      break;
+    case GPU_TEXTURE_1D:
+      r_region.height = 1;
+      r_region.depth = 1;
+      break;
+    case GPU_TEXTURE_2D:
+    default:
+      if (layer > 0) {
+        return false;
+      }
+      r_region.depth = 1;
+      break;
+  }
+
+  const uint32_t backing_depth = (subresources_.texture.GetDimension() ==
+                                  wgpu::TextureDimension::e3D) ?
+                                     mip_dimension(subresources_.texture.GetDepthOrArrayLayers(),
+                                                   absolute_mip) :
+                                     subresources_.texture.GetDepthOrArrayLayers();
+  if (r_region.origin_z > backing_depth || r_region.depth > backing_depth - r_region.origin_z)
+  {
+    return false;
+  }
+  return true;
+}
+
+GPUReadback *WGPUTexture::read_async(const int mip, const eGPUDataFormat format)
+{
+  return read_sub_async(mip, -1, format);
+}
+
+GPUReadback *WGPUTexture::read_sub_async(const int mip,
+                                        const int layer,
+                                        const eGPUDataFormat format)
+{
+#ifndef __EMSCRIPTEN__
+  /* Native backends can block safely and retain the established synchronous
+   * conversion path. The browser path below is the no-wait exact ticket path. */
+  if (layer < 0) {
+    return Texture::read_async(mip, format);
+  }
+  ResolvedReadRegion resolved;
+  if (!resolve_read_region(mip, layer, resolved)) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  const size_t sample_size = to_bytesize(format_, format);
+  size_t sample_count = size_t(resolved.width);
+  if (resolved.height != 0 && sample_count > std::numeric_limits<size_t>::max() / resolved.height)
+  {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  sample_count *= resolved.height;
+  if (resolved.depth != 0 && sample_count > std::numeric_limits<size_t>::max() / resolved.depth) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  sample_count *= resolved.depth;
+  if (sample_size == 0 || sample_count > std::numeric_limits<size_t>::max() / sample_size) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  std::vector<unsigned char> bytes(sample_count * sample_size);
+  read_sub(mip, layer, format, bytes.data());
+  return gpu_readback_create_ready(std::move(bytes));
+#else
+  ResolvedReadRegion resolved;
+  if (!resolve_read_region(mip, layer, resolved)) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  const Repr repr = snorm16_emulated_ ? Repr::Snorm16 : repr_of(format_);
+  if (repr == Repr::Compressed || repr == Repr::Unsupported) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_UNSUPPORTED_FORMAT);
+  }
+  if (repr == Repr::Packed32 && format != GPU_DATA_2_10_10_10_REV) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_UNSUPPORTED_FORMAT);
+  }
+  if ((format_flag_ & GPU_FORMAT_DEPTH) &&
+      resolved.aspect != wgpu::TextureAspect::StencilOnly && format != GPU_DATA_FLOAT)
+  {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_UNSUPPORTED_FORMAT);
+  }
+  if (resolved.aspect == wgpu::TextureAspect::StencilOnly &&
+      format == GPU_DATA_UINT_24_8_DEPRECATED)
+  {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_UNSUPPORTED_FORMAT);
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_SOURCE_UNAVAILABLE);
+  }
+
+  const uint32_t texel_bytes = (resolved.aspect == wgpu::TextureAspect::StencilOnly) ?
+                                   1u :
+                                   device_texel_bytes(format_, conv_, repr);
+  const size_t host_texel_bytes = to_bytesize(format_, format);
+  wgpu::Limits limits = {};
+  TextureReadbackLayout layout;
+  if (!ctx->device_get().GetLimits(&limits) ||
+      !texture_readback_layout(resolved.width,
+                               resolved.height,
+                               resolved.depth,
+                               texel_bytes,
+                               host_texel_bytes,
+                               limits.maxBufferSize,
+                               layout))
+  {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+
+  const readback::TextureRegion region{resolved.mip_level,
+                                       resolved.origin_x,
+                                       resolved.origin_y,
+                                       resolved.origin_z,
+                                       resolved.width,
+                                       resolved.height,
+                                       resolved.depth,
+                                       resolved.aspect};
+  const readback::SourceKey key{readback::SourceKind::Texture,
+                                this,
+                                uint64_t(region.mip_level),
+                                uint64_t(layout.device_data_size),
+                                region.origin_x,
+                                region.origin_y,
+                                region.origin_z,
+                                region.width,
+                                region.height,
+                                region.depth,
+                                uint8_t(region.aspect)};
+  const readback::Ticket ticket = readback::kick_texture(ctx->instance_get(),
+                                                         ctx->device_get(),
+                                                         ctx->queue_get(),
+                                                         ctx->queue_scheduler_get(),
+                                                         resolved.texture,
+                                                         key,
+                                                         region,
+                                                         texel_bytes,
+                                                         layout.bytes_per_row,
+                                                         layout.row_bytes,
+                                                         readback::RequestMode::Exact);
+  if (ticket == readback::kInvalidTicket) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_CAPACITY_EXCEEDED,
+                                      layout.host_data_size);
+  }
+  return MEM_new<WGPUTextureReadback>(__func__,
+                                      ticket,
+                                      format_,
+                                      conv_,
+                                      snorm16_emulated_,
+                                      resolved.aspect,
+                                      format,
+                                      layout.sample_count,
+                                      layout.device_data_size,
+                                      layout.host_data_size);
+#endif
+}
+
+void WGPUTexture::read(int mip, eGPUDataFormat format, void *data)
+{
+  read_sub(mip, -1, format, data);
+}
+
+void WGPUTexture::read_sub(int mip, int layer, eGPUDataFormat format, void *data)
+{
+  if (data == nullptr) {
+    return;
+  }
+  ResolvedReadRegion resolved;
+  if (!resolve_read_region(mip, layer, resolved)) {
+    return;
+  }
+  const Repr repr = snorm16_emulated_ ? Repr::Snorm16 : repr_of(format_);
+  if (repr == Repr::Compressed || repr == Repr::Unsupported) {
+    BLI_assert_msg(0, "WGPUTexture::read: compressed / unsupported format readback");
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+
+  const uint32_t ex = resolved.width;
+  const uint32_t ey = resolved.height;
+  const uint32_t ez = resolved.depth;
+  const uint32_t texel_bytes = (resolved.aspect == wgpu::TextureAspect::StencilOnly) ?
+                                   1u :
+                                   device_texel_bytes(format_, conv_, repr);
+  const size_t host_texel_bytes = to_bytesize(format_, format);
+  wgpu::Limits limits = {};
+  TextureReadbackLayout layout;
+  if (!ctx->device_get().GetLimits(&limits) ||
+      !texture_readback_layout(
+          ex, ey, ez, texel_bytes, host_texel_bytes, limits.maxBufferSize, layout))
+  {
+    return;
+  }
+
+#ifdef __EMSCRIPTEN__
+  /* Windowed WM-worker profile (ADR-006/007): a synchronous map wait cannot resolve here,
+   * so route through the production kick/latch/settle registry (wgpu_readback) rather than
+   * the blocking WaitAny path below (which is compiled out on this profile). Contract per
+   * notes/m5-sync-readback-contract-design.md section 3.1: return the latched device bytes
+   * when a prior kick for THIS texture+mip has settled (kick-now, fill-one-tick-late), else
+   * kick a fresh HEAP-OWNED readback and deterministically convert a zero-filled device
+   * buffer into `data` (the conservative first-call interim). The old
+   * `MapAsync(WaitAnyOnly)` + `WaitAny` lambda,
+   * which captured the caller stack by reference and could fire after read() returned, does
+   * not exist in the wasm binary, closing M5.readback-callback-lifetime (design section 4). */
+  {
+    std::vector<uint8_t> device_data(layout.device_data_size);
+    const readback::TextureRegion region{resolved.mip_level,
+                                         resolved.origin_x,
+                                         resolved.origin_y,
+                                         resolved.origin_z,
+                                         resolved.width,
+                                         resolved.height,
+                                         resolved.depth,
+                                         resolved.aspect};
+    const readback::SourceKey key{readback::SourceKind::Texture,
+                                  this,
+                                  uint64_t(region.mip_level),
+                                  uint64_t(device_data.size()),
+                                  region.origin_x,
+                                  region.origin_y,
+                                  region.origin_z,
+                                  region.width,
+                                  region.height,
+                                  region.depth,
+                                  uint8_t(region.aspect)};
+    readback::take_settled(key, device_data.data(), device_data.size());
+    readback::kick_texture(ctx->instance_get(),
+                           ctx->device_get(),
+                           ctx->queue_get(),
+                           ctx->queue_scheduler_get(),
+                           resolved.texture,
+                           key,
+                           region,
+                           texel_bytes,
+                           layout.bytes_per_row,
+                           layout.row_bytes);
+    /* device_data is value-initialized, so a miss deterministically returns the documented
+     * conservative zero interim even when the caller did not pre-initialize `data`. */
+    convert_device_to_host(
+        static_cast<uint8_t *>(data), device_data.data(), layout.sample_count, format);
+    return;
+  }
+#else
+  wgpu::Device device = ctx->device_get();
+
+  wgpu::BufferDescriptor bd = {};
+  bd.size = layout.staging_size;
+  bd.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+  wgpu::Buffer staging = device.CreateBuffer(&bd);
+  if (staging == nullptr) {
+    return;
+  }
+
+  wgpu::TexelCopyTextureInfo src = {};
+  src.texture = resolved.texture;
+  src.mipLevel = resolved.mip_level;
+  src.origin = {resolved.origin_x, resolved.origin_y, resolved.origin_z};
+  src.aspect = resolved.aspect;
+
+  wgpu::TexelCopyBufferInfo dst = {};
+  dst.buffer = staging;
+  dst.layout.offset = 0;
+  dst.layout.bytesPerRow = layout.bytes_per_row;
+  dst.layout.rowsPerImage = ey;
+
+  wgpu::Extent3D copy_size = {ex, ey, ez};
+  bool submitted = false;
+  webgpu::command_encode_submit_scoped(ctx->instance_get(),
+                                       device,
+                                       ctx->queue_get(),
+                                       ctx->queue_scheduler_get(),
+                                       "synchronous texture readback",
+                                       [&](auto &encoder) {
+                                         encoder.CopyTextureToBuffer(&src, &dst, &copy_size);
+                                       },
+                                       [&](const bool valid) { submitted = valid; });
+  if (!submitted) {
+    return;
+  }
+
+  bool ok = false;
+  wgpu::Future f = staging.MapAsync(wgpu::MapMode::Read,
+                                    0,
+                                    layout.staging_size,
+                                    wgpu::CallbackMode::WaitAnyOnly,
+                                    [&](wgpu::MapAsyncStatus s, wgpu::StringView) {
+                                      ok = (s == wgpu::MapAsyncStatus::Success);
+                                    });
+  ctx->instance_get().WaitAny(f, UINT64_MAX);
+  if (!ok) {
+    return;
+  }
+  const uint8_t *mapped = static_cast<const uint8_t *>(
+      staging.GetConstMappedRange(0, layout.staging_size));
+  if (mapped == nullptr) {
+    staging.Unmap();
+    return;
+  }
+
+  /* Strip the 256-byte row padding into a tightly-packed device buffer. */
+  std::vector<uint8_t> device_data(layout.device_data_size);
+  for (uint32_t z = 0; z < ez; z++) {
+    for (uint32_t y = 0; y < ey; y++) {
+      const uint8_t *s = mapped + (size_t(z) * ey + y) * layout.bytes_per_row;
+      uint8_t *d = device_data.data() + (size_t(z) * ey + y) * ex * texel_bytes;
+      std::memcpy(d, s, layout.row_bytes);
+    }
+  }
+  staging.Unmap();
+
+  convert_device_to_host(
+      static_cast<uint8_t *>(data), device_data.data(), layout.sample_count, format);
+#endif /* __EMSCRIPTEN__ */
+}
+
+/* -------------------------------------------------------------------- */
+void WGPUTexture::copy_to(Texture *tex, IndexRange mip_levels)
+{
+  WGPUTexture *dst = static_cast<WGPUTexture *>(tex);
+  BLI_assert_msg(!is_texture_view() && (dst == nullptr || !dst->is_texture_view()),
+                 "WGPUTexture::copy_to is root-only; copy a view through a framebuffer blit");
+  if (is_texture_view() || dst == nullptr || dst->is_texture_view() ||
+      !subresources_.valid() || !dst->subresources_.valid())
+  {
+    return;
+  }
+  const bool copy_formats_compatible =
+      subresources_.backing_format == dst->subresources_.backing_format ||
+      srgb_view_format_pair(subresources_.backing_format) == dst->subresources_.backing_format;
+  BLI_assert_msg(copy_formats_compatible,
+                 "WGPUTexture::copy_to requires equal or linear/sRGB-paired formats");
+  if (!copy_formats_compatible ||
+      subresources_.texture.GetDimension() != dst->subresources_.texture.GetDimension() ||
+      subresources_.texture.GetSampleCount() != dst->subresources_.texture.GetSampleCount())
+  {
+    return;
+  }
+  if (mip_levels.is_empty()) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  webgpu::command_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "texture copy",
+      [&](auto &encoder) {
+            for (const int64_t mip : mip_levels) {
+              ResolvedReadRegion src_region;
+              ResolvedReadRegion dst_region;
+              if (!resolve_subresource(int(mip), -1, src_region) ||
+                  !dst->resolve_subresource(int(mip), -1, dst_region) ||
+                  src_region.width != dst_region.width ||
+                  src_region.height != dst_region.height ||
+                  src_region.depth != dst_region.depth)
+              {
+                continue;
+              }
+              const bool combined_depth_stencil =
+                  subresources_.backing_format == wgpu::TextureFormat::Depth32FloatStencil8 ||
+                  subresources_.backing_format == wgpu::TextureFormat::Depth24PlusStencil8;
+              const wgpu::TextureAspect copy_aspect = combined_depth_stencil ?
+                                                          wgpu::TextureAspect::All :
+                                                          src_region.aspect;
+
+              wgpu::TexelCopyTextureInfo s = {};
+              s.texture = src_region.texture;
+              s.mipLevel = src_region.mip_level;
+              s.origin = {src_region.origin_x, src_region.origin_y, src_region.origin_z};
+              s.aspect = copy_aspect;
+
+              wgpu::TexelCopyTextureInfo d = {};
+              d.texture = dst_region.texture;
+              d.mipLevel = dst_region.mip_level;
+              d.origin = {dst_region.origin_x, dst_region.origin_y, dst_region.origin_z};
+              d.aspect = copy_aspect;
+
+              wgpu::Extent3D size = {
+                  src_region.width, src_region.height, src_region.depth};
+              encoder.CopyTextureToTexture(&s, &d, &size);
+            }
+      },
+      [](bool) {});
+}
+
+void WGPUTexture::generate_mipmap()
+{
+  BLI_assert_msg(!is_texture_view(),
+                 "WGPUTexture::generate_mipmap is root-only; views cannot own a mip chain");
+  if (is_texture_view() || !subresources_.valid() || subresources_.mip_count <= 1) {
+    return;
+  }
+  if (ELEM(type_, GPU_TEXTURE_1D, GPU_TEXTURE_3D)) {
+    /* Mandatory follow-up 0147 supplies native-fidelity plain-1D/3D mip chains
+     * (and plain-1D sRGB clear); 0143-A is the EEVEE view + physical-1D-array
+     * dependency and never substitutes an incomplete chain for those roots. */
+    return;
+  }
+  const Repr repr = snorm16_emulated_ ? Repr::Snorm16 : repr_of(format_);
+  if (repr == Repr::Compressed || repr == Repr::Depth32F || repr == Repr::Depth32FS8 ||
+      repr == Repr::Unsupported ||
+      !(subresources_.texture.GetUsage() & wgpu::TextureUsage::TextureBinding) ||
+      !(subresources_.texture.GetUsage() & wgpu::TextureUsage::RenderAttachment))
+  {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+
+  /* WebGPU has no GenerateMipmap command. Render one exact mip/layer view at a time. The source
+   * view exposes one mip, so textureLoad always addresses level zero. Normalized and float
+   * textures use Blender's native 1/2/3-tap separable kernel so odd edges are not discarded. */
+  const bool integer = (format_flag_ & GPU_FORMAT_INTEGER) != 0 || snorm16_emulated_;
+  std::string wgsl_source;
+  if (!integer) {
+    wgsl_source = mipmap_float_shader_source();
+  }
+  else {
+    const bool signed_integer = (format_flag_ & GPU_FORMAT_SIGNED) != 0 && !snorm16_emulated_;
+    const char *sample_type = signed_integer ? "i32" : "u32";
+    const char *vec_type = signed_integer ? "vec4i" : "vec4u";
+    const char *quarter = signed_integer ? "4" : "4u";
+    wgsl_source =
+        "struct VOut { @builtin(position) pos : vec4f, };\n"
+        "@vertex fn vs_main(@builtin(vertex_index) vid : u32) -> VOut {\n"
+        "  var o : VOut;\n"
+        "  let x = f32((vid << 1u) & 2u);\n"
+        "  let y = f32(vid & 2u);\n"
+        "  o.pos = vec4f(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);\n"
+        "  return o;\n"
+        "}\n@group(0) @binding(0) var src_tex : texture_2d<" +
+        std::string(sample_type) + ">;\n@fragment fn fs_main(i : VOut) -> @location(0) " + vec_type +
+        " {\n"
+        "  let dims = textureDimensions(src_tex);\n"
+        "  let p = vec2u(i.pos.xy) * 2u;\n"
+        "  let hi = dims - vec2u(1u);\n"
+        "  let a = textureLoad(src_tex, vec2i(min(p, hi)), 0);\n"
+        "  let b = textureLoad(src_tex, vec2i(min(p + vec2u(1u, 0u), hi)), 0);\n"
+        "  let c = textureLoad(src_tex, vec2i(min(p + vec2u(0u, 1u), hi)), 0);\n"
+        "  let d = textureLoad(src_tex, vec2i(min(p + vec2u(1u, 1u), hi)), 0);\n"
+        "  return (a + b + c + d) / " + quarter + ";\n}\n";
+  }
+
+  wgpu::ShaderSourceWGSL source = {};
+  source.code = wgsl_source.c_str();
+  wgpu::ShaderModuleDescriptor module_desc = {};
+  module_desc.nextInChain = &source;
+  wgpu::Device device = ctx->device_get();
+  const wgpu::RenderPipeline pipeline = webgpu::transient_resource_create_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_scheduler_get(),
+      "texture mipmap shader/pipeline creation",
+      [&]() {
+        wgpu::ShaderModule module = device.CreateShaderModule(&module_desc);
+        if (module == nullptr) {
+          return wgpu::RenderPipeline{};
+        }
+        wgpu::ColorTargetState target = {};
+        target.format = subresources_.view_format;
+        target.writeMask = wgpu::ColorWriteMask::All;
+        wgpu::FragmentState fragment = {};
+        fragment.module = module;
+        fragment.entryPoint = "fs_main";
+        fragment.targetCount = 1;
+        fragment.targets = &target;
+        wgpu::RenderPipelineDescriptor pipeline_desc = {};
+        pipeline_desc.layout = nullptr;
+        pipeline_desc.vertex.module = module;
+        pipeline_desc.vertex.entryPoint = "vs_main";
+        pipeline_desc.primitive.topology = wgpu::PrimitiveTopology::TriangleList;
+        pipeline_desc.fragment = &fragment;
+        return device.CreateRenderPipeline(&pipeline_desc);
+      },
+      [](bool) {});
+  if (pipeline == nullptr) {
+    return;
+  }
+
+  const uint32_t layers = ELEM(type_,
+                               GPU_TEXTURE_1D_ARRAY,
+                               GPU_TEXTURE_2D_ARRAY,
+                               GPU_TEXTURE_CUBE,
+                               GPU_TEXTURE_CUBE_ARRAY) ?
+                              subresources_.layer_count :
+                              1u;
+  webgpu::command_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "texture mipmap generation",
+      [&](auto &enc) {
+        for (uint32_t mip = 1; mip < subresources_.mip_count; mip++) {
+          for (uint32_t layer = 0; layer < layers; layer++) {
+            wgpu::TextureView src_view = sampled_attachment_view(
+                int(mip - 1), int(layer), TextureViewValidationScope::EnclosingCommand);
+            wgpu::TextureView dst_view = attachment_view(
+                int(mip), int(layer), TextureViewValidationScope::EnclosingCommand);
+            if (src_view == nullptr || dst_view == nullptr) {
+              return false;
+            }
+            wgpu::BindGroupEntry entry = {};
+            entry.binding = 0;
+            entry.textureView = src_view;
+            wgpu::BindGroupDescriptor bind_desc = {};
+            bind_desc.layout = pipeline.GetBindGroupLayout(0);
+            bind_desc.entryCount = 1;
+            bind_desc.entries = &entry;
+            wgpu::BindGroup bind_group = device.CreateBindGroup(&bind_desc);
+            if (bind_group == nullptr) {
+              return false;
+            }
+
+            wgpu::RenderPassColorAttachment color = {};
+            color.view = dst_view;
+            color.loadOp = wgpu::LoadOp::Clear;
+            color.storeOp = wgpu::StoreOp::Store;
+            wgpu::RenderPassDescriptor pass_desc = {};
+            pass_desc.colorAttachmentCount = 1;
+            pass_desc.colorAttachments = &color;
+            wgpu::RenderPassEncoder pass = enc.BeginRenderPass(&pass_desc);
+            if (pass == nullptr) {
+              return false;
+            }
+            pass.SetPipeline(pipeline);
+            pass.SetBindGroup(0, bind_group);
+            pass.Draw(3, 1, 0, 0);
+            pass.End();
+          }
+        }
+        return true;
+      },
+      [](bool) {});
+}
