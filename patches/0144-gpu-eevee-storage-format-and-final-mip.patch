diff --git a/source/blender/draw/engines/eevee/eevee_storage_format.hh b/source/blender/draw/engines/eevee/eevee_storage_format.hh
new file mode 100644
index 0000000..2403ec9
--- /dev/null
+++ b/source/blender/draw/engines/eevee/eevee_storage_format.hh
@@ -0,0 +1,30 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include "GPU_context.hh"
+#include "GPU_texture.hh"
+
+namespace blender::eevee {
+
+/**
+ * Return the physical format used for an EEVEE storage image.
+ *
+ * WebGPU does not support read-write storage access for RG11B10Ufloat. The WebGPU shader backend
+ * therefore promotes RG11B10Ufloat storage declarations to RGBA16Float. Promote the matching
+ * allocations here so the texture and shader layout retain exact format identity. Other backends
+ * keep EEVEE's native packed format.
+ */
+inline gpu::TextureFormat eevee_storage_format(gpu::TextureFormat format)
+{
+  if (GPU_backend_get_type() == GPU_BACKEND_WEBGPU &&
+      format == gpu::TextureFormat::UFLOAT_11_11_10)
+  {
+    return gpu::TextureFormat::SFLOAT_16_16_16_16;
+  }
+  return format;
+}
+
+}  // namespace blender::eevee
