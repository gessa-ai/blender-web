+/** Encode and submit one short-lived command buffer without using a failed encoder or
+ * submitting a failed command-buffer handle. Templated so transient creation failures remain
+ * device-free testable on native and Wasm. */
+template<typename DeviceT, typename QueueT, typename EncodeFn>
+inline bool command_encode_submit_if_valid(const DeviceT &device,
+                                           const QueueT &queue,
+                                           EncodeFn &&encode)
+{
+  auto encoder = device.CreateCommandEncoder();
+  if (encoder == nullptr) {
+    return false;
+  }
+  std::forward<EncodeFn>(encode)(encoder);
+  auto command_buffer = encoder.Finish();
+  if (command_buffer == nullptr) {
+    return false;
+  }
+  queue.Submit(1, &command_buffer);
+  return true;
+}
