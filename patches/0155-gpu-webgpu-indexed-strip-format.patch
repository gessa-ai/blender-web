+wgpu::IndexFormat to_wgpu_strip_index_format(const GPUPrimType prim,
+                                             const wgpu::IndexFormat index_format)
+{
+  if (index_format == wgpu::IndexFormat::Undefined) {
+    return wgpu::IndexFormat::Undefined;
+  }
+  switch (prim) {
+    case GPU_PRIM_LINE_STRIP:
+    case GPU_PRIM_LINE_LOOP:
+    case GPU_PRIM_TRI_STRIP:
+      return index_format;
+    default:
+      /* Dawn requires Undefined for every non-strip topology. */
+      return wgpu::IndexFormat::Undefined;
+  }
+}
