+# OpenUSD can build its scene-description core without either Imaging or its
+# vendored Boost.Python bindings. Keep native builds unchanged by default, but
+# let constrained platforms select the faithful core IO capability explicitly.
+if(NOT DEFINED USD_HAS_IMAGING)
+  set(USD_HAS_IMAGING ON)
+endif()
+if(NOT DEFINED USD_HAS_PYTHON_HOOKS)
+  set(USD_HAS_PYTHON_HOOKS ON)
+endif()
+
+if(USD_HAS_IMAGING)
+  add_definitions(-DWITH_USD_IMAGING)
+  list(APPEND SRC intern/usd_reader_shape.cc)
+endif()
+
+if(USD_HAS_PYTHON_HOOKS)
+  add_definitions(-DWITH_USD_PYTHON_HOOKS)
+  list(APPEND SRC intern/usd_hook.cc)
+else()
+  list(APPEND SRC intern/usd_hook_stub.cc)
+endif()
+
 if(WITH_HYDRA)
   list(APPEND SRC
     hydra/camera_delegate.cc
diff --git a/source/blender/io/usd/intern/usd_hook_stub.cc b/source/blender/io/usd/intern/usd_hook_stub.cc
new file mode 100644
index 00000000000..a9daece1b96
--- /dev/null
+++ b/source/blender/io/usd/intern/usd_hook_stub.cc
@@ -0,0 +1,111 @@
+/* SPDX-FileCopyrightText: 2023 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/io/usd/intern/usd_hook.cc @ fbe6228777e7. */
+
+#include "usd_hook.hh"
+
+#include "usd_api_hook.hh"
+
+#include "BLI_utildefines.h"
+
+#include "BKE_report.hh"
+
+#include <algorithm>
+#include <list>
+#include <memory>
+
+namespace blender::io::usd {
+
+using USDHookList = std::list<std::unique_ptr<USDHook>>;
+
+static USDHookList &hook_list()
+{
+  static USDHookList hooks{};
+  return hooks;
+}
+
+void USD_register_hook(std::unique_ptr<USDHook> hook)
+{
+  if (USD_find_hook_name(hook->idname)) {
+    return;
+  }
+  hook_list().push_back(std::move(hook));
+}
+
+void USD_unregister_hook(const USDHook *hook)
+{
+  hook_list().remove_if(
+      [hook](const std::unique_ptr<USDHook> &item) { return item.get() == hook; });
+}
+
+USDHook *USD_find_hook_name(const char idname[])
+{
+  if (hook_list().empty() || idname == nullptr || idname[0] == '\0') {
+    return nullptr;
+  }
+  const auto hook_iter = std::find_if(
+      hook_list().begin(), hook_list().end(), [idname](const std::unique_ptr<USDHook> &item) {
+        return STREQ(item->idname, idname);
+      });
+  return hook_iter == hook_list().end() ? nullptr : hook_iter->get();
+}
+
+static void report_hooks_unavailable(ReportList *reports)
+{
+  if (!hook_list().empty()) {
+    BKE_report(reports,
+               RPT_ERROR,
+               "USD Python hooks are unavailable in this OpenUSD core-only build");
+  }
+}
+
+void register_hook_converters()
+{
+  /* OpenUSD was built without its Python bindings, so there are no pxr Python
+   * types for Blender's hook context converters to register. */
+}
+
+void call_export_hooks(Depsgraph * /*depsgraph*/,
+                       const USDHierarchyIterator * /*iter*/,
+                       ReportList *reports)
+{
+  report_hooks_unavailable(reports);
+}
+
+void call_material_export_hooks(pxr::UsdStageRefPtr /*stage*/,
+                                Material * /*material*/,
+                                const pxr::UsdShadeMaterial & /*usd_material*/,
+                                const USDExportParams & /*export_params*/,
+                                ReportList *reports)
+{
+  report_hooks_unavailable(reports);
+}
+
+void call_import_hooks(USDStageReader * /*archive*/, ReportList *reports)
+{
+  report_hooks_unavailable(reports);
+}
+
+bool have_material_import_hook(pxr::UsdStageRefPtr /*stage*/,
+                               const pxr::UsdShadeMaterial & /*usd_material*/,
+                               const USDImportParams & /*import_params*/,
+                               ReportList *reports)
+{
+  report_hooks_unavailable(reports);
+  return false;
+}
+
+bool call_material_import_hooks(pxr::UsdStageRefPtr /*stage*/,
+                                Material * /*material*/,
+                                const pxr::UsdShadeMaterial & /*usd_material*/,
+                                const USDImportParams & /*import_params*/,
+                                ReportList *reports)
+{
+  report_hooks_unavailable(reports);
+  return false;
+}
+
+}  // namespace blender::io::usd
