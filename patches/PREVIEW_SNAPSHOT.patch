+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ */
+
+#include "wgpu_query.hh"
+
+#include "BLI_assert.h"
+
+namespace blender::gpu {
+
+void WGPUQueryPool::init(const GPUQueryType type)
+{
+  BLI_assert_msg(!initialized_, "WebGPU query pool is already initialized");
+  BLI_assert_msg(type == GPU_QUERY_OCCLUSION, "Unsupported WebGPU query type");
+  initialized_ = true;
+  query_issued_ = 0;
+  query_active_ = false;
+}
+
+void WGPUQueryPool::begin_query()
+{
+  BLI_assert_msg(initialized_, "Initialize WebGPU query pool before use");
+  BLI_assert_msg(!query_active_, "WebGPU query is already active");
+  if (!initialized_ || query_active_) {
+    return;
+  }
+  query_active_ = true;
+  query_issued_++;
+}
+
+void WGPUQueryPool::end_query()
+{
+  BLI_assert_msg(query_active_, "No WebGPU query is active");
+  if (!query_active_) {
+    return;
+  }
+  query_active_ = false;
+}
+
+void WGPUQueryPool::get_occlusion_result(MutableSpan<uint32_t> r_values)
+{
+  BLI_assert_msg(initialized_, "Initialize WebGPU query pool before use");
+  BLI_assert_msg(!query_active_, "End the active WebGPU query before reading results");
+  BLI_assert_msg(r_values.size() == query_issued_,
+                 "WebGPU query result span does not match the issued query count");
+
+  /* Fail closed. A non-zero placeholder could select an unrelated gizmo. */
+  r_values.fill(0u);
+}
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_query.hh b/source/blender/gpu/webgpu/wgpu_query.hh
