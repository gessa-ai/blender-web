+static void test_texture_webgpu_pixel_buffer_upload()
+{
+  GPU_render_begin();
+  constexpr int width = 7;
+  constexpr int height = 3;
+  constexpr size_t pixel_count = size_t(width) * height;
+  constexpr size_t channel_count = 4;
+  constexpr size_t value_count = pixel_count * channel_count;
+  constexpr size_t byte_size = value_count * sizeof(uint16_t);
+  constexpr uint16_t values[width] = {
+      0x0000, 0x3000, 0x3400, 0x3800, 0x3a00, 0x3c00, 0x4000};
+
+  GPUPixelBuffer *pixel_buffer = GPU_pixel_buffer_create(byte_size);
+  ASSERT_NE(pixel_buffer, nullptr);
+  EXPECT_EQ(GPU_pixel_buffer_size(pixel_buffer), size_t(256));
+
+  uint16_t *mapped = static_cast<uint16_t *>(GPU_pixel_buffer_map(pixel_buffer));
+  ASSERT_NE(mapped, nullptr);
+  uint16_t expected[value_count] = {};
+  for (size_t index = 0; index < pixel_count; index++) {
+    expected[index * channel_count + 0] = values[index % width];
+    expected[index * channel_count + 1] = values[index / width];
+    expected[index * channel_count + 2] = 0x3800; /* 0.5 */
+    expected[index * channel_count + 3] = 0x3c00; /* 1.0 */
+  }
+  memcpy(mapped, expected, byte_size);
+  GPU_pixel_buffer_unmap(pixel_buffer);
+
+  gpu::Texture *texture = GPU_texture_create_2d(__func__,
+                                                width,
+                                                height,
+                                                1,
+                                                TextureFormat::SFLOAT_16_16_16_16,
+                                                GPU_TEXTURE_USAGE_HOST_READ,
+                                                nullptr);
+  ASSERT_NE(texture, nullptr);
+  GPU_texture_update_sub_from_pixel_buffer(
+      texture, GPU_DATA_HALF_FLOAT, pixel_buffer, 0, 0, 0, width, height, 0);
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+
+  uint16_t *readback = static_cast<uint16_t *>(
+      GPU_texture_read(texture, GPU_DATA_HALF_FLOAT, 0));
+  ASSERT_NE(readback, nullptr);
+  for (size_t index = 0; index < value_count; index++) {
+    EXPECT_EQ(readback[index], expected[index]);
+  }
+
+  MEM_delete(readback);
+  GPU_texture_free(texture);
+  GPU_pixel_buffer_free(pixel_buffer);
+  GPU_render_end();
+}
+GPU_WEBGPU_TEST(texture_webgpu_pixel_buffer_upload)
