+static void transcode_i10_field(uint8_t *field)
+{
+  const uint32_t packed = uint32_t(field[0]) | (uint32_t(field[1]) << 8) |
+                          (uint32_t(field[2]) << 16) | (uint32_t(field[3]) << 24);
+  int w = int((packed >> 30) & 0x3u);
+  if (w & 0x2) {
+    w -= 4; /* sign-extend the 2-bit component to [-2, 1]. */
+  }
+  w = (w > 1) ? 1 : (w < -1) ? -1 : w;
+  field[0] = uint8_t(i10_component_to_snorm8(packed));         /* X (low 10 bits) */
+  field[1] = uint8_t(i10_component_to_snorm8(packed >> 10));   /* Y */
+  field[2] = uint8_t(i10_component_to_snorm8(packed >> 20));   /* Z */
+  field[3] = uint8_t(int8_t(w * 127));                         /* W (unused by normals) */
+}
