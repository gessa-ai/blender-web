+    const wmOperatorStatus result = WM_gesture_box_modal(C, op, event);
+    read = view3d_zoom_border_depth_read_find(op);
+    if (read == nullptr) {
+      return result;
+    }
+
+    const eGPUReadbackStatus status = view3d_zoom_border_depth_read_status(read);
+    if (status == GPU_READBACK_READY) {
+      return view3d_zoom_border_depth_read_finish(C, op, read);
+    }
+    if (status != GPU_READBACK_PENDING) {
+      BKE_report(op->reports, RPT_ERROR, "Border depth readback failed");
+      view3d_zoom_border_depth_read_free(C, op, read);
+      return OPERATOR_CANCELLED;
