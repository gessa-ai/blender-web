+      __func__, base, TextureFormat::UINT_32, 0, 1, 0, 1, false, false);
+  EXPECT_EQ(view, nullptr);
+  gpu::Texture *snorm = GPU_texture_create_2d(
+      __func__, 4, 4, 1, TextureFormat::SNORM_16, usage, nullptr);
+  ASSERT_NE(snorm, nullptr);
+  gpu::Texture *emulation_alias = GPU_texture_create_view(
+      __func__, snorm, TextureFormat::UINT_16, 0, 1, 0, 1, false, false);
+  EXPECT_EQ(emulation_alias, nullptr);
+
+  gpu::Texture *rgb = GPU_texture_create_2d(
+      __func__, 4, 4, 1, TextureFormat::UNORM_8_8_8, usage, nullptr);
+  ASSERT_NE(rgb, nullptr);
+  gpu::Texture *rgb_same = GPU_texture_create_view(
+      __func__, rgb, TextureFormat::UNORM_8_8_8, 0, 1, 0, 1, false, false);
+  gpu::Texture *rgb_srgb = GPU_texture_create_view(
+      __func__, rgb, TextureFormat::SRGBA_8_8_8, 0, 1, 0, 1, false, false);
