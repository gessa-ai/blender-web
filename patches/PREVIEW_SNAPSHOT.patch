+static void test_texture_webgpu_film_uniform_history_repeated_updates()
+{
+  using namespace shader;
+  GPU_render_begin();
+
+  constexpr size_t history_offset = offsetof(eevee::UniformData, film) +
+                                    offsetof(eevee::FilmData, use_history);
+  constexpr size_t samples_len_offset = offsetof(eevee::UniformData, film) +
+                                        offsetof(eevee::FilmData, samples_len);
+  constexpr size_t history_block = history_offset / sizeof(uint4);
+  constexpr size_t history_component = (history_offset % sizeof(uint4)) / sizeof(uint);
+  constexpr size_t samples_len_block = samples_len_offset / sizeof(uint4);
+  constexpr size_t samples_len_component = (samples_len_offset % sizeof(uint4)) / sizeof(uint);
+  constexpr size_t probe_block_len = samples_len_block + 1;
+  static_assert(history_offset % sizeof(uint) == 0);
+  static_assert(samples_len_offset % sizeof(uint) == 0);
+  static_assert(probe_block_len * sizeof(uint4) <= sizeof(eevee::UniformData));
+
+  ShaderCreateInfo info("pyGPU_Shader");
+  /* Runtime create-info compilation cannot consume EEVEE's full typedef dependency graph. Use an
+   * array of 16-byte blocks as an exact byte-layout view of the real host UniformData instead. */
+  info.typedef_source_generated = "struct UniformDataProbe { uvec4 words[" +
+                                  std::to_string(probe_block_len) + "]; };\n";
+  info.uniform_buf(0, "UniformDataProbe", "uniform_buf");
+  info.image(0,
+             TextureFormat::UINT_32_32_32_32,
+             Qualifier::read_write,
+             ImageReadWriteType::uimage2D,
+             "result_img");
+  info.local_group_size(1, 1, 1);
+  info.compute_source_generated =
+      "void main() {\n"
+      "  uvec4 result = imageLoad(result_img, ivec2(0));\n"
+      "  uint use_history = uniform_buf.words[" + std::to_string(history_block) + "][" +
+      std::to_string(history_component) + "];\n"
+      "  result.x += use_history;\n"
+      "  result.y = use_history;\n"
+      "  result.z += 1u;\n"
+      "  result.w += uniform_buf.words[" + std::to_string(samples_len_block) + "][" +
+      std::to_string(samples_len_component) + "];\n"
+      "  imageStore(result_img, ivec2(0), result);\n"
+      "}\n";
+
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+
+  constexpr eGPUTextureUsage result_usage = GPU_TEXTURE_USAGE_SHADER_READ |
+                                             GPU_TEXTURE_USAGE_SHADER_WRITE |
+                                             GPU_TEXTURE_USAGE_HOST_READ;
+  gpu::Texture *result_img = GPU_texture_create_2d(__func__,
+                                                   1,
+                                                   1,
+                                                   1,
+                                                   TextureFormat::UINT_32_32_32_32,
+                                                   result_usage,
+                                                   nullptr);
+  ASSERT_NE(result_img, nullptr);
+
+  draw::UniformBuffer<eevee::UniformData> uniform_data("Film UniformData update test");
+
+  class FilmUniformTestPass : public draw::PassSimple {
+   public:
+    FilmUniformTestPass(const char *name) : draw::PassSimple(name) {}
+
+    void submit_for_test()
+    {
+      draw::command::RecordingState state;
+      this->submit(state);
+      state.cleanup();
+    }
+  };
+
+  FilmUniformTestPass pass("Film retained UniformData repeated update");
+  pass.init();
+  pass.shader_set(shader);
+  /* Film binds this wrapper through the retained UniformBuf ** path. Record the pass once, then
+   * update and resubmit it without changing the resource pointer. */
+  pass.bind_ubo("uniform_buf", &uniform_data);
+  pass.bind_image("result_img", result_img);
+  pass.barrier(GPU_BARRIER_SHADER_IMAGE_ACCESS);
+  pass.dispatch(int3(1));
+
+  auto run_dispatches = [&](const uint dispatch_len) {
+    GPU_texture_clear(result_img, GPU_DATA_UINT, uint4(0u));
+    GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+
+    for (uint dispatch = 0; dispatch < dispatch_len; dispatch++) {
+      /* This is the Film accumulation transition: the first sample has no valid history and every
+       * later sample must observe history as valid. Also vary a neighboring FilmData field on
+       * every submit so this covers repeated updates, not only the first 0 -> 1 write. */
+      uniform_data.film.use_history = dispatch != 0;
+      uniform_data.film.samples_len = int(dispatch);
+      uniform_data.push_update();
+      pass.submit_for_test();
+    }
+
+    GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE | GPU_BARRIER_SHADER_IMAGE_ACCESS);
+    uint4 *result = static_cast<uint4 *>(GPU_texture_read(result_img, GPU_DATA_UINT, 0));
+    ASSERT_NE(result, nullptr);
+    EXPECT_EQ(result->x, dispatch_len - 1u);
+    EXPECT_EQ(result->y, 1u);
+    EXPECT_EQ(result->z, dispatch_len);
+    EXPECT_EQ(result->w, dispatch_len * (dispatch_len - 1u) / 2u);
+    MEM_delete(result);
+  };
+
+  run_dispatches(2u);
+  run_dispatches(65u);
+
+  GPU_texture_image_unbind(result_img);
+  GPU_shader_unbind();
+  GPU_texture_free(result_img);
+  GPU_shader_free(shader);
+  GPU_render_end();
+}
