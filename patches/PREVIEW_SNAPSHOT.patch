@@ -0,0 +1,601 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_vertex_buffer.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ */
+
+#include "wgpu_vertex_buffer.hh"
+
+#include "GPU_context.hh"
+#include "gpu_context_private.hh"
+
+#include "wgpu_context.hh"
+
+#include "MEM_guardedalloc.h"
+
+#include "BLI_utildefines.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+namespace blender::gpu {
+
+/** The active WebGPU context. */
+static WGPUContext *active_context()
+{
+  return static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
+}
+
+/* --- Signed packed-normal (GPU_COMP_I10) transcode --------------------------------
+ * WebGPU has no signed 10_10_10_2 vertex format, so `to_wgpu_vertex_format`
+ * (wgpu_pipeline.cc) reports normalized GPU_COMP_I10 attributes as Snorm8x4. The packed
+ * source data (A2B10G10R10 layout: R/X in the low 10 bits, then G/Y, B/Z, and the 2-bit
+ * A/W in the top bits, each 10-bit component a signed [-512,511] value scaled by 511)
+ * must therefore be transcoded to four signed bytes IN PLACE (same 4-byte field) before
+ * upload. Without this the unsigned-decode bug flipped the sign of every negative normal
+ * component (r37: the default cube's -Y face shaded as +Y). Mirrors the intent of
+ * Vulkan's VK_FORMAT_A2B10G10R10_SNORM_PACK32 path. */
+
+static inline int8_t i10_component_to_snorm8(uint32_t bits10)
+{
+  int v = int(bits10 & 0x3FFu);
+  if (v & 0x200) {
+    v -= 1024; /* sign-extend the 10-bit two's-complement value to [-512, 511]. */
+  }
+  float f = float(v) * (1.0f / 511.0f);
+  f = (f > 1.0f) ? 1.0f : (f < -1.0f) ? -1.0f : f;
+  int o = int(f * 127.0f + (f >= 0.0f ? 0.5f : -0.5f));
+  return int8_t((o > 127) ? 127 : (o < -127) ? -127 : o);
+}
+
+static void transcode_i10_field(uint8_t *field)
+{
+  const uint32_t packed = uint32_t(field[0]) | (uint32_t(field[1]) << 8) |
+                          (uint32_t(field[2]) << 16) | (uint32_t(field[3]) << 24);
+  int w = int((packed >> 30) & 0x3u);
+  if (w & 0x2) {
+    w -= 4; /* sign-extend the 2-bit component to [-2, 1]. */
+  }
+  w = (w > 1) ? 1 : (w < -1) ? -1 : w;
+  field[0] = uint8_t(i10_component_to_snorm8(packed));         /* X (low 10 bits) */
+  field[1] = uint8_t(i10_component_to_snorm8(packed >> 10));   /* Y */
+  field[2] = uint8_t(i10_component_to_snorm8(packed >> 20));   /* Z */
+  field[3] = uint8_t(int8_t(w * 127));                         /* W (unused by normals) */
+}
+
+/** True if `fmt` carries at least one normalized GPU_COMP_I10 attribute needing transcode. */
+static bool format_has_norm_i10(const GPUVertFormat &fmt)
+{
+  for (uint i = 0; i < fmt.attr_len; i++) {
+    const GPUVertAttr &a = fmt.attrs[i];
+    if (a.type.comp_type() == GPU_COMP_I10 &&
+        a.type.fetch_mode() == GPU_FETCH_INT_TO_FLOAT_UNIT)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+/** Transcode every normalized GPU_COMP_I10 field of `fmt` from packed 2_10_10_10 SNORM to
+ * Snorm8x4, in place, over `bytes` (a WRITABLE copy of the host data — never `data_`). */
+static void transcode_i10_attrs(uint8_t *bytes,
+                                size_t nbytes,
+                                const GPUVertFormat &fmt,
+                                uint vertex_len)
+{
+  for (uint ai = 0; ai < fmt.attr_len; ai++) {
+    const GPUVertAttr &a = fmt.attrs[ai];
+    if (a.type.comp_type() != GPU_COMP_I10 ||
+        a.type.fetch_mode() != GPU_FETCH_INT_TO_FLOAT_UNIT)
+    {
+      continue;
+    }
+    /* Locate this attribute's 4-byte fields. Interleaved: one per stride at a.offset.
+     * Deinterleaved: a contiguous block after the prior attributes' blocks (mirrors the
+     * buf_off math in wgpu_pipeline.cc build_vertex_plan). */
+    size_t base, field_stride;
+    if (!fmt.deinterleaved) {
+      base = a.offset;
+      field_stride = fmt.stride;
+    }
+    else {
+      base = 0;
+      for (uint j = 0; j < ai; j++) {
+        base += size_t(fmt.attrs[j].type.size()) * size_t(vertex_len);
+      }
+      field_stride = a.type.size(); /* 4 for I10 */
+    }
+    for (uint v = 0; v < vertex_len; v++) {
+      const size_t off = base + size_t(v) * field_stride;
+      if (off + 4 > nbytes) {
+        break;
+      }
+      transcode_i10_field(bytes + off);
+    }
+  }
+}
+
+static void i10_attribute_layout(const GPUVertFormat &fmt,
+                                 const uint attribute_index,
+                                 const uint vertex_len,
+                                 size_t &r_base,
+                                 size_t &r_stride)
+{
+  const GPUVertAttr &attribute = fmt.attrs[attribute_index];
+  if (!fmt.deinterleaved) {
+    r_base = attribute.offset;
+    r_stride = fmt.stride;
+    return;
+  }
+  r_base = 0;
+  for (uint index = 0; index < attribute_index; index++) {
+    r_base += size_t(fmt.attrs[index].type.size()) * size_t(vertex_len);
+  }
+  r_stride = attribute.type.size();
+}
+
+static void i10_update_vertex_range(const size_t base,
+                                    const size_t stride,
+                                    const uint vertex_len,
+                                    const size_t update_start,
+                                    const size_t update_end,
+                                    uint &r_first,
+                                    uint &r_end)
+{
+  r_first = r_end = 0;
+  if (vertex_len == 0 || update_end <= base) {
+    return;
+  }
+  const size_t first = (update_start > base) ? (update_start - base) / stride : 0;
+  if (first >= vertex_len) {
+    return;
+  }
+  const size_t end_delta = update_end - base;
+  const size_t end = end_delta / stride + ((end_delta % stride) != 0);
+  r_first = uint(first);
+  r_end = uint((end < vertex_len) ? end : vertex_len);
+}
+
+/** Convert complete signed-I10 fields inside one `GPU_vertbuf_update_sub` payload.
+ * The payload addresses `[update_start, update_start + nbytes)` in the full VBO. A range
+ * touching only part of a packed field cannot be decoded independently, so reject it before
+ * changing any byte. */
+static bool transcode_i10_update_payload(uint8_t *bytes,
+                                         const size_t nbytes,
+                                         const size_t update_start,
+                                         const GPUVertFormat &fmt,
+                                         const uint vertex_len)
+{
+  if ((bytes == nullptr && nbytes != 0) || update_start > SIZE_MAX - nbytes) {
+    return false;
+  }
+  const size_t update_end = update_start + nbytes;
+
+  /* Validate the whole range first so a rejected payload remains byte-identical. */
+  for (uint attribute_index = 0; attribute_index < fmt.attr_len; attribute_index++) {
+    const GPUVertAttr &attribute = fmt.attrs[attribute_index];
+    if (attribute.type.comp_type() != GPU_COMP_I10 ||
+        attribute.type.fetch_mode() != GPU_FETCH_INT_TO_FLOAT_UNIT)
+    {
+      continue;
+    }
+    size_t base, stride;
+    i10_attribute_layout(fmt, attribute_index, vertex_len, base, stride);
+    uint first_vertex, end_vertex;
+    i10_update_vertex_range(
+        base, stride, vertex_len, update_start, update_end, first_vertex, end_vertex);
+    for (uint vertex = first_vertex; vertex < end_vertex; vertex++) {
+      const size_t field_start = base + size_t(vertex) * stride;
+      const size_t field_end = field_start + 4;
+      const bool overlaps = field_start < update_end && update_start < field_end;
+      if (overlaps && (field_start < update_start || field_end > update_end)) {
+        return false;
+      }
+    }
+  }
+
+  for (uint attribute_index = 0; attribute_index < fmt.attr_len; attribute_index++) {
+    const GPUVertAttr &attribute = fmt.attrs[attribute_index];
+    if (attribute.type.comp_type() != GPU_COMP_I10 ||
+        attribute.type.fetch_mode() != GPU_FETCH_INT_TO_FLOAT_UNIT)
+    {
+      continue;
+    }
+    size_t base, stride;
+    i10_attribute_layout(fmt, attribute_index, vertex_len, base, stride);
+    uint first_vertex, end_vertex;
+    i10_update_vertex_range(
+        base, stride, vertex_len, update_start, update_end, first_vertex, end_vertex);
+    for (uint vertex = first_vertex; vertex < end_vertex; vertex++) {
+      const size_t field_start = base + size_t(vertex) * stride;
+      const size_t field_end = field_start + 4;
+      if (field_start >= update_start && field_end <= update_end) {
+        transcode_i10_field(bytes + field_start - update_start);
+      }
+    }
+  }
+  return true;
+}
+
+/** Map Blender's base `GPUUsageType` (low bits) to the buffer wrapper's usage. */
+static webgpu::UsageType to_wgpu_usage(GPUUsageType usage)
+{
+  switch (usage & 0x3) {
+    case GPU_USAGE_STREAM:
+      return webgpu::UsageType::Stream;
+    case GPU_USAGE_STATIC:
+      return webgpu::UsageType::Static;
+    case GPU_USAGE_DYNAMIC:
+      return webgpu::UsageType::Dynamic;
+    case GPU_USAGE_DEVICE_ONLY:
+      return webgpu::UsageType::DeviceOnly;
+    default:
+      return webgpu::UsageType::Static;
+  }
+}
+
+WGPUVertexBuffer::~WGPUVertexBuffer()
+{
+  release_data();
+}
+
+void WGPUVertexBuffer::allocate()
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  /* Vertex | Storage | Copy* (readable=true so it can be the CopySrc of
+   * GPU_storagebuf_copy_sub_from_vertbuf and of read()). */
+  buffer_.create_scoped(ctx->instance_get(),
+                        ctx->device_get(),
+                        webgpu::BufferKind::Vertex,
+                        to_wgpu_usage(usage_),
+                        size_alloc_get(),
+                        nullptr,
+                        true);
+}
+
+void WGPUVertexBuffer::enable_device_allocation_tracking()
+{
+  track_next_allocation_ = true;
+}
+
+bool WGPUVertexBuffer::is_device_allocation_pending() const
+{
+  return track_next_allocation_ && buffer_.creation_pending();
+}
+
+bool WGPUVertexBuffer::is_device_valid() const
+{
+  return buffer_.valid();
+}
+
+void WGPUVertexBuffer::upload_data()
+{
+  if (!buffer_.valid()) {
+    allocate();
+    if (!buffer_.valid()) {
+      return; /* allocation failed (e.g. no active context). */
+    }
+  }
+  buffer_.retry_pending_updates();
+
+  /* DEVICE_ONLY buffers hold no host copy and are never uploaded from host. */
+  if (!ELEM(usage_ & 0x3, GPU_USAGE_STATIC, GPU_USAGE_STREAM, GPU_USAGE_DYNAMIC)) {
+    return;
+  }
+
+  if (upload_transaction_.started()) {
+    if (!upload_transaction_.accepted()) {
+      return;
+    }
+    upload_transaction_.reset();
+    data_uploaded_ = true;
+    flag |= GPU_VERTBUF_DATA_UPLOADED;
+    /* The queued payload consumed its dirty bit when it was retained. A set bit now belongs to
+     * a newer CPU mutation, so preserve its host data and schedule it below. */
+    if ((flag & GPU_VERTBUF_DATA_DIRTY) == 0) {
+      if ((usage_ & 0x3) == GPU_USAGE_STATIC) {
+        MEM_SAFE_DELETE(data_);
+      }
+      return;
+    }
+  }
+
+  if (flag & GPU_VERTBUF_DATA_DIRTY) {
+    buffer_texture_buffer_dirty_ = true;
+    const size_t used = size_used_get();
+    if (data_ != nullptr && used > 0) {
+      WGPUContext *ctx = active_context();
+      if (ctx == nullptr) {
+        return;
+      }
+      /* Signed packed normals (GPU_COMP_I10) have no native WebGPU vertex format; transcode
+       * them to Snorm8x4 in a scratch copy so `data_` (which DYNAMIC/STREAM buffers keep and
+       * re-upload) is never mutated. See transcode_i10_attrs. */
+      const void *upload_data = data_;
+      std::vector<uint8_t> scratch;
+      if (format_has_norm_i10(format)) {
+        scratch.assign(data_, data_ + used);
+        transcode_i10_attrs(scratch.data(), used, format, vertex_len);
+        upload_data = scratch.data();
+      }
+
+      /* GPUVertFormat::pack() does not guarantee that the final logical byte count is
+       * four-aligned. Preserve exactly those caller-owned bytes and zero-fill only the
+       * transfer tail. Once the queue retains that exact snapshot, consume only its dirty bit;
+       * any later frontend mutation raises a distinct bit that acceptance must not clear. */
+      webgpu::BufferUpdatePayload payload;
+      if (!webgpu::buffer_update_payload(upload_data, used, buffer_.size(), payload)) {
+        return;
+      }
+      flag &= ~GPU_VERTBUF_DATA_DIRTY;
+      if (!buffer_.update_sub(ctx->instance_get(),
+                              ctx->device_get(),
+                              ctx->queue_get(),
+                              ctx->queue_scheduler_get(),
+                              0,
+                              payload.data(upload_data),
+                              payload.transfer_size,
+                              upload_transaction_))
+      {
+        if (!upload_transaction_.started()) {
+          flag |= GPU_VERTBUF_DATA_DIRTY;
+        }
+        return;
+      }
+      if (!upload_transaction_.accepted()) {
+        return;
+      }
+      upload_transaction_.reset();
+    }
+    else {
+      flag &= ~GPU_VERTBUF_DATA_DIRTY;
+    }
+    data_uploaded_ = true;
+    flag |= GPU_VERTBUF_DATA_UPLOADED;
+    if ((flag & GPU_VERTBUF_DATA_DIRTY) == 0 && (usage_ & 0x3) == GPU_USAGE_STATIC) {
+      MEM_SAFE_DELETE(data_);
+    }
+  }
+}
+
+void WGPUVertexBuffer::update_sub(uint start, uint len, const void *data)
+{
+  if (!buffer_.valid() || data == nullptr) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  buffer_.retry_pending_updates();
+  if (format_has_norm_i10(format)) {
+    const uint8_t *source = static_cast<const uint8_t *>(data);
+    std::vector<uint8_t> scratch(source, source + len);
+    if (!transcode_i10_update_payload(
+            scratch.data(), scratch.size(), start, format, vertex_len))
+    {
+      BLI_assert_msg(false,
+                     "WebGPU signed-I10 vertex subrange updates must contain whole fields");
+      return;
+    }
+    buffer_.update_sub(
+        ctx->instance_get(),
+        ctx->device_get(),
+        ctx->queue_get(),
+        ctx->queue_scheduler_get(),
+        start,
+        scratch.data(),
+        scratch.size());
+  }
+  else {
+    buffer_.update_sub(ctx->instance_get(),
+                       ctx->device_get(),
+                       ctx->queue_get(),
+                       ctx->queue_scheduler_get(),
+                       start,
+                       data,
+                       len);
+  }
+  buffer_texture_buffer_dirty_ = true;
+}
+
+void WGPUVertexBuffer::read(void *data) const
+{
+  if (!buffer_.valid()) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  std::vector<uint8_t> bytes = buffer_.read(
+      ctx->instance_get(),
+      ctx->device_get(),
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      0,
+      size_used_get());
+  if (!bytes.empty()) {
+    std::memcpy(data, bytes.data(), bytes.size());
+  }
+}
+
+void WGPUVertexBuffer::acquire_data()
+{
+  if ((usage_ & 0x3) == GPU_USAGE_DEVICE_ONLY) {
+    return;
+  }
+  /* Discard previous data if any. */
+  MEM_SAFE_DELETE(data_);
+  data_ = MEM_new_array_uninitialized<uchar>(this->size_alloc_get(), __func__);
+}
+
+void WGPUVertexBuffer::resize_data()
+{
+  if ((usage_ & 0x3) == GPU_USAGE_DEVICE_ONLY) {
+    return;
+  }
+  data_ = static_cast<uchar *>(
+      MEM_realloc_uninitialized(data_, sizeof(uchar) * this->size_alloc_get()));
+}
+
+void WGPUVertexBuffer::release_data()
+{
+  /* Drop any binding this buffer holds in the active context's SSBO bind-space so a
+   * freed VBO can never leave a dangling pointer for the next dispatch/draw. */
+  if (WGPUContext *ctx = active_context()) {
+    ctx->buffer_ssbo_unbind(&buffer_);
+    ctx->buffer_ssbo_unbind(&buffer_texture_buffer_);
+  }
+  /* Drop the GPU buffer (RAII releases the wgpu::Buffer handle). */
+  buffer_ = webgpu::Buffer();
+  buffer_texture_buffer_ = webgpu::Buffer();
+  buffer_texture_buffer_dirty_ = true;
+  MEM_SAFE_DELETE(data_);
+}
+
+/* Bind this vertex buffer as a read/write storage buffer at the given WGSL @binding
+ * (GPU_vertbuf_bind_as_ssbo — compute writes vertex data, e.g. the compute_vbo test /
+ * subdiv). Every VBO is allocated Vertex|Storage (wgpu_buffer.cc), so no reallocation
+ * is needed. Upload before every bind so a first-use VBO and any later host-side DIRTY
+ * update are visible to the shader. `upload_data` still only allocates DEVICE_ONLY VBOs;
+ * it never invents host data for them. The buffer is then recorded in the context's SSBO
+ * bind-space, which the compute/-draw bind-group builder consumes. */
+void WGPUVertexBuffer::bind_as_ssbo(uint binding)
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  upload_data();
+  if (!buffer_.valid()) {
+    return;
+  }
+  ctx->buffer_ssbo_bind(
+      int(binding), &buffer_, WGPUContext::BufferSSBOBindKind::Storage);
+}
+
+/* Bind this vertex buffer as an emulated texel buffer (GPU_vertbuf_bind_as_texture — the
+ * runtime source of a `samplerBuffer`). The buffer-sampler emulation (wgpu_shader.cc
+ * is_buffer_sampler / print_resource) rewrites the samplerBuffer into a read-only std430
+ * storage buffer, so the runtime bind is identical to bind_as_ssbo (patch 0085): ensure
+ * the device buffer exists and register it in the context's SSBO bind-space at the WGSL
+ * @binding the frontend recorded (GPU_shader_get_sampler_binding), which the compute/-draw
+ * bind-group builder consumes. As with bind_as_ssbo, upload before every bind so first-use
+ * and later DIRTY host bytes are visible to the shader.
+ *
+ * Float texel buffers are format-expanded to RGBA32F when their single source attribute
+ * has one to three components. This matches the vec4 storage element emitted for a
+ * FloatBuffer by wgpu_shader.cc, and preserves ordinary texture-buffer component fill
+ * semantics (missing RGB = 0, missing A = 1). Integer R32 buffer samplers already use a
+ * scalar storage element and continue to bind the original 4-byte-stride buffer. */
+void WGPUVertexBuffer::bind_as_texture(uint binding)
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  upload_data();
+  if (!buffer_.valid()) {
+    return;
+  }
+  webgpu::Buffer *binding_buffer = &buffer_;
+  buffer_texture_buffer_.retry_pending_updates();
+  if (buffer_texture_upload_transaction_.started()) {
+    if (!buffer_texture_upload_transaction_.accepted()) {
+      return;
+    }
+    buffer_texture_upload_transaction_.reset();
+  }
+  if (format.attr_len == 1 && format.attrs[0].type.comp_type() == GPU_COMP_F32 &&
+      format.attrs[0].type.comp_len() < 4)
+  {
+    if (buffer_texture_buffer_dirty_ || !buffer_texture_buffer_.valid()) {
+      const std::vector<uint8_t> source = buffer_.read(ctx->instance_get(),
+                                                       ctx->device_get(),
+                                                       ctx->queue_get(),
+                                                       ctx->queue_scheduler_get(),
+                                                       0,
+                                                       size_used_get());
+      if (source.empty()) {
+        return;
+      }
+      const GPUVertAttr &attr = format.attrs[0];
+      const size_t source_stride = format.deinterleaved ? attr.type.size() : format.stride;
+      std::vector<float> expanded(size_t(vertex_len) * 4, 0.0f);
+      for (uint vertex = 0; vertex < vertex_len; vertex++) {
+        const size_t source_offset = size_t(attr.offset) + size_t(vertex) * source_stride;
+        const size_t component_bytes = size_t(attr.type.comp_len()) * sizeof(float);
+        if (source_offset + component_bytes > source.size()) {
+          return;
+        }
+        std::memcpy(expanded.data() + size_t(vertex) * 4,
+                    source.data() + source_offset,
+                    component_bytes);
+        expanded[size_t(vertex) * 4 + 3] = 1.0f;
+      }
+      if (!buffer_texture_buffer_.valid() ||
+          buffer_texture_buffer_.size() < expanded.size() * sizeof(float))
+      {
+        buffer_texture_buffer_ = webgpu::Buffer();
+        if (!buffer_texture_buffer_.create_scoped(ctx->instance_get(),
+                                                  ctx->device_get(),
+                                                  webgpu::BufferKind::Storage,
+                                                  webgpu::UsageType::Static,
+                                                  expanded.size() * sizeof(float),
+                                                  expanded.data(),
+                                                  false,
+                                                  "float texel-buffer expansion"))
+        {
+          return;
+        }
+        buffer_texture_buffer_dirty_ = false;
+      }
+      else {
+        /* Consume only the expansion represented by this retained payload. A primary-buffer
+         * upload that completes while it is pending raises this bit again for the next bind. */
+        buffer_texture_buffer_dirty_ = false;
+        if (!buffer_texture_buffer_.update_sub(ctx->instance_get(),
+                                                ctx->device_get(),
+                                                ctx->queue_get(),
+                                                ctx->queue_scheduler_get(),
+                                                0,
+                                                expanded.data(),
+                                                expanded.size() * sizeof(float),
+                                                buffer_texture_upload_transaction_))
+        {
+          if (!buffer_texture_upload_transaction_.started()) {
+            buffer_texture_buffer_dirty_ = true;
+          }
+          return;
+        }
+        if (!buffer_texture_upload_transaction_.accepted()) {
+          return;
+        }
+        buffer_texture_upload_transaction_.reset();
+      }
+    }
+    binding_buffer = &buffer_texture_buffer_;
+  }
+  else if (format.stride != 16 && format.stride != 4) {
+    fprintf(stderr,
+            "[WebGPU] buffer-texture texel stride %u is unsupported by the storage-buffer "
+            "emulation; only float1-4 and R32I/R32UI are accepted.\n",
+            format.stride);
+  }
+  ctx->buffer_ssbo_bind(int(binding), binding_buffer, WGPUContext::BufferSSBOBindKind::Sampler);
+}
+
+void WGPUVertexBuffer::wrap_handle(uint64_t /*handle*/)
+{
+  /* Importing an externally-owned GPU buffer handle is not supported yet
+   * (the Vulkan backend also leaves this NOT_YET_IMPLEMENTED). */
+}
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_vertex_buffer.hh b/source/blender/gpu/webgpu/wgpu_vertex_buffer.hh
new file mode 100644
index 0000000000000000000000000000000000000000..30d4a277145ccd6cfd380012ed7b5acf4e6365cb
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_vertex_buffer.hh
@@ -0,0 +1,77 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_vertex_buffer.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * `VertBuf` on the WebGPU backend, backed by the common `webgpu::Buffer`
+ * (Vertex | Storage | Copy* usage — a vertex buffer may also be read as an SSBO
+ * by compute, and copied from as the source of GPU_storagebuf_copy_sub_from_vertbuf).
+ * The GPU buffer is allocated lazily on first `upload()`; the host copy is kept
+ * per the usage hint (dropped for STATIC after upload, as the Vulkan backend does).
+ * `bind_as_ssbo` / `bind_as_texture` are deferred to bind-group assembly (T7 / lane B).
+ */
+
+#pragma once
+
+#include "GPU_vertex_buffer.hh"
+
+#include "wgpu_buffer.hh"
+
+#include "MEM_guardedalloc.h"
+
+namespace blender::gpu {
+
+class WGPUVertexBuffer : public VertBuf {
+ public:
+  ~WGPUVertexBuffer() override;
+
+  void bind_as_ssbo(uint binding) override;
+  void bind_as_texture(uint binding) override;
+  void enable_device_allocation_tracking() override;
+  bool is_device_allocation_pending() const override;
+  bool is_device_valid() const override;
+  void wrap_handle(uint64_t handle) override;
+
+  void update_sub(uint start, uint len, const void *data) override;
+  void read(void *data) const override;
+
+  const webgpu::Buffer &buffer() const
+  {
+    return buffer_;
+  }
+
+ protected:
+  void acquire_data() override;
+  void resize_data() override;
+  void release_data() override;
+  void upload_data() override;
+
+ private:
+  void allocate();
+
+  webgpu::Buffer buffer_;
+  /* WebGPU has no texel-buffer resource. Float buffer samplers are lowered to
+   * `array<vec4<f32>>`; source vertex formats with fewer than four float
+   * components are expanded lazily into this storage backing at bind time. */
+  webgpu::Buffer buffer_texture_buffer_;
+  bool buffer_texture_buffer_dirty_ = true;
+  webgpu::BufferUpdateTransaction buffer_texture_upload_transaction_;
+  bool data_uploaded_ = false;
+  bool track_next_allocation_ = false;
+  /** Initial host upload remains uncommitted until browser implementation scopes accept it. */
+  webgpu::BufferUpdateTransaction upload_transaction_;
+
+  MEM_CXX_CLASS_ALLOC_FUNCS("WGPUVertexBuffer")
+};
+
+static inline WGPUVertexBuffer *unwrap(VertBuf *vertex_buffer)
+{
+  return static_cast<WGPUVertexBuffer *>(vertex_buffer);
+}
+
+}  // namespace blender::gpu
