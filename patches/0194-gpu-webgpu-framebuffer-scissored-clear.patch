+/** The implementation selected for one framebuffer clear. WebGPU load operations cover a whole
+ * attachment, so any proper sub-rectangle requires a draw. Empty clipped regions remain valid
+ * no-ops rather than malformed render passes. */
+enum class FramebufferClearMethod : uint8_t { NoOp, FullAttachmentLoadOp, ScissoredDraw };
+
+enum class FramebufferClearAspect : uint8_t {
+  Color = 1u << 0,
+  Depth = 1u << 1,
+  Stencil = 1u << 2,
+};
+
+struct FramebufferClearPlan {
+  FramebufferClearMethod method = FramebufferClearMethod::NoOp;
+  uint8_t aspects = 0;
+  uint32_t x = 0;
+  uint32_t y = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+};
+
+enum class FramebufferClearShaderType : uint8_t { Float, Uint, Sint, Depth };
+
+/** Select the fragment output base type from the texture's numeric flags. Blender's packed
+ * UNORM_10_10_10_2 and UINT_10_10_10_2 share one legacy eGPUDataFormat token, so that token
+ * cannot distinguish the float and unsigned WebGPU render-target contracts. */
+inline FramebufferClearShaderType framebuffer_clear_color_shader_type(bool is_integer,
+                                                                      bool is_signed)
+{
+  if (!is_integer) {
+    return FramebufferClearShaderType::Float;
+  }
+  return is_signed ? FramebufferClearShaderType::Sint : FramebufferClearShaderType::Uint;
+}
+
+/** Exact typed fullscreen-triangle shaders used by scissored framebuffer clears. Keeping the
+ * shipping WGSL here lets the device-free contract parse and identity-bind every variant. */
+inline const char *framebuffer_clear_shader_source(FramebufferClearShaderType type)
+{
+  switch (type) {
+    case FramebufferClearShaderType::Float:
+      return "struct Params { value : vec4f, };\n"
+             "@group(0) @binding(0) var<uniform> params : Params;\n"
+             "@vertex fn vs_main(@builtin(vertex_index) vid : u32) -> @builtin(position) "
+             "vec4f {\n"
+             "  let x = f32((vid << 1u) & 2u);\n"
+             "  let y = f32(vid & 2u);\n"
+             "  return vec4f(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);\n"
+             "}\n"
+             "@fragment fn fs_main() -> @location(0) vec4f { return params.value; }\n";
+    case FramebufferClearShaderType::Uint:
+      return "struct Params { value : vec4u, };\n"
+             "@group(0) @binding(0) var<uniform> params : Params;\n"
+             "@vertex fn vs_main(@builtin(vertex_index) vid : u32) -> @builtin(position) "
+             "vec4f {\n"
+             "  let x = f32((vid << 1u) & 2u);\n"
+             "  let y = f32(vid & 2u);\n"
+             "  return vec4f(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);\n"
+             "}\n"
+             "@fragment fn fs_main() -> @location(0) vec4u { return params.value; }\n";
+    case FramebufferClearShaderType::Sint:
+      return "struct Params { value : vec4i, };\n"
+             "@group(0) @binding(0) var<uniform> params : Params;\n"
+             "@vertex fn vs_main(@builtin(vertex_index) vid : u32) -> @builtin(position) "
+             "vec4f {\n"
+             "  let x = f32((vid << 1u) & 2u);\n"
+             "  let y = f32(vid & 2u);\n"
+             "  return vec4f(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);\n"
+             "}\n"
+             "@fragment fn fs_main() -> @location(0) vec4i { return params.value; }\n";
+    case FramebufferClearShaderType::Depth:
+      return "struct Params { value : vec4f, };\n"
+             "@group(0) @binding(0) var<uniform> params : Params;\n"
+             "@vertex fn vs_main(@builtin(vertex_index) vid : u32) -> @builtin(position) "
+             "vec4f {\n"
+             "  let x = f32((vid << 1u) & 2u);\n"
+             "  let y = f32(vid & 2u);\n"
+             "  return vec4f(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);\n"
+             "}\n"
+             "@fragment fn fs_main() -> @builtin(frag_depth) f32 { return params.value.x; }\n";
+  }
+  return nullptr;
+}
+
+/** Preserve Blender's scissor-sensitive framebuffer clear contract. A disabled or exact-full
+ * scissor retains WebGPU's loadOp=Clear fast path. A proper clipped rectangle selects a draw over
+ * loadOp=Load attachments, while an empty rectangle is an explicit no-op. Window targets convert
+ * lower-left Y; ordinary offscreens retain the backend's established post-flip coordinates.
+ * Invalid target/aspect inputs leave `result` unchanged. */
+inline bool framebuffer_clear_plan(const int *scissor,
+                                   int target_width,
+                                   int target_height,
+                                   bool convert_bottom_origin,
+                                   uint8_t aspects,
+                                   FramebufferClearPlan &result)
+{
+  constexpr uint8_t valid_aspects = uint8_t(FramebufferClearAspect::Color) |
+                                    uint8_t(FramebufferClearAspect::Depth) |
+                                    uint8_t(FramebufferClearAspect::Stencil);
+  if (target_width <= 0 || target_height <= 0 || aspects == 0 ||
+      (aspects & ~valid_aspects) != 0)
+  {
+    return false;
+  }
+
+  FramebufferClearPlan candidate;
+  candidate.method = FramebufferClearMethod::FullAttachmentLoadOp;
+  candidate.aspects = aspects;
+  candidate.width = uint32_t(target_width);
+  candidate.height = uint32_t(target_height);
+  if (scissor == nullptr) {
+    result = candidate;
+    return true;
+  }
+
+  if (scissor[2] <= 0 || scissor[3] <= 0) {
+    candidate.method = FramebufferClearMethod::NoOp;
+    candidate.width = 0;
+    candidate.height = 0;
+    result = candidate;
+    return true;
+  }
+
+  const int64_t left = int64_t(scissor[0]);
+  const int64_t top = convert_bottom_origin ?
+                          int64_t(target_height) - int64_t(scissor[1]) -
+                              int64_t(scissor[3]) :
+                          int64_t(scissor[1]);
+  const int64_t right = left + int64_t(scissor[2]);
+  const int64_t bottom = top + int64_t(scissor[3]);
+  const int64_t clipped_left = left > 0 ? left : 0;
+  const int64_t clipped_top = top > 0 ? top : 0;
+  const int64_t clipped_right = right < int64_t(target_width) ? right : target_width;
+  const int64_t clipped_bottom = bottom < int64_t(target_height) ? bottom : target_height;
+  if (clipped_left >= clipped_right || clipped_top >= clipped_bottom) {
+    candidate.method = FramebufferClearMethod::NoOp;
+    candidate.width = 0;
+    candidate.height = 0;
+    result = candidate;
+    return true;
+  }
+
+  candidate.x = uint32_t(clipped_left);
+  candidate.y = uint32_t(clipped_top);
+  candidate.width = uint32_t(clipped_right - clipped_left);
+  candidate.height = uint32_t(clipped_bottom - clipped_top);
+  if (candidate.x != 0 || candidate.y != 0 || candidate.width != uint32_t(target_width) ||
+      candidate.height != uint32_t(target_height))
+  {
+    candidate.method = FramebufferClearMethod::ScissoredDraw;
+  }
+  result = candidate;
+  return true;
+}
