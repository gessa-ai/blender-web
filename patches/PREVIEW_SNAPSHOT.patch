+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_buffer.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * The common `GPUBuffer` wrapper the vertex/index/uniform/storage buffer classes
+ * share. Replaces the Vulkan backend's `vk_buffer` + VMA allocation + staging /
+ * streaming plumbing with WebGPU's implicit allocation:
+ *   - creation with initial data uses `mappedAtCreation` (no queue op, any size);
+ *   - runtime updates use `queue.writeBuffer` (<=64 KiB) or a staging buffer +
+ *     `CopyBufferToBuffer` (larger), chosen by kWriteBufferStagingThreshold;
+ *   - readback uses a MAP_READ staging buffer + `CopyBufferToBuffer` + `mapAsync`.
+ *
+ * Standalone-proven (5/5 live, byte-exact incl. the 20 MiB staging path) in
+ * sandbox/wgpu-buffers/; recon + rationale in notes/gpu-t6-t10pre-findings.md.
+ */
+
+#pragma once
+
+#include <vector>
+
+#include "wgpu_common.hh"
+
+namespace blender::gpu::webgpu {
+
+/** Compute the `wgpu::BufferUsage` for a (kind, usage) pair. `readable` adds
+ * CopySrc so the buffer can be read back to host (storage buffers, pixel packs). */
+wgpu::BufferUsage usage_flags(BufferKind kind, UsageType usage, bool readable);
+
+/** The common buffer wrapper. Non-owning of the device; owns its wgpu::Buffer. */
+class Buffer {
+ public:
+  Buffer() = default;
+  ~Buffer();
+  Buffer(const Buffer &) = delete;
+  Buffer &operator=(const Buffer &) = delete;
+  Buffer(Buffer &&other) noexcept;
+  Buffer &operator=(Buffer &&other) noexcept;
+
+  /** Create a short-lived buffer whose dependent queue work is reserved in the same frame epoch.
+   * The provisional handle is available for CPU-side command encoding, but the queue gate releases
+   * only after validation/OOM/internal scopes accept it. */
+  bool create_transient(const wgpu::Instance &instance,
+                        const wgpu::Device &device,
+                        OrderedQueueScheduler &scheduler,
+                        BufferKind kind,
+                        UsageType usage,
+                        size_t size,
+                        const void *initial_data,
+                        bool readable,
+                        const char *label = nullptr);
+
+  /** Create a persistent buffer of `size` bytes. If `initial_data` is non-null it is written
+   * via `mappedAtCreation` (no queue submission). `size` is rounded up to a
+   * multiple of 4 (WebGPU requirement). The buffer and its metadata remain
+   * unpublished until validation/OOM/internal scopes settle cleanly. Returns
+   * false while browser validation is pending or after failure. */
+  bool create_scoped(const wgpu::Instance &instance,
+                     const wgpu::Device &device,
+                     BufferKind kind,
+                     UsageType usage,
+                     size_t size,
+                     const void *initial_data,
+                     bool readable,
+                     const char *label = nullptr);
+
+  /** Partial update: writes `size` bytes at `offset`. Uses queue.writeBuffer for
+   * small writes, a staging buffer + copy for large ones. offset/size must be
+   * 4-aligned. Returns true only after synchronous scope acceptance; callers that
+   * own commit state must use the transaction overload below. */
+  bool update_sub(const wgpu::Instance &instance,
+                  const wgpu::Device &device,
+                  const wgpu::Queue &queue,
+                  OrderedQueueScheduler &scheduler,
+                  size_t offset,
+                  const void *data,
+                  size_t size);
+
+  /** Partial update with an explicit asynchronous completion token. Returns true only when the
+   * validation/OOM/internal scopes have already accepted the write; browser-pending work returns
+   * false while `transaction` retains its eventual status. */
+  bool update_sub(const wgpu::Instance &instance,
+                  const wgpu::Device &device,
+                  const wgpu::Queue &queue,
+                  OrderedQueueScheduler &scheduler,
+                  size_t offset,
+                  const void *data,
+                  size_t size,
+                  BufferUpdateTransaction &transaction);
+
+  /** Retry every retained rejected update against the published allocation. */
+  size_t retry_pending_updates();
+
+  /** Read `size` bytes at `offset` back to host via a MAP_READ staging buffer.
+   * Requires the buffer was created `readable`. Blocks on the instance. */
+  std::vector<uint8_t> read(const wgpu::Instance &instance,
+                            const wgpu::Device &device,
+                            const wgpu::Queue &queue,
+                            OrderedQueueScheduler &scheduler,
+                            size_t offset,
+                            size_t size) const;
+
+  wgpu::Buffer handle() const
+  {
+    return allocation_get().handle;
+  }
+  size_t size() const
+  {
+    return allocation_get().size;
+  }
+  BufferKind kind() const
+  {
+    return allocation_get().kind;
+  }
+  bool valid() const
+  {
+    return allocation_get() != nullptr;
+  }
+  bool creation_pending() const
+  {
+    return allocation_cache_.pending(kAllocationKey) ||
+           (transient_scope_status_ &&
+            transient_scope_status_->load(std::memory_order_acquire) == 0);
+  }
+  bool creation_pending_or_retryable() const
+  {
+    return creation_pending() || pending_updates_->retryable();
+  }
+  size_t update_capacity() const
+  {
+    const Allocation allocation = allocation_get();
+    return allocation != nullptr ? allocation.size : pending_updates_->allocation_size();
+  }
+
+ private:
+  struct Allocation {
+    wgpu::Buffer handle;
+    size_t size = 0;      /* rounded (allocated) size */
+    size_t requested = 0; /* size the caller asked for */
+    BufferKind kind = BufferKind::Vertex;
+    bool readable = false;
+
+    bool operator==(std::nullptr_t) const
+    {
+      return handle == nullptr;
+    }
+    bool operator!=(std::nullptr_t) const
+    {
+      return handle != nullptr;
+    }
+  };
+
+  struct PendingUpdateContext {
+    wgpu::Instance instance;
+    wgpu::Device device;
+    wgpu::Queue queue;
+    OrderedQueueScheduler scheduler;
+  };
+
+  static bool update_allocation(PendingUpdateContext context,
+                                const Allocation &allocation,
+                                size_t offset,
+                                const void *data,
+                                size_t size,
+                                std::function<void(bool)> complete);
+
+  static constexpr uint8_t kAllocationKey = 0;
+  Allocation allocation_get() const
+  {
+    const Allocation persistent = allocation_cache_.lookup(kAllocationKey);
+    if (persistent != nullptr) {
+      return persistent;
+    }
+    if (transient_scope_status_ &&
+        transient_scope_status_->load(std::memory_order_acquire) >= 0)
+    {
+      return transient_allocation_;
+    }
+    return {};
+  }
+
+  ScopedHandleCache<uint8_t, Allocation> allocation_cache_;
+  std::shared_ptr<PendingBufferPayloadQueue<PendingUpdateContext>> pending_updates_ =
+      std::make_shared<PendingBufferPayloadQueue<PendingUpdateContext>>();
+  Allocation transient_allocation_;
+  std::shared_ptr<std::atomic<int8_t>> transient_scope_status_;
+};
+
+}  // namespace blender::gpu::webgpu
