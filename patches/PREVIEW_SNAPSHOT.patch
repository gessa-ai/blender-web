+  GPUVertFormat *format = immVertexFormat();
+  const uint pos = GPU_vertformat_attr_add(format, "pos", gpu::VertAttrType::SFLOAT_32_32_32);
+
+  const float4 color(1.0f, 0.0f, 0.0f, 1.0f);
+  GPU_line_smooth(false);
+  GPU_line_width(4.0f);
+  immBindBuiltinProgram(GPU_SHADER_3D_UNIFORM_COLOR);
+  immUniformColor4fv(color);
+  immBegin(GPU_PRIM_LINES, 2);
+  immVertex3f(pos, -0.75f, 0.0f, 0.0f);
+  immVertex3f(pos, 0.75f, 0.0f, 0.0f);
+  immEnd();
+  immUnbindProgram();
+  GPU_line_width(1.0f);
+
+  GPU_offscreen_unbind(offscreen, false);
+  GPU_finish();
+
+  Vector<float4> read_data(polyline_size * polyline_size);
+  GPU_offscreen_read_color(offscreen, GPU_DATA_FLOAT, read_data.data());
+  int64_t colored_pixels = 0;
+  for (const float4 &read_color : read_data) {
+    if (read_color == color) {
+      colored_pixels++;
+    }
+  }
+  /* More than a one-pixel row proves that the wide-line triangle expansion ran. */
