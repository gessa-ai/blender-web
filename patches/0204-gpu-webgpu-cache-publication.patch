   wgpu::Sampler sampler = device_.CreateSampler(&d);
-  sampler_cache_[key] = sampler;
+  if (!webgpu::cache_handle_if_valid(sampler_cache_, key, sampler)) {
+    return nullptr;
+  }
   return sampler;
@@ -474,6 +476,5 @@ bool WGPUContext::blit_color_render(webgpu::WGPUTexture *src,
     pipeline = device_.CreateRenderPipeline(&pd);
-    blit_pipelines_[fmt_key] = pipeline;
-  }
-  if (pipeline == nullptr) {
-    return false;
+    if (!webgpu::cache_handle_if_valid(blit_pipelines_, fmt_key, pipeline)) {
+      return false;
+    }
   }
@@ -620,6 +621,7 @@ bool WGPUContext::blit_depth_render(webgpu::WGPUTexture *src,
     pipeline = device_.CreateRenderPipeline(&pipeline_desc);
-    depth_blit_pipelines_[uint32_t(dst_format)] = pipeline;
-  }
-  if (pipeline == nullptr) {
-    return false;
+    if (!webgpu::cache_handle_if_valid(
+            depth_blit_pipelines_, uint32_t(dst_format), pipeline))
+    {
+      return false;
+    }
   }
@@ -748,6 +750,7 @@ bool WGPUContext::upload_depth_render(webgpu::WGPUTexture *dst,
     pipeline = device_.CreateRenderPipeline(&pipeline_desc);
-    depth_upload_pipelines_[uint32_t(format)] = pipeline;
-  }
-  if (pipeline == nullptr) {
-    return false;
+    if (!webgpu::cache_handle_if_valid(
+            depth_upload_pipelines_, uint32_t(format), pipeline))
+    {
+      return false;
