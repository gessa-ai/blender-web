+  EXPECT_EQ(GPU_texture_width(source_nested), mip_width);
+  EXPECT_EQ(GPU_texture_height(source_nested), 1);
+
+  GPU_texture_free(source_root);
+  GPU_texture_free(output_root);
+  GPU_texture_free(source_outer);
+  GPU_texture_free(output_outer);
+
+  ShaderCreateInfo info("pyGPU_Shader");
+  info.sampler(0, ImageType::Uint1DArray, "source_map");
+  info.image(1,
+             TextureFormat::UINT_32,
+             Qualifier::write,
+             ImageReadWriteType::Uint1DArray,
+             "output_img");
+  info.local_group_size(1, 1, 1);
+  info.compute_source_generated =
+      "void main() {\n"
+      "  uint value = textureLod(source_map, vec2(0.75, 0.0), 0.0).x;\n"
+      "  ivec2 size = textureSize(source_map, 0);\n"
+      "  imageStore(output_img, ivec2(0, 0), uvec4(value + uint(size.x + size.y)));\n"
+      "}\n";
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+  GPU_shader_bind(shader);
+  GPU_texture_bind(source_nested, GPU_shader_get_sampler_binding(shader, "source_map"));
+  GPU_texture_image_bind(output_nested, GPU_shader_get_sampler_binding(shader, "output_img"));
+  GPU_compute_dispatch(shader, 1, 1, 1);
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE | GPU_BARRIER_SHADER_IMAGE_ACCESS);
+
+  uint *selected = static_cast<uint *>(GPU_texture_read(output_nested, GPU_DATA_UINT, 0));
+  uint *output_untouched = static_cast<uint *>(
+      GPU_texture_read(output_neighbor, GPU_DATA_UINT, 0));
+  uint *source_untouched = static_cast<uint *>(
+      GPU_texture_read(source_neighbor, GPU_DATA_UINT, 0));
+  ASSERT_NE(selected, nullptr);
+  ASSERT_NE(output_untouched, nullptr);
+  ASSERT_NE(source_untouched, nullptr);
+  EXPECT_EQ(selected[0], 224u);
+  EXPECT_EQ(selected[1], 0u);
+  EXPECT_EQ(output_untouched[0], 0u);
+  EXPECT_EQ(output_untouched[1], 0u);
+  EXPECT_EQ(source_untouched[0], 210u);
+  EXPECT_EQ(source_untouched[1], 211u);
+  MEM_delete(selected);
+  MEM_delete(output_untouched);
+  MEM_delete(source_untouched);
+
+  GPU_shader_unbind();
+  GPU_texture_unbind(source_nested);
+  GPU_texture_image_unbind(output_nested);
+  GPU_shader_free(shader);
+  GPU_texture_free(output_neighbor);
+  GPU_texture_free(source_neighbor);
+  GPU_texture_free(output_nested);
+  GPU_texture_free(source_nested);
+  GPU_render_end();
+}
