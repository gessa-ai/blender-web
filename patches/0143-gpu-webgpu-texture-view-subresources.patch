+static wgpu::TextureFormat aspect_view_format(const WGPUTexture::SubresourceRange &range)
+{
+  if (range.aspect == wgpu::TextureAspect::StencilOnly) {
+    if (range.backing_format == wgpu::TextureFormat::Depth32FloatStencil8 ||
+        range.backing_format == wgpu::TextureFormat::Depth24PlusStencil8)
+    {
+      return wgpu::TextureFormat::Stencil8;
+    }
+  }
+  else if (range.aspect == wgpu::TextureAspect::DepthOnly) {
+    if (range.backing_format == wgpu::TextureFormat::Depth32FloatStencil8) {
+      return wgpu::TextureFormat::Depth32Float;
+    }
+    if (range.backing_format == wgpu::TextureFormat::Depth24PlusStencil8) {
+      return wgpu::TextureFormat::Depth24Plus;
+    }
+  }
+  return range.view_format;
+}
+
+wgpu::TextureView WGPUTexture::attachment_view(int mip, int layer) const
+{
+  ResolvedReadRegion region;
+  if (!subresources_.valid() ||
+      !(subresources_.texture.GetUsage() & wgpu::TextureUsage::RenderAttachment) ||
+      !resolve_subresource(mip, layer, region) || region.depth != 1)
+  {
+    return nullptr;
+  }
+  wgpu::TextureViewDescriptor d = {};
+  d.format = subresources_.view_format;
+  d.dimension = (subresources_.texture.GetDimension() == wgpu::TextureDimension::e3D) ?
+                    wgpu::TextureViewDimension::e3D :
+                    wgpu::TextureViewDimension::e2D;
+  d.baseMipLevel = region.mip_level;
+  d.mipLevelCount = 1;
+  if (d.dimension != wgpu::TextureViewDimension::e3D) {
+    d.baseArrayLayer = region.origin_z;
+    d.arrayLayerCount = 1;
+  }
+  /* A combined depth-stencil render attachment needs the combined view. Sampling
+   * and readback continue to use the range's selected single aspect. */
+  d.aspect = (subresources_.backing_format == wgpu::TextureFormat::Depth32FloatStencil8 ||
+              subresources_.backing_format == wgpu::TextureFormat::Depth24PlusStencil8) ?
+                 wgpu::TextureAspect::All :
+                 subresources_.aspect;
+  return subresources_.texture.CreateView(&d);
+}
+
+uint32_t WGPUTexture::attachment_depth_slice(int mip, int layer) const
+{
+  ResolvedReadRegion region;
+  if (subresources_.texture.GetDimension() != wgpu::TextureDimension::e3D ||
+      !resolve_subresource(mip, layer, region) || region.depth != 1)
+  {
+    return wgpu::kDepthSliceUndefined;
+  }
+  return region.origin_z;
+}
+
+uint32_t WGPUTexture::attachment_layer_count(int mip) const
+{
+  ResolvedReadRegion region;
+  return resolve_subresource(mip, -1, region) ? region.depth : 0u;
+}
+
+wgpu::TextureView WGPUTexture::sampled_attachment_view(int mip, int layer) const
+{
+  ResolvedReadRegion region;
+  if (!subresources_.valid() ||
+      !(subresources_.texture.GetUsage() & wgpu::TextureUsage::TextureBinding) ||
+      !resolve_subresource(mip, layer, region) || region.depth != 1)
+  {
+    return nullptr;
+  }
+  SubresourceRange sampled_range = subresources_;
+  if (sampled_range.aspect == wgpu::TextureAspect::All &&
+      (format_flag_ & GPU_FORMAT_DEPTH))
+  {
+    sampled_range.aspect = wgpu::TextureAspect::DepthOnly;
+  }
+  wgpu::TextureViewDescriptor d = {};
+  d.format = aspect_view_format(sampled_range);
+  d.dimension = (subresources_.texture.GetDimension() == wgpu::TextureDimension::e3D) ?
+                    wgpu::TextureViewDimension::e3D :
+                    wgpu::TextureViewDimension::e2D;
