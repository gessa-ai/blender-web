+  const ParticleEditDepthCacheState state = PE_depth_cache_session_state(C,
+                                                                         circle->depth_session);
+  if (state == ParticleEditDepthCacheState::Failed) {
+    return state;
+  }
+  if (event->type == TIMER) {
+    if (event->customdata != circle->timer) {
+      return ParticleEditDepthCacheState::Pending;
+    }
+    constexpr int max_tick_count = 240;
+    if (++circle->tick_count > max_tick_count) {
+      return ParticleEditDepthCacheState::Failed;
+    }
+    return state;
+  }
+
+  constexpr int max_queued_events = 512;
+  if (event->custom != 0 || event->customdata != nullptr ||
+      circle->depth_events.size() >= max_queued_events)
+  {
+    return ParticleEditDepthCacheState::Failed;
+  }
+  wmEvent queued = *event;
+  queued.next = nullptr;
+  queued.prev = nullptr;
+  queued.custom = 0;
+  queued.customdata = nullptr;
+  queued.customdata_free = false;
+  circle->depth_events.append(queued);
+  return ParticleEditDepthCacheState::Pending;
+}
