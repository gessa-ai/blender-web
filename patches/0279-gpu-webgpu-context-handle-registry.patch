# M3: publish async-compiler instance/device/queue handles as one coherent,
# owner-tracked tuple across overlapping WebGPU context lifetimes.
# Ported for the web from source/blender/gpu/webgpu/ @ fbe6228777e7.

diff --git a/source/blender/gpu/webgpu/wgpu_common.hh b/source/blender/gpu/webgpu/wgpu_common.hh
index 76c45d66a4a64ae6112b8af28db17310d98d0727..f63527367cc4443fba7ad4fe6de300e503daf4a5 100644
--- a/source/blender/gpu/webgpu/wgpu_common.hh
+++ b/source/blender/gpu/webgpu/wgpu_common.hh
@@ -243,6 +243,62 @@ inline bool index_buffer_handle_resolve_if_required(const bool required,
   return transient_handle_publish_if_valid(std::move(candidate), result);
 }
 
+/**
+ * Publish one coherent handle tuple for the most recently registered live owner.
+ *
+ * GPU contexts can overlap, while backend worker threads need an owner-independent
+ * snapshot. Re-publishing an owner moves it to the newest position, forgetting an
+ * older owner cannot clear a newer tuple, and forgetting the newest owner restores
+ * the previous live tuple. The snapshot copy is made under the same lock as owner
+ * changes so callers cannot combine handles from different contexts.
+ */
+template<typename OwnerT, typename HandleSetT> class LatestOwnerHandleRegistry {
+ private:
+  struct Entry {
+    const OwnerT *owner = nullptr;
+    HandleSetT handles = {};
+  };
+
+ public:
+  void publish(const OwnerT *owner, HandleSetT handles)
+  {
+    if (owner == nullptr) {
+      return;
+    }
+    std::lock_guard lock(mutex_);
+    entries_.erase(std::remove_if(entries_.begin(),
+                                  entries_.end(),
+                                  [owner](const Entry &entry) { return entry.owner == owner; }),
+                   entries_.end());
+    entries_.push_back({owner, std::move(handles)});
+  }
+
+  void forget(const OwnerT *owner)
+  {
+    std::lock_guard lock(mutex_);
+    entries_.erase(std::remove_if(entries_.begin(),
+                                  entries_.end(),
+                                  [owner](const Entry &entry) { return entry.owner == owner; }),
+                   entries_.end());
+  }
+
+  HandleSetT current() const
+  {
+    std::lock_guard lock(mutex_);
+    return entries_.empty() ? HandleSetT{} : entries_.back().handles;
+  }
+
+  size_t size() const
+  {
+    std::lock_guard lock(mutex_);
+    return entries_.size();
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::vector<Entry> entries_;
+};
+
