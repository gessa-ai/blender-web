+/** Host geometry for extracting one framebuffer rectangle from a tightly packed texture
+ * subresource. The source is WebGPU top-down; the destination is Blender's GL-compatible
+ * bottom-up convention and can request a different leading-channel count. */
+struct FramebufferReadLayout {
+  uint32_t source_width = 0;
+  uint32_t source_height = 0;
+  uint32_t source_x = 0;
+  uint32_t source_y = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t source_components = 0;
+  uint32_t destination_components = 0;
+  size_t component_bytes = 0;
+  size_t source_texel_bytes = 0;
+  size_t destination_texel_bytes = 0;
+  size_t source_row_bytes = 0;
+  size_t destination_row_bytes = 0;
+  size_t source_data_size = 0;
+  size_t destination_data_size = 0;
+};
+
+/** Resolve every source/destination byte count before reading a framebuffer attachment or
+ * touching caller memory. Failure leaves `result` unchanged. */
+inline bool framebuffer_read_layout(uint32_t source_width,
+                                    uint32_t source_height,
+                                    int x,
+                                    int y,
+                                    int width,
+                                    int height,
+                                    uint32_t source_components,
+                                    uint32_t destination_components,
+                                    size_t component_bytes,
+                                    FramebufferReadLayout &result)
+{
+  if (source_width == 0 || source_height == 0 || x < 0 || y < 0 || width <= 0 ||
+      height <= 0 || source_components == 0 || source_components > 4 ||
+      destination_components == 0 || destination_components > 4 || component_bytes == 0)
+  {
+    return false;
+  }
+  const uint32_t source_x = uint32_t(x);
+  const uint32_t source_y = uint32_t(y);
+  const uint32_t copy_width = uint32_t(width);
+  const uint32_t copy_height = uint32_t(height);
+  if (source_x > source_width || copy_width > source_width - source_x ||
+      source_y > source_height || copy_height > source_height - source_y)
+  {
+    return false;
+  }
+
+  FramebufferReadLayout candidate;
+  candidate.source_width = source_width;
+  candidate.source_height = source_height;
+  candidate.source_x = source_x;
+  candidate.source_y = source_y;
+  candidate.width = copy_width;
+  candidate.height = copy_height;
+  candidate.source_components = source_components;
+  candidate.destination_components = destination_components;
+  candidate.component_bytes = component_bytes;
+  if (!checked_size_mul(size_t(source_components),
+                        component_bytes,
+                        candidate.source_texel_bytes) ||
+      !checked_size_mul(size_t(destination_components),
+                        component_bytes,
+                        candidate.destination_texel_bytes) ||
+      !checked_size_mul(size_t(source_width),
+                        candidate.source_texel_bytes,
+                        candidate.source_row_bytes) ||
+      !checked_size_mul(size_t(source_height),
+                        candidate.source_row_bytes,
+                        candidate.source_data_size) ||
+      !checked_size_mul(size_t(copy_width),
+                        candidate.destination_texel_bytes,
+                        candidate.destination_row_bytes) ||
+      !checked_size_mul(size_t(copy_height),
+                        candidate.destination_row_bytes,
+                        candidate.destination_data_size))
+  {
+    return false;
+  }
+  result = candidate;
+  return true;
+}
+
+/** Crop, vertically flip, and select/extend leading channels from a validated framebuffer
+ * source. Missing color channels are zero and a missing requested alpha channel is one, matching
+ * native framebuffer reads. All capacity checks happen before `destination` is changed. */
+inline bool framebuffer_read_extract(const uint8_t *source,
+                                     size_t source_capacity,
+                                     uint8_t *destination,
+                                     size_t destination_capacity,
+                                     const void *one_component,
+                                     const FramebufferReadLayout &layout)
+{
+  if (source == nullptr || destination == nullptr || one_component == nullptr ||
+      layout.source_x > uint32_t(std::numeric_limits<int>::max()) ||
+      layout.source_y > uint32_t(std::numeric_limits<int>::max()) ||
+      layout.width > uint32_t(std::numeric_limits<int>::max()) ||
+      layout.height > uint32_t(std::numeric_limits<int>::max()))
+  {
+    return false;
+  }
+  FramebufferReadLayout expected;
+  if (!framebuffer_read_layout(layout.source_width,
+                               layout.source_height,
+                               int(layout.source_x),
+                               int(layout.source_y),
+                               int(layout.width),
+                               int(layout.height),
+                               layout.source_components,
+                               layout.destination_components,
+                               layout.component_bytes,
+                               expected) ||
+      expected.source_texel_bytes != layout.source_texel_bytes ||
+      expected.destination_texel_bytes != layout.destination_texel_bytes ||
+      expected.source_row_bytes != layout.source_row_bytes ||
+      expected.destination_row_bytes != layout.destination_row_bytes ||
+      expected.source_data_size != layout.source_data_size ||
+      expected.destination_data_size != layout.destination_data_size ||
+      source_capacity < layout.source_data_size ||
+      destination_capacity < layout.destination_data_size)
+  {
+    return false;
+  }
+
+  std::memset(destination, 0, layout.destination_data_size);
+  const size_t copied_components =
+      layout.source_components < layout.destination_components ?
+          size_t(layout.source_components) :
+          size_t(layout.destination_components);
+  const size_t copied_bytes = copied_components * layout.component_bytes;
+  for (uint32_t row = 0; row < layout.height; row++) {
+    const uint32_t source_row = layout.source_height - 1 - (layout.source_y + row);
+    const uint8_t *source_pixel = source + size_t(source_row) * layout.source_row_bytes +
+                                  size_t(layout.source_x) * layout.source_texel_bytes;
+    uint8_t *destination_pixel = destination + size_t(row) * layout.destination_row_bytes;
+    for (uint32_t column = 0; column < layout.width; column++) {
+      std::memcpy(destination_pixel, source_pixel, copied_bytes);
+      if (layout.destination_components == 4 && layout.source_components < 4) {
+        std::memcpy(destination_pixel + 3 * layout.component_bytes,
+                    one_component,
+                    layout.component_bytes);
+      }
+      source_pixel += layout.source_texel_bytes;
+      destination_pixel += layout.destination_texel_bytes;
+    }
+  }
+  return true;
+}
