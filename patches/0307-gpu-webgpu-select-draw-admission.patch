+/**
+ * A select-next result starts from a cleared output buffer, so every valid selection batch must
+ * reach its draw command before that clear can be interpreted as a genuine miss. Keep this guard
+ * armed across every synchronous pre-encode exit that is not otherwise classified as a pending
+ * module, pipeline, or binding. Ordinary draws and native builds remain untouched.
+ */
+class SelectionDrawAdmission {
+ public:
+  explicit SelectionDrawAdmission(WGPUShader *shader)
+  {
+#ifdef __EMSCRIPTEN__
+    shader_ = shader;
+    armed_ = shader != nullptr && (G.f & G_FLAG_PICKSEL) != 0;
+#else
+    (void)shader;
+#endif
+  }
+
+  ~SelectionDrawAdmission()
+  {
+#ifdef __EMSCRIPTEN__
+    if (!armed_) {
+      return;
+    }
+    note_webgpu_draw_drop();
+    static std::atomic<uint32_t> log_count{0};
+    if (log_count.fetch_add(1u, std::memory_order_relaxed) < 128u) {
+      std::printf("[bw] WGPUWeb-select-draw-drop shader=%s stage=%s\n",
+                  shader_->name_get().c_str(),
+                  stage_);
+    }
+#endif
+  }
+
+  void stage(const char *stage)
+  {
+#ifdef __EMSCRIPTEN__
+    stage_ = stage;
+#else
+    (void)stage;
+#endif
+  }
+
+  void admit()
+  {
+#ifdef __EMSCRIPTEN__
+    armed_ = false;
+#endif
+  }
+
+ private:
+#ifdef __EMSCRIPTEN__
+  WGPUShader *shader_ = nullptr;
+  const char *stage_ = "module";
+  bool armed_ = false;
+#endif
+};
