+struct ByteReader {
+  const unsigned char *data = nullptr;
+  size_t size = 0;
+  size_t offset = 0;
+
+  bool read(void *out, size_t bytes)
+  {
+    if (offset > size || bytes > size - offset) {
+      return false;
+    }
+    if (bytes != 0) {
+      std::memcpy(out, data + offset, bytes);
+    }
+    offset += bytes;
+    return true;
+  }
+
+  template<typename T> bool scalar(T &out)
+  {
+    return read(&out, sizeof(out));
+  }
+
+  bool skip(size_t bytes)
+  {
+    if (offset > size || bytes > size - offset) {
+      return false;
+    }
+    offset += bytes;
+    return true;
+  }
+
+  bool at_end() const { return offset == size; }
+};
+
+constexpr size_t kCacheHeaderBytes = sizeof(kMagic) + sizeof(uint32_t) + sizeof(uint64_t) * 3 +
+                                     sizeof(uint32_t) * 3 + sizeof(uint64_t);
+
+bool read_bounded_file(const char *path, size_t max_bytes, std::vector<unsigned char> &out)
+{
+  FILE *f = std::fopen(path, "rb");
+  if (f == nullptr) {
+    return false;
+  }
+  bool ok = false;
+  do {
+    if (std::fseek(f, 0, SEEK_END) != 0) {
+      break;
+    }
+    const long end = std::ftell(f);
+    if (end < 0 || static_cast<unsigned long>(end) > max_bytes ||
+        std::fseek(f, 0, SEEK_SET) != 0)
+    {
+      break;
+    }
+    std::vector<unsigned char> bytes(static_cast<size_t>(end));
+    if (!bytes.empty() && !read_exact(f, bytes.data(), bytes.size())) {
+      break;
+    }
+    if (std::fgetc(f) != EOF || std::ferror(f) != 0) {
+      break;
+    }
+    out = std::move(bytes);
+    ok = true;
+  } while (false);
+  std::fclose(f);
+  return ok;
+}
+
+bool decode_cache_entry(const unsigned char *data,
+                        size_t size,
+                        const ShaderCacheKey &key,
+                        std::string &vertex_wgsl,
+                        std::string &fragment_wgsl,
+                        std::string &compute_wgsl)
+{
+  ByteReader reader{data, size};
+  char magic[4];
+  uint32_t fmt = 0;
+  uint64_t salt = 0;
+  uint64_t stored_key_hi = 0, stored_key_lo = 0;
+  uint32_t vlen = 0, flen = 0, clen = 0;
+  uint64_t expected_payload_hash = 0;
+  if (!reader.read(magic, sizeof(magic)) || std::memcmp(magic, kMagic, sizeof(magic)) != 0 ||
+      !reader.scalar(fmt) || fmt != kFormatVersion || !reader.scalar(salt) ||
+      salt != salt_hash() || !reader.scalar(stored_key_hi) || !reader.scalar(stored_key_lo) ||
+      stored_key_hi != key.hi || stored_key_lo != key.lo || !reader.scalar(vlen) ||
+      !reader.scalar(flen) || !reader.scalar(clen) || vlen > kMaxStageBytes ||
+      flen > kMaxStageBytes || clen > kMaxStageBytes ||
+      !reader.scalar(expected_payload_hash))
+  {
+    return false;
+  }
+  const size_t payload_bytes = size_t(vlen) + size_t(flen) + size_t(clen);
+  if (reader.offset > reader.size || payload_bytes != reader.size - reader.offset) {
+    return false;
+  }
+  std::string v(vlen, '\0'), fr(flen, '\0'), c(clen, '\0');
+  if ((vlen != 0 && !reader.read(v.data(), vlen)) ||
+      (flen != 0 && !reader.read(fr.data(), flen)) ||
+      (clen != 0 && !reader.read(c.data(), clen)) || !reader.at_end() ||
+      payload_hash(v, fr, c) != expected_payload_hash)
+  {
+    return false;
+  }
+  vertex_wgsl = std::move(v);
+  fragment_wgsl = std::move(fr);
+  compute_wgsl = std::move(c);
+  return true;
+}
+
+struct SeedRecord {
+  ShaderCacheKey key;
+  size_t offset = 0;
+  uint32_t size = 0;
+};
+
+struct SeedIndex {
+  bool attempted = false;
+  bool valid = false;
+  std::vector<unsigned char> bytes;
+  std::vector<SeedRecord> records;
+};
+
+const char *seed_path()
+{
+  const char *override_path = std::getenv("BW_SHADER_CACHE_SEED");
+  if (override_path == nullptr) {
+    return kSeedPath;
+  }
+  return std::strcmp(override_path, "0") == 0 ? nullptr : override_path;
+}
+
+SeedIndex &seed_index()
+{
+  static SeedIndex index;
+  if (index.attempted) {
+    return index;
+  }
+  index.attempted = true;
+  const char *path = seed_path();
+  if (path == nullptr || !read_bounded_file(path, kMaxSeedPackBytes, index.bytes)) {
+    return index;
+  }
+
+  ByteReader reader{index.bytes.data(), index.bytes.size()};
+  char magic[4];
+  uint32_t format = 0, count = 0;
+  if (!reader.read(magic, sizeof(magic)) ||
+      std::memcmp(magic, kSeedMagic, sizeof(magic)) != 0 || !reader.scalar(format) ||
+      format != kSeedFormatVersion || !reader.scalar(count) || count == 0 ||
+      count > kMaxSeedEntries)
+  {
+    index.bytes.clear();
+    return index;
+  }
+
+  index.records.reserve(count);
+  ShaderCacheKey previous{};
+  bool have_previous = false;
+  for (uint32_t entry = 0; entry < count; entry++) {
+    SeedRecord record;
+    if (!reader.scalar(record.key.hi) || !reader.scalar(record.key.lo) ||
+        !reader.scalar(record.size) || record.size < kCacheHeaderBytes)
+    {
+      index.records.clear();
+      index.bytes.clear();
+      return index;
+    }
+    const bool ordered = !have_previous || previous.hi < record.key.hi ||
+                         (previous.hi == record.key.hi && previous.lo < record.key.lo);
+    if (!ordered) {
+      index.records.clear();
+      index.bytes.clear();
+      return index;
+    }
+    record.offset = reader.offset;
+    if (!reader.skip(record.size)) {
+      index.records.clear();
+      index.bytes.clear();
+      return index;
+    }
+    index.records.push_back(record);
+    previous = record.key;
+    have_previous = true;
+  }
+  if (!reader.at_end()) {
+    index.records.clear();
+    index.bytes.clear();
+    return index;
+  }
+  index.valid = true;
+  printf("[bw] BW_SHADER_CACHE_SEED loaded entries=%zu bytes=%zu\n",
+         index.records.size(),
+         index.bytes.size());
+  fflush(stdout);
+  return index;
+}
+
+bool seed_cache_lookup(const ShaderCacheKey &key,
+                       std::string &vertex_wgsl,
+                       std::string &fragment_wgsl,
+                       std::string &compute_wgsl)
+{
+  SeedIndex &index = seed_index();
+  if (!index.valid) {
+    return false;
+  }
+  for (const SeedRecord &record : index.records) {
+    if (record.key.hi == key.hi && record.key.lo == key.lo) {
+      return decode_cache_entry(index.bytes.data() + record.offset,
+                                record.size,
+                                key,
+                                vertex_wgsl,
+                                fragment_wgsl,
+                                compute_wgsl);
+    }
+  }
+  return false;
+}
