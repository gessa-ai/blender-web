+  GPU_texture_clear(srgb, GPU_DATA_FLOAT, color);
+  uchar4 *srgb_bytes = static_cast<uchar4 *>(GPU_texture_read(base, GPU_DATA_UBYTE, 0));
+  ASSERT_NE(srgb_bytes, nullptr);
+  EXPECT_NEAR((*srgb_bytes)[0], 64, 1);
+  EXPECT_NEAR((*srgb_bytes)[1], 128, 1);
+  EXPECT_NEAR((*srgb_bytes)[2], 191, 1);
