+/** One axis of Blender's native mipmap reduction kernel. */
+struct MipmapAxisPlan {
+  uint32_t tap_count = 0;
+  float weights[3] = {0.0f, 0.0f, 0.0f};
+};
+
+/** Derive the pinned native mipmap kernel for one source axis and destination coordinate.
+ * Even axes average two texels. Odd axes use three position-dependent weights so their final
+ * source texel contributes instead of being discarded. Failure leaves `result` unchanged. */
+inline bool mipmap_axis_plan(uint32_t input_size,
+                             uint32_t output_coordinate,
+                             MipmapAxisPlan &result)
+{
+  if (input_size == 0) {
+    return false;
+  }
+  const uint32_t output_size = input_size == 1 ? 1 : input_size / 2;
+  if (output_coordinate >= output_size) {
+    return false;
+  }
+
+  MipmapAxisPlan candidate;
+  if (input_size == 1) {
+    candidate.tap_count = 1;
+    candidate.weights[0] = 1.0f;
+  }
+  else if ((input_size & 1u) == 0) {
+    candidate.tap_count = 2;
+    candidate.weights[0] = 0.5f;
+    candidate.weights[1] = 0.5f;
+  }
+  else {
+    candidate.tap_count = 3;
+    const float reciprocal = 1.0f / float(2u * output_size + 1u);
+    candidate.weights[0] = reciprocal * float(output_size - output_coordinate);
+    candidate.weights[1] = reciprocal * float(output_size);
+    candidate.weights[2] = 1.0f - candidate.weights[0] - candidate.weights[1];
+  }
+  result = candidate;
+  return true;
+}
+
+/** Complete shipping WGSL for normalized/float render-fallback mipmap generation. The 1/2/3-tap
+ * separable kernel is equivalent to `gpu_shader_2D_update_mipmaps.bsl.hh` at the pinned source. */
+inline const char *mipmap_float_shader_source()
+{
+  return R"WGSL(struct VOut { @builtin(position) pos : vec4f, };
+@vertex fn vs_main(@builtin(vertex_index) vid : u32) -> VOut {
+  var o : VOut;
+  let x = f32((vid << 1u) & 2u);
+  let y = f32(vid & 2u);
+  o.pos = vec4f(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);
+  return o;
+}
+@group(0) @binding(0) var src_tex : texture_2d<f32>;
+
+fn mip_axis_tap_count(input_size : u32) -> u32 {
+  if (input_size == 1u) {
+    return 1u;
+  }
+  return 2u | (input_size & 1u);
+}
+
+fn mip_axis_weights(input_size : u32, output_coordinate : u32) -> vec3f {
+  if (input_size == 1u) {
+    return vec3f(1.0, 0.0, 0.0);
+  }
+  if ((input_size & 1u) == 0u) {
+    return vec3f(0.5, 0.5, 0.0);
+  }
+  let output_size = input_size / 2u;
+  let reciprocal = 1.0 / f32(2u * output_size + 1u);
+  let w0 = reciprocal * f32(output_size - output_coordinate);
+  let w1 = reciprocal * f32(output_size);
+  return vec3f(w0, w1, 1.0 - w0 - w1);
+}
+
+@fragment fn fs_main(i : VOut) -> @location(0) vec4f {
+  let dims = textureDimensions(src_tex);
+  let output_coordinate = vec2u(i.pos.xy);
+  let source_origin = output_coordinate * 2u;
+  let tap_count = vec2u(mip_axis_tap_count(dims.x), mip_axis_tap_count(dims.y));
+  let weights_x = mip_axis_weights(dims.x, output_coordinate.x);
+  let weights_y = mip_axis_weights(dims.y, output_coordinate.y);
+  var result = vec4f(0.0);
+  for (var y = 0u; y < tap_count.y; y += 1u) {
+    for (var x = 0u; x < tap_count.x; x += 1u) {
+      result += textureLoad(src_tex, vec2i(source_origin + vec2u(x, y)), 0) * weights_x[x] *
+                weights_y[y];
+    }
+  }
+  return result;
+}
+)WGSL";
+}
