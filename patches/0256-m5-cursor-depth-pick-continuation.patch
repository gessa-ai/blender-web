+/**
+ * Owned depth sample used by browser operators that cannot block the WM event loop.
+ *
+ * `init()` captures the exact viewport, screen coordinate, and view transform, then starts the
+ * same progressively widened auto-distance sample as #ED_view3d_autodist. Native backends may be
+ * ready immediately; browser callers must poll across event-loop ticks. A view or region change
+ * before `sample()` fails closed instead of unprojecting pixels with a different transform.
+ */
+class ViewportDepthPickSession {
+ public:
+  enum class ReadbackState {
+    Pending,
+    Ready,
+    Failed,
+  };
+
+ private:
+  struct Impl;
+  Impl *impl_ = nullptr;
+
+ public:
+  ViewportDepthPickSession() = default;
+  ~ViewportDepthPickSession();
+
+  ViewportDepthPickSession(const ViewportDepthPickSession &) = delete;
+  ViewportDepthPickSession &operator=(const ViewportDepthPickSession &) = delete;
+
+  bool init(ARegion *region, const int mval[2]);
+  ReadbackState state();
+  /** Return the exact world-space surface point once ready. False also means no depth was hit. */
+  bool sample(ARegion *region, float r_world_location[3]);
+};
