From: blender-web contributors
Subject: editors: let the windowed web profile omit sculpt and paint registration

Sculpt and paint are outside the launch tier and their operator/keymap roots retain
nearly half a megabyte of Brotli-compressed Wasm. Keep all stock desktop and
headless behavior, shared data/RNA, mode-exit, undo, and Workbench helpers while
letting the windowed profile leave only those registration roots unreachable.

diff --git a/source/blender/editors/space_api/CMakeLists.txt b/source/blender/editors/space_api/CMakeLists.txt
index 8b45bbc7f9f..b1012aa247f 100644
--- a/source/blender/editors/space_api/CMakeLists.txt
+++ b/source/blender/editors/space_api/CMakeLists.txt
@@ -47,3 +47,17 @@ set(LIB
 )
 
 blender_add_lib(bf_editor_space_api "${SRC}" "${INC}" "${INC_SYS}" "${LIB}")
+
+# Keep Blender's stock behavior for every non-web or headless build. The
+# windowed browser profile can omit non-launch sculpt/paint registration so
+# wasm-ld can collect its otherwise unreachable operator implementation graph.
+if(NOT DEFINED WITH_BLENDER_WEB_SCULPT_PAINT)
+  if(WITH_BLENDER_WEB_WINDOWED)
+    set(WITH_BLENDER_WEB_SCULPT_PAINT OFF)
+  else()
+    set(WITH_BLENDER_WEB_SCULPT_PAINT ON)
+  endif()
+endif()
+if(WITH_BLENDER_WEB_SCULPT_PAINT)
+  target_compile_definitions(bf_editor_space_api PRIVATE WITH_BLENDER_WEB_SCULPT_PAINT)
+endif()
diff --git a/source/blender/editors/space_api/spacetypes.cc b/source/blender/editors/space_api/spacetypes.cc
index ad21b369a72..9af25acd43f 100644
--- a/source/blender/editors/space_api/spacetypes.cc
+++ b/source/blender/editors/space_api/spacetypes.cc
@@ -101,10 +101,14 @@ void ED_spacetypes_init()
   ED_operatortypes_lattice();
   ED_operatortypes_mesh();
   geometry::operatortypes_geometry();
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_SCULPT_PAINT)
   sculpt_paint::operatortypes_sculpt();
   ED_operatortypes_sculpt_curves();
+#endif
   ED_operatortypes_uvedit();
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_SCULPT_PAINT)
   ED_operatortypes_paint();
+#endif
   ED_operatortypes_physics();
   ED_operatortypes_curve();
   curves::operatortypes_curves();
@@ -169,7 +173,9 @@ void ED_spacemacros_init()
   pointcloud::operatormacros_pointcloud();
   ED_operatormacros_mask();
   vse::ED_operatormacros_sequencer();
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_SCULPT_PAINT)
   ED_operatormacros_paint();
+#endif
   ED_operatormacros_grease_pencil();
   ED_operatormacros_nla();
 
@@ -200,10 +206,14 @@ void ED_spacetypes_keymap(wmKeyConfig *keyconf)
   ED_keymap_armature(keyconf);
   ED_keymap_physics(keyconf);
   ED_keymap_metaball(keyconf);
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_SCULPT_PAINT)
   ED_keymap_paint(keyconf);
+#endif
   ED_keymap_mask(keyconf);
   ED_keymap_marker(keyconf);
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_SCULPT_PAINT)
   sculpt_paint::keymap_sculpt(keyconf);
+#endif
 
   ui::ED_keymap_view2d(keyconf);
   ui::keymap_ui(keyconf);
