+/** Exact byte geometry for Blender's emulated multi-draw loop. Every generated
+ * DrawIndirect/DrawIndexedIndirect call addresses one fixed-size command. */
+struct IndirectDrawSpan {
+  uint64_t first_offset = 0;
+  uint64_t command_stride = 0;
+  uint64_t command_size = 0;
+  uint64_t end_offset = 0;
+};
+
+/** Validate signed frontend inputs, normalize GL's tightly-packed zero stride,
+ * and prove every 16-byte array or 20-byte indexed command fits the allocation.
+ * Rejection leaves `r_span` unchanged. */
+bool indirect_draw_span(int count,
+                        intptr_t offset,
+                        intptr_t stride,
+                        bool indexed,
+                        uint64_t buffer_size,
+                        IndirectDrawSpan &r_span);

