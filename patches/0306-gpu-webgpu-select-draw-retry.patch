+bool Buffer::create_for_draw_scope(const wgpu::Instance &instance,
+                                   const wgpu::Device &device,
+                                   OrderedQueueScheduler &scheduler,
+                                   const BufferKind kind,
+                                   const UsageType usage,
+                                   const size_t size,
+                                   const void *initial_data,
+                                   const bool readable,
+                                   const char *label)
+{
+#ifdef __EMSCRIPTEN__
+  /* Selection without a viewport owns a one-draw DRWData. A persistent allocation cannot publish
+   * until after that owner is destroyed, so every retry would recreate the same pending buffers.
+   * Reserve their validation and dependent work in this exact ordered queue epoch instead. */
+  if ((G.f & G_FLAG_PICKSEL) != 0) {
+    return create_transient(
+        instance, device, scheduler, kind, usage, size, initial_data, readable, label);
+  }
+#else
+  (void)scheduler;
+#endif
+  return create_scoped(instance, device, kind, usage, size, initial_data, readable, label);
+}
+
