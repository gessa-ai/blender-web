- * device-free testable on native and Wasm. */
+ * submitting a failed command-buffer handle. A boolean encoder callback can abort the whole
+ * transaction after earlier commands were recorded; a void callback retains the simple copy
+ * contract. Templated so transient creation failures remain device-free testable on native and
+ * Wasm. */
 template<typename DeviceT, typename QueueT, typename EncodeFn>
 inline bool command_encode_submit_if_valid(const DeviceT &device,
                                            const QueueT &queue,
@@ -153,7 +156,15 @@ inline bool command_encode_submit_if_valid(const DeviceT &device,
