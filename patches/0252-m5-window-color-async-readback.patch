+EyedropperWindowColorSampleSession::~EyedropperWindowColorSampleSession()
+{
+  cancel();
+}
+
+void EyedropperWindowColorSampleSession::cancel()
+{
+  WM_window_pixels_read_async_cancel(readback_);
+  MEM_SAFE_DELETE(pixels_);
+  window_ = nullptr;
+  size_[0] = 0;
+  size_[1] = 0;
+  state_ = ReadbackState::Invalid;
+}
+
+bool EyedropperWindowColorSampleSession::init(bContext *C, wmWindow *window)
+{
+  if (C == nullptr || window == nullptr) {
+    return false;
+  }
+  if (window_ == window && state_ != ReadbackState::Failed) {
+    return true;
+  }
+
+  cancel();
+  readback_ = WM_window_pixels_read_async(C, window);
+  if (readback_ == nullptr) {
+    state_ = ReadbackState::Failed;
+    return false;
+  }
+  window_ = window;
+  state_ = ReadbackState::Pending;
+  return true;
+}
+
+EyedropperWindowColorSampleSession::ReadbackState EyedropperWindowColorSampleSession::state()
+{
+  if (state_ != ReadbackState::Pending) {
+    return state_;
+  }
+
+  const WMWindowPixelsReadStatus status = WM_window_pixels_read_async_status(readback_);
+  if (status == WMWindowPixelsReadStatus::Pending) {
+    return state_;
+  }
+  if (status != WMWindowPixelsReadStatus::Ready) {
+    WM_window_pixels_read_async_cancel(readback_);
+    state_ = ReadbackState::Failed;
+    return state_;
+  }
+
+  pixels_ = WM_window_pixels_read_async_consume(readback_, size_);
+  if (pixels_ == nullptr || size_[0] <= 0 || size_[1] <= 0) {
+    MEM_SAFE_DELETE(pixels_);
+    state_ = ReadbackState::Failed;
+    return state_;
+  }
+  state_ = ReadbackState::Ready;
+  return state_;
+}
+
+bool EyedropperWindowColorSampleSession::sample(const int pos[2], float r_col[3])
+{
+  if (pos == nullptr || r_col == nullptr || state() != ReadbackState::Ready ||
+      uint(pos[0]) >= uint(size_[0]) || uint(pos[1]) >= uint(size_[1]))
+  {
+    return false;
+  }
+
+  const unsigned char *pixel = pixels_ + (size_t(pos[1]) * size_t(size_[0]) + size_t(pos[0])) * 4;
+  r_col[0] = float(pixel[0]) / 255.0f;
+  r_col[1] = float(pixel[1]) / 255.0f;
+  r_col[2] = float(pixel[2]) / 255.0f;
+  return true;
+}
