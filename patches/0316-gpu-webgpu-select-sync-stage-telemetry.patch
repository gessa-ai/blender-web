+bool web_select_shader_compile_traced(const shader::ShaderCreateInfo &info)
+{
+  return info.name_.rfind("select_id_", 0) == 0 ||
+         (info.name_.size() >= 11 &&
+          info.name_.compare(info.name_.size() - 11, 11, "_selectable") == 0);
+}
+
+void web_select_shader_compile_begin(const shader::ShaderCreateInfo &info)
+{
+  if (!web_select_shader_compile_traced(info)) {
+    return;
+  }
+  const uint32_t kind = info.name_ == "select_id_flat" ? 1u :
+                        info.name_ == "select_id_uniform" ? 2u : 3u;
+  web_select_shader_compile_kind.store(kind, std::memory_order_release);
+  web_select_shader_compile_stage.store(1u, std::memory_order_release);
+}
+
+void web_select_shader_compile_stage_store(const shader::ShaderCreateInfo &info,
+                                           const uint32_t stage)
+{
+  if (web_select_shader_compile_traced(info)) {
+    web_select_shader_compile_stage.store(stage, std::memory_order_release);
+  }
+}
+
