diff --git a/source/blender/gpu/webgpu/wgpu_texture.cc b/source/blender/gpu/webgpu/wgpu_texture.cc
index 29adf4b..241a49a 100644
--- a/source/blender/gpu/webgpu/wgpu_texture.cc
+++ b/source/blender/gpu/webgpu/wgpu_texture.cc
@@ -33,9 +33,15 @@
 
 #include <algorithm>
 #include <cmath>
+#include <cstdio>
 #include <cstring>
+#include <string>
 #include <vector>
 
+/* Raw fd-2 stderr for the diagnostic readback (the only reliable web console
+ * channel — see notes/m5-windowed-replay.md). */
+#include <unistd.h>
+
 namespace blender::gpu::webgpu {
 
 /* -------------------------------------------------------------------- */
@@ -1285,6 +1291,225 @@ void WGPUTexture::read(int mip, eGPUDataFormat format, void *data)
   convert_device_to_host(static_cast<uint8_t *>(data), device_data.data(), sample_count, format);
 }
 
+/* -------------------------------------------------------------------- */
+/** \name Diagnostic kick-then-consume readback (M4 r31)
+ *
+ * The windowed WM-worker profile cannot block on a map future (ADR-006/ADR-007), so
+ * this is the async twin of read(): kick a copy + MapAsync(AllowProcessEvents) and
+ * return; the completion is drained by WGPUContext::activate pumping ProcessEvents on
+ * a later tick. See wgpu_diag_readback.hh. Inert unless a diagnostic caller invokes it.
+ * \{ */
+
+namespace {
+
+struct DiagPending {
+  wgpu::Buffer staging;
+  uint32_t w = 0;
+  uint32_t h = 0;
+  uint32_t z = 0;
+  uint32_t texel_bytes = 0;
+  uint32_t bytes_per_row = 0; /* 256-aligned copy pitch */
+  uint32_t row_bytes = 0;     /* tight pitch (w * texel_bytes) */
+  uint32_t wgpu_format = 0;
+  size_t staging_size = 0;
+  int seq = 0;
+  std::string label;
+};
+
+/* Monotonic sequence for /tmp/bw_readback_<n>.bin naming, shared with the rig. */
+static int g_diag_seq = 0;
+
+static void diag_stderr_line(const char *s)
+{
+  /* Raw fd 2 reaches Module.printErr per newline; Python/C stdout is block-buffered
+   * and never flushes on the web (no process exit) — see notes/m5-windowed-replay.md. */
+  size_t n = std::strlen(s);
+  ssize_t rc = ::write(2, s, n);
+  (void)rc;
+}
+
+static void diag_complete(DiagPending *p, wgpu::MapAsyncStatus status)
+{
+  char line[320];
+  if (status != wgpu::MapAsyncStatus::Success) {
+    std::snprintf(line,
+                  sizeof(line),
+                  "BW_READBACK_DONE seq=%d label=%s status=mapfail(%d)\n",
+                  p->seq,
+                  p->label.c_str(),
+                  int(status));
+    diag_stderr_line(line);
+    delete p;
+    return;
+  }
+  const uint8_t *mapped = static_cast<const uint8_t *>(
+      p->staging.GetConstMappedRange(0, p->staging_size));
+  if (mapped == nullptr) {
+    std::snprintf(line,
+                  sizeof(line),
+                  "BW_READBACK_DONE seq=%d label=%s status=nomap\n",
+                  p->seq,
+                  p->label.c_str());
+    diag_stderr_line(line);
+    p->staging.Unmap();
+    delete p;
+    return;
+  }
+
+  char path[96];
+  std::snprintf(path, sizeof(path), "/tmp/bw_readback_%d.bin", p->seq);
+  const size_t data_bytes = size_t(p->row_bytes) * p->h * std::max<uint32_t>(p->z, 1u);
+  uint32_t hdr[8];
+  std::memcpy(&hdr[0], "BWRB", 4);
+  hdr[1] = 1u; /* version */
+  hdr[2] = p->w;
+  hdr[3] = p->h;
+  hdr[4] = p->wgpu_format;
+  hdr[5] = p->texel_bytes;
+  hdr[6] = p->row_bytes; /* tight row pitch */
+  hdr[7] = uint32_t(data_bytes);
+
+  bool wrote = false;
+  if (FILE *f = std::fopen(path, "wb")) {
+    std::fwrite(hdr, 1, sizeof(hdr), f);
+    const uint32_t layers = std::max<uint32_t>(p->z, 1u);
+    for (uint32_t zz = 0; zz < layers; zz++) {
+      for (uint32_t y = 0; y < p->h; y++) {
+        const uint8_t *row = mapped + (size_t(zz) * p->h + y) * p->bytes_per_row;
+        std::fwrite(row, 1, p->row_bytes, f);
+      }
+    }
+    std::fclose(f);
+    wrote = true;
+  }
+  p->staging.Unmap();
+
+  std::snprintf(line,
+                sizeof(line),
+                "BW_READBACK_DONE seq=%d label=%s file=%s w=%u h=%u fmt=%u texel=%u "
+                "pitch=%u bytes=%zu status=%s\n",
+                p->seq,
+                p->label.c_str(),
+                path,
+                p->w,
+                p->h,
+                p->wgpu_format,
+                p->texel_bytes,
+                p->row_bytes,
+                data_bytes,
+                wrote ? "ok" : "writefail");
+  diag_stderr_line(line);
+  delete p;
+}
+
+}  // namespace
+
+void WGPUTexture::diag_kick_readback(const char *label)
+{
+  const std::string lbl = (label != nullptr) ? label : "";
+  char line[192];
+  if (texture_ == nullptr) {
+    std::snprintf(line, sizeof(line), "BW_READBACK_KICK label=%s status=notexture\n", lbl.c_str());
+    diag_stderr_line(line);
+    return;
+  }
+  const Repr repr = snorm16_emulated_ ? Repr::Snorm16 : repr_of(format_);
+  if (repr == Repr::Compressed || repr == Repr::Unsupported) {
+    std::snprintf(line, sizeof(line), "BW_READBACK_KICK label=%s status=badformat\n", lbl.c_str());
+    diag_stderr_line(line);
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    std::snprintf(line, sizeof(line), "BW_READBACK_KICK label=%s status=noctx\n", lbl.c_str());
+    diag_stderr_line(line);
+    return;
+  }
+
+  int mip_size[3] = {1, 1, 1};
+  mip_size_get(0, mip_size);
+  const uint32_t ex = uint32_t(std::max(mip_size[0], 1));
+  const uint32_t ey = uint32_t(std::max(mip_size[1], 1));
+  const uint32_t ez = uint32_t(std::max(mip_size[2], 1));
+  const uint32_t texel_bytes = device_texel_bytes(format_, conv_, repr);
+
+  const uint32_t row_bytes = ex * texel_bytes;
+  const uint32_t bytes_per_row = uint32_t(align_up(row_bytes, 256));
+  const size_t staging_size = size_t(bytes_per_row) * ey * ez;
+
+  /* Depth textures copy their depth aspect only (Depth24Plus is uncopyable, but the
+   * gbuffer depth is Depth32Float which copies fine as f32). */
+  const wgpu::TextureAspect aspect = (format_flag_ & GPU_FORMAT_DEPTH) ?
+                                         wgpu::TextureAspect::DepthOnly :
+                                         wgpu::TextureAspect::All;
+
+  wgpu::Device device = ctx->device_get();
+  wgpu::BufferDescriptor bd = {};
+  bd.size = staging_size;
+  bd.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+  wgpu::Buffer staging = device.CreateBuffer(&bd);
+  if (staging == nullptr) {
+    std::snprintf(line, sizeof(line), "BW_READBACK_KICK label=%s status=nostaging\n", lbl.c_str());
+    diag_stderr_line(line);
+    return;
+  }
+
+  wgpu::TexelCopyTextureInfo src = {};
+  src.texture = texture_;
+  src.mipLevel = 0;
+  src.origin = {0, 0, 0};
+  src.aspect = aspect;
+
+  wgpu::TexelCopyBufferInfo dst = {};
+  dst.buffer = staging;
+  dst.layout.offset = 0;
+  dst.layout.bytesPerRow = bytes_per_row;
+  dst.layout.rowsPerImage = ey;
+
+  wgpu::Extent3D copy_size = {ex, ey, ez};
+  wgpu::CommandEncoder enc = device.CreateCommandEncoder();
+  enc.CopyTextureToBuffer(&src, &dst, &copy_size);
+  wgpu::CommandBuffer cb = enc.Finish();
+  ctx->queue_get().Submit(1, &cb);
+
+  DiagPending *p = new DiagPending();
+  p->staging = staging;
+  p->w = ex;
+  p->h = ey;
+  p->z = ez;
+  p->texel_bytes = texel_bytes;
+  p->bytes_per_row = bytes_per_row;
+  p->row_bytes = row_bytes;
+  p->wgpu_format = uint32_t(wgpu_format_);
+  p->staging_size = staging_size;
+  p->seq = g_diag_seq++;
+  p->label = lbl;
+
+  std::snprintf(line,
+                sizeof(line),
+                "BW_READBACK_KICK seq=%d label=%s w=%u h=%u fmt=%u texel=%u\n",
+                p->seq,
+                p->label.c_str(),
+                ex,
+                ey,
+                p->wgpu_format,
+                texel_bytes);
+  diag_stderr_line(line);
+
+  /* AllowSpontaneous: the callback fires as soon as the underlying JS mapAsync promise
+   * resolves on the WM worker's own event loop, between main-loop ticks (ADR-007
+   * finding 2) — it does NOT depend on instance.ProcessEvents (which the imported-device
+   * windowed profile does not drive for map futures). p (and thus the staging buffer)
+   * is kept alive by the capture until then, and freed in diag_complete. */
+  staging.MapAsync(wgpu::MapMode::Read,
+                   0,
+                   staging_size,
+                   wgpu::CallbackMode::AllowSpontaneous,
+                   [p](wgpu::MapAsyncStatus s, wgpu::StringView) { diag_complete(p, s); });
+}
