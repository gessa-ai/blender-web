+static wmOperatorStatus grease_pencil_fill_apply_or_defer(bContext &C,
+                                                           wmOperator &op,
+                                                           const wmEvent &event)
+{
+  ARegion &region = *CTX_wm_region(&C);
+  if (!BLI_rcti_isect_pt_v(&region.winrct, event.xy)) {
+    return OPERATOR_CANCELLED;
+  }
+
+  auto &op_data = *static_cast<GreasePencilFillOpData *>(op.customdata);
+  const ViewContext view_context = ED_view3d_viewcontext_init(
+      &C, CTX_data_depsgraph_pointer(&C));
+  Scene &scene = *CTX_data_scene(&C);
+  View3D &view3d = *view_context.v3d;
+  Depsgraph &depsgraph = *view_context.depsgraph;
+  Object &object = *view_context.obact;
+  const Object &object_eval = *DEG_get_evaluated(&depsgraph, &object);
+  GreasePencil *grease_pencil = id_cast<GreasePencil *>(object.data);
+  if (grease_pencil == nullptr || !grease_pencil->has_active_layer()) {
+    return OPERATOR_CANCELLED;
+  }
+
+  op_data.depth_cache_placement.emplace(
+      scene, region, view3d, object_eval, grease_pencil->get_active_layer());
+  ed::greasepencil::DrawingPlacementDepthCacheState state =
+      ed::greasepencil::DrawingPlacementDepthCacheState::Ready;
+  if (op_data.depth_cache_placement->use_project_to_surface() ||
+      op_data.depth_cache_placement->use_project_to_stroke())
+  {
+    state = op_data.depth_cache_placement->cache_viewport_depths_async(
+        &depsgraph, &region, &view3d);
+  }
+  if (state == ed::greasepencil::DrawingPlacementDepthCacheState::Pending) {
+    if (!grease_pencil_fill_depth_cache_wait_begin(C, op_data, event)) {
+      BKE_report(op.reports, RPT_ERROR, "Unable to retain Grease Pencil fill depth");
+      grease_pencil_fill_depth_cache_clear(op_data);
+      return OPERATOR_CANCELLED;
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  const bool applied = grease_pencil_apply_fill(C, op, event, *op_data.depth_cache_placement);
+  op_data.depth_cache_placement.reset();
+  return applied ? OPERATOR_FINISHED : OPERATOR_CANCELLED;
+}
