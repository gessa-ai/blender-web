index 18e22f356ac1bbf28c59c3695024cc8e7241c251..b8b5d6aa33f04a7b9405ad439add017468e04cc8 100644
--- a/source/blender/gpu/intern/gpu_select_next.cc
+++ b/source/blender/gpu/intern/gpu_select_next.cc
@@ -8,9 +8,13 @@
  * Glue to make the new Select-Next engine work with the old GPU select API.
  */
 #include <cfloat>
+#include <cstring>
 
 #include "BLI_rect.h"
 #include "BLI_span.hh"
+#include "BLI_vector.hh"
+
+#include "GPU_readback.hh"
 
 #include "gpu_select_private.hh"
 
@@ -31,6 +35,109 @@ struct GPUSelectNextState {
 
 static GPUSelectNextState g_state = {};
 
+struct GPUSelectAsyncKey {
+  rcti rect = {0, 0, 0, 0};
+  int radius = 0;
+  GPUSelectMode mode = GPU_SELECT_INVALID;
+
+  bool operator==(const GPUSelectAsyncKey &other) const
+  {
+    return radius == other.radius && mode == other.mode && BLI_rcti_compare(&rect, &other.rect);
+  }
+};
+
+struct GPUSelectAsyncResult {
+  GPUSelectAsyncKey key;
+  Vector<GPUSelectResult> hits;
+};
+
+struct GPUSelectAsyncState {
+  bool session_active = false;
+  bool failed = false;
+  eGPUReadbackError error = GPU_READBACK_ERROR_NONE;
+  GPUReadback *readback = nullptr;
+  GPUSelectAsyncKey pending_key;
+  Vector<uint> select_id_map;
+  Vector<bool> in_front_map;
+  Vector<GPUSelectAsyncResult> results;
+};
+
+static GPUSelectAsyncState g_async = {};
+
+static GPUSelectAsyncKey gpu_select_async_key_from_state()
+{
+  return {g_state.rect, g_state.radius, g_state.mode};
+}
+
+static GPUSelectAsyncKey gpu_select_async_key_create(const rcti *rect,
+                                                     const int radius,
+                                                     const GPUSelectMode mode)
+{
+  return {*rect, radius, mode};
+}
+
+static void gpu_select_async_fail(const eGPUReadbackError error)
+{
+  GPU_readback_cancel(g_async.readback);
+  g_async.failed = true;
+  g_async.error = error == GPU_READBACK_ERROR_NONE ? GPU_READBACK_ERROR_BACKEND_FAILURE : error;
+}
+
+static void gpu_select_async_convert(const Span<uint> raw,
+                                     const Span<uint> select_id_map,
+                                     const Span<bool> in_front_map,
+                                     const GPUSelectMode mode,
+                                     Vector<GPUSelectResult> &hit_results)
+{
+  switch (mode) {
+    case GPU_SELECT_ALL:
+      for (const int64_t i : select_id_map.index_range()) {
+        const int64_t word = i / 32;
+        if (word < raw.size() && ((raw[word] >> (i % 32)) & 1) != 0) {
+          hit_results.append({select_id_map[i], 0xFFFFu});
+        }
+      }
+      break;
+    case GPU_SELECT_PICK_ALL:
+      for (const int64_t i : select_id_map.index_range()) {
+        if (i >= raw.size() || raw[i] == 0xFFFFFFFFu) {
+          continue;
+        }
+        GPUSelectResult hit{select_id_map[i], raw[i]};
+        if (i < in_front_map.size() && in_front_map[i]) {
+          float depth;
+          std::memcpy(&depth, &hit.depth, sizeof(depth));
+          depth /= 100.0f;
+          std::memcpy(&hit.depth, &depth, sizeof(hit.depth));
+        }
+        hit_results.append(hit);
+      }
+      break;
+    case GPU_SELECT_PICK_NEAREST:
+      for (const int64_t i : select_id_map.index_range()) {
+        if (i >= raw.size() || raw[i] == 0xFFFFFFFFu) {
+          continue;
+        }
+        GPUSelectResult hit{select_id_map[i], raw[i]};
+        if (i < in_front_map.size() && in_front_map[i]) {
+          const uint32_t depth_mask = 0x00FFFFFFu << 8u;
+          const uint32_t offset_depth = ((hit.depth & depth_mask) >> 8u) / 100;
+          hit.depth = (hit.depth & ~depth_mask) | (offset_depth << 8u);
+        }
+        if (hit_results.is_empty() || hit.depth < hit_results[0].depth) {
+          hit_results.clear();
+          hit_results.append(hit);
+        }
+      }
+      break;
+    case GPU_SELECT_NEAREST_FIRST_PASS:
+    case GPU_SELECT_NEAREST_SECOND_PASS:
+    case GPU_SELECT_INVALID:
+      BLI_assert_unreachable();
+      break;
+  }
+}
