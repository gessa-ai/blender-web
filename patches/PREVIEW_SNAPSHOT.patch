diff --git a/source/blender/blenlib/tests/BLI_task_web_lifecycle.cc b/source/blender/blenlib/tests/BLI_task_web_lifecycle.cc
new file mode 100644
index 0000000000000000000000000000000000000000..13dd68c120ec7c75e0f02065712ef22f81f6132d
--- /dev/null
+++ b/source/blender/blenlib/tests/BLI_task_web_lifecycle.cc
@@ -0,0 +1,143 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <pthread.h>
+#include <thread>
+
+#include <emscripten/emscripten.h>
+
+#include "BLI_task.h"
+#include "BLI_threads.h"
+
+using namespace blender;
+
+struct LifecycleData {
+  pthread_t caller{};
+  pthread_t executed{};
+  std::atomic<int> count{0};
+  bool nested = false;
+};
+
+static int main_worker_count()
+{
+  return MAIN_THREAD_EM_ASM_INT({
+    return PThread.unusedWorkers.length + Object.keys(PThread.pthreads).length;
+  });
+}
+
+static int main_constructor_count()
+{
+  return MAIN_THREAD_EM_ASM_INT({ return globalThis.__bwWorkerConstructors; });
+}
+
+static size_t current_stack_size()
+{
+  pthread_attr_t attr;
+  size_t stack_size = 0;
+  if (pthread_getattr_np(pthread_self(), &attr) != 0 ||
+      pthread_attr_getstacksize(&attr, &stack_size) != 0)
+  {
+    return 0;
+  }
+  pthread_attr_destroy(&attr);
+  return stack_size;
+}
+
+static size_t default_stack_size()
+{
+  pthread_attr_t attr;
+  size_t stack_size = 0;
+  if (pthread_attr_init(&attr) != 0 || pthread_attr_getstacksize(&attr, &stack_size) != 0) {
+    return 0;
+  }
+  pthread_attr_destroy(&attr);
+  return stack_size;
+}
+
+static void run_task(TaskPool *, void *userdata)
+{
+  LifecycleData &data = *static_cast<LifecycleData *>(userdata);
+  data.executed = pthread_self();
+  data.count.fetch_add(1, std::memory_order_relaxed);
+  if (!BLI_task_scheduler_web_split_ready() && !data.nested) {
+    data.nested = true;
+    TaskPool *nested = BLI_task_pool_create_background_serial(&data, TASK_PRIORITY_HIGH);
+    BLI_task_pool_push(nested, run_task, &data, false, nullptr);
+    BLI_task_pool_work_and_wait(nested);
+    BLI_task_pool_cancel(nested);
+    BLI_task_pool_free(nested);
+  }
+}
+
+static bool run_pool(const bool serial, const bool expect_caller)
+{
+  LifecycleData data;
+  data.caller = pthread_self();
+  TaskPool *pool = serial ? BLI_task_pool_create_background_serial(&data, TASK_PRIORITY_HIGH) :
+                            BLI_task_pool_create_background(&data, TASK_PRIORITY_HIGH);
+  BLI_task_pool_push(pool, run_task, &data, false, nullptr);
+  if (!expect_caller) {
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (data.count.load(std::memory_order_acquire) == 0 &&
+           std::chrono::steady_clock::now() < deadline)
+    {
+      std::this_thread::yield();
+    }
+  }
+  BLI_task_pool_work_and_wait(pool);
+  BLI_task_pool_cancel(pool);
+  BLI_task_pool_free(pool);
+  const int expected_count = expect_caller ? 2 : 1;
+  return data.count.load(std::memory_order_acquire) == expected_count &&
+         (pthread_equal(data.caller, data.executed) != 0) == expect_caller;
+}
+
+int main()
+{
+  constexpr size_t proxy_main_stack_size = 32 * 1024 * 1024;
+  constexpr size_t ordinary_pthread_stack_size = 8 * 1024 * 1024;
+  BLI_threadapi_init();
+  BLI_task_scheduler_web_split_set_ready_for_testing(false);
+  const size_t observed_main_stack_size = current_stack_size();
+  const size_t observed_default_stack_size = default_stack_size();
+  bool pass = main_constructor_count() >= 1 &&
+              observed_main_stack_size == proxy_main_stack_size &&
+              observed_default_stack_size == ordinary_pthread_stack_size;
+  std::printf("BW_PTHREAD_STACK_POLICY {\"proxy_main\":%zu,\"ordinary_default\":%zu}\n",
+              observed_main_stack_size,
+              observed_default_stack_size);
+  for (const bool serial : {false, true}) {
+    const int workers_before = main_worker_count();
+    const int constructors_before = main_constructor_count();
+    pass &= run_pool(serial, true);
+    const int workers_after = main_worker_count();
+    const int constructors_after = main_constructor_count();
+    pass &= workers_before >= 1 && workers_after == workers_before &&
+            constructors_after == constructors_before;
+    std::printf("BW_PTHREAD_LIFECYCLE {\"phase\":\"bootstrap\",\"serial\":%s,"
+                "\"workers_before\":%d,\"workers_after\":%d,"
+                "\"constructors_before\":%d,\"constructors_after\":%d}\n",
+                serial ? "true" : "false", workers_before, workers_after,
+                constructors_before, constructors_after);
+  }
+  BLI_task_scheduler_web_split_set_ready_for_testing(true);
+  for (const bool serial : {false, true}) {
+    const int workers_before = main_worker_count();
+    const int constructors_before = main_constructor_count();
+    pass &= run_pool(serial, false);
+    const int workers_after = main_worker_count();
+    const int constructors_after = main_constructor_count();
+    pass &= workers_before >= 1 && workers_after >= workers_before &&
+            constructors_after >= constructors_before;
+    std::printf("BW_PTHREAD_LIFECYCLE {\"phase\":\"ready\",\"serial\":%s,"
+                "\"workers_before\":%d,\"workers_after\":%d,"
+                "\"constructors_before\":%d,\"constructors_after\":%d}\n",
+                serial ? "true" : "false", workers_before, workers_after,
+                constructors_before, constructors_after);
+  }
+  std::printf("BW_PTHREAD_LIFECYCLE_RESULT %s\n", pass ? "PASS" : "FAIL");
+  return pass ? 0 : 1;
+}
