+/* SPDX-FileCopyrightText: 2022 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_framebuffer.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WGPUFrameBuffer — the WebGPU `gpu::FrameBuffer` implementation. WebGPU has no
+ * persistent framebuffer object: attachments are bound into a transient
+ * `wgpu::RenderPassDescriptor` at pass-begin. `bind()` just records this as the
+ * context's active framebuffer; `clear*()` builds a one-shot render pass with
+ * per-attachment loadOp=Clear / storeOp=Store (no draw) — the same mechanism the
+ * draw path (wgpu_batch) will reuse to open its render pass. Depth aspect handling
+ * comes from WGPUTexture. */
+
+#pragma once
+
+#include "gpu_framebuffer_private.hh"
+
+#include "GPU_common_types.hh" /* GPULoadOp / GPUStoreOp */
+
+#include "MEM_guardedalloc.h"
+
+namespace blender::gpu {
+
+class WGPUFrameBuffer : public FrameBuffer {
+ public:
+  WGPUFrameBuffer(const char *name);
+  ~WGPUFrameBuffer() override;
+
+  void bind(bool enabled_srgb) override;
+  bool check(char err_out[256]) override;
+
+  void clear(GPUFrameBufferBits buffers,
+             const double4 clear_color,
+             float clear_depth,
+             uint clear_stencil) override;
+  void clear_multi(Span<double4> clear_cols) override;
+  void clear_attachment(GPUAttachmentType type, const double4 clear_value) override;
+
+  void attachment_set_loadstore_op(GPUAttachmentType type, GPULoadStore ls) override;
+
+  void read(GPUFrameBufferBits planes,
+            eGPUDataFormat format,
+            const int area[4],
+            int channel_len,
+            int slot,
+            void *r_data) override;
+
+  void blit_to(GPUFrameBufferBits planes,
+               int src_slot,
+               FrameBuffer *dst,
+               int dst_slot,
+               int dst_offset_x,
+               int dst_offset_y) override;
+
+ protected:
+  void subpass_transition_impl(const GPUAttachmentState depth_attachment_state,
+                               Span<GPUAttachmentState> color_attachment_states) override;
+
+ private:
+  /** Per-attachment load/store op (explicit-loadstore binds); default = clear+store. */
+  GPULoadStore load_store_[GPU_FB_MAX_ATTACHMENT];
+
+  /** Recompute width_/height_ from the first bound attachment. */
+  void update_size();
+
+  /** Build + submit a one-shot clear render pass. `colors` is either one colour
+   * (broadcast to every colour attachment) or one per colour attachment slot. */
+  void submit_clear(GPUFrameBufferBits buffers,
+                    Span<double4> colors,
+                    float clear_depth,
+                    uint clear_stencil);
+
+  MEM_CXX_CLASS_ALLOC_FUNCS("WGPUFrameBuffer")
+};
+
+}  // namespace blender::gpu
