+/** One signed viewport plus its WebGPU-valid unsigned framebuffer intersection. */
+struct ViewportScissorPlan {
+  int viewport_x = 0;
+  int viewport_y = 0;
+  uint32_t viewport_width = 0;
+  uint32_t viewport_height = 0;
+  uint32_t scissor_x = 0;
+  uint32_t scissor_y = 0;
+  uint32_t scissor_width = 0;
+  uint32_t scissor_height = 0;
+};
+
+/** Preserve Blender's signed viewport transform while intersecting the scissor with the
+ * framebuffer. WebGPU permits a negative viewport origin but its scissor is unsigned and must
+ * be contained in the render area. Fully clipped or device-invalid rectangles are rejected
+ * before a render pass is allocated. Failure leaves `result` unchanged. */
+inline bool viewport_scissor_plan(int x,
+                                  int y,
+                                  int width,
+                                  int height,
+                                  int target_width,
+                                  int target_height,
+                                  uint32_t max_viewport_dimension,
+                                  ViewportScissorPlan &result)
+{
+  if (width <= 0 || height <= 0 || target_width <= 0 || target_height <= 0 ||
+      max_viewport_dimension == 0 || uint64_t(target_width) > max_viewport_dimension ||
+      uint64_t(target_height) > max_viewport_dimension ||
+      uint64_t(width) > max_viewport_dimension || uint64_t(height) > max_viewport_dimension)
+  {
+    return false;
+  }
+
+  const int64_t left = int64_t(x);
+  const int64_t top = int64_t(y);
+  const int64_t right = left + int64_t(width);
+  const int64_t bottom = top + int64_t(height);
+  const int64_t max_viewport_bound = int64_t(max_viewport_dimension) * 2;
+  if (left < -max_viewport_bound || top < -max_viewport_bound ||
+      right > max_viewport_bound - 1 || bottom > max_viewport_bound - 1)
+  {
+    return false;
+  }
+
+  const int64_t clipped_left = left > 0 ? left : 0;
+  const int64_t clipped_top = top > 0 ? top : 0;
+  const int64_t clipped_right = right < target_width ? right : target_width;
+  const int64_t clipped_bottom = bottom < target_height ? bottom : target_height;
+  if (clipped_left >= clipped_right || clipped_top >= clipped_bottom) {
+    return false;
+  }
+
+  ViewportScissorPlan candidate;
+  candidate.viewport_x = x;
+  candidate.viewport_y = y;
+  candidate.viewport_width = uint32_t(width);
+  candidate.viewport_height = uint32_t(height);
+  candidate.scissor_x = uint32_t(clipped_left);
+  candidate.scissor_y = uint32_t(clipped_top);
+  candidate.scissor_width = uint32_t(clipped_right - clipped_left);
+  candidate.scissor_height = uint32_t(clipped_bottom - clipped_top);
+  result = candidate;
+  return true;
+}
