+bool compressed_upload_layout(TextureFormat format,
+                              uint32_t width,
+                              uint32_t height,
+                              uint32_t layers,
+                              uint32_t unpack_row_length,
+                              CompressedUploadLayout &r_layout)
+{
+  const FormatInfo &info = format_info(format);
+  if (info.conv != ConvClass::Compressed || width == 0 || height == 0 || layers == 0 ||
+      (unpack_row_length != 0 && unpack_row_length < width))
+  {
+    return false;
+  }
+
+  constexpr uint64_t block_width = 4;
+  constexpr uint64_t block_height = 4;
+  const uint64_t copy_width = (uint64_t(width) + block_width - 1) & ~(block_width - 1);
+  const uint64_t copy_height = (uint64_t(height) + block_height - 1) & ~(block_height - 1);
+  const uint64_t source_width = unpack_row_length != 0 ? unpack_row_length : width;
+  const uint64_t source_physical_width = (source_width + block_width - 1) &
+                                         ~(block_width - 1);
+  const uint64_t bytes_per_row = (source_physical_width / block_width) *
+                                 info.src_bytes_per_pixel;
+  const uint64_t rows_per_image = copy_height / block_height;
+  if (copy_width > std::numeric_limits<uint32_t>::max() ||
+      copy_height > std::numeric_limits<uint32_t>::max() ||
+      bytes_per_row > std::numeric_limits<uint32_t>::max() ||
+      rows_per_image > std::numeric_limits<uint32_t>::max() ||
+      rows_per_image > std::numeric_limits<size_t>::max() / bytes_per_row)
+  {
+    return false;
+  }
+  const size_t bytes_per_image = size_t(bytes_per_row * rows_per_image);
+  if (layers > std::numeric_limits<size_t>::max() / bytes_per_image) {
+    return false;
+  }
+
+  CompressedUploadLayout result;
+  result.copy_width = uint32_t(copy_width);
+  result.copy_height = uint32_t(copy_height);
+  result.bytes_per_row = uint32_t(bytes_per_row);
+  result.rows_per_image = uint32_t(rows_per_image);
+  result.data_size = bytes_per_image * size_t(layers);
+  r_layout = result;
+  return true;
+}
+
+bool compressed_texture_type_supported(GPUTextureType type)
+{
+  switch (type) {
+    case GPU_TEXTURE_2D:
+    case GPU_TEXTURE_2D_ARRAY:
+    case GPU_TEXTURE_CUBE:
+    case GPU_TEXTURE_CUBE_ARRAY:
+      return true;
+    case GPU_TEXTURE_1D:
+    case GPU_TEXTURE_1D_ARRAY:
+    case GPU_TEXTURE_3D:
+    case GPU_TEXTURE_ARRAY:
+    case GPU_TEXTURE_BUFFER:
+      return false;
+  }
+  return false;
+}
