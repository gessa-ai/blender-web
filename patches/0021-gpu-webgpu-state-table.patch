+/* SPDX-FileCopyrightText: 2020 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/opengl/gl_state.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * M3.T10 — WebGPU state-table mapping.
+ *
+ * The complete mechanical mapping from Blender's fixed-function state model
+ * (`GPU_state.hh`) to WebGPU pipeline-descriptor structs. Header-only-consumable:
+ * every entry point is a PURE function of a `GPUState` / `GPUStateMutable` field —
+ * no device, no context, no allocation — so `wgpu_state.cc` / `wgpu_pipeline.cc`
+ * can call them while building a (cached) render-pipeline descriptor.
+ *
+ *   - GPUBlend (16 arms)   -> wgpu::BlendState {color, alpha} (X-macro table)
+ *   - GPUDepthTest         -> depthCompare + depthWriteEnabled
+ *   - GPUStencilTest / Op  -> wgpu::StencilFaceState front/back (incl. shadow-volume
+ *                             increment/decrement-wrap counting)
+ *   - GPUFaceCullTest      -> wgpu::CullMode ; front-face winding
+ *   - GPUWriteMask         -> wgpu::ColorWriteMask (color bits only; the DEPTH /
+ *                             STENCIL write bits are applied by the depth-stencil
+ *                             state, not here)
+ *   - GPUProvokingVertex   -> NO WebGPU control (documented; emulate in-shader)
+ *
+ * SOURCE OF TRUTH (read-only recon, cited in notes/gpu-t6-t10pre-findings.md
+ * §Part-2): `opengl/gl_state.cc::set_blend` (blend factors) — verified IDENTICAL
+ * in the Vulkan (`vk_graphics_pipeline.hh:603-724`) and Metal (`mtl_state.mm:394+`)
+ * backends — plus `set_depth_test` / `set_stencil_op` / `set_backface_culling` /
+ * `set_provoking_vert` in the same file. Enum contract: `GPU_state.hh`. */
+
+#pragma once
+
+#include <cstddef>
+
+#include "webgpu/webgpu_cpp.h"
+
+#include "GPU_state.hh" /* blender::GPUBlend / GPUDepthTest / GPUStencilTest / ... */
+
+namespace blender::gpu::webgpu {
+
+/* ---- Mapping results ------------------------------------------------------- */
+
+struct BlendMapping {
+  GPUBlend blend;
+  const char *name;
+  bool enabled;     /* false for GPU_BLEND_NONE -> omit the BlendState. */
+  bool dual_source; /* true for GPU_BLEND_CUSTOM -> needs DualSourceBlending + @blend_src. */
+  wgpu::BlendComponent color;
+  wgpu::BlendComponent alpha;
+};
+
+struct DepthMapping {
+  bool test_enabled; /* false -> depthWrite off, compare Always. */
+  wgpu::CompareFunction compare;
+};
+
+struct StencilMapping {
+  bool enabled; /* false for GPU_STENCIL_NONE. */
+  wgpu::StencilFaceState front;
+  wgpu::StencilFaceState back;
+};
+
+/* ---- The mapping API (pure; GPUState field -> wgpu descriptor field) -------- */
+
+BlendMapping to_blend(GPUBlend blend);
+DepthMapping to_depth(GPUDepthTest test);
+StencilMapping to_stencil(GPUStencilTest test, GPUStencilOp op);
+wgpu::CullMode to_cull_mode(GPUFaceCullTest cull);
+wgpu::FrontFace to_front_face(bool invert); /* GL default CCW; invert -> CW. */
+wgpu::ColorWriteMask to_color_write_mask(GPUWriteMask gpu_write_mask);
+
+/** WebGPU has NO provoking-vertex control (flat interpolation samples the FIRST
+ * vertex); Blender defaults to LAST. Returns true iff the requested convention is
+ * native to WebGPU (i.e. `GPU_VERTEX_FIRST`). `GPU_VERTEX_LAST` must be emulated
+ * in-shader (Metal precedent: mtl_state.mm:384-391). No pipeline knob exists —
+ * this is a shader-codegen task, flagged for the render milestones. */
+bool provoking_vertex_is_native(GPUProvokingVertex vert);
+
+/* Whole-table iteration for reflection / tests. */
+const BlendMapping *blend_table(size_t &count);
+const char *to_string(GPUBlend b);
+
+}  // namespace blender::gpu::webgpu
