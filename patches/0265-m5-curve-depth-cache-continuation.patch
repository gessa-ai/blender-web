+static void curve_draw_depth_timer_remove(CurveDrawData *cdd)
+{
+  if (cdd->depth_cache_timer != nullptr) {
+    WM_event_timer_remove(
+        cdd->depth_cache_manager, cdd->depth_cache_window, cdd->depth_cache_timer);
+    cdd->depth_cache_timer = nullptr;
+  }
+  cdd->depth_cache_tick_count = 0;
+}
+
+static bool curve_draw_depth_context_matches(const bContext *C, const CurveDrawData *cdd)
+{
+  return CTX_wm_manager(C) == cdd->depth_cache_manager &&
+         CTX_wm_window(C) == cdd->depth_cache_window &&
+         CTX_wm_screen(C) == cdd->depth_cache_screen &&
+         CTX_wm_area(C) == cdd->depth_cache_area && CTX_wm_region(C) == cdd->vc.region &&
+         CTX_wm_region_view3d(C) == cdd->vc.rv3d && CTX_wm_view3d(C) == cdd->vc.v3d &&
+         CTX_data_scene(C) == cdd->vc.scene &&
+         CTX_data_edit_object(C) == cdd->vc.obedit;
+}
+
+static bool curve_draw_depth_event_push(CurveDrawData *cdd, const wmEvent *event)
+{
+  constexpr int max_queued_events = 256;
+  if (event == nullptr || event->type == TIMER || event->custom != 0 ||
+      event->customdata != nullptr ||
+      cdd->depth_cache_events == nullptr ||
+      cdd->depth_cache_events->size() >= max_queued_events)
+  {
+    return false;
+  }
+
+  wmEvent queued = *event;
+  queued.next = nullptr;
+  queued.prev = nullptr;
+  queued.custom = 0;
+  queued.customdata = nullptr;
+  queued.customdata_free = false;
+  cdd->depth_cache_events->append(queued);
+  return true;
+}
+
+static bool curve_draw_depth_wait_begin(bContext *C, CurveDrawData *cdd)
+{
+  cdd->depth_cache_manager = CTX_wm_manager(C);
+  cdd->depth_cache_window = CTX_wm_window(C);
+  cdd->depth_cache_screen = CTX_wm_screen(C);
+  cdd->depth_cache_area = CTX_wm_area(C);
+  if (ELEM(nullptr,
+           cdd->depth_cache_manager,
+           cdd->depth_cache_window,
+           cdd->depth_cache_screen,
+           cdd->depth_cache_area))
+  {
+    return false;
+  }
+
+  cdd->depth_cache_events = MEM_new<Vector<wmEvent>>(__func__);
+  cdd->depth_cache_timer = WM_event_timer_add(
+      cdd->depth_cache_manager, cdd->depth_cache_window, TIMER, 0.01f);
+  if (cdd->depth_cache_timer == nullptr) {
+    MEM_SAFE_DELETE(cdd->depth_cache_events);
+    return false;
+  }
+  cdd->depth_cache_pending = true;
+  cdd->depth_cache_tick_count = 0;
+  return true;
+}
