+static wmOperatorStatus paint_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  ImagePaintStroke *stroke = static_cast<ImagePaintStroke *>(op->customdata);
+  PaintOperation *pop = stroke != nullptr ? stroke->operation() : nullptr;
+
+  if (pop != nullptr && event->type == TIMER && pop->readback_timer != nullptr &&
+      event->customdata == pop->readback_timer)
+  {
+    constexpr int max_tick_count = 240;
+    if (++pop->readback_tick_count > max_tick_count) {
+      return paint_modal_readback_cancel(
+          C, op, stroke, "Timed out waiting for clone-cursor depth readback");
+    }
+
+    pop->readback_result = pop->mode->paint_stroke_readback_poll(C, pop->stroke_handle);
+    if (pop->readback_result == PaintProjStrokeResult::Pending) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+
+    image_paint_readback_timer_remove(C, pop);
+    if (pop->readback_result == PaintProjStrokeResult::Failed) {
+      return paint_modal_readback_cancel(
+          C, op, stroke, "Clone-cursor depth readback failed or its viewport changed");
+    }
+    if (pop->finish_deferred) {
+      wmEvent finish_event = pop->deferred_finish_event;
+      pop->finish_deferred = false;
+      finish_event.next = nullptr;
+      finish_event.prev = nullptr;
+      finish_event.customdata = nullptr;
+      finish_event.custom = 0;
+      finish_event.customdata_free = 0;
+      return paint_modal_dispatch(C, op, stroke, &finish_event);
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  if (pop != nullptr && pop->readback_result == PaintProjStrokeResult::Pending) {
+    if (stroke->is_finish_event(event)) {
+      if (event->customdata != nullptr) {
+        return paint_modal_readback_cancel(
+            C, op, stroke, "Cannot retain a custom-data paint finish event");
+      }
+      pop->deferred_finish_event = *event;
+      pop->finish_deferred = true;
+      if (!image_paint_readback_timer_ensure(C, pop)) {
+        return paint_modal_readback_cancel(
+            C, op, stroke, "Unable to schedule clone-cursor depth readback");
+      }
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (pop->finish_deferred) {
+      if (event->type == EVT_MODAL_MAP) {
+        return paint_modal_dispatch(C, op, stroke, event);
+      }
+      return OPERATOR_RUNNING_MODAL;
+    }
+  }
+
+  const wmOperatorStatus retval = paint_modal_dispatch(C, op, stroke, event);
+  if (retval != OPERATOR_RUNNING_MODAL) {
+    return retval;
+  }
