@@ -0,0 +1,28 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#include "draw_debug_infos.hh"
+
+COMPUTE_SHADER_CREATE_INFO(draw_debug_draw_compact)
+
+void main()
+{
+  uint line_id = gl_GlobalInvocationID.x;
+  uint vertex_count = min(drw_debug_draw_v_count(in_debug_lines_buf),
+                          uint(DRW_DEBUG_DRAW_VERT_MAX));
+  if (line_id * 2u >= vertex_count) {
+    return;
+  }
+
+  DRWDebugVertPair vert = in_debug_lines_buf[line_id + drw_debug_draw_offset];
+  if (vert.lifetime <= 1u) {
+    return;
+  }
+
+  uint vertex_id = atomicAdd(drw_debug_draw_v_count(out_debug_lines_buf), 2u);
+  if (vertex_id < uint(DRW_DEBUG_DRAW_VERT_MAX)) {
+    vert.lifetime -= 1u;
+    out_debug_lines_buf[vertex_id / 2u + drw_debug_draw_offset] = vert;
+  }
+}
