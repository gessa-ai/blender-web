+/** Host/device byte geometry for one CopyTextureToBuffer readback. */
+struct TextureReadbackLayout {
+  size_t sample_count = 0;
+  size_t device_data_size = 0;
+  size_t staging_size = 0;
+  size_t host_data_size = 0;
+  uint32_t row_bytes = 0;
+  uint32_t bytes_per_row = 0;
+  size_t row_count = 0;
+};
+
+/** Resolve every readback byte count before allocating a host or WebGPU buffer.
+ *
+ * CopyTextureToBuffer rows are padded to WebGPU's 256-byte alignment. Both the tight and
+ * padded row pitches must fit the uint32_t layout fields, every host product must fit size_t
+ * (notably wasm32), and the staging allocation must fit the live device limit. Failure is
+ * atomic. */
+inline bool texture_readback_layout(uint32_t width,
+                                    uint32_t height,
+                                    uint32_t depth,
+                                    uint32_t device_texel_bytes,
+                                    size_t host_texel_bytes,
+                                    uint64_t max_staging_size,
+                                    TextureReadbackLayout &result)
+{
+  if (width == 0 || height == 0 || depth == 0 || device_texel_bytes == 0 ||
+      host_texel_bytes == 0 || max_staging_size == 0)
+  {
+    return false;
+  }
+
+  TextureReadbackLayout candidate;
+  size_t tight_row_size;
+  size_t padded_row_size;
+  if (!checked_size_mul(size_t(width), size_t(device_texel_bytes), tight_row_size) ||
+      tight_row_size > std::numeric_limits<uint32_t>::max() ||
+      !checked_size_add(tight_row_size, size_t(255), padded_row_size))
+  {
+    return false;
+  }
+  padded_row_size &= ~size_t(255);
+  if (padded_row_size > std::numeric_limits<uint32_t>::max()) {
+    return false;
+  }
+  candidate.row_bytes = uint32_t(tight_row_size);
+  candidate.bytes_per_row = uint32_t(padded_row_size);
+
+  if (!checked_size_mul(size_t(height), size_t(depth), candidate.row_count) ||
+      !checked_size_mul(size_t(width), candidate.row_count, candidate.sample_count) ||
+      !checked_size_mul(
+          candidate.sample_count, size_t(device_texel_bytes), candidate.device_data_size) ||
+      !checked_size_mul(
+          candidate.row_count, size_t(candidate.bytes_per_row), candidate.staging_size) ||
+      !checked_size_mul(
+          candidate.sample_count, host_texel_bytes, candidate.host_data_size) ||
+      candidate.staging_size > max_staging_size)
+  {
+    return false;
+  }
+
+  result = candidate;
+  return true;
+}
