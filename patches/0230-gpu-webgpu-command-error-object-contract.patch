+         typename QueueT,
+         typename BeginPassFn,
+         typename EncodeFn,
+         typename CompleteFn>
+inline void command_pass_encode_submit_scoped(const InstanceT &instance,
+                                              const DeviceT &device,
+                                              const QueueT &queue,
+                                              OrderedQueueScheduler &scheduler,
+                                              const char *label,
+                                              BeginPassFn &&begin_pass,
+                                              EncodeFn &&encode,
+                                              CompleteFn &&complete)
+{
+  command_encode_submit_scoped(
+      instance,
+      device,
+      queue,
+      scheduler,
+      label,
+      [begin_pass = std::forward<BeginPassFn>(begin_pass),
+       encode = std::forward<EncodeFn>(encode)](auto &encoder) mutable {
+        auto pass = begin_pass(encoder);
