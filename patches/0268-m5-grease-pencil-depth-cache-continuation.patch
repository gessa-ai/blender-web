+DrawingPlacementDepthCacheState DrawingPlacement::cache_viewport_depths_async(
+    Depsgraph *depsgraph, ARegion *region, View3D *view3d)
+{
+  this->cancel_viewport_depths();
+  const eView3D_GPFlag previous_gp_flag = view3d->gp_flag;
+  eV3DDepthOverrideMode mode = V3D_DEPTH_GPENCIL_ONLY;
+
+  if (use_project_to_surface()) {
+    mode = use_project_only_selected_ ? V3D_DEPTH_SELECTED_ONLY : V3D_DEPTH_NO_GPENCIL;
+  }
+  if (use_project_to_stroke()) {
+    /* Match the synchronous path: stroke depth must be produced in 3D order. */
+    view3d->gp_flag |= V3D_GP_FORCE_STROKE_ORDER_3D;
+  }
+
+  ED_view3d_depth_override_prepare(depsgraph, region, view3d, nullptr, mode, false);
+  view3d->gp_flag = previous_gp_flag;
+
+  depth_cache_session_ = MEM_new<ViewportDepthCacheSession>(__func__);
+  if (!depth_cache_session_->init(region)) {
+    MEM_SAFE_DELETE(depth_cache_session_);
+    return DrawingPlacementDepthCacheState::Failed;
+  }
+  return this->poll_viewport_depths(region);
+}
+
+DrawingPlacementDepthCacheState DrawingPlacement::poll_viewport_depths(ARegion *region)
+{
+  if (depth_cache_session_ == nullptr) {
+    return depth_cache_ != nullptr ? DrawingPlacementDepthCacheState::Ready :
+                                     DrawingPlacementDepthCacheState::Failed;
+  }
+
+  const ViewportDepthCacheSession::ReadbackState state = depth_cache_session_->state();
+  if (state == ViewportDepthCacheSession::ReadbackState::Pending) {
+    return DrawingPlacementDepthCacheState::Pending;
+  }
+  if (state == ViewportDepthCacheSession::ReadbackState::Failed) {
+    MEM_SAFE_DELETE(depth_cache_session_);
+    return DrawingPlacementDepthCacheState::Failed;
+  }
+
+  ViewDepths *depths = depth_cache_session_->take(region);
+  MEM_SAFE_DELETE(depth_cache_session_);
+  if (depths == nullptr) {
+    return DrawingPlacementDepthCacheState::Failed;
+  }
+  if (depth_cache_ != nullptr) {
+    ED_view3d_depths_free(depth_cache_);
+  }
+  depth_cache_ = depths;
+  return DrawingPlacementDepthCacheState::Ready;
+}
+
+void DrawingPlacement::cancel_viewport_depths()
+{
+  MEM_SAFE_DELETE(depth_cache_session_);
+}
