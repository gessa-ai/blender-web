+static wmOperatorStatus select_linked_pick_exec(bContext *C, wmOperator *op)
+{
+  ParticleLinkedPickData *wait = MEM_new<ParticleLinkedPickData>(__func__);
+  wait->depth_session = PE_depth_cache_session_create();
+  wait->manager = CTX_wm_manager(C);
+  wait->window = CTX_wm_window(C);
+  RNA_int_get_array(op->ptr, "location", wait->location);
+  wait->deselect = RNA_boolean_get(op->ptr, "deselect");
+
+  const wmOperatorStatus result = select_linked_pick_apply(C, op, wait);
+  if (result == OPERATOR_RUNNING_MODAL) {
+    wait->timer = WM_event_timer_add(wait->manager, wait->window, TIMER, 0.01f);
+    if (wait->timer == nullptr) {
+      BKE_report(op->reports, RPT_ERROR, "Unable to retain particle linked-select depth request");
+      select_linked_pick_data_free(wait);
+      return OPERATOR_CANCELLED;
+    }
+    op->customdata = wait;
+    WM_event_add_modal_handler(C, op);
+    return OPERATOR_RUNNING_MODAL;
+  }
+  select_linked_pick_data_free(wait);
+  return result;
+}
+
+static wmOperatorStatus select_linked_pick_modal(bContext *C,
+                                                 wmOperator *op,
+                                                 const wmEvent *event)
+{
+  ParticleLinkedPickData *wait = static_cast<ParticleLinkedPickData *>(op->customdata);
+  if (wait == nullptr || (event->type == EVT_ESCKEY && event->val == KM_PRESS)) {
+    select_linked_pick_cancel(op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type != TIMER || event->customdata != wait->timer) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++wait->tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for particle linked-select depth");
+    select_linked_pick_cancel(op);
+    return OPERATOR_CANCELLED;
+  }
+  const ParticleEditDepthCacheState state = PE_depth_cache_session_state(C,
+                                                                         wait->depth_session);
+  if (state == ParticleEditDepthCacheState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == ParticleEditDepthCacheState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Particle linked-select depth context changed");
+    select_linked_pick_cancel(op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const wmOperatorStatus result = select_linked_pick_apply(C, op, wait);
+  select_linked_pick_cancel(op);
+  return result;
+}
