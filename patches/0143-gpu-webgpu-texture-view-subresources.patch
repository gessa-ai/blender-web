+  GPU_framebuffer_ensure_config(
+      &srgb_fb, {GPU_ATTACHMENT_NONE, GPU_ATTACHMENT_TEXTURE(srgb)});
+  GPU_framebuffer_clear_color(srgb_fb, double4(color));
+  uchar4 *srgb_attachment_bytes = static_cast<uchar4 *>(
+      GPU_texture_read(base, GPU_DATA_UBYTE, 0));
+  ASSERT_NE(srgb_attachment_bytes, nullptr);
+  EXPECT_NEAR((*srgb_attachment_bytes)[0], 137, 2);
+  EXPECT_NEAR((*srgb_attachment_bytes)[1], 188, 2);
+  EXPECT_NEAR((*srgb_attachment_bytes)[2], 225, 2);
+  MEM_delete(srgb_attachment_bytes);
+  GPU_framebuffer_free(srgb_fb);
+
+  gpu::Texture *srgb_base = GPU_texture_create_2d(
+      __func__, 2, 2, 1, TextureFormat::SRGBA_8_8_8_8, usage, nullptr);
+  ASSERT_NE(srgb_base, nullptr);
+  gpu::Texture *linear = GPU_texture_create_view(
+      __func__, srgb_base, TextureFormat::UNORM_8_8_8_8, 0, 1, 0, 1, false, false);
+  ASSERT_NE(linear, nullptr);
+  GPU_texture_clear(srgb_base, GPU_DATA_FLOAT, color);
+  uchar4 *root_srgb_bytes = static_cast<uchar4 *>(
+      GPU_texture_read(linear, GPU_DATA_UBYTE, 0));
+  ASSERT_NE(root_srgb_bytes, nullptr);
+  EXPECT_NEAR((*root_srgb_bytes)[0], 137, 2);
+  EXPECT_NEAR((*root_srgb_bytes)[1], 188, 2);
+  EXPECT_NEAR((*root_srgb_bytes)[2], 225, 2);
+  MEM_delete(root_srgb_bytes);
+
+  GPU_texture_clear(linear, GPU_DATA_FLOAT, color);
+  uchar4 *linear_view_bytes = static_cast<uchar4 *>(
+      GPU_texture_read(srgb_base, GPU_DATA_UBYTE, 0));
+  ASSERT_NE(linear_view_bytes, nullptr);
+  EXPECT_NEAR((*linear_view_bytes)[0], 137, 2);
+  EXPECT_NEAR((*linear_view_bytes)[1], 188, 2);
+  EXPECT_NEAR((*linear_view_bytes)[2], 225, 2);
+  MEM_delete(linear_view_bytes);
+
+  gpu::Texture *srgb_no_attachment = GPU_texture_create_2d(__func__,
+                                                            2,
+                                                            2,
+                                                            1,
+                                                            TextureFormat::SRGBA_8_8_8_8,
+                                                            GPU_TEXTURE_USAGE_HOST_READ,
+                                                            nullptr);
+  ASSERT_NE(srgb_no_attachment, nullptr);
+  GPU_texture_clear(srgb_no_attachment, GPU_DATA_FLOAT, color);
+  uchar4 *no_attachment_bytes = static_cast<uchar4 *>(
