+
+  # Keep the normal test build aggregated, but also provide one unmistakable
+  # parity executable containing only tests/bmesh_core_test.cc. Reuse Blender's
+  # canonical per-source helper without changing the policy for any other suite.
+  if(WITH_TESTS_BMESH_CORE_PARITY)
+    set(_with_tests_single_binary "${WITH_TESTS_SINGLE_BINARY}")
+    set(WITH_TESTS_SINGLE_BINARY OFF)
+    blender_add_test_suite_executable(
+      bmesh "${TEST_SRC}" "${INC};${TEST_INC}" "${INC_SYS}" "${LIB};${TEST_LIB}"
+    )
+    if(EMSCRIPTEN)
+      # The bmesh dependency closure pulls in libpython3.13.a, whose obmalloc.o
+      # vendors the public mimalloc API. The platform's normal gtest allocator
+      # setting would also link Emscripten's libmimalloc-mt.a. Emscripten settings
+      # are last-one-wins, so keep the platform profile intact and override only
+      # this Python-linked parity executable to the same non-conflicting C-heap
+      # allocator used by the main Blender target.
+      target_link_options(
+        bmesh_core_test
+        PRIVATE
+          "-sMALLOC=dlmalloc"
+          # This dedicated executable links the full bmesh dependency closure.
+          # Its static image needs 20,445,328 bytes with the pinned toolchain,
+          # which exceeds Emscripten's 16 MiB default. Keep the override local:
+          # 32 MiB leaves deterministic link/startup headroom, while the existing
+          # ALLOW_MEMORY_GROWTH policy covers later test allocations.
+          "-sINITIAL_MEMORY=33554432"
+      )
+    endif()
+    set(WITH_TESTS_SINGLE_BINARY "${_with_tests_single_binary}")
+    unset(_with_tests_single_binary)
+  endif()
 endif()
