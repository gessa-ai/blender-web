diff --git a/source/blender/gpu/webgpu/wgpu_common.hh b/source/blender/gpu/webgpu/wgpu_common.hh
--- a/source/blender/gpu/webgpu/wgpu_common.hh
+++ b/source/blender/gpu/webgpu/wgpu_common.hh
@@ -19,6 +19,7 @@
 
 #include <cstddef>
 #include <cstdint>
+#include <limits>
 
 #include "webgpu/webgpu_cpp.h"
 
@@ -60,4 +61,24 @@ inline size_t align_up(size_t v, size_t a)
   return (v + (a - 1)) & ~(a - 1);
 }
 
+/** Round up without wrapping. Invalid alignments and unrepresentable results fail
+ * without changing `result`. */
+inline bool checked_align_up(size_t v, size_t a, size_t &result)
+{
+  if (a == 0 || (a & (a - 1)) != 0 ||
+      v > std::numeric_limits<size_t>::max() - (a - 1))
+  {
+    return false;
+  }
+  result = (v + (a - 1)) & ~(a - 1);
+  return true;
+}
+
+/** True when the half-open byte range [offset, offset + size) is contained in
+ * an allocation of `capacity` bytes. The subtraction form cannot overflow. */
+inline bool range_fits(size_t offset, size_t size, size_t capacity)
+{
+  return offset <= capacity && size <= capacity - offset;
+}
+
 }  // namespace blender::gpu::webgpu
diff --git a/source/blender/gpu/webgpu/wgpu_buffer.cc b/source/blender/gpu/webgpu/wgpu_buffer.cc
