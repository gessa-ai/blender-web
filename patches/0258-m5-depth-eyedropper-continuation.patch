-static void depthdropper_depth_sample_accum(bContext *C, DepthDropper *ddr, const int m_xy[2])
-{
+  float co[3];
   float depth = -1.0f;
-  depthdropper_depth_sample_pt(C, ddr, m_xy, &depth);
-  if (depth != -1.0f) {
+  const bool has_depth = ddr->readback_session.sample(ddr->readback_region, co);
+  if (!has_depth &&
+      ddr->readback_session.state() == ViewportDepthPickSession::ReadbackState::Failed)
+  {
+    BKE_report(op->reports, RPT_ERROR, "Viewport changed while resolving depth sample");
+    depthdropper_exit(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  if (has_depth) {
+    const float mval_center_fl[2] = {float(ddr->readback_region->winx) / 2.0f,
+                                     float(ddr->readback_region->winy) / 2.0f};
+    float co_align[3];
+    copy_v2_v2_int(ddr->name_pos, ddr->readback_mval);
+    ED_view3d_win_to_3d(ddr->readback_view3d,
+                        ddr->readback_region,
+                        co,
+                        mval_center_fl,
+                        co_align);
+    depth = len_v3v3(ddr->readback_view_origin, co_align);
+    BKE_unit_value_as_string(ddr->name,
+                             sizeof(ddr->name),
+                             double(depth),
+                             -4,
+                             B_UNIT_LENGTH,
+                             ddr->readback_scene->unit,
+                             false,
+                             true);
+  }
+  else {
+    STRNCPY_UTF8(ddr->name, RPT_("Nothing under cursor"));
+  }
+
+  const DepthDropperReadbackAction action = ddr->readback_action;
+  ddr->readback_action = DepthDropperReadbackAction::None;
+  if (action == DepthDropperReadbackAction::Accumulate && depth != -1.0f) {
     ddr->accum_depth += depth;
     ddr->accum_tot++;
   }
+  else if (action == DepthDropperReadbackAction::AccumulateAndSet) {
+    if (depth != -1.0f) {
+      ddr->accum_depth += depth;
+      ddr->accum_tot++;
+    }
+    depthdropper_depth_set_accum(C, ddr);
+  }
+
+  if (ddr->readback_timer != nullptr) {
+    WM_event_timer_remove(
+        CTX_wm_manager(C), ddr->readback_window, ddr->readback_timer);
+    ddr->readback_timer = nullptr;
+  }
+
+  if (ddr->readback_confirm_after) {
+    const bool is_undo = ddr->is_undo;
+    if (ddr->accum_tot != 0) {
+      depthdropper_depth_set_accum(C, ddr);
+    }
+    depthdropper_exit(C, op);
+    return is_undo ? OPERATOR_FINISHED : OPERATOR_CANCELLED;
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static wmOperatorStatus depthdropper_readback_request(bContext *C,
+                                                      wmOperator *op,
+                                                      const int m_xy[2],
+                                                      const DepthDropperReadbackAction action)
+{
+  DepthDropper *ddr = static_cast<DepthDropper *>(op->customdata);
+  bScreen *screen = CTX_wm_screen(C);
+  ScrArea *area = BKE_screen_find_area_xy(screen, SPACE_TYPE_ANY, m_xy);
+  ARegion *region = area != nullptr && area->spacetype == SPACE_VIEW3D ?
+                        BKE_area_find_region_xy(area, RGN_TYPE_WINDOW, m_xy) :
+                        nullptr;
+  if (region == nullptr || region->regiondata == nullptr) {
+    ddr->name[0] = '\0';
+    if (action == DepthDropperReadbackAction::AccumulateAndSet) {
+      depthdropper_depth_set_accum(C, ddr);
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  View3D *v3d = static_cast<View3D *>(area->spacedata.first);
+  RegionView3D *rv3d = static_cast<RegionView3D *>(region->regiondata);
+  Scene *scene = CTX_data_scene(C);
+  const int mval[2] = {m_xy[0] - region->winrct.xmin, m_xy[1] - region->winrct.ymin};
+  float view_origin[3];
+  if (v3d->camera != nullptr && rv3d->persp == RV3D_CAMOB) {
+    copy_v3_v3(view_origin, v3d->camera->object_to_world().location());
+  }
+  else {
+    copy_v3_v3(view_origin, rv3d->viewinv[3]);
+  }
+
+  ScrArea *area_prev = CTX_wm_area(C);
+  ARegion *region_prev = CTX_wm_region(C);
+  CTX_wm_area_set(C, area);
+  CTX_wm_region_set(C, region);
+
+  ED_region_tag_redraw(region);
+  view3d_operator_needs_gpu(C);
+  ED_view3d_depth_override(CTX_data_depsgraph_pointer(C),
+                           region,
+                           v3d,
+                           nullptr,
+                           V3D_DEPTH_NO_GPENCIL,
+                           false,
+                           nullptr);
+  const bool request_started = ddr->readback_session.init(region, mval);
+
+  CTX_wm_area_set(C, area_prev);
+  CTX_wm_region_set(C, region_prev);
+
+  ddr->readback_window = CTX_wm_window(C);
+  ddr->readback_screen = screen;
+  ddr->readback_scene = scene;
+  ddr->readback_area = area;
+  ddr->readback_region = region;
+  ddr->readback_view3d = v3d;
+  ddr->readback_region_view = rv3d;
+  copy_v2_v2_int(ddr->readback_event_xy, m_xy);
+  copy_v2_v2_int(ddr->readback_mval, mval);
+  copy_v3_v3(ddr->readback_view_origin, view_origin);
+  ddr->readback_tick_count = 0;
+  ddr->readback_action = action;
+  ddr->readback_confirm_after = false;
+
+  if (!request_started) {
+    BKE_report(op->reports, RPT_ERROR, "Unable to start viewport depth readback");
+    depthdropper_exit(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const ViewportDepthPickSession::ReadbackState state = ddr->readback_session.state();
+  if (state == ViewportDepthPickSession::ReadbackState::Ready) {
+    return depthdropper_readback_apply(C, op);
+  }
+  if (state == ViewportDepthPickSession::ReadbackState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Viewport depth readback failed");
+    depthdropper_exit(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (ddr->readback_timer == nullptr) {
+    ddr->readback_timer = WM_event_timer_add(
+        CTX_wm_manager(C), ddr->readback_window, TIMER, 0.01f);
+  }
+  return OPERATOR_RUNNING_MODAL;
 }
 
