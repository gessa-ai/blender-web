+bool Film::read_passes_async_begin(RenderLayer &render_layer, const char *view_name)
+{
+  if (readback_batch_) {
+    return false;
+  }
+
+  std::unique_ptr<ReadbackBatch> batch = std::make_unique<ReadbackBatch>();
+  batch->view_name = view_name ? view_name : "";
+  bool combined_kicked = false;
+
+  /* One barrier covers all exact layer snapshots submitted by this batch. */
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+
+  auto set_setup_error = [&](const eGPUReadbackError error) {
+    if (batch->setup_error == GPU_READBACK_ERROR_NONE) {
+      batch->setup_error = error;
+    }
+  };
+
+  auto kick = [&](const eViewLayerEEVEEPassType pass_type,
+                  const int layer_offset,
+                  const char *pass_name,
+                  gpu::Texture *pass_tx,
+                  const bool compact_float3) {
+    RenderPass *target = RE_pass_find_by_name(
+        &render_layer, pass_name, batch->view_name.c_str());
+    if (target == nullptr) {
+      return;
+    }
+
+    ReadbackBatch::Entry entry;
+    entry.pass_type = pass_type;
+    entry.layer_offset = layer_offset;
+    entry.pass_name = pass_name;
+    entry.channels = target->channels;
+    entry.compact_float3 = compact_float3;
+
+    if (pass_tx != nullptr) {
+      entry.width = GPU_texture_width(pass_tx);
+      entry.height = GPU_texture_height(pass_tx);
+      if (entry.width <= 0 || entry.height <= 0 ||
+          entry.width > std::numeric_limits<int>::max() / entry.height)
+      {
+        set_setup_error(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+      }
+      else {
+        entry.pixel_count = entry.width * entry.height;
+        entry.readback = GPU_texture_read_async(pass_tx, GPU_DATA_FLOAT, 0);
+        if (entry.readback == nullptr) {
+          set_setup_error(GPU_READBACK_ERROR_BACKEND_FAILURE);
+        }
+        else if (pass_type == EEVEE_RENDER_PASS_COMBINED) {
+          combined_kicked = true;
+        }
+      }
+    }
+    else {
+      set_setup_error(GPU_READBACK_ERROR_SOURCE_UNAVAILABLE);
+    }
+    batch->entries.append(std::move(entry));
+  };
+
+  const eViewLayerEEVEEPassType enabled_passes = enabled_passes_get();
+  for (const int i : IndexRange(EEVEE_RENDER_PASS_MAX_BIT + 1)) {
+    const eViewLayerEEVEEPassType pass_type = eViewLayerEEVEEPassType(enabled_passes & (1 << i));
+    if (pass_type == 0) {
+      continue;
+    }
+
+    const Vector<std::string> pass_names = pass_to_render_pass_names(pass_type, inst_.view_layer);
+    for (const int64_t layer_offset : pass_names.index_range()) {
+      kick(pass_type,
+           int(layer_offset),
+           pass_names[layer_offset].c_str(),
+           get_pass_texture(pass_type, int(layer_offset)),
+           pass_is_float3(pass_type));
+    }
+  }
+
+  /* AOV render passes are already exact layer views but do not use the float3 compaction applied
+   * to standard color passes. */
+  for (ViewLayerAOV &aov : inst_.view_layer->aovs) {
+    if ((aov.flag & AOV_CONFLICT) != 0) {
+      continue;
+    }
+    kick(eViewLayerEEVEEPassType(0), -1, aov.name, get_aov_texture(&aov), false);
+  }
+
+  /* Combined is always registered and enabled for final renders. Treat a missing target or view
+   * as a terminal setup failure instead of publishing an empty Ready batch. */
+  if (!combined_kicked) {
+    set_setup_error(GPU_READBACK_ERROR_SOURCE_UNAVAILABLE);
+  }
+
+  readback_batch_ = std::move(batch);
+  return true;
+}
+
+eGPUReadbackStatus Film::read_passes_async_status()
+{
+  if (!readback_batch_) {
+    return GPU_READBACK_INVALID;
+  }
+  if (readback_batch_->setup_error != GPU_READBACK_ERROR_NONE) {
+    return GPU_READBACK_FAILED;
+  }
+
+  bool has_pending = false;
+  for (ReadbackBatch::Entry &entry : readback_batch_->entries) {
+    const eGPUReadbackStatus status = GPU_readback_status(entry.readback);
+    if (status == GPU_READBACK_FAILED || status == GPU_READBACK_INVALID) {
+      return GPU_READBACK_FAILED;
+    }
+    has_pending |= status == GPU_READBACK_PENDING;
+  }
+  return has_pending ? GPU_READBACK_PENDING : GPU_READBACK_READY;
+}
+
+eGPUReadbackError Film::read_passes_async_error()
+{
+  if (!readback_batch_) {
+    return GPU_READBACK_ERROR_INVALID_ARGUMENT;
+  }
+  if (readback_batch_->setup_error != GPU_READBACK_ERROR_NONE) {
+    return readback_batch_->setup_error;
+  }
+  for (ReadbackBatch::Entry &entry : readback_batch_->entries) {
+    const eGPUReadbackStatus status = GPU_readback_status(entry.readback);
+    if (status == GPU_READBACK_FAILED) {
+      return GPU_readback_error(entry.readback);
+    }
+    if (status == GPU_READBACK_INVALID) {
+      return GPU_READBACK_ERROR_BACKEND_FAILURE;
+    }
+  }
+  return GPU_READBACK_ERROR_NONE;
+}
+
+bool Film::read_passes_async_consume(RenderLayer &render_layer)
+{
+  if (read_passes_async_status() != GPU_READBACK_READY) {
+    return false;
+  }
+
+  auto fail = [&](const eGPUReadbackError error) {
+    readback_batch_->setup_error = error;
+    return false;
+  };
+
+  /* Resolve and validate every destination before consuming any one-shot result. */
+  Vector<RenderPass *> targets;
+  Vector<size_t> byte_sizes;
+  targets.reserve(readback_batch_->entries.size());
+  byte_sizes.reserve(readback_batch_->entries.size());
+  for (ReadbackBatch::Entry &entry : readback_batch_->entries) {
+    RenderPass *target = RE_pass_find_by_name(
+        &render_layer, entry.pass_name.c_str(), readback_batch_->view_name.c_str());
+    if (target == nullptr) {
+      return fail(GPU_READBACK_ERROR_SOURCE_UNAVAILABLE);
+    }
+    if (target->rectx != entry.width || target->recty != entry.height ||
+        target->channels != entry.channels)
+    {
+      return fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    }
+
+    const size_t byte_size = GPU_readback_size(entry.readback);
+    if (byte_size == 0 || byte_size % sizeof(float) != 0 || entry.pixel_count <= 0) {
+      return fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    }
+    const size_t float_count = byte_size / sizeof(float);
+    if (float_count % size_t(entry.pixel_count) != 0) {
+      return fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    }
+    const size_t source_channels = float_count / size_t(entry.pixel_count);
+    if ((entry.compact_float3 && (source_channels != 4 || entry.channels != 3)) ||
+        (!entry.compact_float3 && source_channels != size_t(entry.channels)))
+    {
+      return fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    }
+    targets.append(target);
+    byte_sizes.append(byte_size);
+  }
+
+  /* Allocate every destination before consuming any one-shot handle. */
+  Vector<float *> results;
+  results.reserve(byte_sizes.size());
+  for (const size_t byte_size : byte_sizes) {
+    float *result = static_cast<float *>(MEM_new_uninitialized(byte_size, __func__));
+    if (result == nullptr) {
+      for (float *allocated : results) {
+        MEM_delete_void(static_cast<void *>(allocated));
+      }
+      return fail(GPU_READBACK_ERROR_ALLOCATION_FAILED);
+    }
+    results.append(result);
+  }
+
+  for (const int64_t i : readback_batch_->entries.index_range()) {
+    ReadbackBatch::Entry &entry = readback_batch_->entries[i];
+    if (!GPU_readback_consume(entry.readback, results[i], byte_sizes[i])) {
+      for (float *allocated : results) {
+        MEM_delete_void(static_cast<void *>(allocated));
+      }
+      return fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    }
+    if (entry.compact_float3) {
+      compact_float4_to_float3(results[i], entry.pixel_count);
+    }
+  }
+
+  for (const int64_t i : results.index_range()) {
+    RE_pass_set_buffer_data(targets[i], results[i]);
+  }
+
+  readback_batch_.reset();
+  return true;
+}
+
+void Film::read_passes_async_cancel()
+{
+  readback_batch_.reset();
+}
