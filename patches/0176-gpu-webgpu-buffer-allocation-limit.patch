@@ -74,6 +74,25 @@ inline bool checked_align_up(size_t v, size_t a, size_t &result)
   return true;
 }
-
+
+/** Resolve the aligned WebGPU allocation size without exceeding the device limit.
+ * A zero-byte Blender buffer keeps the existing four-byte sentinel allocation.
+ * Failure leaves `result` unchanged. */
+inline bool buffer_allocation_size(size_t requested_size,
+                                   uint64_t max_buffer_size,
+                                   size_t &result)
+{
+  size_t candidate;
+  if (!checked_align_up(requested_size == 0 ? kCopyAlignment : requested_size,
+                        kCopyAlignment,
+                        candidate) ||
+      uint64_t(candidate) > max_buffer_size)
+  {
+    return false;
+  }
+  result = candidate;
+  return true;
+}
+
 /** True when the half-open byte range [offset, offset + size) is contained in
  * an allocation of `capacity` bytes. The subtraction form cannot overflow. */
 inline bool range_fits(size_t offset, size_t size, size_t capacity)
