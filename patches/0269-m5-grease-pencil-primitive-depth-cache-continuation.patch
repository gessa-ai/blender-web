+static void grease_pencil_primitive_depth_cache_timer_remove(PrimitiveToolOperation &ptd)
+{
+  if (ptd.depth_cache_timer != nullptr) {
+    WM_event_timer_remove(
+        ptd.depth_cache_manager, ptd.depth_cache_window, ptd.depth_cache_timer);
+    ptd.depth_cache_timer = nullptr;
+  }
+  ptd.depth_cache_tick_count = 0;
+}
+
+static bool grease_pencil_primitive_depth_cache_wait_begin(bContext *C,
+                                                           PrimitiveToolOperation &ptd)
+{
+  ptd.depth_cache_manager = CTX_wm_manager(C);
+  ptd.depth_cache_window = CTX_wm_window(C);
+  ptd.depth_cache_screen = CTX_wm_screen(C);
+  ptd.depth_cache_area = CTX_wm_area(C);
+  ptd.depth_cache_region_view = CTX_wm_region_view3d(C);
+  ptd.depth_cache_view3d = CTX_wm_view3d(C);
+  ptd.depth_cache_depsgraph = CTX_data_depsgraph_pointer(C);
+  ptd.depth_cache_scene = CTX_data_scene(C);
+  ptd.depth_cache_view_layer = CTX_data_view_layer(C);
+  ptd.depth_cache_object = CTX_data_active_object(C);
+  if (ELEM(nullptr,
+           ptd.depth_cache_manager,
+           ptd.depth_cache_window,
+           ptd.depth_cache_screen,
+           ptd.depth_cache_area,
+           ptd.region,
+           ptd.depth_cache_region_view,
+           ptd.depth_cache_view3d,
+           ptd.depth_cache_depsgraph,
+           ptd.depth_cache_scene,
+           ptd.depth_cache_view_layer,
+           ptd.depth_cache_object) ||
+      ptd.depth_cache_object->type != OB_GREASE_PENCIL)
+  {
+    return false;
+  }
+
+  ptd.depth_cache_grease_pencil = id_cast<GreasePencil *>(ptd.depth_cache_object->data);
+  if (ptd.depth_cache_grease_pencil == nullptr ||
+      !ptd.depth_cache_grease_pencil->has_active_layer())
+  {
+    return false;
+  }
+  ptd.depth_cache_layer = ptd.depth_cache_grease_pencil->get_active_layer();
+  ptd.depth_cache_frame = ptd.depth_cache_scene->r.cfra;
+  ptd.depth_cache_drawing = ptd.depth_cache_grease_pencil->get_editable_drawing_at(
+      *ptd.depth_cache_layer, ptd.depth_cache_frame);
+  ptd.depth_cache_paint = BKE_paint_get_active_from_context(C);
+  ptd.depth_cache_brush = ptd.depth_cache_paint != nullptr ?
+                              BKE_paint_brush(ptd.depth_cache_paint) :
+                              nullptr;
+  if (ELEM(nullptr,
+           ptd.depth_cache_drawing,
+           ptd.depth_cache_paint,
+           ptd.depth_cache_brush))
+  {
+    return false;
+  }
+
+  ptd.depth_cache_events.clear();
+  ptd.depth_cache_timer = WM_event_timer_add(
+      ptd.depth_cache_manager, ptd.depth_cache_window, TIMER, 0.01f);
+  if (ptd.depth_cache_timer == nullptr) {
+    return false;
+  }
+  ptd.depth_cache_tick_count = 0;
+  ptd.depth_cache_pending = true;
+  return true;
+}
