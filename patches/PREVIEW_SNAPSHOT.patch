--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_data_conversion.cc
@@ -0,0 +1,286 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_data_conversion.cc @ fbe6228777e7 */
+
+/** \file
+ * Implements the RGB→RGBA promotion for the 13 three-channel Blender formats.
+ * See wgpu_data_conversion.hh. */
+
+#include "wgpu_data_conversion.hh"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+
+namespace blender::gpu::webgpu {
+
+PromotionPlan promotion_plan(TextureFormat format)
+{
+  /* Only the ConvClass::PromoteRGBA formats need widening; {comp_bytes, type}
+   * per the format's element type. */
+  switch (format) {
+    case TextureFormat::UNORM_8_8_8:   return {true, 1, ScalarType::Unorm};
+    case TextureFormat::UNORM_16_16_16:return {true, 2, ScalarType::Unorm};
+    case TextureFormat::SNORM_8_8_8:   return {true, 1, ScalarType::Snorm};
+    case TextureFormat::SNORM_16_16_16:return {true, 2, ScalarType::Snorm};
+    case TextureFormat::UINT_8_8_8:    return {true, 1, ScalarType::Uint};
+    case TextureFormat::UINT_16_16_16: return {true, 2, ScalarType::Uint};
+    case TextureFormat::UINT_32_32_32: return {true, 4, ScalarType::Uint};
+    case TextureFormat::SINT_8_8_8:    return {true, 1, ScalarType::Sint};
+    case TextureFormat::SINT_16_16_16: return {true, 2, ScalarType::Sint};
+    case TextureFormat::SINT_32_32_32: return {true, 4, ScalarType::Sint};
+    case TextureFormat::SFLOAT_16_16_16: return {true, 2, ScalarType::Float};
+    case TextureFormat::SFLOAT_32_32_32: return {true, 4, ScalarType::Float};
+    case TextureFormat::SRGBA_8_8_8:   return {true, 1, ScalarType::Unorm};
+    default:                           return {false, 0, ScalarType::Unorm};
+  }
+}
+
+void opaque_alpha_bytes(ScalarType type, uint32_t comp_bytes, uint8_t *out)
+{
+  std::memset(out, 0, comp_bytes);
+  switch (type) {
+    case ScalarType::Unorm:
+      /* max value: 0xFF / 0xFFFF / 0xFFFFFFFF */
+      std::memset(out, 0xFF, comp_bytes);
+      break;
+    case ScalarType::Snorm:
+      /* max positive: 0x7F / 0x7FFF (little-endian: high byte holds 0x7F) */
+      std::memset(out, 0xFF, comp_bytes);
+      out[comp_bytes - 1] = 0x7F;
+      break;
+    case ScalarType::Uint:
+    case ScalarType::Sint:
+      out[0] = 0x01; /* integer 1, little-endian */
+      break;
+    case ScalarType::Float:
+      if (comp_bytes == 2) {           /* half 1.0 = 0x3C00 */
+        out[0] = 0x00; out[1] = 0x3C;
+      }
+      else if (comp_bytes == 4) {      /* float 1.0 = 0x3F800000 */
+        out[0] = 0x00; out[1] = 0x00; out[2] = 0x80; out[3] = 0x3F;
+      }
+      break;
+  }
+}
+
+uint8_t srgb_clear_component_to_unorm8(float linear)
+{
+  if (!std::isfinite(linear)) {
+    return 0;
+  }
+  linear = std::clamp(linear, 0.0f, 1.0f);
+  const float encoded = linear < 0.0031308f ? linear * 12.92f :
+                                                   1.055f * std::pow(linear, 1.0f / 2.4f) - 0.055f;
+  return uint8_t(std::lround(std::clamp(encoded, 0.0f, 1.0f) * 255.0f));
+}
+
+size_t promoted_byte_size(uint32_t width, uint32_t height, uint32_t comp_bytes)
+{
+  return size_t(width) * height * 4u * comp_bytes;
+}
+
+bool promote_rgb_to_rgba(const uint8_t *src, size_t src_size,
+                         uint8_t *dst, size_t dst_size,
+                         uint32_t width, uint32_t height,
+                         const PromotionPlan &plan)
+{
+  if (!plan.needed || plan.comp_bytes == 0) {
+    return false;
+  }
+  const uint32_t cb = plan.comp_bytes;
+  const size_t need_src = size_t(width) * height * 3u * cb;
+  const size_t need_dst = promoted_byte_size(width, height, cb);
+  if (src_size < need_src || dst_size < need_dst) {
+    return false;
+  }
+  uint8_t alpha[4];
+  opaque_alpha_bytes(plan.type, cb, alpha);
+
+  const size_t pixels = size_t(width) * height;
+  for (size_t p = 0; p < pixels; p++) {
+    const uint8_t *s = src + p * 3u * cb;
+    uint8_t *d = dst + p * 4u * cb;
+    std::memcpy(d, s, 3u * cb);       /* R,G,B verbatim */
+    std::memcpy(d + 3u * cb, alpha, cb); /* opaque A */
+  }
+  return true;
+}
+
+std::vector<uint8_t> promote_for_upload(TextureFormat format,
+                                        const std::vector<uint8_t> &rgb_src,
+                                        uint32_t width, uint32_t height)
+{
+  const PromotionPlan plan = promotion_plan(format);
+  if (!plan.needed) {
+    return rgb_src; /* Direct formats upload verbatim */
+  }
+  std::vector<uint8_t> out(promoted_byte_size(width, height, plan.comp_bytes));
+  promote_rgb_to_rgba(rgb_src.data(), rgb_src.size(), out.data(), out.size(), width, height, plan);
+  return out;
+}
+
+uint32_t pack_rgb9e5_ufloat(float red, float green, float blue)
+{
+  constexpr int mantissa_bits = 9;
+  constexpr int exponent_bias = 15;
+  constexpr int exponent_max = 31;
+  constexpr uint32_t mantissa_mask = (1u << mantissa_bits) - 1u;
+  constexpr float shared_max = float(mantissa_mask) * 128.0f;
+
+  const auto clamp_channel = [=](const float value) {
+    if (std::isnan(value) || value <= 0.0f) {
+      return 0.0f;
+    }
+    return std::min(value, shared_max);
+  };
+  red = clamp_channel(red);
+  green = clamp_channel(green);
+  blue = clamp_channel(blue);
+
+  const float max_channel = std::max(red, std::max(green, blue));
+  if (max_channel == 0.0f) {
+    return 0;
+  }
+
+  int binary_exponent = 0;
+  std::frexp(max_channel, &binary_exponent);
+  int shared_exponent = std::max(-exponent_bias, binary_exponent) + exponent_bias;
+  float scale = std::ldexp(1.0f, shared_exponent - exponent_bias - mantissa_bits);
+  const uint32_t max_mantissa = uint32_t(std::floor(max_channel / scale + 0.5f));
+  if (max_mantissa == (1u << mantissa_bits) && shared_exponent < exponent_max) {
+    shared_exponent++;
+    scale *= 2.0f;
+  }
+
+  const auto encode_mantissa = [=](const float value) {
+    return std::min(uint32_t(std::floor(value / scale + 0.5f)), mantissa_mask);
+  };
+  const uint32_t red_mantissa = encode_mantissa(red);
+  const uint32_t green_mantissa = encode_mantissa(green);
+  const uint32_t blue_mantissa = encode_mantissa(blue);
+  return red_mantissa | (green_mantissa << 9u) | (blue_mantissa << 18u) |
+         (uint32_t(shared_exponent) << 27u);
+}
+
+void unpack_rgb9e5_ufloat(const uint32_t packed, float r_rgb[3])
+{
+  constexpr uint32_t mantissa_mask = (1u << 9u) - 1u;
+  const int exponent = int((packed >> 27u) & 0x1fu);
+  const float scale = std::ldexp(1.0f, exponent - 24);
+  r_rgb[0] = float(packed & mantissa_mask) * scale;
+  r_rgb[1] = float((packed >> 9u) & mantissa_mask) * scale;
+  r_rgb[2] = float((packed >> 18u) & mantissa_mask) * scale;
+}
+
+template<uint32_t DestinationMantissaBits>
+static uint32_t convert_f32_to_unsigned_float_bits(const float value)
+{
+  constexpr uint32_t source_mantissa_bits = 23;
+  constexpr uint32_t source_mantissa_mask = (1u << source_mantissa_bits) - 1u;
+  constexpr int32_t source_exponent_bias = 127;
+  constexpr uint32_t source_exponent_special = 255;
+  constexpr uint32_t destination_mantissa_mask = (1u << DestinationMantissaBits) - 1u;
+  constexpr int32_t destination_exponent_bias = 15;
+  constexpr uint32_t destination_exponent_special = 31;
+
+  uint32_t bits = 0;
+  std::memcpy(&bits, &value, sizeof(bits));
+  const bool is_negative = (bits >> 31u) != 0;
+  uint32_t mantissa = bits & source_mantissa_mask;
+  int32_t exponent = int32_t((bits >> source_mantissa_bits) & source_exponent_special);
+  const bool is_nan = exponent == int32_t(source_exponent_special) && mantissa != 0;
+  const bool is_infinite = exponent == int32_t(source_exponent_special) && mantissa == 0;
+  const bool is_zero = exponent == 0 && mantissa == 0;
+
+  /* Match convert_float_formats<FormatF11/F10, FormatF32>() at the pin:
+   * negative finite values and infinities clamp to zero, while either-signed
+   * NaNs canonicalize to the destination's all-ones mantissa. */
+  if (is_negative && !is_nan) {
+    return 0;
+  }
+  if (is_zero) {
+    return 0;
+  }
+  if (is_infinite) {
+    exponent = int32_t(destination_exponent_special);
+  }
+  else if (is_nan) {
+    exponent = int32_t(destination_exponent_special);
+    mantissa = destination_mantissa_mask;
+  }
+  else {
+    exponent -= source_exponent_bias;
+    if (exponent > destination_exponent_bias) {
+      exponent = 0;
+      mantissa = source_mantissa_mask;
+    }
+    else if (exponent < -destination_exponent_bias) {
+      return 0;
+    }
+    exponent += destination_exponent_bias;
+    mantissa >>= source_mantissa_bits - DestinationMantissaBits;
+  }
+
+  return (uint32_t(exponent) << DestinationMantissaBits) |
+         (mantissa & destination_mantissa_mask);
+}
+
+template<uint32_t SourceMantissaBits>
+static float convert_unsigned_float_bits_to_f32(const uint32_t value)
+{
+  constexpr uint32_t source_mantissa_mask = (1u << SourceMantissaBits) - 1u;
+  constexpr int32_t source_exponent_bias = 15;
+  constexpr uint32_t source_exponent_special = 31;
+  constexpr uint32_t destination_mantissa_bits = 23;
+  constexpr uint32_t destination_mantissa_mask = (1u << destination_mantissa_bits) - 1u;
+  constexpr int32_t destination_exponent_bias = 127;
+  constexpr uint32_t destination_exponent_special = 255;
+
+  uint32_t mantissa = value & source_mantissa_mask;
+  int32_t exponent = int32_t((value >> SourceMantissaBits) & source_exponent_special);
+  const bool is_nan = exponent == int32_t(source_exponent_special) && mantissa != 0;
+  const bool is_infinite = exponent == int32_t(source_exponent_special) && mantissa == 0;
+  const bool is_zero = exponent == 0 && mantissa == 0;
+  if (is_zero) {
+    return 0.0f;
+  }
+  if (is_infinite) {
+    exponent = int32_t(destination_exponent_special);
+  }
+  else if (is_nan) {
+    exponent = int32_t(destination_exponent_special);
+    mantissa = destination_mantissa_mask;
+  }
+  else {
+    exponent -= source_exponent_bias;
+    exponent += destination_exponent_bias;
+    mantissa <<= destination_mantissa_bits - SourceMantissaBits;
+  }
+
+  const uint32_t bits = (uint32_t(exponent) << destination_mantissa_bits) |
+                        (mantissa & destination_mantissa_mask);
+  float result = 0.0f;
+  std::memcpy(&result, &bits, sizeof(result));
+  return result;
+}
+
+uint32_t pack_r11g11b10_ufloat(const float red, const float green, const float blue)
+{
+  const uint32_t red_bits = convert_f32_to_unsigned_float_bits<6>(red);
+  const uint32_t green_bits = convert_f32_to_unsigned_float_bits<6>(green);
+  const uint32_t blue_bits = convert_f32_to_unsigned_float_bits<5>(blue);
+  return red_bits | (green_bits << 11u) | (blue_bits << 22u);
+}
+
+void unpack_r11g11b10_ufloat(const uint32_t packed, float r_rgb[3])
+{
+  r_rgb[0] = convert_unsigned_float_bits_to_f32<6>(packed & 0x7ffu);
+  r_rgb[1] = convert_unsigned_float_bits_to_f32<6>((packed >> 11u) & 0x7ffu);
+  r_rgb[2] = convert_unsigned_float_bits_to_f32<5>((packed >> 22u) & 0x3ffu);
+}
+
+}  // namespace blender::gpu::webgpu
