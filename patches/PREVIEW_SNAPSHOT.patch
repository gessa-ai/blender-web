@@ -0,0 +1,40 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Conservative fallback for Blender's synchronous legacy occlusion-query API.
+ * Browser WebGPU can encode and resolve occlusion queries, but making the result
+ * CPU-visible requires an asynchronous map. Blender's legacy selection contract
+ * consumes every result synchronously in `GPU_select_end()`, so a real WebGPU
+ * implementation needs an asynchronous selection redesign rather than a blocking
+ * query pool.
+ *
+ * Until then, report no hits. This fails closed (never selects the wrong gizmo)
+ * and keeps post-render redraw alive. The legacy query path is used by 3D gizmo
+ * hit-testing; normal View3D object selection uses the Select-Next engine and is
+ * unaffected.
+ */
+
+#pragma once
+
+#include "gpu_query.hh"
+
+namespace blender::gpu {
+
+class WGPUQueryPool : public QueryPool {
+ public:
+  void init(GPUQueryType type) override;
+  void begin_query() override;
+  void end_query() override;
+  void get_occlusion_result(MutableSpan<uint32_t> r_values) override;
+
+ private:
+  uint32_t query_issued_ = 0;
+  bool initialized_ = false;
+  bool query_active_ = false;
+};
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_readback.cc b/source/blender/gpu/webgpu/wgpu_readback.cc
new file mode 100644
index 0000000000000000000000000000000000000000..d4e217545b9c44f652f850f5a4b1c949d955d47f
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_readback.cc
@@ -0,0 +1,1025 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * New for the web port (no upstream equivalent). */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Production WebGPU readback registry. Cache requests retain patch 0133's source-keyed
+ * fill-late behavior. Exact requests are unique chronological snapshots retained until
+ * explicit consume/free. All callback state is heap-owned, ticket publication is guarded,
+ * and WebGPU staging/source handles are released by the map callback that owns them. */
+
+#include "wgpu_readback.hh"
+
+#include "wgpu_common.hh"
+
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+#include <deque>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <utility>
+#include <vector>
+
+namespace blender::gpu::webgpu::readback {
+
+namespace {
+
+constexpr size_t kMaxInFlight = 64;
+constexpr size_t kMaxInFlightBytes = size_t(512) * 1024 * 1024;
+constexpr size_t kMaxSettled = 128;
+constexpr size_t kMaxCacheTickets = 128;
+constexpr size_t kMaxCachePayloadBytes = size_t(512) * 1024 * 1024;
+constexpr size_t kMaxExactClaims = 128;
+constexpr size_t kMaxExactClaimBytes = size_t(512) * 1024 * 1024;
+constexpr size_t kMaxExactRecords = 256;
+
+struct KeyHash {
+  size_t operator()(const SourceKey &k) const
+  {
+    size_t h = std::hash<const void *>{}(k.obj);
+    auto mix = [&](uint64_t value) {
+      h ^= std::hash<uint64_t>{}(value) + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+    };
+    mix(k.sub);
+    mix(k.span);
+    mix(k.origin_x);
+    mix(k.origin_y);
+    mix(k.origin_z);
+    mix(k.extent_x);
+    mix(k.extent_y);
+    mix(k.extent_z);
+    mix(k.aspect);
+    mix(uint8_t(k.kind));
+    return h;
+  }
+};
+
+struct KeyEq {
+  bool operator()(const SourceKey &a, const SourceKey &b) const
+  {
+    return a.kind == b.kind && a.obj == b.obj && a.sub == b.sub && a.span == b.span &&
+           a.origin_x == b.origin_x && a.origin_y == b.origin_y &&
+           a.origin_z == b.origin_z && a.extent_x == b.extent_x &&
+           a.extent_y == b.extent_y && a.extent_z == b.extent_z && a.aspect == b.aspect;
+  }
+};
+
+struct TicketRecord {
+  RequestMode mode = RequestMode::Cache;
+  SourceKey key;
+  TicketStatus status = TicketStatus::Pending;
+  TicketError error = TicketError::None;
+  std::shared_ptr<const std::vector<uint8_t>> bytes;
+  size_t reservation = 0;
+};
+
+struct Pending {
+  Ticket ticket = kInvalidTicket;
+  RequestMode mode = RequestMode::Cache;
+  SourceKey key;
+  std::shared_ptr<TicketRecord> record;
+
+  wgpu::Buffer staging;
+  wgpu::Buffer buffer_pin;
+  wgpu::Texture texture_pin;
+
+  uint32_t h = 0;
+  uint32_t z = 0;
+  uint32_t bytes_per_row = 0;
+  uint32_t row_bytes = 0;
+  size_t staging_size = 0;
+  size_t result_size = 0;
+  size_t want = 0;
+  bool is_buffer = false;
+  std::atomic_bool orphaned{false};
+};
+
+struct Settled {
+  std::shared_ptr<const std::vector<uint8_t>> bytes;
+};
+
+struct Registry {
+  std::mutex mutex;
+  std::unordered_map<Ticket, std::shared_ptr<TicketRecord>> tickets;
+  std::deque<Ticket> cache_ticket_order;
+  std::unordered_map<SourceKey, std::weak_ptr<Pending>, KeyHash, KeyEq> cache_pending;
+  std::unordered_map<SourceKey, Settled, KeyHash, KeyEq> settled;
+  std::deque<SourceKey> settled_order;
+  Ticket next_ticket = 1;
+  size_t in_flight = 0;
+  size_t in_flight_bytes = 0;
+  size_t cache_payload_bytes = 0;
+  size_t exact_claims = 0;
+  size_t exact_claim_bytes = 0;
+  size_t exact_records = 0;
+};
+
+/* Deliberately leaked so late WebGPU callbacks and wrapper destructors never race static
+ * destruction at process shutdown. */
+Registry &registry()
+{
+  static Registry *instance = new Registry();
+  return *instance;
+}
+
+bool checked_mul(size_t a, size_t b, size_t &result)
+{
+  if (a != 0 && b > std::numeric_limits<size_t>::max() / a) {
+    return false;
+  }
+  result = a * b;
+  return true;
+}
+
+bool checked_add_u32(uint32_t a, uint32_t b)
+{
+  return uint64_t(a) + uint64_t(b) <= std::numeric_limits<uint32_t>::max();
+}
+
+/** Return the exact linear-copy byte size for one uncompressed texel/aspect.
+ * Unsupported, compressed, multi-planar, and opaque-depth representations return 0 so
+ * validation fails before a command is encoded. */
+uint32_t texture_copy_texel_bytes(wgpu::TextureFormat format, wgpu::TextureAspect aspect)
+{
+  const bool color = aspect == wgpu::TextureAspect::All;
+  switch (format) {
+    case wgpu::TextureFormat::R8Unorm:
+    case wgpu::TextureFormat::R8Snorm:
+    case wgpu::TextureFormat::R8Uint:
+    case wgpu::TextureFormat::R8Sint:
+      return color ? 1u : 0u;
+
+    case wgpu::TextureFormat::R16Unorm:
+    case wgpu::TextureFormat::R16Snorm:
+    case wgpu::TextureFormat::R16Uint:
+    case wgpu::TextureFormat::R16Sint:
+    case wgpu::TextureFormat::R16Float:
+    case wgpu::TextureFormat::RG8Unorm:
+    case wgpu::TextureFormat::RG8Snorm:
+    case wgpu::TextureFormat::RG8Uint:
+    case wgpu::TextureFormat::RG8Sint:
+      return color ? 2u : 0u;
+
+    case wgpu::TextureFormat::R32Float:
+    case wgpu::TextureFormat::R32Uint:
+    case wgpu::TextureFormat::R32Sint:
+    case wgpu::TextureFormat::RG16Unorm:
+    case wgpu::TextureFormat::RG16Snorm:
+    case wgpu::TextureFormat::RG16Uint:
+    case wgpu::TextureFormat::RG16Sint:
+    case wgpu::TextureFormat::RG16Float:
+    case wgpu::TextureFormat::RGBA8Unorm:
+    case wgpu::TextureFormat::RGBA8UnormSrgb:
+    case wgpu::TextureFormat::RGBA8Snorm:
+    case wgpu::TextureFormat::RGBA8Uint:
+    case wgpu::TextureFormat::RGBA8Sint:
+    case wgpu::TextureFormat::BGRA8Unorm:
+    case wgpu::TextureFormat::BGRA8UnormSrgb:
+    case wgpu::TextureFormat::RGB10A2Uint:
+    case wgpu::TextureFormat::RGB10A2Unorm:
+    case wgpu::TextureFormat::RG11B10Ufloat:
+    case wgpu::TextureFormat::RGB9E5Ufloat:
+      return color ? 4u : 0u;
+
+    case wgpu::TextureFormat::RG32Float:
+    case wgpu::TextureFormat::RG32Uint:
+    case wgpu::TextureFormat::RG32Sint:
+    case wgpu::TextureFormat::RGBA16Unorm:
+    case wgpu::TextureFormat::RGBA16Snorm:
+    case wgpu::TextureFormat::RGBA16Uint:
+    case wgpu::TextureFormat::RGBA16Sint:
+    case wgpu::TextureFormat::RGBA16Float:
+      return color ? 8u : 0u;
+
+    case wgpu::TextureFormat::RGBA32Float:
+    case wgpu::TextureFormat::RGBA32Uint:
+    case wgpu::TextureFormat::RGBA32Sint:
+      return color ? 16u : 0u;
+
+    case wgpu::TextureFormat::Stencil8:
+      return (aspect == wgpu::TextureAspect::All ||
+              aspect == wgpu::TextureAspect::StencilOnly) ?
+                 1u :
+                 0u;
+    case wgpu::TextureFormat::Depth16Unorm:
+      return (aspect == wgpu::TextureAspect::All || aspect == wgpu::TextureAspect::DepthOnly) ?
+                 2u :
+                 0u;
+    case wgpu::TextureFormat::Depth32Float:
+      return (aspect == wgpu::TextureAspect::All || aspect == wgpu::TextureAspect::DepthOnly) ?
+                 4u :
+                 0u;
+    case wgpu::TextureFormat::Depth32FloatStencil8:
+      return (aspect == wgpu::TextureAspect::DepthOnly) ?
+                 4u :
+                 ((aspect == wgpu::TextureAspect::StencilOnly) ? 1u : 0u);
+    case wgpu::TextureFormat::Depth24PlusStencil8:
+      return (aspect == wgpu::TextureAspect::StencilOnly) ? 1u : 0u;
+
+    /* Depth24Plus has an opaque device representation. Compressed and extension
+     * formats need block-coordinate layout support that this primitive does not expose. */
+    case wgpu::TextureFormat::Undefined:
+    case wgpu::TextureFormat::Depth24Plus:
+    default:
+      return 0u;
+  }
+}
+
+bool is_depth_stencil_format(wgpu::TextureFormat format)
+{
+  return format == wgpu::TextureFormat::Stencil8 ||
+         format == wgpu::TextureFormat::Depth16Unorm ||
+         format == wgpu::TextureFormat::Depth24Plus ||
+         format == wgpu::TextureFormat::Depth24PlusStencil8 ||
+         format == wgpu::TextureFormat::Depth32Float ||
+         format == wgpu::TextureFormat::Depth32FloatStencil8;
+}
+
+void erase_cache_payload_locked(
+    Registry &reg,
+    const SourceKey &key,
+    const std::shared_ptr<const std::vector<uint8_t>> &expected = nullptr)
+{
+  const auto settled = reg.settled.find(key);
+  if (settled == reg.settled.end() ||
+      (expected != nullptr && settled->second.bytes != expected))
+  {
+    return;
+  }
+  const std::shared_ptr<const std::vector<uint8_t>> payload = settled->second.bytes;
+  const size_t payload_size = payload ? payload->size() : 0;
+  reg.cache_payload_bytes = (reg.cache_payload_bytes >= payload_size) ?
+                                reg.cache_payload_bytes - payload_size :
+                                0;
+  reg.settled.erase(settled);
+  reg.settled_order.erase(
+      std::remove_if(reg.settled_order.begin(),
+                     reg.settled_order.end(),
+                     [&](const SourceKey &candidate) { return KeyEq{}(candidate, key); }),
+      reg.settled_order.end());
+
+  /* A terminal cache ticket shares this immutable payload with the settled mapping.
+   * Eviction must drop both references or the aggregate byte budget would be cosmetic. */
+  for (auto ticket = reg.tickets.begin(); ticket != reg.tickets.end();) {
+    const TicketRecord &record = *ticket->second;
+    if (record.mode == RequestMode::Cache && record.status != TicketStatus::Pending &&
+        record.bytes == payload)
+    {
+      ticket = reg.tickets.erase(ticket);
+    }
+    else {
+      ++ticket;
+    }
+  }
+}
+
+void evict_settled_locked(Registry &reg)
+{
+  while (reg.settled.size() > kMaxSettled ||
+         reg.cache_payload_bytes > kMaxCachePayloadBytes)
+  {
+    if (reg.settled_order.empty()) {
+      break;
+    }
+    const SourceKey key = reg.settled_order.front();
+    if (reg.settled.find(key) == reg.settled.end()) {
+      reg.settled_order.pop_front();
+      continue;
+    }
+    erase_cache_payload_locked(reg, key);
+  }
+}
+
+void make_cache_payload_room_locked(Registry &reg, size_t incoming_bytes)
+{
+  /* Evict before addition so wasm32 size_t accounting cannot wrap while briefly
+   * exceeding the aggregate budget. Every admitted payload is at most the in-flight
+   * byte cap, which is the same size as this cache budget. */
+  while (!reg.settled.empty() &&
+         (reg.settled.size() >= kMaxSettled || incoming_bytes > kMaxCachePayloadBytes ||
+          reg.cache_payload_bytes > kMaxCachePayloadBytes - incoming_bytes))
+  {
+    if (reg.settled_order.empty()) {
+      break;
+    }
+    const SourceKey key = reg.settled_order.front();
+    if (reg.settled.find(key) == reg.settled.end()) {
+      reg.settled_order.pop_front();
+      continue;
+    }
+    erase_cache_payload_locked(reg, key);
+  }
+}
+
+void evict_cache_tickets_locked(Registry &reg)
+{
+  size_t pending_seen = 0;
+  while (reg.cache_ticket_order.size() > kMaxCacheTickets) {
+    const Ticket ticket = reg.cache_ticket_order.front();
+    reg.cache_ticket_order.pop_front();
+    const auto found = reg.tickets.find(ticket);
+    if (found == reg.tickets.end() || found->second->mode != RequestMode::Cache) {
+      continue;
+    }
+    if (found->second->status == TicketStatus::Pending) {
+      /* Pending tickets cannot be retired. Rotate them behind terminal tickets; the
+       * in-flight cap guarantees this scan reaches an evictable entry. */
+      reg.cache_ticket_order.push_back(ticket);
+      pending_seen++;
+      if (pending_seen >= reg.cache_ticket_order.size()) {
+        break;
+      }
+      continue;
+    }
+    reg.tickets.erase(found);
+    pending_seen = 0;
+  }
+}
+
+void release_exact_reservation_locked(Registry &reg, TicketRecord &record)
+{
+  if (record.mode != RequestMode::Exact || record.reservation == 0) {
+    return;
+  }
+  if (reg.exact_claims > 0) {
+    reg.exact_claims--;
+  }
+  reg.exact_claim_bytes = (reg.exact_claim_bytes >= record.reservation) ?
+                              reg.exact_claim_bytes - record.reservation :
+                              0;
+  record.reservation = 0;
+}
+
+Ticket allocate_ticket_locked(Registry &reg,
+                              RequestMode mode,
+                              const SourceKey &key,
+                              TicketStatus status,
+                              TicketError error)
+{
+  Ticket ticket = kInvalidTicket;
+  size_t attempts = 0;
+  do {
+    ticket = reg.next_ticket++;
+    attempts++;
+  } while ((ticket == kInvalidTicket || reg.tickets.find(ticket) != reg.tickets.end()) &&
+           attempts <= reg.tickets.size() + 1);
+  if (ticket == kInvalidTicket || reg.tickets.find(ticket) != reg.tickets.end()) {
+    return kInvalidTicket;
+  }
+  auto record = std::make_shared<TicketRecord>();
+  record->mode = mode;
+  record->key = key;
+  record->status = status;
+  record->error = error;
+  reg.tickets.emplace(ticket, std::move(record));
+  if (mode == RequestMode::Cache) {
+    reg.cache_ticket_order.push_back(ticket);
+    evict_cache_tickets_locked(reg);
+  }
+  else {
+    reg.exact_records++;
+  }
+  return ticket;
+}
+
+Ticket failed_ticket(RequestMode mode, const SourceKey &key, TicketError error)
+{
+  if (mode == RequestMode::Cache) {
+    return kInvalidTicket;
+  }
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  if (reg.exact_records >= kMaxExactRecords) {
+    return kInvalidTicket;
+  }
+  return allocate_ticket_locked(reg, mode, key, TicketStatus::Failed, error);
+}
+
+Ticket cache_pending_ticket_locked(Registry &reg, const SourceKey &key)
+{
+  const auto found = reg.cache_pending.find(key);
+  if (found == reg.cache_pending.end()) {
+    return kInvalidTicket;
+  }
+  const std::shared_ptr<Pending> pending = found->second.lock();
+  if (!pending || pending->orphaned.load(std::memory_order_acquire) ||
+      !pending->record || pending->record->status != TicketStatus::Pending)
+  {
+    reg.cache_pending.erase(found);
+    return kInvalidTicket;
+  }
+  return pending->ticket;
+}
+
+void release_backend_handles(Pending &pending)
+{
+  pending.staging = wgpu::Buffer(nullptr);
+  pending.buffer_pin = wgpu::Buffer(nullptr);
+  pending.texture_pin = wgpu::Texture(nullptr);
+}
+
+void complete_pending(const std::shared_ptr<Pending> &pending, wgpu::MapAsyncStatus map_status)
+{
+  TicketError completion_error = TicketError::None;
+  std::vector<uint8_t> tight;
+
+  if (map_status != wgpu::MapAsyncStatus::Success) {
+    completion_error = TicketError::MapFailed;
+  }
+  else {
+    const uint8_t *mapped = static_cast<const uint8_t *>(
+        pending->staging.GetConstMappedRange(0, pending->staging_size));
+    if (mapped == nullptr) {
+      completion_error = TicketError::NoMappedRange;
+    }
+    else if (pending->is_buffer) {
+      tight.assign(mapped, mapped + std::min(pending->want, pending->staging_size));
+    }
+    else {
+      const uint32_t layers = std::max(pending->z, 1u);
+      size_t tight_size = 0;
+      if (!checked_mul(size_t(pending->row_bytes), pending->h, tight_size) ||
+          !checked_mul(tight_size, layers, tight_size))
+      {
+        completion_error = TicketError::InvalidArgument;
+      }
+      else {
+        tight.resize(tight_size);
+        uint8_t *output = tight.data();
+        for (uint32_t layer = 0; layer < layers; layer++) {
+          for (uint32_t row_index = 0; row_index < pending->h; row_index++) {
+            const uint8_t *row =
+                mapped + (size_t(layer) * pending->h + row_index) * pending->bytes_per_row;
+            std::memcpy(output, row, pending->row_bytes);
+            output += pending->row_bytes;
+          }
+        }
+      }
+    }
+    pending->staging.Unmap();
+  }
+
+  /* Every WebGPU handle is dropped on the callback thread before CPU-only publication. */
+  release_backend_handles(*pending);
+
+  Registry &reg = registry();
+  {
+    std::lock_guard lock(reg.mutex);
+    if (reg.in_flight > 0) {
+      reg.in_flight--;
+    }
+    reg.in_flight_bytes = (reg.in_flight_bytes >= pending->staging_size) ?
+                              reg.in_flight_bytes - pending->staging_size :
+                              0;
+
+    if (pending->mode == RequestMode::Cache) {
+      const auto current = reg.cache_pending.find(pending->key);
+      if (current != reg.cache_pending.end()) {
+        const std::shared_ptr<Pending> same = current->second.lock();
+        if (!same || same.get() == pending.get()) {
+          reg.cache_pending.erase(current);
+        }
+      }
+    }
+
+    TicketRecord &record = *pending->record;
+    if (record.status == TicketStatus::Canceled) {
+      record.bytes.reset();
+    }
+    else if (pending->orphaned.load(std::memory_order_acquire)) {
+      record.status = TicketStatus::Failed;
+      record.error = TicketError::SourceForgotten;
+      release_exact_reservation_locked(reg, record);
+    }
+    else if (completion_error != TicketError::None) {
+      record.status = TicketStatus::Failed;
+      record.error = completion_error;
+      release_exact_reservation_locked(reg, record);
+    }
+    else {
+      record.bytes = std::make_shared<const std::vector<uint8_t>>(std::move(tight));
+      record.status = TicketStatus::Ready;
+      record.error = TicketError::None;
+      if (pending->mode == RequestMode::Cache) {
+        erase_cache_payload_locked(reg, pending->key);
+        make_cache_payload_room_locked(reg, record.bytes->size());
+        reg.settled[pending->key] = Settled{record.bytes};
+        reg.settled_order.push_back(pending->key);
+        reg.cache_payload_bytes += record.bytes->size();
+        evict_settled_locked(reg);
+      }
+    }
+    evict_cache_tickets_locked(reg);
+  }
+}
+
+bool reserve_pending(const std::shared_ptr<Pending> &pending)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+
+  if (pending->mode == RequestMode::Cache) {
+    const Ticket existing = cache_pending_ticket_locked(reg, pending->key);
+    if (existing != kInvalidTicket) {
+      pending->ticket = existing;
+      return false;
+    }
+  }
+
+  if (reg.in_flight >= kMaxInFlight || pending->staging_size > kMaxInFlightBytes ||
+      reg.in_flight_bytes > kMaxInFlightBytes - pending->staging_size)
+  {
+    return false;
+  }
+  if (pending->mode == RequestMode::Exact &&
+      (reg.exact_records >= kMaxExactRecords || reg.exact_claims >= kMaxExactClaims ||
+       pending->result_size > kMaxExactClaimBytes ||
+       reg.exact_claim_bytes > kMaxExactClaimBytes - pending->result_size))
+  {
+    return false;
+  }
+
+  pending->ticket = allocate_ticket_locked(
+      reg, pending->mode, pending->key, TicketStatus::Pending, TicketError::None);
+  if (pending->ticket == kInvalidTicket) {
+    return false;
+  }
+  pending->record = reg.tickets.at(pending->ticket);
+  if (pending->mode == RequestMode::Exact) {
+    pending->record->reservation = pending->result_size;
+    reg.exact_claims++;
+    reg.exact_claim_bytes += pending->result_size;
+  }
+  if (pending->mode == RequestMode::Cache) {
+    reg.cache_pending[pending->key] = pending;
+  }
+  reg.in_flight++;
+  reg.in_flight_bytes += pending->staging_size;
+  return true;
+}
+
+void fail_reserved_pending(const std::shared_ptr<Pending> &pending, TicketError error)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+
+  if (reg.in_flight > 0) {
+    reg.in_flight--;
+  }
+  reg.in_flight_bytes = (reg.in_flight_bytes >= pending->staging_size) ?
+                            reg.in_flight_bytes - pending->staging_size :
+                            0;
+  if (pending->mode == RequestMode::Cache) {
+    const auto current = reg.cache_pending.find(pending->key);
+    if (current != reg.cache_pending.end()) {
+      const std::shared_ptr<Pending> same = current->second.lock();
+      if (!same || same.get() == pending.get()) {
+        reg.cache_pending.erase(current);
+      }
+    }
+  }
+
+  TicketRecord &record = *pending->record;
+  /* The Cache ticket is visible between reservation and CreateBuffer. Another caller
+   * may cancel/free it while allocation is in progress; allocation failure must not
+   * overwrite that terminal decision. Accounting/weak-key cleanup still occurs here. */
+  if (record.status == TicketStatus::Pending) {
+    record.status = TicketStatus::Failed;
+    record.error = error;
+    record.bytes.reset();
+  }
+  release_exact_reservation_locked(reg, record);
+  evict_cache_tickets_locked(reg);
+}
+
+}  // namespace
+
+Ticket kick_texture(const wgpu::Instance &instance,
+                    const wgpu::Device &device,
+                    const wgpu::Queue &queue,
+                    OrderedQueueScheduler &scheduler,
+                    const wgpu::Texture &texture,
+                    SourceKey key,
+                    const TextureRegion &region,
+                    uint32_t texel_bytes,
+                    uint32_t bytes_per_row,
+                    uint32_t row_bytes,
+                    RequestMode mode)
+{
+  key.sub = region.mip_level;
+  key.origin_x = region.origin_x;
+  key.origin_y = region.origin_y;
+  key.origin_z = region.origin_z;
+  key.extent_x = region.width;
+  key.extent_y = region.height;
+  key.extent_z = region.depth;
+  key.aspect = uint8_t(region.aspect);
+
+  size_t rows_size = 0;
+  size_t staging_size = 0;
+  bool valid_bounds = false;
+  uint32_t copy_texel_bytes = 0;
+  bool valid_depth_stencil_extent = true;
+  if (texture != nullptr && region.mip_level < texture.GetMipLevelCount()) {
+    const auto mip_dimension = [](uint32_t base, uint32_t mip) {
+      return std::max((mip < 32) ? (base >> mip) : 0u, 1u);
+    };
+    const uint32_t mip_width = mip_dimension(texture.GetWidth(), region.mip_level);
+    const uint32_t mip_height = (texture.GetDimension() == wgpu::TextureDimension::e1D) ?
+                                    1u :
+                                    mip_dimension(texture.GetHeight(), region.mip_level);
+    const uint32_t mip_depth = (texture.GetDimension() == wgpu::TextureDimension::e3D) ?
+                                   mip_dimension(texture.GetDepthOrArrayLayers(),
+                                                 region.mip_level) :
+                                   texture.GetDepthOrArrayLayers();
+    valid_bounds = region.origin_x <= mip_width && region.width <= mip_width - region.origin_x &&
+                   region.origin_y <= mip_height &&
+                   region.height <= mip_height - region.origin_y &&
+                   region.origin_z <= mip_depth && region.depth <= mip_depth - region.origin_z;
+    copy_texel_bytes = texture_copy_texel_bytes(texture.GetFormat(), region.aspect);
+    if (is_depth_stencil_format(texture.GetFormat())) {
+      /* WebGPU linear depth/stencil copies must cover the entire x/y subresource. */
+      valid_depth_stencil_extent = region.origin_x == 0 && region.origin_y == 0 &&
+                                   region.width == mip_width && region.height == mip_height;
+    }
+  }
+  const bool valid_region = region.width > 0 && region.height > 0 && region.depth > 0 &&
+                            checked_add_u32(region.origin_x, region.width) &&
+                            checked_add_u32(region.origin_y, region.height) &&
+                            checked_add_u32(region.origin_z, region.depth);
+  const uint64_t tight_row_bytes = uint64_t(region.width) * copy_texel_bytes;
+  const bool valid_layout = copy_texel_bytes > 0 && texel_bytes == copy_texel_bytes &&
+                            tight_row_bytes <= std::numeric_limits<uint32_t>::max() &&
+                            row_bytes == tight_row_bytes && bytes_per_row >= row_bytes &&
+                            (bytes_per_row % 256) == 0 &&
+                            checked_mul(bytes_per_row, region.height, rows_size) &&
+                            checked_mul(rows_size, region.depth, staging_size) && staging_size > 0;
+  wgpu::Limits device_limits = {};
+  const bool valid_staging_limit = device != nullptr && device.GetLimits(&device_limits) &&
+                                   staging_size <= device_limits.maxBufferSize;
+  if (device == nullptr || queue == nullptr || texture == nullptr || !valid_region ||
+      (texture.GetUsage() & wgpu::TextureUsage::CopySrc) == wgpu::TextureUsage::None ||
+      texture.GetSampleCount() != 1 ||
+      !valid_bounds || !valid_depth_stencil_extent || !valid_layout || !valid_staging_limit)
+  {
+    return failed_ticket(mode, key, TicketError::InvalidArgument);
+  }
+
+  if (mode == RequestMode::Cache) {
+    Registry &reg = registry();
+    std::lock_guard lock(reg.mutex);
+    if (const Ticket existing = cache_pending_ticket_locked(reg, key);
+        existing != kInvalidTicket)
+    {
+      return existing;
+    }
+  }
+
+  auto pending = std::make_shared<Pending>();
+  pending->mode = mode;
+  pending->key = key;
+  pending->texture_pin = texture;
+  pending->h = region.height;
+  pending->z = region.depth;
+  pending->bytes_per_row = bytes_per_row;
+  pending->row_bytes = row_bytes;
+  pending->staging_size = staging_size;
+  pending->result_size = size_t(row_bytes) * region.height * region.depth;
+
+  if (!reserve_pending(pending)) {
+    if (pending->ticket != kInvalidTicket) {
+      return pending->ticket;
+    }
+    release_backend_handles(*pending);
+    return failed_ticket(mode, key, TicketError::CapacityExceeded);
+  }
+
+  wgpu::BufferDescriptor descriptor = {};
+  descriptor.size = staging_size;
+  descriptor.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+  wgpu::Buffer staging = device.CreateBuffer(&descriptor);
+  if (staging == nullptr) {
+    fail_reserved_pending(pending, TicketError::StagingAllocationFailed);
+    release_backend_handles(*pending);
+    return pending->ticket;
+  }
+  pending->staging = staging;
+
+  wgpu::TexelCopyTextureInfo source = {};
+  source.texture = texture;
+  source.mipLevel = region.mip_level;
+  source.origin = {region.origin_x, region.origin_y, region.origin_z};
+  source.aspect = region.aspect;
+
+  wgpu::TexelCopyBufferInfo destination = {};
+  destination.buffer = staging;
+  destination.layout.offset = 0;
+  destination.layout.bytesPerRow = bytes_per_row;
+  destination.layout.rowsPerImage = region.height;
+
+  const wgpu::Extent3D extent = {region.width, region.height, region.depth};
+  webgpu::command_encode_submit_scoped(
+      instance,
+      device,
+      queue,
+      scheduler,
+      "texture readback copy",
+      [&](auto &encoder) { encoder.CopyTextureToBuffer(&source, &destination, &extent); },
+      [pending, staging, staging_size](const bool valid) mutable {
+        if (!valid) {
+          fail_reserved_pending(pending, TicketError::CommandEncodingFailed);
+          release_backend_handles(*pending);
+          return;
+        }
+        staging.MapAsync(wgpu::MapMode::Read,
+                         0,
+                         staging_size,
+                         wgpu::CallbackMode::AllowSpontaneous,
+                         [pending](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                           complete_pending(pending, status);
+                         });
+      });
+  return pending->ticket;
+}
+
+Ticket kick_buffer(const wgpu::Instance &instance,
+                   const wgpu::Device &device,
+                   const wgpu::Queue &queue,
+                   OrderedQueueScheduler &scheduler,
+                   const wgpu::Buffer &handle,
+                   SourceKey key,
+                   uint64_t offset,
+                   uint64_t copy,
+                   uint64_t want,
+                   RequestMode mode)
+{
+  const uint64_t handle_size = (handle != nullptr) ? handle.GetSize() : 0;
+  wgpu::Limits device_limits = {};
+  const bool valid_staging_limit = device != nullptr && device.GetLimits(&device_limits) &&
+                                   copy <= device_limits.maxBufferSize;
+  if (device == nullptr || queue == nullptr || handle == nullptr || copy == 0 || want == 0 ||
+      want > copy || copy > std::numeric_limits<size_t>::max() || (offset % 4) != 0 ||
+      (copy % 4) != 0 ||
+      (handle.GetUsage() & wgpu::BufferUsage::CopySrc) == wgpu::BufferUsage::None ||
+      handle.GetMapState() != wgpu::BufferMapState::Unmapped ||
+      !valid_staging_limit ||
+      offset > handle_size || copy > handle_size - offset)
+  {
+    return failed_ticket(mode, key, TicketError::InvalidArgument);
+  }
+
+  if (mode == RequestMode::Cache) {
+    Registry &reg = registry();
+    std::lock_guard lock(reg.mutex);
+    if (const Ticket existing = cache_pending_ticket_locked(reg, key);
+        existing != kInvalidTicket)
+    {
+      return existing;
+    }
+  }
+
+  auto pending = std::make_shared<Pending>();
+  pending->mode = mode;
+  pending->key = key;
+  pending->buffer_pin = handle;
+  pending->staging_size = size_t(copy);
+  pending->result_size = size_t(want);
+  pending->want = size_t(want);
+  pending->is_buffer = true;
+
+  if (!reserve_pending(pending)) {
+    if (pending->ticket != kInvalidTicket) {
+      return pending->ticket;
+    }
+    release_backend_handles(*pending);
+    return failed_ticket(mode, key, TicketError::CapacityExceeded);
+  }
+
+  wgpu::BufferDescriptor descriptor = {};
+  descriptor.size = copy;
+  descriptor.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+  wgpu::Buffer staging = device.CreateBuffer(&descriptor);
+  if (staging == nullptr) {
+    fail_reserved_pending(pending, TicketError::StagingAllocationFailed);
+    release_backend_handles(*pending);
+    return pending->ticket;
+  }
+  pending->staging = staging;
+
+  webgpu::command_encode_submit_scoped(
+      instance,
+      device,
+      queue,
+      scheduler,
+      "buffer readback copy",
+      [&](auto &encoder) { encoder.CopyBufferToBuffer(handle, offset, staging, 0, copy); },
+      [pending, staging, copy](const bool valid) mutable {
+        if (!valid) {
+          fail_reserved_pending(pending, TicketError::CommandEncodingFailed);
+          release_backend_handles(*pending);
+          return;
+        }
+        staging.MapAsync(wgpu::MapMode::Read,
+                         0,
+                         copy,
+                         wgpu::CallbackMode::AllowSpontaneous,
+                         [pending](wgpu::MapAsyncStatus status, wgpu::StringView) {
+                           complete_pending(pending, status);
+                         });
+      });
+  return pending->ticket;
+}
+
+bool take_settled(SourceKey key, void *destination, size_t destination_size)
+{
+  if (destination == nullptr || destination_size == 0) {
+    return false;
+  }
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  const auto found = reg.settled.find(key);
+  if (found == reg.settled.end() || !found->second.bytes ||
+      found->second.bytes->size() != destination_size)
+  {
+    return false;
+  }
+  std::memcpy(destination, found->second.bytes->data(), destination_size);
+  return true;
+}
+
+TicketStatus ticket_status(Ticket ticket)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  const auto found = reg.tickets.find(ticket);
+  return (found != reg.tickets.end()) ? found->second->status : TicketStatus::Invalid;
+}
+
+TicketError ticket_error(Ticket ticket)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  const auto found = reg.tickets.find(ticket);
+  return (found != reg.tickets.end()) ? found->second->error : TicketError::InvalidArgument;
+}
+
+size_t ticket_size(Ticket ticket)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  const auto found = reg.tickets.find(ticket);
+  return (found != reg.tickets.end() && found->second->bytes) ? found->second->bytes->size() : 0;
+}
+
+bool is_ready(Ticket ticket)
+{
+  return ticket_status(ticket) == TicketStatus::Ready;
+}
+
+size_t consume_ticket(Ticket ticket, void *destination, size_t destination_size)
+{
+  if (destination == nullptr || destination_size == 0) {
+    return 0;
+  }
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  const auto found = reg.tickets.find(ticket);
+  if (found == reg.tickets.end() || found->second->status != TicketStatus::Ready ||
+      !found->second->bytes || destination_size < found->second->bytes->size())
+  {
+    return 0;
+  }
+  const size_t size = found->second->bytes->size();
+  std::memcpy(destination, found->second->bytes->data(), size);
+  release_exact_reservation_locked(reg, *found->second);
+  found->second->bytes.reset();
+  if (found->second->mode == RequestMode::Exact && reg.exact_records > 0) {
+    reg.exact_records--;
+  }
+  reg.tickets.erase(found);
+  return size;
+}
+
+bool cancel_ticket(Ticket ticket)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  const auto found = reg.tickets.find(ticket);
+  if (found == reg.tickets.end()) {
+    return false;
+  }
+  TicketRecord &record = *found->second;
+  if (record.status == TicketStatus::Failed || record.status == TicketStatus::Canceled) {
+    return false;
+  }
+  if (record.mode == RequestMode::Cache && record.status == TicketStatus::Ready &&
+      record.bytes != nullptr)
+  {
+    const std::shared_ptr<const std::vector<uint8_t>> payload = record.bytes;
+    erase_cache_payload_locked(reg, record.key, payload);
+    return true;
+  }
+  record.status = TicketStatus::Canceled;
+  record.error = TicketError::Canceled;
+  release_exact_reservation_locked(reg, record);
+  record.bytes.reset();
+  return true;
+}
+
+void free_ticket(Ticket ticket)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  const auto found = reg.tickets.find(ticket);
+  if (found == reg.tickets.end()) {
+    return;
+  }
+  if (found->second->mode == RequestMode::Cache &&
+      found->second->status == TicketStatus::Ready && found->second->bytes != nullptr)
+  {
+    const SourceKey key = found->second->key;
+    const std::shared_ptr<const std::vector<uint8_t>> payload = found->second->bytes;
+    erase_cache_payload_locked(reg, key, payload);
+    /* erase_cache_payload_locked retires every terminal cache ticket sharing payload. */
+    if (reg.tickets.find(ticket) == reg.tickets.end()) {
+      return;
+    }
+  }
+  const auto current = reg.tickets.find(ticket);
+  if (current == reg.tickets.end()) {
+    return;
+  }
+  current->second->status = TicketStatus::Canceled;
+  current->second->error = TicketError::Canceled;
+  release_exact_reservation_locked(reg, *current->second);
+  current->second->bytes.reset();
+  if (current->second->mode == RequestMode::Exact && reg.exact_records > 0) {
+    reg.exact_records--;
+  }
+  reg.tickets.erase(current);
+}
+
+int pending_count()
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  return int(std::min<size_t>(reg.in_flight, size_t(INT32_MAX)));
+}
+
+void pump()
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+  evict_settled_locked(reg);
+  evict_cache_tickets_locked(reg);
+}
+
+void forget_source(SourceKind kind, const void *object)
+{
+  Registry &reg = registry();
+  std::lock_guard lock(reg.mutex);
+
+  for (auto iterator = reg.cache_pending.begin(); iterator != reg.cache_pending.end();) {
+    if (iterator->first.kind == kind && iterator->first.obj == object) {
+      if (const std::shared_ptr<Pending> pending = iterator->second.lock()) {
+        pending->orphaned.store(true, std::memory_order_release);
+      }
+      iterator = reg.cache_pending.erase(iterator);
+    }
+    else {
+      ++iterator;
+    }
+  }
+
+  std::vector<SourceKey> settled_to_erase;
+  for (const SourceKey &key : reg.settled_order) {
+    if (key.kind == kind && key.obj == object) {
+      settled_to_erase.push_back(key);
+    }
+  }
+  for (const SourceKey &key : settled_to_erase) {
+    erase_cache_payload_locked(reg, key);
+  }
+
+  for (auto iterator = reg.tickets.begin(); iterator != reg.tickets.end();) {
+    TicketRecord &record = *iterator->second;
+    if (record.mode == RequestMode::Cache && record.key.kind == kind && record.key.obj == object) {
+      record.status = TicketStatus::Failed;
+      record.error = TicketError::SourceForgotten;
+      record.bytes.reset();
+      iterator = reg.tickets.erase(iterator);
+    }
+    else {
+      ++iterator;
+    }
+  }
+}
+
+}  // namespace blender::gpu::webgpu::readback
