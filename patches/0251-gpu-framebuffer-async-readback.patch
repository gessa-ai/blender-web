+      (packed_format && channel_len != 1) ||
+      ((planes & GPU_COLOR_BIT) && (slot < 0 || slot >= GPU_FB_MAX_COLOR_ATTACHMENT)))
+  {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  const size_t component_size = to_bytesize(format);
+  const size_t width = size_t(area[2]);
+  const size_t height = size_t(area[3]);
+  if (component_size == 0 || width > std::numeric_limits<size_t>::max() / height) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  const size_t sample_count = width * height;
+  const size_t sample_size = size_t(channel_len) * component_size;
+  if (sample_count > std::numeric_limits<size_t>::max() / sample_size) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  std::vector<unsigned char> bytes(sample_count * sample_size);
+  read(planes, format, area, channel_len, slot, bytes.data());
+  return gpu_readback_create_ready(std::move(bytes));
