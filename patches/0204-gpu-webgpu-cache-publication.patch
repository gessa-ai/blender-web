diff --git a/source/blender/gpu/webgpu/wgpu_common.hh b/source/blender/gpu/webgpu/wgpu_common.hh
--- a/source/blender/gpu/webgpu/wgpu_common.hh
+++ b/source/blender/gpu/webgpu/wgpu_common.hh
@@ -148 +148,14 @@ inline bool multi_viewport_uniform_buffer_create(DeviceT &device, BufferT &result)
+/** Publish a fallible WebGPU handle only after creation succeeds. A null sampler or pipeline
+ * must remain absent so the same cache key can retry after a transient allocation failure.
+ * Templated so the exact transaction remains device-free testable on native and Wasm. */
+template<typename CacheT, typename KeyT, typename HandleT>
+inline bool cache_handle_if_valid(CacheT &cache, const KeyT &key, const HandleT &handle)
+{
+  if (handle == nullptr) {
+    return false;
+  }
+  cache.emplace(key, handle);
+  return true;
+}
+
 /** One signed viewport plus its WebGPU-valid unsigned framebuffer intersection. */
