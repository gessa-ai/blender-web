+struct ViewportDepthPickSession::Impl {
+  ARegion *region = nullptr;
+  RegionView3D *region_view = nullptr;
+  GPUReadback *readback = nullptr;
+  rcti request_rect = {};
+  rcti sample_rects[3] = {};
+  bool sample_rect_valid[3] = {false, false, false};
+  int region_size[2] = {0, 0};
+  int mval[2] = {0, 0};
+  float viewinv[4][4] = {};
+  float winmat[4][4] = {};
+  size_t expected_size = 0;
+  std::vector<float> depths;
+  float depth = FLT_MAX;
+  ReadbackState readback_state = ReadbackState::Failed;
+};
+
+static bool view3d_depth_pick_rect_clamp(ARegion *region, rcti &rect)
+{
+  const rcti bounds = {0, region->winx - 1, 0, region->winy - 1};
+  return BLI_rcti_isect(&bounds, &rect, &rect) && BLI_rcti_size_x(&rect) > 0 &&
+         BLI_rcti_size_y(&rect) > 0;
+}
+
+static rcti view3d_depth_pick_rect_from_margin(const int mval[2], const int margin)
+{
+  rcti rect;
+  if (margin == 0) {
+    rect.xmin = mval[0];
+    rect.ymin = mval[1];
+    rect.xmax = mval[0] + 1;
+    rect.ymax = mval[1] + 1;
+  }
+  else {
+    BLI_rcti_init_pt_radius(&rect, mval, margin);
+  }
+  return rect;
+}
+
+ViewportDepthPickSession::~ViewportDepthPickSession()
+{
+  if (impl_ != nullptr) {
+    GPU_readback_cancel(impl_->readback);
+    MEM_delete(impl_);
+    impl_ = nullptr;
+  }
+}
+
+bool ViewportDepthPickSession::init(ARegion *region, const int mval[2])
+{
+  if (impl_ != nullptr) {
+    GPU_readback_cancel(impl_->readback);
+    MEM_delete(impl_);
+    impl_ = nullptr;
+  }
+  if (region == nullptr || region->regiondata == nullptr || mval == nullptr || region->winx <= 1 ||
+      region->winy <= 1)
+  {
+    return false;
+  }
+
+  Impl *impl = MEM_new<Impl>(__func__);
+  impl->region = region;
+  impl->region_view = static_cast<RegionView3D *>(region->regiondata);
+  impl->region_size[0] = region->winx;
+  impl->region_size[1] = region->winy;
+  copy_v2_v2_int(impl->mval, mval);
+  copy_m4_m4(impl->viewinv, impl->region_view->viewinv);
+  copy_m4_m4(impl->winmat, impl->region_view->winmat);
+
+  constexpr int margin_count = 3;
+  const int margin_pixels[margin_count] = {
+      0,
+      int(2.0f * U.pixelsize),
+      int(4.0f * U.pixelsize),
+  };
+  bool has_request_rect = false;
+  for (int i = 0; i < margin_count; i++) {
+    impl->sample_rects[i] = view3d_depth_pick_rect_from_margin(mval, margin_pixels[i]);
+    impl->sample_rect_valid[i] = view3d_depth_pick_rect_clamp(region, impl->sample_rects[i]);
+    if (impl->sample_rect_valid[i]) {
+      impl->request_rect = impl->sample_rects[i];
+      has_request_rect = true;
+    }
+  }
+  if (!has_request_rect) {
+    MEM_delete(impl);
+    return false;
+  }
+
+  const size_t width = size_t(BLI_rcti_size_x(&impl->request_rect));
+  const size_t height = size_t(BLI_rcti_size_y(&impl->request_rect));
+  if (width > std::numeric_limits<size_t>::max() / height ||
+      width * height > std::numeric_limits<size_t>::max() / sizeof(float))
+  {
+    MEM_delete(impl);
+    return false;
+  }
+  impl->expected_size = width * height * sizeof(float);
+
+  GPUViewport *viewport = WM_draw_region_get_viewport(region);
+  gpu::Texture *depth_tx = viewport != nullptr ? GPU_viewport_depth_texture(viewport) : nullptr;
+  if (depth_tx == nullptr) {
+    MEM_delete(impl);
+    return false;
+  }
+
+  gpu::FrameBuffer *depth_read_fb = nullptr;
+  GPU_framebuffer_ensure_config(&depth_read_fb,
+                                {
+                                    GPU_ATTACHMENT_TEXTURE(depth_tx),
+                                    GPU_ATTACHMENT_NONE,
+                                });
+  GPU_framebuffer_bind(depth_read_fb);
+  impl->readback = GPU_framebuffer_read_depth_async(depth_read_fb,
+                                                    impl->request_rect.xmin,
+                                                    impl->request_rect.ymin,
+                                                    int(width),
+                                                    int(height),
+                                                    GPU_DATA_FLOAT);
+  GPU_framebuffer_restore();
+  GPU_framebuffer_free(depth_read_fb);
+
+  impl->readback_state = ReadbackState::Pending;
+  impl_ = impl;
+  return state() != ReadbackState::Failed;
+}
+
+ViewportDepthPickSession::ReadbackState ViewportDepthPickSession::state()
+{
+  if (impl_ == nullptr || impl_->readback_state != ReadbackState::Pending) {
+    return impl_ != nullptr ? impl_->readback_state : ReadbackState::Failed;
+  }
+
+  const eGPUReadbackStatus status = GPU_readback_status(impl_->readback);
+  if (status == GPU_READBACK_PENDING) {
+    return impl_->readback_state;
+  }
+  if (status != GPU_READBACK_READY || GPU_readback_size(impl_->readback) != impl_->expected_size) {
+    GPU_readback_cancel(impl_->readback);
+    impl_->readback_state = ReadbackState::Failed;
+    return impl_->readback_state;
+  }
+
+  const size_t pixel_count = impl_->expected_size / sizeof(float);
+  impl_->depths.resize(pixel_count);
+  if (!GPU_readback_consume(
+          impl_->readback, impl_->depths.data(), impl_->depths.size() * sizeof(float)))
+  {
+    GPU_readback_cancel(impl_->readback);
+    impl_->depths.clear();
+    impl_->readback_state = ReadbackState::Failed;
+    return impl_->readback_state;
+  }
+
+  const int request_width = BLI_rcti_size_x(&impl_->request_rect);
+  for (int sample_index = 0; sample_index < ARRAY_SIZE(impl_->sample_rects); sample_index++) {
+    if (!impl_->sample_rect_valid[sample_index]) {
+      continue;
+    }
+    const rcti &sample_rect = impl_->sample_rects[sample_index];
+    float nearest = 1.0f;
+    for (int y = sample_rect.ymin; y < sample_rect.ymax; y++) {
+      for (int x = sample_rect.xmin; x < sample_rect.xmax; x++) {
+        const size_t index = size_t(y - impl_->request_rect.ymin) * size_t(request_width) +
+                             size_t(x - impl_->request_rect.xmin);
+        const float depth = impl_->depths[index];
+        if (depth > 0.0f && depth < nearest) {
+          nearest = depth;
+        }
+      }
+    }
+    if (nearest < 1.0f) {
+      impl_->depth = nearest;
+      break;
+    }
+  }
+  impl_->readback_state = ReadbackState::Ready;
+  return impl_->readback_state;
+}
+
+bool ViewportDepthPickSession::sample(ARegion *region, float r_world_location[3])
+{
+  if (state() != ReadbackState::Ready || region == nullptr || r_world_location == nullptr ||
+      region != impl_->region || region->regiondata != impl_->region_view ||
+      region->winx != impl_->region_size[0] || region->winy != impl_->region_size[1] ||
+      !equals_m4m4(static_cast<RegionView3D *>(region->regiondata)->viewinv, impl_->viewinv) ||
+      !equals_m4m4(static_cast<RegionView3D *>(region->regiondata)->winmat, impl_->winmat))
+  {
+    if (impl_ != nullptr && impl_->readback_state == ReadbackState::Ready) {
+      impl_->readback_state = ReadbackState::Failed;
+      impl_->depths.clear();
+    }
+    return false;
+  }
+  if (impl_->depth == FLT_MAX) {
+    return false;
+  }
+
+  return ED_view3d_unproject_v3(region,
+                                float(impl_->mval[0]) + 0.5f,
+                                float(impl_->mval[1]) + 0.5f,
+                                impl_->depth,
+                                r_world_location);
+}
