+static wmOperatorStatus grease_pencil_primitive_depth_cache_poll(bContext *C,
+                                                                 wmOperator *op,
+                                                                 const wmEvent *event)
+{
+  PrimitiveToolOperation &ptd = *static_cast<PrimitiveToolOperation *>(op->customdata);
+  if (!ptd.depth_cache_pending ||
+      !grease_pencil_primitive_depth_cache_context_matches(C, ptd))
+  {
+    BKE_report(op->reports,
+               RPT_ERROR,
+               "Viewport changed while waiting for Grease Pencil primitive depth");
+    grease_pencil_primitive_exit(C, op, true);
+    return OPERATOR_CANCELLED;
+  }
+
+  if (ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE) ||
+      (event->type == EVT_MODAL_MAP && event->val == int(ModalKeyMode::Cancel)))
+  {
+    grease_pencil_primitive_exit(C, op, true);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type != TIMER || event->customdata != ptd.depth_cache_timer) {
+    if (event->type == TIMER) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (!grease_pencil_primitive_depth_cache_event_push(ptd, event)) {
+      BKE_report(op->reports,
+                 RPT_ERROR,
+                 "Grease Pencil primitive depth event queue exceeded its safe bound");
+      grease_pencil_primitive_exit(C, op, true);
+      return OPERATOR_CANCELLED;
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++ptd.depth_cache_tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for Grease Pencil primitive depth");
+    grease_pencil_primitive_exit(C, op, true);
+    return OPERATOR_CANCELLED;
+  }
+
+  const DrawingPlacementDepthCacheState state = ptd.placement.poll_viewport_depths(ptd.region);
+  if (state == DrawingPlacementDepthCacheState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == DrawingPlacementDepthCacheState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Grease Pencil primitive depth readback failed");
+    grease_pencil_primitive_exit(C, op, true);
+    return OPERATOR_CANCELLED;
+  }
+
+  ptd.depth_cache_pending = false;
+  grease_pencil_primitive_depth_cache_timer_remove(ptd);
+  Vector<wmEvent> queued_events = std::move(ptd.depth_cache_events);
+  grease_pencil_primitive_invoke_ready(C, op, ptd);
+  for (wmEvent &queued_event : queued_events) {
+    const wmOperatorStatus result = grease_pencil_primitive_modal_dispatch(
+        C, op, &queued_event);
+    if (result != OPERATOR_RUNNING_MODAL) {
+      return result;
+    }
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+
+/* Modal handler: isolate the pre-projection continuation from initialized primitive state. */
+static wmOperatorStatus grease_pencil_primitive_modal(bContext *C,
+                                                      wmOperator *op,
+                                                      const wmEvent *event)
+{
+  PrimitiveToolOperation &ptd = *static_cast<PrimitiveToolOperation *>(op->customdata);
+  if (ptd.depth_cache_pending) {
+    return grease_pencil_primitive_depth_cache_poll(C, op, event);
+  }
+  return grease_pencil_primitive_modal_dispatch(C, op, event);
+}
