+  WGPUContext *context = static_cast<WGPUContext *>(Context::get());
+  webgpu::WGPUTexture *webgpu_texture = static_cast<webgpu::WGPUTexture *>(texture);
+  const bool renderable =
+      context->device_get().HasFeature(wgpu::FeatureName::RG11B10UfloatRenderable);
+  const wgpu::TextureUsage device_usage =
+      webgpu_texture->subresource_range().texture.GetUsage();
+  EXPECT_EQ(bool(device_usage & wgpu::TextureUsage::RenderAttachment), renderable);
+  EXPECT_TRUE(bool(device_usage & wgpu::TextureUsage::TextureBinding));
+
+  if (!renderable) {
+    gpu::Texture *unsupported_attachment = GPU_texture_create_2d(__func__,
+                                                                  2,
+                                                                  2,
+                                                                  1,
+                                                                  TextureFormat::UFLOAT_11_11_10,
+                                                                  usage |
+                                                                      GPU_TEXTURE_USAGE_ATTACHMENT,
+                                                                  nullptr);
+    EXPECT_EQ(unsupported_attachment, nullptr);
+  }
+
+  /* With the optional feature this is a render clear; without it the packed
+   * WriteTexture fallback must remain a legal, numerically equivalent clear. */
+  GPU_texture_clear(texture, GPU_DATA_FLOAT, float4(0.25f, 0.5f, 0.75f, 1.0f));
+  float *values = static_cast<float *>(GPU_texture_read(texture, GPU_DATA_FLOAT, 0));
+  ASSERT_NE(values, nullptr);
