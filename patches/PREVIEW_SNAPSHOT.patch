+static WGPUContext *active_context()
+{
+  return static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
+}
+
+/** The render-pipeline cache. TODO: move to WGPUContext once its ownership of
+ * device-lifetime caches is wired (lane A file); a function-static pool is correct
+ * for the single-device native test harness. */
+static webgpu::WGPUPipelinePool &pipeline_pool()
+{
+  static webgpu::WGPUPipelinePool pool;
+  return pool;
+}
+
+static wgpu::ComputePipeline triangle_fan_index_pipeline(const wgpu::Instance &instance,
+                                                         const wgpu::Device &device)
+{
+  /* The application owns one WebGPU device. Match the render-pipeline pool's
+   * device-lifetime assumption and compile this small topology kernel once. */
+  static webgpu::ScopedHandleCache<uint8_t, wgpu::ComputePipeline> pipeline_cache;
+  static constexpr const char *source = R"(
+struct Params {
+  first : u32,
+  count : u32,
+  restart : u32,
+  max_count : u32,
+}
+@group(0) @binding(0) var<storage, read> source_indices : array<u32>;
+@group(0) @binding(1) var<storage, read_write> output_indices : array<u32>;
+@group(0) @binding(2) var<uniform> params : Params;
+
+fn load_index(position : u32) -> u32 {
+  if (params.restart == 0xffffu) {
+    let packed = source_indices[position >> 1u];
+    return select(packed & 0xffffu, packed >> 16u, (position & 1u) != 0u);
+  }
+  return source_indices[position];
+}
+
+@compute @workgroup_size(1)
+fn main() {
+  var output_count = 0u;
+  var fan_count = 0u;
+  var fan_first = 0u;
+  var fan_previous = 0u;
+  for (var i = 0u; i < params.count; i++) {
+    let index = load_index(params.first + i);
+    if (index == params.restart) {
+      fan_count = 0u;
+    }
+    else if (fan_count == 0u) {
+      fan_first = index;
+      fan_count = 1u;
+    }
+    else if (fan_count == 1u) {
+      fan_previous = index;
+      fan_count = 2u;
+    }
+    else {
+      output_indices[output_count] = fan_first;
+      output_indices[output_count + 1u] = fan_previous;
+      output_indices[output_count + 2u] = index;
+      output_indices[output_count + 3u] = 0xffffffffu;
+      output_count += 4u;
+      fan_previous = index;
+      fan_count += 1u;
+    }
+  }
+  /* Restart isolates each three-index strip. Unused capacity is restart-only,
+   * producing neither primitives nor vertex shader invocations. */
+  while (output_count < params.max_count) {
+    output_indices[output_count] = 0xffffffffu;
+    output_count += 1u;
+  }
+}
+)";
+  return pipeline_cache.get_or_create(
+      instance, device, uint8_t(0), "indexed triangle-fan compute-pipeline creation", [&]() {
+        wgpu::ShaderSourceWGSL wgsl = {};
+        wgsl.code = source;
+        wgpu::ShaderModuleDescriptor shader_descriptor = {};
+        shader_descriptor.nextInChain = &wgsl;
+        wgpu::ShaderModule module = device.CreateShaderModule(&shader_descriptor);
+        if (module == nullptr) {
+          return wgpu::ComputePipeline{};
+        }
+        wgpu::ComputePipelineDescriptor pipeline_descriptor = {};
+        pipeline_descriptor.compute.module = module;
+        pipeline_descriptor.compute.entryPoint = "main";
+        return device.CreateComputePipeline(&pipeline_descriptor);
+      });
+}
+
+static bool expand_indexed_triangle_fan(WGPUContext &ctx,
+                                        WGPUIndexBuffer &source,
+                                        uint32_t first,
+                                        uint32_t count,
+                                        webgpu::Buffer &r_output,
+                                        uint32_t &r_output_count)
+{
+  if (!source.buffer().valid() || count < 3) {
+    return false;
+  }
+  const uint64_t max_output_count = uint64_t(count - 2) * 4;
+  const uint64_t source_first = uint64_t(source.index_start_get()) + first;
+  const uint64_t source_last = source_first + count - 1;
+  const uint64_t source_byte_end = (source_last + 1) * (source.is_32bit() ? 4 : 2);
+  if (max_output_count > UINT32_MAX ||
+      max_output_count > SIZE_MAX / sizeof(uint32_t) || source_last > UINT32_MAX ||
+      source_byte_end > source.buffer().size())
+  {
+    return false;
+  }
+  r_output_count = uint32_t(max_output_count);
+  if (!r_output.create_transient(ctx.instance_get(),
+                                 ctx.device_get(),
+                                 ctx.queue_scheduler_get(),
+                                 webgpu::BufferKind::Index,
+                                 webgpu::UsageType::DeviceOnly,
+                                 size_t(max_output_count) * sizeof(uint32_t),
+                                 nullptr,
+                                 false,
+                                 "indexed triangle-fan output buffer"))
+  {
+    return false;
+  }
+  const uint32_t params[4] = {uint32_t(source_first),
+                              count,
+                              source.is_32bit() ? 0xffffffffu : 0xffffu,
+                              r_output_count};
+  webgpu::Buffer params_buffer;
+  if (!params_buffer.create_transient(ctx.instance_get(),
+                                      ctx.device_get(),
+                                      ctx.queue_scheduler_get(),
+                                      webgpu::BufferKind::Uniform,
+                                      webgpu::UsageType::Static,
+                                      sizeof(params),
+                                      params,
+                                      false,
+                                      "indexed triangle-fan parameters"))
+  {
+    return false;
+  }
+
+  const wgpu::ComputePipeline pipeline = triangle_fan_index_pipeline(ctx.instance_get(),
+                                                                     ctx.device_get());
+  if (pipeline == nullptr) {
+    return false;
+  }
+  wgpu::BindGroupEntry entries[3] = {};
+  entries[0].binding = 0;
+  entries[0].buffer = source.buffer().handle();
+  entries[0].size = source.buffer().size();
+  entries[1].binding = 1;
+  entries[1].buffer = r_output.handle();
+  entries[1].size = size_t(r_output_count) * sizeof(uint32_t);
+  entries[2].binding = 2;
+  entries[2].buffer = params_buffer.handle();
+  entries[2].size = sizeof(params);
+  wgpu::BindGroupDescriptor group_descriptor = {};
+  group_descriptor.layout = pipeline.GetBindGroupLayout(0);
+  group_descriptor.entryCount = 3;
+  group_descriptor.entries = entries;
+  const wgpu::BindGroup group = webgpu::transient_resource_create_scoped(
+      ctx.instance_get(),
+      ctx.device_get(),
+      ctx.queue_scheduler_get(),
+      "indexed triangle-fan bind group",
+      [&]() { return ctx.device_get().CreateBindGroup(&group_descriptor); },
+      [](bool) {});
+  if (group == nullptr) {
+    return false;
+  }
+
+  webgpu::command_pass_encode_submit_scoped(
+      ctx.instance_get(),
+      ctx.device_get(),
+      ctx.queue_get(),
+      ctx.queue_scheduler_get(),
+      "indexed triangle-fan expansion",
+      [](auto &encoder) { return encoder.BeginComputePass(); },
+      [&](auto &pass) {
+        pass.SetPipeline(pipeline);
+        pass.SetBindGroup(0, group);
+        pass.DispatchWorkgroups(1);
+      },
+      [](bool) {});
+  return true;
+}
+
+void WGPUBatch::draw(int vertex_first, int vertex_count, int instance_first, int instance_count)
+{
+  webgpu::DirectDrawPlan draw_parameters;
+  if (!webgpu::direct_draw_plan(
+          vertex_first, vertex_count, instance_first, instance_count, draw_parameters))
+  {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  Context *base_ctx = Context::get();
+  WGPUFrameBuffer *fb = static_cast<WGPUFrameBuffer *>(base_ctx->active_fb);
+  WGPUShader *shader = static_cast<WGPUShader *>(base_ctx->shader);
+  if (fb == nullptr || shader == nullptr) {
+    return;
+  }
+  /* Browser module validation can still be pending after finalize(). Retry from the retained
+   * WGSL, but never expose a provisional/error module to pipeline creation. */
+  if (!shader->ensure_shader_modules(ctx->instance_get(), ctx->device_get()) ||
+      shader->vertex_module() == nullptr || shader->fragment_module() == nullptr)
+  {
+    return;
+  }
+
+  /* Collect ALL vertex buffers (a Blender mesh/overlay batch spreads a shader's inputs
+   * across several verts[] slots) and upload each. Recorded by verts[] slot so the plan's
+   * vbo_index maps straight back for per-slot binding below. */
+  const GPUVertFormat *formats[GPU_BATCH_VBO_MAX_LEN] = {};
+  int64_t vlens[GPU_BATCH_VBO_MAX_LEN] = {};
+  WGPUVertexBuffer *wvbos[GPU_BATCH_VBO_MAX_LEN] = {};
+  int formats_len = 0;
+  for (int i = 0; i < GPU_BATCH_VBO_MAX_LEN; i++) {
+    if (verts[i] != nullptr) {
+      verts[i]->upload();
+      wvbos[i] = unwrap(verts[i]);
+      formats[i] = &wvbos[i]->format;
+      vlens[i] = int64_t(wvbos[i]->vertex_len);
+      formats_len = i + 1;
+    }
+  }
+  /* Ensure the index buffer is on the GPU before it is bound (mirrors
+   * vk_batch.cc:34 and mtl_batch.mm:253). The frontend transfers index data to the
+   * IndexBuf and defers the upload to "first use"; unlike Vulkan/Metal, nothing in
+   * the WebGPU draw path forced that upload, so an indexed batch could reach the
+   * encoder with an un-uploaded (invalid) buffer -- draw() then skipped DrawIndexed
+   * entirely and multi_draw_indirect() fell back to a NON-indexed DrawIndirect that
+   * read vertices in raw order (the r28 crumpled-mesh / missing-solid / missing
+   * nav-gizmo family). upload_data() is a no-op once the buffer is valid. */
+  if (elem != nullptr) {
+    elem->upload_data();
+  }
+
+  /* WebGPU has no triangle-fan topology. Direct batch draws preserve fan semantics
+   * with a transient UInt32 index buffer. Indexed fans become isolated three-index
+   * strips separated by restart markers; non-indexed fans become triangle lists.
+   * GPU expansion covers U16 packing, U32, restart-delimited fans,
+   * shared/device-built buffers, and subranges. */
+  WGPUIndexBuffer *wibo = (elem != nullptr) ? unwrap(elem) : nullptr;
+  const webgpu::IndexBindingPlan index_binding =
+      elem != nullptr ?
+          webgpu::index_binding_plan(*elem, webgpu::IndexBindingMode::Direct) :
+          webgpu::IndexBindingPlan{};
+  const bool emulate_triangle_fan = prim_type == GPU_PRIM_TRI_FAN;
+  std::vector<uint32_t> fan_indices;
+  webgpu::Buffer fan_index_buffer;
+  uint32_t fan_index_count = 0;
+  if (emulate_triangle_fan) {
+    if (draw_parameters.vertex_count < 3) {
+      return;
+    }
+    if (wibo != nullptr) {
+      if (uint64_t(draw_parameters.vertex_first) + draw_parameters.vertex_count >
+          elem->index_len_get())
+      {
+        return;
+      }
+      if (!expand_indexed_triangle_fan(*ctx,
+                                       *wibo,
+                                       draw_parameters.vertex_first,
+                                       draw_parameters.vertex_count,
+                                       fan_index_buffer,
+                                       fan_index_count))
+      {
+        return;
+      }
+    }
+    else {
+      const uint64_t fan_count = uint64_t(draw_parameters.vertex_count - 2) * 3;
+      const uint64_t vertex_last =
+          uint64_t(draw_parameters.vertex_first) + draw_parameters.vertex_count - 1;
+      if (fan_count > UINT32_MAX || fan_count > SIZE_MAX / sizeof(uint32_t) ||
+          vertex_last > UINT32_MAX ||
+          (wvbos[0] != nullptr && vertex_last >= uint64_t(wvbos[0]->vertex_len)))
+      {
+        return;
+      }
+      fan_indices.reserve(size_t(draw_parameters.vertex_count - 2) * 3);
+      const uint32_t base = draw_parameters.vertex_first;
+      for (uint32_t i = 1; i + 1 < draw_parameters.vertex_count; i++) {
+        fan_indices.push_back(base);
+        fan_indices.push_back(base + i);
+        fan_indices.push_back(base + i + 1);
+      }
+      fan_index_count = uint32_t(fan_indices.size());
+      if (!fan_index_buffer.create_transient(ctx->instance_get(),
+                                             ctx->device_get(),
+                                             ctx->queue_scheduler_get(),
+                                             webgpu::BufferKind::Index,
+                                             webgpu::UsageType::Static,
+                                             fan_indices.size() * sizeof(uint32_t),
+                                             fan_indices.data(),
+                                             false,
+                                             "triangle-fan index buffer"))
+      {
+        return;
+      }
+    }
+  }
+
+  wgpu::Buffer index_buffer_candidate;
+  if (emulate_triangle_fan) {
+    index_buffer_candidate = fan_index_buffer.handle();
+  }
+  else if (wibo != nullptr) {
+    index_buffer_candidate = wibo->buffer().handle();
+  }
+  wgpu::Buffer index_buffer;
+  if (!webgpu::index_buffer_handle_resolve_if_required(
+          emulate_triangle_fan || elem != nullptr, std::move(index_buffer_candidate), index_buffer))
+  {
+    return;
+  }
+
+  /* Assemble the pipeline key from the shader, geometry, fixed-function state, and
+   * the bound framebuffer's target formats. */
+  webgpu::PipelineInfo info(shader, shader->pipeline_cache_identity());
+  if (const shader::SpecializationConstants *constants =
+          shader->bound_specialization_constants())
+  {
+    info.specialization_values.assign(constants->values.begin(), constants->values.end());
+  }
+  for (int i = 0; i < formats_len; i++) {
+    info.vertex_formats[i] = formats[i];
+    info.vertex_lens[i] = vlens[i];
+  }
+  info.vertex_formats_len = formats_len;
+  if (base_ctx->state_manager != nullptr) {
+    info.state = base_ctx->state_manager->state;
+    info.mutable_state = base_ctx->state_manager->mutable_state;
+  }
+  info.empty_render_attachment = fb->target_formats(
+      info.color_formats, info.color_count, info.depth_format);
+  if (info.color_count == 0 && info.depth_format == wgpu::TextureFormat::Undefined) {
+    return;
+  }
+  info.prim_type = (emulate_triangle_fan && wibo != nullptr) ? GPU_PRIM_TRI_STRIP :
+                   emulate_triangle_fan                      ? GPU_PRIM_TRIS :
+                                                               prim_type;
+  const wgpu::IndexFormat draw_index_format =
+      (emulate_triangle_fan && wibo != nullptr) ? wgpu::IndexFormat::Uint32 :
+      (wibo != nullptr && index_buffer != nullptr) ? wibo->index_format() :
+                                                    wgpu::IndexFormat::Undefined;
+  info.strip_index_format = webgpu::to_wgpu_strip_index_format(info.prim_type,
+                                                               draw_index_format);
+  info.flip_y = !ctx->is_window_backbuffer(fb);
+
+
+  wgpu::RenderPipeline pipeline = pipeline_pool().get(
+      ctx->instance_get(), ctx->device_get(), info);
+  if (pipeline == nullptr) {
+    return;
+  }
+
+  /* The identical plan the pipeline layout was built from, used to bind each slot's
+   * buffer (real VBO by index, or the shared dummy for a filled-in location). */
+  const webgpu::VertexPlan vplan = webgpu::build_vertex_plan(
+      info.vertex_formats, info.vertex_lens, info.vertex_formats_len, *shader);
+  std::vector<wgpu::Buffer> vertex_buffers;
+  if (!webgpu::vertex_buffer_handles_resolve_if_valid(
+          vplan,
+          [&](const webgpu::VertexBinding &binding) -> wgpu::Buffer {
+            if (binding.is_dummy) {
+              return ctx->dummy_vertex_buffer();
+            }
+            if (binding.vbo_index >= 0 && binding.vbo_index < GPU_BATCH_VBO_MAX_LEN &&
+                wvbos[binding.vbo_index] != nullptr &&
+                wvbos[binding.vbo_index]->buffer().valid())
+            {
+              return wvbos[binding.vbo_index]->buffer().handle();
+            }
+            return nullptr;
+          },
+          vertex_buffers))
+  {
+    return;
+  }
+  auto bind_vertex_buffers = [&](wgpu::RenderPassEncoder &rp) {
+    for (uint32_t s = 0; s < vplan.size(); s++) {
+      const webgpu::VertexBinding &b = vplan[s];
+      rp.SetVertexBuffer(s, vertex_buffers[s], b.buffer_offset);
+    }
+  };
+
+  /* Multi-viewport / layered emulation (M3.F7). WebGPU has no viewport array and no
+   * vertex-stage gl_Layer / gl_ViewportIndex routing, so render one pass per (array
+   * layer, viewport rect): a single-layer attachment view selects the layer, a
+   * per-viewport SetViewport + SetScissorRect selects the rect, and the shader discards
+   * every primitive whose vertex-carried gpu_Layer / gpu_ViewportIndex != this pass's
+   * (layer, viewport) — supplied in the _wgpu_mv UBO. Each 1x1 viewport therefore
+   * receives exactly the primitive routed to it, matching the GL/Vulkan reference. This
+   * path only runs when GPU_framebuffer_multi_viewports_set() is active (the gpu suite's
+   * framebuffer_multi_viewport test); every other draw takes the single-pass path below. */
+  if (fb->is_multi_viewport()) {
+    wgpu::Device device = ctx->device_get();
+    const int layers = fb->attachment_layer_count();
+    const int2 framebuffer_size = fb->size_get();
+    wgpu::Limits limits = {};
+    if (!device.GetLimits(&limits)) {
+      return;
+    }
+
+    /* Per-pass (layer, viewport) UBO: std140 { int; int; } padded to 16 bytes. Reused
+     * across passes — a queue WriteBuffer is ordered before the Submit that follows it,
+     * so each pass reads its own value before the next overwrite. */
+    wgpu::Buffer mv_buf;
+    if (!webgpu::multi_viewport_uniform_buffer_create(device, mv_buf)) {
+      return;
+    }
+
+    if (shader->push_constants_survive_compilation()) {
+      shader->push_constants_flush();
+    }
+
+    std::vector<wgpu::BindGroupEntry> entries;
+    wgpu::BindGroupEntry mv_entry = {};
+    mv_entry.binding = shader->multi_viewport_binding();
+    mv_entry.buffer = mv_buf;
+    mv_entry.offset = 0;
+    mv_entry.size = 16;
+    entries.push_back(mv_entry);
+    if (shader->push_constants_survive_compilation() &&
+        shader->push_constants_buffer().valid())
+    {
+      wgpu::BindGroupEntry pc = {};
+      pc.binding = shader->push_constants_binding();
+      pc.buffer = shader->push_constants_buffer().handle();
+      pc.offset = 0;
+      pc.size = shader->push_constants_buffer().size();
+      entries.push_back(pc);
+    }
+    /* A multi-viewport draw changes only the pass-state UBO; it still needs the shader's
+     * ordinary UBO/SSBO/texture/image resources. Validate the complete set before the first
+     * queue write, encoder, or render pass. */
+    ctx->append_resource_bind_entries(shader, entries);
+    if (!shader->bind_group_entries_complete(entries)) {
+      return;
+    }
+
+    for (int layer = 0; layer < layers; layer++) {
+      for (int vp = 0; vp < GPU_MAX_VIEWPORTS; vp++) {
+        int rect[4];
+        fb->get_viewport(vp, rect);
+        webgpu::ViewportScissorPlan viewport;
+        if (!webgpu::viewport_scissor_plan(rect[0],
+                                            rect[1],
+                                            rect[2],
+                                            rect[3],
+                                            framebuffer_size.x,
+                                            framebuffer_size.y,
+                                            limits.maxTextureDimension2D,
+                                            viewport))
+        {
+          continue; /* unused, fully clipped, or device-invalid viewport slot */
+        }
+        const int32_t mv_vals[2] = {layer, vp};
+        webgpu::queue_write_buffer_scoped(ctx->instance_get(),
+                                          device,
+                                          ctx->queue_get(),
+                                          ctx->queue_scheduler_get(),
+                                          mv_buf,
+                                          0,
+                                          mv_vals,
+                                          sizeof(mv_vals),
+                                          "direct multi-viewport uniform upload",
+                                          [](bool) {});
+
+        const auto load_action = fb->load_action_transaction();
+        std::function<void(bool)> load_action_completion;
+        if (!fb->load_action_transaction_prepare(load_action, load_action_completion)) {
+          return;
+        }
+        webgpu::command_encode_submit_scoped(
+            ctx->instance_get(),
+            device,
+            ctx->queue_get(),
+            ctx->queue_scheduler_get(),
+            "direct multi-viewport draw",
+            [&](auto &mv_enc) {
+              wgpu::RenderPassEncoder mv_pass = fb->begin_load_pass(
+                  mv_enc, load_action, layer);
+              if (mv_pass == nullptr) {
+                return false;
+              }
+              mv_pass.SetPipeline(pipeline);
+              ctx->apply_stencil_reference(mv_pass);
+              mv_pass.SetViewport(float(viewport.viewport_x),
+                                  float(viewport.viewport_y),
+                                  float(viewport.viewport_width),
+                                  float(viewport.viewport_height),
+                                  0.0f,
+                                  1.0f);
+              mv_pass.SetScissorRect(viewport.scissor_x,
+                                     viewport.scissor_y,
+                                     viewport.scissor_width,
+                                     viewport.scissor_height);
+              bind_vertex_buffers(mv_pass);
+
+              const wgpu::BindGroupLayout mv_bgl = shader->has_explicit_layout() ?
+                                                       shader->explicit_bind_group_layout() :
+                                                       pipeline.GetBindGroupLayout(0);
+              wgpu::BindGroup mv_bind_group;
+              if (!webgpu::transient_handle_publish_if_valid(
+                      ctx->create_bind_group_checked(mv_bgl, entries), mv_bind_group))
+              {
+                return false;
+              }
+              mv_pass.SetBindGroup(0, mv_bind_group);
+
+              if (emulate_triangle_fan) {
+                mv_pass.SetIndexBuffer(index_buffer, wgpu::IndexFormat::Uint32, 0);
+                mv_pass.DrawIndexed(fan_index_count,
+                                    draw_parameters.instance_count,
+                                    0,
+                                    wibo != nullptr ? index_binding.base_vertex : 0,
+                                    draw_parameters.instance_first);
+              }
+              else if (elem != nullptr) {
+                mv_pass.SetIndexBuffer(index_buffer,
+                                       wibo->index_format(),
+                                       index_binding.byte_offset);
+                mv_pass.DrawIndexed(draw_parameters.vertex_count,
+                                    draw_parameters.instance_count,
+                                    draw_parameters.vertex_first,
+                                    index_binding.base_vertex,
+                                    draw_parameters.instance_first);
+              }
+              else {
+                mv_pass.Draw(draw_parameters.vertex_count,
+                             draw_parameters.instance_count,
+                             draw_parameters.vertex_first,
+                             draw_parameters.instance_first);
+              }
+              mv_pass.End();
+              return true;
+            },
+            [load_action_completion](const bool valid) { load_action_completion(valid); });
+      }
+    }
+    return;
+  }
+
+  std::vector<wgpu::BindGroupEntry> entries;
+  if (shader->push_constants_survive_compilation()) {
+    shader->push_constants_flush();
+    const webgpu::Buffer &pc = shader->push_constants_buffer();
+    if (pc.valid()) {
+      wgpu::BindGroupEntry entry = {};
+      entry.binding = shader->push_constants_binding();
+      entry.buffer = pc.handle();
+      entry.offset = 0;
+      entry.size = pc.size();
+      entries.push_back(entry);
+    }
+  }
+  ctx->append_resource_bind_entries(shader, entries);
+  if (!shader->bind_group_entries_complete(entries)) {
+    return;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  const auto load_action = fb->load_action_transaction();
+  std::function<void(bool)> load_action_completion;
+  if (!fb->load_action_transaction_prepare(load_action, load_action_completion)) {
+    return;
+  }
+  webgpu::command_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "direct batch draw",
+      [&](auto &enc) {
+        wgpu::RenderPassEncoder pass = fb->begin_load_pass(enc, load_action);
+        if (pass == nullptr) {
+          return false;
+        }
+        pass.SetPipeline(pipeline);
+        ctx->apply_stencil_reference(pass);
+        bind_vertex_buffers(pass);
+
+        if (!entries.empty()) {
+          const wgpu::BindGroupLayout bgl = shader->has_explicit_layout() ?
+                                                shader->explicit_bind_group_layout() :
+                                                pipeline.GetBindGroupLayout(0);
+          wgpu::BindGroup bind_group;
+          if (!webgpu::transient_handle_publish_if_valid(
+                  ctx->create_bind_group_checked(bgl, entries), bind_group))
+          {
+            return false;
+          }
+          pass.SetBindGroup(0, bind_group);
+        }
+
+        if (emulate_triangle_fan) {
+          pass.SetIndexBuffer(index_buffer, wgpu::IndexFormat::Uint32, 0);
+          pass.DrawIndexed(fan_index_count,
+                           draw_parameters.instance_count,
+                           0,
+                           wibo != nullptr ? index_binding.base_vertex : 0,
+                           draw_parameters.instance_first);
+        }
+        else if (elem != nullptr) {
+          pass.SetIndexBuffer(index_buffer, wibo->index_format(), index_binding.byte_offset);
+          pass.DrawIndexed(draw_parameters.vertex_count,
+                           draw_parameters.instance_count,
+                           draw_parameters.vertex_first,
+                           index_binding.base_vertex,
+                           draw_parameters.instance_first);
+        }
+        else {
+          pass.Draw(draw_parameters.vertex_count,
+                    draw_parameters.instance_count,
+                    draw_parameters.vertex_first,
+                    draw_parameters.instance_first);
+        }
+        pass.End();
+        return true;
+      },
+      [load_action_completion](const bool valid) { load_action_completion(valid); });
+}
+
+void WGPUBatch::draw_indirect(StorageBuf *indirect_buf, intptr_t offset)
+{
+  multi_draw_indirect(indirect_buf, 1, offset, 0);
+}
+
+/* Indirect draw. WebGPU has native DrawIndirect / DrawIndexedIndirect reading the
+ * draw arguments from a GPU buffer (the StorageBuf carries the Indirect usage bit —
+ * wgpu_buffer.cc). WebGPU exposes no core multi-draw, so `count` draws are recorded
+ * in a loop, each reading its argument block at offset + i*stride (matches the
+ * frontend's contiguous GPUIndirect layout). Mirrors VKBatch::multi_draw_indirect. */
+void WGPUBatch::multi_draw_indirect(StorageBuf *indirect_buf,
+                                    int count,
+                                    intptr_t offset,
+                                    intptr_t stride)
+{
+  if (indirect_buf == nullptr || count <= 0) {
+    return;
+  }
+  if (prim_type == GPU_PRIM_TRI_FAN) {
+    /* The fan vertex/index count resides in GPU indirect arguments, so the CPU
+     * cannot build a faithful triangle-list expansion here. No production fan
+     * batch uses indirect drawing at the pinned tree; reject instead of silently
+     * selecting TriangleStrip. */
+    BLI_assert_msg(false, "WebGPU indirect triangle-fan draws are unsupported");
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  Context *base_ctx = Context::get();
+  WGPUFrameBuffer *fb = static_cast<WGPUFrameBuffer *>(base_ctx->active_fb);
+  WGPUShader *shader = static_cast<WGPUShader *>(base_ctx->shader);
+  if (fb == nullptr || shader == nullptr) {
+    return;
+  }
+  if (!shader->ensure_shader_modules(ctx->instance_get(), ctx->device_get()) ||
+      shader->vertex_module() == nullptr || shader->fragment_module() == nullptr)
+  {
+    return;
+  }
+
+  WGPUStorageBuffer *indirect = static_cast<WGPUStorageBuffer *>(indirect_buf);
+  const webgpu::Buffer &indirect_gpu = indirect->buffer();
+  if (!indirect_gpu.valid()) {
+    return;
+  }
+
+  const GPUVertFormat *formats[GPU_BATCH_VBO_MAX_LEN] = {};
+  int64_t vlens[GPU_BATCH_VBO_MAX_LEN] = {};
+  WGPUVertexBuffer *wvbos[GPU_BATCH_VBO_MAX_LEN] = {};
+  int formats_len = 0;
+  for (int i = 0; i < GPU_BATCH_VBO_MAX_LEN; i++) {
+    if (verts[i] != nullptr) {
+      verts[i]->upload();
+      wvbos[i] = unwrap(verts[i]);
+      formats[i] = &wvbos[i]->format;
+      vlens[i] = int64_t(wvbos[i]->vertex_len);
+      formats_len = i + 1;
+    }
+  }
+  /* Ensure the index buffer is on the GPU before it is bound (see draw() above;
+   * mirrors vk_batch.cc:97). Without this a GPU-generated indirect batch fell back
+   * to a non-indexed DrawIndirect and drew vertices in raw order. */
+  if (elem != nullptr) {
+    elem->upload_data();
+  }
+  WGPUIndexBuffer *wibo = (elem != nullptr) ? unwrap(elem) : nullptr;
+  const bool indexed = elem != nullptr;
+  wgpu::Buffer index_buffer_candidate;
+  if (wibo != nullptr) {
+    index_buffer_candidate = wibo->buffer().handle();
+  }
+  wgpu::Buffer index_buffer;
+  if (!webgpu::index_buffer_handle_resolve_if_required(
+          indexed, std::move(index_buffer_candidate), index_buffer))
+  {
+    return;
+  }
+  const webgpu::IndexBindingPlan index_binding =
+      indexed ? webgpu::index_binding_plan(*elem, webgpu::IndexBindingMode::Indirect) :
+                webgpu::IndexBindingPlan{};
+  webgpu::IndirectDrawSpan indirect_span;
+  if (!webgpu::indirect_draw_span(count,
+                                   offset,
+                                   stride,
+                                   indexed,
+                                   indirect_gpu.size(),
+                                   indirect_span))
+  {
+    return;
+  }
+
+  webgpu::PipelineInfo info(shader, shader->pipeline_cache_identity());
+  if (const shader::SpecializationConstants *constants =
+          shader->bound_specialization_constants())
+  {
+    info.specialization_values.assign(constants->values.begin(), constants->values.end());
+  }
+  for (int i = 0; i < formats_len; i++) {
+    info.vertex_formats[i] = formats[i];
+    info.vertex_lens[i] = vlens[i];
+  }
+  info.vertex_formats_len = formats_len;
+  if (base_ctx->state_manager != nullptr) {
+    info.state = base_ctx->state_manager->state;
+    info.mutable_state = base_ctx->state_manager->mutable_state;
+  }
+  info.empty_render_attachment = fb->target_formats(
+      info.color_formats, info.color_count, info.depth_format);
+  if (info.color_count == 0 && info.depth_format == wgpu::TextureFormat::Undefined) {
+    return;
+  }
+  info.prim_type = prim_type;
+  info.strip_index_format = webgpu::to_wgpu_strip_index_format(
+      info.prim_type,
+      indexed ? wibo->index_format() : wgpu::IndexFormat::Undefined);
+  info.flip_y = !ctx->is_window_backbuffer(fb);
+
+  wgpu::RenderPipeline pipeline = pipeline_pool().get(
+      ctx->instance_get(), ctx->device_get(), info);
+  if (pipeline == nullptr) {
+    return;
+  }
+
+  const webgpu::VertexPlan vplan = webgpu::build_vertex_plan(
+      info.vertex_formats, info.vertex_lens, info.vertex_formats_len, *shader);
+
+  std::vector<wgpu::Buffer> vertex_buffers;
+  if (!webgpu::vertex_buffer_handles_resolve_if_valid(
+          vplan,
+          [&](const webgpu::VertexBinding &binding) -> wgpu::Buffer {
+            if (binding.is_dummy) {
+              return ctx->dummy_vertex_buffer();
+            }
+            if (binding.vbo_index >= 0 && binding.vbo_index < GPU_BATCH_VBO_MAX_LEN &&
+                wvbos[binding.vbo_index] != nullptr &&
+                wvbos[binding.vbo_index]->buffer().valid())
+            {
+              return wvbos[binding.vbo_index]->buffer().handle();
+            }
+            return nullptr;
+          },
+          vertex_buffers))
+  {
+    return;
+  }
+
+  auto bind_geometry = [&](wgpu::RenderPassEncoder &render_pass) {
+    for (uint32_t s = 0; s < vplan.size(); s++) {
+      const webgpu::VertexBinding &b = vplan[s];
+      render_pass.SetVertexBuffer(s, vertex_buffers[s], b.buffer_offset);
+    }
+    if (indexed) {
+      /* The GPU-generated DrawCommandIndexed already carries the absolute
+       * index_start_get() and index_base_get(). Bind the complete parent allocation
+       * so WebGPU does not apply the subrange start a second time. */
+      render_pass.SetIndexBuffer(index_buffer, wibo->index_format(), index_binding.byte_offset);
+    }
+  };
+
+  auto issue_indirect_draws = [&](wgpu::RenderPassEncoder &render_pass) {
+    for (int i = 0; i < count; i++) {
+      const uint64_t byte_offset = indirect_span.first_offset +
+                                   uint64_t(i) * indirect_span.command_stride;
+      if (indexed) {
+        render_pass.DrawIndexedIndirect(indirect_gpu.handle(), byte_offset);
+      }
+      else {
+        render_pass.DrawIndirect(indirect_gpu.handle(), byte_offset);
+      }
+    }
+  };
+
+  wgpu::Device device = ctx->device_get();
+
+  /* Keep indirect rendering in parity with draw(): VIEWPORT_INDEX shaders carry a
+   * codegen-injected `_wgpu_mv` UBO and the fragment wrapper discards primitives not
+   * routed to the current viewport. EEVEE shadow surfaces are indirect draws on a
+   * multi-viewport framebuffer. Omitting this branch both left that UBO unbound
+   * (14 entries supplied for the explicit 15-entry layout) and skipped the per-viewport
+   * routing needed to rasterize the shadow pages. */
+  if (fb->is_multi_viewport()) {
+    const int layers = fb->attachment_layer_count();
+    const int2 framebuffer_size = fb->size_get();
+    wgpu::Limits limits = {};
+    if (!device.GetLimits(&limits)) {
+      return;
+    }
+
+    wgpu::Buffer mv_buf;
+    if (!webgpu::multi_viewport_uniform_buffer_create(device, mv_buf)) {
+      return;
+    }
+
+    if (shader->push_constants_survive_compilation()) {
+      shader->push_constants_flush();
+    }
+
+    std::vector<wgpu::BindGroupEntry> entries;
+    wgpu::BindGroupEntry mv_entry = {};
+    mv_entry.binding = shader->multi_viewport_binding();
+    mv_entry.buffer = mv_buf;
+    mv_entry.offset = 0;
+    mv_entry.size = 16;
+    entries.push_back(mv_entry);
+    if (shader->push_constants_survive_compilation() &&
+        shader->push_constants_buffer().valid())
+    {
+      wgpu::BindGroupEntry pc = {};
+      pc.binding = shader->push_constants_binding();
+      pc.buffer = shader->push_constants_buffer().handle();
+      pc.offset = 0;
+      pc.size = shader->push_constants_buffer().size();
+      entries.push_back(pc);
+    }
+    ctx->append_resource_bind_entries(shader, entries);
+    if (!shader->bind_group_entries_complete(entries)) {
+      return;
+    }
+
+    for (int layer = 0; layer < layers; layer++) {
+      for (int vp = 0; vp < GPU_MAX_VIEWPORTS; vp++) {
+        int rect[4];
+        fb->get_viewport(vp, rect);
+        webgpu::ViewportScissorPlan viewport;
+        if (!webgpu::viewport_scissor_plan(rect[0],
+                                            rect[1],
+                                            rect[2],
+                                            rect[3],
+                                            framebuffer_size.x,
+                                            framebuffer_size.y,
+                                            limits.maxTextureDimension2D,
+                                            viewport))
+        {
+          continue;
+        }
+
+        const int32_t mv_vals[2] = {layer, vp};
+        webgpu::queue_write_buffer_scoped(ctx->instance_get(),
+                                          device,
+                                          ctx->queue_get(),
+                                          ctx->queue_scheduler_get(),
+                                          mv_buf,
+                                          0,
+                                          mv_vals,
+                                          sizeof(mv_vals),
+                                          "indirect multi-viewport uniform upload",
+                                          [](bool) {});
+
+        const auto load_action = fb->load_action_transaction();
+        std::function<void(bool)> load_action_completion;
+        if (!fb->load_action_transaction_prepare(load_action, load_action_completion)) {
+          return;
+        }
+        webgpu::command_encode_submit_scoped(
+            ctx->instance_get(),
+            device,
+            ctx->queue_get(),
+            ctx->queue_scheduler_get(),
+            "indirect multi-viewport draw",
+            [&](auto &mv_enc) {
+              wgpu::RenderPassEncoder mv_pass = fb->begin_load_pass(
+                  mv_enc, load_action, layer);
+              if (mv_pass == nullptr) {
+                return false;
+              }
+              mv_pass.SetPipeline(pipeline);
+              ctx->apply_stencil_reference(mv_pass);
+              mv_pass.SetViewport(float(viewport.viewport_x),
+                                  float(viewport.viewport_y),
+                                  float(viewport.viewport_width),
+                                  float(viewport.viewport_height),
+                                  0.0f,
+                                  1.0f);
+              mv_pass.SetScissorRect(viewport.scissor_x,
+                                     viewport.scissor_y,
+                                     viewport.scissor_width,
+                                     viewport.scissor_height);
+              bind_geometry(mv_pass);
+
+              const wgpu::BindGroupLayout mv_bgl = shader->has_explicit_layout() ?
+                                                       shader->explicit_bind_group_layout() :
+                                                       pipeline.GetBindGroupLayout(0);
+              wgpu::BindGroup mv_bind_group;
+              if (!webgpu::transient_handle_publish_if_valid(
+                      ctx->create_bind_group_checked(mv_bgl, entries), mv_bind_group))
+              {
+                return false;
+              }
+              mv_pass.SetBindGroup(0, mv_bind_group);
+              issue_indirect_draws(mv_pass);
+              mv_pass.End();
+              return true;
+            },
+            [load_action_completion](const bool valid) { load_action_completion(valid); });
+      }
+    }
+    return;
+  }
+
+  std::vector<wgpu::BindGroupEntry> entries;
+  if (shader->push_constants_survive_compilation()) {
+    shader->push_constants_flush();
+    const webgpu::Buffer &pc = shader->push_constants_buffer();
+    if (pc.valid()) {
+      wgpu::BindGroupEntry entry = {};
+      entry.binding = shader->push_constants_binding();
+      entry.buffer = pc.handle();
+      entry.offset = 0;
+      entry.size = pc.size();
+      entries.push_back(entry);
+    }
+  }
+  ctx->append_resource_bind_entries(shader, entries);
+  if (!shader->bind_group_entries_complete(entries)) {
+    return;
+  }
+
+  const auto load_action = fb->load_action_transaction();
+  std::function<void(bool)> load_action_completion;
+  if (!fb->load_action_transaction_prepare(load_action, load_action_completion)) {
+    return;
+  }
+  webgpu::command_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "indirect batch draw",
+      [&](auto &enc) {
+        wgpu::RenderPassEncoder pass = fb->begin_load_pass(enc, load_action);
+        if (pass == nullptr) {
+          return false;
+        }
+        pass.SetPipeline(pipeline);
+        ctx->apply_stencil_reference(pass);
+        bind_geometry(pass);
+
+        if (!entries.empty()) {
+          const wgpu::BindGroupLayout bgl = shader->has_explicit_layout() ?
+                                                shader->explicit_bind_group_layout() :
+                                                pipeline.GetBindGroupLayout(0);
+          wgpu::BindGroup bind_group;
+          if (!webgpu::transient_handle_publish_if_valid(
+                  ctx->create_bind_group_checked(bgl, entries), bind_group))
+          {
+            return false;
+          }
+          pass.SetBindGroup(0, bind_group);
+        }
+        issue_indirect_draws(pass);
+        pass.End();
+        return true;
+      },
+      [load_action_completion](const bool valid) { load_action_completion(valid); });
+}
+
