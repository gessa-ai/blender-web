+/** Shared completion state for one transient resource gate. The resource scope may settle before
+ * its reserved queue entry reaches the front, or the entry may start first and wait for the
+ * browser callback. Either order releases the queue exactly once. */
+class TransientResourceGateState {
+ public:
+  explicit TransientResourceGateState(std::function<void(bool)> complete)
+      : complete_(std::move(complete))
+  {
+  }
+
+  void operation(std::function<void(bool)> done)
+  {
+    std::function<void(bool)> complete;
+    bool valid = false;
+    {
+      std::lock_guard lock(mutex_);
+      if (finished_) {
+        return;
+      }
+      done_ = std::move(done);
+      if (!scope_settled_) {
+        return;
+      }
+      finished_ = true;
+      valid = scope_valid_;
+      complete = std::move(complete_);
+      done = std::move(done_);
+    }
+    if (complete) {
+      complete(valid);
+    }
+    done(valid);
+  }
+
+  void settle(const bool valid)
+  {
+    std::function<void(bool)> complete;
+    std::function<void(bool)> done;
+    {
+      std::lock_guard lock(mutex_);
+      if (finished_ || scope_settled_) {
+        return;
+      }
+      scope_settled_ = true;
+      scope_valid_ = valid;
+      if (!done_) {
+        return;
+      }
+      finished_ = true;
+      complete = std::move(complete_);
+      done = std::move(done_);
+    }
+    if (complete) {
+      complete(valid);
+    }
+    done(valid);
+  }
+
+  void cancel()
+  {
+    std::function<void(bool)> complete;
+    {
+      std::lock_guard lock(mutex_);
+      if (finished_) {
+        return;
+      }
+      finished_ = true;
+      complete = std::move(complete_);
+    }
+    if (complete) {
+      complete(false);
+    }
+  }
+
+ private:
+  std::mutex mutex_;
+  bool scope_settled_ = false;
+  bool scope_valid_ = false;
+  bool finished_ = false;
+  std::function<void(bool)> done_;
+  std::function<void(bool)> complete_;
+};
