+static wmOperatorStatus object_transform_axis_target_depth_poll(bContext *C,
+                                                                wmOperator *op,
+                                                                const wmEvent *event)
+{
+  XFormAxisData *xfd = static_cast<XFormAxisData *>(op->customdata);
+  if (!xfd->depth_cache_pending || !xfd->depth_cache_start_event_valid ||
+      !object_transform_axis_target_depth_context_matches(C, xfd))
+  {
+    BKE_report(op->reports, RPT_ERROR, "Viewport changed while waiting for axis-target depth");
+    object_transform_axis_target_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  if (event->type == EVT_ESCKEY || event->type == RIGHTMOUSE ||
+      (event->type == EVT_MODAL_MAP && event->val == AXIS_TARGET_MODAL_CANCEL))
+  {
+    object_transform_axis_target_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type != TIMER || event->customdata != xfd->depth_cache_timer) {
+    if (event->type == TIMER) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (!object_transform_axis_target_depth_event_push(xfd, event)) {
+      BKE_report(
+          op->reports, RPT_ERROR, "Axis-target depth event queue exceeded its safe bound");
+      object_transform_axis_target_cancel(C, op);
+      return OPERATOR_CANCELLED;
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++xfd->depth_cache_tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for axis-target depth");
+    object_transform_axis_target_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const ViewportDepthCacheSession::ReadbackState state = xfd->depth_cache_session.state();
+  if (state == ViewportDepthCacheSession::ReadbackState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == ViewportDepthCacheSession::ReadbackState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Axis-target depth readback failed");
+    object_transform_axis_target_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  xfd->depths = xfd->depth_cache_session.take(xfd->vc.region);
+  if (xfd->depths == nullptr) {
+    BKE_report(op->reports, RPT_ERROR, "Axis-target depth readback could not be consumed");
+    object_transform_axis_target_cancel(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const wmEvent start_event = xfd->depth_cache_start_event;
+  Vector<wmEvent> queued_events = std::move(xfd->depth_cache_events);
+  xfd->depth_cache_start_event_valid = false;
+  xfd->depth_cache_pending = false;
+  object_transform_axis_target_depth_timer_remove(xfd);
+  object_transform_axis_target_initialize_ready(C, op, &start_event);
+
+  for (wmEvent &queued_event : queued_events) {
+    const wmOperatorStatus result = object_transform_axis_target_modal_dispatch(
+        C, op, &queued_event);
+    if (result != OPERATOR_RUNNING_MODAL) {
+      return result;
+    }
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static wmOperatorStatus object_transform_axis_target_modal(bContext *C,
+                                                           wmOperator *op,
+                                                           const wmEvent *event)
+{
+  XFormAxisData *xfd = static_cast<XFormAxisData *>(op->customdata);
+  if (xfd->depth_cache_pending) {
+    return object_transform_axis_target_depth_poll(C, op, event);
+  }
+  return object_transform_axis_target_modal_dispatch(C, op, event);
+}
