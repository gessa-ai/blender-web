+static wmOperatorStatus brush_edit_depth_poll(bContext *C,
+                                              wmOperator *op,
+                                              const wmEvent *event)
+{
+  BrushEdit *bedit = static_cast<BrushEdit *>(op->customdata);
+  if (bedit == nullptr || !bedit->depth_pending || bedit->depth_session == nullptr) {
+    brush_edit_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type == EVT_ESCKEY && event->val == KM_PRESS) {
+    brush_edit_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const ParticleEditDepthCacheState state = PE_depth_cache_session_state(C,
+                                                                         bedit->depth_session);
+  if (state == ParticleEditDepthCacheState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Particle brush context changed during depth readback");
+    brush_edit_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type != TIMER || event->customdata != bedit->depth_timer) {
+    if (event->type == TIMER || bedit->exec_pending) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    constexpr int max_queued_events = 256;
+    if (bedit->depth_events.size() >= max_queued_events) {
+      BKE_report(op->reports, RPT_ERROR, "Particle brush depth event queue exceeded its bound");
+      brush_edit_exit(op);
+      return OPERATOR_CANCELLED;
+    }
+    wmEvent queued;
+    if (!brush_edit_depth_event_copy(&queued, event)) {
+      BKE_report(op->reports, RPT_ERROR, "Unsafe event while waiting for particle brush depth");
+      brush_edit_exit(op);
+      return OPERATOR_CANCELLED;
+    }
+    bedit->depth_events.append(queued);
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++bedit->depth_tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for particle brush depth");
+    brush_edit_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+  if (state == ParticleEditDepthCacheState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  const bool exec_pending = bedit->exec_pending;
+  const bool start_event_valid = bedit->depth_start_event_valid;
+  const wmEvent start_event = bedit->depth_start_event;
+  Vector<wmEvent> queued_events = std::move(bedit->depth_events);
+  bedit->depth_pending = false;
+  bedit->exec_pending = false;
+  bedit->depth_start_event_valid = false;
+  brush_edit_depth_timer_remove(bedit);
+
+  if (brush_edit_init(C, op) != ParticleEditDepthCacheState::Ready) {
+    BKE_report(op->reports, RPT_ERROR, "Particle brush depth readback could not be consumed");
+    brush_edit_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+  if (exec_pending) {
+    return brush_edit_exec_apply(C, op);
+  }
+  if (!start_event_valid) {
+    brush_edit_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+
+  brush_edit_apply_event(C, op, &start_event);
+  for (wmEvent &queued_event : queued_events) {
+    const wmOperatorStatus result = brush_edit_modal_dispatch(C, op, &queued_event);
+    if (result != OPERATOR_RUNNING_MODAL) {
+      return result;
+    }
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
