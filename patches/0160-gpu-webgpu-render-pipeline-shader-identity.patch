+static uint64_t next_pipeline_cache_identity()
+{
+  static std::atomic<uint64_t> next_identity{1};
+  const uint64_t identity = next_identity.fetch_add(1, std::memory_order_relaxed);
+  BLI_assert(identity != 0);
+  return identity;
+}
+
+WGPUShader::WGPUShader(const char *name)
+    : Shader(name), pipeline_cache_identity_(next_pipeline_cache_identity())
