+/** Linear host layout for one block-compressed WriteTexture operation. Copy width/height are
+ * WebGPU's physical texel extent (rounded to complete 4x4 BC blocks); rows_per_image is in
+ * block rows, as required by TexelCopyBufferLayout. */
+struct CompressedUploadLayout {
+  uint32_t copy_width = 0;
+  uint32_t copy_height = 0;
+  uint32_t bytes_per_row = 0;
+  uint32_t rows_per_image = 0;
+  size_t data_size = 0;
+};
+
+/** Compute a bounded BC1/2/3 host layout without modifying `r_layout` on rejection.
+ * `unpack_row_length` is a source-row width in logical texels; zero selects `width`.
+ * Width/height are rounded to WebGPU's physical 4x4 block extent. */
+bool compressed_upload_layout(TextureFormat format,
+                              uint32_t width,
+                              uint32_t height,
+                              uint32_t layers,
+                              uint32_t unpack_row_length,
+                              CompressedUploadLayout &r_layout);
+
+/** BC texture formats are legal only on WebGPU 2D textures (including array/cube views).
+ * Sliced-3D compression is a distinct optional feature and is not part of Blender's pinned
+ * compressed-2D creation API. */
+bool compressed_texture_type_supported(GPUTextureType type);
