+static void test_texture_view_webgpu_depth_crossformat_and_0147_boundaries()
+{
+  GPU_render_begin();
+  constexpr int width = 2;
+  constexpr int height = 2;
+  constexpr int pixels = width * height;
+  constexpr eGPUTextureUsage usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                     GPU_TEXTURE_USAGE_HOST_READ |
+                                     GPU_TEXTURE_USAGE_FORMAT_VIEW;
+
+  auto clear_depth = [](gpu::Texture *texture, float value) {
+    gpu::FrameBuffer *framebuffer = nullptr;
+    GPU_framebuffer_ensure_config(
+        &framebuffer, {GPU_ATTACHMENT_TEXTURE(texture), GPU_ATTACHMENT_NONE});
+    GPU_framebuffer_clear_depth(framebuffer, value);
+    return framebuffer;
+  };
+  auto expect_depth = [](gpu::Texture *texture, int count, float expected, float tolerance) {
+    float *values = static_cast<float *>(GPU_texture_read(texture, GPU_DATA_FLOAT, 0));
+    ASSERT_NE(values, nullptr);
+    for (int i = 0; i < count; i++) {
+      EXPECT_NEAR(values[i], expected, tolerance);
+    }
+    MEM_delete(values);
+  };
+
+  /* Pure depth formats are not copy-compatible. The complete D32F -> D16 blit
+   * must therefore take blit_depth_render rather than encode an invalid copy. */
+  gpu::Texture *source = GPU_texture_create_2d(
+      __func__, width, height, 1, TextureFormat::SFLOAT_32_DEPTH, usage, nullptr);
+  gpu::Texture *destination = GPU_texture_create_2d(
+      __func__, width, height, 1, TextureFormat::UNORM_16_DEPTH, usage, nullptr);
+  ASSERT_NE(source, nullptr);
+  ASSERT_NE(destination, nullptr);
+  gpu::FrameBuffer *source_fb = clear_depth(source, 0.25f);
+  gpu::FrameBuffer *destination_fb = clear_depth(destination, 0.75f);
+  GPU_framebuffer_blit(source_fb, 0, destination_fb, 0, GPU_DEPTH_BIT);
+  expect_depth(destination, pixels, 0.25f, 2.0f / 65535.0f);
+  GPU_framebuffer_clear_depth(destination_fb, 0.75f);
+  static_cast<WGPUFrameBuffer *>(source_fb)
+      ->blit_to(GPU_DEPTH_BIT | GPU_STENCIL_BIT, 0, destination_fb, 0, 0, 0);
+  expect_depth(destination, pixels, 0.25f, 2.0f / 65535.0f);
+
+  /* A combined aspect-all cross-format copy has no representation-independent
+   * bridge. 0147 owns that path; 0143 must leave the destination untouched. */
+  gpu::Texture *combined = GPU_texture_create_2d(__func__,
+                                                  width,
+                                                  height,
+                                                  1,
+                                                  TextureFormat::SFLOAT_32_DEPTH_UINT_8,
+                                                  usage,
+                                                  nullptr);
+  ASSERT_NE(combined, nullptr);
+  gpu::FrameBuffer *combined_fb = nullptr;
+  GPU_framebuffer_ensure_config(
+      &combined_fb, {GPU_ATTACHMENT_TEXTURE(combined), GPU_ATTACHMENT_NONE});
+  GPU_framebuffer_clear_depth_stencil(combined_fb, 0.5f, 7u);
+  GPU_framebuffer_clear_depth(destination_fb, 0.75f);
+  static_cast<WGPUFrameBuffer *>(combined_fb)
+      ->blit_to(GPU_DEPTH_BIT | GPU_STENCIL_BIT, 0, destination_fb, 0, 0, 0);
+  expect_depth(destination, pixels, 0.75f, 2.0f / 65535.0f);
+
+  /* WebGPU depth copies require the complete x/y subresource. An offset/partial
+   * destination remains the explicit 0147 boundary and must be a safe no-op. */
+  gpu::Texture *partial_destination = GPU_texture_create_2d(
+      __func__, 3, height, 1, TextureFormat::UNORM_16_DEPTH, usage, nullptr);
+  ASSERT_NE(partial_destination, nullptr);
+  gpu::FrameBuffer *partial_fb = clear_depth(partial_destination, 0.75f);
+  static_cast<WGPUFrameBuffer *>(source_fb)
+      ->blit_to(GPU_DEPTH_BIT, 0, partial_fb, 0, 1, 0);
+  expect_depth(partial_destination, 3 * height, 0.75f, 2.0f / 65535.0f);
+
+  GPU_framebuffer_free(partial_fb);
+  GPU_texture_free(partial_destination);
+  GPU_framebuffer_free(combined_fb);
+  GPU_texture_free(combined);
+  GPU_framebuffer_free(destination_fb);
+  GPU_framebuffer_free(source_fb);
+  GPU_texture_free(destination);
+  GPU_texture_free(source);
+  GPU_render_end();
+}
+GPU_WEBGPU_TEST(texture_view_webgpu_depth_crossformat_and_0147_boundaries)
+#endif
