+wmOperatorStatus GreasePencilPenToolOperation::depth_cache_poll(bContext *C,
+                                                                wmOperator *op,
+                                                                const wmEvent *event)
+{
+  if (!depth_cache_pending_ || !this->depth_cache_context_matches(C)) {
+    BKE_report(op->reports, RPT_ERROR, "Viewport changed while waiting for Grease Pencil pen depth");
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type == EVT_ESCKEY) {
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type != TIMER || event->customdata != depth_cache_timer_) {
+    if (event->type == TIMER) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (!this->depth_cache_event_push(event)) {
+      BKE_report(op->reports, RPT_ERROR, "Grease Pencil pen depth event queue exceeded its safe bound");
+      return OPERATOR_CANCELLED;
     }
+    return OPERATOR_RUNNING_MODAL;
+  }
 
-    return std::nullopt;
+  constexpr int max_tick_count = 240;
+  if (++depth_cache_tick_count_ > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for Grease Pencil pen depth");
+    return OPERATOR_CANCELLED;
   }
-};
+
+  const DrawingPlacementDepthCacheState state = placement.poll_viewport_depths(
+      depth_cache_region_);
+  if (state == DrawingPlacementDepthCacheState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == DrawingPlacementDepthCacheState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Grease Pencil pen depth readback failed");
+    return OPERATOR_CANCELLED;
+  }
+
+  BLI_assert(depth_cache_start_event_.has_value());
+  const wmEvent start_event = *depth_cache_start_event_;
+  Vector<wmEvent> queued_events = std::move(depth_cache_events_);
+  depth_cache_start_event_.reset();
+  depth_cache_pending_ = false;
+  this->depth_cache_timer_remove();
+
+  this->initialize_ready(C);
+  this->invoke_initialized(C, op, &start_event);
+  for (wmEvent &queued_event : queued_events) {
+    const wmOperatorStatus result = PenToolOperation::modal(C, op, &queued_event);
+    if (result != OPERATOR_RUNNING_MODAL) {
+      return result;
+    }
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
