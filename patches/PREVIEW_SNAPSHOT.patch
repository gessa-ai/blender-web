+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include <cstddef>
+#include <functional>
+#include <vector>
+
+#include "GPU_readback.hh"
+
+namespace blender {
+
+struct GPUReadback {
+  virtual ~GPUReadback() = default;
+
+  virtual eGPUReadbackStatus status() = 0;
+  virtual eGPUReadbackError error() = 0;
+  virtual size_t size() = 0;
+  virtual bool consume(void *dst, size_t dst_len) = 0;
+};
+
+GPUReadback *gpu_readback_create_ready(std::vector<unsigned char> &&bytes);
+GPUReadback *gpu_readback_create_failed(eGPUReadbackError error, size_t final_size = 0);
+
+using GPUReadbackTransform =
+    std::function<bool(const unsigned char *source,
+                       size_t source_size,
+                       unsigned char *destination,
+                       size_t destination_size)>;
+
+/**
+ * Own `source` and expose a transformed result without retaining caller memory.
+ * The transform runs exactly once after the source becomes ready. Canceling or
+ * destroying the returned request also cancels the source request.
+ */
+GPUReadback *gpu_readback_create_transform(GPUReadback *source,
+                                           size_t source_size,
+                                           size_t final_size,
+                                           GPUReadbackTransform transform);
+
+}  // namespace blender
