+  const ShaderModuleHandles modules = shader_module_cache_.get_or_create(
+      instance,
+      device,
+      kShaderModuleKey,
+      "shader module-set creation",
+      [&]() {
+        ShaderModuleHandles candidate;
+        if (!vertex_wgsl_.empty()) {
+          candidate.vertex = make_module(device, vertex_wgsl_);
+          if (candidate.vertex == nullptr) {
+            return ShaderModuleHandles{};
+          }
+        }
+        if (!fragment_wgsl_.empty()) {
+          candidate.fragment = make_module(device, fragment_wgsl_);
+          if (candidate.fragment == nullptr) {
+            return ShaderModuleHandles{};
+          }
+        }
+        if (!compute_wgsl_.empty()) {
+          candidate.compute = make_module(device, compute_wgsl_);
+          if (candidate.compute == nullptr) {
+            return ShaderModuleHandles{};
+          }
+        }
+        return candidate;
+      });
+  return modules != nullptr;
+}
