+    /* Geometry-frequency SSBO attributes: the vertex-pulling buffers (mesh positions, the
+     * index buffer at GPU_SSBO_INDEX_BUF_SLOT) that GPU_batch_bind_as_resources binds for
+     * draw_expand / primitive-expansion draws. The shared frontend gates that whole bind on
+     * `interface->ssbo_attr_mask_` (gpu_batch.cc: early-returns when it is 0, and only binds
+     * the index buffer when its bit is set). vk/GL populate it here
+     * (vk_shader_interface.cc:171, gl_shader_interface.cc:507); the web interface omitted it, so
+     * the mask stayed 0 and NO geometry SSBO was bound -- the workbench shadow index buffer
+     * (dense binding 5) was left unbound, giving the 6-vs-7 shadow bind group -> Invalid
+     * CommandBuffer -> black render for every shadow-enabled workbench scene. Mirror vk/GL. */
+    for (const Resource &res : info.geometry_resources_) {
+      if (res.bind_type == Resource::BindType::STORAGE_BUFFER) {
+        ssbo_attr_mask_ |= (1 << res.slot);
+      }
+    }
