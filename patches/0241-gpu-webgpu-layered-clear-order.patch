+    scissor_get(scissor);
+    active_scissor = scissor;
+  }
+  WGPUContext *wctx = active_context();
+  wgpu::Limits limits = {};
+  if (wctx == nullptr || !wctx->device_get().GetLimits(&limits)) {
+    return false;
+  }
+  if (wctx->is_window_backbuffer(this)) {
+    return webgpu::window_viewport_scissor_plan(viewport,
+                                                active_scissor,
+                                                width_,
+                                                height_,
+                                                limits.maxTextureDimension2D,
+                                                draw_viewport);
+  }
+  return webgpu::offscreen_viewport_scissor_plan(viewport,
+                                                 active_scissor,
+                                                 width_,
+                                                 height_,
+                                                 limits.maxTextureDimension2D,
+                                                 draw_viewport);
