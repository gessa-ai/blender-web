   candidate.viewport = viewport_plan;
-  if (scissor != nullptr) {
-    if (scissor[2] <= 0 || scissor[3] <= 0) {
-      return false;
-    }
-    const int64_t left = int64_t(scissor[0]);
-    const int64_t top = int64_t(target_height) - int64_t(scissor[1]) -
-                        int64_t(scissor[3]);
-    const int64_t right = left + int64_t(scissor[2]);
-    const int64_t bottom = top + int64_t(scissor[3]);
-    const int64_t clipped_left = left > 0 ? left : 0;
-    const int64_t clipped_top = top > 0 ? top : 0;
-    const int64_t clipped_right = right < int64_t(target_width) ? right : target_width;
-    const int64_t clipped_bottom = bottom < int64_t(target_height) ? bottom : target_height;
-    if (clipped_left >= clipped_right || clipped_top >= clipped_bottom) {
-      return false;
-    }
-    candidate.scissor_enabled = true;
-    candidate.scissor_x = uint32_t(clipped_left);
-    candidate.scissor_y = uint32_t(clipped_top);
-    candidate.scissor_width = uint32_t(clipped_right - clipped_left);
-    candidate.scissor_height = uint32_t(clipped_bottom - clipped_top);
+  if (!framebuffer_scissor_plan(scissor, target_width, target_height, true, candidate)) {
+    return false;
+  }
+  result = candidate;
+  return true;
+}
+
+/** Preserve ordinary offscreen viewport/scissor coordinates through WebGPU's existing
+ * clip-space-Y and readback-row flips. The viewport remains signed; an enabled scissor is
+ * independently clipped to the render area. Failure leaves `result` unchanged. */
+inline bool offscreen_viewport_scissor_plan(const int viewport[4],
+                                            const int *scissor,
+                                            int target_width,
+                                            int target_height,
+                                            uint32_t max_viewport_dimension,
+                                            FramebufferViewportPlan &result)
+{
+  if (viewport == nullptr) {
+    return false;
+  }
+
+  ViewportScissorPlan viewport_plan;
+  if (!viewport_scissor_plan(viewport[0],
+                             viewport[1],
+                             viewport[2],
+                             viewport[3],
+                             target_width,
+                             target_height,
+                             max_viewport_dimension,
+                             viewport_plan))
+  {
+    return false;
+  }
+
+  FramebufferViewportPlan candidate;
+  candidate.viewport = viewport_plan;
+  if (!framebuffer_scissor_plan(scissor, target_width, target_height, false, candidate)) {
+    return false;
   }
   result = candidate;
   return true;
