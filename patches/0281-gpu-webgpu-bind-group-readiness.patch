+  template<typename InstanceT, typename DeviceT, typename CreateFn>
+  HandleT get_or_create_ordered(const InstanceT &instance,
+                                const DeviceT &device,
+                                OrderedQueueScheduler &scheduler,
+                                const KeyT &key,
+                                const char *label,
+                                CreateFn &&create)
+  {
+    std::string operation_label = label ? label : "";
+    return get_or_create_ordered(
+        key,
+        scheduler,
+        [&device]() { webgpu_error_scopes_push(device); },
+        std::forward<CreateFn>(create),
+        [&instance, &device, operation_label = std::move(operation_label)](
+            auto completion) mutable {
+          webgpu_error_scopes_pop(
+              instance, device, std::move(operation_label), std::move(completion));
+        });
+  }
+
  private:
   std::shared_ptr<State> state_ = std::make_shared<State>();
 };
