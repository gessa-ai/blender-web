+
+struct View3DCursorDepthRead {
+  View3DCursorDepthRead *next = nullptr;
+  View3DCursorDepthRead *prev = nullptr;
+  ViewportDepthPickSession session;
+  Scene *scene = nullptr;
+  View3D *view3d = nullptr;
+  ARegion *region = nullptr;
+  wmTimer *timer = nullptr;
+  wmWindow *timer_window = nullptr;
+  int mval[2] = {0, 0};
+  eV3DCursorOrient orientation = V3D_CURSOR_ORIENT_NONE;
+  View3DCursor cursor_before;
+  int tick_count = 0;
+  bool listed = false;
+  bool superseded = false;
+};
+
+static ListBase view3d_cursor_depth_reads = {nullptr, nullptr};
+
+static bool view3d_cursor3d_depth_read_cursor_matches(const View3DCursor &a,
+                                                      const View3DCursor &b)
+{
+  return equals_v3v3(a.location, b.location) &&
+         equals_v4v4(a.rotation_quaternion, b.rotation_quaternion) &&
+         equals_v3v3(a.rotation_euler, b.rotation_euler) &&
+         equals_v3v3(a.rotation_axis, b.rotation_axis) && a.rotation_angle == b.rotation_angle &&
+         a.rotation_mode == b.rotation_mode;
+}
+
+static bool view3d_cursor3d_depth_read_context_matches(
+    bContext *C, const View3DCursorDepthRead *read)
+{
+  return CTX_data_scene(C) == read->scene && CTX_wm_view3d(C) == read->view3d &&
+         CTX_wm_region(C) == read->region && CTX_wm_window(C) == read->timer_window;
+}
+
+static void view3d_cursor3d_depth_read_register(View3DCursorDepthRead *read)
+{
+  for (View3DCursorDepthRead *active = static_cast<View3DCursorDepthRead *>(
+           view3d_cursor_depth_reads.first);
+       active != nullptr;
+       active = active->next)
+  {
+    if (active->timer_window == read->timer_window) {
+      active->superseded = true;
+    }
+  }
+  BLI_addtail(&view3d_cursor_depth_reads, read);
+  read->listed = true;
+}
+
+static void view3d_cursor3d_depth_read_free(bContext *C, wmOperator *op)
+{
+  View3DCursorDepthRead *read = static_cast<View3DCursorDepthRead *>(op->customdata);
+  if (read == nullptr) {
+    return;
+  }
+  if (read->listed) {
+    BLI_remlink(&view3d_cursor_depth_reads, read);
+    read->listed = false;
+  }
+  if (read->timer != nullptr) {
+    WM_event_timer_remove(CTX_wm_manager(C), read->timer_window, read->timer);
+    read->timer = nullptr;
+  }
+  MEM_delete(read);
+  op->customdata = nullptr;
+}
+
+static wmOperatorStatus view3d_cursor3d_depth_read_apply(bContext *C, wmOperator *op)
+{
+  View3DCursorDepthRead *read = static_cast<View3DCursorDepthRead *>(op->customdata);
+  if (!view3d_cursor3d_depth_read_context_matches(C, read) ||
+      !view3d_cursor3d_depth_read_cursor_matches(read->cursor_before, read->scene->cursor))
+  {
+    BKE_report(op->reports, RPT_ERROR, "Cursor context changed while waiting for depth readback");
+    view3d_cursor3d_depth_read_free(C, op);
+    return OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH;
+  }
+  float depth_location[3];
+  const bool has_depth = read->session.sample(read->region, depth_location);
+  if (!has_depth &&
+      read->session.state() == ViewportDepthPickSession::ReadbackState::Failed)
+  {
+    BKE_report(op->reports, RPT_ERROR, "Viewport changed while waiting for cursor depth");
+    view3d_cursor3d_depth_read_free(C, op);
+    return OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH;
+  }
+
+  /* A ready request with no surface hit preserves the stock view-plane fallback. */
+  view3d_cursor3d_update_ex(C,
+                            read->mval,
+                            has_depth,
+                            read->orientation,
+                            has_depth ? depth_location : nullptr);
+  view3d_cursor3d_depth_read_free(C, op);
+  return OPERATOR_FINISHED | OPERATOR_PASS_THROUGH;
+}
+
+static wmOperatorStatus view3d_cursor3d_modal(bContext *C,
+                                              wmOperator *op,
+                                              const wmEvent *event)
+{
+  View3DCursorDepthRead *read = static_cast<View3DCursorDepthRead *>(op->customdata);
+  if (read == nullptr) {
+    return OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH;
+  }
+  if (read->superseded) {
+    view3d_cursor3d_depth_read_free(C, op);
+    return OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH;
+  }
+  if (!view3d_cursor3d_depth_read_context_matches(C, read)) {
+    view3d_cursor3d_depth_read_free(C, op);
+    return OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH;
+  }
+  if (event->type != TIMER || event->customdata != read->timer) {
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+
+  /* Roughly 2.4 seconds at 10 ms. A lost callback must not mutate the cursor late. */
+  constexpr int max_tick_count = 240;
+  if (++read->tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for cursor depth readback");
+    view3d_cursor3d_depth_read_free(C, op);
+    return OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH;
+  }
+
+  const ViewportDepthPickSession::ReadbackState state = read->session.state();
+  if (state == ViewportDepthPickSession::ReadbackState::Pending) {
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+  if (state == ViewportDepthPickSession::ReadbackState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Cursor depth readback failed");
+    view3d_cursor3d_depth_read_free(C, op);
+    return OPERATOR_CANCELLED | OPERATOR_PASS_THROUGH;
+  }
+  return view3d_cursor3d_depth_read_apply(C, op);
+}
+
+static void view3d_cursor3d_cancel(bContext *C, wmOperator *op)
+{
+  view3d_cursor3d_depth_read_free(C, op);
+}
