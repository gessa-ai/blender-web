index 0000000000000000000000000000000000000000..ebcea77d1bd74d254e14f016ec45a0323a881c6b
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_state_manager.hh
@@ -0,0 +1,110 @@
+/* SPDX-FileCopyrightText: 2023 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_state_manager.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WGPUStateManager — the WebGPU `StateManager` implementation. Every context needs
+ * one: the gpu frontend dereferences `Context::get()->state_manager` unconditionally
+ * (e.g. `GPU_memory_barrier` → `state_manager->issue_barrier`, gpu_state.cc:312), so
+ * a null `state_manager` crashes before any draw. This bootstrap version is a set of
+ * honest no-ops: WebGPU's implicit memory model needs no barrier, pipeline state is
+ * baked into the render-pipeline descriptor at creation (not applied globally), and
+ * resource bindings are resolved into a `wgpu::BindGroup` at draw-time assembly
+ * (wgpu_batch / wgpu_pipeline). Real BindSpace tracking (mirroring VKStateManager)
+ * now lives here: texture/sampler + storage-image binds are recorded per WGSL
+ * @binding slot and read back by the compute-dispatch / draw bind-group builders. */
+
+#pragma once
+
+#include <unordered_map>
+
+#include "gpu_state_private.hh"
+
+namespace blender::gpu {
+
+/**
+ * Fence synchronization primitive.
+ *
+ * WebGPU exposes one ordered queue per device. All commands emitted by this backend are
+ * submitted immediately to that queue, so work submitted after a fence wait is already
+ * ordered after work submitted before the matching signal. There is no command-stream
+ * fence object to encode (unlike GLsync/MTLEvent), and waiting for
+ * Queue::OnSubmittedWorkDone on the CPU is both stronger than the GPUFence contract and
+ * impossible in the windowed Emscripten profile without Asyncify/JSPI.
+ *
+ * Keep the frontend's reusable signal/wait state while relying on the queue timeline for
+ * the actual dependency. A wait before the first signal is intentionally a no-op, matching
+ * the other backends.
+ */
+class WGPUFence : public Fence {
+ public:
+  WGPUFence() = default;
+  ~WGPUFence() override = default;
+
+  void signal() override
+  {
+    signalled_ = true;
+  }
+
+  void wait() override
+  {
+    if (!signalled_) {
+      return;
+    }
+    signalled_ = false;
+  }
+};
+
+class WGPUStateManager : public StateManager {
+ public:
+  /** One combined-sampler binding: the sampled texture plus its sampler state.
+   * The bind-group builder splits this into a texture entry at binding N and a
+   * sampler entry at SAMPLER_BASE + N (notes/gpu-binding-map-spec.md §4.1). */
+  struct BoundTexture {
+    Texture *texture = nullptr;
+    GPUSamplerState sampler = GPUSamplerState::default_sampler();
+  };
+
+  WGPUStateManager() = default;
+  ~WGPUStateManager() override = default;
+
+  void apply_state() override;
+  void force_state() override;
+
+  void issue_barrier(GPUBarrier barrier_bits) override;
+
+  void texture_bind(Texture *tex, GPUSamplerState sampler, int unit) override;
+  void texture_unbind(Texture *tex) override;
+  void texture_unbind_all() override;
+
+  void image_bind(Texture *tex, int unit) override;
+  void image_unbind(Texture *tex) override;
+  void image_unbind_all() override;
+
+  /* --- Bind-space accessors (consumed by wgpu_backend / wgpu_batch) ----------
+   * WebGPU has no global binding state — bindings live in a per-draw/-dispatch
+   * BindGroup — so the backend records which texture/image is bound to which
+   * dense WGSL @binding here and resolves them into the group-0 bind group at
+   * dispatch/draw time. Keyed by binding slot; last bind to a slot wins. */
+  const std::unordered_map<int, BoundTexture> &bound_textures() const
+  {
+    return textures_;
+  }
+  const std::unordered_map<int, Texture *> &bound_images() const
+  {
+    return images_;
+  }
+
+ private:
+  /** Combined samplers keyed by dense WGSL @binding N (texture half). */
+  std::unordered_map<int, BoundTexture> textures_;
+  /** Storage images keyed by dense WGSL @binding N. */
+  std::unordered_map<int, Texture *> images_;
+};
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_state_table.cc b/source/blender/gpu/webgpu/wgpu_state_table.cc
new file mode 100644
index 0000000000000000000000000000000000000000..7eb0dc4c2e8a0d0d64d1b1f76cd12dfec5bdffe4
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_state_table.cc
@@ -0,0 +1,156 @@
+/* SPDX-FileCopyrightText: 2020 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/opengl/gl_state.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Blender fixed-function state -> WebGPU descriptor mapping. See
+ * wgpu_state_table.hh. The blend table is transcribed VERBATIM from
+ * `opengl/gl_state.cc::set_blend` (GL_* -> wgpu::BlendFactor; equation ->
+ * wgpu::BlendOperation), verified byte-identical in the Vulkan
+ * (`vk_graphics_pipeline.hh:603-724`) and Metal (`mtl_state.mm:394+`) backends. */
+
+#include "wgpu_state_table.hh"
+
+namespace blender::gpu::webgpu {
+
+using BF = wgpu::BlendFactor;
+using BO = wgpu::BlendOperation;
+using CF = wgpu::CompareFunction;
+using SO = wgpu::StencilOperation;
+
+/* GPU_BLEND_<name> -> (color src,dst) (alpha src,dst) equation dual-source.
+ * The X token is the bare enum suffix; `GPU_BLEND_##name` recovers the real
+ * unscoped `blender::GPUBlend` enumerator from GPU_state.hh.
+ *   X(name, enabled, colorSrc, colorDst, alphaSrc, alphaDst, op, dual) */
+#define GPU_BLEND_TABLE(X) \
+  X(NONE,                    false, One,             Zero,             One,             Zero,             Add,             false) \
+  X(ALPHA,                   true,  SrcAlpha,        OneMinusSrcAlpha, One,             OneMinusSrcAlpha, Add,             false) \
+  X(ALPHA_PREMULT,           true,  One,             OneMinusSrcAlpha, One,             OneMinusSrcAlpha, Add,             false) \
+  X(ADDITIVE,                true,  SrcAlpha,        One,              Zero,            One,              Add,             false) \
+  X(ADDITIVE_PREMULT,        true,  One,             One,              One,             One,              Add,             false) \
+  X(MULTIPLY,                true,  Dst,             Zero,             DstAlpha,        Zero,             Add,             false) \
+  X(SUBTRACT,                true,  One,             One,              One,             One,              ReverseSubtract, false) \
+  X(INVERT,                  true,  OneMinusDst,     Zero,             Zero,            One,              Add,             false) \
+  X(MIN,                     true,  One,             One,              One,             One,              Min,             false) \
+  X(MAX,                     true,  One,             One,              One,             One,              Max,             false) \
+  X(OIT,                     true,  One,             One,              Zero,            OneMinusSrcAlpha, Add,             false) \
+  X(BACKGROUND,              true,  OneMinusDstAlpha,SrcAlpha,         Zero,            SrcAlpha,         Add,             false) \
+  X(CUSTOM,                  true,  One,             Src1,             One,             Src1Alpha,        Add,             true)  \
+  X(ALPHA_UNDER_PREMUL,      true,  OneMinusDstAlpha,One,              OneMinusDstAlpha,One,              Add,             false) \
+  X(OVERLAY_MASK_FROM_ALPHA, true,  Zero,            OneMinusSrcAlpha, Zero,            OneMinusSrcAlpha, Add,             false) \
+  X(TRANSPARENCY,            true,  One,             SrcAlpha,         Zero,            SrcAlpha,         Add,             false)
+
+static const BlendMapping g_blend[] = {
+#define X(name, en, cs, cd, as, ad, op, dual) \
+  {GPU_BLEND_##name, "GPU_BLEND_" #name, en, dual, {BO::op, BF::cs, BF::cd}, {BO::op, BF::as, BF::ad}},
+    GPU_BLEND_TABLE(X)
+#undef X
+};
+static constexpr size_t g_blend_count = sizeof(g_blend) / sizeof(g_blend[0]);
+
+const BlendMapping *blend_table(size_t &count)
+{
+  count = g_blend_count;
+  return g_blend;
+}
+
+BlendMapping to_blend(GPUBlend blend)
+{
+  for (const BlendMapping &m : g_blend) {
+    if (m.blend == blend) {
+      return m;
+    }
+  }
+  return g_blend[0];
+}
+
+const char *to_string(GPUBlend b)
+{
+  return to_blend(b).name;
+}
+
+DepthMapping to_depth(GPUDepthTest test)
+{
+  switch (test) {
+    case GPU_DEPTH_NONE:          return {false, CF::Always};
+    case GPU_DEPTH_ALWAYS:        return {true, CF::Always};
+    case GPU_DEPTH_LESS:          return {true, CF::Less};
+    case GPU_DEPTH_LESS_EQUAL:    return {true, CF::LessEqual};
+    case GPU_DEPTH_EQUAL:         return {true, CF::Equal};
+    case GPU_DEPTH_GREATER:       return {true, CF::Greater};
+    case GPU_DEPTH_GREATER_EQUAL: return {true, CF::GreaterEqual};
+  }
+  return {false, CF::Always};
+}
+
+StencilMapping to_stencil(GPUStencilTest test, GPUStencilOp op)
+{
+  CF cmp = CF::Always;
+  bool enabled = true;
+  switch (test) {
+    case GPU_STENCIL_NONE:   enabled = false; cmp = CF::Always; break;
+    case GPU_STENCIL_ALWAYS: cmp = CF::Always; break;
+    case GPU_STENCIL_EQUAL:  cmp = CF::Equal; break;
+    case GPU_STENCIL_NEQUAL: cmp = CF::NotEqual; break;
+  }
+  wgpu::StencilFaceState front = {}, back = {};
+  front.compare = back.compare = cmp;
+  /* {failOp, depthFailOp, passOp}; from gl_state.cc:218-234 glStencilOp order. */
+  switch (op) {
+    case GPU_STENCIL_OP_NONE:
+      front.failOp = front.depthFailOp = front.passOp = SO::Keep;
+      back = front;
+      break;
+    case GPU_STENCIL_OP_REPLACE:
+      front.failOp = SO::Keep; front.depthFailOp = SO::Keep; front.passOp = SO::Replace;
+      back = front;
+      break;
+    case GPU_STENCIL_OP_COUNT_DEPTH_PASS: /* depth-pass count: passOp wrap, per-face. */
+      back.failOp = SO::Keep;  back.depthFailOp = SO::Keep;  back.passOp = SO::IncrementWrap;
+      front.failOp = SO::Keep; front.depthFailOp = SO::Keep; front.passOp = SO::DecrementWrap;
+      break;
+    case GPU_STENCIL_OP_COUNT_DEPTH_FAIL: /* depth-fail count: depthFailOp wrap, per-face. */
+      back.failOp = SO::Keep;  back.depthFailOp = SO::DecrementWrap; back.passOp = SO::Keep;
+      front.failOp = SO::Keep; front.depthFailOp = SO::IncrementWrap; front.passOp = SO::Keep;
+      break;
+  }
+  return {enabled, front, back};
+}
+
+wgpu::CullMode to_cull_mode(GPUFaceCullTest cull)
+{
+  switch (cull) {
+    case GPU_CULL_NONE:  return wgpu::CullMode::None;
+    case GPU_CULL_FRONT: return wgpu::CullMode::Front;
+    case GPU_CULL_BACK:  return wgpu::CullMode::Back;
+  }
+  return wgpu::CullMode::None;
+}
+
+wgpu::FrontFace to_front_face(bool invert)
+{
+  /* GL default is CCW (glFrontFace(GL_CCW)); invert flips to CW. gl_state.cc:290-293. */
+  return invert ? wgpu::FrontFace::CW : wgpu::FrontFace::CCW;
+}
+
+wgpu::ColorWriteMask to_color_write_mask(GPUWriteMask m)
+{
+  wgpu::ColorWriteMask out = wgpu::ColorWriteMask::None;
+  if (flag_is_set(m, GPU_WRITE_RED))   out |= wgpu::ColorWriteMask::Red;
+  if (flag_is_set(m, GPU_WRITE_GREEN)) out |= wgpu::ColorWriteMask::Green;
+  if (flag_is_set(m, GPU_WRITE_BLUE))  out |= wgpu::ColorWriteMask::Blue;
+  if (flag_is_set(m, GPU_WRITE_ALPHA)) out |= wgpu::ColorWriteMask::Alpha;
+  return out;
+}
+
+bool provoking_vertex_is_native(GPUProvokingVertex vert)
+{
+  return vert == GPU_VERTEX_FIRST;
+}
+
+}  // namespace blender::gpu::webgpu
diff --git a/source/blender/gpu/webgpu/wgpu_state_table.hh b/source/blender/gpu/webgpu/wgpu_state_table.hh
new file mode 100644
index 0000000000000000000000000000000000000000..1a67146d0c00f641b9c8550e21bc35cb753b254e
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_state_table.hh
@@ -0,0 +1,87 @@
+/* SPDX-FileCopyrightText: 2020 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/opengl/gl_state.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * M3.T10 — WebGPU state-table mapping.
+ *
+ * The complete mechanical mapping from Blender's fixed-function state model
+ * (`GPU_state.hh`) to WebGPU pipeline-descriptor structs. Header-only-consumable:
+ * every entry point is a PURE function of a `GPUState` / `GPUStateMutable` field —
+ * no device, no context, no allocation — so `wgpu_state.cc` / `wgpu_pipeline.cc`
+ * can call them while building a (cached) render-pipeline descriptor.
+ *
+ *   - GPUBlend (16 arms)   -> wgpu::BlendState {color, alpha} (X-macro table)
+ *   - GPUDepthTest         -> depthCompare + depthWriteEnabled
+ *   - GPUStencilTest / Op  -> wgpu::StencilFaceState front/back (incl. shadow-volume
+ *                             increment/decrement-wrap counting)
+ *   - GPUFaceCullTest      -> wgpu::CullMode ; front-face winding
+ *   - GPUWriteMask         -> wgpu::ColorWriteMask (color bits only; the DEPTH /
+ *                             STENCIL write bits are applied by the depth-stencil
+ *                             state, not here)
+ *   - GPUProvokingVertex   -> NO WebGPU control (documented; emulate in-shader)
+ *
+ * SOURCE OF TRUTH (read-only recon, cited in notes/gpu-t6-t10pre-findings.md
+ * §Part-2): `opengl/gl_state.cc::set_blend` (blend factors) — verified IDENTICAL
+ * in the Vulkan (`vk_graphics_pipeline.hh:603-724`) and Metal (`mtl_state.mm:394+`)
+ * backends — plus `set_depth_test` / `set_stencil_op` / `set_backface_culling` /
+ * `set_provoking_vert` in the same file. Enum contract: `GPU_state.hh`. */
+
+#pragma once
+
+#include <cstddef>
+
+#include "webgpu/webgpu_cpp.h"
+
+#include "GPU_state.hh" /* blender::GPUBlend / GPUDepthTest / GPUStencilTest / ... */
+
+namespace blender::gpu::webgpu {
+
+/* ---- Mapping results ------------------------------------------------------- */
+
+struct BlendMapping {
+  GPUBlend blend;
+  const char *name;
+  bool enabled;     /* false for GPU_BLEND_NONE -> omit the BlendState. */
+  bool dual_source; /* true for GPU_BLEND_CUSTOM -> needs DualSourceBlending + @blend_src. */
+  wgpu::BlendComponent color;
+  wgpu::BlendComponent alpha;
+};
+
+struct DepthMapping {
+  bool test_enabled; /* false -> depthWrite off, compare Always. */
+  wgpu::CompareFunction compare;
+};
+
+struct StencilMapping {
+  bool enabled; /* false for GPU_STENCIL_NONE. */
+  wgpu::StencilFaceState front;
+  wgpu::StencilFaceState back;
+};
+
+/* ---- The mapping API (pure; GPUState field -> wgpu descriptor field) -------- */
+
+BlendMapping to_blend(GPUBlend blend);
+DepthMapping to_depth(GPUDepthTest test);
+StencilMapping to_stencil(GPUStencilTest test, GPUStencilOp op);
+wgpu::CullMode to_cull_mode(GPUFaceCullTest cull);
+wgpu::FrontFace to_front_face(bool invert); /* GL default CCW; invert -> CW. */
+wgpu::ColorWriteMask to_color_write_mask(GPUWriteMask gpu_write_mask);
+
+/** WebGPU has NO provoking-vertex control (flat interpolation samples the FIRST
+ * vertex); Blender defaults to LAST. Returns true iff the requested convention is
+ * native to WebGPU (i.e. `GPU_VERTEX_FIRST`). `GPU_VERTEX_LAST` must be emulated
+ * in-shader (Metal precedent: mtl_state.mm:384-391). No pipeline knob exists —
+ * this is a shader-codegen task, flagged for the render milestones. */
+bool provoking_vertex_is_native(GPUProvokingVertex vert);
+
+/* Whole-table iteration for reflection / tests. */
+const BlendMapping *blend_table(size_t &count);
+const char *to_string(GPUBlend b);
+
+}  // namespace blender::gpu::webgpu
diff --git a/source/blender/gpu/webgpu/wgpu_storage_buffer.cc b/source/blender/gpu/webgpu/wgpu_storage_buffer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..f63b804779f297d126a761681a384c13b0c98619
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_storage_buffer.cc
@@ -0,0 +1,331 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_storage_buffer.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ */
+
+#include "wgpu_storage_buffer.hh"
+
+#include "GPU_context.hh"
+#include "GPU_readback.hh"
+#include "GPU_vertex_buffer.hh"
+#include "gpu_context_private.hh"
+#include "gpu_readback_private.hh"
+
+#include "wgpu_context.hh"
+#include "wgpu_readback.hh"
+#include "wgpu_vertex_buffer.hh"
+
+#include <cstring>
+#include <vector>
+
+namespace blender::gpu {
+
+namespace {
+
+eGPUReadbackError readback_error_to_gpu(const webgpu::readback::TicketError error)
+{
+  using webgpu::readback::TicketError;
+  switch (error) {
+    case TicketError::None:
+      return GPU_READBACK_ERROR_NONE;
+    case TicketError::InvalidArgument:
+      return GPU_READBACK_ERROR_INVALID_ARGUMENT;
+    case TicketError::CapacityExceeded:
+      return GPU_READBACK_ERROR_CAPACITY_EXCEEDED;
+    case TicketError::StagingAllocationFailed:
+      return GPU_READBACK_ERROR_ALLOCATION_FAILED;
+    case TicketError::MapFailed:
+      return GPU_READBACK_ERROR_MAP_FAILED;
+    case TicketError::NoMappedRange:
+      return GPU_READBACK_ERROR_NO_MAPPED_RANGE;
+    case TicketError::SourceForgotten:
+      return GPU_READBACK_ERROR_SOURCE_UNAVAILABLE;
+    case TicketError::Canceled:
+      return GPU_READBACK_ERROR_BACKEND_FAILURE;
+  }
+  return GPU_READBACK_ERROR_BACKEND_FAILURE;
+}
+
+class WGPUStorageBufferReadback final : public GPUReadback {
+ private:
+  webgpu::readback::Ticket ticket_ = webgpu::readback::kInvalidTicket;
+  size_t size_ = 0;
+
+ public:
+  WGPUStorageBufferReadback(const webgpu::readback::Ticket ticket, const size_t size)
+      : ticket_(ticket), size_(size)
+  {
+  }
+
+  ~WGPUStorageBufferReadback() override
+  {
+    if (ticket_ != webgpu::readback::kInvalidTicket) {
+      webgpu::readback::free_ticket(ticket_);
+    }
+  }
+
+  eGPUReadbackStatus status() override
+  {
+    using webgpu::readback::TicketStatus;
+    switch (webgpu::readback::ticket_status(ticket_)) {
+      case TicketStatus::Pending:
+        return GPU_READBACK_PENDING;
+      case TicketStatus::Ready:
+        return GPU_READBACK_READY;
+      case TicketStatus::Failed:
+      case TicketStatus::Canceled:
+        return GPU_READBACK_FAILED;
+      case TicketStatus::Invalid:
+        return GPU_READBACK_INVALID;
+    }
+    return GPU_READBACK_INVALID;
+  }
+
+  eGPUReadbackError error() override
+  {
+    return readback_error_to_gpu(webgpu::readback::ticket_error(ticket_));
+  }
+
+  size_t size() override
+  {
+    return size_;
+  }
+
+  bool consume(void *destination, const size_t destination_size) override
+  {
+    if (destination == nullptr || destination_size < size_ ||
+        webgpu::readback::consume_ticket(ticket_, destination, size_) != size_)
+    {
+      return false;
+    }
+    ticket_ = webgpu::readback::kInvalidTicket;
+    return true;
+  }
+};
+
+}  // namespace
+
+/** The active WebGPU context (owns the live Dawn instance/device/queue). */
+static WGPUContext *active_context()
+{
+  return static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
+}
+
+bool WGPUStorageBuffer::ensure()
+{
+  if (buffer_.valid()) {
+    buffer_.retry_pending_updates();
+    return true;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return false;
+  }
+  const webgpu::UsageType usage = (usage_ == GPU_USAGE_DEVICE_ONLY) ?
+                                      webgpu::UsageType::DeviceOnly :
+                                      webgpu::UsageType::Dynamic;
+  /* readable=true: storage buffers can be read back (GPU_storagebuf_read). */
+  return buffer_.create_scoped(
+      ctx->instance_get(),
+      ctx->device_get(),
+      webgpu::BufferKind::Storage,
+      usage,
+      size_in_bytes_,
+      nullptr,
+      true,
+      label_.c_str());
+}
+
+WGPUStorageBuffer::~WGPUStorageBuffer()
+{
+  /* Drop any binding this buffer holds in the active context's bind-space, so a
+   * freed SSBO can never leave a dangling pointer (or a stale binding) for the next
+   * shader's compute_dispatch to pick up. */
+  WGPUContext *ctx = active_context();
+  if (ctx != nullptr) {
+    ctx->storage_buffer_unbind(this);
+  }
+}
+
+void WGPUStorageBuffer::update(const void *data)
+{
+  if (data == nullptr) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  const bool allocation_ready = ensure();
+  if (!(allocation_ready || buffer_.creation_pending_or_retryable())) {
+    return;
+  }
+  webgpu::BufferUpdatePayload payload;
+  if (!webgpu::buffer_update_payload(
+          data, usage_size_in_bytes_, buffer_.update_capacity(), payload))
+  {
+    return;
+  }
+  buffer_.update_sub(
+      ctx->instance_get(),
+      ctx->device_get(),
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      0,
+      payload.data(data),
+      payload.transfer_size);
+}
+
+void WGPUStorageBuffer::clear(uint32_t clear_value)
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  const bool allocation_ready = ensure();
+  if (!(allocation_ready || buffer_.creation_pending_or_retryable())) {
+    return;
+  }
+  /* WebGPU has no fill-with-value primitive; upload a host vector of the 32-bit
+   * pattern. size_in_bytes_ is a multiple of 4 for storage buffers. */
+  const size_t words = webgpu::align_up(size_in_bytes_, webgpu::kCopyAlignment) / sizeof(uint32_t);
+  std::vector<uint32_t> pattern(words, clear_value);
+  buffer_.update_sub(
+      ctx->instance_get(),
+      ctx->device_get(),
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      0,
+      pattern.data(),
+      words * sizeof(uint32_t));
+}
+
+void WGPUStorageBuffer::copy_sub(VertBuf *src, uint dst_offset, uint src_offset, uint copy_size)
+{
+  if (!ensure()) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+
+  /* Make sure the source vertex buffer's GPU buffer exists and is uploaded. */
+  WGPUVertexBuffer *src_vbo = unwrap(src);
+  src_vbo->upload();
+  const webgpu::Buffer &src_buffer = src_vbo->buffer();
+  if (!src_buffer.valid()) {
+    return;
+  }
+
+  /* CopyBufferToBuffer requires all three byte values to be four-aligned. Validate both
+   * half-open ranges before creating an encoder so malformed frontend input cannot submit a
+   * Dawn validation error or wrap an end offset. */
+  if (!webgpu::buffer_copy_range_valid(src_offset,
+                                       dst_offset,
+                                       copy_size,
+                                       src_buffer.size(),
+                                       buffer_.size()))
+  {
+    return;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  webgpu::command_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "vertex-to-storage copy",
+      [&](auto &encoder) {
+        encoder.CopyBufferToBuffer(
+            src_buffer.handle(), src_offset, buffer_.handle(), dst_offset, copy_size);
+      },
+      [](bool) {});
+}
+
+void WGPUStorageBuffer::read(void *data)
+{
+  if (data == nullptr || !ensure()) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  std::vector<uint8_t> bytes = buffer_.read(
+      ctx->instance_get(),
+      ctx->device_get(),
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      0,
+      size_in_bytes_);
+  if (bytes.size() == size_in_bytes_) {
+    std::memcpy(data, bytes.data(), size_in_bytes_);
+  }
+}
+
+GPUReadback *WGPUStorageBuffer::read_async()
+{
+#ifndef __EMSCRIPTEN__
+  return StorageBuf::read_async();
+#else
+  if (!ensure()) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_SOURCE_UNAVAILABLE, size_in_bytes_);
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_SOURCE_UNAVAILABLE, size_in_bytes_);
+  }
+
+  const size_t copy_size = webgpu::align_up(size_in_bytes_, webgpu::kCopyAlignment);
+  const webgpu::readback::SourceKey key{webgpu::readback::SourceKind::Buffer,
+                                        this,
+                                        0,
+                                        uint64_t(size_in_bytes_)};
+  const webgpu::readback::Ticket ticket = webgpu::readback::kick_buffer(ctx->instance_get(),
+                                                                       ctx->device_get(),
+                                                                       ctx->queue_get(),
+                                                                       ctx->queue_scheduler_get(),
+                                                                       buffer_.handle(),
+                                                                       key,
+                                                                       0,
+                                                                       copy_size,
+                                                                       size_in_bytes_,
+                                                                       webgpu::readback::RequestMode::Exact);
+  if (ticket == webgpu::readback::kInvalidTicket) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_CAPACITY_EXCEEDED, size_in_bytes_);
+  }
+  return MEM_new<WGPUStorageBufferReadback>(__func__, ticket, size_in_bytes_);
+#endif
+}
+
+/* Record the binding in the active context's storage-buffer bind-space; the actual
+ * wgpu::BindGroup is assembled at dispatch/draw time (WGPUBackend::compute_dispatch
+ * today; the draw path when it binds SSBOs). ensure() the device buffer here so it
+ * exists (valid handle) by the time the bind group is built — the compute tests
+ * create the SSBO DEVICE_ONLY with no initial upload, so nothing else would. */
+void WGPUStorageBuffer::bind(int slot)
+{
+  if (!ensure()) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx != nullptr) {
+    ctx->storage_buffer_bind(slot, this);
+  }
+}
+void WGPUStorageBuffer::unbind()
+{
+  WGPUContext *ctx = active_context();
+  if (ctx != nullptr) {
+    ctx->storage_buffer_unbind(this);
+  }
+}
+
+/* read() is synchronous (blocks on the instance), so the async flush is a no-op;
+ * the Indirect usage bit is set at creation, so no explicit sync is needed. */
+void WGPUStorageBuffer::async_flush_to_host() {}
+void WGPUStorageBuffer::sync_as_indirect_buffer() {}
+
+}  // namespace blender::gpu
