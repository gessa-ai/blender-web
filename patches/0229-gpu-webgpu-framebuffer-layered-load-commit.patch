   return FramebufferLoadClearScope::RenderPass;
 }
 
+/** Consume a pending framebuffer load action only after its explicit clear reached the queue.
+ * A failed command transaction leaves the action untouched so the next draw retries it. */
+template<typename SubmitFn, typename ActionT>
+inline bool framebuffer_load_action_commit_if_valid(SubmitFn &&submit,
+                                                    const ActionT committed_action,
+                                                    ActionT &load_action)
+{
+  if (!std::forward<SubmitFn>(submit)()) {
+    return false;
+  }
+  load_action = committed_action;
+  return true;
+}
