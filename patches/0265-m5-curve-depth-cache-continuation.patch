+static void curve_draw_project_finalize(CurveDrawData *cdd)
+{
+  RegionView3D *rv3d = cdd->vc.rv3d;
+  Object *obedit = cdd->vc.obedit;
+  const float *plane_no = nullptr;
+  const float *plane_co = nullptr;
