+static void test_framebuffer_webgpu_empty_raster_load_clear()
+{
+  GPU_render_begin();
+
+  const int2 size(2, 2);
+  constexpr eGPUTextureUsage usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                     GPU_TEXTURE_USAGE_HOST_READ;
+  gpu::Texture *texture = GPU_texture_create_2d(
+      __func__, UNPACK2(size), 1, TextureFormat::UNORM_8_8_8_8, usage, nullptr);
+  ASSERT_NE(texture, nullptr);
+  GPU_texture_clear(texture, GPU_DATA_FLOAT, float4(0.0f));
+
+  gpu::FrameBuffer *framebuffer = nullptr;
+  GPU_framebuffer_ensure_config(
+      &framebuffer, {GPU_ATTACHMENT_NONE, GPU_ATTACHMENT_TEXTURE(texture)});
+  ASSERT_NE(framebuffer, nullptr);
+
+  shader::ShaderCreateInfo create_info("gpu_framebuffer_empty_raster_load_clear");
+  create_info.builtins(shader::BuiltinBits::VERTEX_ID);
+  create_info.fragment_out(0, shader::Type::float4_t, "out_color");
+  create_info.vertex_source_generated = R"(
+void main()
+{
+  int vertex = gl_VertexID % 3;
+  float x = -1.0 + float((vertex & 1) << 2);
+  float y = -1.0 + float((vertex & 2) << 1);
+  gl_Position = vec4(x, y, 0.0, 1.0);
+}
+)";
+  create_info.fragment_source_generated = R"(
+void main()
+{
+  out_color = vec4(1.0, 0.0, 0.0, 1.0);
+}
+)";
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&create_info));
+  ASSERT_NE(shader, nullptr);
+  Batch *batch = GPU_batch_create_procedural(GPU_PRIM_TRIS, 3);
+  ASSERT_NE(batch, nullptr);
+  GPU_batch_set_shader(batch, shader);
+
+  const GPULoadStore actions[2] = {
+      {GPU_LOADACTION_DONT_CARE, GPU_STOREACTION_DONT_CARE, {0.0, 0.0, 0.0, 0.0}},
+      {GPU_LOADACTION_CLEAR, GPU_STOREACTION_STORE, {0.0, 1.0, 0.0, 1.0}},
+  };
+  GPU_framebuffer_bind_loadstore(framebuffer, actions, 2);
+  GPU_framebuffer_viewport_set(framebuffer, 0, 0, 0, size.y);
+  GPU_scissor_test(false);
+
+  /* The normal draw must open a pass so the green load clear is consumed, while its legal zero
+   * viewport prevents the red shader from producing fragments. */
+  GPU_batch_draw(batch);
+  GPU_finish();
+
+  std::array<uchar4, 4> pixels;
+  GPU_framebuffer_read_color(
+      framebuffer, 0, 0, size.x, size.y, 4, 0, GPU_DATA_UBYTE, pixels.data());
+  for (const uchar4 pixel : pixels) {
+    EXPECT_EQ(pixel, uchar4(0, 255, 0, 255));
+  }
+
+  GPU_framebuffer_restore();
+  GPU_batch_discard(batch);
+  GPU_shader_unbind();
+  GPU_shader_free(shader);
+  GPU_framebuffer_free(framebuffer);
+  GPU_texture_free(texture);
+  GPU_render_end();
+}
+GPU_WEBGPU_TEST(framebuffer_webgpu_empty_raster_load_clear)
