+++ b/source/blender/gpu/webgpu/wgpu_framebuffer.hh
@@ -95,7 +95,11 @@
 
  private:
   /** Per-attachment load/store op (explicit-loadstore binds); default = clear+store. */
-  GPULoadStore load_store_[GPU_FB_MAX_ATTACHMENT];
+  /* Mutable: begin_load_pass() (const) consumes one-shot CLEAR load-actions —
+   * the first render pass after attachment_set_loadstore_op performs the clear,
+   * subsequent passes on the same binding LOAD (Blender's bind_loadstore contract
+   * under the pass-per-draw model). */
+  mutable GPULoadStore load_store_[GPU_FB_MAX_ATTACHMENT];
 
   /** Recompute width_/height_ from the first bound attachment. */
   void update_size();
