+
+static bool view3d_particle_gesture_async_begin(
+    bContext *C,
+    wmOperator *op,
+    const View3DGestureAsyncKind kind,
+    ParticleEditDepthCacheSession *depth_session)
+{
+  BLI_assert(op->customdata == nullptr);
+  View3DGestureAsyncData *data = MEM_new<View3DGestureAsyncData>(__func__);
+  data->kind = kind;
+  data->particle_depth_session = depth_session;
+  data->manager = CTX_wm_manager(C);
+  data->window = CTX_wm_window(C);
+  data->timer = WM_event_timer_add(data->manager, data->window, TIMER, 0.01f);
+  if (data->timer == nullptr) {
+    PE_depth_cache_session_free(depth_session);
+    MEM_delete(data);
+    return false;
+  }
+  op->customdata = data;
+  view3d_particle_gesture_async_operators.append(op);
+  if ((op->flag & OP_IS_INVOKE) == 0) {
+    WM_event_add_modal_handler(C, op);
+  }
+  return true;
+}
+
+static wmOperatorStatus view3d_particle_gesture_async_start(
+    bContext *C,
+    wmOperator *op,
+    const View3DGestureAsyncKind kind,
+    const View3DParticleGestureApplyFn apply)
+{
+  ParticleEditDepthCacheSession *depth_session = PE_depth_cache_session_create();
+  const ParticleEditOperationResult result = apply(C, op, depth_session);
+  if (result == ParticleEditOperationResult::Pending) {
+    if (!view3d_particle_gesture_async_begin(C, op, kind, depth_session)) {
+      BKE_report(op->reports, RPT_ERROR, "Unable to retain particle selection depth request");
+      return OPERATOR_CANCELLED;
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+  PE_depth_cache_session_free(depth_session);
+  if (result == ParticleEditOperationResult::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Particle selection depth readback failed");
+  }
+  return view3d_particle_operation_status(result);
+}
+
+static wmOperatorStatus view3d_particle_gesture_async_modal(
+    bContext *C,
+    wmOperator *op,
+    const wmEvent *event,
+    const View3DParticleGestureApplyFn apply)
+{
+  View3DGestureAsyncData *data = static_cast<View3DGestureAsyncData *>(op->customdata);
+  if ((event->type == EVT_ESCKEY && event->val == KM_PRESS) ||
+      (event->type == EVT_MODAL_MAP && event->val == GESTURE_MODAL_CANCEL))
+  {
+    view3d_gesture_bitmap_async_data_end(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (data == nullptr || data->particle_depth_session == nullptr || event->type != TIMER ||
+      event->customdata != data->timer)
+  {
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++data->tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for particle selection depth");
+    view3d_gesture_bitmap_async_data_end(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  const ParticleEditDepthCacheState state = PE_depth_cache_session_state(
+      C, data->particle_depth_session);
+  if (state == ParticleEditDepthCacheState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == ParticleEditDepthCacheState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Particle selection depth context changed");
+    view3d_gesture_bitmap_async_data_end(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const ParticleEditOperationResult operation_result = apply(
+      C, op, data->particle_depth_session);
+  if (operation_result == ParticleEditOperationResult::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (operation_result == ParticleEditOperationResult::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Particle selection depth could not be consumed");
+  }
+  const wmOperatorStatus result = view3d_particle_operation_status(operation_result);
+  view3d_gesture_bitmap_async_data_end(C, op);
+  return result;
+}
