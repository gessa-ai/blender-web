+static wmOperatorStatus curve_draw_depth_poll(bContext *C,
+                                              wmOperator *op,
+                                              const wmEvent *event)
+{
+  CurveDrawData *cdd = static_cast<CurveDrawData *>(op->customdata);
+  if (cdd == nullptr || !cdd->depth_cache_pending ||
+      !curve_draw_depth_context_matches(C, cdd))
+  {
+    BKE_report(op->reports, RPT_ERROR, "Viewport changed while waiting for curve depth cache");
+    curve_draw_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+
+  if (ELEM(event->type, EVT_ESCKEY, RIGHTMOUSE)) {
+    curve_draw_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+  if (event->type != TIMER || event->customdata != cdd->depth_cache_timer) {
+    if (event->type == TIMER) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (!curve_draw_depth_event_push(cdd, event)) {
+      BKE_report(op->reports, RPT_ERROR, "Curve depth event queue exceeded its safe bound");
+      curve_draw_exit(op);
+      return OPERATOR_CANCELLED;
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++cdd->depth_cache_tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for curve depth cache");
+    curve_draw_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const ViewportDepthCacheSession::ReadbackState state = cdd->depth_cache_session->state();
+  if (state == ViewportDepthCacheSession::ReadbackState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == ViewportDepthCacheSession::ReadbackState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Curve depth cache readback failed");
+    curve_draw_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+
+  cdd->depths = cdd->depth_cache_session->take(cdd->vc.region);
+  if (cdd->depths == nullptr) {
+    BKE_report(op->reports, RPT_ERROR, "Curve depth cache became stale before settlement");
+    curve_draw_exit(op);
+    return OPERATOR_CANCELLED;
+  }
+  cdd->project.use_depth = true;
+  cdd->depth_cache_pending = false;
+  MEM_SAFE_DELETE(cdd->depth_cache_session);
+  curve_draw_project_finalize(cdd);
+  curve_draw_depth_timer_remove(cdd);
+
+  Vector<wmEvent> *queued_events = cdd->depth_cache_events;
+  cdd->depth_cache_events = nullptr;
+  for (const wmEvent &queued : *queued_events) {
+    const wmOperatorStatus result = curve_draw_modal_dispatch(C, op, &queued);
+    if (result != OPERATOR_RUNNING_MODAL) {
+      MEM_delete(queued_events);
+      return result;
+    }
+  }
+  MEM_delete(queued_events);
+  return OPERATOR_RUNNING_MODAL;
+}
