diff --git a/source/blender/gpu/GPU_readback.hh b/source/blender/gpu/GPU_readback.hh
new file mode 100644
index 0000000000000000000000000000000000000000..428b10ca27419de0f0ffec1b3c6237e8173d1e76
--- /dev/null
+++ b/source/blender/gpu/GPU_readback.hh
@@ -0,0 +1,56 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Owned, non-blocking GPU readback results. A request never retains a caller
+ * destination pointer. The result owns its bytes until it is consumed or
+ * canceled, so callers may poll it across event-loop ticks.
+ */
+
+#pragma once
+
+#include <cstddef>
+
+namespace blender {
+
+struct GPUReadback;
+
+enum eGPUReadbackStatus {
+  GPU_READBACK_INVALID = 0,
+  GPU_READBACK_PENDING,
+  GPU_READBACK_READY,
+  GPU_READBACK_FAILED,
+};
+
+enum eGPUReadbackError {
+  GPU_READBACK_ERROR_NONE = 0,
+  GPU_READBACK_ERROR_INVALID_ARGUMENT,
+  GPU_READBACK_ERROR_UNSUPPORTED_FORMAT,
+  GPU_READBACK_ERROR_CAPACITY_EXCEEDED,
+  GPU_READBACK_ERROR_ALLOCATION_FAILED,
+  GPU_READBACK_ERROR_MAP_FAILED,
+  GPU_READBACK_ERROR_NO_MAPPED_RANGE,
+  GPU_READBACK_ERROR_SOURCE_UNAVAILABLE,
+  GPU_READBACK_ERROR_BACKEND_FAILURE,
+};
+
+eGPUReadbackStatus GPU_readback_status(GPUReadback *readback);
+eGPUReadbackError GPU_readback_error(GPUReadback *readback);
+
+/** Final caller-visible byte size, after any backend-to-host format conversion. */
+size_t GPU_readback_size(GPUReadback *readback);
+
+/**
+ * Consume a ready result exactly once. On success the result is freed and
+ * `readback` is set to null. Pending, failed, or undersized requests are left
+ * intact for the caller to poll, inspect, or cancel.
+ */
+bool GPU_readback_consume(GPUReadback *&readback, void *dst, size_t dst_len);
+
+/** Cancel or release any result, including pending backend work, and set it to null. */
+void GPU_readback_cancel(GPUReadback *&readback);
+
+}  // namespace blender
