+/** Validated unsigned parameters for one direct WebGPU draw. */
+struct DirectDrawPlan {
+  uint32_t vertex_first = 0;
+  uint32_t vertex_count = 0;
+  uint32_t instance_first = 0;
+  uint32_t instance_count = 0;
+};
+
+/** Convert Blender's signed backend parameters only after the frontend has resolved its
+ * zero-count defaults. WebGPU accepts unsigned values, so negative inputs would otherwise
+ * become very large draws. Failure leaves `result` unchanged. */
+inline bool direct_draw_plan(int vertex_first,
+                             int vertex_count,
+                             int instance_first,
+                             int instance_count,
+                             DirectDrawPlan &result)
+{
+  if (vertex_first < 0 || vertex_count <= 0 || instance_first < 0 || instance_count <= 0) {
+    return false;
+  }
+
+  DirectDrawPlan candidate;
+  candidate.vertex_first = uint32_t(vertex_first);
+  candidate.vertex_count = uint32_t(vertex_count);
+  candidate.instance_first = uint32_t(instance_first);
+  candidate.instance_count = uint32_t(instance_count);
+  result = candidate;
+  return true;
+}
