+{
+  return CTX_wm_manager(C) == p->depth_cache_manager && CTX_wm_window(C) == p->win &&
+         CTX_wm_screen(C) == p->depth_cache_screen && CTX_wm_area(C) == p->area &&
+         CTX_wm_region(C) == p->region &&
+         CTX_wm_region_view3d(C) == static_cast<RegionView3D *>(p->region->regiondata) &&
+         CTX_wm_view3d(C) == static_cast<View3D *>(p->area->spacedata.first) &&
+         CTX_data_scene(C) == p->scene;
+}
+
+static wmOperatorStatus annotation_depth_fail(bContext *C,
+                                              wmOperator *op,
+                                              const char *message)
+{
+  BKE_report(op->reports, RPT_ERROR, message);
+  annotation_draw_abort(C, op);
+  return OPERATOR_CANCELLED;
+}
+
+static wmOperatorStatus annotation_depth_resume_apply_event(bContext *C,
+                                                             wmOperator *op,
+                                                             const wmEvent *event)
+{
+  tGPsdata *p = static_cast<tGPsdata *>(op->customdata);
+  annotation_draw_apply_event(
+      op, event, CTX_data_ensure_evaluated_depsgraph(C), 0.0f, 0.0f);
+  if (p->status == GP_STATUS_ERROR || !annotation_area_exists(C, p->area)) {
+    return annotation_depth_fail(C, op, "Annotation stroke failed after depth settlement");
+  }
+  annotation_draw_status_indicators(C, p);
+  annotation_draw_cursor_set(p);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static wmOperatorStatus annotation_depth_poll(bContext *C,
+                                               wmOperator *op,
+                                               const wmEvent *event)
+{
+  tGPsdata *p = static_cast<tGPsdata *>(op->customdata);
+  if (p == nullptr || !p->depth_cache_pending || !annotation_depth_context_matches(C, p)) {
+    return annotation_depth_fail(C, op, "Viewport changed while waiting for annotation depth");
+  }
+
+  if (event->type != TIMER || event->customdata != p->depth_cache_timer) {
+    if (event->type == TIMER) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (!annotation_depth_event_push(p, event)) {
+      return annotation_depth_fail(C, op, "Annotation depth event queue exceeded its safe bound");
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++p->depth_cache_tick_count > max_tick_count) {
+    return annotation_depth_fail(C, op, "Timed out waiting for annotation depth cache");
+  }
+
+  const ViewportDepthCacheSession::ReadbackState state = p->depth_cache_session->state();
+  if (state == ViewportDepthCacheSession::ReadbackState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == ViewportDepthCacheSession::ReadbackState::Failed ||
+      !annotation_depth_cache_take(p))
+  {
+    return annotation_depth_fail(C, op, "Annotation depth-cache readback failed");
+  }
+
+  annotation_depth_timer_remove(p);
+  p->depth_cache_pending = false;
+  p->depth_cache_manager = nullptr;
+  p->depth_cache_screen = nullptr;
+  Vector<wmEvent> *queued_events = p->depth_cache_events;
+  p->depth_cache_events = nullptr;
+  const bool resume_apply_event = p->depth_cache_resume_apply_event;
+  p->depth_cache_resume_apply_event = false;
+
+  for (int64_t index = 0; index < queued_events->size(); index++) {
+    const wmOperatorStatus result = (index == 0 && resume_apply_event) ?
+                                        annotation_depth_resume_apply_event(
+                                            C, op, &(*queued_events)[index]) :
+                                        annotation_draw_modal(C, op, &(*queued_events)[index]);
+    if (result & (OPERATOR_FINISHED | OPERATOR_CANCELLED)) {
+      MEM_delete(queued_events);
+      return result;
+    }
+
+    p = static_cast<tGPsdata *>(op->customdata);
+    if (p == nullptr) {
+      MEM_delete(queued_events);
+      return OPERATOR_CANCELLED;
+    }
+    if (p->depth_cache_pending) {
+      for (int64_t remaining = index + 1; remaining < queued_events->size(); remaining++) {
+        if (!annotation_depth_event_push(p, &(*queued_events)[remaining])) {
+          MEM_delete(queued_events);
+          return annotation_depth_fail(
+              C, op, "Annotation depth replay exceeded its safe event bound");
+        }
+      }
+      MEM_delete(queued_events);
+      return OPERATOR_RUNNING_MODAL;
+    }
+  }
+
+  MEM_delete(queued_events);
+  return OPERATOR_RUNNING_MODAL;
+}
+
+static wmOperatorStatus annotation_draw_modal(bContext *C,
+                                               wmOperator *op,
+                                               const wmEvent *event)
+{
+  tGPsdata *p = static_cast<tGPsdata *>(op->customdata);
+  if (p == nullptr) {
+    return OPERATOR_CANCELLED;
+  }
+  if (p->depth_cache_pending) {
+    return annotation_depth_poll(C, op, event);
+  }
+  if (annotation_depth_event_requires_cache(p, event)) {
+    const AnnotationDepthCacheState state = annotation_depth_cache_defer_event(
+        C, p, event, annotation_depth_cache_mode_get(p));
+    if (state == AnnotationDepthCacheState::Pending) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (state == AnnotationDepthCacheState::Failed) {
+      return annotation_depth_fail(C, op, "Unable to prepare annotation depth cache");
+    }
+  }
+  return annotation_draw_modal_dispatch(C, op, event);
+}
