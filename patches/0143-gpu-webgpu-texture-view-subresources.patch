+  EXPECT_NEAR((*no_attachment_bytes)[0], 137, 2);
+  EXPECT_NEAR((*no_attachment_bytes)[1], 188, 2);
+  EXPECT_NEAR((*no_attachment_bytes)[2], 225, 2);
+  MEM_delete(no_attachment_bytes);
+
+  GPU_texture_free(srgb_no_attachment);
