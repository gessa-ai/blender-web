+static void test_texture_view_webgpu_depth_stencil_layers_and_blits()
+{
+  GPU_render_begin();
+  constexpr int width = 2;
+  constexpr int height = 2;
+  constexpr int pixels = width * height;
+  constexpr eGPUTextureUsage usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                     GPU_TEXTURE_USAGE_HOST_READ |
+                                     GPU_TEXTURE_USAGE_FORMAT_VIEW;
+  const TextureFormat format = TextureFormat::SFLOAT_32_DEPTH_UINT_8;
+  gpu::Texture *source = GPU_texture_create_2d_array(
+      __func__, width, height, 2, 1, format, usage, nullptr);
+  ASSERT_NE(source, nullptr);
+  gpu::FrameBuffer *source_all_fb = nullptr;
+  GPU_framebuffer_ensure_config(
+      &source_all_fb, {GPU_ATTACHMENT_TEXTURE(source), GPU_ATTACHMENT_NONE});
+  GPU_framebuffer_clear_depth_stencil(source_all_fb, 0.25f, 3u);
+  GPU_framebuffer_free(source_all_fb);
+
+  gpu::Texture *depth0 = GPU_texture_create_view(
+      __func__, source, format, 0, 1, 0, 1, false, false);
+  gpu::Texture *depth_outer = GPU_texture_create_view(
+      __func__, source, format, 0, 1, 0, 2, false, false);
+  gpu::Texture *depth1 = GPU_texture_create_view(
+      __func__, depth_outer, format, 0, 1, 1, 1, false, false);
+  gpu::Texture *stencil0 = GPU_texture_create_view(
+      __func__, source, format, 0, 1, 0, 1, false, true);
+  gpu::Texture *stencil_outer = GPU_texture_create_view(
+      __func__, source, format, 0, 1, 0, 2, false, true);
+  gpu::Texture *stencil1 = GPU_texture_create_view(
+      __func__, stencil_outer, format, 0, 1, 1, 1, false, false);
+  ASSERT_NE(depth0, nullptr);
+  ASSERT_NE(depth_outer, nullptr);
+  ASSERT_NE(depth1, nullptr);
+  ASSERT_NE(stencil0, nullptr);
+  ASSERT_NE(stencil_outer, nullptr);
+  ASSERT_NE(stencil1, nullptr);
+
+  /* A nested single-aspect view cannot switch to the sibling aspect. */
+  gpu::Texture *widened = GPU_texture_create_view(
+      __func__, depth_outer, format, 0, 1, 0, 1, false, true);
+  EXPECT_EQ(widened, nullptr);
+  gpu::Texture *plain_depth = GPU_texture_create_2d(
+      __func__, width, height, 1, TextureFormat::SFLOAT_32_DEPTH, usage, nullptr);
+  ASSERT_NE(plain_depth, nullptr);
+  gpu::Texture *invalid_stencil = GPU_texture_create_view(__func__,
+                                                           plain_depth,
+                                                           TextureFormat::SFLOAT_32_DEPTH,
+                                                           0,
+                                                           1,
+                                                           0,
+                                                           1,
+                                                           false,
+                                                           true);
+  EXPECT_EQ(invalid_stencil, nullptr);
+  GPU_texture_free(plain_depth);
+
+  GPU_texture_free(depth_outer);
+  GPU_texture_free(stencil_outer);
+
+  /* Direct depth clear follows the same relative-mip-zero contract as colour. */
+  gpu::Texture *depth_mips = GPU_texture_create_2d(
+      __func__, width, height, 2, TextureFormat::SFLOAT_32_DEPTH, usage, nullptr);
+  ASSERT_NE(depth_mips, nullptr);
+  gpu::Texture *depth_mip1 = GPU_texture_create_view(__func__,
+                                                      depth_mips,
+                                                      TextureFormat::SFLOAT_32_DEPTH,
+                                                      1,
+                                                      1,
+                                                      0,
+                                                      1,
+                                                      false,
+                                                      false);
+  ASSERT_NE(depth_mip1, nullptr);
+  GPU_texture_clear(depth_mip1, GPU_DATA_FLOAT, float4(0.2f));
+  GPU_texture_clear(depth_mips, GPU_DATA_FLOAT, float4(0.6f));
+  float *depth_mip0_values = static_cast<float *>(
+      GPU_texture_read(depth_mips, GPU_DATA_FLOAT, 0));
+  float *depth_mip1_values = static_cast<float *>(
+      GPU_texture_read(depth_mip1, GPU_DATA_FLOAT, 0));
+  ASSERT_NE(depth_mip0_values, nullptr);
+  ASSERT_NE(depth_mip1_values, nullptr);
+  for (int i = 0; i < pixels; i++) {
+    EXPECT_NEAR(depth_mip0_values[i], 0.6f, 1e-6f);
+  }
+  EXPECT_NEAR(depth_mip1_values[0], 0.2f, 1e-6f);
+  MEM_delete(depth_mip1_values);
+  MEM_delete(depth_mip0_values);
+  GPU_texture_free(depth_mip1);
+  GPU_texture_free(depth_mips);
+
+  auto expect_depth = [&](gpu::Texture *texture, float expected) {
+    float *bytes = static_cast<float *>(GPU_texture_read(texture, GPU_DATA_FLOAT, 0));
+    ASSERT_NE(bytes, nullptr);
+    for (int i = 0; i < pixels; i++) {
+      EXPECT_NEAR(bytes[i], expected, 1e-6f);
+    }
+    MEM_delete(bytes);
+  };
+  auto expect_stencil = [&](gpu::Texture *texture, uint expected) {
+    uint *bytes = static_cast<uint *>(GPU_texture_read(texture, GPU_DATA_UINT, 0));
+    ASSERT_NE(bytes, nullptr);
+    for (int i = 0; i < pixels; i++) {
+      EXPECT_EQ(bytes[i], expected);
+    }
+    MEM_delete(bytes);
+  };
+  expect_depth(depth0, 0.25f);
+  expect_depth(depth1, 0.25f);
+  expect_stencil(stencil0, 3u);
+  expect_stencil(stencil1, 3u);
+
+  /* Root direct texture clear matches Vulkan: combined depth/stencil clears
+   * depth only and never consumes a second (possibly unspecified) component. */
+  GPU_texture_clear(source, GPU_DATA_FLOAT, float4(0.6f, 1.0f, 1.0f, 1.0f));
+  expect_depth(depth0, 0.6f);
+  expect_depth(depth1, 0.6f);
+  expect_stencil(stencil0, 3u);
+  expect_stencil(stencil1, 3u);
+  GPU_texture_clear(stencil1, GPU_DATA_FLOAT, float4(0.8f));
+  expect_depth(depth0, 0.6f);
+  expect_depth(depth1, 0.8f);
+  expect_stencil(stencil0, 3u);
+  expect_stencil(stencil1, 3u);
+  GPU_texture_clear(source, GPU_DATA_FLOAT, float4(0.25f));
+  GPU_texture_free(source);
+
+  gpu::FrameBuffer *source_depth_fb = nullptr;
+  gpu::FrameBuffer *source_stencil_fb = nullptr;
+  GPU_framebuffer_ensure_config(
+      &source_depth_fb, {GPU_ATTACHMENT_TEXTURE(depth1), GPU_ATTACHMENT_NONE});
+  GPU_framebuffer_ensure_config(
+      &source_stencil_fb, {GPU_ATTACHMENT_TEXTURE(stencil1), GPU_ATTACHMENT_NONE});
+  /* The attachment view is necessarily combined Depth32FloatStencil8, but the
+   * flattened Blender view remains single-aspect. Impossible clear planes must
+   * load/preserve the sibling aspect rather than widening through the backing. */
+  GPU_framebuffer_clear_stencil(source_depth_fb, 11u);
+  expect_depth(depth1, 0.25f);
+  expect_stencil(stencil1, 3u);
+  GPU_framebuffer_clear_depth(source_stencil_fb, 0.75f);
+  expect_depth(depth1, 0.25f);
+  expect_stencil(stencil1, 3u);
+  GPU_framebuffer_clear_depth(source_depth_fb, 0.5f);
+  expect_depth(depth1, 0.5f);
+  expect_stencil(stencil1, 3u);
+  GPU_framebuffer_clear_depth(source_depth_fb, 0.25f);
+  GPU_framebuffer_clear_stencil(source_stencil_fb, 7u);
+  expect_depth(depth1, 0.25f);
+  expect_stencil(stencil1, 7u);
+  GPU_framebuffer_clear_stencil(source_stencil_fb, 3u);
+
+#ifdef WITH_WEBGPU_BACKEND
+  static_cast<WGPUFrameBuffer *>(source_depth_fb)
+      ->clear_attachment(GPU_FB_DEPTH_STENCIL_ATTACHMENT, double4(0.6, 13.0, 0.0, 0.0));
+  expect_depth(depth1, 0.6f);
+  expect_stencil(stencil1, 3u);
+  GPU_framebuffer_clear_depth(source_depth_fb, 0.25f);
+  static_cast<WGPUFrameBuffer *>(source_stencil_fb)
+      ->clear_attachment(GPU_FB_DEPTH_STENCIL_ATTACHMENT, double4(0.9, 13.0, 0.0, 0.0));
+  expect_depth(depth1, 0.25f);
+  expect_stencil(stencil1, 13u);
+  GPU_framebuffer_clear_stencil(source_stencil_fb, 3u);
+
+  auto execute_load_clear = [](gpu::FrameBuffer *framebuffer, double depth_value) {
+    GPULoadStore action = {GPU_LOADACTION_CLEAR,
+                           GPU_STOREACTION_STORE,
+                           {depth_value, 0.0, 0.0, 0.0}};
+    GPU_framebuffer_bind_loadstore(framebuffer, &action, 1);
+    WGPUContext *context = static_cast<WGPUContext *>(Context::get());
+    wgpu::CommandEncoder encoder = context->device_get().CreateCommandEncoder();
+    wgpu::RenderPassEncoder pass =
+        static_cast<WGPUFrameBuffer *>(framebuffer)->begin_load_pass(encoder, 0);
+    pass.End();
+    wgpu::CommandBuffer command = encoder.Finish();
+    context->queue_get().Submit(1, &command);
+    GPU_framebuffer_restore();
+  };
+  execute_load_clear(source_depth_fb, 0.7);
+  expect_depth(depth1, 0.7f);
+  expect_stencil(stencil1, 3u);
+  GPU_framebuffer_clear_depth(source_depth_fb, 0.25f);
+  execute_load_clear(source_stencil_fb, 0.9);
+  expect_depth(depth1, 0.25f);
+  expect_stencil(stencil1, 0u);
+  GPU_framebuffer_clear_stencil(source_stencil_fb, 3u);
+#endif
+
+  gpu::Texture *destination = GPU_texture_create_2d_array(
+      __func__, width, height, 2, 1, format, usage, nullptr);
+  ASSERT_NE(destination, nullptr);
+  gpu::FrameBuffer *destination_all_fb = nullptr;
+  GPU_framebuffer_ensure_config(
+      &destination_all_fb, {GPU_ATTACHMENT_TEXTURE(destination), GPU_ATTACHMENT_NONE});
+  GPU_framebuffer_clear_depth_stencil(destination_all_fb, 0.75f, 9u);
+  gpu::Texture *dst_depth1 = GPU_texture_create_view(
+      __func__, destination, format, 0, 1, 1, 1, false, false);
+  gpu::Texture *dst_stencil1 = GPU_texture_create_view(
+      __func__, destination, format, 0, 1, 1, 1, false, true);
+  ASSERT_NE(dst_depth1, nullptr);
+  ASSERT_NE(dst_stencil1, nullptr);
+
+  gpu::FrameBuffer *destination_depth_fb = nullptr;
+  GPU_framebuffer_ensure_config(
+      &destination_depth_fb, {GPU_ATTACHMENT_TEXTURE(dst_depth1), GPU_ATTACHMENT_NONE});
+  GPU_framebuffer_blit(source_depth_fb, 0, destination_depth_fb, 0, GPU_DEPTH_BIT);
+  expect_depth(dst_depth1, 0.25f);
+  expect_stencil(dst_stencil1, 9u);
+
+  GPU_framebuffer_clear_depth_stencil(destination_all_fb, 0.75f, 9u);
+  gpu::FrameBuffer *destination_stencil_fb = nullptr;
+  GPU_framebuffer_ensure_config(
+      &destination_stencil_fb, {GPU_ATTACHMENT_TEXTURE(dst_stencil1), GPU_ATTACHMENT_NONE});
+  GPU_framebuffer_blit(source_stencil_fb, 0, destination_stencil_fb, 0, GPU_STENCIL_BIT);
+  expect_depth(dst_depth1, 0.75f);
+  expect_stencil(dst_stencil1, 3u);
+
+  GPU_framebuffer_free(destination_stencil_fb);
+  GPU_framebuffer_free(source_stencil_fb);
+  GPU_framebuffer_free(destination_depth_fb);
+  GPU_framebuffer_free(source_depth_fb);
+  GPU_framebuffer_free(destination_all_fb);
+  GPU_texture_free(dst_stencil1);
+  GPU_texture_free(dst_depth1);
+  GPU_texture_free(destination);
+  GPU_texture_free(stencil1);
+  GPU_texture_free(stencil0);
+  GPU_texture_free(depth1);
+  GPU_texture_free(depth0);
+  GPU_render_end();
+}
