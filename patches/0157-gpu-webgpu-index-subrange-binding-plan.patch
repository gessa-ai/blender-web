diff --git a/source/blender/gpu/webgpu/wgpu_index_buffer.hh b/source/blender/gpu/webgpu/wgpu_index_buffer.hh
index bcfea24..139fa2a 100644
--- a/source/blender/gpu/webgpu/wgpu_index_buffer.hh
+++ b/source/blender/gpu/webgpu/wgpu_index_buffer.hh
@@ -23 +23,3 @@
+#include <cstdint>
+
 #include "GPU_index_buffer.hh"
@@ -30 +32,24 @@
+namespace webgpu {
+
+/** Complete WebGPU indexed-draw binding state derived from IndexBuf metadata.
+ *
+ * Subranges share their parent's allocation, so index_start_get() must become
+ * the SetIndexBuffer byte offset. Squeezed Uint16 buffers store indices relative
+ * to index_base_get(), which must become DrawIndexed's baseVertex. Keeping both
+ * values together prevents alternate pass encoders from silently dropping half
+ * of the binding contract. */
+struct IndexBindingPlan {
+  uint64_t byte_offset = 0;
+  int32_t base_vertex = 0;
+};
+
+inline IndexBindingPlan index_binding_plan(const IndexBuf &index_buffer)
+{
+  const uint64_t index_size = index_buffer.is_32bit() ? sizeof(uint32_t) : sizeof(uint16_t);
+  return {uint64_t(index_buffer.index_start_get()) * index_size,
+          int32_t(index_buffer.index_base_get())};
+}
+
+}  // namespace webgpu
+
 class WGPUIndexBuffer : public IndexBuf {
  public:
   ~WGPUIndexBuffer() override;
