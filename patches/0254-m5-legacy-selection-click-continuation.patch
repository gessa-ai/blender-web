+static uint drw_select_buffer_sample_point_result(const uint *buf, const uint buf_len)
+{
+  if (buf == nullptr) {
+    BLI_assert(buf_len == 0);
+    return 0;
+  }
+  BLI_assert(buf_len == 1);
+  return buf[0];
+}
+
+static uint drw_select_buffer_find_nearest_to_point_result(const uint *buf,
+                                                           const uint buf_len,
+                                                           const int width,
+                                                           const int height,
+                                                           const uint id_min,
+                                                           const uint id_max,
+                                                           uint *dist)
+{
+  if (buf == nullptr) {
+    BLI_assert(buf_len == 0);
+    return 0;
+  }
+  BLI_assert(buf_len == uint(width * height));
+
+  const int shape[2] = {height, width};
+  const int center_yx[2] = {(height - 1) / 2, (width - 1) / 2};
+  SelectReadData data = {nullptr, id_min, id_max, 0};
+  BLI_array_iter_spiral_square(buf, shape, center_yx, select_buffer_test_fn, &data);
+
+  if (data.val_ptr) {
+    size_t offset = (size_t(data.val_ptr) - size_t(buf)) / sizeof(*buf);
+    int hit_x = offset % width;
+    int hit_y = offset / width;
+    *dist = uint(abs(hit_y - center_yx[0]) + abs(hit_x - center_yx[1]));
+  }
+  return data.r_index;
+}
+
+enum class DRWSelectBufferQueryKind : uint8_t {
+  Sample,
+  Nearest,
+};
+
+struct DRWSelectBufferQueryContext {
+  Vector<Object *> objects;
+  Map<Object *, ElemIndexRanges> elem_ranges;
+  uint max_index_drawn_len = 0;
+  short select_mode = 0;
+};
+
+struct DRWSelectBufferQueryKey {
+  DRWSelectBufferQueryKind kind = DRWSelectBufferQueryKind::Sample;
+  Depsgraph *depsgraph = nullptr;
+  ARegion *region = nullptr;
+  View3D *v3d = nullptr;
+  rcti rect = {};
+  uint id_min = 0;
+  uint id_max = 0;
+  uint initial_distance = 0;
+  short select_mode = 0;
+  Vector<Object *> objects;
+};
+
+struct DRWSelectBufferQueryResult {
+  DRWSelectBufferQueryKey key;
+  DRWSelectBufferQueryContext context;
+  uint index = 0;
+  uint distance = 0;
+};
+
+struct DRWSelectBufferQueryState {
+  bool session_active = false;
+  bool failed = false;
+  bool replay_required = false;
+  eGPUReadbackError error = GPU_READBACK_ERROR_NONE;
+  DRWSelectBufferReadback *pending = nullptr;
+  DRWSelectBufferQueryKey pending_key;
+  DRWSelectBufferQueryContext pending_context;
+  Vector<DRWSelectBufferQueryResult> results;
+};
+
+static DRWSelectBufferQueryState g_select_buffer_query = {};
+
+static DRWSelectBufferQueryContext drw_select_buffer_query_context_capture()
+{
+  DRWSelectBufferQueryContext snapshot;
+  const SELECTID_Context *select_ctx = DRW_select_engine_context_get();
+  if (select_ctx == nullptr) {
+    return snapshot;
+  }
+  snapshot.objects.extend(select_ctx->objects);
+  for (const auto &item : select_ctx->elem_ranges.items()) {
+    snapshot.elem_ranges.add(item.key, item.value);
+  }
+  snapshot.max_index_drawn_len = select_ctx->max_index_drawn_len;
+  snapshot.select_mode = select_ctx->select_mode;
+  return snapshot;
+}
+
+static void drw_select_buffer_query_context_restore(const DRWSelectBufferQueryContext &snapshot)
+{
+  SELECTID_Context *select_ctx = DRW_select_engine_context_get();
+  if (select_ctx == nullptr) {
+    return;
+  }
+  select_ctx->objects.clear();
+  select_ctx->objects.extend(snapshot.objects);
+  select_ctx->elem_ranges.clear();
+  for (const auto &item : snapshot.elem_ranges.items()) {
+    select_ctx->elem_ranges.add(item.key, item.value);
+  }
+  select_ctx->max_index_drawn_len = snapshot.max_index_drawn_len;
+  select_ctx->select_mode = snapshot.select_mode;
+}
+
+static DRWSelectBufferQueryKey drw_select_buffer_query_key_create(
+    const DRWSelectBufferQueryKind kind,
+    Depsgraph *depsgraph,
+    ARegion *region,
+    View3D *v3d,
+    const rcti &rect,
+    const uint id_min,
+    const uint id_max,
+    const uint initial_distance)
+{
+  DRWSelectBufferQueryKey key;
+  key.kind = kind;
+  key.depsgraph = depsgraph;
+  key.region = region;
+  key.v3d = v3d;
+  key.rect = rect;
+  key.id_min = id_min;
+  key.id_max = id_max;
+  key.initial_distance = initial_distance;
+  const SELECTID_Context *select_ctx = DRW_select_engine_context_get();
+  if (select_ctx != nullptr) {
+    key.select_mode = select_ctx->select_mode;
+    key.objects.extend(select_ctx->objects);
+  }
+  return key;
+}
+
+static bool drw_select_buffer_query_key_equal(const DRWSelectBufferQueryKey &left,
+                                              const DRWSelectBufferQueryKey &right)
+{
+  if (left.kind != right.kind || left.depsgraph != right.depsgraph ||
+      left.region != right.region || left.v3d != right.v3d ||
+      !BLI_rcti_compare(&left.rect, &right.rect) || left.id_min != right.id_min ||
+      left.id_max != right.id_max || left.initial_distance != right.initial_distance ||
+      left.select_mode != right.select_mode || left.objects.size() != right.objects.size())
+  {
+    return false;
+  }
+  for (const int64_t i : left.objects.index_range()) {
+    if (left.objects[i] != right.objects[i]) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static void drw_select_buffer_query_fail(const eGPUReadbackError error)
+{
+  DRW_select_buffer_read_async_cancel(g_select_buffer_query.pending);
+  g_select_buffer_query.failed = true;
+  g_select_buffer_query.error = error == GPU_READBACK_ERROR_NONE ?
+                                    GPU_READBACK_ERROR_BACKEND_FAILURE :
+                                    error;
+}
+
+static bool drw_select_buffer_query_result_from_buffer(const DRWSelectBufferQueryKey &key,
+                                                       const uint *buf,
+                                                       const uint buf_len,
+                                                       uint &r_index,
+                                                       uint &r_distance)
+{
+  uint expected_len = 0;
+  if (!drw_select_buffer_len(key.rect, expected_len) ||
+      (buf == nullptr ? buf_len != 0 : buf_len != expected_len))
+  {
+    return false;
+  }
+  r_distance = key.initial_distance;
+  if (key.kind == DRWSelectBufferQueryKind::Sample) {
+    if (expected_len != 1) {
+      return false;
+    }
+    r_index = drw_select_buffer_sample_point_result(buf, buf_len);
+    return true;
+  }
+  const int width = BLI_rcti_size_x(&key.rect);
+  const int height = BLI_rcti_size_y(&key.rect);
+  if (width != height) {
+    return false;
+  }
+  r_index = drw_select_buffer_find_nearest_to_point_result(
+      buf, buf_len, width, height, key.id_min, key.id_max, &r_distance);
+  return true;
+}
+
+void DRW_select_buffer_query_session_begin()
+{
+  DRW_select_buffer_query_session_end();
+  g_select_buffer_query.session_active = true;
+}
+
+void DRW_select_buffer_query_session_end()
+{
+  DRW_select_buffer_read_async_cancel(g_select_buffer_query.pending);
+  g_select_buffer_query = {};
+}
+
+bool DRW_select_buffer_query_session_is_active()
+{
+  return g_select_buffer_query.session_active;
+}
+
+bool DRW_select_buffer_query_session_needs_replay()
+{
+  return g_select_buffer_query.replay_required;
+}
+
+eGPUReadbackStatus DRW_select_buffer_query_session_status()
+{
+  if (!g_select_buffer_query.session_active) {
+    return GPU_READBACK_INVALID;
+  }
+  if (g_select_buffer_query.failed) {
+    return GPU_READBACK_FAILED;
+  }
+  if (g_select_buffer_query.pending == nullptr) {
+    return g_select_buffer_query.results.is_empty() ? GPU_READBACK_INVALID : GPU_READBACK_READY;
+  }
+
+  const eGPUReadbackStatus status =
+      DRW_select_buffer_read_async_status(g_select_buffer_query.pending);
+  if (status == GPU_READBACK_PENDING) {
+    return status;
+  }
+  if (status != GPU_READBACK_READY) {
+    drw_select_buffer_query_fail(
+        DRW_select_buffer_read_async_error(g_select_buffer_query.pending));
+    return GPU_READBACK_FAILED;
+  }
+
+  uint buf_len = 0;
+  uint *buf = DRW_select_buffer_read_async_consume(g_select_buffer_query.pending, &buf_len);
+  if (g_select_buffer_query.pending != nullptr) {
+    const eGPUReadbackError error =
+        DRW_select_buffer_read_async_error(g_select_buffer_query.pending);
+    MEM_delete(buf);
+    drw_select_buffer_query_fail(error);
+    return GPU_READBACK_FAILED;
+  }
+
+  DRWSelectBufferQueryResult result;
+  result.key = std::move(g_select_buffer_query.pending_key);
+  if (!drw_select_buffer_query_result_from_buffer(
+          result.key, buf, buf_len, result.index, result.distance))
+  {
+    MEM_delete(buf);
+    drw_select_buffer_query_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    return GPU_READBACK_FAILED;
+  }
+  MEM_delete(buf);
+  result.context = std::move(g_select_buffer_query.pending_context);
+  g_select_buffer_query.results.append(std::move(result));
+  return GPU_READBACK_READY;
+}
+
+eGPUReadbackError DRW_select_buffer_query_session_error()
+{
+  DRW_select_buffer_query_session_status();
+  return g_select_buffer_query.failed ? g_select_buffer_query.error : GPU_READBACK_ERROR_NONE;
+}
+
+static bool drw_select_buffer_query_replay(const DRWSelectBufferQueryKey &key,
+                                           uint *r_index,
+                                           uint *r_distance)
+{
+  for (const DRWSelectBufferQueryResult &result : g_select_buffer_query.results) {
+    if (drw_select_buffer_query_key_equal(result.key, key)) {
+      drw_select_buffer_query_context_restore(result.context);
+      *r_index = result.index;
+      if (r_distance != nullptr) {
+        *r_distance = result.distance;
+      }
+      g_select_buffer_query.replay_required = false;
+      return true;
+    }
+  }
+  return false;
+}
+
+static uint drw_select_buffer_query(Depsgraph *depsgraph,
+                                    ARegion *region,
+                                    View3D *v3d,
+                                    const DRWSelectBufferQueryKey &key,
+                                    uint *r_distance)
+{
+  if (!g_select_buffer_query.session_active || g_select_buffer_query.failed) {
+    return 0;
+  }
+
+  uint index = 0;
+  const eGPUReadbackStatus status = DRW_select_buffer_query_session_status();
+  if (status == GPU_READBACK_FAILED) {
+    return 0;
+  }
+  if (drw_select_buffer_query_replay(key, &index, r_distance)) {
+    return index;
+  }
+  if (g_select_buffer_query.pending != nullptr) {
+    if (!drw_select_buffer_query_key_equal(g_select_buffer_query.pending_key, key)) {
+      drw_select_buffer_query_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    }
+    g_select_buffer_query.replay_required = true;
+    return 0;
+  }
+
+  g_select_buffer_query.replay_required = true;
+  g_select_buffer_query.pending_key = key;
+  g_select_buffer_query.pending =
+      DRW_select_buffer_read_async(depsgraph, region, v3d, &key.rect);
+  g_select_buffer_query.pending_context = drw_select_buffer_query_context_capture();
+  if (DRW_select_buffer_query_session_status() == GPU_READBACK_READY &&
+      drw_select_buffer_query_replay(key, &index, r_distance))
+  {
+    return index;
+  }
+  return 0;
+}
+
+uint DRW_select_buffer_sample_point(Depsgraph *depsgraph,
+                                    ARegion *region,
+                                    View3D *v3d,
+                                    const int center[2])
+{
+  rcti rect{};
+  rect.xmin = center[0];
+  rect.xmax = center[0] + 1;
+  rect.ymin = center[1];
+  rect.ymax = center[1] + 1;
+
+  uint buf_len;
+  uint *buf = DRW_select_buffer_read(depsgraph, region, v3d, &rect, &buf_len);
+  const uint result = drw_select_buffer_sample_point_result(buf, buf_len);
+  MEM_delete(buf);
+  return result;
+}
+
+uint DRW_select_buffer_sample_point_async(Depsgraph *depsgraph,
+                                          ARegion *region,
+                                          View3D *v3d,
+                                          const int center[2])
+{
+  rcti rect{};
+  rect.xmin = center[0];
+  rect.xmax = center[0] + 1;
+  rect.ymin = center[1];
+  rect.ymax = center[1] + 1;
+  const DRWSelectBufferQueryKey key = drw_select_buffer_query_key_create(
+      DRWSelectBufferQueryKind::Sample, depsgraph, region, v3d, rect, 0, 0, 0);
+  return drw_select_buffer_query(depsgraph, region, v3d, key, nullptr);
+}
