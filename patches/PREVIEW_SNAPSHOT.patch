@@ -0,0 +1,270 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include <cstdint>
+
+enum class WebSplitSchedulerPhase : int {
+  Bootstrap = 0, ParkRequested = 1, Parked = 2, PreparedRequested = 3, Prepared = 4,
+  ApplyRequested = 5, Applied = 6, PageReadyRequested = 7, PageReady = 8,
+  ResumeRequested = 9, Resumed = 10, Error = 11,
+};
+
+enum class WebSplitSchedulerError : int {
+  None = 0, InvalidGeneration = 1, InvalidPhase = 2, WrongGeneration = 3,
+  WrongTarget = 4, JobRunning = 5, BootstrapSchedulerMismatch = 6,
+  SchedulerApplyFailed = 7, ImagePolicyApplyFailed = 8, RollbackFailed = 9,
+  ReadyTransitionFailed = 10, InvalidWorkerPayload = 11,
+};
+
+struct WebSplitWorkerPayload {
+  int workers;
+  int acknowledgements;
+  int instances;
+  int local_instances;
+  int pending;
+  int protocol_errors;
+};
+
+struct WebSplitApplyEffects {
+  bool scheduler_apply;
+  bool image_apply;
+  bool scheduler_rollback;
+  bool image_rollback;
+  bool mark_ready;
+};
+
+struct WebSplitApplyResult {
+  WebSplitSchedulerError error;
+  int scheduler_threads;
+  int override_threads;
+  int openexr_threads;
+  int oiio_threads;
+  bool native_ready;
+  bool reload_required;
+  uint32_t applied_generation;
+};
+
+inline WebSplitApplyResult wm_web_split_apply_reduce(uint32_t generation,
+                                                     const WebSplitApplyEffects &effects);
+
+struct WebSplitControlStepInput {
+  WebSplitSchedulerPhase phase;
+  uint32_t generation;
+  bool jobs_running;
+  bool bootstrap_scheduler_valid;
+  bool bootstrap_image_valid;
+  bool scheduler_observation_valid;
+  WebSplitApplyEffects apply_effects;
+};
+
+struct WebSplitControlStepResult {
+  bool consume_tick;
+  bool publish_ack;
+  bool terminal;
+  WebSplitSchedulerPhase phase;
+  WebSplitSchedulerError error;
+  uint32_t generation;
+  bool reload_required;
+};
+
+inline WebSplitControlStepResult wm_web_split_control_step_reduce(
+    const WebSplitControlStepInput &input)
+{
+  WebSplitControlStepResult result{
+      true, false, false, input.phase, WebSplitSchedulerError::None, input.generation, false};
+  switch (input.phase) {
+    case WebSplitSchedulerPhase::Bootstrap:
+    case WebSplitSchedulerPhase::Resumed:
+      result.consume_tick = false;
+      return result;
+    case WebSplitSchedulerPhase::ParkRequested:
+      if (input.jobs_running) {
+        result.terminal = result.publish_ack = true;
+        result.phase = WebSplitSchedulerPhase::Error;
+        result.error = WebSplitSchedulerError::JobRunning;
+      }
+      else if (!input.bootstrap_scheduler_valid) {
+        result.terminal = result.publish_ack = true;
+        result.phase = WebSplitSchedulerPhase::Error;
+        result.error = WebSplitSchedulerError::BootstrapSchedulerMismatch;
+      }
+      else if (!input.bootstrap_image_valid) {
+        result.terminal = result.publish_ack = true;
+        result.phase = WebSplitSchedulerPhase::Error;
+        result.error = WebSplitSchedulerError::ImagePolicyApplyFailed;
+      }
+      else {
+        result.publish_ack = true;
+        result.phase = WebSplitSchedulerPhase::Parked;
+      }
+      return result;
+    case WebSplitSchedulerPhase::ApplyRequested: {
+      if (!input.scheduler_observation_valid) {
+        result.publish_ack = result.terminal = result.reload_required = true;
+        result.phase = WebSplitSchedulerPhase::Error;
+        result.error = WebSplitSchedulerError::SchedulerApplyFailed;
+        return result;
+      }
+      const WebSplitApplyResult apply = wm_web_split_apply_reduce(input.generation,
+                                                                  input.apply_effects);
+      result.publish_ack = true;
+      result.reload_required = apply.reload_required;
+      result.error = apply.error;
+      result.terminal = apply.error != WebSplitSchedulerError::None;
+      result.phase = result.terminal ? WebSplitSchedulerPhase::Error :
+                                       WebSplitSchedulerPhase::Applied;
+      return result;
+    }
+    case WebSplitSchedulerPhase::ResumeRequested:
+      result.publish_ack = true;
+      result.phase = WebSplitSchedulerPhase::Resumed;
+      return result;
+    case WebSplitSchedulerPhase::PreparedRequested:
+      result.publish_ack = true;
+      result.phase = WebSplitSchedulerPhase::Prepared;
+      return result;
+    case WebSplitSchedulerPhase::PageReadyRequested:
+      result.publish_ack = true;
+      result.phase = WebSplitSchedulerPhase::PageReady;
+      return result;
+    case WebSplitSchedulerPhase::Parked:
+    case WebSplitSchedulerPhase::Prepared:
+    case WebSplitSchedulerPhase::Applied:
+    case WebSplitSchedulerPhase::PageReady:
+    case WebSplitSchedulerPhase::Error:
+      return result;
+  }
+  return result;
+}
+
+/* Shared ACK-last publication seam. The production and unit-test writers are
+ * intentionally injected: payload/phase must be published before generation. */
+template<typename PayloadWriter, typename AckWriter>
+inline void wm_web_split_publish_control_step(const WebSplitControlStepResult &result,
+                                              PayloadWriter &&write_payload,
+                                              AckWriter &&write_ack)
+{
+  if (!result.publish_ack) {
+    return;
+  }
+  write_payload(result);
+  write_ack(result.generation);
+}
+
+inline WebSplitApplyResult wm_web_split_apply_reduce(const uint32_t generation,
+                                                     const WebSplitApplyEffects &effects)
+{
+  WebSplitApplyResult result{WebSplitSchedulerError::None, 1, 1, 0, 1, false, false, 0};
+  if (!effects.scheduler_apply) {
+    result.error = effects.scheduler_rollback ? WebSplitSchedulerError::SchedulerApplyFailed :
+                                                WebSplitSchedulerError::RollbackFailed;
+    result.reload_required = !effects.scheduler_rollback;
+    return result;
+  }
+  result.scheduler_threads = result.override_threads = 8;
+  if (!effects.image_apply) {
+    if (!effects.image_rollback || !effects.scheduler_rollback) {
+      result.error = WebSplitSchedulerError::RollbackFailed;
+      result.reload_required = true;
+      return result;
+    }
+    result.scheduler_threads = result.override_threads = 1;
+    result.error = WebSplitSchedulerError::ImagePolicyApplyFailed;
+    return result;
+  }
+  result.openexr_threads = result.oiio_threads = 8;
+  if (!effects.mark_ready) {
+    result.error = WebSplitSchedulerError::ReadyTransitionFailed;
+    result.reload_required = true;
+    return result;
+  }
+  result.native_ready = true;
+  /* ACK-last: no result field may be mutated after this assignment. */
+  result.applied_generation = generation;
+  return result;
+}
+
+inline bool wm_web_split_worker_payload_valid(const WebSplitWorkerPayload &payload)
+{
+  return payload.workers >= 8 && payload.acknowledgements == payload.workers &&
+         payload.instances == payload.workers && payload.local_instances == 1 &&
+         payload.pending == 0 && payload.protocol_errors == 0;
+}
+
+inline WebSplitSchedulerError wm_web_split_validate_park(const WebSplitSchedulerPhase phase,
+                                                         const uint32_t generation,
+                                                         const uint32_t active_generation)
+{
+  if (generation == 0) return WebSplitSchedulerError::InvalidGeneration;
+  if (phase != WebSplitSchedulerPhase::Bootstrap) return WebSplitSchedulerError::InvalidPhase;
+  if (active_generation != 0) return WebSplitSchedulerError::WrongGeneration;
+  return WebSplitSchedulerError::None;
+}
+
+inline WebSplitSchedulerError wm_web_split_validate_prepared(
+    const WebSplitSchedulerPhase phase,
+    const uint32_t generation,
+    const uint32_t active_generation,
+    const uint32_t parked_generation,
+    const WebSplitWorkerPayload &payload,
+    const uint32_t stabilization_epoch)
+{
+  if (phase != WebSplitSchedulerPhase::Parked) return WebSplitSchedulerError::InvalidPhase;
+  if (generation == 0 || generation != active_generation || generation != parked_generation) {
+    return WebSplitSchedulerError::WrongGeneration;
+  }
+  if (!wm_web_split_worker_payload_valid(payload) || stabilization_epoch == 0) {
+    return WebSplitSchedulerError::InvalidWorkerPayload;
+  }
+  return WebSplitSchedulerError::None;
+}
+
+inline WebSplitSchedulerError wm_web_split_validate_apply(const WebSplitSchedulerPhase phase,
+                                                          const uint32_t generation,
+                                                          const uint32_t active_generation,
+                                                          const uint32_t prepared_generation,
+                                                          const int target_threads)
+{
+  if (phase != WebSplitSchedulerPhase::Prepared) return WebSplitSchedulerError::InvalidPhase;
+  if (generation == 0 || generation != active_generation || generation != prepared_generation) {
+    return WebSplitSchedulerError::WrongGeneration;
+  }
+  return target_threads == 8 ? WebSplitSchedulerError::None : WebSplitSchedulerError::WrongTarget;
+}
+
+inline WebSplitSchedulerError wm_web_split_validate_page_ready(
+    const WebSplitSchedulerPhase phase,
+    const uint32_t generation,
+    const uint32_t active_generation,
+    const uint32_t applied_generation,
+    const WebSplitWorkerPayload &payload,
+    const int prepared_workers,
+    const int late_workers,
+    const uint32_t prepared_epoch,
+    const uint32_t page_ready_epoch)
+{
+  if (phase != WebSplitSchedulerPhase::Applied) return WebSplitSchedulerError::InvalidPhase;
+  if (generation == 0 || generation != active_generation || generation != applied_generation) {
+    return WebSplitSchedulerError::WrongGeneration;
+  }
+  if (!wm_web_split_worker_payload_valid(payload) || payload.workers < prepared_workers ||
+      late_workers != payload.workers - prepared_workers || page_ready_epoch <= prepared_epoch)
+  {
+    return WebSplitSchedulerError::InvalidWorkerPayload;
+  }
+  return WebSplitSchedulerError::None;
+}
+
+inline WebSplitSchedulerError wm_web_split_validate_resume(const WebSplitSchedulerPhase phase,
+                                                           const uint32_t generation,
+                                                           const uint32_t active_generation,
+                                                           const uint32_t page_ready_generation)
+{
+  if (phase != WebSplitSchedulerPhase::PageReady) return WebSplitSchedulerError::InvalidPhase;
+  if (generation == 0 || generation != active_generation || generation != page_ready_generation) {
+    return WebSplitSchedulerError::WrongGeneration;
+  }
+  return WebSplitSchedulerError::None;
+}
