+++ b/source/blender/gpu/webgpu/wgpu_data_conversion.cc
@@ -11,6 +11,8 @@
 
 #include "wgpu_data_conversion.hh"
 
+#include <algorithm>
+#include <cmath>
 #include <cstring>
 
 namespace blender::gpu::webgpu {
@@ -110,4 +112,57 @@ std::vector<uint8_t> promote_for_upload(TextureFormat format,
   return out;
 }
 
+uint32_t pack_rgb9e5_ufloat(float red, float green, float blue)
+{
+  constexpr int mantissa_bits = 9;
+  constexpr int exponent_bias = 15;
+  constexpr int exponent_max = 31;
+  constexpr uint32_t mantissa_mask = (1u << mantissa_bits) - 1u;
+  constexpr float shared_max = float(mantissa_mask) * 128.0f;
+
+  const auto clamp_channel = [=](const float value) {
+    if (std::isnan(value) || value <= 0.0f) {
+      return 0.0f;
+    }
+    return std::min(value, shared_max);
+  };
+  red = clamp_channel(red);
+  green = clamp_channel(green);
+  blue = clamp_channel(blue);
+
+  const float max_channel = std::max(red, std::max(green, blue));
+  if (max_channel == 0.0f) {
+    return 0;
+  }
+
+  int binary_exponent = 0;
+  std::frexp(max_channel, &binary_exponent);
+  int shared_exponent = std::max(-exponent_bias, binary_exponent) + exponent_bias;
+  float scale = std::ldexp(1.0f, shared_exponent - exponent_bias - mantissa_bits);
+  const uint32_t max_mantissa = uint32_t(std::floor(max_channel / scale + 0.5f));
+  if (max_mantissa == (1u << mantissa_bits) && shared_exponent < exponent_max) {
+    shared_exponent++;
+    scale *= 2.0f;
+  }
+
+  const auto encode_mantissa = [=](const float value) {
+    return std::min(uint32_t(std::floor(value / scale + 0.5f)), mantissa_mask);
+  };
+  const uint32_t red_mantissa = encode_mantissa(red);
+  const uint32_t green_mantissa = encode_mantissa(green);
+  const uint32_t blue_mantissa = encode_mantissa(blue);
+  return red_mantissa | (green_mantissa << 9u) | (blue_mantissa << 18u) |
+         (uint32_t(shared_exponent) << 27u);
+}
+
+void unpack_rgb9e5_ufloat(const uint32_t packed, float r_rgb[3])
+{
+  constexpr uint32_t mantissa_mask = (1u << 9u) - 1u;
+  const int exponent = int((packed >> 27u) & 0x1fu);
+  const float scale = std::ldexp(1.0f, exponent - 24);
+  r_rgb[0] = float(packed & mantissa_mask) * scale;
+  r_rgb[1] = float((packed >> 9u) & mantissa_mask) * scale;
+  r_rgb[2] = float((packed >> 18u) & mantissa_mask) * scale;
+}
+
 }  // namespace blender::gpu::webgpu
