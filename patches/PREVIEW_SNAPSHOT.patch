@@ -87,6 +195,116 @@ void gpu_select_next_set_result(GPUSelectResult *hit_buf, uint hit_len)
   g_state.hits = hit_len;
 }
 
+void GPU_select_async_session_begin()
+{
+  GPU_select_async_session_end();
+  g_async.session_active = true;
+}
+
+bool GPU_select_async_session_is_active()
+{
+  return g_async.session_active;
+}
+
+void GPU_select_async_session_end()
+{
+  GPU_readback_cancel(g_async.readback);
+  g_async = {};
+}
+
+eGPUReadbackStatus GPU_select_async_status()
+{
+  if (!g_async.session_active) {
+    return GPU_READBACK_INVALID;
+  }
+  if (g_async.failed) {
+    return GPU_READBACK_FAILED;
+  }
+  if (g_async.readback == nullptr) {
+    return g_async.results.is_empty() ? GPU_READBACK_INVALID : GPU_READBACK_READY;
+  }
+
+  const eGPUReadbackStatus status = GPU_readback_status(g_async.readback);
+  if (status == GPU_READBACK_PENDING) {
+    return status;
+  }
+  if (status != GPU_READBACK_READY) {
+    gpu_select_async_fail(GPU_readback_error(g_async.readback));
+    return GPU_READBACK_FAILED;
+  }
+
+  const size_t byte_size = GPU_readback_size(g_async.readback);
+  if (byte_size == 0 || byte_size % sizeof(uint) != 0) {
+    gpu_select_async_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    return GPU_READBACK_FAILED;
+  }
+
+  Vector<uint> raw(byte_size / sizeof(uint));
+  if (!GPU_readback_consume(g_async.readback, raw.data(), byte_size)) {
+    gpu_select_async_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    return GPU_READBACK_FAILED;
+  }
+
+  GPUSelectAsyncResult result;
+  result.key = g_async.pending_key;
+  gpu_select_async_convert(raw.as_span(),
+                           g_async.select_id_map.as_span(),
+                           g_async.in_front_map.as_span(),
+                           result.key.mode,
+                           result.hits);
+  g_async.results.append(std::move(result));
+  g_async.select_id_map.clear();
+  g_async.in_front_map.clear();
+  return GPU_READBACK_READY;
+}
+
+eGPUReadbackError GPU_select_async_error()
+{
+  return g_async.failed ? g_async.error : GPU_READBACK_ERROR_NONE;
+}
+
+bool GPU_select_async_result_replay(GPUSelectBuffer *buffer,
+                                    const rcti *input,
+                                    const int radius,
+                                    const GPUSelectMode mode,
+                                    int *r_hits)
+{
+  if (buffer == nullptr || input == nullptr || r_hits == nullptr ||
+      GPU_select_async_status() != GPU_READBACK_READY)
+  {
+    return false;
+  }
+
+  const GPUSelectAsyncKey key = gpu_select_async_key_create(input, radius, mode);
+  for (const GPUSelectAsyncResult &result : g_async.results) {
+    if (result.key == key) {
+      buffer->storage.extend(result.hits.as_span());
+      *r_hits = int(result.hits.size());
+      return true;
+    }
+  }
+  return false;
+}
+
+void gpu_select_next_async_readback_begin(GPUReadback *readback,
+                                          const Span<uint> select_id_map,
+                                          const Span<bool> in_front_map)
+{
+  if (!g_async.session_active) {
+    GPU_select_async_session_begin();
+  }
+  if (readback == nullptr || g_async.readback != nullptr || g_async.failed) {
+    GPU_readback_cancel(readback);
+    gpu_select_async_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    return;
+  }
+
+  g_async.pending_key = gpu_select_async_key_from_state();
+  g_async.select_id_map.extend(select_id_map);
+  g_async.in_front_map.extend(in_front_map);
+  g_async.readback = readback;
+}
+
 uint gpu_select_next_end()
 {
   return g_state.hits;
