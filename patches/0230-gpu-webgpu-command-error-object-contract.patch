+  using CompleteT = std::decay_t<CompleteFn>;
+  const auto completion = std::make_shared<CompleteT>(std::forward<CompleteFn>(complete));
+  const std::string operation_label = label ? label : "buffer write";
+  scheduler.enqueue(
+      [instance,
+       device,
+       queue,
+       buffer = std::move(buffer),
+       offset,
+       bytes = std::move(bytes),
+       operation_label,
+       completion](std::function<void(bool)> done) mutable {
+        if (queue == nullptr || buffer == nullptr || bytes.empty()) {
+          (*completion)(false);
