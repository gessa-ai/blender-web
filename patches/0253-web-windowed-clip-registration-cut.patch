From: blender-web contributors
Subject: editors: let the windowed web profile omit Clip registration

The Clip/Motion Tracking editor is outside the launch tier and libmv is
already disabled, while its space-type and macro registration retain a leaf
editor implementation closure. Keep MovieClip data, DNA/RNA, blend loading,
and stock desktop/headless behavior, but let the windowed profile leave those
two editor roots unreachable.

diff --git a/source/blender/editors/space_api/CMakeLists.txt b/source/blender/editors/space_api/CMakeLists.txt
--- a/source/blender/editors/space_api/CMakeLists.txt
+++ b/source/blender/editors/space_api/CMakeLists.txt
@@ -103,3 +103,17 @@ if(WITH_BLENDER_WEB_SPREADSHEET)
 if(WITH_BLENDER_WEB_SPREADSHEET)
   target_compile_definitions(bf_editor_space_api PRIVATE WITH_BLENDER_WEB_SPREADSHEET)
 endif()
+
+# Keep Blender's stock behavior for every non-web or headless build. The
+# windowed browser profile can omit non-launch Clip/Motion Tracking editor
+# registration while retaining MovieClip data, DNA/RNA, and blend loading.
+if(NOT DEFINED WITH_BLENDER_WEB_CLIP)
+  if(WITH_BLENDER_WEB_WINDOWED)
+    set(WITH_BLENDER_WEB_CLIP OFF)
+  else()
+    set(WITH_BLENDER_WEB_CLIP ON)
+  endif()
+endif()
+if(WITH_BLENDER_WEB_CLIP)
+  target_compile_definitions(bf_editor_space_api PRIVATE WITH_BLENDER_WEB_CLIP)
+endif()
diff --git a/source/blender/editors/space_api/spacetypes.cc b/source/blender/editors/space_api/spacetypes.cc
--- a/source/blender/editors/space_api/spacetypes.cc
+++ b/source/blender/editors/space_api/spacetypes.cc
@@ -84,7 +84,9 @@ void ED_spacetypes_init()
 #endif
   ED_spacetype_console();
   ED_spacetype_userpref();
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_CLIP)
   ED_spacetype_clip();
+#endif
   ED_spacetype_statusbar();
   ED_spacetype_topbar();
 #if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_SPREADSHEET)
@@ -173,7 +175,9 @@ void ED_spacemacros_init()
   ED_operatormacros_file();
   ED_operatormacros_graph();
   ED_operatormacros_action();
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_CLIP)
   ED_operatormacros_clip();
+#endif
   ED_operatormacros_curve();
   curves::operatormacros_curves();
   pointcloud::operatormacros_pointcloud();
