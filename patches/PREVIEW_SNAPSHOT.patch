+static void test_texture_webgpu_unfilterable_float_texel_fetch()
+{
+  using namespace shader;
+  GPU_render_begin();
+
+  constexpr int width = 1;
+  constexpr int height = 1;
+  constexpr int layers = 2;
+  const float source[width * height * layers * 2] = {0.25f, 0.5f, 0.75f, 1.0f};
+
+  gpu::Texture *input = GPU_texture_create_2d_array(__func__,
+                                                    width,
+                                                    height,
+                                                    layers,
+                                                    1,
+                                                    TextureFormat::UNORM_16_16,
+                                                    GPU_TEXTURE_USAGE_SHADER_READ,
+                                                    nullptr);
+  gpu::Texture *output = GPU_texture_create_2d(__func__,
+                                               1,
+                                               1,
+                                               1,
+                                               TextureFormat::SFLOAT_32_32_32_32,
+                                               GPU_TEXTURE_USAGE_SHADER_WRITE |
+                                                   GPU_TEXTURE_USAGE_HOST_READ,
+                                               nullptr);
+  ASSERT_NE(input, nullptr);
+  ASSERT_NE(output, nullptr);
+  GPU_texture_update(input, GPU_DATA_FLOAT, source);
+
+  ShaderCreateInfo info("pyGPU_Shader");
+  info.sampler(0, ImageType::Float2DArray, "input_tx");
+  info.image(1,
+             TextureFormat::SFLOAT_32_32_32_32,
+             Qualifier::write,
+             ImageReadWriteType::image2D,
+             "output_img");
+  info.local_group_size(1, 1, 1);
+  info.compute_source_generated =
+      "vec2 fetch_layer(sampler2DArray tx) {\n"
+      "  return texelFetch(tx, ivec3(0, 0, 1), 0).xy;\n"
+      "}\n"
+      "void main() {\n"
+      /* The GLSL combined sampler is split into texture + sampler handles by
+       * Tint. With optimization disabled, forwarding it through a helper keeps
+       * both handles in WGSL even though texelFetch ultimately uses only the
+       * texture. This is the EEVEE gbuffer::Reader shape which defeated the old
+       * textual sampler-reference heuristic. */
+      "  vec2 value = fetch_layer(input_tx);\n"
+      "  imageStore(output_img, ivec2(0), vec4(value, 0.0, 1.0));\n"
+      "}\n";
+
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+  GPU_shader_bind(shader);
+  GPU_texture_bind(input, GPU_shader_get_sampler_binding(shader, "input_tx"));
+  GPU_texture_image_bind(output, GPU_shader_get_sampler_binding(shader, "output_img"));
+  GPU_compute_dispatch(shader, 1, 1, 1);
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE | GPU_BARRIER_SHADER_IMAGE_ACCESS);
+
+  float *result = static_cast<float *>(GPU_texture_read(output, GPU_DATA_FLOAT, 0));
+  ASSERT_NE(result, nullptr);
+  EXPECT_NEAR(result[0], 0.75f, 0.00002f);
+  EXPECT_NEAR(result[1], 1.0f, 0.00002f);
+  EXPECT_FLOAT_EQ(result[2], 0.0f);
+  EXPECT_FLOAT_EQ(result[3], 1.0f);
+  MEM_delete(result);
+
+  GPU_texture_unbind(input);
+  GPU_texture_image_unbind(output);
+  GPU_shader_unbind();
+  GPU_shader_free(shader);
+  GPU_texture_free(output);
+  GPU_texture_free(input);
+  GPU_render_end();
+}
