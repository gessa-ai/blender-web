+static void grease_pencil_fill_depth_cache_clear(GreasePencilFillOpData &op_data)
+{
+  grease_pencil_fill_depth_cache_timer_remove(op_data);
+  if (op_data.depth_cache_placement.has_value()) {
+    op_data.depth_cache_placement->cancel_viewport_depths();
