+  DRWSelectBufferBitmapKey pending_key;
+  DRWSelectBufferQueryContext pending_context;
+  DRWSelectBufferBitmapResult result;
+};
+
+static DRWSelectBufferBitmapState g_select_buffer_bitmap = {};
