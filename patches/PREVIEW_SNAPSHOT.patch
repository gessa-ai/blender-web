+struct View3DSelectAsyncData {
+  wmTimer *timer = nullptr;
+  int tick_count = 0;
+};
+
+static void view3d_select_async_finish(bContext *C, wmOperator *op)
+{
+  View3DSelectAsyncData *data = static_cast<View3DSelectAsyncData *>(op->customdata);
+  if (data != nullptr) {
+    if (data->timer != nullptr) {
+      WM_event_timer_remove(CTX_wm_manager(C), CTX_wm_window(C), data->timer);
+    }
+    MEM_delete(data);
+    op->customdata = nullptr;
+  }
+  GPU_select_async_session_end();
+}
+
 static wmOperatorStatus view3d_select_invoke(bContext *C, wmOperator *op, const wmEvent *event)
 {
   RNA_int_set_array(op->ptr, "location", event->mval);
 
+#ifdef __EMSCRIPTEN__
+  GPU_select_async_session_begin();
+#endif
   const wmOperatorStatus retval = view3d_select_exec(C, op);
 
+#ifdef __EMSCRIPTEN__
+  if (retval == OPERATOR_RUNNING_MODAL) {
+    View3DSelectAsyncData *data = MEM_new<View3DSelectAsyncData>(__func__);
+    data->timer = WM_event_timer_add(
+        CTX_wm_manager(C), CTX_wm_window(C), TIMER, 0.01f);
+    op->customdata = data;
+    WM_event_add_modal_handler(C, op);
+    return OPERATOR_RUNNING_MODAL;
+  }
+  GPU_select_async_session_end();
+#endif
   return WM_operator_flag_only_pass_through_on_press(retval, event);
 }
 
+static wmOperatorStatus view3d_select_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  View3DSelectAsyncData *data = static_cast<View3DSelectAsyncData *>(op->customdata);
+  if (event->type == EVT_ESCKEY && event->val == KM_PRESS) {
+    view3d_select_async_finish(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (data == nullptr || event->type != TIMER || event->customdata != data->timer) {
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+
+  /* Fail closed instead of retaining a modal operator forever after device
+   * loss or an undelivered browser callback (roughly 2.4 seconds at 10 ms). */
+  constexpr int max_tick_count = 240;
+  if (++data->tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for WebGPU selection readback");
+    view3d_select_async_finish(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const eGPUReadbackStatus status = GPU_select_async_status();
+  if (status == GPU_READBACK_PENDING) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (status != GPU_READBACK_READY) {
+    BKE_reportf(op->reports,
+                RPT_ERROR,
+                "WebGPU selection readback failed (error %d)",
+                int(GPU_select_async_error()));
+    view3d_select_async_finish(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const wmOperatorStatus retval = view3d_select_exec(C, op);
+  if (retval == OPERATOR_RUNNING_MODAL) {
+    return retval;
+  }
+  view3d_select_async_finish(C, op);
+  return retval;
+}
+
+static void view3d_select_cancel(bContext *C, wmOperator *op)
+{
+  view3d_select_async_finish(C, op);
+}
