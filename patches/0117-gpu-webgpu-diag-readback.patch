diff --git a/source/blender/gpu/webgpu/wgpu_diag_readback.cc b/source/blender/gpu/webgpu/wgpu_diag_readback.cc
new file mode 100644
index 0000000..a00b3ee
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_diag_readback.cc
@@ -0,0 +1,217 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * New for the web port (no upstream equivalent). */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Diagnostic GPU readback coordination (M4 round 31). See wgpu_diag_readback.hh for
+ * the design. This translation unit owns the small named-texture registry shared
+ * between the backend seams, the per-frame command poll + ProcessEvents pump, and the
+ * armed "capture the gbuffer right after the workbench-prepass submit" discriminator.
+ * The heavy lifting (kick copy + MapAsync + file write) is WGPUTexture::diag_kick_readback.
+ *
+ * INERT unless the env var BW_DIAG is set: every entry point returns on the first
+ * branch when it is unset, so no ProcessEvents pump, no file poll, and no readback
+ * ever runs in production or the pixel-golden runs. */
+
+#include "wgpu_diag_readback.hh"
+
+#include "wgpu_context.hh"
+#include "wgpu_framebuffer.hh"
+#include "wgpu_texture.hh"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <unistd.h>
+
+namespace blender::gpu::webgpu::diag {
+
+namespace {
+
+/* --- Named-texture registry (updated at the backend seams) ------------------- */
+WGPUTexture *g_viewport_color = nullptr;
+WGPUTexture *g_gbuf_depth = nullptr;
+WGPUTexture *g_gbuf_color0 = nullptr; /* workbench prepass COLOR_ATTACHMENT0 (material) */
+WGPUTexture *g_gbuf_color1 = nullptr; /* COLOR_ATTACHMENT1 (normal) */
+WGPUTexture *g_gbuf_color2 = nullptr; /* COLOR_ATTACHMENT2 (object_id) */
+
+/* Remaining workbench-prepass submits to sample right after Submit (state (a)). */
+int g_arm_prepass = 0;
+
+/* Latched true once BW_DIAG is observed set; the whole module is a no-op until then. */
+bool g_enabled = false;
+
+const char *kCmdPath = "/tmp/bw_diag_cmd";
+
+void stderr_line(const char *s)
+{
+  ssize_t rc = ::write(2, s, std::strlen(s));
+  (void)rc;
+}
+
+bool ensure_enabled()
+{
+  if (g_enabled) {
+    return true;
+  }
+  /* Re-check each frame (cheap) until the driver sets it before/at WM_main. */
+  if (std::getenv("BW_DIAG") == nullptr) {
+    return false;
+  }
+  g_enabled = true;
+  stderr_line("BW_DIAG enabled: diagnostic readback active (BW_DIAG set)\n");
+  /* Optional boot-time arm: capture the gbuffer at the first N workbench-prepass
+   * submits. Needed because the viewport prepass runs only during the (early) render,
+   * not on every tag_redraw kick — the transient material/normal gbuffer textures are
+   * freed by the DRW pool afterward, so state (a) MUST be captured during the frame. */
+  if (const char *arm = std::getenv("BW_DIAG_ARM")) {
+    g_arm_prepass = std::atoi(arm);
+    char line[96];
+    std::snprintf(line, sizeof(line), "BW_DIAG boot-arm prepass=%d\n", g_arm_prepass);
+    stderr_line(line);
+  }
+  return true;
+}
+
+WGPUTexture *target_for(const char *name)
+{
+  if (std::strcmp(name, "viewport_color") == 0) {
+    return g_viewport_color;
+  }
+  if (std::strcmp(name, "gbuffer_depth") == 0) {
+    return g_gbuf_depth;
+  }
+  if (std::strcmp(name, "gbuffer_material") == 0) {
+    return g_gbuf_color0;
+  }
+  if (std::strcmp(name, "gbuffer_normal") == 0) {
+    return g_gbuf_color1;
+  }
+  if (std::strcmp(name, "gbuffer_objectid") == 0) {
+    return g_gbuf_color2;
+  }
+  return nullptr;
+}
+
+void run_command(const char *verb, const char *arg)
+{
+  char line[192];
+  if (std::strcmp(verb, "readback") == 0 && arg != nullptr) {
+    WGPUTexture *tex = target_for(arg);
+    if (tex == nullptr) {
+      std::snprintf(line, sizeof(line), "BW_READBACK_KICK label=%s status=unregistered\n", arg);
+      stderr_line(line);
+      return;
+    }
+    tex->diag_kick_readback(arg);
+  }
+  else if (std::strcmp(verb, "arm") == 0 && arg != nullptr) {
+    g_arm_prepass = std::atoi(arg);
+    std::snprintf(line, sizeof(line), "BW_DIAG arm prepass=%d\n", g_arm_prepass);
+    stderr_line(line);
+  }
+  else {
+    std::snprintf(line, sizeof(line), "BW_DIAG unknown-command verb=%s\n", verb);
+    stderr_line(line);
+  }
+}
+
+void drain_command_file()
+{
+  FILE *f = std::fopen(kCmdPath, "rb");
+  if (f == nullptr) {
+    return;
+  }
+  char buf[1024];
+  size_t n = std::fread(buf, 1, sizeof(buf) - 1, f);
+  std::fclose(f);
+  std::remove(kCmdPath); /* one-shot: consume the command */
+  buf[n] = '\0';
+
+  /* One command per line: "<verb> <arg>". */
+  char *save = nullptr;
+  for (char *ln = strtok_r(buf, "\n", &save); ln != nullptr;
+       ln = strtok_r(nullptr, "\n", &save))
+  {
+    char *sp = std::strpbrk(ln, " \t");
+    char *arg = nullptr;
+    if (sp != nullptr) {
+      *sp = '\0';
+      arg = sp + 1;
+      while (*arg == ' ' || *arg == '\t') {
+        arg++;
+      }
+      /* trim trailing whitespace/CR on arg */
+      char *end = arg + std::strlen(arg);
+      while (end > arg && (end[-1] == ' ' || end[-1] == '\t' || end[-1] == '\r')) {
+        *--end = '\0';
+      }
+    }
+    if (*ln != '\0') {
+      run_command(ln, arg);
+    }
+  }
+}
+
+}  // namespace
+
+void register_viewport_color(WGPUTexture *tex)
+{
+  g_viewport_color = tex;
+}
+
+void on_draw_submit(const char *shader_name, WGPUFrameBuffer *fb)
+{
+  if (!g_enabled || shader_name == nullptr || fb == nullptr) {
+    return;
+  }
+  if (std::strstr(shader_name, "workbench_prepass") == nullptr) {
+    return;
+  }
+  /* Register the gbuffer targets from this prepass's bound attachments (so a later
+   * timer-driven `readback gbuffer_*` reads the same textures — state (b)). */
+  WGPUTexture *depth = fb->diag_attachment_texture(GPU_FB_DEPTH_ATTACHMENT);
+  if (depth == nullptr) {
+    depth = fb->diag_attachment_texture(GPU_FB_DEPTH_STENCIL_ATTACHMENT);
+  }
+  g_gbuf_depth = depth;
+  g_gbuf_color0 = fb->diag_attachment_texture(GPU_FB_COLOR_ATTACHMENT0);
+  g_gbuf_color1 = fb->diag_attachment_texture(GPU_FB_COLOR_ATTACHMENT1);
+  g_gbuf_color2 = fb->diag_attachment_texture(GPU_FB_COLOR_ATTACHMENT2);
+
+  if (g_arm_prepass <= 0) {
+    return;
+  }
+  g_arm_prepass--;
+  /* State (a): the gbuffer contents the instant the prepass Submit lands. */
+  if (g_gbuf_depth != nullptr) {
+    g_gbuf_depth->diag_kick_readback("prepass_depth");
+  }
+  if (g_gbuf_color0 != nullptr) {
+    g_gbuf_color0->diag_kick_readback("prepass_material");
+  }
+  if (g_gbuf_color1 != nullptr) {
+    g_gbuf_color1->diag_kick_readback("prepass_normal");
+  }
+  if (g_gbuf_color2 != nullptr) {
+    g_gbuf_color2->diag_kick_readback("prepass_objectid");
+  }
+}
+
+void poll_and_pump(WGPUContext *ctx)
+{
+  if (!ensure_enabled() || ctx == nullptr) {
+    return;
+  }
+  /* Drive pending map futures registered with AllowProcessEvents — this is the
+   * "consume" half of every kick, running on the WM worker's own event loop. */
+  ctx->instance_get().ProcessEvents();
+  drain_command_file();
+}
+
+}  // namespace blender::gpu::webgpu::diag
diff --git a/source/blender/gpu/webgpu/wgpu_diag_readback.hh b/source/blender/gpu/webgpu/wgpu_diag_readback.hh
new file mode 100644
index 0000000..3605103
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_diag_readback.hh
@@ -0,0 +1,66 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * New for the web port (no upstream equivalent). */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Diagnostic GPU texture readback (M4 round 31) — the tick-pumped, kick-then-consume
+ * side of the `gpu-sync-readback-windowed` deferral (ADR-007).
+ *
+ * WebGPU map futures cannot be waited on synchronously in the windowed WM-worker
+ * profile: `instance.WaitAny` needs asyncify/JSPI (dropped per ADR-006) and a
+ * same-thread blocking wait halts the very event loop that would deliver the map
+ * completion, so `WGPUTexture::read` returns all-zero buffers on the web. This module
+ * KICKS a `CopyTextureToBuffer` + `MapAsync(AllowProcessEvents)` and returns
+ * immediately; the completion rides the WM worker's main loop
+ * (`WGPUContext::activate` pumps `instance.ProcessEvents()` each tick), and when the
+ * map resolves the bytes + a small header are written to `/tmp/bw_readback_<n>.bin`
+ * in WasmFS with one raw-fd-2 stderr line. A `?pyexpr=` `bpy.app.timer` drives it;
+ * the browser rig pulls the file via `window.__bwModule.FS.readFile`.
+ *
+ * INERT unless the environment variable `BW_DIAG` is set (the diagnostic driver sets
+ * it before `WM_main`). With `BW_DIAG` unset, `poll_and_pump` / `on_draw_submit`
+ * return on the first branch and no readback machinery ever runs — production and the
+ * pixel goldens are unaffected. The keeper half (the readback primitive
+ * `WGPUTexture::diag_kick_readback`) also unblocks M5 pick-select, M6 capture and
+ * in-app screenshots once a proper caller-facing sync/poll API lands. */
+
+#pragma once
+
+#include "gpu_framebuffer_private.hh" /* GPUAttachmentType */
+
+namespace blender::gpu {
+
+class WGPUContext;
+class WGPUFrameBuffer;
+namespace webgpu {
+class WGPUTexture;
+}
+
+namespace webgpu::diag {
+
+/** Called once per frame from WGPUContext::activate(). Immediate no-op unless the
+ * `BW_DIAG` env var is set. When enabled: pumps `instance.ProcessEvents()` so pending
+ * map futures resolve, then executes any command queued in `/tmp/bw_diag_cmd`:
+ *   readback <viewport_color|gbuffer_depth|gbuffer_normal|gbuffer_material>
+ *   arm <n>          (capture the gbuffer at the next n workbench-prepass submits)
+ * The command file is consumed (unlinked) after it is read. */
+void poll_and_pump(WGPUContext *ctx);
+
+/** Register the persistent window colour target (the composited/presented image) as
+ * the `viewport_color` readback target. Called from WGPUContext::sync_backbuffer. */
+void register_viewport_color(WGPUTexture *tex);
+
+/** Called right after every draw Submit in wgpu_batch. When the shader is the
+ * workbench opaque prepass it (1) registers the framebuffer's depth + colour
+ * attachments as the gbuffer readback targets and (2), if armed, KICKS a readback of
+ * each right after the prepass submit (the "state (a)" discriminator sample). Cheap
+ * no-op unless BW_DIAG is set. */
+void on_draw_submit(const char *shader_name, WGPUFrameBuffer *fb);
+
+}  // namespace webgpu::diag
+
+}  // namespace blender::gpu
