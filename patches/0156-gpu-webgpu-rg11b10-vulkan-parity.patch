+template<uint32_t DestinationMantissaBits>
+static uint32_t convert_f32_to_unsigned_float_bits(const float value)
+{
+  constexpr uint32_t source_mantissa_bits = 23;
+  constexpr uint32_t source_mantissa_mask = (1u << source_mantissa_bits) - 1u;
+  constexpr int32_t source_exponent_bias = 127;
+  constexpr uint32_t source_exponent_special = 255;
+  constexpr uint32_t destination_mantissa_mask = (1u << DestinationMantissaBits) - 1u;
+  constexpr int32_t destination_exponent_bias = 15;
+  constexpr uint32_t destination_exponent_special = 31;
+
+  uint32_t bits = 0;
+  std::memcpy(&bits, &value, sizeof(bits));
+  const bool is_negative = (bits >> 31u) != 0;
+  uint32_t mantissa = bits & source_mantissa_mask;
+  int32_t exponent = int32_t((bits >> source_mantissa_bits) & source_exponent_special);
+  const bool is_nan = exponent == int32_t(source_exponent_special) && mantissa != 0;
+  const bool is_infinite = exponent == int32_t(source_exponent_special) && mantissa == 0;
+  const bool is_zero = exponent == 0 && mantissa == 0;
+
+  /* Match convert_float_formats<FormatF11/F10, FormatF32>() at the pin:
+   * negative finite values and infinities clamp to zero, while either-signed
+   * NaNs canonicalize to the destination's all-ones mantissa. */
+  if (is_negative && !is_nan) {
+    return 0;
+  }
+  if (is_zero) {
+    return 0;
+  }
+  if (is_infinite) {
+    exponent = int32_t(destination_exponent_special);
+  }
+  else if (is_nan) {
+    exponent = int32_t(destination_exponent_special);
+    mantissa = destination_mantissa_mask;
+  }
+  else {
+    exponent -= source_exponent_bias;
+    if (exponent > destination_exponent_bias) {
+      exponent = 0;
+      mantissa = source_mantissa_mask;
+    }
+    else if (exponent < -destination_exponent_bias) {
+      return 0;
+    }
+    exponent += destination_exponent_bias;
+    mantissa >>= source_mantissa_bits - DestinationMantissaBits;
+  }
+
+  return (uint32_t(exponent) << DestinationMantissaBits) |
+         (mantissa & destination_mantissa_mask);
+}
+
+template<uint32_t SourceMantissaBits>
+static float convert_unsigned_float_bits_to_f32(const uint32_t value)
+{
+  constexpr uint32_t source_mantissa_mask = (1u << SourceMantissaBits) - 1u;
+  constexpr int32_t source_exponent_bias = 15;
+  constexpr uint32_t source_exponent_special = 31;
+  constexpr uint32_t destination_mantissa_bits = 23;
+  constexpr uint32_t destination_mantissa_mask = (1u << destination_mantissa_bits) - 1u;
+  constexpr int32_t destination_exponent_bias = 127;
+  constexpr uint32_t destination_exponent_special = 255;
+
+  uint32_t mantissa = value & source_mantissa_mask;
+  int32_t exponent = int32_t((value >> SourceMantissaBits) & source_exponent_special);
+  const bool is_nan = exponent == int32_t(source_exponent_special) && mantissa != 0;
+  const bool is_infinite = exponent == int32_t(source_exponent_special) && mantissa == 0;
+  const bool is_zero = exponent == 0 && mantissa == 0;
+  if (is_zero) {
+    return 0.0f;
+  }
+  if (is_infinite) {
+    exponent = int32_t(destination_exponent_special);
+  }
+  else if (is_nan) {
+    exponent = int32_t(destination_exponent_special);
+    mantissa = destination_mantissa_mask;
+  }
+  else {
+    exponent -= source_exponent_bias;
+    exponent += destination_exponent_bias;
+    mantissa <<= destination_mantissa_bits - SourceMantissaBits;
+  }
+
+  const uint32_t bits = (uint32_t(exponent) << destination_mantissa_bits) |
+                        (mantissa & destination_mantissa_mask);
+  float result = 0.0f;
+  std::memcpy(&result, &bits, sizeof(result));
+  return result;
+}
+
+uint32_t pack_r11g11b10_ufloat(const float red, const float green, const float blue)
+{
+  const uint32_t red_bits = convert_f32_to_unsigned_float_bits<6>(red);
+  const uint32_t green_bits = convert_f32_to_unsigned_float_bits<6>(green);
+  const uint32_t blue_bits = convert_f32_to_unsigned_float_bits<5>(blue);
+  return red_bits | (green_bits << 11u) | (blue_bits << 22u);
+}
+
+void unpack_r11g11b10_ufloat(const uint32_t packed, float r_rgb[3])
+{
+  r_rgb[0] = convert_unsigned_float_bits_to_f32<6>(packed & 0x7ffu);
+  r_rgb[1] = convert_unsigned_float_bits_to_f32<6>((packed >> 11u) & 0x7ffu);
+  r_rgb[2] = convert_unsigned_float_bits_to_f32<5>((packed >> 22u) & 0x3ffu);
+}
+
 }  // namespace blender::gpu::webgpu
