+/** Reserve queue chronology before creating a short-lived resource. The provisional handle may
+ * be used only to encode work queued after this gate. A literal null or a completed error scope
+ * rejects the gate and cancels the remainder of the current frame epoch. */
+template<typename BeginScopeFn, typename CreateFn, typename EndScopeFn, typename CompleteFn>
+inline auto transient_resource_gate_scoped(OrderedQueueScheduler &scheduler,
+                                           BeginScopeFn &&begin_scope,
+                                           CreateFn &&create,
+                                           EndScopeFn &&end_scope,
+                                           CompleteFn &&complete)
+{
+  using CandidateT = std::decay_t<decltype(std::forward<CreateFn>(create)())>;
+  auto state = std::make_shared<TransientResourceGateState>(
+      std::function<void(bool)>(std::forward<CompleteFn>(complete)));
+  OrderedQueueScheduler::Ticket ticket = scheduler.reserve();
+
+  std::forward<BeginScopeFn>(begin_scope)();
+  CandidateT candidate = std::forward<CreateFn>(create)();
+  const bool handle_valid = !(candidate == nullptr);
+  ticket.resolve(
+      [state](auto done) { state->operation(std::move(done)); },
+      [state]() { state->cancel(); });
+  std::forward<EndScopeFn>(end_scope)(
+      [state, retained_candidate = candidate, handle_valid](const bool scope_valid) mutable {
+        (void)retained_candidate;
+        state->settle(handle_valid && scope_valid);
+      });
+  return candidate;
+}
