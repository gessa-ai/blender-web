+static void view3d_select_async_web_failure_log(
+    const char *message,
+    const eGPUReadbackError error = GPU_READBACK_ERROR_NONE)
+{
+  constexpr int max_log_count = 16;
+  static int log_count = 0;
+  if (log_count >= max_log_count) {
+    return;
+  }
+  log_count++;
+  if (error == GPU_READBACK_ERROR_NONE) {
+    std::fprintf(stderr, "[bw] WebGPU selection continuation canceled: %s\n", message);
+  }
+  else {
+    std::fprintf(stderr,
+                 "[bw] WebGPU selection readback failed (error %d): %s\n",
+                 int(error),
+                 message);
+  }
+  std::fflush(stderr);
+}
