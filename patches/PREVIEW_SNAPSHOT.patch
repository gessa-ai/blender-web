+enum class WorkbenchImageRenderPhase {
+  Render,
+  AwaitReadback,
+  ViewComplete,
+  Failed,
+};
+
+struct WorkbenchImageRenderSession {
+  DRWRenderToImageSession draw;
+  WorkbenchImageRenderPhase phase = WorkbenchImageRenderPhase::Render;
+  GPUReadback *color_readback = nullptr;
+  GPUReadback *depth_readback = nullptr;
+  std::string active_view;
+  rcti rect = {};
+  int source_width = 0;
+  int source_height = 0;
+  float4x4 winmat;
+  bool depth_is_perspective = false;
+  float depth_near_clip = 0.0f;
+  float depth_far_clip = 0.0f;
+};
+
+static void workbench_render_readback_cancel(WorkbenchImageRenderSession &session)
+{
+  GPU_readback_cancel(session.color_readback);
+  GPU_readback_cancel(session.depth_readback);
+}
+
+static bool workbench_render_readback_begin(WorkbenchImageRenderSession &session,
+                                            RenderEngine *engine,
+                                            RenderLayer *layer,
+                                            const rcti rect)
+{
+  const DRWContext *draw_ctx = DRW_context_get();
+  if (!workbench_render_draw(engine, session.winmat)) {
+    return false;
+  }
+
+  DefaultTextureList *dtxl = draw_ctx->viewport_texture_list_get();
+  if (dtxl->color == nullptr || dtxl->depth == nullptr) {
+    return false;
+  }
+  session.active_view = RE_GetActiveRenderView(engine->re);
+  session.rect = rect;
+  session.source_width = GPU_texture_width(dtxl->color);
+  session.source_height = GPU_texture_height(dtxl->color);
+  session.depth_is_perspective = draw::View::default_get().is_persp();
+  session.depth_near_clip = draw::View::default_get().near_clip();
+  session.depth_far_clip = draw::View::default_get().far_clip();
+
+  RenderPass *combined = RE_pass_find_by_name(
+      layer, RE_PASSNAME_COMBINED, session.active_view.c_str());
+  RenderPass *depth = RE_pass_find_by_name(layer, RE_PASSNAME_DEPTH, session.active_view.c_str());
+  if (session.source_width <= 0 || session.source_height <= 0 || rect.xmin < 0 || rect.ymin < 0 ||
+      rect.xmax > session.source_width || rect.ymax > session.source_height)
+  {
+    return false;
+  }
+  if (combined == nullptr && depth == nullptr) {
+    return true;
+  }
+
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+  if (combined != nullptr) {
+    session.color_readback = GPU_texture_read_async(dtxl->color, GPU_DATA_FLOAT, 0);
+    if (session.color_readback == nullptr) {
+      return false;
+    }
+  }
+
+  if (depth != nullptr) {
+    if (GPU_texture_width(dtxl->depth) != session.source_width ||
+        GPU_texture_height(dtxl->depth) != session.source_height)
+    {
+      workbench_render_readback_cancel(session);
+      return false;
+    }
+    session.depth_readback = GPU_texture_read_async(dtxl->depth, GPU_DATA_FLOAT, 0);
+    if (session.depth_readback == nullptr) {
+      workbench_render_readback_cancel(session);
+      return false;
+    }
+  }
+  return true;
+}
+
+static eGPUReadbackStatus workbench_render_readback_status(
+    const WorkbenchImageRenderSession &session)
+{
+  bool pending = false;
+  GPUReadback *readbacks[2] = {session.color_readback, session.depth_readback};
+  for (GPUReadback *readback : readbacks) {
+    if (readback == nullptr) {
+      continue;
+    }
+    const eGPUReadbackStatus status = GPU_readback_status(readback);
+    if (ELEM(status, GPU_READBACK_FAILED, GPU_READBACK_INVALID)) {
+      return GPU_READBACK_FAILED;
+    }
+    pending |= status == GPU_READBACK_PENDING;
+  }
+  return pending ? GPU_READBACK_PENDING : GPU_READBACK_READY;
+}
+
+static bool workbench_copy_readback_rect(const Span<float> source,
+                                         const int source_width,
+                                         const int source_height,
+                                         const int channels,
+                                         const rcti &rect,
+                                         MutableSpan<float> destination)
+{
+  const int width = BLI_rcti_size_x(&rect);
+  const int height = BLI_rcti_size_y(&rect);
+  if (source_width <= 0 || source_height <= 0 || channels <= 0 || width <= 0 || height <= 0 ||
+      rect.xmin < 0 || rect.ymin < 0 || rect.xmax > source_width ||
+      rect.ymax > source_height ||
+      source.size() != int64_t(source_width) * source_height * channels ||
+      destination.size() != int64_t(width) * height * channels)
+  {
+    return false;
+  }
+
+  for (const int row : IndexRange(height)) {
+    /* Exact async texture tickets already use the row orientation expected by RenderPass.
+     * Unlike WGPUFrameBuffer::read(), this direct publication path must only crop the source;
+     * applying the framebuffer compatibility flip here would invert the saved Render Result. */
+    const int source_row = rect.ymin + row;
+    const int64_t source_offset = (int64_t(source_row) * source_width + rect.xmin) * channels;
+    const int64_t destination_offset = int64_t(row) * width * channels;
+    std::memcpy(destination.data() + destination_offset,
+                source.data() + source_offset,
+                sizeof(float) * width * channels);
+  }
+  return true;
+}
+
+static bool workbench_render_readback_consume(WorkbenchImageRenderSession &session,
+                                              RenderLayer *layer)
+{
+  const int width = BLI_rcti_size_x(&session.rect);
+  const int height = BLI_rcti_size_y(&session.rect);
+  RenderPass *combined = RE_pass_find_by_name(
+      layer, RE_PASSNAME_COMBINED, session.active_view.c_str());
+  RenderPass *depth = RE_pass_find_by_name(
+      layer, RE_PASSNAME_DEPTH, session.active_view.c_str());
+  if ((combined != nullptr && (combined->channels != 4 || combined->rectx != width ||
+                               combined->recty != height)) ||
+      (depth != nullptr &&
+       (depth->channels != 1 || depth->rectx != width || depth->recty != height)))
+  {
+    return false;
+  }
+
+  if (session.source_width <= 0 || session.source_height <= 0 ||
+      size_t(session.source_width) >
+          std::numeric_limits<size_t>::max() / size_t(session.source_height))
+  {
+    return false;
+  }
+  const size_t source_pixel_count = size_t(session.source_width) * size_t(session.source_height);
+  if (source_pixel_count > std::numeric_limits<size_t>::max() / 4 / sizeof(float)) {
+    return false;
+  }
+  const size_t color_float_count = source_pixel_count * 4;
+  const size_t depth_float_count = source_pixel_count;
+  if ((combined != nullptr &&
+       (session.color_readback == nullptr ||
+        GPU_readback_size(session.color_readback) != color_float_count * sizeof(float))) ||
+      (depth != nullptr && (session.depth_readback == nullptr ||
+                            GPU_readback_size(session.depth_readback) !=
+                                depth_float_count * sizeof(float))))
+  {
+    return false;
+  }
+
+  std::vector<float> color(combined != nullptr ? color_float_count : 0);
+  std::vector<float> depth_values(depth != nullptr ? depth_float_count : 0);
+  if ((combined != nullptr &&
+       !GPU_readback_consume(
+           session.color_readback, color.data(), color.size() * sizeof(float))) ||
+      (depth != nullptr &&
+       !GPU_readback_consume(session.depth_readback,
+                             depth_values.data(),
+                             depth_values.size() * sizeof(float))))
+  {
+    return false;
+  }
+
+  if (combined != nullptr) {
+    MutableSpan<float> combined_destination(
+        combined->ibuf->float_data_for_write(), int64_t(width) * height * 4);
+    if (!workbench_copy_readback_rect(color,
+                                      session.source_width,
+                                      session.source_height,
+                                      4,
+                                      session.rect,
+                                      combined_destination))
+    {
+      return false;
+    }
+  }
+
+  if (depth != nullptr) {
+    MutableSpan<float> depth_destination(
+        depth->ibuf->float_data_for_write(), int64_t(width) * height);
+    if (!workbench_copy_readback_rect(depth_values,
+                                      session.source_width,
+                                      session.source_height,
+                                      1,
+                                      session.rect,
+                                      depth_destination))
+    {
+      return false;
+    }
+    if (session.depth_is_perspective) {
+      for (float &z : depth_destination) {
+        z = (z == 1.0f) ? 1e10f : session.winmat[3][2] / (z * 2.0f - 1.0f +
+                                                          session.winmat[2][2]);
+      }
+    }
+    else {
+      const float range = fabsf(session.depth_far_clip - session.depth_near_clip);
+      for (float &z : depth_destination) {
+        z = (z == 1.0f) ? 1e10f : z * range - session.depth_near_clip;
+      }
+    }
+  }
+  return true;
+}
+
+static RenderStepStatus workbench_render_step(RenderEngine *engine, Depsgraph *depsgraph)
+{
+  WorkbenchImageRenderSession *session = static_cast<WorkbenchImageRenderSession *>(
+      engine->render_session);
+  if (session == nullptr) {
+    session = new WorkbenchImageRenderSession();
+    engine->render_session = session;
+  }
+
+  const RenderStepStatus status = DRW_render_to_image_step(
+      engine,
+      depsgraph,
+      session->draw,
+      [&](RenderEngine *engine, RenderLayer *layer, const rcti rect) {
+        if (session->phase == WorkbenchImageRenderPhase::ViewComplete) {
+          session->active_view.clear();
+          session->phase = WorkbenchImageRenderPhase::Render;
+        }
+        if (session->phase == WorkbenchImageRenderPhase::Render) {
+          if (!workbench_render_readback_begin(*session, engine, layer, rect)) {
+            RE_engine_set_error_message(engine, "Workbench could not start render-pass readback.");
+            session->phase = WorkbenchImageRenderPhase::Failed;
+            return RenderStepStatus::Failed;
+          }
+          session->phase = WorkbenchImageRenderPhase::AwaitReadback;
+        }
+
+        const eGPUReadbackStatus readback_status = workbench_render_readback_status(*session);
+        if (readback_status == GPU_READBACK_PENDING) {
+          return RenderStepStatus::Pending;
+        }
+        if (readback_status != GPU_READBACK_READY) {
+          RE_engine_set_error_message(engine, "Workbench render-pass readback failed.");
+          session->phase = WorkbenchImageRenderPhase::Failed;
+          return RenderStepStatus::Failed;
+        }
+
+        BLI_mutex_lock(&engine->update_render_passes_mutex);
+        const bool consumed = workbench_render_readback_consume(*session, layer);
+        BLI_mutex_unlock(&engine->update_render_passes_mutex);
+        if (!consumed) {
+          RE_engine_set_error_message(engine, "Workbench render-pass readback could not be consumed.");
+          session->phase = WorkbenchImageRenderPhase::Failed;
+          return RenderStepStatus::Failed;
+        }
+        session->phase = WorkbenchImageRenderPhase::ViewComplete;
+        return RenderStepStatus::Complete;
+      },
+      [](RenderResult *) {});
+
+  if (status != RenderStepStatus::Pending) {
+    workbench_render_readback_cancel(*session);
+    delete session;
+    engine->render_session = nullptr;
+  }
+  return status;
+}
+
+static void workbench_render_cancel(RenderEngine *engine)
+{
+  WorkbenchImageRenderSession *session = static_cast<WorkbenchImageRenderSession *>(
+      engine->render_session);
+  if (session == nullptr) {
+    return;
+  }
+  workbench_render_readback_cancel(*session);
+  DRW_render_to_image_cancel(engine, session->draw);
+  delete session;
+  engine->render_session = nullptr;
+}
