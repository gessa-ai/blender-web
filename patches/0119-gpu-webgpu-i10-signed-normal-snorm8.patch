+/* --- Signed packed-normal (GPU_COMP_I10) transcode --------------------------------
+ * WebGPU has no signed 10_10_10_2 vertex format, so `to_wgpu_vertex_format`
+ * (wgpu_pipeline.cc) reports normalized GPU_COMP_I10 attributes as Snorm8x4. The packed
+ * source data (A2B10G10R10 layout: R/X in the low 10 bits, then G/Y, B/Z, and the 2-bit
+ * A/W in the top bits, each 10-bit component a signed [-512,511] value scaled by 511)
+ * must therefore be transcoded to four signed bytes IN PLACE (same 4-byte field) before
+ * upload. Without this the unsigned-decode bug flipped the sign of every negative normal
+ * component (r37: the default cube's -Y face shaded as +Y). Mirrors the intent of
+ * Vulkan's VK_FORMAT_A2B10G10R10_SNORM_PACK32 path. */
+
+static inline int8_t i10_component_to_snorm8(uint32_t bits10)
+{
+  int v = int(bits10 & 0x3FFu);
+  if (v & 0x200) {
+    v -= 1024; /* sign-extend the 10-bit two's-complement value to [-512, 511]. */
+  }
+  float f = float(v) * (1.0f / 511.0f);
+  f = (f > 1.0f) ? 1.0f : (f < -1.0f) ? -1.0f : f;
+  int o = int(f * 127.0f + (f >= 0.0f ? 0.5f : -0.5f));
+  return int8_t((o > 127) ? 127 : (o < -127) ? -127 : o);
+}
+
+/** True if `fmt` carries at least one normalized GPU_COMP_I10 attribute needing transcode. */
+static bool format_has_norm_i10(const GPUVertFormat &fmt)
+{
+  for (uint i = 0; i < fmt.attr_len; i++) {
+    const GPUVertAttr &a = fmt.attrs[i];
+    if (a.type.comp_type() == GPU_COMP_I10 &&
+        a.type.fetch_mode() == GPU_FETCH_INT_TO_FLOAT_UNIT)
+    {
+      return true;
+    }
+  }
+  return false;
+}
+
+/** Transcode every normalized GPU_COMP_I10 field of `fmt` from packed 2_10_10_10 SNORM to
+ * Snorm8x4, in place, over `bytes` (a WRITABLE copy of the host data — never `data_`). */
+static void transcode_i10_attrs(uint8_t *bytes,
+                                size_t nbytes,
+                                const GPUVertFormat &fmt,
+                                uint vertex_len)
+{
+  for (uint ai = 0; ai < fmt.attr_len; ai++) {
+    const GPUVertAttr &a = fmt.attrs[ai];
+    if (a.type.comp_type() != GPU_COMP_I10 ||
+        a.type.fetch_mode() != GPU_FETCH_INT_TO_FLOAT_UNIT)
+    {
+      continue;
+    }
+    /* Locate this attribute's 4-byte fields. Interleaved: one per stride at a.offset.
+     * Deinterleaved: a contiguous block after the prior attributes' blocks (mirrors the
+     * buf_off math in wgpu_pipeline.cc build_vertex_plan). */
+    size_t base, field_stride;
+    if (!fmt.deinterleaved) {
+      base = a.offset;
+      field_stride = fmt.stride;
+    }
+    else {
+      base = 0;
+      for (uint j = 0; j < ai; j++) {
+        base += size_t(fmt.attrs[j].type.size()) * size_t(vertex_len);
+      }
+      field_stride = a.type.size(); /* 4 for I10 */
+    }
+    for (uint v = 0; v < vertex_len; v++) {
+      const size_t off = base + size_t(v) * field_stride;
+      if (off + 4 > nbytes) {
+        break;
+      }
+      uint8_t *f = bytes + off;
+      const uint32_t p = uint32_t(f[0]) | (uint32_t(f[1]) << 8) | (uint32_t(f[2]) << 16) |
+                         (uint32_t(f[3]) << 24);
+      int w = int((p >> 30) & 0x3u);
+      if (w & 0x2) {
+        w -= 4; /* sign-extend the 2-bit component to [-2, 1]. */
+      }
+      w = (w > 1) ? 1 : (w < -1) ? -1 : w;
+      f[0] = uint8_t(i10_component_to_snorm8(p));         /* X (low 10 bits) */
+      f[1] = uint8_t(i10_component_to_snorm8(p >> 10));   /* Y */
+      f[2] = uint8_t(i10_component_to_snorm8(p >> 20));   /* Z */
+      f[3] = uint8_t(int8_t(w * 127));                    /* W (2-bit; unused by normals) */
+    }
+  }
+}
+
+/** Map Blender's base `GPUUsageType` (low bits) to the buffer wrapper's usage. */
+static webgpu::UsageType to_wgpu_usage(GPUUsageType usage)
+{
+  switch (usage & 0x3) {
+    case GPU_USAGE_STREAM:
+      return webgpu::UsageType::Stream;
+    case GPU_USAGE_STATIC:
+      return webgpu::UsageType::Static;
+    case GPU_USAGE_DYNAMIC:
+      return webgpu::UsageType::Dynamic;
+    case GPU_USAGE_DEVICE_ONLY:
+      return webgpu::UsageType::DeviceOnly;
+    default:
+      return webgpu::UsageType::Static;
+  }
+}
