+/** Validate one texture allocation against the live device's dimension, array-layer, and
+ * mip-level limits. This mirrors Dawn's `ValidateTextureSize` decision before CreateTexture can
+ * return a non-null error texture. */
+inline bool texture_allocation_supported(wgpu::TextureDimension dimension,
+                                         const wgpu::Extent3D &size,
+                                         uint32_t mip_level_count,
+                                         const wgpu::Limits &limits)
+{
+  if (size.width == 0 || size.height == 0 || size.depthOrArrayLayers == 0 ||
+      mip_level_count == 0)
+  {
+    return false;
+  }
+
+  uint32_t max_mipped_dimension;
+  switch (dimension) {
+    case wgpu::TextureDimension::e1D:
+      return size.height == 1 && size.depthOrArrayLayers == 1 && mip_level_count == 1 &&
+             size.width <= limits.maxTextureDimension1D;
+    case wgpu::TextureDimension::e2D:
+      if (size.width > limits.maxTextureDimension2D ||
+          size.height > limits.maxTextureDimension2D ||
+          size.depthOrArrayLayers > limits.maxTextureArrayLayers)
+      {
+        return false;
+      }
+      max_mipped_dimension = size.width > size.height ? size.width : size.height;
+      break;
+    case wgpu::TextureDimension::e3D:
+      if (size.width > limits.maxTextureDimension3D ||
+          size.height > limits.maxTextureDimension3D ||
+          size.depthOrArrayLayers > limits.maxTextureDimension3D)
+      {
+        return false;
+      }
+      max_mipped_dimension = size.width > size.height ? size.width : size.height;
+      if (size.depthOrArrayLayers > max_mipped_dimension) {
+        max_mipped_dimension = size.depthOrArrayLayers;
+      }
+      break;
+    case wgpu::TextureDimension::Undefined:
+      return false;
+  }
+
+  uint32_t max_mip_level_count = 0;
+  while (max_mipped_dimension != 0) {
+    max_mip_level_count++;
+    max_mipped_dimension >>= 1;
+  }
+  return mip_level_count <= max_mip_level_count;
+}
