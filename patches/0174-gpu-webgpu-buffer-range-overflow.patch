 {
+  size_t allocated_size;
+  if (!checked_align_up(size == 0 ? kCopyAlignment : size, kCopyAlignment, allocated_size)) {
+    return false;
+  }
   readback::forget_source(readback::SourceKind::Buffer, this);
   requested_ = size;
-  size_ = align_up(size == 0 ? kCopyAlignment : size, kCopyAlignment);
+  size_ = allocated_size;
   kind_ = kind;
   readable_ = readable;
 
@@ -143,7 +147,7 @@ bool Buffer::update_sub(const wgpu::Device &device,
   if ((offset % kCopyAlignment) != 0 || (size % kCopyAlignment) != 0) {
     return false; /* WebGPU copies require 4-byte alignment */
   }
-  if (offset + size > size_) {
+  if (!range_fits(offset, size, size_)) {
     return false;
   }
 
@@ -182,8 +186,8 @@ std::vector<uint8_t> Buffer::read(const wgpu::Instance &instance,
   if (handle_ == nullptr || !readable_ || size == 0) {
     return out;
   }
-  const size_t copy = align_up(size, kCopyAlignment);
-  if (offset > size_ || copy > size_ - offset) {
+  size_t copy;
+  if (!checked_align_up(size, kCopyAlignment, copy) || !range_fits(offset, copy, size_)) {
     return out;
   }
