-        continue;
-      }
-      seen[e.binding] = true;
+    if (std::find(seen_bindings.begin(), seen_bindings.end(), e.binding) !=
+        seen_bindings.end())
+    {
+      continue;
     }
+    seen_bindings.push_back(e.binding);
     valid.push_back(e);
   }
   wgpu::BindGroupDescriptor bgd = {};
