+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * New for the web port (no upstream equivalent). */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Production GPU readback primitive (M5 lane L-A) - the caller-facing "kick on request,
+ * latch on tick, consume on settle" contract adopted in
+ * notes/m5-sync-readback-contract-design.md.
+ *
+ * WHY THIS EXISTS. In the windowed WM-worker profile a WebGPU map future cannot be
+ * waited on synchronously: `instance.WaitAny` needs asyncify/JSPI (dropped per ADR-006)
+ * and a same-thread blocking wait halts the very event loop that would deliver the map
+ * completion (ADR-007). So the historic `WGPUTexture::read` / `webgpu::Buffer::read`
+ * path (a `MapAsync(WaitAnyOnly)` + `WaitAny(f, UINT64_MAX)`) returns all-zero buffers
+ * on the web. Worse, its completion lambda captured the caller's stack BY REFERENCE and
+ * could fire spontaneously AFTER `read()` returned - a dangling write through a reused
+ * wasm function-table slot, the suspected `table index is out of bounds` crash after
+ * back-to-back snapshot ops (r25). See the design note section 4 (M5.readback-callback-
+ * lifetime).
+ *
+ * The proven lever (patches 0117/0125, twice) is `CallbackMode::AllowSpontaneous`: the
+ * map completion fires on the WM worker's own event loop BETWEEN main-loop ticks with no
+ * `ProcessEvents` dependency, provided the C++ stack has returned to the browser loop.
+ * This module promotes that lever to production quality behind one registry shared by
+ * both backend seams. Cache requests preserve the fill-late compatibility path, while
+ * exact requests provide a unique claimed snapshot for later public async callers:
+ *
+ *   KICK    - a request submits the copy + `MapAsync(AllowSpontaneous)` and registers a
+ *             heap-owned pending record. The callback captures shared durable state that
+ *             pins its staging and source WebGPU handles, never a caller stack or wrapper.
+ *   LATCH   - when the map resolves (a later tick) the callback strips row padding into a
+ *             per-source settled record, keyed so a later read of the SAME source finds it.
+ *   CONSUME - `take_settled()` returns the latched device bytes when present. The two
+ *             `read()` seams use it for the design's "return the latched bytes when
+ *             settled; on first-call-unsettled return the conservative interim (zeros)"
+ *             contract (kick-now, fill-one-tick-late).
+ *
+ * Native synchronous `read()` paths remain blocking and do not call this registry. The
+ * exact primitive itself is compiled on native too so its async ownership and ordering
+ * contract can be exercised against Dawn rather than only a mock.
+ *
+ * POLL / SETTLE for later lanes. `pending_count()` and `pump()` are the internal hooks a
+ * WM-loop "settle barrier" (L-C `wait_for_gpu_idle`) drives: advance ticks (returning to
+ * the loop so AllowSpontaneous can fire) until `pending_count()` reaches zero or a bounded
+ * frame budget is hit. The PUBLIC `GPU_*_read_async` API is deliberately NOT here - that
+ * is lane L-B (upstream-shared gpu/intern). This lane ships only the backend mechanics. */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "webgpu/webgpu_cpp.h"
+
+namespace blender::gpu::webgpu {
+class OrderedQueueScheduler;
+class WGPUTexture;
+}
+
+namespace blender::gpu::webgpu::readback {
+
+/** A readback ticket. 0 is never a valid ticket. Returned by the kick entry points and
+ * accepted by the poll/consume entry points; the later async GPU API (L-B) will surface
+ * these to callers. */
+using Ticket = uint64_t;
+constexpr Ticket kInvalidTicket = 0;
+
+/** Cache requests preserve the 0133 fill-late behavior: an identical in-flight source
+ * reuses its kick and a bounded source-key result may be served by a later synchronous
+ * read. Exact requests are claimed chronological snapshots for the later public async
+ * GPU API: every call submits a distinct copy and its result is retained until explicitly
+ * consumed or freed. */
+enum class RequestMode : uint8_t {
+  Cache = 0,
+  Exact = 1,
+};
+
+/** Ticket state. Invalid is returned for an unknown/retired ticket. Exact Failed and
+ * Canceled records remain queryable until free_ticket(); cache ticket metadata is bounded.
+ * A successful consume retires the ticket immediately, so a second consume sees Invalid. */
+enum class TicketStatus : uint8_t {
+  Invalid = 0,
+  Pending,
+  Ready,
+  Failed,
+  Canceled,
+};
+
+enum class TicketError : uint8_t {
+  None = 0,
+  InvalidArgument,
+  CapacityExceeded,
+  StagingAllocationFailed,
+  CommandEncodingFailed,
+  MapFailed,
+  NoMappedRange,
+  SourceForgotten,
+  Canceled,
+};
+
+/** Which backend seam a source key belongs to (a texture handle or a buffer handle can
+ * share a raw address across kinds, so the kind is part of the identity). */
+enum class SourceKind : uint8_t {
+  Texture = 0,
+  Buffer = 1,
+};
+
+/** Stable identity of a readback source, used both to de-duplicate in-flight kicks and to
+ * serve a settled result on a later read of the same source. `obj` is the logical wrapper
+ * pointer, `sub` disambiguates mip (texture) or
+ * byte offset (buffer), and `span` disambiguates differently-sized reads of one buffer
+ * region. */
+struct SourceKey {
+  SourceKind kind = SourceKind::Texture;
+  const void *obj = nullptr;
+  uint64_t sub = 0;
+  uint64_t span = 0;
+  uint32_t origin_x = 0;
+  uint32_t origin_y = 0;
+  uint32_t origin_z = 0;
+  uint32_t extent_x = 0;
+  uint32_t extent_y = 0;
+  uint32_t extent_z = 0;
+  uint8_t aspect = 0;
+};
+
+/** Exact texture copy region after resolving a Blender texture view to its backing
+ * WebGPU texture. Origins and extent are explicit so supported array-layer/mip views never
+ * silently fall back to mip 0 / layer 0. The backend's current 1D-array representation is
+ * exact only at mip 0; higher-mip requests are rejected until the representation is fixed. */
+struct TextureRegion {
+  uint32_t mip_level = 0;
+  uint32_t origin_x = 0;
+  uint32_t origin_y = 0;
+  uint32_t origin_z = 0;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t depth = 0;
+  wgpu::TextureAspect aspect = wgpu::TextureAspect::All;
+};
+
+/** KICK a texture readback: submit `CopyTextureToBuffer` of `region` into a fresh
+ * MapRead staging buffer, then `MapAsync(AllowSpontaneous)` and RETURN. The completion
+ * (a later tick) strips the 256-byte row padding to a tight `row_bytes` pitch and latches
+ * the device bytes under `key`. Heap-owned throughout; nothing is captured from the
+ * caller stack. The source must carry CopySrc usage and its actual uncompressed format,
+ * aspect, texel size, and region are validated before submission. Cache mode reuses an
+ * identical in-flight key. Exact mode always creates a new ticket and copy, with a terminal
+ * Failed ticket for argument/allocation/command/capacity errors whenever the registry can
+ * represent it. */
+Ticket kick_texture(const wgpu::Instance &instance,
+                    const wgpu::Device &device,
+                    const wgpu::Queue &queue,
+                    OrderedQueueScheduler &scheduler,
+                    const wgpu::Texture &tex,
+                    SourceKey key,
+                    const TextureRegion &region,
+                    uint32_t texel_bytes,
+                    uint32_t bytes_per_row,
+                    uint32_t row_bytes,
+                    RequestMode mode = RequestMode::Cache);
+
+/** KICK a buffer readback: `CopyBufferToBuffer(handle, offset, staging, 0, copy)` +
+ * `MapAsync(AllowSpontaneous)`. `want` (<= copy) bytes are latched under `key` when the
+ * map resolves. The underlying buffer handle is pinned in the record so its raw address
+ * cannot be reused before its callback completes. Cache mode reuses an identical
+ * in-flight key; exact mode always creates a new ticket and copy. */
+Ticket kick_buffer(const wgpu::Instance &instance,
+                   const wgpu::Device &device,
+                   const wgpu::Queue &queue,
+                   OrderedQueueScheduler &scheduler,
+                   const wgpu::Buffer &handle,
+                   SourceKey key,
+                   uint64_t offset,
+                   uint64_t copy,
+                   uint64_t want,
+                   RequestMode mode = RequestMode::Cache);
+
+/** CONSUME the latched device bytes for `key`, if a settled record exists whose payload
+ * is exactly `dst_len` bytes. Copies into `dst` and returns true (the record is kept so
+ * repeated reads keep hitting until the source is forgotten or the slot is evicted).
+ * Returns false when nothing is settled for `key` (the caller then sees the conservative
+ * interim: zeros/empty). This is the "return the latched bytes when settled" half. */
+bool take_settled(SourceKey key, void *dst, size_t dst_len);
+
+/** Current status/error/byte count for an unretired ticket. These entry points are
+ * thread-safe: a WM job may publish a map completion while a later caller polls it. */
+TicketStatus ticket_status(Ticket ticket);
+TicketError ticket_error(Ticket ticket);
+size_t ticket_size(Ticket ticket);
+
+/** True once the kick with this ticket has latched its result. Compatibility shorthand. */
+bool is_ready(Ticket ticket);
+
+/** Copy this exact ticket's immutable bytes into `dst` (up to `dst_len`) if ready; returns
+ * the number of bytes copied, or 0 if not ready / unknown / undersized destination. A
+ * successful consume TRANSFERS the payload and RETIRES the ticket exactly once. A later
+ * kick for the same source cannot change an exact result. */
+size_t consume_ticket(Ticket ticket, void *dst, size_t dst_len);
+
+/** Mark a pending/ready ticket canceled and discard any CPU payload. The backend callback
+ * still owns and cleans its staging/source WebGPU handles on the callback thread. */
+bool cancel_ticket(Ticket ticket);
+
+/** Release a ticket without consuming it. Pending work is canceled, but its durable
+ * callback state remains alive until WebGPU completes and performs owner-thread cleanup. */
+void free_ticket(Ticket ticket);
+
+/** Number of kicks whose map completion has not fired yet. A settle barrier pumps ticks
+ * until this reaches 0 (or a bounded budget). */
+int pending_count();
+
+/** Per-tick maintenance hook a WM-loop settle barrier may call: evicts stale settled
+ * records beyond the retention cap. The AllowSpontaneous completions do NOT need this to
+ * fire (they ride the loop on their own); it is bookkeeping only. Safe to never call. */
+void pump();
+
+/** Drop cache records that reference the exact (`kind`, `obj`) source. Cache work is
+ * marked orphaned so completion discards it. Exact tickets are deliberately untouched:
+ * their pending state pins the backing WebGPU handle and their immutable result remains
+ * claimed across wrapper destruction until consume/cancel/free. */
+void forget_source(SourceKind kind, const void *obj);
+
+}  // namespace blender::gpu::webgpu::readback
