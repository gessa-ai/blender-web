+  EXPECT_EQ(rgba_to_rgb, nullptr);
+  GPU_texture_free(rgb_srgb);
+  GPU_texture_free(rgb_same);
+  GPU_texture_free(rgb);
+  GPU_texture_free(snorm);
+  GPU_texture_free(base);
+  GPU_render_end();
