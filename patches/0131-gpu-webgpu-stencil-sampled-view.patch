   d.aspect = wgpu::TextureAspect::All;
+  /* A Blender stencil view records use_stencil_ in init_internal. Honor it before the
+   * generic depth path: the underlying combined texture must expose a StencilOnly,
+   * Stencil8 view to a uint sampled binding. Ignoring the flag and forcing DepthOnly
+   * made Workbench's stencil_tx (usampler2D) receive a Depth32Float view, so Dawn
+   * rejected the entire composite bind group. */
+  if (use_stencil_) {
+    d.aspect = wgpu::TextureAspect::StencilOnly;
+    if (wgpu_format_ == wgpu::TextureFormat::Depth32FloatStencil8 ||
+        wgpu_format_ == wgpu::TextureFormat::Depth24PlusStencil8)
+    {
+      d.format = wgpu::TextureFormat::Stencil8;
+    }
+  }
   /* Depth (and depth-stencil) textures cannot be SAMPLED through an All-aspect view:
    * WebGPU requires a single-aspect view, and a combined Depth32FloatStencil8 bound to
    * a Float/UnfilterableFloat sampled slot (overlay/workbench depth reads) is rejected
    * unless the depth aspect is isolated. Force DepthOnly; for a combined depth-stencil
    * format the view format must also be the aspect-specific (depth-only) format, since a
    * single-aspect view may not carry the combined format. */
-  if (format_flag_ & GPU_FORMAT_DEPTH) {
+  else if (format_flag_ & GPU_FORMAT_DEPTH) {
     d.aspect = wgpu::TextureAspect::DepthOnly;
     if (wgpu_format_ == wgpu::TextureFormat::Depth32FloatStencil8) {
