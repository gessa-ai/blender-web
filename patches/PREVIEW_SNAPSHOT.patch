+void GPU_texture_copy_mipmap(gpu::Texture *dst_, gpu::Texture *src_, int mip_level)
+{
+  Texture *src = src_;
+  Texture *dst = dst_;
+  BLI_assert(src != nullptr && dst != nullptr);
+  BLI_assert(src == nullptr || !src->is_texture_view());
+  BLI_assert(dst == nullptr || !dst->is_texture_view());
+  BLI_assert(mip_level >= 0 && mip_level < src->mip_count() && mip_level < dst->mip_count());
+  if (src == nullptr || dst == nullptr || src->is_texture_view() || dst->is_texture_view() ||
+      mip_level < 0 || mip_level >= src->mip_count() || mip_level >= dst->mip_count())
+  {
+    return;
+  }
+  src->copy_to(dst, IndexRange(mip_level, 1));
