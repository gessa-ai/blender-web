+static void i10_update_vertex_range(const size_t base,
+                                    const size_t stride,
+                                    const uint vertex_len,
+                                    const size_t update_start,
+                                    const size_t update_end,
+                                    uint &r_first,
+                                    uint &r_end)
+{
+  r_first = r_end = 0;
+  if (vertex_len == 0 || update_end <= base) {
+    return;
+  }
+  const size_t first = (update_start > base) ? (update_start - base) / stride : 0;
+  if (first >= vertex_len) {
+    return;
+  }
+  const size_t end_delta = update_end - base;
+  const size_t end = end_delta / stride + ((end_delta % stride) != 0);
+  r_first = uint(first);
+  r_end = uint((end < vertex_len) ? end : vertex_len);
+}
