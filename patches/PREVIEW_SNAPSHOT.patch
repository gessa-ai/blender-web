new file mode 100644
index 0000000000000000000000000000000000000000..b9b6e9bd50ebfc47adba05f8e232f1644ed8e629
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_texture_format.hh
@@ -0,0 +1,169 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/GPU_format.hh @ fbe6228777e7 */
+
+/** \file
+ * WebGPU texture-format table — the WebGPU analog of vk_common's to_vk_format.
+ *
+ * Maps Blender's `gpu::TextureFormat` (every value at the pin) to
+ * `wgpu::TextureFormat`, plus capability flags {renderable, filterable, storage,
+ * blendable, multisample}, a conversion class, and a device feature gate.
+ *
+ * SOURCE OF TRUTH (read-only recon): `upstream/source/blender/gpu/GPU_format.hh`
+ * — an X-macro table carrying, per format, {C-type, byte-size, channel-count,
+ * blender enum, VkFormat, MTLPixelFormat, MTLVertexFormat, GL enum, shader enum}.
+ * The enum set is `GPU_TEXTURE_FORMAT_EXPAND` in `GPU_texture.hh:45-124`. The
+ * Vulkan backend's equivalent mapping (the model) is
+ * `vulkan/vk_common.cc::to_vk_format` (a big switch over `TextureFormat::…`).
+ *
+ * KEY STRUCTURE (see notes/gpu-t9pre-findings.md):
+ *   - WebGPU, like Metal, has NO 3-channel texture formats. The 13 three-channel
+ *     Blender formats are PROMOTED to their 4-channel sibling with an RGB→RGBA
+ *     data conversion on upload (GPU_format.hh already aliases them to RGBA in the
+ *     MTLPixelFormat column, e.g. UNORM_8_8_8 → RGBA8Unorm). See
+ *     wgpu_data_conversion.{hh,cc}.
+ *   - All other formats map directly. 3 gates: BC/DXT compression
+ *     (texture-compression-bc), Depth32FloatStencil8 (its own feature), and the
+ *     non-core 16-bit UNORM/SNORM formats (adapter-dependent). Every Blender
+ *     format has SOME WebGPU target — none is unmappable, only feature-gated. */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#include "webgpu/webgpu_cpp.h"
+
+#include "intern/gpu_texture_private.hh"
+#include "GPU_texture.hh"  /* blender::gpu::TextureFormat */
+
+namespace blender::gpu::webgpu {
+
+/** Key on the REAL enum (GPU_texture.hh:40). The X-macro list
+ * (wgpu_texture_format_list.h) uses the same member names, so the table below
+ * generates directly against gpu::TextureFormat. */
+using TextureFormat = ::blender::gpu::TextureFormat;
+
+/** How the pixel bytes must be transformed before upload / after readback. */
+enum class ConvClass : uint8_t {
+  Direct,        /* memcpy; src layout == wgpu layout (incl. 32-bit packed). */
+  PromoteRGBA,   /* 3-channel → 4-channel sibling; add opaque alpha (RGB→RGBA). */
+  Depth,         /* depth/stencil aspect; restricted copy semantics. */
+  Compressed,    /* block-compressed (BC); block-aligned copy. */
+};
+
+/** Optional device feature a format needs to be creatable/usable. */
+enum class FeatureGate : uint8_t {
+  None,
+  TextureCompressionBC,   /* BC1/2/3 (DXT). */
+  Depth32FloatStencil8,   /* SFLOAT_32_DEPTH_UINT_8. */
+  Unorm16,                /* non-core R/RG/RGBA 16-bit UNORM (feature Unorm16TextureFormats). */
+  Snorm16,                /* 16-bit SNORM: NO WebGPU/Dawn support at the pin — must emulate. */
+  Float32Filterable,      /* filtering of 32-bit float formats (cap only, not creatability). */
+  RG11B10UfloatRenderable,/* render-target use of RG11B10Ufloat (cap only). */
+};
+
+/** WebGPU capability bits for a format (spec-derived; the harness validates the
+ * creation-observable ones: renderable/storage/multisample + round-trip). */
+struct FormatCaps {
+  bool renderable = false;   /* usable as a color/depth RENDER_ATTACHMENT. */
+  bool filterable = false;   /* a Filtering sampler may sample it. */
+  bool storage = false;      /* usable as a STORAGE_BINDING (write-only baseline). */
+  bool blendable = false;    /* supports fixed-function blending as a color target. */
+  bool multisample = false;  /* supports sampleCount > 1. */
+};
+
+/** Enabled optional texture-format features. Creation and render-attachment
+ * predicates share this device-free value so their feature policy cannot drift. */
+struct TextureFormatFeatures {
+  bool texture_compression_bc = false;
+  bool unorm16_texture_formats = false;
+  bool texture_formats_tier1 = false;
+  bool depth32_float_stencil8 = false;
+  bool float32_filterable = false;
+  bool rg11b10_ufloat_renderable = false;
+};
+
+/** True when a format gate can be created faithfully for the enabled feature set.
+ * SNORM16 remains creatable through its Uint emulation; Float32Filterable and
+ * RG11B10UfloatRenderable are capability-only gates and never block creation. */
+bool format_creation_supported(FeatureGate gate, const TextureFormatFeatures &features);
+
+/** True when `format` is render-attachment capable for the enabled feature set. */
+bool render_attachment_supported(wgpu::TextureFormat format,
+                                 const TextureFormatFeatures &features);
+
+struct FormatInfo {
+  TextureFormat blender;
+  const char *name;               /* blender enum spelling */
+  uint32_t src_bytes_per_pixel;   /* Source texel bytes, or bytes/block for compressed rows. */
+  uint8_t src_components;         /* 1..4 (GPU_format.hh comps col) */
+  wgpu::TextureFormat wgpu;       /* the actual texture format created on the device */
+  ConvClass conv;
+  FeatureGate gate;
+  FormatCaps caps;
+};
+
+/** Linear host layout for one block-compressed WriteTexture operation. Copy width/height are
+ * WebGPU's physical texel extent (rounded to complete 4x4 BC blocks); rows_per_image is in
+ * block rows, as required by TexelCopyBufferLayout. */
+struct CompressedUploadLayout {
+  uint32_t copy_width = 0;
+  uint32_t copy_height = 0;
+  uint32_t bytes_per_row = 0;
+  uint32_t rows_per_image = 0;
+  size_t data_size = 0;
+};
+
+/** Compute a bounded BC1/2/3 host layout without modifying `r_layout` on rejection.
+ * `unpack_row_length` is a source-row width in logical texels; zero selects `width`.
+ * Width/height are rounded to WebGPU's physical 4x4 block extent. */
+bool compressed_upload_layout(TextureFormat format,
+                              uint32_t width,
+                              uint32_t height,
+                              uint32_t layers,
+                              uint32_t unpack_row_length,
+                              CompressedUploadLayout &r_layout);
+
+/** BC texture formats are legal only on WebGPU 2D textures (including array/cube views).
+ * Sliced-3D compression is a distinct optional feature and is not part of Blender's pinned
+ * compressed-2D creation API. */
+bool compressed_texture_type_supported(GPUTextureType type);
+
+/** Translate Blender's documented `rgba` / `xyzw` / `01` sampled-texture mask alphabet.
+ * Undefined is the fail-closed sentinel for every other byte. */
+wgpu::ComponentSwizzle to_wgpu_component_swizzle(char component);
+
+/** Look up the full record for a Blender format. */
+const FormatInfo &format_info(TextureFormat format);
+
+/** The WebGPU texture format the backend creates for a Blender format (promotion
+ * applied — a 3-channel format returns its 4-channel target). */
+wgpu::TextureFormat to_wgpu_format(TextureFormat format);
+
+/** Return the WebGPU linear/sRGB partner that is legal in a texture descriptor's
+ * `viewFormats` list, or Undefined when the format has no such partner. WebGPU
+ * only permits view-format reinterpretation within one format compatibility
+ * class; arbitrary same-byte aliases remain intentionally unsupported. */
+wgpu::TextureFormat srgb_view_format_pair(wgpu::TextureFormat format);
+
+/** True when `view` may legally be created from a texture whose descriptor format
+ * is `backing`. This is deliberately narrower than Blender's FORMAT_VIEW contract:
+ * exact formats and the WebGPU-defined linear/sRGB pairs are handled here, while
+ * incompatible same-byte aliases are the dependent 0145 work. */
+bool is_legal_view_format(wgpu::TextureFormat backing, wgpu::TextureFormat view);
+
+/** Iterate the whole table (for the harness / reflection). */
+const FormatInfo *format_table(size_t &count);
+
+/** Spec capability classification from a wgpu::TextureFormat (used to fill
+ * FormatInfo::caps; exposed for the harness cross-check). */
+FormatCaps caps_of(wgpu::TextureFormat wgpu);
+
+const char *to_string(ConvClass c);
+const char *to_string(FeatureGate g);
+
+}  // namespace blender::gpu::webgpu
