+  read->invoke_event.next = nullptr;
+  read->invoke_event.prev = nullptr;
+  read->invoke_event.customdata = nullptr;
+  read->invoke_event.customdata_free = false;
+  read->sample_rect = sample_rect;
+  read->region_size[0] = read->region->winx;
+  read->region_size[1] = read->region->winy;
+  copy_m4_m4(read->viewinv, read->region_view->viewinv);
+  copy_m4_m4(read->winmat, read->region_view->winmat);
+  copy_m4_m4(read->persmat, read->region_view->persmat);
+  copy_m4_m4(read->persinv, read->region_view->persinv);
+  copy_v3_v3(read->ofs, read->region_view->ofs);
+  copy_v4_v4(read->viewquat, read->region_view->viewquat);
+  read->dist = read->region_view->dist;
+  read->camdx = read->region_view->camdx;
+  read->camdy = read->region_view->camdy;
+  read->camzoom = read->region_view->camzoom;
+  read->persp = int(read->region_view->persp);
+  read->view = int(read->region_view->view);
+  read->view_axis_roll = int(read->region_view->view_axis_roll);
+  read->view_lock = int(RV3D_LOCK_FLAGS(read->region_view));
+  read->lens = read->view3d->lens;
+  read->clip_start = read->view3d->clip_start;
+  read->clip_end = read->view3d->clip_end;
