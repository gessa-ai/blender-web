+struct WMWindowPixelsRead {
+  GPUOffScreen *offscreen = nullptr;
+  GPUReadback *readback = nullptr;
+  std::vector<uint8_t> native_bytes;
+  int2 size = {0, 0};
+  size_t expected_size = 0;
+};
+
+static bool wm_window_pixels_read_size(const int2 size, size_t &r_size)
+{
+  if (size.x <= 0 || size.y <= 0) {
+    return false;
+  }
+  const size_t width = size_t(size.x);
+  const size_t height = size_t(size.y);
+  if (height > std::numeric_limits<size_t>::max() / width) {
+    return false;
+  }
+  const size_t pixel_count = width * height;
+  if (pixel_count > std::numeric_limits<size_t>::max() / 4) {
+    return false;
+  }
+  r_size = pixel_count * 4;
+  return true;
+}
+
+static void wm_window_pixels_read_offscreen_release(WMWindowPixelsRead *readback)
+{
+  if (readback->offscreen != nullptr) {
+    GPU_offscreen_free(readback->offscreen);
+    readback->offscreen = nullptr;
+  }
+}
+
+static void wm_window_pixels_read_flip_rows(uint8_t *pixels, const int2 size)
+{
+  const size_t row_size = size_t(size.x) * 4;
+  for (int y = 0; y < size.y / 2; y++) {
+    uint8_t *row_a = pixels + size_t(y) * row_size;
+    uint8_t *row_b = pixels + size_t(size.y - 1 - y) * row_size;
+    std::swap_ranges(row_a, row_a + row_size, row_b);
+  }
+}
+
+WMWindowPixelsRead *WM_window_pixels_read_async(bContext *C, wmWindow *win)
+{
+  if (C == nullptr || win == nullptr) {
+    return nullptr;
+  }
+  const int2 win_size = WM_window_native_pixel_size(win);
+  size_t expected_size;
+  if (!wm_window_pixels_read_size(win_size, expected_size)) {
+    return nullptr;
+  }
+
+  const gpu::TextureFormat desired_format = get_hdr_framebuffer_format(
+      WM_window_get_active_scene(win));
+  GPUOffScreen *offscreen = GPU_offscreen_create(
+      win_size.x,
+      win_size.y,
+      false,
+      desired_format,
+      GPU_TEXTURE_USAGE_SHADER_READ | GPU_TEXTURE_USAGE_HOST_READ,
+      false,
+      nullptr);
+  if (offscreen == nullptr) {
+    return nullptr;
+  }
+
+  GPU_offscreen_bind(offscreen, false);
+  wm_draw_window_onscreen(C, win, -1);
+  GPU_offscreen_unbind(offscreen, false);
+
+  WMWindowPixelsRead *readback = MEM_new<WMWindowPixelsRead>(__func__);
+  readback->offscreen = offscreen;
+  readback->size = win_size;
+  readback->expected_size = expected_size;
+#ifdef __EMSCRIPTEN__
+  readback->readback = GPU_texture_read_async(
+      GPU_offscreen_color_texture(offscreen), GPU_DATA_UBYTE, 0);
+#else
+  readback->native_bytes.resize(expected_size);
+  GPU_offscreen_read_color(offscreen, GPU_DATA_UBYTE, readback->native_bytes.data());
+  wm_window_pixels_read_offscreen_release(readback);
+#endif
+  return readback;
+}
+
+WMWindowPixelsReadStatus WM_window_pixels_read_async_status(WMWindowPixelsRead *readback)
+{
+  if (readback == nullptr) {
+    return WMWindowPixelsReadStatus::Invalid;
+  }
+  if (!readback->native_bytes.empty()) {
+    return readback->native_bytes.size() == readback->expected_size ?
+               WMWindowPixelsReadStatus::Ready :
+               WMWindowPixelsReadStatus::Failed;
+  }
+
+  const eGPUReadbackStatus status = GPU_readback_status(readback->readback);
+  if (status == GPU_READBACK_PENDING) {
+    return WMWindowPixelsReadStatus::Pending;
+  }
+  if (status != GPU_READBACK_READY ||
+      GPU_readback_size(readback->readback) != readback->expected_size)
+  {
+    wm_window_pixels_read_offscreen_release(readback);
+    return WMWindowPixelsReadStatus::Failed;
+  }
+  wm_window_pixels_read_offscreen_release(readback);
+  return WMWindowPixelsReadStatus::Ready;
+}
+
+uint8_t *WM_window_pixels_read_async_consume(WMWindowPixelsRead *&readback, int r_size[2])
+{
+  if (r_size == nullptr ||
+      WM_window_pixels_read_async_status(readback) != WMWindowPixelsReadStatus::Ready)
+  {
+    return nullptr;
+  }
+
+  uint8_t *pixels = MEM_new_array_uninitialized<uint8_t>(readback->expected_size, __func__);
+  bool consumed = false;
+  if (readback->readback != nullptr) {
+    consumed = GPU_readback_consume(readback->readback, pixels, readback->expected_size);
+#ifdef __EMSCRIPTEN__
+    if (consumed) {
+      /* WGPUTexture::read_async returns physical top-origin rows. Match the existing
+       * framebuffer-read contract consumed by screenshots. */
+      wm_window_pixels_read_flip_rows(pixels, readback->size);
+    }
+#endif
+  }
+  else if (readback->native_bytes.size() == readback->expected_size) {
+    std::memcpy(pixels, readback->native_bytes.data(), readback->expected_size);
+    consumed = true;
+  }
+  if (!consumed) {
+    MEM_delete(pixels);
+    return nullptr;
+  }
+
+  r_size[0] = readback->size.x;
+  r_size[1] = readback->size.y;
+  WM_window_pixels_read_async_cancel(readback);
+  return pixels;
+}
+
+void WM_window_pixels_read_async_cancel(WMWindowPixelsRead *&readback)
+{
+  if (readback == nullptr) {
+    return;
+  }
+  GPU_readback_cancel(readback->readback);
+  wm_window_pixels_read_offscreen_release(readback);
+  MEM_delete(readback);
+  readback = nullptr;
+}
