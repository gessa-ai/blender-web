+/** Resolve the index-buffer handle before command encoding begins. A required missing handle
+ * invalidates the draw without changing the caller-owned result. A non-indexed draw publishes
+ * an empty handle even if a stale candidate was supplied. */
+template<typename HandleT>
+inline bool index_buffer_handle_resolve_if_required(const bool required,
+                                                    HandleT candidate,
+                                                    HandleT &result)
+{
+  if (!required) {
+    result = HandleT{};
+    return true;
+  }
+  return transient_handle_publish_if_valid(std::move(candidate), result);
+}
