+  uchar4 *copied = static_cast<uchar4 *>(GPU_texture_read(dst_view, GPU_DATA_UBYTE, 0));
+  uchar4 *dst_untouched = static_cast<uchar4 *>(
+      GPU_texture_read(dst_neighbor, GPU_DATA_UBYTE, 0));
