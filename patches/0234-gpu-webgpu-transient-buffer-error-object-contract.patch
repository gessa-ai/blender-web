+/** Create one transient WebGPU resource under the standard validation/OOM/internal scope set and
+ * gate all later queue work on its completed status. */
+template<typename InstanceT, typename DeviceT, typename CreateFn, typename CompleteFn>
+inline auto transient_resource_create_scoped(const InstanceT &instance,
+                                              const DeviceT &device,
+                                              OrderedQueueScheduler &scheduler,
+                                              const char *label,
+                                              CreateFn &&create,
+                                              CompleteFn &&complete)
+{
+  std::string operation_label = label ? label : "";
+  return transient_resource_gate_scoped(
+      scheduler,
+      [&device]() { webgpu_error_scopes_push(device); },
+      std::forward<CreateFn>(create),
+      [&instance, &device, operation_label = std::move(operation_label)](
+          auto completion) mutable {
+        webgpu_error_scopes_pop(
+            instance, device, std::move(operation_label), std::move(completion));
+      },
+      std::forward<CompleteFn>(complete));
+}
