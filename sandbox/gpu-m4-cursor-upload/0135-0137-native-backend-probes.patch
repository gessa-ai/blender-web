+static void test_shader_storage_binding_chronology()
+{
+  static constexpr uint SIZE = 16;
+
+  gpu::Shader *shader = GPU_shader_create_from_info_name("gpu_compute_vbo_test");
+  ASSERT_NE(shader, nullptr);
+  GPU_shader_bind(shader);
+  const int slot = GPU_shader_get_ssbo_binding(shader, "out_positions");
+
+  GPUVertFormat format = {0};
+  GPU_vertformat_attr_add(&format, "pos", gpu::VertAttrType::SFLOAT_32_32_32_32);
+  VertBuf *vbo = GPU_vertbuf_create_with_format_ex(format, GPU_USAGE_DEVICE_ONLY);
+  GPU_vertbuf_data_alloc(*vbo, SIZE);
+  StorageBuf *ssbo = GPU_storagebuf_create_ex(
+      SIZE * sizeof(float4), nullptr, GPU_USAGE_DEVICE_ONLY, __func__);
+
+  /* A later VBO bind must replace an earlier StorageBuf at the same raw storage slot. */
+  GPU_storagebuf_bind(ssbo, slot);
+  GPU_vertbuf_bind_as_ssbo(vbo, slot);
+  GPU_compute_dispatch(shader, SIZE, 1, 1);
+  GPU_memory_barrier(GPU_BARRIER_BUFFER_UPDATE);
+  float vbo_data[SIZE * 4];
+  GPU_vertbuf_read(vbo, vbo_data);
+  for (int index = 0; index < SIZE; index++) {
+    EXPECT_FLOAT_EQ(vbo_data[index * 4], float(index));
+  }
+
+  /* Reversing the order must replace the VBO, not leave or later resurrect it. */
+  GPU_vertbuf_bind_as_ssbo(vbo, slot);
+  GPU_storagebuf_bind(ssbo, slot);
+  GPU_compute_dispatch(shader, SIZE, 1, 1);
+  GPU_memory_barrier(GPU_BARRIER_BUFFER_UPDATE);
+  float ssbo_data[SIZE * 4];
+  GPU_storagebuf_read(ssbo, ssbo_data);
+  for (int index = 0; index < SIZE; index++) {
+    EXPECT_FLOAT_EQ(ssbo_data[index * 4], float(index));
+  }
+
+  GPU_shader_unbind();
+  GPU_storagebuf_free(ssbo);
+  GPU_vertbuf_discard(vbo);
+  GPU_shader_free(shader);
+}
+GPU_TEST(shader_storage_binding_chronology)
