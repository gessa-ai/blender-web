+bool IrradianceBake::read_result_packed_async_begin()
+{
+  for (GPUReadback *readback : result_readbacks_) {
+    if (readback != nullptr) {
+      return false;
+    }
+  }
+
+  result_readback_size_ = int3(
+      irradiance_L0_tx_.width(), irradiance_L0_tx_.height(), irradiance_L0_tx_.depth());
+  if (math::reduce_min(result_readback_size_) <= 0) {
+    return false;
+  }
+
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+  result_readbacks_[0] = GPU_texture_read_async(irradiance_L0_tx_, GPU_DATA_FLOAT, 0);
+  result_readbacks_[1] = GPU_texture_read_async(irradiance_L1_a_tx_, GPU_DATA_FLOAT, 0);
+  result_readbacks_[2] = GPU_texture_read_async(irradiance_L1_b_tx_, GPU_DATA_FLOAT, 0);
+  result_readbacks_[3] = GPU_texture_read_async(irradiance_L1_c_tx_, GPU_DATA_FLOAT, 0);
+  result_readbacks_[4] = GPU_texture_read_async(validity_tx_, GPU_DATA_FLOAT, 0);
+
+  for (GPUReadback *readback : result_readbacks_) {
+    if (readback == nullptr) {
+      read_result_packed_async_cancel();
+      return false;
+    }
+  }
+  return true;
+}
+
+eGPUReadbackStatus IrradianceBake::read_result_packed_async_status() const
+{
+  bool has_pending = false;
+  for (GPUReadback *readback : result_readbacks_) {
+    const eGPUReadbackStatus status = GPU_readback_status(readback);
+    if (status == GPU_READBACK_FAILED || status == GPU_READBACK_INVALID) {
+      return GPU_READBACK_FAILED;
+    }
+    has_pending |= status == GPU_READBACK_PENDING;
+  }
+  return has_pending ? GPU_READBACK_PENDING : GPU_READBACK_READY;
+}
+
+eGPUReadbackError IrradianceBake::read_result_packed_async_error() const
+{
+  for (GPUReadback *readback : result_readbacks_) {
+    const eGPUReadbackStatus status = GPU_readback_status(readback);
+    if (status == GPU_READBACK_FAILED) {
+      return GPU_readback_error(readback);
+    }
+    if (status == GPU_READBACK_INVALID) {
+      return GPU_READBACK_ERROR_BACKEND_FAILURE;
+    }
+  }
+  return GPU_READBACK_ERROR_NONE;
+}
+
+LightProbeGridCacheFrame *IrradianceBake::read_result_packed_async_consume()
+{
+  if (read_result_packed_async_status() != GPU_READBACK_READY) {
+    return nullptr;
+  }
+
+  const int64_t sample_count = int64_t(result_readback_size_.x) * result_readback_size_.y *
+                               result_readback_size_.z;
+  const size_t coefficient_bytes = size_t(sample_count) * sizeof(float[4]);
+  const size_t validity_bytes = size_t(sample_count) * sizeof(float);
+  for (const int i : IndexRange(result_readback_len_)) {
+    const size_t expected_size = (i == result_readback_len_ - 1) ? validity_bytes :
+                                                                         coefficient_bytes;
+    if (GPU_readback_size(result_readbacks_[i]) != expected_size) {
+      read_result_packed_async_cancel();
+      return nullptr;
+    }
+  }
+
+  LightProbeGridCacheFrame *cache_frame = BKE_lightprobe_grid_cache_frame_create();
+  read_surfels(cache_frame);
+  read_virtual_offset(cache_frame);
+  cache_frame->size[0] = result_readback_size_.x;
+  cache_frame->size[1] = result_readback_size_.y;
+  cache_frame->size[2] = result_readback_size_.z;
+
+  cache_frame->baking.L0 = static_cast<float(*)[4]>(
+      MEM_new_uninitialized(coefficient_bytes, __func__));
+  cache_frame->baking.L1_a = static_cast<float(*)[4]>(
+      MEM_new_uninitialized(coefficient_bytes, __func__));
+  cache_frame->baking.L1_b = static_cast<float(*)[4]>(
+      MEM_new_uninitialized(coefficient_bytes, __func__));
+  cache_frame->baking.L1_c = static_cast<float(*)[4]>(
+      MEM_new_uninitialized(coefficient_bytes, __func__));
+  cache_frame->baking.validity = static_cast<float *>(
+      MEM_new_uninitialized(validity_bytes, __func__));
+
+  void *destinations[result_readback_len_] = {cache_frame->baking.L0,
+                                               cache_frame->baking.L1_a,
+                                               cache_frame->baking.L1_b,
+                                               cache_frame->baking.L1_c,
+                                               cache_frame->baking.validity};
+  for (const int i : IndexRange(result_readback_len_)) {
+    const size_t expected_size = (i == result_readback_len_ - 1) ? validity_bytes :
+                                                                         coefficient_bytes;
+    if (destinations[i] == nullptr ||
+        !GPU_readback_consume(result_readbacks_[i], destinations[i], expected_size))
+    {
+      BKE_lightprobe_grid_cache_frame_free(cache_frame);
+      read_result_packed_async_cancel();
+      return nullptr;
+    }
+  }
+
+  return pack_result(cache_frame);
+}
+
+void IrradianceBake::read_result_packed_async_cancel()
+{
+  for (GPUReadback *&readback : result_readbacks_) {
+    GPU_readback_cancel(readback);
+  }
+  result_readback_size_ = int3(0);
+}
