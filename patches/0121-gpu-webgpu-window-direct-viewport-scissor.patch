diff --git a/source/blender/gpu/webgpu/wgpu_framebuffer.cc b/source/blender/gpu/webgpu/wgpu_framebuffer.cc
--- a/source/blender/gpu/webgpu/wgpu_framebuffer.cc
+++ b/source/blender/gpu/webgpu/wgpu_framebuffer.cc
@@ -457,7 +457,54 @@
   rp.colorAttachments = color_atts.empty() ? nullptr : color_atts.data();
   rp.depthStencilAttachment = has_depth ? &dsa : nullptr;
 
-  return encoder.BeginRenderPass(&rp);
+  wgpu::RenderPassEncoder pass = encoder.BeginRenderPass(&rp);
+
+  WGPUContext *wctx = active_context();
+  const bool is_backbuffer = (wctx != nullptr && wctx->is_window_backbuffer(this));
+
+  /* Window-direct viewport/scissor application (M4 r39, DEFECT B). Region content is
+   * normally drawn into a region-sized offscreen (viewport == whole target), so the
+   * single-pass/immediate draw paths apply no SetViewport/SetScissorRect and the
+   * whole-target default is correct. But wm_draw_window_onscreen draws region overlays
+   * (wm_region_draw_overlay -> ED_*_draw_overlay, e.g. the timeline current-frame
+   * indicator) and paint cursors STRAIGHT to the window backbuffer with a region
+   * sub-rect set via wmViewport(region->winrct)/GPU_scissor. With no viewport applied,
+   * that region-local geometry mapped to the full window and fell outside the visible
+   * result (the missing playhead box). Apply the frontend viewport/scissor for the
+   * window backbuffer only, converting the stored GL bottom-origin Y to the WebGPU
+   * top-origin backbuffer (same flip as the 0115 blit: y' = H - (y + h)); offscreen
+   * targets (and the native/headless gpu gate, which has no window backbuffer) keep the
+   * whole-target default untouched. */
+  if (is_backbuffer) {
+    const int fb_h = height_;
+    const int fb_w = width_;
+    int vp[4];
+    viewport_get(vp);
+    if (vp[2] > 0 && vp[3] > 0) {
+      const int vy = fb_h - (vp[1] + vp[3]);
+      const int cx = std::clamp(vp[0], 0, fb_w);
+      const int cy = std::clamp(vy, 0, fb_h);
+      const int cw = std::clamp(vp[2], 0, fb_w - cx);
+      const int ch = std::clamp(vp[3], 0, fb_h - cy);
+      if (cw > 0 && ch > 0) {
+        pass.SetViewport(float(cx), float(cy), float(cw), float(ch), 0.0f, 1.0f);
+      }
+    }
+    if (scissor_test_get()) {
+      int sc[4];
+      scissor_get(sc);
+      const int sy = fb_h - (sc[1] + sc[3]);
+      const int cx = std::clamp(sc[0], 0, fb_w);
+      const int cy = std::clamp(sy, 0, fb_h);
+      const int cw = std::clamp(sc[2], 0, fb_w - cx);
+      const int ch = std::clamp(sc[3], 0, fb_h - cy);
+      if (cw > 0 && ch > 0) {
+        pass.SetScissorRect(uint32_t(cx), uint32_t(cy), uint32_t(cw), uint32_t(ch));
+      }
+    }
+  }
+
+  return pass;
 }
 
