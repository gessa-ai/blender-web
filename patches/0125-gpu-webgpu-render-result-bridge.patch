+/* M6 r35: render-result bridge counters. Every WGPUTexture::read() under BW_DIAG kicks
+ * one tick-pumped readback so the render OP's final combined-pass read (which otherwise
+ * returns zeros -> black PNG) lands its true device bytes in /tmp/bw_readback_<seq>.bin.
+ * Bounded so a readback-heavy caller cannot spawn unbounded staging buffers. */
+int g_read_captures = 0;
+const int kMaxReadCaptures = 256;
+
 /* Latched true once BW_DIAG is observed set; the whole module is a no-op until then. */
