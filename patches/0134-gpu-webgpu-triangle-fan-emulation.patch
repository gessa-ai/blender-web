+static wgpu::ComputePipeline triangle_fan_index_pipeline(const wgpu::Device &device)
+{
+  /* The application owns one WebGPU device. Match the render-pipeline pool's
+   * device-lifetime assumption and compile this small topology kernel once. */
+  static wgpu::ComputePipeline pipeline;
+  if (pipeline != nullptr) {
+    return pipeline;
+  }
+  static constexpr const char *source = R"(
+struct Params {
+  first : u32,
+  count : u32,
+  restart : u32,
+  max_count : u32,
+}
+@group(0) @binding(0) var<storage, read> source_indices : array<u32>;
+@group(0) @binding(1) var<storage, read_write> output_indices : array<u32>;
+@group(0) @binding(2) var<uniform> params : Params;
+
+fn load_index(position : u32) -> u32 {
+  if (params.restart == 0xffffu) {
+    let packed = source_indices[position >> 1u];
+    return select(packed & 0xffffu, packed >> 16u, (position & 1u) != 0u);
+  }
+  return source_indices[position];
+}
+
+@compute @workgroup_size(1)
+fn main() {
+  var output_count = 0u;
+  var fan_count = 0u;
+  var fan_first = 0u;
+  var fan_previous = 0u;
+  for (var i = 0u; i < params.count; i++) {
+    let index = load_index(params.first + i);
+    if (index == params.restart) {
+      fan_count = 0u;
+    }
+    else if (fan_count == 0u) {
+      fan_first = index;
+      fan_count = 1u;
+    }
+    else if (fan_count == 1u) {
+      fan_previous = index;
+      fan_count = 2u;
+    }
+    else {
+      output_indices[output_count] = fan_first;
+      output_indices[output_count + 1u] = fan_previous;
+      output_indices[output_count + 2u] = index;
+      output_indices[output_count + 3u] = 0xffffffffu;
+      output_count += 4u;
+      fan_previous = index;
+      fan_count += 1u;
+    }
+  }
+  /* Restart isolates each three-index strip. Unused capacity is restart-only,
+   * producing neither primitives nor vertex shader invocations. */
+  while (output_count < params.max_count) {
+    output_indices[output_count] = 0xffffffffu;
+    output_count += 1u;
+  }
+}
+)";
+  wgpu::ShaderSourceWGSL wgsl = {};
+  wgsl.code = source;
+  wgpu::ShaderModuleDescriptor shader_descriptor = {};
+  shader_descriptor.nextInChain = &wgsl;
+  wgpu::ShaderModule module = device.CreateShaderModule(&shader_descriptor);
+  wgpu::ComputePipelineDescriptor pipeline_descriptor = {};
+  pipeline_descriptor.compute.module = module;
+  pipeline_descriptor.compute.entryPoint = "main";
+  pipeline = device.CreateComputePipeline(&pipeline_descriptor);
+  return pipeline;
+}
+
+static bool expand_indexed_triangle_fan(WGPUContext &ctx,
+                                        WGPUIndexBuffer &source,
+                                        uint32_t first,
+                                        uint32_t count,
+                                        webgpu::Buffer &r_output,
+                                        uint32_t &r_output_count)
+{
+  if (!source.buffer().valid() || count < 3) {
+    return false;
+  }
+  const uint64_t max_output_count = uint64_t(count - 2) * 4;
+  const uint64_t source_first = uint64_t(source.index_start_get()) + first;
+  const uint64_t source_last = source_first + count - 1;
+  const uint64_t source_byte_end = (source_last + 1) * (source.is_32bit() ? 4 : 2);
+  if (max_output_count > UINT32_MAX ||
+      max_output_count > SIZE_MAX / sizeof(uint32_t) || source_last > UINT32_MAX ||
+      source_byte_end > source.buffer().size())
+  {
+    return false;
+  }
+  r_output_count = uint32_t(max_output_count);
+  if (!r_output.create(ctx.device_get(),
+                       webgpu::BufferKind::Index,
+                       webgpu::UsageType::DeviceOnly,
+                       size_t(max_output_count) * sizeof(uint32_t),
+                       nullptr,
+                       false))
+  {
+    return false;
+  }
+  const uint32_t params[4] = {uint32_t(source_first),
+                              count,
+                              source.is_32bit() ? 0xffffffffu : 0xffffu,
+                              r_output_count};
+  webgpu::Buffer params_buffer;
+  if (!params_buffer.create(ctx.device_get(),
+                            webgpu::BufferKind::Uniform,
+                            webgpu::UsageType::Static,
+                            sizeof(params),
+                            params,
+                            false))
+  {
+    return false;
+  }
+
+  const wgpu::ComputePipeline pipeline = triangle_fan_index_pipeline(ctx.device_get());
+  if (pipeline == nullptr) {
+    return false;
+  }
+  wgpu::BindGroupEntry entries[3] = {};
+  entries[0].binding = 0;
+  entries[0].buffer = source.buffer().handle();
+  entries[0].size = source.buffer().size();
+  entries[1].binding = 1;
+  entries[1].buffer = r_output.handle();
+  entries[1].size = size_t(r_output_count) * sizeof(uint32_t);
+  entries[2].binding = 2;
+  entries[2].buffer = params_buffer.handle();
+  entries[2].size = sizeof(params);
+  wgpu::BindGroupDescriptor group_descriptor = {};
+  group_descriptor.layout = pipeline.GetBindGroupLayout(0);
+  group_descriptor.entryCount = 3;
+  group_descriptor.entries = entries;
+  const wgpu::BindGroup group = ctx.device_get().CreateBindGroup(&group_descriptor);
+  if (group == nullptr) {
+    return false;
+  }
+
+  wgpu::CommandEncoder encoder = ctx.device_get().CreateCommandEncoder();
+  wgpu::ComputePassEncoder pass = encoder.BeginComputePass();
+  pass.SetPipeline(pipeline);
+  pass.SetBindGroup(0, group);
+  pass.DispatchWorkgroups(1);
+  pass.End();
+  wgpu::CommandBuffer command_buffer = encoder.Finish();
+  ctx.queue_get().Submit(1, &command_buffer);
+  return true;
+}
