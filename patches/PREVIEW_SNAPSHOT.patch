+static bool wgsl_position_has_invariant(const std::string &wgsl)
+{
+  size_t line_begin = 0;
+  while (line_begin < wgsl.size()) {
+    const size_t line_end = wgsl.find('\n', line_begin);
+    const std::string_view line(
+        wgsl.data() + line_begin,
+        (line_end == std::string::npos ? wgsl.size() : line_end) - line_begin);
+    if (line.find("@builtin(position)") != std::string_view::npos &&
+        line.find("@invariant") != std::string_view::npos)
+    {
+      return true;
+    }
+    if (line_end == std::string::npos) {
+      break;
+    }
+    line_begin = line_end + 1;
+  }
+  return false;
+}
+
+static void test_framebuffer_webgpu_invariant_position_depth_equal()
+{
+  using namespace gpu::shader;
+
+  /* Assert the full production compiler chain preserves GLSL position
+   * invariance, rather than relying on the GLSL declaration alone. */
+  webgpu::ShaderStageSources compiler_sources;
+  compiler_sources.name = __func__;
+  compiler_sources.vertex = R"(#version 450
+invariant gl_Position;
+void main()
+{
+  gl_Position = vec4(0.0, 0.0, 0.0, 1.0);
+}
+)";
+  const webgpu::CompileResult compiler_result = webgpu::compile_shader(compiler_sources, {});
+  ASSERT_TRUE(compiler_result.ok) << compiler_result.error;
+  EXPECT_TRUE(wgsl_position_has_invariant(compiler_result.vertex_wgsl))
+      << compiler_result.vertex_wgsl;
+
+  GPU_render_begin();
+
+  const int2 size(8, 8);
+  const eGPUTextureUsage color_usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                       GPU_TEXTURE_USAGE_HOST_READ;
+  gpu::Texture *color = GPU_texture_create_2d(
+      __func__, UNPACK2(size), 1, TextureFormat::UINT_32, color_usage, nullptr);
+  gpu::Texture *depth = GPU_texture_create_2d(__func__,
+                                              UNPACK2(size),
+                                              1,
+                                              TextureFormat::SFLOAT_32_DEPTH,
+                                              GPU_TEXTURE_USAGE_ATTACHMENT,
+                                              nullptr);
+  ASSERT_NE(color, nullptr);
+  ASSERT_NE(depth, nullptr);
+
+  gpu::FrameBuffer *framebuffer = nullptr;
+  GPU_framebuffer_ensure_config(
+      &framebuffer, {GPU_ATTACHMENT_TEXTURE(depth), GPU_ATTACHMENT_TEXTURE(color)});
+  ASSERT_NE(framebuffer, nullptr);
+  GPU_framebuffer_bind(framebuffer);
+  GPU_framebuffer_clear_color_depth(framebuffer, double4(0.0), 1.0f);
+
+  ShaderCreateInfo depth_info("webgpu_invariant_position_depth_writer");
+  depth_info.builtins(BuiltinBits::VERTEX_ID);
+  depth_info.fragment_out(0, Type::uint_t, "out_value");
+  depth_info.vertex_source_generated = R"(
+void main()
+{
+  int vertex = gl_VertexID % 3;
+  float x = -1.0 + float((vertex & 1) << 2);
+  float y = -1.0 + float((vertex & 2) << 1);
+  gl_Position = vec4(x, y, 0.0, 1.0);
+}
+)";
+  depth_info.fragment_source_generated = R"(
+void main()
+{
+  out_value = 0x2468ACE0u;
+}
+)";
+  gpu::Shader *depth_shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&depth_info));
+  ASSERT_NE(depth_shader, nullptr);
+
+  /* Deliberately use a separate shader and differently factored source so this
+   * is two distinct vertex/fragment pipelines over identical geometry. */
+  ShaderCreateInfo equal_info("webgpu_invariant_position_equal_shading");
+  equal_info.builtins(BuiltinBits::VERTEX_ID);
+  equal_info.fragment_out(0, Type::uint_t, "out_value");
+  equal_info.vertex_source_generated = R"(
+vec4 fullscreen_position(int vertex)
+{
+  vec2 position = vec2(-1.0);
+  position.x += float((vertex & 1) << 2);
+  position.y += float((vertex & 2) << 1);
+  return vec4(position, 0.0, 1.0);
+}
+void main()
+{
+  gl_Position = fullscreen_position(gl_VertexID % 3);
+}
+)";
+  equal_info.fragment_source_generated = R"(
+void main()
+{
+  out_value = 0x13579BDFu;
+}
+)";
+  gpu::Shader *equal_shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&equal_info));
+  ASSERT_NE(equal_shader, nullptr);
+
+  Batch *batch = GPU_batch_create_procedural(GPU_PRIM_TRIS, 3);
+  ASSERT_NE(batch, nullptr);
+
+  GPU_depth_test(GPU_DEPTH_ALWAYS);
+  GPU_write_mask(GPU_WRITE_DEPTH);
+  GPU_batch_set_shader(batch, depth_shader);
+  GPU_batch_draw(batch);
+
+  GPU_depth_test(GPU_DEPTH_EQUAL);
+  GPU_write_mask(GPU_WRITE_COLOR);
+  GPU_batch_set_shader(batch, equal_shader);
+  GPU_batch_draw(batch);
+  GPU_finish();
+
+  uint32_t *read_data = static_cast<uint32_t *>(GPU_texture_read(color, GPU_DATA_UINT, 0));
+  ASSERT_NE(read_data, nullptr);
+  for (const int pixel : IndexRange(size.x * size.y)) {
+    EXPECT_EQ(read_data[pixel], 0x13579BDFu) << "pixel " << pixel;
+  }
+
+  MEM_delete(read_data);
+  GPU_depth_test(GPU_DEPTH_LESS_EQUAL);
+  GPU_write_mask(GPU_WRITE_COLOR);
+  GPU_batch_discard(batch);
+  GPU_shader_unbind();
+  GPU_shader_free(equal_shader);
+  GPU_shader_free(depth_shader);
+  GPU_framebuffer_free(framebuffer);
+  GPU_texture_free(depth);
+  GPU_texture_free(color);
+  GPU_render_end();
+}
+
+GPU_WEBGPU_TEST(framebuffer_webgpu_invariant_position_depth_equal)
+
+static void test_framebuffer_webgpu_depth_only_ignores_stencil_state()
+{
+  using namespace gpu::shader;
+  GPU_render_begin();
+
+  const int2 size(4, 4);
+  gpu::Texture *color = GPU_texture_create_2d(__func__,
+                                               UNPACK2(size),
+                                               1,
+                                               TextureFormat::UINT_32,
+                                               GPU_TEXTURE_USAGE_ATTACHMENT |
+                                                   GPU_TEXTURE_USAGE_HOST_READ,
+                                               nullptr);
+  gpu::Texture *depth = GPU_texture_create_2d(__func__,
+                                               UNPACK2(size),
+                                               1,
+                                               TextureFormat::SFLOAT_32_DEPTH,
+                                               GPU_TEXTURE_USAGE_ATTACHMENT,
+                                               nullptr);
+  ASSERT_NE(color, nullptr);
+  ASSERT_NE(depth, nullptr);
+
+  gpu::FrameBuffer *framebuffer = nullptr;
+  GPU_framebuffer_ensure_config(
+      &framebuffer, {GPU_ATTACHMENT_TEXTURE(depth), GPU_ATTACHMENT_TEXTURE(color)});
+  ASSERT_NE(framebuffer, nullptr);
+  GPU_framebuffer_bind(framebuffer);
+  GPU_framebuffer_clear_color_depth(framebuffer, double4(0.0), 1.0f);
+
+  ShaderCreateInfo info("webgpu_depth_only_ignores_stencil_state");
+  info.builtins(BuiltinBits::VERTEX_ID);
+  info.fragment_out(0, Type::uint_t, "out_value");
+  info.vertex_source_generated = R"(
+void main()
+{
+  int vertex = gl_VertexID % 3;
+  float x = -1.0 + float((vertex & 1) << 2);
+  float y = -1.0 + float((vertex & 2) << 1);
+  gl_Position = vec4(x, y, 0.0, 1.0);
+}
+)";
+  info.fragment_source_generated = R"(
+void main()
+{
+  out_value = 0x10203040u;
+}
+)";
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+  Batch *batch = GPU_batch_create_procedural(GPU_PRIM_TRIS, 3);
+  ASSERT_NE(batch, nullptr);
+  GPU_batch_set_shader(batch, shader);
+
+  /* Blender can retain stencil state while rendering into a depth-only target.
+   * WebGPU requires every stencil operation to remain Keep when the attachment
+   * format has no stencil aspect; the backend must ignore that unavailable state. */
+  GPU_state_set(GPU_WRITE_COLOR,
+                GPU_BLEND_NONE,
+                GPU_CULL_NONE,
+                GPU_DEPTH_ALWAYS,
+                GPU_STENCIL_ALWAYS,
+                GPU_STENCIL_OP_REPLACE,
+                GPU_VERTEX_LAST);
+  GPU_batch_draw(batch);
+  GPU_finish();
+
+  uint32_t *read_data = static_cast<uint32_t *>(GPU_texture_read(color, GPU_DATA_UINT, 0));
+  ASSERT_NE(read_data, nullptr);
+  for (const int pixel : IndexRange(size.x * size.y)) {
+    EXPECT_EQ(read_data[pixel], 0x10203040u) << "pixel " << pixel;
+  }
+
+  MEM_delete(read_data);
+  GPU_state_set(GPU_WRITE_COLOR,
+                GPU_BLEND_NONE,
+                GPU_CULL_NONE,
+                GPU_DEPTH_LESS_EQUAL,
+                GPU_STENCIL_NONE,
+                GPU_STENCIL_OP_NONE,
+                GPU_VERTEX_LAST);
+  GPU_batch_discard(batch);
+  GPU_shader_unbind();
+  GPU_shader_free(shader);
+  GPU_framebuffer_free(framebuffer);
+  GPU_texture_free(depth);
+  GPU_texture_free(color);
+  GPU_render_end();
+}
+
+GPU_WEBGPU_TEST(framebuffer_webgpu_depth_only_ignores_stencil_state)
+
+#endif
+
 }  // namespace blender::gpu::tests
