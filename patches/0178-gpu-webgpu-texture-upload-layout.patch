+/** True when a non-empty texture copy box fits within an available physical subresource.
+ * Subtraction avoids overflow even for adversarial uint32_t origins/extents. */
+inline bool texture_region_fits(const wgpu::Origin3D &origin,
+                                const wgpu::Extent3D &extent,
+                                const wgpu::Extent3D &capacity)
+{
+  return extent.width != 0 && extent.height != 0 && extent.depthOrArrayLayers != 0 &&
+         origin.x <= capacity.width && extent.width <= capacity.width - origin.x &&
+         origin.y <= capacity.height && extent.height <= capacity.height - origin.y &&
+         origin.z <= capacity.depthOrArrayLayers &&
+         extent.depthOrArrayLayers <= capacity.depthOrArrayLayers - origin.z;
+}
