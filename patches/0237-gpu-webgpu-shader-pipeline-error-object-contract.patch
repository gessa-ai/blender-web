+bool WGPUShader::ensure_shader_modules(const wgpu::Instance &instance,
+                                       const wgpu::Device &device)
+{
+  if (instance == nullptr || device == nullptr ||
+      (vertex_wgsl_.empty() && fragment_wgsl_.empty() && compute_wgsl_.empty()))
+  {
+    return false;
+  }
+  if (shader_module_cache_.lookup(kShaderModuleKey) != nullptr) {
