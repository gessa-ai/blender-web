+bool indirect_draw_span(const int count,
+                        const intptr_t offset,
+                        const intptr_t stride,
+                        const bool indexed,
+                        const uint64_t buffer_size,
+                        IndirectDrawSpan &r_span)
+{
+  if (count <= 0 || offset < 0 || stride < 0) {
+    return false;
+  }
+
+  IndirectDrawSpan candidate;
+  candidate.first_offset = uint64_t(offset);
+  candidate.command_size = indexed ? 5u * sizeof(uint32_t) : 4u * sizeof(uint32_t);
+  /* Blender's API follows glMultiDraw*Indirect: zero means tightly packed. */
+  candidate.command_stride = (stride == 0) ? candidate.command_size : uint64_t(stride);
+  if ((candidate.first_offset & 3u) != 0 || (candidate.command_stride & 3u) != 0) {
+    return false;
+  }
+
+  /* First reserve the final command's fixed byte span inside the allocation. The
+   * remaining quotient then bounds (count - 1) * stride without overflowing. */
+  if (candidate.command_size > buffer_size ||
+      candidate.first_offset > buffer_size - candidate.command_size)
+  {
+    return false;
+  }
+  const uint64_t last_start_capacity =
+      buffer_size - candidate.command_size - candidate.first_offset;
+  const uint64_t steps = uint64_t(count - 1);
+  if (steps > last_start_capacity / candidate.command_stride) {
+    return false;
+  }
+  candidate.end_offset = candidate.first_offset + steps * candidate.command_stride +
+                         candidate.command_size;
+  r_span = candidate;
+  return true;
+}
