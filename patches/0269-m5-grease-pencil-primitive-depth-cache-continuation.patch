+static bool grease_pencil_primitive_depth_cache_context_matches(
+    const bContext *C, const PrimitiveToolOperation &ptd)
+{
+  if (CTX_wm_manager(C) != ptd.depth_cache_manager ||
+      CTX_wm_window(C) != ptd.depth_cache_window ||
+      CTX_wm_screen(C) != ptd.depth_cache_screen || CTX_wm_area(C) != ptd.depth_cache_area ||
+      CTX_wm_region(C) != ptd.region ||
+      CTX_wm_region_view3d(C) != ptd.depth_cache_region_view ||
+      CTX_wm_view3d(C) != ptd.depth_cache_view3d ||
+      CTX_data_depsgraph_pointer(C) != ptd.depth_cache_depsgraph ||
+      CTX_data_scene(C) != ptd.depth_cache_scene ||
+      CTX_data_view_layer(C) != ptd.depth_cache_view_layer ||
+      CTX_data_active_object(C) != ptd.depth_cache_object ||
+      ptd.depth_cache_scene->r.cfra != ptd.depth_cache_frame)
+  {
+    return false;
+  }
+
+  GreasePencil *grease_pencil = id_cast<GreasePencil *>(ptd.depth_cache_object->data);
+  if (grease_pencil != ptd.depth_cache_grease_pencil || !grease_pencil->has_active_layer() ||
+      grease_pencil->get_active_layer() != ptd.depth_cache_layer ||
+      grease_pencil->get_editable_drawing_at(*ptd.depth_cache_layer, ptd.depth_cache_frame) !=
+          ptd.depth_cache_drawing)
+  {
+    return false;
+  }
+
+  Paint *paint = BKE_paint_get_active_from_context(C);
+  return paint == ptd.depth_cache_paint && paint != nullptr &&
+         BKE_paint_brush(paint) == ptd.depth_cache_brush;
+}
+
+static bool grease_pencil_primitive_depth_cache_event_push(PrimitiveToolOperation &ptd,
+                                                           const wmEvent *event)
+{
+  constexpr int max_queued_events = 256;
+  if (event == nullptr || event->type == TIMER || event->custom != 0 ||
+      event->customdata != nullptr || ptd.depth_cache_events.size() >= max_queued_events)
+  {
+    return false;
+  }
+
+  wmEvent queued = *event;
+  queued.next = nullptr;
+  queued.prev = nullptr;
+  queued.custom = 0;
+  queued.customdata = nullptr;
+  queued.customdata_free = false;
+  ptd.depth_cache_events.append(queued);
+  return true;
+}
