+  GPU_framebuffer_clear(src_fb, GPU_COLOR_BIT, red, 0.0f, 0u);
+
+  uchar4 *selected = static_cast<uchar4 *>(GPU_texture_read(nested, GPU_DATA_UBYTE, 0));
+  uchar4 *untouched = static_cast<uchar4 *>(GPU_texture_read(neighbor, GPU_DATA_UBYTE, 0));
+  ASSERT_NE(selected, nullptr);
