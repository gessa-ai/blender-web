+ParticleEditDepthCacheState PE_depth_cache_session_state(
+    bContext *C, ParticleEditDepthCacheSession *session)
+{
+  if (!PE_depth_cache_context_matches(C, session)) {
+    return ParticleEditDepthCacheState::Failed;
+  }
+  if (session->xray_bypass) {
+    return ParticleEditDepthCacheState::Ready;
+  }
+  switch (session->readback.state()) {
+    case ViewportDepthCacheSession::ReadbackState::Pending:
+      return ParticleEditDepthCacheState::Pending;
+    case ViewportDepthCacheSession::ReadbackState::Ready:
+      return ParticleEditDepthCacheState::Ready;
+    case ViewportDepthCacheSession::ReadbackState::Failed:
+      return ParticleEditDepthCacheState::Failed;
+  }
+  BLI_assert_unreachable();
+  return ParticleEditDepthCacheState::Failed;
