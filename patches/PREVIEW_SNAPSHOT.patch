+static void test_storage_buffer_readback_owned_result()
+{
+  GPU_render_begin();
+
+  const uint4 expected[] = {
+      uint4(0x10203040u, 0x50607080u, 0x90a0b0c0u, 0xd0e0f000u),
+      uint4(1u, 2u, 3u, 4u),
+  };
+  gpu::StorageBuf *buffer = GPU_storagebuf_create_ex(
+      sizeof(expected), expected, GPU_USAGE_DYNAMIC, "owned-storage-readback");
+  ASSERT_NE(buffer, nullptr);
+  GPU_memory_barrier(GPU_BARRIER_BUFFER_UPDATE);
+
+  GPUReadback *readback = GPU_storagebuf_read_async(buffer);
+  ASSERT_NE(readback, nullptr);
+#ifdef __EMSCRIPTEN__
+  EXPECT_EQ(GPU_readback_status(readback), GPU_READBACK_PENDING);
+  EXPECT_EQ(GPU_readback_error(readback), GPU_READBACK_ERROR_NONE);
+  EXPECT_EQ(GPU_readback_size(readback), sizeof(expected));
+  GPU_storagebuf_free(buffer);
+  uint4 pending_dst[ARRAY_SIZE(expected)] = {};
+  EXPECT_FALSE(GPU_readback_consume(readback, pending_dst, sizeof(pending_dst)));
+  EXPECT_NE(readback, nullptr);
+  GPU_readback_cancel(readback);
+  EXPECT_EQ(readback, nullptr);
+#else
+  EXPECT_EQ(GPU_readback_status(readback), GPU_READBACK_READY);
+  EXPECT_EQ(GPU_readback_error(readback), GPU_READBACK_ERROR_NONE);
+  EXPECT_EQ(GPU_readback_size(readback), sizeof(expected));
+  GPU_storagebuf_free(buffer);
+
+  uint4 actual[ARRAY_SIZE(expected)] = {};
+  EXPECT_FALSE(GPU_readback_consume(readback, actual, sizeof(actual) - 1));
+  EXPECT_NE(readback, nullptr);
+  EXPECT_TRUE(GPU_readback_consume(readback, actual, sizeof(actual)));
+  EXPECT_EQ(readback, nullptr);
+  for (const int i : IndexRange(ARRAY_SIZE(expected))) {
+    EXPECT_EQ(actual[i], expected[i]);
+  }
+#endif
+
+  GPUReadback *invalid = GPU_storagebuf_read_async(nullptr);
+  EXPECT_EQ(GPU_readback_status(invalid), GPU_READBACK_FAILED);
+  EXPECT_EQ(GPU_readback_error(invalid), GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  GPU_readback_cancel(invalid);
+  EXPECT_EQ(invalid, nullptr);
+
+  GPU_render_end();
+}
