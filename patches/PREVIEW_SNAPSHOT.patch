+static void test_texture_copy_mipmap()
+{
+  constexpr int extent = 4;
+  GPU_render_begin();
+
+  const eGPUTextureUsage usage = GPU_TEXTURE_USAGE_HOST_READ;
+  gpu::Texture *src_tx = GPU_texture_create_2d(
+      "copy-mip-src", extent, extent, 2, TextureFormat::SFLOAT_32, usage, nullptr);
+  gpu::Texture *dst_tx = GPU_texture_create_2d(
+      "copy-mip-dst", extent, extent, 2, TextureFormat::SFLOAT_32, usage, nullptr);
+
+  Vector<float> src_mip0(extent * extent, 1.0f);
+  Vector<float> src_mip1((extent / 2) * (extent / 2), 2.0f);
+  Vector<float> dst_mip0(extent * extent, 3.0f);
+  Vector<float> dst_mip1((extent / 2) * (extent / 2), 4.0f);
+  GPU_texture_update_mipmap(src_tx, 0, GPU_DATA_FLOAT, src_mip0.data());
+  GPU_texture_update_mipmap(src_tx, 1, GPU_DATA_FLOAT, src_mip1.data());
+  GPU_texture_update_mipmap(dst_tx, 0, GPU_DATA_FLOAT, dst_mip0.data());
+  GPU_texture_update_mipmap(dst_tx, 1, GPU_DATA_FLOAT, dst_mip1.data());
+
+  GPU_texture_copy_mipmap(dst_tx, src_tx, 1);
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+
+  float *result_mip0 = static_cast<float *>(GPU_texture_read(dst_tx, GPU_DATA_FLOAT, 0));
+  float *result_mip1 = static_cast<float *>(GPU_texture_read(dst_tx, GPU_DATA_FLOAT, 1));
+  for (int index : IndexRange(dst_mip0.size())) {
+    EXPECT_EQ(result_mip0[index], 3.0f);
+  }
+  for (int index : IndexRange(dst_mip1.size())) {
+    EXPECT_EQ(result_mip1[index], 2.0f);
+  }
+
+  MEM_delete(result_mip0);
+  MEM_delete(result_mip1);
+  GPU_texture_free(src_tx);
+  GPU_texture_free(dst_tx);
+  GPU_render_end();
+}
+GPU_TEST(texture_copy_mipmap)
