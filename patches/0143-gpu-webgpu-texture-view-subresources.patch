+static void test_texture_view_webgpu_geometry_and_rejected_update()
+{
+  GPU_render_begin();
+  constexpr eGPUTextureUsage usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                     GPU_TEXTURE_USAGE_HOST_READ |
+                                     GPU_TEXTURE_USAGE_FORMAT_VIEW;
+  gpu::Texture *root = GPU_texture_create_2d_array(
+      __func__, 16, 8, 4, 4, TextureFormat::UNORM_8_8_8_8, usage, nullptr);
+  ASSERT_NE(root, nullptr);
+  const float4 clear(0.0f, 0.25f, 0.5f, 1.0f);
+  GPU_texture_clear(root, GPU_DATA_FLOAT, clear);
+  /* Direct clear is relative-mip-zero only. Initialize the two nonzero mips that
+   * this geometry/update-isolation test reads through explicit mip views. */
+  for (int mip = 1; mip <= 2; mip++) {
+    gpu::Texture *mip_view = GPU_texture_create_view(
+        __func__, root, TextureFormat::UNORM_8_8_8_8, mip, 1, 0, 4, false, false);
+    ASSERT_NE(mip_view, nullptr);
+    GPU_texture_clear(mip_view, GPU_DATA_FLOAT, clear);
+    GPU_texture_free(mip_view);
+  }
+
+  gpu::Texture *direct = GPU_texture_create_view(
+      __func__, root, TextureFormat::UNORM_8_8_8_8, 1, 2, 1, 2, false, false);
+  ASSERT_NE(direct, nullptr);
+  EXPECT_EQ(GPU_texture_width(direct), 8);
+  EXPECT_EQ(GPU_texture_height(direct), 4);
+  EXPECT_EQ(GPU_texture_depth(direct), 2);
+  EXPECT_EQ(GPU_texture_read_size_get(direct, GPU_DATA_UBYTE, 0), size_t(8 * 4 * 2 * 4));
+
+  gpu::Texture *nested = GPU_texture_create_view(
+      __func__, direct, TextureFormat::UNORM_8_8_8_8, 1, 1, 1, 1, false, false);
+  ASSERT_NE(nested, nullptr);
+  EXPECT_EQ(GPU_texture_width(nested), 4);
+  EXPECT_EQ(GPU_texture_height(nested), 2);
+  EXPECT_EQ(GPU_texture_depth(nested), 1);
+  EXPECT_EQ(GPU_texture_read_size_get(nested, GPU_DATA_UBYTE, 0), size_t(4 * 2 * 4));
+
+  /* Vulkan and Metal reject host updates through texture views. WebGPU must do the
+   * same without corrupting either the selected subresource or a neighbor. */
+  Vector<uchar4> direct_update(8 * 4 * 2, uchar4(255, 0, 0, 255));
+  Vector<uchar4> nested_update(4 * 2, uchar4(255, 255, 0, 255));
+  EXPECT_BLI_ASSERT(GPU_texture_update(direct, GPU_DATA_UBYTE, direct_update.data()),
+                    "WGPUTexture::update_sub through a format view is not supported");
+  EXPECT_BLI_ASSERT(GPU_texture_update(nested, GPU_DATA_UBYTE, nested_update.data()),
+                    "WGPUTexture::update_sub through a format view is not supported");
+
+  gpu::Texture *neighbor = GPU_texture_create_view(
+      __func__, root, TextureFormat::UNORM_8_8_8_8, 2, 1, 0, 1, false, false);
+  ASSERT_NE(neighbor, nullptr);
+  GPU_texture_free(root);
+
+  uchar4 *direct_bytes = static_cast<uchar4 *>(
+      GPU_texture_read(direct, GPU_DATA_UBYTE, 0));
+  uchar4 *nested_bytes = static_cast<uchar4 *>(
+      GPU_texture_read(nested, GPU_DATA_UBYTE, 0));
+  uchar4 *neighbor_bytes = static_cast<uchar4 *>(
+      GPU_texture_read(neighbor, GPU_DATA_UBYTE, 0));
+  ASSERT_NE(direct_bytes, nullptr);
+  ASSERT_NE(nested_bytes, nullptr);
+  ASSERT_NE(neighbor_bytes, nullptr);
+  const uchar4 expected(0, 64, 128, 255);
+  for (int i = 0; i < 8 * 4 * 2; i++) {
+    EXPECT_EQ(direct_bytes[i], expected);
+  }
+  for (int i = 0; i < 4 * 2; i++) {
+    EXPECT_EQ(nested_bytes[i], expected);
+  }
+  for (int i = 0; i < 4 * 2; i++) {
+    EXPECT_EQ(neighbor_bytes[i], expected);
+  }
+  MEM_delete(direct_bytes);
+  MEM_delete(nested_bytes);
+  MEM_delete(neighbor_bytes);
+  GPU_texture_free(neighbor);
+  GPU_texture_free(nested);
+  GPU_texture_free(direct);
+  GPU_render_end();
+}
+GPU_WEBGPU_TEST(texture_view_webgpu_geometry_and_rejected_update)
