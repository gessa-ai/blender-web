diff --git a/source/blender/gpu/webgpu/wgpu_common.hh b/source/blender/gpu/webgpu/wgpu_common.hh
--- a/source/blender/gpu/webgpu/wgpu_common.hh
+++ b/source/blender/gpu/webgpu/wgpu_common.hh
@@ -128,6 +128,20 @@ inline bool direct_draw_plan(int vertex_first,
 
+/** Create a WebGPU buffer without publishing a failed handle. Templated so resource-allocation
+ * transactions remain device-free testable on native and Wasm. */
+template<typename DeviceT, typename BufferT>
+inline bool buffer_create_if_valid(DeviceT &device,
+                                   const wgpu::BufferDescriptor &descriptor,
+                                   BufferT &result)
+{
+  BufferT candidate = device.CreateBuffer(&descriptor);
+  if (candidate == nullptr) {
+    return false;
+  }
+  result = std::move(candidate);
+  return true;
+}
+
 /** Allocate the std140 `{layer, viewport}` uniform shared by the direct and indirect
  * multi-viewport emulation paths. WebGPU creation is fallible; publish the candidate only after
- * a non-null handle is available. Templated so the exact transaction remains device-free
- * testable on native and Wasm. */
+ * a non-null handle is available. */
 template<typename DeviceT, typename BufferT>
@@ -139,8 +153,3 @@ inline bool multi_viewport_uniform_buffer_create(DeviceT &device, BufferT &resul
 
-  BufferT candidate = device.CreateBuffer(&descriptor);
-  if (candidate == nullptr) {
-    return false;
-  }
-  result = std::move(candidate);
-  return true;
+  return buffer_create_if_valid(device, descriptor, result);
 }
