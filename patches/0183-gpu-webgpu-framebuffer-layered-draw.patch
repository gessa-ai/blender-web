+/** Accumulated layer count for one emulated layered draw. Fixed-layer attachments do not drive
+ * the pass count; every all-layer attachment must expose the same count because one WebGPU render
+ * pipeline/pass cannot change its attachment layout between layers. */
+struct FramebufferDrawPassCount {
+  uint32_t count = 1;
+  bool layered = false;
+};
+
+/** Add one draw attachment to the pass-count model. Failure is atomic. */
+inline bool framebuffer_draw_pass_count_update(int selected_layer,
+                                               uint32_t layer_count,
+                                               FramebufferDrawPassCount &result)
+{
+  if (layer_count == 0 ||
+      layer_count > uint32_t(std::numeric_limits<int>::max()) ||
+      (selected_layer >= 0 && uint32_t(selected_layer) >= layer_count))
+  {
+    return false;
+  }
+
+  FramebufferDrawPassCount candidate = result;
+  if (selected_layer < 0) {
+    if (candidate.layered && candidate.count != layer_count) {
+      return false;
+    }
+    candidate.count = layer_count;
+    candidate.layered = true;
+  }
+  result = candidate;
+  return true;
+}
+
+/** Select one attachment for an emulated layered draw pass. All-layer attachments advance with
+ * the pass while a fixed-layer attachment keeps its frontend selection. */
+inline FramebufferClearPassStatus framebuffer_draw_pass_layer(int selected_layer,
+                                                              uint32_t layer_count,
+                                                              uint32_t pass_layer,
+                                                              int &force_layer)
+{
+  return framebuffer_clear_pass_layer(selected_layer, layer_count, pass_layer, force_layer);
+}
