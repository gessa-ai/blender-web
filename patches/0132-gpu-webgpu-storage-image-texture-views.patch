diff --git a/source/blender/gpu/webgpu/wgpu_texture.cc b/source/blender/gpu/webgpu/wgpu_texture.cc
index 2f94738..884f590 100644
--- a/source/blender/gpu/webgpu/wgpu_texture.cc
+++ b/source/blender/gpu/webgpu/wgpu_texture.cc
@@ -984,3 +984,10 @@ wgpu::TextureView WGPUTexture::image_view()
 {
-  if (texture_ == nullptr) {
+  /* Storage-image binds frequently use GPU_texture_create_view for one mip of a
+   * source texture (the generic 2D mipmap compute binds mip_in/out1/out2 this way).
+   * A Blender texture view owns no device texture; resolve its aliased source just
+   * like sampled_view does. Returning null dropped all three storage-texture entries
+   * and left only the compute UBO in a layout that expected four entries. */
+  wgpu::Texture tex = (texture_ != nullptr) ? texture_ :
+                      (source_ != nullptr ? source_->texture_ : wgpu::Texture(nullptr));
+  if (tex == nullptr) {
     return nullptr;
@@ -1000,7 +1007,19 @@ wgpu::TextureView WGPUTexture::image_view()
   d.mipLevelCount = 1;
-  d.baseArrayLayer = 0;
-  /* arrayLayerCount left at its UNDEFINED default → all remaining layers (1 for a
-   * plain 2D texture, the full array for an array texture). */
+  d.baseArrayLayer = uint32_t(std::max(layer_offset_, 0));
+  if (dim == wgpu::TextureViewDimension::e2D) {
+    d.arrayLayerCount = 1;
+  }
+  else if (dim == wgpu::TextureViewDimension::e2DArray) {
+    /* Texture::init_view stores the requested subset length in this view's
+     * layer_count(). Do not expose all source layers after baseArrayLayer: a
+     * 4-layer source viewed as start=2,len=1 must remain exactly one layer. Base
+     * cube types are collapsed to e2DArray above and store their face count in d_. */
+    const int layers = ELEM(type_, GPU_TEXTURE_CUBE, GPU_TEXTURE_CUBE_ARRAY) ? d_ :
+                                                                                layer_count();
+    d.arrayLayerCount = uint32_t(std::max(layers, 1));
+  }
+  /* Native 2D and 2D-array/cube-array views now carry explicit, exact layer
+   * counts. Other dimensions retain their existing defaults. */
   d.aspect = wgpu::TextureAspect::All;
-  return texture_.CreateView(&d);
+  return tex.CreateView(&d);
 }
