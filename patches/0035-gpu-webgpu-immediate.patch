+/* SPDX-FileCopyrightText: 2023 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_immediate.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WGPUImmediate — old-style immediate-mode drawing on WebGPU. `begin()` hands the
+ * frontend a CPU staging buffer to write the current primitive's vertices into;
+ * `end()` uploads them to a transient vertex buffer and draws them through the
+ * shared render-pipeline path (same assembly wgpu_batch uses). Must be constructed
+ * by the context ctor (`imm = new WGPUImmediate()`), as every backend does. */
+
+#pragma once
+
+#include "gpu_immediate_private.hh"
+
+#include "MEM_guardedalloc.h"
+
+#include <vector>
+
+namespace blender::gpu {
+
+class WGPUImmediate : public Immediate {
+ public:
+  uchar *begin() override;
+  void end() override;
+
+ private:
+  /** CPU staging for the current primitive; grown on demand, uploaded in end(). */
+  std::vector<uchar> cpu_buffer_;
+
+  MEM_CXX_CLASS_ALLOC_FUNCS("WGPUImmediate")
+};
+
+}  // namespace blender::gpu
