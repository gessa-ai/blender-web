+static void test_texture_view_webgpu_rejects_incompatible_alias()
+{
+  GPU_render_begin();
+  constexpr eGPUTextureUsage usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                     GPU_TEXTURE_USAGE_HOST_READ |
+                                     GPU_TEXTURE_USAGE_FORMAT_VIEW;
+  gpu::Texture *base = GPU_texture_create_2d(
+      __func__, 4, 4, 1, TextureFormat::UNORM_8_8_8_8, usage, nullptr);
+  ASSERT_NE(base, nullptr);
+  gpu::Texture *view = GPU_texture_create_view(
+      __func__, base, TextureFormat::UINT_32, 0, 1, 0, 1, false, false);
+  EXPECT_EQ(view, nullptr);
+  gpu::Texture *snorm = GPU_texture_create_2d(
+      __func__, 4, 4, 1, TextureFormat::SNORM_16, usage, nullptr);
+  ASSERT_NE(snorm, nullptr);
+  gpu::Texture *emulation_alias = GPU_texture_create_view(
+      __func__, snorm, TextureFormat::UINT_16, 0, 1, 0, 1, false, false);
+  EXPECT_EQ(emulation_alias, nullptr);
+
+  gpu::Texture *rgb = GPU_texture_create_2d(
+      __func__, 4, 4, 1, TextureFormat::UNORM_8_8_8, usage, nullptr);
+  ASSERT_NE(rgb, nullptr);
+  gpu::Texture *rgb_same = GPU_texture_create_view(
+      __func__, rgb, TextureFormat::UNORM_8_8_8, 0, 1, 0, 1, false, false);
+  gpu::Texture *rgb_srgb = GPU_texture_create_view(
+      __func__, rgb, TextureFormat::SRGBA_8_8_8, 0, 1, 0, 1, false, false);
+  gpu::Texture *rgb_to_rgba = GPU_texture_create_view(
+      __func__, rgb, TextureFormat::UNORM_8_8_8_8, 0, 1, 0, 1, false, false);
+  ASSERT_NE(rgb_same, nullptr);
+  ASSERT_NE(rgb_srgb, nullptr);
+  EXPECT_EQ(rgb_to_rgba, nullptr);
+
+  gpu::Texture *rgba_to_rgb = GPU_texture_create_view(
+      __func__, base, TextureFormat::UNORM_8_8_8, 0, 1, 0, 1, false, false);
+  EXPECT_EQ(rgba_to_rgb, nullptr);
+  GPU_texture_free(rgb_srgb);
+  GPU_texture_free(rgb_same);
+  GPU_texture_free(rgb);
+  GPU_texture_free(snorm);
+  GPU_texture_free(base);
+  GPU_render_end();
+}
+GPU_WEBGPU_TEST(texture_view_webgpu_rejects_incompatible_alias)
