+static wmOperatorStatus view3d_zoom_border_exec(bContext *C, wmOperator *op)
+{
+  /* NOTE: otherwise opengl won't work. */
+  view3d_operator_needs_gpu(C);
+  ED_view3d_depth_override(CTX_data_ensure_evaluated_depsgraph(C),
+                           CTX_wm_region(C),
+                           CTX_wm_view3d(C),
+                           nullptr,
+                           V3D_DEPTH_NO_GPENCIL,
+                           true,
+                           nullptr);
+
+  ZoomBorderDepthRead *read = view3d_zoom_border_depth_read_create(C, op);
+  const eGPUReadbackStatus status = view3d_zoom_border_depth_read_status(read);
+  if (status == GPU_READBACK_READY) {
+    return view3d_zoom_border_depth_read_finish(C, op, read);
+  }
+  if (status != GPU_READBACK_PENDING) {
+    BKE_report(op->reports, RPT_ERROR, "Unable to start border depth readback");
+    view3d_zoom_border_depth_read_free(C, op, read);
+    return OPERATOR_CANCELLED;
+  }
+
+  view3d_zoom_border_depth_read_register(read);
+  if (op->customdata == nullptr) {
+    view3d_zoom_border_depth_read_attach(C, op, read, true);
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
