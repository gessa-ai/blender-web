+/** \file
+ * \ingroup gpu
+ *
+ * WGPUTexture — the WebGPU `gpu::Texture` implementation. Wraps a `wgpu::Texture`
+ * created from the T9 format table (wgpu_texture_format) with device-probed usage;
+ * uploads dispatch on ConvClass (Direct memcpy vs RGB→RGBA promotion) via
+ * wgpu_data_conversion with 256-byte bytesPerRow alignment; reads go through a
+ * MAP_READ staging buffer. Modelled on VKTexture; the standalone proof of the
+ * format/conversion/round-trip paths is sandbox/wgpu-texture-formats/. */
+
+#pragma once
+
+#include <atomic>
+#include <memory>
+
+#include "webgpu/webgpu_cpp.h"
+
+#include "gpu_texture_private.hh"
+
+#include "wgpu_texture_format.hh"
+
+namespace blender::gpu::webgpu {
+
+/** A stand-alone view reserves its own queue-validation gate. A view created while
+ * `command_encode_submit_scoped()` is active is instead covered by that enclosing command scope,
+ * which already rejects the complete command before submission. */
+enum class TextureViewValidationScope : uint8_t { Standalone, EnclosingCommand };
+
+class WGPUTexture : public Texture {
+ public:
+  /** One immutable, checked description of the backing allocation owned by this
+   * Blender texture wrapper. A view copies the ref-counted texture handle and
+   * narrows this range, so nested views remain valid after every source wrapper
+   * has been freed. All mip/layer values are absolute in the backing texture. */
+  struct SubresourceRange {
+    wgpu::Texture texture = nullptr;
+    wgpu::TextureFormat backing_format = wgpu::TextureFormat::Undefined;
+    wgpu::TextureFormat view_format = wgpu::TextureFormat::Undefined;
+    wgpu::TextureAspect aspect = wgpu::TextureAspect::All;
+    GPUTextureType backing_type = GPU_TEXTURE_2D;
+    uint32_t base_mip = 0;
+    uint32_t mip_count = 0;
+    uint32_t base_layer = 0;
+    uint32_t layer_count = 0;
+    /** Root texture creation may be pending while browser error scopes resolve. A provisional
+     * non-null handle is usable only for CPU encoding behind its reserved queue gate. Rejection
+     * invalidates this range and every copied Blender texture view without retaining a wrapper. */
+    std::shared_ptr<std::atomic<int8_t>> creation_scope_status;
+    /** Physical WebGPU extent at base_mip. For array textures the depth is
+     * layer_count; for 3D textures it is the mip-reduced spatial depth. */
+    wgpu::Extent3D physical_extent = {};
+
+    bool valid() const
+    {
+      const bool creation_valid = !creation_scope_status ||
+                                  creation_scope_status->load(std::memory_order_acquire) >= 0;
+      return creation_valid && texture != nullptr &&
+             backing_format != wgpu::TextureFormat::Undefined &&
+             view_format != wgpu::TextureFormat::Undefined && mip_count > 0 &&
+             layer_count > 0 && physical_extent.width > 0 && physical_extent.height > 0 &&
+             physical_extent.depthOrArrayLayers > 0;
+    }
+  };
+
+ private:
+  /** The device texture (null until init_internal). */
+  wgpu::Texture texture_ = nullptr;
+  /** Canonical pinned backing and exact absolute subresource subset. */
+  SubresourceRange subresources_;
+  /** The WebGPU format actually created (promotion applied — see to_wgpu_format). */
+  wgpu::TextureFormat wgpu_format_ = wgpu::TextureFormat::Undefined;
+  /** How CPU pixel data maps to the device format (Direct / PromoteRGBA / ...). */
+  ConvClass conv_ = ConvClass::Direct;
+  /** For buffer textures (GPU_texture_create_from_vertbuf): the backing vertex
+   * buffer. Not owned. WebGPU has no texel-buffer texture, so sampling is
+   * forwarded to the buffer (bind-group assembly, lane A) — see init_internal(VertBuf*). */
+  VertBuf *source_buffer_ = nullptr;
+  /** SNORM_16 family has no WebGPU format at the pin (notes/gpu-t9pre-findings.md
+   * §5): emulated in a matching-width *Uint* texture with byte-identical SNORM bit
+   * patterns (exact CPU round-trip; shader-sample remap deferred). */
+  bool snorm16_emulated_ = false;
+  /** Current swizzle (GPU_texture_swizzle_set); applied at view creation. */
+  char swizzle_[4] = {'r', 'g', 'b', 'a'};
+
+  wgpu::Texture backing_texture() const
+  {
+    return subresources_.texture;
+  }
+
+ public:
+  struct ResolvedReadRegion {
+    wgpu::Texture texture;
+    uint32_t mip_level = 0;
+    uint32_t origin_x = 0;
+    uint32_t origin_y = 0;
+    uint32_t origin_z = 0;
+    uint32_t width = 0;
+    uint32_t height = 0;
+    uint32_t depth = 0;
+    wgpu::TextureAspect aspect = wgpu::TextureAspect::All;
+  };
+
+  WGPUTexture(const char *name) : Texture(name) {}
+  virtual ~WGPUTexture() override;
+
+  void generate_mipmap() override;
+  void copy_to(Texture *tex, IndexRange mip_levels) override;
+  void clear(const double4 data) override;
+  void swizzle_set(const char swizzle_mask[4]) override;
+  void mip_range_set(int min, int max) override;
+  void read(int mip, eGPUDataFormat format, void *data) override;
+  /** Read one relative mip and one relative layer/depth slice. */
+  void read_sub(int mip, int layer, eGPUDataFormat format, void *data);
+  GPUReadback *read_async(int mip, eGPUDataFormat format) override;
+  /** Owned counterpart to #read_sub for framebuffer attachment regions. */
+  GPUReadback *read_sub_async(int mip, int layer, eGPUDataFormat format);
+
+  /** Resolve this texture or nested texture view to the backing WebGPU texture and
+   * absolute mip/layer copy region. */
+  bool resolve_read_region(int mip, ResolvedReadRegion &r_region) const;
+
+  /** Resolve one relative mip and layer/depth slice for host readback. */
+  bool resolve_read_region(int mip, int layer, ResolvedReadRegion &r_region) const;
+
+  /** Resolve one relative mip and optionally one relative array layer. `layer < 0`
+   * keeps the full array subset; non-array and 3D textures require layer 0/-1. */
+  bool resolve_subresource(int mip, int layer, ResolvedReadRegion &r_region) const;
+
+  const SubresourceRange &subresource_range() const
+  {
+    return subresources_;
+  }
+
+  void update_sub(int mip,
+                  int offset[3],
+                  int extent[3],
+                  eGPUDataFormat format,
+                  const void *data,
+                  uint unpack_row_length) override;
+  void update_sub(int offset[3],
+                  int extent[3],
+                  eGPUDataFormat format,
+                  GPUPixelBuffer *pixbuf) override;
+
+  /** Root-owned device texture. Views deliberately return null here; callers that
+   * accept views must use subresource_range()/the exact-view helpers below. */
+  wgpu::Texture &texture() { return texture_; }
+  wgpu::TextureFormat wgpu_format() const
+  {
+    return subresources_.valid() ? subresources_.view_format : wgpu_format_;
+  }
+  wgpu::TextureFormat backing_format() const
+  {
+    return subresources_.valid() ? subresources_.backing_format : wgpu_format_;
+  }
+
+  /** Exact single-mip/single-layer render-attachment view. Mip and layer are
+   * relative to this wrapper's subset. */
+  wgpu::TextureView attachment_view(
+      int mip = 0,
+      int layer = 0,
+      TextureViewValidationScope validation_scope = TextureViewValidationScope::Standalone) const;
+  uint32_t attachment_depth_slice(int mip, int layer) const;
+  uint32_t attachment_layer_count(int mip = 0) const;
+
+  /** A view suitable for a WGSL storage-image binding (`texture_storage_*`): a
+   * single mip level with the texture's native format and view dimension. WebGPU
+   * rejects a multi-mip or cube view for a storage binding. Consumed by the
+   * compute-dispatch / draw bind-group builders (GPU_texture_image_bind path). */
+  wgpu::TextureView image_view();
+
+  /** A view suitable for a WGSL sampled-texture binding (`texture_*<f32>` etc.):
+   * the whole texture (all mips/layers) at its native view dimension. Consumed by
+   * the draw bind-group builder (GPU_texture_bind path). */
+  wgpu::TextureView sampled_view(
+      wgpu::TextureViewDimension override_dim = wgpu::TextureViewDimension::Undefined);
+
+  /** Exact single-mip/single-layer sampled view used by framebuffer render blits. */
+  wgpu::TextureView sampled_attachment_view(
+      int mip,
+      int layer,
+      TextureViewValidationScope validation_scope = TextureViewValidationScope::Standalone) const;
+
+  /** True for a buffer texture (GPU_texture_create_from_vertbuf): it has NO device
+   * texture (source_buffer_ set, texture_ null). WGSL has no texel-buffer type, so
+   * such a bind is a read-only storage-buffer entry, not a texture+sampler — the
+   * draw/compute bind-group builders skip it in their sampled-texture loop. */
+  bool is_buffer_texture() const
+  {
+    return source_buffer_ != nullptr;
+  }
+
+  /** Adopt an externally-owned wgpu::Texture (a surface's GetCurrentTexture()) as
+   * this gpu::Texture WITHOUT allocating a device texture, setting the base
+   * dimensions/format so framebuffer attachment + target_formats resolve. The handle
+   * is ref-held until re-adopted; the surface governs its per-frame validity, so
+   * re-adopt each frame (WGPUContext::sync_backbuffer). Web windowed back-buffer. */
+  void adopt_external(const wgpu::Texture &texture,
+                      wgpu::TextureFormat wgpu_format,
+                      int width,
+                      int height);
+
+ protected:
+  bool init_internal() override;
+  bool init_internal(VertBuf *vbo) override;
+  bool init_internal(gpu::Texture *src, int mip_offset, int layer_offset, bool use_stencil)
+      override;
+
+ private:
+  /** Create `texture_` from the base-class format_/type_/w_/h_/d_/usage; returns
+   * false on failure. Shared by the 1D/2D/3D/cube init_internal path. */
+  bool allocate();
+
+  /** Create one view either under its own ordered resource gate or inside an already-active
+   * command scope. No raw view factory is permitted outside this single seam. */
+  wgpu::TextureView create_view_scoped(
+      const wgpu::TextureViewDescriptor &descriptor,
+      const char *label,
+      TextureViewValidationScope validation_scope = TextureViewValidationScope::Standalone) const;
+
+  /** Convert `sample_count` tightly-packed host texels (`host_format` scalars, one
+   * per logical component) into this texture's device byte layout, and the reverse.
+   * WebGPU copies move raw bytes, so all pixel-format conversion is CPU-side here. */
+  void convert_host_to_device(uint8_t *dst,
+                              const uint8_t *src,
+                              size_t sample_count,
+                              eGPUDataFormat host_format) const;
+  void convert_device_to_host(uint8_t *dst,
+                              const uint8_t *src,
+                              size_t sample_count,
+                              eGPUDataFormat host_format) const;
+};
+
+}  // namespace blender::gpu::webgpu
