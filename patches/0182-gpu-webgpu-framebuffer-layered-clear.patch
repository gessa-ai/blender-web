+enum class FramebufferClearPassStatus : uint8_t { Invalid, Inactive, Active };
+
+/** Select one attachment for a framebuffer clear pass. A negative selected layer advances through
+ * the attachment's relative subresource range; a fixed layer remains attached to every emitted
+ * pass. Non-active decisions leave `force_layer` unchanged. */
+inline FramebufferClearPassStatus framebuffer_clear_pass_layer(int selected_layer,
+                                                               uint32_t layer_count,
+                                                               uint32_t pass_layer,
+                                                               int &force_layer)
+{
+  if (layer_count == 0) {
+    return FramebufferClearPassStatus::Invalid;
+  }
+
+  int candidate;
+  if (selected_layer < 0) {
+    if (pass_layer >= layer_count) {
+      return FramebufferClearPassStatus::Inactive;
+    }
+    if (pass_layer > uint32_t(std::numeric_limits<int>::max())) {
+      return FramebufferClearPassStatus::Invalid;
+    }
+    candidate = int(pass_layer);
+  }
+  else {
+    if (uint32_t(selected_layer) >= layer_count) {
+      return FramebufferClearPassStatus::Invalid;
+    }
+    candidate = -1;
+  }
+
+  force_layer = candidate;
+  return FramebufferClearPassStatus::Active;
+}
