+GPUReadback *Texture::read_async(const int mip, const eGPUDataFormat format)
+{
+  int extent[3] = {1, 1, 1};
+  mip_size_get(mip, extent);
+  size_t sample_count = 1;
+  for (const int dimension : extent) {
+    const size_t value = size_t(std::max(1, dimension));
+    if (sample_count > std::numeric_limits<size_t>::max() / value) {
+      return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    }
+    sample_count *= value;
+  }
+  const size_t sample_size = to_bytesize(format_, format);
+  if (sample_size == 0 || sample_count > std::numeric_limits<size_t>::max() / sample_size) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  const size_t logical_size = sample_count * sample_size;
+  /* Match GPU_texture_read(): AMD Pro OpenGL cube-array reads can write eight
+   * bytes past the logical payload. Keep that native backend workaround in the
+   * temporary scratch, then expose only the exact caller-visible bytes. */
+  const size_t guard_size = type_get() == GPU_TEXTURE_CUBE_ARRAY ? 8 : 0;
+  if (logical_size > std::numeric_limits<size_t>::max() - guard_size) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  const size_t scratch_size = logical_size + guard_size;
+  std::vector<unsigned char> bytes(scratch_size);
+  read(mip, format, bytes.data());
+  bytes.resize(logical_size);
+  return gpu_readback_create_ready(std::move(bytes));
+}
+
+GPUReadback *GPU_texture_read_async(Texture *texture,
+                                    const eGPUDataFormat data_format,
+                                    const int mip_level)
+{
+  if (texture == nullptr || !(GPU_texture_usage(texture) & GPU_TEXTURE_USAGE_HOST_READ) ||
+      mip_level < 0 || mip_level >= texture->mip_count() ||
+      !validate_data_format(texture->format_get(), data_format))
+  {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  if (texture->format_flag_get() & GPU_FORMAT_COMPRESSED) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_UNSUPPORTED_FORMAT);
+  }
+  return texture->read_async(mip_level, data_format);
+}
