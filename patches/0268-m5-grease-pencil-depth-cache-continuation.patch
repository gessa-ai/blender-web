+void GreasePencilPaintStroke::depth_cache_timer_ensure()
+{
+  if (depth_cache_timer_ == nullptr) {
+    depth_cache_timer_ = WM_event_timer_add(
+        CTX_wm_manager(evil_C), CTX_wm_window(evil_C), TIMER, 1.0 / 60.0);
+  }
+}
+
+void GreasePencilPaintStroke::depth_cache_timer_remove(bContext *C)
+{
+  if (depth_cache_timer_ != nullptr) {
+    WM_event_timer_remove(CTX_wm_manager(C), CTX_wm_window(C), depth_cache_timer_);
+    depth_cache_timer_ = nullptr;
+  }
+}
+
+wmOperatorStatus GreasePencilPaintStroke::modal(bContext *C,
+                                                wmOperator *op,
+                                                const wmEvent *event)
+{
+  constexpr int paint_stroke_modal_cancel = 1;
+  GreasePencilStrokeOperation *operation = static_cast<GreasePencilStrokeOperation *>(
+      mode_data_.get());
+  if (operation != nullptr &&
+      operation->async_state() == GreasePencilStrokeOperationAsyncState::Pending)
+  {
+    if (event->type == EVT_MODAL_MAP && event->val == paint_stroke_modal_cancel) {
+      operation->cancel_async();
+      this->depth_cache_timer_remove(C);
+      PaintStroke::cancel(C);
+      return OPERATOR_CANCELLED;
+    }
+    if ((event->type == event_type_ && event->val == KM_RELEASE) ||
+        ELEM(event->type, EVT_RETKEY, EVT_SPACEKEY))
+    {
+      wmEvent finish_event = *event;
+      finish_event.next = nullptr;
+      finish_event.prev = nullptr;
+      finish_event.custom = 0;
+      finish_event.customdata = nullptr;
+      finish_event.customdata_free = false;
+      deferred_finish_event_ = finish_event;
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (event->type == TIMER && event->customdata == depth_cache_timer_) {
+      const GreasePencilStrokeOperationAsyncState state = operation->poll_async(*C);
+      if (state == GreasePencilStrokeOperationAsyncState::Pending) {
+        return OPERATOR_RUNNING_MODAL;
+      }
+      this->depth_cache_timer_remove(C);
+      if (state == GreasePencilStrokeOperationAsyncState::Failed) {
+        BKE_report(op->reports, RPT_ERROR, "Unable to prepare Grease Pencil placement depth");
+        PaintStroke::cancel(C);
+        return OPERATOR_CANCELLED;
+      }
+      if (deferred_finish_event_) {
+        wmEvent finish_event = *deferred_finish_event_;
+        deferred_finish_event_.reset();
+        return PaintStroke::modal(C, op, &finish_event);
+      }
+      return OPERATOR_RUNNING_MODAL;
+    }
+    if (deferred_finish_event_) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+  }
+
+  const wmOperatorStatus result = PaintStroke::modal(C, op, event);
+  operation = static_cast<GreasePencilStrokeOperation *>(mode_data_.get());
+  if (ELEM(result, OPERATOR_FINISHED, OPERATOR_CANCELLED)) {
+    this->depth_cache_timer_remove(C);
+    return result;
+  }
+  if (operation != nullptr) {
+    if (operation->async_state() == GreasePencilStrokeOperationAsyncState::Pending) {
+      this->depth_cache_timer_ensure();
+    }
+    else if (operation->async_state() == GreasePencilStrokeOperationAsyncState::Failed) {
+      this->depth_cache_timer_remove(C);
+      BKE_report(op->reports, RPT_ERROR, "Grease Pencil placement depth continuation failed");
+      PaintStroke::cancel(C);
+      return OPERATOR_CANCELLED;
+    }
+  }
+  return result;
+}
+
+void GreasePencilPaintStroke::cancel(bContext *C)
+{
+  GreasePencilStrokeOperation *operation = static_cast<GreasePencilStrokeOperation *>(
+      mode_data_.get());
+  if (operation != nullptr) {
+    operation->cancel_async();
+  }
+  deferred_finish_event_.reset();
+  this->depth_cache_timer_remove(C);
+  PaintStroke::cancel(C);
+}
