+/**
+ * Cache a reusable WebGPU handle only after its implementation error scopes settle cleanly.
+ *
+ * Browser scope callbacks resolve after the creating C++ stack returns, so a cache miss is an
+ * explicit pending state. Repeated lookups for the same key do not create duplicates, a rejected
+ * non-null error object clears the pending state for retry, and an accepted candidate is published
+ * atomically. Callback state is shared independently of the owning context's lifetime.
+ */
+template<typename KeyT,
+         typename HandleT,
+         typename HashT = std::hash<KeyT>,
+         typename EqualT = std::equal_to<KeyT>>
+class ScopedHandleCache {
+ private:
+  struct State {
+    std::mutex mutex;
+    std::unordered_map<KeyT, HandleT, HashT, EqualT> handles;
+    std::unordered_set<KeyT, HashT, EqualT> pending;
+  };
+
+ public:
+  HandleT lookup(const KeyT &key) const
+  {
+    std::lock_guard lock(state_->mutex);
+    const auto found = state_->handles.find(key);
+    return found == state_->handles.end() ? HandleT{} : found->second;
+  }
+
+  bool pending(const KeyT &key) const
+  {
+    std::lock_guard lock(state_->mutex);
+    return state_->pending.find(key) != state_->pending.end();
+  }
+
+  size_t size() const
+  {
+    std::lock_guard lock(state_->mutex);
+    return state_->handles.size();
+  }
+
+  template<typename BeginScopeFn, typename CreateFn, typename EndScopeFn>
+  HandleT get_or_create_scoped(const KeyT &key,
+                               BeginScopeFn &&begin_scope,
+                               CreateFn &&create,
+                               EndScopeFn &&end_scope)
+  {
+    {
+      std::lock_guard lock(state_->mutex);
+      const auto found = state_->handles.find(key);
+      if (found != state_->handles.end()) {
+        return found->second;
+      }
+      if (!state_->pending.emplace(key).second) {
+        return HandleT{};
+      }
+    }
+
+    std::forward<BeginScopeFn>(begin_scope)();
+    HandleT candidate = std::forward<CreateFn>(create)();
+    const bool handle_valid = candidate != nullptr;
+    const std::shared_ptr<State> state = state_;
+    auto completed = std::make_shared<std::atomic<bool>>(false);
+    std::forward<EndScopeFn>(end_scope)(
+        [state,
+         key,
+         candidate = std::move(candidate),
+         handle_valid,
+         completed](const bool scope_valid) mutable {
+          if (completed->exchange(true, std::memory_order_acq_rel)) {
+            return;
+          }
+          std::lock_guard lock(state->mutex);
+          state->pending.erase(key);
+          if (handle_valid && scope_valid) {
+            state->handles.emplace(key, std::move(candidate));
+          }
+        });
+    return lookup(key);
+  }
+
+  template<typename InstanceT, typename DeviceT, typename CreateFn>
+  HandleT get_or_create(const InstanceT &instance,
+                        const DeviceT &device,
+                        const KeyT &key,
+                        const char *label,
+                        CreateFn &&create)
+  {
+    std::string operation_label = label ? label : "";
+    return get_or_create_scoped(
+        key,
+        [&device]() { webgpu_error_scopes_push(device); },
+        std::forward<CreateFn>(create),
+        [&instance, &device, operation_label = std::move(operation_label)](
+            auto completion) mutable {
+          webgpu_error_scopes_pop(
+              instance, device, std::move(operation_label), std::move(completion));
+        });
+  }
+
+ private:
+  std::shared_ptr<State> state_ = std::make_shared<State>();
+};
+
