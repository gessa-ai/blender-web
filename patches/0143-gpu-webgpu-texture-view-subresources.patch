+static void test_texture_1d_array_webgpu_mips_partial_update_and_view_lifetime()
+{
+  GPU_render_begin();
+  constexpr int width = 8;
+  constexpr int layers = 3;
+  constexpr int mips = 4;
+  constexpr eGPUTextureUsage usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                     GPU_TEXTURE_USAGE_HOST_READ |
+                                     GPU_TEXTURE_USAGE_FORMAT_VIEW;
+  Vector<float4> data(width * layers);
+  for (int layer = 0; layer < layers; layer++) {
+    for (int x = 0; x < width; x++) {
+      data[layer * width + x] = float4(0.1f + 0.4f * layer);
+    }
+  }
+  gpu::Texture *texture = GPU_texture_create_1d_array(
+      __func__,
+      width,
+      layers,
+      mips,
+      TextureFormat::SFLOAT_32_32_32_32,
+      usage,
+      reinterpret_cast<const float *>(data.data()));
+  ASSERT_NE(texture, nullptr);
+
+  const float4 replacement[2] = {float4(1.0f), float4(1.0f)};
+  GPU_texture_update_sub(texture, GPU_DATA_FLOAT, replacement, 2, 1, 0, 2, 1, 1);
+  GPU_texture_update_mipmap_chain(texture);
+
+  float4 *mip1 = static_cast<float4 *>(GPU_texture_read(texture, GPU_DATA_FLOAT, 1));
+  ASSERT_NE(mip1, nullptr);
+  EXPECT_FLOAT_EQ(mip1[0].x, 0.1f);
+  EXPECT_FLOAT_EQ(mip1[width / 2 + 0].x, 0.5f);
+  EXPECT_FLOAT_EQ(mip1[width / 2 + 1].x, 1.0f);
+  EXPECT_FLOAT_EQ(mip1[2 * (width / 2)].x, 0.9f);
+  MEM_delete(mip1);
+
+  gpu::Texture *layer_view = GPU_texture_create_view(__func__,
+                                                      texture,
+                                                      TextureFormat::SFLOAT_32_32_32_32,
+                                                      1,
+                                                      1,
+                                                      2,
+                                                      1,
+                                                      false,
+                                                      false);
+  ASSERT_NE(layer_view, nullptr);
+  EXPECT_EQ(GPU_texture_width(layer_view), width / 2);
+  EXPECT_EQ(GPU_texture_height(layer_view), 1);
+  EXPECT_EQ(GPU_texture_depth(layer_view), 0);
+  EXPECT_EQ(GPU_texture_read_size_get(layer_view, GPU_DATA_FLOAT, 0),
+            size_t(width / 2) * sizeof(float4));
+  GPU_texture_free(texture);
+  float4 *layer_data = static_cast<float4 *>(GPU_texture_read(layer_view, GPU_DATA_FLOAT, 0));
+  ASSERT_NE(layer_data, nullptr);
+  for (int x = 0; x < width / 2; x++) {
+    EXPECT_FLOAT_EQ(layer_data[x].x, 0.9f);
+  }
+  MEM_delete(layer_data);
+  GPU_texture_free(layer_view);
+  GPU_render_end();
+}
+GPU_WEBGPU_TEST(texture_1d_array_webgpu_mips_partial_update_and_view_lifetime)
