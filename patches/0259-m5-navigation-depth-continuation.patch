+static bool view3d_navigation_depth_context_matches(bContext *C,
+                                                    const ViewOpsData *vod,
+                                                    const ViewOpsDepthRead *read)
+{
+  return CTX_wm_window(C) == read->window && CTX_wm_screen(C) == read->screen &&
+         CTX_wm_area(C) == vod->area && CTX_wm_region(C) == vod->region &&
+         CTX_wm_view3d(C) == vod->v3d && CTX_wm_region_view3d(C) == vod->rv3d &&
+         vod->region->regiondata == vod->rv3d;
+}
+
+static wmOperatorStatus view3d_navigation_depth_cancel(bContext *C,
+                                                       wmOperator *op,
+                                                       ViewOpsData *vod)
+{
+  vod->state_restore();
+  viewops_data_free(C, vod);
+  op->customdata = nullptr;
+  return OPERATOR_CANCELLED;
+}
+
+static wmOperatorStatus view3d_navigation_depth_modal(bContext *C,
+                                                      wmOperator *op,
+                                                      const wmEvent *event)
+{
+  ViewOpsData *vod = static_cast<ViewOpsData *>(op->customdata);
+  ViewOpsDepthRead *read = vod != nullptr ? vod->depth_read : nullptr;
+  if (read == nullptr) {
+    return OPERATOR_CANCELLED;
+  }
+
+  if (!view3d_navigation_depth_context_matches(C, vod, read)) {
+    BKE_report(op->reports, RPT_ERROR, "View changed while waiting for navigation depth");
+    return view3d_navigation_depth_cancel(C, op, vod);
+  }
+  if ((event->type == EVT_ESCKEY && event->val == KM_PRESS) ||
+      (event->type == EVT_MODAL_MAP && event->val == VIEW_MODAL_CANCEL))
+  {
+    return view3d_navigation_depth_cancel(C, op, vod);
+  }
+
+  if (event->type != TIMER || event->customdata != read->timer) {
+    if (event->customdata == nullptr) {
+      read->queued_event = *event;
+      read->queued_event.next = nullptr;
+      read->queued_event.prev = nullptr;
+      read->queued_event_valid = true;
+    }
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+
+  /* Roughly 2.4 seconds at 10 ms. A lost completion must not move the view late. */
+  constexpr int max_tick_count = 240;
+  if (++read->tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for navigation depth");
+    return view3d_navigation_depth_cancel(C, op, vod);
+  }
+
+  const ViewportDepthPickSession::ReadbackState state = read->session.state();
+  if (state == ViewportDepthPickSession::ReadbackState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == ViewportDepthPickSession::ReadbackState::Failed) {
+    BKE_report(op->reports, RPT_ERROR, "Navigation depth readback failed");
+    return view3d_navigation_depth_cancel(C, op, vod);
+  }
+
+  float pivot[3];
+  if (!read->session.sample(vod->region, pivot)) {
+    if (read->session.state() == ViewportDepthPickSession::ReadbackState::Failed) {
+      BKE_report(op->reports, RPT_ERROR, "View changed while resolving navigation depth");
+      return view3d_navigation_depth_cancel(C, op, vod);
+    }
+    navigate_pivot_fallback(vod->region, vod->v3d, read, pivot);
+  }
+  ED_view3d_autodist_last_set(read->window, &read->invoke_event, pivot, true);
+  copy_v3_v3(read->resolved_pivot, pivot);
+  read->resolved = true;
+
+  const wmEvent invoke_event = read->invoke_event;
+  const wmEvent queued_event = read->queued_event;
+  const bool queued_event_valid = read->queued_event_valid;
+  const ViewOpsType *nav_type = vod->nav_type;
+  const bool use_cursor_init = read->use_cursor_init;
+  if (read->timer != nullptr) {
+    WM_event_timer_remove(CTX_wm_manager(C), read->window, read->timer);
+    read->timer = nullptr;
+  }
+
+  const ViewOpsDataInitResult init_result = vod->init_navigation(
+      C, &invoke_event, nav_type, nullptr, use_cursor_init, true);
+  BLI_assert(init_result == ViewOpsDataInitResult::Ready);
+  viewops_depth_read_free(C, vod);
+  ED_view3d_smooth_view_force_finish(C, vod->v3d, vod->region);
+
+  wmOperatorStatus ret = nav_type->init_fn(C, vod, &invoke_event, op->ptr);
+  if (ret != OPERATOR_RUNNING_MODAL) {
+    viewops_data_free(C, vod);
+    op->customdata = nullptr;
+    return ret;
+  }
+  if (queued_event_valid) {
+    return view3d_navigate_modal_fn(C, op, &queued_event);
+  }
+  return OPERATOR_RUNNING_MODAL;
+}
