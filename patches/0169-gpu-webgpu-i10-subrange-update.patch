+static void i10_attribute_layout(const GPUVertFormat &fmt,
+                                 const uint attribute_index,
+                                 const uint vertex_len,
+                                 size_t &r_base,
+                                 size_t &r_stride)
+{
+  const GPUVertAttr &attribute = fmt.attrs[attribute_index];
+  if (!fmt.deinterleaved) {
+    r_base = attribute.offset;
+    r_stride = fmt.stride;
+    return;
+  }
+  r_base = 0;
+  for (uint index = 0; index < attribute_index; index++) {
+    r_base += size_t(fmt.attrs[index].type.size()) * size_t(vertex_len);
+  }
+  r_stride = attribute.type.size();
+}
