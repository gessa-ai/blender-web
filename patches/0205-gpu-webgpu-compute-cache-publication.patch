diff --git a/source/blender/gpu/webgpu/wgpu_common.hh b/source/blender/gpu/webgpu/wgpu_common.hh
--- a/source/blender/gpu/webgpu/wgpu_common.hh
+++ b/source/blender/gpu/webgpu/wgpu_common.hh
@@ -161 +161,13 @@ inline bool cache_handle_if_valid(CacheT &cache, const KeyT &key, const HandleT &handle)
+/** Append a specialization-keyed pipeline variant only after fallible creation succeeds. A null
+ * variant must stay absent so a later request for the same key retries creation. */
+template<typename CacheT, typename KeyT, typename HandleT>
+inline bool cache_variant_if_valid(CacheT &cache, const KeyT &key, const HandleT &handle)
+{
+  if (handle == nullptr) {
+    return false;
+  }
+  cache.push_back({key, handle});
+  return true;
+}
+
 /** One signed viewport plus its WebGPU-valid unsigned framebuffer intersection. */
diff --git a/source/blender/gpu/webgpu/wgpu_shader.cc b/source/blender/gpu/webgpu/wgpu_shader.cc
--- a/source/blender/gpu/webgpu/wgpu_shader.cc
+++ b/source/blender/gpu/webgpu/wgpu_shader.cc
@@ -2573,3 +2573,5 @@ wgpu::ComputePipeline WGPUShader::compute_pipeline(const wgpu::Device &device)
   wgpu::ComputePipeline pipeline = device.CreateComputePipeline(&desc);
-  compute_pipelines_.push_back({key, pipeline});
+  if (!wgi::cache_variant_if_valid(compute_pipelines_, key, pipeline)) {
+    return nullptr;
+  }
   return pipeline;
