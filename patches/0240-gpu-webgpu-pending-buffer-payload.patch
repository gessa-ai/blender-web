+/** Ordered owned writes that arrive while one persistent allocation is unresolved.
+ *
+ * Browser error-scope callbacks settle only after the frontend update call has returned, so the
+ * caller's bytes cannot remain borrowed. Rejection deliberately leaves the queue retryable; an
+ * accepted allocation drains each retained payload once in frontend order. `ContextT` carries the
+ * queue/device state needed by the backend replay without retaining its owning Buffer object. */
+template<typename ContextT> class PendingBufferPayloadQueue {
+ private:
+  struct Entry {
+    ContextT context;
+    size_t offset = 0;
+    std::vector<uint8_t> bytes;
+  };
+
+ public:
+  bool begin(const size_t allocation_size)
+  {
+    if (allocation_size == 0) {
+      return false;
+    }
+    std::lock_guard lock(mutex_);
+    if (!entries_.empty() && allocation_size_ != 0 && allocation_size_ != allocation_size) {
+      return false;
+    }
+    allocation_size_ = allocation_size;
+    retryable_ = true;
+    return true;
+  }
+
+  bool retain(ContextT context, const size_t offset, const void *data, const size_t size)
+  {
+    if (data == nullptr || (offset % kCopyAlignment) != 0 ||
+        (size % kCopyAlignment) != 0)
+    {
+      return false;
+    }
+    std::lock_guard lock(mutex_);
+    if (!retryable_ || !range_fits(offset, size, allocation_size_)) {
+      return false;
+    }
+    Entry entry{std::move(context), offset, {}};
+    const uint8_t *source = static_cast<const uint8_t *>(data);
+    entry.bytes.assign(source, source + size);
+    entries_.push_back(std::move(entry));
+    return true;
+  }
+
+  bool retryable() const
+  {
+    std::lock_guard lock(mutex_);
+    return retryable_;
+  }
+
+  size_t allocation_size() const
+  {
+    std::lock_guard lock(mutex_);
+    return allocation_size_;
+  }
+
+  size_t size() const
+  {
+    std::lock_guard lock(mutex_);
+    return entries_.size();
+  }
+
+  template<typename ReplayFn>
+  size_t replay(const size_t allocation_size, ReplayFn &&replay)
+  {
+    std::deque<Entry> entries;
+    {
+      std::lock_guard lock(mutex_);
+      if (!retryable_ || allocation_size_ != allocation_size) {
+        return 0;
+      }
+      retryable_ = false;
+      entries.swap(entries_);
+    }
+
+    size_t replayed = 0;
+    for (size_t index = 0; index < entries.size(); index++) {
+      Entry &entry = entries[index];
+      if (replay(entry.context, entry.offset, entry.bytes.data(), entry.bytes.size()))
+      {
+        replayed++;
+        continue;
+      }
+
+      /* Preserve the failed payload and every later payload ahead of any update retained by a
+       * concurrent frontend call while this replay was outside the lock. */
+      std::lock_guard lock(mutex_);
+      for (size_t pending = entries.size(); pending > index; pending--) {
+        entries_.push_front(std::move(entries[pending - 1]));
+      }
+      retryable_ = true;
+      break;
+    }
+    return replayed;
+  }
+
+ private:
+  mutable std::mutex mutex_;
+  std::deque<Entry> entries_;
+  size_t allocation_size_ = 0;
+  bool retryable_ = false;
+};
