+  if constexpr (std::is_same_v<EncodeResult, bool>) {
+    if (!std::forward<EncodeFn>(encode)(encoder)) {
+      return false;
+    }
+  }
+  else {
+    std::forward<EncodeFn>(encode)(encoder);
+  }
   auto command_buffer = encoder.Finish();
