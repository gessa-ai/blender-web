+static VertexBinding dummy_vertex_binding(const uint32_t location, const uint8_t type_byte)
+{
+  uint32_t attribute_size = 0;
+  const wgpu::VertexFormat format = dummy_vertex_format(type_byte, attribute_size);
+  BLI_assert(attribute_size <= 16);
+
+  VertexBinding binding;
+  binding.vbo_index = -1;
+  binding.is_dummy = true;
+  binding.buffer_offset = 0;
+  /* Pinned Dawn accepts zero array stride and validates only the attribute's fixed byte span.
+   * Match Vulkan's constant-attribute binding so firstVertex/firstInstance and draw counts can
+   * never walk past the shared 16-byte zero buffer. */
+  binding.array_stride = 0;
+  binding.step_mode = wgpu::VertexStepMode::Vertex;
+  wgpu::VertexAttribute attribute = {};
+  attribute.format = format;
+  attribute.offset = 0;
+  attribute.shaderLocation = location;
+  binding.attributes.push_back(attribute);
+  return binding;
+}
