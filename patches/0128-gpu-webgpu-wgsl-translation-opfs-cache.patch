-  {
-    out.error = err;
-    return out;
+  /* WARM-BOOT CACHE (M4.T29): the emitted WGSL is a pure function of the per-stage
+   * GLSL (which already carries every #define) plus the translation inputs
+   * (optimize flag, sampler_base, sampler_mappings). On the web build the whole
+   * first-draw shader set is translated INLINE on the WM worker (the async
+   * ShaderCompiler is bypassed under use_main_context_workaround), and shaderc
+   * alone measures ~81% of the ~16 s boot compile block (notes/gpu-r51-shader-
+   * latency.md). So look the WGSL up before paying shaderc+Tint; on a hit, hand the
+   * stored WGSL straight back. The browser createShaderModule that the caller runs
+   * next is unaffected - it recompiles the identical WGSL and hits ITS own cache.
+   * The cache is inert (every call a no-op, cold behaviour byte-for-byte
+   * unchanged) wherever the OPFS mount is absent, e.g. the native gpu build. */
+  const ShaderCacheKey ckey =
+      cache_key(sources, options.optimize, out.interface.sampler_base, maps);
+  if (!cache_lookup(ckey, out.vertex_wgsl, out.fragment_wgsl, out.compute_wgsl)) {
+    if (!run_stage(sources.vertex, shaderc_vertex_shader, out.vertex_wgsl) ||
+        !run_stage(sources.fragment, shaderc_fragment_shader, out.fragment_wgsl) ||
+        !run_stage(sources.compute, shaderc_compute_shader, out.compute_wgsl))
+    {
+      out.error = err;
+      return out;
+    }
+    cache_store(ckey, out.vertex_wgsl, out.fragment_wgsl, out.compute_wgsl);
   }
 
   out.ok = true;
