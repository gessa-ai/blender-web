+/** Where an explicit framebuffer load-action clear can execute. A fixed layer or a one-layer
+ * attachment is covered by the draw's render pass. WebGPU cannot attach every layer of an array
+ * texture to one pass, so an all-layer selection must be materialized before drawing. */
+enum class FramebufferLoadClearScope : uint8_t { Invalid, RenderPass, MaterializeAllLayers };
+
+inline FramebufferLoadClearScope framebuffer_load_clear_scope(int selected_layer,
+                                                              uint32_t layer_count)
+{
+  if (layer_count == 0 || layer_count > uint32_t(std::numeric_limits<int>::max()) ||
+      (selected_layer >= 0 && uint32_t(selected_layer) >= layer_count))
+  {
+    return FramebufferLoadClearScope::Invalid;
+  }
+  if (selected_layer < 0 && layer_count > 1) {
+    return FramebufferLoadClearScope::MaterializeAllLayers;
+  }
+  return FramebufferLoadClearScope::RenderPass;
+}
