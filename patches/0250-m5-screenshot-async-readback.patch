+static wmOperatorStatus screenshot_modal(bContext *C, wmOperator *op, const wmEvent *event)
+{
+  ScreenshotData *scd = static_cast<ScreenshotData *>(op->customdata);
+  if (scd == nullptr || event->type != TIMER || event->customdata != scd->readback_timer) {
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+
+  constexpr int max_tick_count = 240;
+  const WMWindowPixelsReadStatus status = WM_window_pixels_read_async_status(scd->readback);
+  if (status == WMWindowPixelsReadStatus::Pending) {
+    scd->readback_tick_count++;
+    if (scd->readback_tick_count < max_tick_count) {
+      return OPERATOR_RUNNING_MODAL;
+    }
+    BKE_report(op->reports, RPT_ERROR, "Screenshot capture timed out");
+    screenshot_data_free(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  return screenshot_exec(C, op);
+}
 
