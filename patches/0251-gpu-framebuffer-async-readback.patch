+static void test_framebuffer_readback_owned_region()
+{
+  GPU_render_begin();
+
+  constexpr int width = 4;
+  constexpr int height = 3;
+  const uchar4 clear_value(17, 34, 51, 68);
+  Texture *texture = GPU_texture_create_2d("owned-framebuffer-readback",
+                                           width,
+                                           height,
+                                           1,
+                                           TextureFormat::UNORM_8_8_8_8,
+                                           GPU_TEXTURE_USAGE_ATTACHMENT |
+                                               GPU_TEXTURE_USAGE_HOST_READ,
+                                           nullptr);
+  ASSERT_NE(texture, nullptr);
+  GPU_texture_clear(texture, GPU_DATA_UBYTE, clear_value);
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+
+  FrameBuffer *framebuffer = nullptr;
+  GPU_framebuffer_ensure_config(
+      &framebuffer, {GPU_ATTACHMENT_NONE, GPU_ATTACHMENT_TEXTURE(texture)});
+  ASSERT_NE(framebuffer, nullptr);
+  GPU_framebuffer_bind(framebuffer);
+  GPUReadback *readback = GPU_framebuffer_read_color_async(
+      framebuffer, 1, 1, 2, 1, 3, 0, GPU_DATA_UBYTE);
+  ASSERT_NE(readback, nullptr);
+  EXPECT_EQ(GPU_readback_size(readback), 6u);
+#ifdef __EMSCRIPTEN__
+  EXPECT_EQ(GPU_readback_status(readback), GPU_READBACK_PENDING);
+  EXPECT_EQ(GPU_readback_error(readback), GPU_READBACK_ERROR_NONE);
+  GPU_framebuffer_restore();
+  GPU_framebuffer_free(framebuffer);
+  GPU_texture_free(texture);
+  GPU_readback_cancel(readback);
+  EXPECT_EQ(readback, nullptr);
+#else
+  EXPECT_EQ(GPU_readback_status(readback), GPU_READBACK_READY);
+  EXPECT_EQ(GPU_readback_error(readback), GPU_READBACK_ERROR_NONE);
+  GPU_framebuffer_restore();
+  GPU_framebuffer_free(framebuffer);
+  GPU_texture_free(texture);
+
+  std::array<unsigned char, 6> actual = {};
+  EXPECT_TRUE(GPU_readback_consume(readback, actual.data(), actual.size()));
+  EXPECT_EQ(readback, nullptr);
+  EXPECT_EQ(actual, (std::array<unsigned char, 6>{17, 34, 51, 17, 34, 51}));
+#endif
+
+  GPUReadback *invalid = GPU_framebuffer_read_color_async(
+      nullptr, 0, 0, 1, 1, 4, 0, GPU_DATA_UBYTE);
+  EXPECT_EQ(GPU_readback_status(invalid), GPU_READBACK_FAILED);
+  EXPECT_EQ(GPU_readback_error(invalid), GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  GPU_readback_cancel(invalid);
+  GPU_render_end();
+}
