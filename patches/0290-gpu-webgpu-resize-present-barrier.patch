diff --git a/source/blender/gpu/webgpu/wgpu_context.hh b/source/blender/gpu/webgpu/wgpu_context.hh
--- a/source/blender/gpu/webgpu/wgpu_context.hh
+++ b/source/blender/gpu/webgpu/wgpu_context.hh
@@ -329,4 +329,10 @@ class WGPUContext : public Context {
   wgpu::Queue queue_ = nullptr;
   /** Serializes async validation with queue writes/submissions without changing their order. */
   webgpu::OrderedQueueScheduler queue_scheduler_;
+#if defined(__EMSCRIPTEN__) && !defined(WITH_HEADLESS)
+  /** Resize episode adopted atomically with this window frame's persistent backbuffer. A
+   * replacement can settle while the frame is encoding; only an adopted frame from the current
+   * episode may place that episode's completed-frame barrier at its queue tail. */
+  uint64_t redraw_present_frame_episode_ = 0;
+#endif
   /** Device-bound pipeline handles must not outlive this context or reach a later device. */

diff --git a/source/blender/gpu/webgpu/wgpu_context.cc b/source/blender/gpu/webgpu/wgpu_context.cc
--- a/source/blender/gpu/webgpu/wgpu_context.cc
+++ b/source/blender/gpu/webgpu/wgpu_context.cc
@@ -58,3 +58,4 @@
  * any native build keep the native branch below unchanged. */
 #  include "GHOST_ContextWGPUWeb.hh"
+#  include "GHOST_WebDisplayState.hh"
 using WGPUGhostContext = GHOST_ContextWGPUWeb;
@@ -128,4 +128,10 @@ WGPUContext::~WGPUContext()
 {
+#if defined(__EMSCRIPTEN__) && !defined(WITH_HEADLESS)
+  if (ghost_web::redraw_present_barrier_is_scheduled()) {
+    ghost_web::cancel_redraw_present_barrier(
+        ghost_web::redraw_present_barrier_scheduled_episode());
+  }
+#endif
   /* Drop the back-buffer wrapper first: the base Texture dtor detaches it from
    * back_left/front_left (which are still alive here), releasing the surface
    * texture ref without destroying the surface's own texture. */
@@ -1237,31 +1237,34 @@ void WGPUContext::sync_backbuffer()
   WGPUGhostContext *wgpu_ghost = static_cast<WGPUGhostContext *>(ghost_context_);
   /* M4.T21 present seam: adopt the GHOST context's PERSISTENT offscreen back-buffer as
    * back_left/front_left, NOT the surface's per-frame GetCurrentTexture(). The transient
    * surface texture is destroyed by the browser on event-loop yield, so any draw/composite
    * command buffer that outlives the rAF tick submitted a destroyed texture ("Destroyed
    * texture … WebgpuSwapChainTexture used in a submit", 725x/boot). The offscreen has NO
    * per-frame lifetime, so that whole family is eliminated by construction; GHOST blits it
    * onto the real surface as the last op of each frame (presentBackbuffer in
    * swapBufferRelease). */
-  wgpu::Texture backbuffer = wgpu_ghost->getBackbufferTexture();
+  const WGPUGhostContext::BackbufferFrameSnapshot backbuffer_snapshot =
+      wgpu_ghost->getBackbufferFrameSnapshot();
+  wgpu::Texture backbuffer = backbuffer_snapshot.texture;
   if (backbuffer == nullptr) {
     return; /* surface not configured yet (canvas unresolved / pre-first-configure) */
   }
-  const int w = int(backbuffer.GetWidth());
-  const int h = int(backbuffer.GetHeight());
-  const wgpu::TextureFormat fmt = wgpu_ghost->getSurfaceFormat();
+  const int w = int(backbuffer_snapshot.width);
+  const int h = int(backbuffer_snapshot.height);
+  const wgpu::TextureFormat fmt = backbuffer_snapshot.format;

   const bool first = (surface_texture_ == nullptr);
   webgpu::WGPUTexture *back;
   if (first) {
     back = new webgpu::WGPUTexture("back_left_backbuffer");
     surface_texture_ = back;
   }
   else {
     back = static_cast<webgpu::WGPUTexture *>(surface_texture_);
   }
   /* Re-adopt each activate: the offscreen handle only changes on resize (GHOST recreates
    * it at the new extent), and re-adopting refreshes the wrapped texture + size in place
    * while the attachment keeps pointing at this same WGPUTexture wrapper. */
   back->adopt_external(backbuffer, fmt, w, h);
+  redraw_present_frame_episode_ = backbuffer_snapshot.redraw_episode;

@@ -1296,6 +1301,32 @@ void WGPUContext::begin_frame()
 {
+  /* The web window context captured its resize episode atomically with backbuffer adoption in
+   * sync_backbuffer(), which activation runs immediately before this frame begins. */
   queue_scheduler_.begin_epoch();
 }
-void WGPUContext::end_frame() {}
+void WGPUContext::end_frame()
+{
+#if defined(__EMSCRIPTEN__) && !defined(WITH_HEADLESS)
+  /* Browser command validation settles after WM has finished encoding this frame. During a
+   * coherent resize episode, reserve one tail barrier before GHOST reaches swapBufferRelease().
+   * The barrier holds later queue work until GHOST has synchronously submitted a copy of this
+   * completed frame, preventing an intermediate backbuffer pass from reaching the canvas. A
+   * frame which began before the replacement backbuffer committed is not eligible: its commands
+   * target the previous drawable even if the resize episode becomes current before this tail. */
+  const uint64_t episode = ghost_web::redraw_episode_generation();
+  if (ghost_window_ != nullptr && ghost_web::redraw_present_frame_matches_episode(
+                                      redraw_present_frame_episode_, episode) &&
+      ghost_web::redraw_trace_active(episode) &&
+      ghost_web::schedule_redraw_present_barrier(episode))
+  {
+    queue_scheduler_.enqueue(
+        [episode](std::function<void(bool)> done) {
+          ghost_web::arrive_redraw_present_barrier(episode, std::move(done));
+        },
+        [episode]() {
+          ghost_web::cancel_redraw_present_barrier(episode);
+        });
+  }
+#endif
+}
 void WGPUContext::flush() {}
 void WGPUContext::finish() {}
