+}
+
+static int expr_float_exceptions_ternary(const TernaryOpFunc func,
+                                         const double arg_a,
+                                         const double arg_b,
+                                         const double arg_c,
+                                         const double result)
+{
+#ifdef __EMSCRIPTEN__
+  const double args[3] = {arg_a, arg_b, arg_c};
+  int flags = wasm_float_invalid(args, 3, result);
