+static void test_texture_1d_array_webgpu_shader_lowering_overloads()
+{
+  using namespace shader;
+  GPU_render_begin();
+
+  ShaderCreateInfo graphics("pyGPU_Shader");
+  graphics.sampler(0, ImageType::Float1DArray, "float_map");
+  graphics.sampler(1, ImageType::Int1DArray, "int_map");
+  graphics.sampler(2, ImageType::Uint1DArray, "uint_map");
+  graphics.builtins(BuiltinBits::VERTEX_ID);
+  graphics.fragment_out(0, Type::float4_t, "out_color");
+  graphics.vertex_source_generated =
+      "void main() {\n"
+      "  float x = float((gl_VertexID << 1) & 2);\n"
+      "  float y = float(gl_VertexID & 2);\n"
+      "  gl_Position = vec4(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);\n"
+      "}\n";
+  /* `textureQueryLod` remains a binding 0147 compiler dependency. Shaderc emits
+   * OpImageQueryLod after the dimensional GLSL source rewrite, and Tint rejects it
+   * before WGSL generation. Its exact result also depends on runtime sampler LOD
+   * clamps and mip filtering, so a source-level derivative approximation is not faithful. */
+  graphics.fragment_source_generated =
+      "void main() {\n"
+      "  vec2 c = vec2(0.375, 1.0);\n"
+      "  vec4 v = texture(float_map, c, 0.0);\n"
+      "  v += textureOffset(float_map, c, 1, 0.0);\n"
+      "  v += textureLod(float_map, c, 0.0);\n"
+      "  v += textureLodOffset(float_map, c, 0.0, 1);\n"
+      "  v += textureGrad(float_map, c, 0.25, 0.25);\n"
+      "  v += textureGradOffset(float_map, c, 0.25, 0.25, 1);\n"
+      "  ivec4 i = texture(int_map, c, 0.5);\n"
+      "  i += textureOffset(int_map, c, 1, 0.5);\n"
+      "  i += textureLod(int_map, c, 0.0);\n"
+      "  i += textureLodOffset(int_map, c, 0.0, 1);\n"
+      "  i += textureGrad(int_map, c, 0.25, 0.25);\n"
+      "  i += textureGradOffset(int_map, c, 0.25, 0.25, 1);\n"
+      "  i += texelFetch(int_map, ivec2(1, 1), 0);\n"
+      "  i += texelFetchOffset(int_map, ivec2(1, 1), 0, 1);\n"
+      "  uvec4 u = texture(uint_map, c, 0.5);\n"
+      "  u += textureOffset(uint_map, c, 1, 0.5);\n"
+      "  u += textureLod(uint_map, c, 0.0);\n"
+      "  u += textureLodOffset(uint_map, c, 0.0, 1);\n"
+      "  u += textureGrad(uint_map, c, 0.25, 0.25);\n"
+      "  u += textureGradOffset(uint_map, c, 0.25, 0.25, 1);\n"
+      "  ivec2 sz = textureSize(int_map, 0);\n"
+      "  out_color = v + vec4(i) + vec4(u) + vec4(sz, 0.0, 0.0);\n"
+      "}\n";
+  gpu::Shader *graphics_shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&graphics));
+  ASSERT_NE(graphics_shader, nullptr);
+  GPU_shader_free(graphics_shader);
+
+  ShaderCreateInfo storage("pyGPU_Shader");
+  storage.image(0,
+                TextureFormat::UINT_32,
+                Qualifier::read,
+                ImageReadWriteType::Uint1DArray,
+                "read_img");
+  storage.image(1,
+                TextureFormat::UINT_32,
+                Qualifier::write,
+                ImageReadWriteType::Uint1DArray,
+                "write_img");
+  storage.local_group_size(1, 1, 1);
+  storage.compute_source_generated =
+      "void main() {\n"
+      "  ivec2 coord = ivec2(gl_GlobalInvocationID.xy);\n"
+      "  ivec2 size = imageSize(read_img);\n"
+      "  uvec4 value = imageLoad(read_img, min(coord, size - 1));\n"
+      "  imageStore(write_img, min(coord, size - 1), value);\n"
+      "}\n";
+  gpu::Shader *storage_shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&storage));
+  ASSERT_NE(storage_shader, nullptr);
+  GPU_shader_free(storage_shader);
+  GPU_render_end();
+}
