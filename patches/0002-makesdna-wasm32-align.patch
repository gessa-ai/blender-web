+/* -------------------------------------------------------------------------
+ * blender-web: wasm32 struct-layout correction.
+ *
+ * makesdna's `size_native` model computes each member's offset as a running SUM
+ * of member sizes and does NOT insert alignment padding of its own; it relies on
+ * the DNA structs being hand-padded so the sum already lands every member on its
+ * natural boundary for the *native* ABI. That hand-padding is tuned for the two
+ * ABIs Blender historically targeted: LP64 (pointers 8, int64_t/double 8) and
+ * ILP32/i386-style (pointers 4, and -- crucially -- int64_t/double aligned to 4).
+ * makesdna encodes exactly this: when `sizeof(void*) == 4` it treats an 8-byte
+ * scalar as only needing 4-byte alignment, and it only enforces 8-byte struct
+ * alignment when `sizeof(void*) == 8` (see the struct-alignment check below).
+ *
+ * wasm32 is a THIRD ABI that model never anticipated: pointers are 4 bytes (like
+ * i386) but int64_t / double / any struct containing them keep 8-byte alignment
+ * (like LP64). Because the makesdna tool is itself cross-compiled to wasm32 here,
+ * `sizeof(void*)` is 4 inside it, so it lays members out i386-style -- omitting
+ * the very padding Clang's real wasm32 layout inserts. Concrete failure:
+ * `offsetof(Scene, customdata_mask)` -> makesdna 5012, emcc 5016 (a 4-byte pad
+ * before the 8-aligned CustomData_MeshMasks that makesdna skipped), tripping the
+ * offsetof() static_assert in dna_verify.cc.
+ *
+ * Fix: on the wasm build only, round the running offset UP to each member's real
+ * wasm32 alignment before adding its size -- exactly what the C++ compiler does.
+ * `align_32` already encodes the wasm32 alignment model member-for-member
+ * (pointers 4, int64_t/double 8, structs = recursive max of their members), so it
+ * is the correct per-member alignment to round to.
+ *
+ * This entire path is compiled ONLY into the wasm makesdna. The native host tool
+ * that generates the shipping DNA is built without __EMSCRIPTEN__, so native
+ * `.blend` layout is byte-for-byte identical to upstream (the guard cannot alter
+ * it). Ported for the web from source/blender/makesdna/intern/makesdna.cc.
+ */
+static int member_align_native(const TypeInfo &member_type,
+                               const dna::ParsedMember &parsed_member)
+{
+  const char *cp = parsed_member.member_name.c_str();
+  /* Pointer or function pointer: wasm32 pointer alignment is 4. */
+  if (cp[0] == '*' || cp[1] == '*') {
+    return 4;
+  }
+  /* `align_32` models pointers-as-4 with natural (size-based) scalar alignment,
+   * i.e. exactly wasm32. Fold in any per-member C++ `alignas` override. */
+  return std::max<int>(member_type.align_32, parsed_member.alignment);
 }
 
+/** Round `offset` up to a multiple of `align` (a power of two >= 1). */
+static int dna_align_up(const int offset, const int align)
+{
+  if (align > 1 && (offset % align) != 0) {
+    return offset + (align - (offset % align));
+  }
+  return offset;
+}
+#endif /* __EMSCRIPTEN__ */
