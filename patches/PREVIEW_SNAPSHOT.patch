+namespace {
+
+static eGPUReadbackError readback_error_from_ticket(const readback::TicketError error)
+{
+  switch (error) {
+    case readback::TicketError::None:
+      return GPU_READBACK_ERROR_NONE;
+    case readback::TicketError::InvalidArgument:
+      return GPU_READBACK_ERROR_INVALID_ARGUMENT;
+    case readback::TicketError::CapacityExceeded:
+      return GPU_READBACK_ERROR_CAPACITY_EXCEEDED;
+    case readback::TicketError::StagingAllocationFailed:
+      return GPU_READBACK_ERROR_ALLOCATION_FAILED;
+    case readback::TicketError::MapFailed:
+      return GPU_READBACK_ERROR_MAP_FAILED;
+    case readback::TicketError::NoMappedRange:
+      return GPU_READBACK_ERROR_NO_MAPPED_RANGE;
+    case readback::TicketError::SourceForgotten:
+    case readback::TicketError::Canceled:
+      return GPU_READBACK_ERROR_SOURCE_UNAVAILABLE;
+  }
+  return GPU_READBACK_ERROR_BACKEND_FAILURE;
+}
+
+class WGPUTextureReadback final : public GPUReadback {
+ private:
+  readback::Ticket ticket_ = readback::kInvalidTicket;
+  TextureFormat texture_format_ = TextureFormat::Invalid;
+  ConvClass conv_ = ConvClass::Direct;
+  bool snorm16_emulated_ = false;
+  wgpu::TextureAspect aspect_ = wgpu::TextureAspect::All;
+  eGPUDataFormat host_format_ = GPU_DATA_FLOAT;
+  size_t sample_count_ = 0;
+  size_t raw_size_ = 0;
+  size_t final_size_ = 0;
+  eGPUReadbackStatus status_ = GPU_READBACK_PENDING;
+  eGPUReadbackError error_ = GPU_READBACK_ERROR_NONE;
+  std::vector<unsigned char> host_bytes_;
+
+  void refresh()
+  {
+    if (status_ != GPU_READBACK_PENDING) {
+      return;
+    }
+    switch (readback::ticket_status(ticket_)) {
+      case readback::TicketStatus::Pending:
+        return;
+      case readback::TicketStatus::Ready: {
+        if (readback::ticket_size(ticket_) != raw_size_) {
+          error_ = GPU_READBACK_ERROR_BACKEND_FAILURE;
+          status_ = GPU_READBACK_FAILED;
+          readback::free_ticket(ticket_);
+          ticket_ = readback::kInvalidTicket;
+          return;
+        }
+        std::vector<unsigned char> raw_bytes(raw_size_);
+        if (readback::consume_ticket(ticket_, raw_bytes.data(), raw_bytes.size()) != raw_size_) {
+          error_ = GPU_READBACK_ERROR_BACKEND_FAILURE;
+          status_ = GPU_READBACK_FAILED;
+          readback::free_ticket(ticket_);
+          ticket_ = readback::kInvalidTicket;
+          return;
+        }
+        ticket_ = readback::kInvalidTicket;
+        host_bytes_.resize(final_size_);
+        convert_device_to_host_snapshot(texture_format_,
+                                        conv_,
+                                        snorm16_emulated_,
+                                        aspect_,
+                                        host_bytes_.data(),
+                                        raw_bytes.data(),
+                                        sample_count_,
+                                        host_format_);
+        status_ = GPU_READBACK_READY;
+        return;
+      }
+      case readback::TicketStatus::Failed:
+        error_ = readback_error_from_ticket(readback::ticket_error(ticket_));
+        status_ = GPU_READBACK_FAILED;
+        readback::free_ticket(ticket_);
+        ticket_ = readback::kInvalidTicket;
+        return;
+      case readback::TicketStatus::Canceled:
+      case readback::TicketStatus::Invalid:
+        error_ = GPU_READBACK_ERROR_SOURCE_UNAVAILABLE;
+        status_ = GPU_READBACK_FAILED;
+        readback::free_ticket(ticket_);
+        ticket_ = readback::kInvalidTicket;
+        return;
+    }
+  }
+
+ public:
+  WGPUTextureReadback(const readback::Ticket ticket,
+                      const TextureFormat texture_format,
+                      const ConvClass conv,
+                      const bool snorm16_emulated,
+                      const wgpu::TextureAspect aspect,
+                      const eGPUDataFormat host_format,
+                      const size_t sample_count,
+                      const size_t raw_size,
+                      const size_t final_size)
+      : ticket_(ticket),
+        texture_format_(texture_format),
+        conv_(conv),
+        snorm16_emulated_(snorm16_emulated),
+        aspect_(aspect),
+        host_format_(host_format),
+        sample_count_(sample_count),
+        raw_size_(raw_size),
+        final_size_(final_size)
+  {
+  }
+
+  ~WGPUTextureReadback() override
+  {
+    if (ticket_ != readback::kInvalidTicket) {
+      readback::free_ticket(ticket_);
+    }
+  }
+
+  eGPUReadbackStatus status() override
+  {
+    refresh();
+    return status_;
+  }
+
+  eGPUReadbackError error() override
+  {
+    refresh();
+    return error_;
+  }
+
+  size_t size() override
+  {
+    return final_size_;
+  }
+
+  bool consume(void *dst, const size_t dst_len) override
+  {
+    refresh();
+    if (status_ != GPU_READBACK_READY || dst == nullptr || dst_len < final_size_) {
+      return false;
+    }
+    if (!host_bytes_.empty()) {
+      std::memcpy(dst, host_bytes_.data(), host_bytes_.size());
+    }
+    return true;
+  }
+};
+
