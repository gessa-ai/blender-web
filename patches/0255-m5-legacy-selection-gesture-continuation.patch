+static void drw_select_buffer_bitmap_key_context_set(DRWSelectBufferBitmapKey &key)
+{
+  const SELECTID_Context *select_ctx = DRW_select_engine_context_get();
+  if (select_ctx == nullptr) {
+    return;
+  }
+  key.select_mode = select_ctx->select_mode;
+  key.objects.extend(select_ctx->objects);
+}
+
+static bool drw_select_buffer_bitmap_key_equal(const DRWSelectBufferBitmapKey &left,
+                                               const DRWSelectBufferBitmapKey &right)
+{
+  if (left.kind != right.kind || left.depsgraph != right.depsgraph ||
+      left.region != right.region || left.v3d != right.v3d ||
+      !BLI_rcti_compare(&left.read_rect, &right.read_rect) || left.center != right.center ||
+      left.radius != right.radius || left.select_mode != right.select_mode ||
+      left.objects.size() != right.objects.size() || left.poly.size() != right.poly.size())
+  {
+    return false;
+  }
+  for (const int64_t i : left.objects.index_range()) {
+    if (left.objects[i] != right.objects[i]) {
+      return false;
+    }
+  }
+  for (const int64_t i : left.poly.index_range()) {
+    if (left.poly[i] != right.poly[i]) {
+      return false;
+    }
+  }
+  return true;
+}
+
+static void drw_select_buffer_bitmap_fail(const eGPUReadbackError error)
+{
+  DRW_select_buffer_read_async_cancel(g_select_buffer_bitmap.pending);
+  MEM_SAFE_DELETE(g_select_buffer_bitmap.result.bitmap);
+  g_select_buffer_bitmap.failed = true;
+  g_select_buffer_bitmap.replay_required = false;
+  g_select_buffer_bitmap.settled = false;
+  g_select_buffer_bitmap.result_ready = false;
+  g_select_buffer_bitmap.error = error == GPU_READBACK_ERROR_NONE ?
+                                     GPU_READBACK_ERROR_BACKEND_FAILURE :
+                                     error;
+}
+
+static bool drw_select_buffer_bitmap_from_ids(const DRWSelectBufferBitmapKey &key,
+                                              const DRWSelectBufferQueryContext &context,
+                                              const uint *buf,
+                                              const uint buf_len,
+                                              BLI_bitmap *&r_bitmap,
+                                              uint &r_bitmap_len)
+{
+  r_bitmap = nullptr;
+  r_bitmap_len = 0;
+  if (buf == nullptr) {
+    return buf_len == 0;
+  }
+
+  uint expected_len = 0;
+  if (!drw_select_buffer_len(key.read_rect, expected_len) || buf_len != expected_len ||
+      context.max_index_drawn_len == 0)
+  {
+    return false;
+  }
+  const uint bitmap_len = context.max_index_drawn_len - 1;
+  BLI_bitmap *bitmap = BLI_BITMAP_NEW(bitmap_len, __func__);
+
+  if (key.kind == DRWSelectBufferBitmapKind::Rect) {
+    for (const uint id : Span(buf, buf_len)) {
+      /* Intentionally wrap to max value if this is zero. */
+      const uint index = id - 1;
+      if (index < bitmap_len) {
+        BLI_BITMAP_ENABLE(bitmap, index);
+      }
+    }
+  }
+  else if (key.kind == DRWSelectBufferBitmapKind::Circle) {
+    const int64_t diameter = int64_t(key.radius) * 2 + 1;
+    if (key.radius < 0 || diameter * diameter != int64_t(buf_len)) {
+      MEM_delete(bitmap);
+      return false;
+    }
+    const int64_t radius_sq = int64_t(key.radius) * int64_t(key.radius);
+    const uint *buf_iter = buf;
+    for (int64_t y = -key.radius; y <= key.radius; y++) {
+      for (int64_t x = -key.radius; x <= key.radius; x++, buf_iter++) {
+        if (x * x + y * y < radius_sq) {
+          const uint index = *buf_iter - 1;
+          if (index < bitmap_len) {
+            BLI_BITMAP_ENABLE(bitmap, index);
+          }
+        }
+      }
+    }
+  }
+  else {
+    BLI_bitmap *buf_mask = BLI_BITMAP_NEW(buf_len, __func__);
+    PolyMaskData poly_mask_data;
+    poly_mask_data.px = buf_mask;
+    poly_mask_data.width = BLI_rcti_size_x(&key.read_rect);
+    BLI_bitmap_draw_2d_poly_v2i_n(key.read_rect.xmin,
+                                  key.read_rect.ymin,
+                                  key.read_rect.xmax,
+                                  key.read_rect.ymax,
+                                  key.poly,
+                                  drw_select_mask_px_cb,
+                                  &poly_mask_data);
+    for (const int64_t i : IndexRange(buf_len)) {
+      const uint index = buf[i] - 1;
+      if (index < bitmap_len && BLI_BITMAP_TEST(buf_mask, i)) {
+        BLI_BITMAP_ENABLE(bitmap, index);
+      }
+    }
+    MEM_delete(buf_mask);
+  }
+
+  r_bitmap = bitmap;
+  r_bitmap_len = bitmap_len;
+  return true;
+}
+
+void DRW_select_buffer_bitmap_session_begin()
+{
+  DRW_select_buffer_bitmap_session_end();
+  g_select_buffer_bitmap.session_active = true;
+}
+
+void DRW_select_buffer_bitmap_session_end()
+{
+  DRW_select_buffer_read_async_cancel(g_select_buffer_bitmap.pending);
+  MEM_SAFE_DELETE(g_select_buffer_bitmap.result.bitmap);
+  g_select_buffer_bitmap = {};
+}
+
+bool DRW_select_buffer_bitmap_session_is_active()
+{
+  return g_select_buffer_bitmap.session_active;
+}
+
+bool DRW_select_buffer_bitmap_session_needs_replay()
+{
+  return g_select_buffer_bitmap.replay_required;
+}
+
+eGPUReadbackStatus DRW_select_buffer_bitmap_session_status()
+{
+  if (!g_select_buffer_bitmap.session_active) {
+    return GPU_READBACK_INVALID;
+  }
+  if (g_select_buffer_bitmap.failed) {
+    return GPU_READBACK_FAILED;
+  }
+  if (g_select_buffer_bitmap.pending == nullptr) {
+    return (g_select_buffer_bitmap.result_ready || g_select_buffer_bitmap.settled) ?
+               GPU_READBACK_READY :
+               GPU_READBACK_INVALID;
+  }
+
+  const eGPUReadbackStatus status =
+      DRW_select_buffer_read_async_status(g_select_buffer_bitmap.pending);
+  if (status == GPU_READBACK_PENDING) {
+    return status;
+  }
+  if (status != GPU_READBACK_READY) {
+    drw_select_buffer_bitmap_fail(
+        DRW_select_buffer_read_async_error(g_select_buffer_bitmap.pending));
+    return GPU_READBACK_FAILED;
+  }
+
+  uint buf_len = 0;
+  uint *buf = DRW_select_buffer_read_async_consume(g_select_buffer_bitmap.pending, &buf_len);
+  if (g_select_buffer_bitmap.pending != nullptr) {
+    const eGPUReadbackError error =
+        DRW_select_buffer_read_async_error(g_select_buffer_bitmap.pending);
+    MEM_delete(buf);
+    drw_select_buffer_bitmap_fail(error);
+    return GPU_READBACK_FAILED;
+  }
+
+  DRWSelectBufferBitmapResult result;
+  result.key = std::move(g_select_buffer_bitmap.pending_key);
+  result.context = std::move(g_select_buffer_bitmap.pending_context);
+  if (!drw_select_buffer_bitmap_from_ids(
+          result.key, result.context, buf, buf_len, result.bitmap, result.bitmap_len))
+  {
+    MEM_delete(buf);
+    drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    return GPU_READBACK_FAILED;
+  }
+  MEM_delete(buf);
+  g_select_buffer_bitmap.result = std::move(result);
+  g_select_buffer_bitmap.result_ready = true;
+  return GPU_READBACK_READY;
+}
+
+eGPUReadbackError DRW_select_buffer_bitmap_session_error()
+{
+  DRW_select_buffer_bitmap_session_status();
+  return g_select_buffer_bitmap.failed ? g_select_buffer_bitmap.error :
+                                         GPU_READBACK_ERROR_NONE;
+}
+
+static uint *drw_select_buffer_bitmap_query(const DRWSelectBufferBitmapKey &key,
+                                            uint *r_bitmap_len)
+{
+  if (r_bitmap_len != nullptr) {
+    *r_bitmap_len = 0;
+  }
+  if (!g_select_buffer_bitmap.session_active || g_select_buffer_bitmap.failed) {
+    return nullptr;
+  }
+
+  const eGPUReadbackStatus status = DRW_select_buffer_bitmap_session_status();
+  if (status == GPU_READBACK_FAILED) {
+    return nullptr;
+  }
+  if (g_select_buffer_bitmap.result_ready) {
+    if (!drw_select_buffer_bitmap_key_equal(g_select_buffer_bitmap.result.key, key)) {
+      drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+      return nullptr;
+    }
+    drw_select_buffer_query_context_restore(g_select_buffer_bitmap.result.context);
+    BLI_bitmap *bitmap = g_select_buffer_bitmap.result.bitmap;
+    g_select_buffer_bitmap.result.bitmap = nullptr;
+    if (r_bitmap_len != nullptr) {
+      *r_bitmap_len = g_select_buffer_bitmap.result.bitmap_len;
+    }
+    g_select_buffer_bitmap.result_ready = false;
+    g_select_buffer_bitmap.replay_required = false;
+    g_select_buffer_bitmap.settled = true;
+    return bitmap;
+  }
+  if (g_select_buffer_bitmap.settled) {
+    drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    return nullptr;
+  }
+  if (g_select_buffer_bitmap.pending != nullptr) {
+    if (!drw_select_buffer_bitmap_key_equal(g_select_buffer_bitmap.pending_key, key)) {
+      drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+    }
+    g_select_buffer_bitmap.replay_required = true;
+    return nullptr;
+  }
+
+  g_select_buffer_bitmap.replay_required = true;
+  g_select_buffer_bitmap.pending_key = key;
+  g_select_buffer_bitmap.pending = DRW_select_buffer_read_async(
+      key.depsgraph, key.region, key.v3d, &key.read_rect);
+  g_select_buffer_bitmap.pending_context = drw_select_buffer_query_context_capture();
+  if (DRW_select_buffer_bitmap_session_status() == GPU_READBACK_READY) {
+    return drw_select_buffer_bitmap_query(key, r_bitmap_len);
+  }
+  return nullptr;
+}
+
+static bool drw_select_buffer_bitmap_rect_key_create(const DRWSelectBufferBitmapKind kind,
+                                                     Depsgraph *depsgraph,
+                                                     ARegion *region,
+                                                     View3D *v3d,
+                                                     const rcti *rect,
+                                                     DRWSelectBufferBitmapKey &r_key)
+{
+  if (depsgraph == nullptr || region == nullptr || v3d == nullptr || rect == nullptr ||
+      DRW_select_engine_context_get() == nullptr ||
+      rect->xmax == std::numeric_limits<int>::max() ||
+      rect->ymax == std::numeric_limits<int>::max())
+  {
+    return false;
+  }
+  r_key.kind = kind;
+  r_key.depsgraph = depsgraph;
+  r_key.region = region;
+  r_key.v3d = v3d;
+  r_key.read_rect = *rect;
+  r_key.read_rect.xmax += 1;
+  r_key.read_rect.ymax += 1;
+  uint read_len = 0;
+  if (!drw_select_buffer_len(r_key.read_rect, read_len)) {
+    return false;
+  }
+  drw_select_buffer_bitmap_key_context_set(r_key);
+  return true;
+}
+
+uint *DRW_select_buffer_bitmap_from_rect_async(Depsgraph *depsgraph,
+                                               ARegion *region,
+                                               View3D *v3d,
+                                               const rcti *rect,
+                                               uint *r_bitmap_len)
+{
+  DRWSelectBufferBitmapKey key;
+  if (!drw_select_buffer_bitmap_rect_key_create(
+          DRWSelectBufferBitmapKind::Rect, depsgraph, region, v3d, rect, key))
+  {
+    drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    return nullptr;
+  }
+  return drw_select_buffer_bitmap_query(key, r_bitmap_len);
+}
+
+uint *DRW_select_buffer_bitmap_from_circle_async(Depsgraph *depsgraph,
+                                                 ARegion *region,
+                                                 View3D *v3d,
+                                                 const int center[2],
+                                                 const int radius,
+                                                 uint *r_bitmap_len)
+{
+  if (depsgraph == nullptr || region == nullptr || v3d == nullptr || center == nullptr ||
+      radius < 0 || DRW_select_engine_context_get() == nullptr)
+  {
+    drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    return nullptr;
+  }
+  const int64_t xmin = int64_t(center[0]) - radius;
+  const int64_t xmax = int64_t(center[0]) + radius + 1;
+  const int64_t ymin = int64_t(center[1]) - radius;
+  const int64_t ymax = int64_t(center[1]) + radius + 1;
+  if (xmin < std::numeric_limits<int>::min() || xmax > std::numeric_limits<int>::max() ||
+      ymin < std::numeric_limits<int>::min() || ymax > std::numeric_limits<int>::max())
+  {
+    drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    return nullptr;
+  }
+
+  DRWSelectBufferBitmapKey key;
+  key.kind = DRWSelectBufferBitmapKind::Circle;
+  key.depsgraph = depsgraph;
+  key.region = region;
+  key.v3d = v3d;
+  key.read_rect = {int(xmin), int(xmax), int(ymin), int(ymax)};
+  key.center = int2(center[0], center[1]);
+  key.radius = radius;
+  uint read_len = 0;
+  if (!drw_select_buffer_len(key.read_rect, read_len)) {
+    drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    return nullptr;
+  }
+  drw_select_buffer_bitmap_key_context_set(key);
+  return drw_select_buffer_bitmap_query(key, r_bitmap_len);
+}
+
+uint *DRW_select_buffer_bitmap_from_poly_async(Depsgraph *depsgraph,
+                                               ARegion *region,
+                                               View3D *v3d,
+                                               const Span<int2> poly,
+                                               const rcti *rect,
+                                               uint *r_bitmap_len)
+{
+  DRWSelectBufferBitmapKey key;
+  if (poly.is_empty() || !drw_select_buffer_bitmap_rect_key_create(
+                             DRWSelectBufferBitmapKind::Poly,
+                             depsgraph,
+                             region,
+                             v3d,
+                             rect,
+                             key))
+  {
+    drw_select_buffer_bitmap_fail(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+    return nullptr;
+  }
+  key.poly.extend(poly);
+  return drw_select_buffer_bitmap_query(key, r_bitmap_len);
+}
