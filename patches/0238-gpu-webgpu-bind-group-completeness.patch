diff --git a/source/blender/gpu/webgpu/wgpu_shader.cc b/source/blender/gpu/webgpu/wgpu_shader.cc
index bebe325013382431476fde2e3998873ca246e67e..10f04dca55178632983a6e3a46fb51ba457240ce 100644
--- a/source/blender/gpu/webgpu/wgpu_shader.cc
+++ b/source/blender/gpu/webgpu/wgpu_shader.cc
@@ -2633,6 +2633,27 @@ wgpu::ComputePipeline WGPUShader::compute_pipeline(const wgpu::Instance &instanc
 /** \name Explicit pipeline layout
  * \{ */
 
+bool WGPUShader::bind_group_entries_complete(
+    const std::vector<wgpu::BindGroupEntry> &entries) const
+{
+  std::vector<uint32_t> assembled_bindings;
+  assembled_bindings.reserve(entries.size());
+  for (const wgpu::BindGroupEntry &entry : entries) {
+    if (entry.buffer != nullptr || entry.textureView != nullptr || entry.sampler != nullptr) {
+      assembled_bindings.push_back(entry.binding);
+    }
+  }
+  if (webgpu::bind_group_binding_ids_complete(surviving_bindings_,
+                                               std::move(assembled_bindings)))
+  {
+    return true;
+  }
+  CLOG_WARN(&LOG,
+            "WGPUShader '%s': assembled group-0 resources do not match surviving WGSL bindings",
+            name_get().c_str());
+  return false;
+}
