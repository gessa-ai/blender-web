+
+static bool is_dashed_diagnostic_shader(const WGPUShader *shader)
+{
+#ifdef __EMSCRIPTEN__
+  return shader != nullptr &&
+         shader->name_get() == "gpu_shader_3D_line_dashed_uniform_color";
+#else
+  (void)shader;
+  return false;
+#endif
+}
+
+static void note_dashed_stage(const bool diagnostic, const DashedTraceStage stage)
+{
+#ifdef __EMSCRIPTEN__
+  if (diagnostic) {
+    ghost_web::note_immediate_dashed_stage(ghost_web::ImmediateDashedStage(stage));
+  }
+#else
+  (void)diagnostic;
+  (void)stage;
+#endif
+}
