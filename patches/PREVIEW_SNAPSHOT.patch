+static void test_compute_webgpu_push_constant_survivor(const bool indirect)
+{
+  using namespace shader;
+  constexpr uint32_t result_len = 4;
+  constexpr uint32_t expected = 0x51A7B00Fu;
+
+  ShaderCreateInfo info("pyGPU_Shader");
+  info.storage_buf(0, Qualifier::read_write, "uint", "results[]");
+  info.push_constant(Type::float4_t, "unused_value");
+  info.local_group_size(1, 1, 1);
+  info.compute_source_generated =
+      "void main() { results[gl_GlobalInvocationID.x] = 0x51A7B00Fu; }";
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+  GPU_shader_bind(shader);
+
+  gpu::StorageBuf *results = GPU_storagebuf_create_ex(
+      sizeof(uint32_t) * result_len, nullptr, GPU_USAGE_DEVICE_ONLY, __func__);
+  ASSERT_NE(results, nullptr);
+  GPU_storagebuf_clear_to_zero(results);
+  GPU_storagebuf_bind(results, GPU_shader_get_ssbo_binding(shader, "results"));
+
+  gpu::StorageBuf *indirect_buf = nullptr;
+  if (indirect) {
+    const uint32_t indirect_args[4] = {result_len, 1, 1, 0};
+    indirect_buf = GPU_storagebuf_create_ex(
+        sizeof(indirect_args), indirect_args, GPU_USAGE_STATIC, __func__);
+    ASSERT_NE(indirect_buf, nullptr);
+    GPU_compute_dispatch_indirect(shader, indirect_buf);
+  }
+  else {
+    GPU_compute_dispatch(shader, result_len, 1, 1);
+  }
+  GPU_memory_barrier(GPU_BARRIER_SHADER_STORAGE);
+
+  uint32_t read_data[result_len] = {};
+  GPU_storagebuf_read(results, read_data);
+  for (const uint32_t value : read_data) {
+    EXPECT_EQ(value, expected);
+  }
+
+  if (indirect_buf != nullptr) {
+    GPU_storagebuf_free(indirect_buf);
+  }
+  GPU_storagebuf_unbind(results);
+  GPU_storagebuf_free(results);
+  GPU_shader_unbind();
+  GPU_shader_free(shader);
+}
+
+static void test_compute_webgpu_push_constant_survivor_direct()
+{
+  test_compute_webgpu_push_constant_survivor(false);
+}
+GPU_WEBGPU_TEST(compute_webgpu_push_constant_survivor_direct)
+
+static void test_compute_webgpu_push_constant_survivor_indirect()
+{
+  test_compute_webgpu_push_constant_survivor(true);
+}
+GPU_WEBGPU_TEST(compute_webgpu_push_constant_survivor_indirect)
+
