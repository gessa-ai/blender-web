index 7919ff10a1b..698ad831c0f 100644
--- a/source/blender/blenlib/intern/expr_pylike_eval.cc
+++ b/source/blender/blenlib/intern/expr_pylike_eval.cc
@@ -48,6 +48,22 @@ namespace blender {
 #  pragma fenv_access(on)
 #endif
 
+#ifdef __EMSCRIPTEN__
+/* wasm has no floating-point exception status register, so Emscripten's
+ * <fenv.h> defines FE_ALL_EXCEPT as 0 and omits FE_DIVBYZERO / FE_INVALID
+ * entirely; fetestexcept() always returns 0. Define the missing flags to 0 so
+ * this compiles: the post-eval FP-exception check becomes a documented no-op on
+ * wasm (div-by-zero / NaN in expr_pylike expressions is not flagged here — see
+ * notes/m1-blenlib.md). Ported for the web from
+ * source/blender/blenlib/intern/expr_pylike_eval.cc @ fbe6228777e7. */
+#  ifndef FE_DIVBYZERO
+#    define FE_DIVBYZERO 0
+#  endif
+#  ifndef FE_INVALID
+#    define FE_INVALID 0
+#  endif
+#endif
+
