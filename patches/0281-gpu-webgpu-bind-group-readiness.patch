+  template<typename BeginScopeFn, typename CreateFn, typename EndScopeFn>
+  HandleT get_or_create_ordered(const KeyT &key,
+                                OrderedQueueScheduler &scheduler,
+                                BeginScopeFn &&begin_scope,
+                                CreateFn &&create,
+                                EndScopeFn &&end_scope)
+  {
+    if (!state_) {
+      state_ = std::make_shared<State>();
+    }
+    const uint64_t epoch = scheduler.current_epoch();
+    std::shared_ptr<OrderedPendingHandle> ordered_pending;
+    bool create_candidate = false;
+    bool reserve_dependency = false;
+    {
+      std::lock_guard lock(state_->mutex);
+      const auto accepted = state_->handles.find(key);
+      if (accepted != state_->handles.end()) {
+        return accepted->second;
+      }
+      if (!state_->pending.emplace(key).second) {
+        const auto pending = state_->ordered_pending.find(key);
+        if (pending == state_->ordered_pending.end() || pending->second->candidate == nullptr) {
+          return HandleT{};
+        }
+        ordered_pending = pending->second;
+        reserve_dependency = ordered_pending->gated_epochs.emplace(epoch).second;
+      }
+      else {
