+/** Join the browser's same-turn map request with the command's later error-scope verdict.
+ * Mapping may finish first, but bytes remain private until both halves settle. */
+struct PendingCommandMapState {
+  explicit PendingCommandMapState(std::shared_ptr<Pending> pending) : pending(std::move(pending))
+  {
+  }
+
+  std::mutex mutex;
+  std::shared_ptr<Pending> pending;
+  bool submission_known = false;
+  bool submitted = false;
+  bool command_done = false;
+  bool command_valid = false;
+  bool map_done = false;
+  bool finalized = false;
+  wgpu::MapAsyncStatus map_status = wgpu::MapAsyncStatus::Error;
+};
+
+void pending_command_map_maybe_complete(const std::shared_ptr<PendingCommandMapState> &state)
+{
+  std::shared_ptr<Pending> pending;
+  bool submitted = false;
+  bool command_valid = false;
+  wgpu::MapAsyncStatus map_status = wgpu::MapAsyncStatus::Error;
+  {
+    std::lock_guard lock(state->mutex);
+    if (state->finalized || !state->submission_known || !state->command_done ||
+        (state->submitted && !state->map_done))
+    {
+      return;
+    }
+    state->finalized = true;
+    pending = state->pending;
+    submitted = state->submitted;
+    command_valid = state->command_valid;
+    map_status = state->map_status;
+  }
+
+  if (!submitted) {
+    fail_reserved_pending(pending, TicketError::CommandEncodingFailed);
+    release_backend_handles(*pending);
+    return;
+  }
+  complete_pending(pending,
+                   map_status,
+                   command_valid ? TicketError::None : TicketError::CommandEncodingFailed);
+}
+
+void pending_command_map_submitted(const std::shared_ptr<PendingCommandMapState> &state,
+                                   const bool submitted)
+{
+  {
+    std::lock_guard lock(state->mutex);
+    state->submission_known = true;
+    state->submitted = submitted;
+  }
+  if (submitted) {
+    const std::shared_ptr<Pending> pending = state->pending;
+    pending->staging.MapAsync(
+        wgpu::MapMode::Read,
+        0,
+        pending->staging_size,
+        wgpu::CallbackMode::AllowSpontaneous,
+        [state](wgpu::MapAsyncStatus status, wgpu::StringView) {
+          {
+            std::lock_guard lock(state->mutex);
+            state->map_status = status;
+            state->map_done = true;
+          }
+          pending_command_map_maybe_complete(state);
+        });
+  }
+  pending_command_map_maybe_complete(state);
+}
+
+void pending_command_map_validated(const std::shared_ptr<PendingCommandMapState> &state,
+                                   const bool valid)
+{
+  {
+    std::lock_guard lock(state->mutex);
+    state->command_valid = valid;
+    state->command_done = true;
+  }
+  pending_command_map_maybe_complete(state);
+}
