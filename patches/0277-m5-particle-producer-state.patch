+static void PE_depth_cache_hash_bytes(ParticleEditDepthHash *hash,
+                                      const void *data,
+                                      const size_t size)
+{
+  /* This short-lived same-process token uses two independent 64-bit accumulators. It is not a
+   * persistent content identity; its only job is to make an in-place edit collision practically
+   * impossible while one depth request crosses browser event-loop ticks. */
+  const uint8_t *bytes = static_cast<const uint8_t *>(data);
+  for (size_t index = 0; index < size; index++) {
+    hash->low ^= uint64_t(bytes[index]);
+    hash->low *= 1099511628211ULL;
+    hash->high ^= uint64_t(bytes[index]) + 0x9e3779b97f4a7c15ULL + (hash->high << 6) +
+                  (hash->high >> 2);
+    hash->high *= 0x165667919e3779f9ULL;
+  }
+}
+
+template<typename T>
+static void PE_depth_cache_hash_value(ParticleEditDepthHash *hash, const T &value)
+{
+  PE_depth_cache_hash_bytes(hash, &value, sizeof(value));
+}
+
+static bool PE_depth_cache_edit_state_hash(const PTCacheEdit *edit,
+                                           ParticleEditDepthHash *r_hash)
+{
+  if (edit == nullptr || edit->totpoint < 0 ||
+      (edit->totpoint != 0 && edit->points == nullptr))
+  {
+    return false;
+  }
+
+  ParticleEditDepthHash hash;
+  PE_depth_cache_hash_value(&hash, edit->flags);
+  PE_depth_cache_hash_value(&hash, edit->points);
+  PE_depth_cache_hash_value(&hash, edit->psys);
+  PE_depth_cache_hash_value(&hash, edit->psys_eval);
+  PE_depth_cache_hash_value(&hash, edit->psmd);
+  PE_depth_cache_hash_value(&hash, edit->psmd_eval);
+  PE_depth_cache_hash_value(&hash, edit->totpoint);
+  PE_depth_cache_hash_value(&hash, edit->totframes);
+  PE_depth_cache_hash_value(&hash, edit->totcached);
+  PE_depth_cache_hash_value(&hash, edit->edited);
+
+  if (edit->psys != nullptr) {
+    if (edit->psys->totpart < 0 ||
+        (edit->psys->totpart != 0 && edit->psys->particles == nullptr) ||
+        size_t(edit->psys->totpart) > SIZE_MAX / sizeof(*edit->psys->particles))
+    {
+      return false;
+    }
+    PE_depth_cache_hash_value(&hash, edit->psys->part);
+    PE_depth_cache_hash_value(&hash, edit->psys->particles);
+    PE_depth_cache_hash_value(&hash, edit->psys->totpart);
+    PE_depth_cache_hash_value(&hash, edit->psys->flag);
+    if (edit->psys->part != nullptr) {
+      PE_depth_cache_hash_value(&hash, edit->psys->part->from);
+    }
+    if (edit->psys->totpart != 0) {
+      PE_depth_cache_hash_bytes(&hash,
+                                edit->psys->particles,
+                                sizeof(*edit->psys->particles) * size_t(edit->psys->totpart));
+    }
+  }
+
+  for (int point_index = 0; point_index < edit->totpoint; point_index++) {
+    const PTCacheEditPoint *point = &edit->points[point_index];
+    if (point->totkey < 0 || (point->totkey != 0 && point->keys == nullptr)) {
+      return false;
+    }
+    PE_depth_cache_hash_value(&hash, point->keys);
+    PE_depth_cache_hash_value(&hash, point->totkey);
+    PE_depth_cache_hash_value(&hash, point->flag);
+    for (int key_index = 0; key_index < point->totkey; key_index++) {
+      const PTCacheEditKey *key = &point->keys[key_index];
+      PE_depth_cache_hash_value(&hash, key->co);
+      PE_depth_cache_hash_value(&hash, key->vel);
+      PE_depth_cache_hash_value(&hash, key->rot);
+      PE_depth_cache_hash_value(&hash, key->time);
+      if (key->co != nullptr) {
+        PE_depth_cache_hash_bytes(&hash, key->co, sizeof(float[3]));
+      }
+      if (key->vel != nullptr) {
+        PE_depth_cache_hash_bytes(&hash, key->vel, sizeof(float[3]));
+      }
+      if (key->rot != nullptr) {
+        PE_depth_cache_hash_bytes(&hash, key->rot, sizeof(float[4]));
+      }
+      if (key->time != nullptr) {
+        PE_depth_cache_hash_value(&hash, *key->time);
+      }
+      PE_depth_cache_hash_bytes(&hash, key->world_co, sizeof(key->world_co));
+      PE_depth_cache_hash_value(&hash, key->ftime);
+      PE_depth_cache_hash_value(&hash, key->length);
+      PE_depth_cache_hash_value(&hash, key->flag);
+    }
+  }
+
+  *r_hash = hash;
+  return true;
+}
+
+static bool PE_depth_cache_producer_state_capture(ParticleEditDepthCacheSession *session)
+{
+  session->producer_state.captured = false;
+  session->producer_state.scene_frame = BKE_scene_frame_get(session->scene);
+  session->producer_state.object_session_uid = session->object->id.session_uid;
+  copy_m4_m4(session->producer_state.object_to_world, session->object->object_to_world().ptr());
+  copy_m4_m4(session->producer_state.world_to_object, session->object->world_to_object().ptr());
+  if (!PE_depth_cache_edit_state_hash(session->edit, &session->producer_state.edit_state)) {
+    return false;
+  }
+  session->producer_state.captured = true;
+  return true;
+}
+
+static bool PE_depth_cache_producer_state_matches(
+    const ParticleEditDepthCacheSession *session)
+{
+  const ParticleEditDepthProducerState &state = session->producer_state;
+  if (!state.captured || BKE_scene_frame_get(session->scene) != state.scene_frame ||
+      session->object->id.session_uid != state.object_session_uid ||
+      std::memcmp(state.object_to_world,
+                  session->object->object_to_world().ptr(),
+                  sizeof(state.object_to_world)) != 0 ||
+      std::memcmp(state.world_to_object,
+                  session->object->world_to_object().ptr(),
+                  sizeof(state.world_to_object)) != 0)
+  {
+    return false;
+  }
+
+  ParticleEditDepthHash current_edit_state;
+  if (!PE_depth_cache_edit_state_hash(session->edit, &current_edit_state)) {
+    return false;
+  }
+  if (current_edit_state.low != state.edit_state.low ||
+      current_edit_state.high != state.edit_state.high)
+  {
+    return false;
+  }
+  return true;
+}
