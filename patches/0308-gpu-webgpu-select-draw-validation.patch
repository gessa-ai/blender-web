 #endif
 }

@@ -238,6 +243,24 @@ eGPUReadbackStatus GPU_select_async_status()
     return GPU_READBACK_FAILED;
   }
 #ifdef __EMSCRIPTEN__
+  /* Encoding a selection draw is not its terminal browser verdict. Keep the mapped clear/result
+   * private until every command scope from this attempt settles, then discard it if any one of
+   * those scopes rejected after readback submission began. The rejecting completion publishes
+   * the redraw edge, so an exact retry is immediately eligible once the pending count reaches 0. */
+  if (ghost_web::selection_draw_validation_pending() != 0) {
+    return GPU_READBACK_PENDING;
+  }
+  if (g_async.readback != nullptr &&
+      ghost_web::selection_draw_validation_failure_generation() !=
+          g_async.readback_draw_validation_failure_generation)
+  {
+    GPU_readback_cancel(g_async.readback);
+    g_async.select_id_map.clear();
+    g_async.in_front_map.clear();
+    const uint64_t retry_generation = ghost_web::redraw_retry_generation();
+    g_async.retry_generation = retry_generation > 0 ? retry_generation - 1u : 0;
+    g_async.retry_pending = true;
+  }
   if (g_async.retry_pending) {
     return ghost_web::redraw_retry_generation() <= g_async.retry_generation ?
                GPU_READBACK_PENDING :
@@ -348,6 +371,10 @@ void gpu_select_next_async_readback_begin(GPUReadback *readback,
   g_async.pending_key = gpu_select_async_key_from_state();
   g_async.select_id_map.extend(select_id_map);
   g_async.in_front_map.extend(in_front_map);
+#ifdef __EMSCRIPTEN__
+  g_async.readback_draw_validation_failure_generation =
+      g_state.draw_validation_failure_generation;
+#endif
   g_async.readback = readback;
 }

