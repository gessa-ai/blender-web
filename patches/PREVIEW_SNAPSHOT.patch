@@ -0,0 +1,429 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_buffer.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WebGPU buffer wrapper. See wgpu_buffer.hh. Usage-flag mapping mirrors the
+ * Vulkan backend's per-kind VkBufferUsageFlags (recon cited in
+ * notes/gpu-t6-t10pre-findings.md): vertex/index buffers are also STORAGE-usable
+ * (GPU-compute writes them), storage buffers are also INDIRECT.
+ */
+
+#include "wgpu_buffer.hh"
+
+#include "wgpu_readback.hh"
+
+#include <cstring>
+#include <utility>
+
+namespace blender::gpu::webgpu {
+
+Buffer::~Buffer()
+{
+  readback::forget_source(readback::SourceKind::Buffer, this);
+}
+
+Buffer::Buffer(Buffer &&other) noexcept
+    : allocation_cache_(std::move(other.allocation_cache_)),
+      pending_updates_(std::move(other.pending_updates_)),
+      transient_allocation_(std::move(other.transient_allocation_)),
+      transient_scope_status_(std::move(other.transient_scope_status_))
+{
+  other.pending_updates_ = std::make_shared<PendingBufferPayloadQueue<PendingUpdateContext>>();
+  other.transient_allocation_ = {};
+}
+
+Buffer &Buffer::operator=(Buffer &&other) noexcept
+{
+  if (this != &other) {
+    readback::forget_source(readback::SourceKind::Buffer, this);
+    allocation_cache_ = std::move(other.allocation_cache_);
+    pending_updates_ = std::move(other.pending_updates_);
+    transient_allocation_ = std::move(other.transient_allocation_);
+    transient_scope_status_ = std::move(other.transient_scope_status_);
+    other.pending_updates_ = std::make_shared<PendingBufferPayloadQueue<PendingUpdateContext>>();
+    other.transient_allocation_ = {};
+  }
+  return *this;
+}
+
+wgpu::BufferUsage usage_flags(BufferKind kind, UsageType usage, bool readable)
+{
+  wgpu::BufferUsage u = wgpu::BufferUsage::None;
+  switch (kind) {
+    case BufferKind::Vertex:
+      /* VERTEX | STORAGE (subdiv/compute writes) — vk_vertex_buffer.cc:207. */
+      u |= wgpu::BufferUsage::Vertex | wgpu::BufferUsage::Storage;
+      break;
+    case BufferKind::Index:
+      /* INDEX | STORAGE — vk_index_buffer.cc:113. */
+      u |= wgpu::BufferUsage::Index | wgpu::BufferUsage::Storage;
+      break;
+    case BufferKind::Uniform:
+      /* Blender deliberately rebinds some uniform buffers as storage buffers for GPU-side
+       * updates (for example EEVEE's extracted sunlight array). WebGPU permits the combined
+       * usage and Dawn has explicit storage-to-uniform synchronization coverage, so retain the
+       * native backend contract here instead of requiring a second backing buffer. */
+      u |= wgpu::BufferUsage::Uniform | wgpu::BufferUsage::Storage;
+      break;
+    case BufferKind::Storage:
+      /* STORAGE | INDIRECT — vk_storage_buffer.cc:82. */
+      u |= wgpu::BufferUsage::Storage | wgpu::BufferUsage::Indirect;
+      break;
+  }
+  /* CopyDst is unconditional: the Vulkan backend gives every vertex/index/storage
+   * buffer VK_BUFFER_USAGE_TRANSFER_DST_BIT regardless of GPU_USAGE_DEVICE_ONLY
+   * (vk_vertex_buffer.cc:211, vk_index_buffer.cc:115, vk_storage_buffer.cc:85). A
+   * DEVICE_ONLY buffer is still a valid copy/clear/writeBuffer destination (e.g. a
+   * device-only SSBO cleared or updated on the device) — dropping CopyDst for it made
+   * Dawn reject those writes ("usage ... doesn't include CopyDst"). Uniform buffers
+   * are always host-updated, so they need it too. */
+  u |= wgpu::BufferUsage::CopyDst;
+  (void)usage;
+  if (readable) {
+    u |= wgpu::BufferUsage::CopySrc;
+  }
+  return u;
+}
+
+bool Buffer::create_transient(const wgpu::Instance &instance,
+                              const wgpu::Device &device,
+                              OrderedQueueScheduler &scheduler,
+                              BufferKind kind,
+                              UsageType usage,
+                              size_t size,
+                              const void *initial_data,
+                              bool readable,
+                              const char *label)
+{
+  wgpu::Limits limits = {};
+  size_t allocated_size;
+  if (instance == nullptr || device == nullptr || !device.GetLimits(&limits) ||
+      !buffer_allocation_size(size, limits.maxBufferSize, allocated_size))
+  {
+    return false;
+  }
+
+  transient_scope_status_ = std::make_shared<std::atomic<int8_t>>(0);
+  const std::shared_ptr<std::atomic<int8_t>> scope_status = transient_scope_status_;
+  transient_allocation_ = transient_resource_create_scoped(
+      instance,
+      device,
+      scheduler,
+      label ? label : "transient buffer creation",
+      [&]() {
+        wgpu::BufferDescriptor descriptor = {};
+        if (label != nullptr) {
+          descriptor.label = label;
+        }
+        descriptor.size = allocated_size;
+        descriptor.usage = usage_flags(kind, usage, readable);
+        descriptor.mappedAtCreation = (initial_data != nullptr);
+
+        Allocation candidate;
+        candidate.handle = device.CreateBuffer(&descriptor);
+        if (candidate.handle == nullptr) {
+          return Allocation{};
+        }
+        if (initial_data != nullptr) {
+          void *mapped = candidate.handle.GetMappedRange(0, allocated_size);
+          if (mapped == nullptr) {
+            return Allocation{};
+          }
+          std::memcpy(mapped, initial_data, size);
+          candidate.handle.Unmap();
+        }
+        candidate.size = allocated_size;
+        candidate.requested = size;
+        candidate.kind = kind;
+        candidate.readable = readable;
+        return candidate;
+      },
+      [scope_status](const bool valid) {
+        scope_status->store(valid ? int8_t(1) : int8_t(-1), std::memory_order_release);
+      });
+  return transient_allocation_ != nullptr &&
+         scope_status->load(std::memory_order_acquire) >= 0;
+}
+
+bool Buffer::create_scoped(const wgpu::Instance &instance,
+                           const wgpu::Device &device,
+                           BufferKind kind,
+                           UsageType usage,
+                           size_t size,
+                           const void *initial_data,
+                           bool readable,
+                           const char *label)
+{
+  wgpu::Limits limits = {};
+  size_t allocated_size;
+  if (instance == nullptr || device == nullptr || !device.GetLimits(&limits) ||
+      !buffer_allocation_size(size, limits.maxBufferSize, allocated_size))
+  {
+    return false;
+  }
+  if (!pending_updates_->begin(allocated_size)) {
+    return false;
+  }
+
+  const Allocation allocation = allocation_cache_.get_or_create(
+      instance, device, kAllocationKey, label ? label : "buffer creation", [&]() {
+        wgpu::BufferDescriptor descriptor = {};
+        if (label != nullptr) {
+          descriptor.label = label;
+        }
+        descriptor.size = allocated_size;
+        descriptor.usage = usage_flags(kind, usage, readable);
+        descriptor.mappedAtCreation = (initial_data != nullptr);
+
+        Allocation candidate;
+        candidate.handle = device.CreateBuffer(&descriptor);
+        if (candidate.handle == nullptr) {
+          return Allocation{};
+        }
+        if (initial_data != nullptr) {
+          void *mapped = candidate.handle.GetMappedRange(0, allocated_size);
+          if (mapped == nullptr) {
+            return Allocation{};
+          }
+          std::memcpy(mapped, initial_data, size);
+          candidate.handle.Unmap();
+        }
+        candidate.size = allocated_size;
+        candidate.requested = size;
+        candidate.kind = kind;
+        candidate.readable = readable;
+        return candidate;
+      },
+      [pending_updates = pending_updates_](const Allocation accepted) {
+        if (accepted == nullptr) {
+          return;
+        }
+        pending_updates->replay(
+            accepted.size,
+            [accepted](const PendingUpdateContext &context,
+                       const size_t offset,
+                       const void *data,
+                       const size_t size,
+                       std::function<void(bool)> complete) {
+              return Buffer::update_allocation(
+                  context, accepted, offset, data, size, std::move(complete));
+            });
+      });
+  return allocation != nullptr;
+}
+
+bool Buffer::update_allocation(PendingUpdateContext context,
+                               const Allocation &allocation,
+                               const size_t offset,
+                               const void *data,
+                               const size_t size,
+                               std::function<void(bool)> complete)
+{
+  if (allocation == nullptr || data == nullptr) {
+    return false;
+  }
+  if ((offset % kCopyAlignment) != 0 || (size % kCopyAlignment) != 0) {
+    return false; /* WebGPU copies require 4-byte alignment */
+  }
+  if (!range_fits(offset, size, allocation.size)) {
+    return false;
+  }
+
+  if (size <= kWriteBufferStagingThreshold) {
+    /* Direct path — analog of Blender's inline vkCmdUpdateBuffer (<=64 KiB). */
+    queue_write_buffer_scoped(context.instance,
+                              context.device,
+                              context.queue,
+                              context.scheduler,
+                              allocation.handle,
+                              offset,
+                              data,
+                              size,
+                              "buffer sub-update",
+                              std::move(complete));
+    return true;
+  }
+
+  /* Large path — dedicated staging buffer + CopyBufferToBuffer (the vk staging
+   * path for device-local buffers). */
+  wgpu::BufferDescriptor sd = {};
+  sd.size = size;
+  sd.usage = wgpu::BufferUsage::CopySrc;
+  sd.mappedAtCreation = true;
+  wgpu::Buffer staging = transient_resource_create_scoped(
+      context.instance,
+      context.device,
+      context.scheduler,
+      "staged buffer creation",
+      [&]() { return context.device.CreateBuffer(&sd); },
+      [](const bool /*valid*/) {});
+  if (staging == nullptr) {
+    return false;
+  }
+  void *mapped = staging.GetMappedRange(0, size);
+  if (mapped == nullptr) {
+    return false;
+  }
+  std::memcpy(mapped, data, size);
+  staging.Unmap();
+  command_encode_submit_scoped(context.instance,
+                               context.device,
+                               context.queue,
+                               context.scheduler,
+                               "staged buffer sub-update",
+                               [&](auto &encoder) {
+                                 encoder.CopyBufferToBuffer(
+                                     staging, 0, allocation.handle, offset, size);
+                               },
+                               std::move(complete));
+  return true;
+}
+
+bool Buffer::update_sub(const wgpu::Instance &instance,
+                        const wgpu::Device &device,
+                        const wgpu::Queue &queue,
+                        OrderedQueueScheduler &scheduler,
+                        size_t offset,
+                        const void *data,
+                        size_t size)
+{
+  BufferUpdateTransaction transaction;
+  return update_sub(instance, device, queue, scheduler, offset, data, size, transaction);
+}
+
+bool Buffer::update_sub(const wgpu::Instance &instance,
+                        const wgpu::Device &device,
+                        const wgpu::Queue &queue,
+                        OrderedQueueScheduler &scheduler,
+                        size_t offset,
+                        const void *data,
+                        size_t size,
+                        BufferUpdateTransaction &transaction)
+{
+  transaction.reset();
+  if (data == nullptr || (offset % kCopyAlignment) != 0 ||
+      (size % kCopyAlignment) != 0)
+  {
+    return false;
+  }
+
+  const Allocation allocation = allocation_cache_.lookup(kAllocationKey);
+  PendingUpdateContext context{instance, device, queue, scheduler};
+  if (allocation != nullptr && !pending_updates_->begin(allocation.size)) {
+    return false;
+  }
+  if (!pending_updates_->retain(std::move(context), offset, data, size, &transaction)) {
+    return false;
+  }
+  if (allocation != nullptr) {
+    retry_pending_updates();
+  }
+  return transaction.accepted();
+}
+
+size_t Buffer::retry_pending_updates()
+{
+  const Allocation allocation = allocation_cache_.lookup(kAllocationKey);
+  if (allocation == nullptr) {
+    return 0;
+  }
+  return pending_updates_->replay(
+      allocation.size,
+      [allocation](const PendingUpdateContext &context,
+                   const size_t offset,
+                   const void *data,
+                   const size_t size,
+                   std::function<void(bool)> complete) {
+        return Buffer::update_allocation(
+            context, allocation, offset, data, size, std::move(complete));
+      });
+}
+
+std::vector<uint8_t> Buffer::read(const wgpu::Instance &instance,
+                                  const wgpu::Device &device,
+                                  const wgpu::Queue &queue,
+                                  OrderedQueueScheduler &scheduler,
+                                  size_t offset,
+                                  size_t size) const
+{
+  std::vector<uint8_t> out;
+  const Allocation allocation = allocation_cache_.lookup(kAllocationKey);
+  if (allocation == nullptr || !allocation.readable || size == 0) {
+    return out;
+  }
+  size_t copy;
+  if (!checked_align_up(size, kCopyAlignment, copy) ||
+      !buffer_copy_range_valid(offset, 0, copy, allocation.size, copy))
+  {
+    return out;
+  }
+#ifdef __EMSCRIPTEN__
+  /* Windowed WM-worker profile (ADR-006/007): the blocking WaitAny below cannot resolve a
+   * map future here and is compiled out. Route through the production kick/latch/settle
+   * registry (wgpu_readback): return the latched bytes when a prior kick for THIS buffer
+   * region has settled (the C1 object-pick StorageBuffer path), else kick a HEAP-OWNED
+   * readback and return empty (the conservative first-call interim, matching today's
+   * "unmapped -> empty" behaviour that leaves the caller's destination zeroed). Keyed by
+   * this stable wrapper identity; the pending record separately pins the WebGPU handle.
+   * Closes the stale-stack `[&]` callback hazard on this seam too. */
+  {
+    const readback::SourceKey key{
+        readback::SourceKind::Buffer, this, uint64_t(offset), uint64_t(size)};
+    out.resize(size);
+    const bool hit = readback::take_settled(key, out.data(), size);
+    readback::kick_buffer(
+        instance, device, queue, scheduler, allocation.handle, key, offset, copy, size);
+    if (!hit) {
+      out.clear();
+    }
+    (void)instance;
+    return out;
+  }
+#else
+  wgpu::BufferDescriptor sd = {};
+  sd.size = copy;
+  sd.usage = wgpu::BufferUsage::MapRead | wgpu::BufferUsage::CopyDst;
+  wgpu::Buffer staging = device.CreateBuffer(&sd);
+  if (staging == nullptr) {
+    return out;
+  }
+  bool submitted = false;
+  command_encode_submit_scoped(instance,
+                               device,
+                               queue,
+                               scheduler,
+                               "synchronous buffer readback",
+                               [&](auto &encoder) {
+                                 encoder.CopyBufferToBuffer(
+                                     allocation.handle, offset, staging, 0, copy);
+                               },
+                               [&](const bool valid) { submitted = valid; });
+  if (!submitted) {
+    return out;
+  }
+
+  bool ok = false;
+  wgpu::Future f = staging.MapAsync(
+      wgpu::MapMode::Read, 0, copy, wgpu::CallbackMode::WaitAnyOnly,
+      [&](wgpu::MapAsyncStatus s, wgpu::StringView) {
+        ok = (s == wgpu::MapAsyncStatus::Success);
+      });
+  instance.WaitAny(f, UINT64_MAX);
+  if (ok) {
+    const uint8_t *p = static_cast<const uint8_t *>(staging.GetConstMappedRange(0, copy));
+    if (p != nullptr) {
+      out.assign(p, p + size);
+    }
+    staging.Unmap();
+  }
+  return out;
+#endif /* __EMSCRIPTEN__ */
+}
+
+}  // namespace blender::gpu::webgpu
