+static void test_texture_readback_owned_result()
+{
+  GPU_render_begin();
+
+  constexpr int width = 2;
+  constexpr int height = 2;
+  const float4 expected(0.25f, 0.5f, 0.75f, 1.0f);
+  Texture *texture = GPU_texture_create_2d("owned-readback",
+                                           width,
+                                           height,
+                                           1,
+                                           TextureFormat::SFLOAT_16_16_16_16,
+                                           GPU_TEXTURE_USAGE_ATTACHMENT |
+                                               GPU_TEXTURE_USAGE_HOST_READ,
+                                           nullptr);
+  ASSERT_NE(texture, nullptr);
+  GPU_texture_clear(texture, GPU_DATA_FLOAT, expected);
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+
+  GPUReadback *readback = GPU_texture_read_async(texture, GPU_DATA_FLOAT, 0);
+  ASSERT_NE(readback, nullptr);
+#ifdef __EMSCRIPTEN__
+  /* The browser backend must return to the JavaScript event loop before the
+   * exact-ticket map callback can publish bytes. This synchronous GPU test
+   * therefore verifies the Pending/source-lifetime/cancel contract; the
+   * Pending-to-Ready conversion is covered by the browser continuation probe. */
+  EXPECT_EQ(GPU_readback_status(readback), GPU_READBACK_PENDING);
+  EXPECT_EQ(GPU_readback_error(readback), GPU_READBACK_ERROR_NONE);
+  EXPECT_EQ(GPU_readback_size(readback), size_t(width * height * sizeof(float4)));
+  GPU_texture_free(texture);
+  float4 pending_dst[width * height] = {};
+  EXPECT_FALSE(GPU_readback_consume(readback, pending_dst, sizeof(pending_dst)));
+  EXPECT_NE(readback, nullptr);
+  GPU_readback_cancel(readback);
+  EXPECT_EQ(readback, nullptr);
+#else
+  EXPECT_EQ(GPU_readback_status(readback), GPU_READBACK_READY);
+  EXPECT_EQ(GPU_readback_error(readback), GPU_READBACK_ERROR_NONE);
+  EXPECT_EQ(GPU_readback_size(readback), size_t(width * height * sizeof(float4)));
+
+  /* The result owns its bytes and must outlive the source wrapper. */
+  GPU_texture_free(texture);
+
+  float4 actual[width * height] = {};
+  EXPECT_FALSE(GPU_readback_consume(readback, actual, sizeof(actual) - 1));
+  EXPECT_NE(readback, nullptr);
+  EXPECT_TRUE(GPU_readback_consume(readback, actual, sizeof(actual)));
+  EXPECT_EQ(readback, nullptr);
+  for (const float4 &value : actual) {
+    EXPECT_EQ(value, expected);
+  }
+#endif
+
+  GPUReadback *canceled = GPU_texture_read_async(nullptr, GPU_DATA_FLOAT, 0);
+  EXPECT_EQ(GPU_readback_status(canceled), GPU_READBACK_FAILED);
+  EXPECT_EQ(GPU_readback_error(canceled), GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  EXPECT_EQ(GPU_readback_size(canceled), 0u);
+  GPU_readback_cancel(canceled);
+  EXPECT_EQ(canceled, nullptr);
+
+  GPU_render_end();
+}
+GPU_TEST(texture_readback_owned_result)
