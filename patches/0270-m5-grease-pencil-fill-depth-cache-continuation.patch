+static wmOperatorStatus grease_pencil_fill_depth_cache_poll(bContext &C,
+                                                             wmOperator &op,
+                                                             const wmEvent &event)
+{
+  auto &op_data = *static_cast<GreasePencilFillOpData *>(op.customdata);
+  if (!op_data.depth_cache_pending ||
+      !grease_pencil_fill_depth_cache_context_matches(C, op_data))
+  {
+    BKE_report(
+        op.reports, RPT_ERROR, "Viewport changed while waiting for Grease Pencil fill depth");
+    return OPERATOR_CANCELLED;
+  }
+
+  if (ELEM(event.type, EVT_ESCKEY, RIGHTMOUSE) ||
+      (event.type == EVT_MODAL_MAP && event.val == int(FillToolModalKey::Cancel)))
+  {
+    return OPERATOR_CANCELLED;
+  }
+  if (event.type != TIMER || event.customdata != op_data.depth_cache_timer) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++op_data.depth_cache_tick_count > max_tick_count) {
+    BKE_report(op.reports, RPT_ERROR, "Timed out waiting for Grease Pencil fill depth");
+    return OPERATOR_CANCELLED;
+  }
+
+  const ed::greasepencil::DrawingPlacementDepthCacheState state =
+      op_data.depth_cache_placement->poll_viewport_depths(op_data.depth_cache_region);
+  if (state == ed::greasepencil::DrawingPlacementDepthCacheState::Pending) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (state == ed::greasepencil::DrawingPlacementDepthCacheState::Failed) {
+    BKE_report(op.reports, RPT_ERROR, "Grease Pencil fill depth readback failed");
+    return OPERATOR_CANCELLED;
+  }
+
+  op_data.depth_cache_pending = false;
+  grease_pencil_fill_depth_cache_timer_remove(op_data);
+  const wmEvent retained_event = *op_data.depth_cache_event;
+  op_data.depth_cache_event.reset();
+  const bool applied = grease_pencil_apply_fill(
+      C, op, retained_event, *op_data.depth_cache_placement);
+  op_data.depth_cache_placement.reset();
+  return applied ? OPERATOR_FINISHED : OPERATOR_CANCELLED;
+}
