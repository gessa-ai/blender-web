+/** Copy one complete caller-owned payload into a mapped-at-creation buffer. Mapping can fail
+ * even when WebGPU returns a non-null error buffer; reject that state before touching memory or
+ * unmapping. Templated so the device-free contract can exercise the exact state transition. */
+template<typename BufferT>
+inline bool mapped_buffer_write(BufferT &buffer, const void *data, size_t size)
+{
+  if (data == nullptr || size == 0) {
+    return false;
+  }
+  void *mapped = buffer.GetMappedRange(0, size);
+  if (mapped == nullptr) {
+    return false;
+  }
+  std::memcpy(mapped, data, size);
+  buffer.Unmap();
+  return true;
+}
