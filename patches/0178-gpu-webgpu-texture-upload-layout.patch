+/** Multiply two host byte counts without wrapping. Failure leaves `result` unchanged. */
+inline bool checked_size_mul(size_t a, size_t b, size_t &result)
+{
+  if (a != 0 && b > std::numeric_limits<size_t>::max() / a) {
+    return false;
+  }
+  result = a * b;
+  return true;
+}
+
+/** Add two host byte counts without wrapping. Failure leaves `result` unchanged. */
+inline bool checked_size_add(size_t a, size_t b, size_t &result)
+{
+  if (b > std::numeric_limits<size_t>::max() - a) {
+    return false;
+  }
+  result = a + b;
+  return true;
+}
+
+/** Host/device byte geometry for one uncompressed Queue::WriteTexture upload. */
+struct TextureUploadLayout {
+  size_t sample_count = 0;
+  size_t device_data_size = 0;
+  size_t source_row_stride = 0;
+  size_t source_data_size = 0;
+  uint32_t bytes_per_row = 0;
+  size_t row_count = 0;
+};
+
+/** Resolve every upload byte count before allocating or reading caller memory.
+ *
+ * `unpack_row_length` is measured in host texels. A non-zero value shorter than the copied
+ * width cannot describe the requested rows. `source_data_size` is the exact last-byte extent,
+ * excluding padding after the last row. WebGPU exposes bytesPerRow as uint32_t, while all host
+ * products must also fit size_t (notably wasm32). Failure is atomic. */
+inline bool texture_upload_layout(uint32_t width,
+                                  uint32_t height,
+                                  uint32_t depth,
+                                  uint32_t device_texel_bytes,
+                                  size_t host_texel_bytes,
+                                  uint32_t unpack_row_length,
+                                  TextureUploadLayout &result)
+{
+  if (width == 0 || height == 0 || depth == 0 || device_texel_bytes == 0 ||
+      host_texel_bytes == 0 || (unpack_row_length != 0 && unpack_row_length < width))
+  {
+    return false;
+  }
+
+  TextureUploadLayout candidate;
+  if (!checked_size_mul(size_t(height), size_t(depth), candidate.row_count) ||
+      !checked_size_mul(size_t(width), candidate.row_count, candidate.sample_count) ||
+      !checked_size_mul(
+          candidate.sample_count, size_t(device_texel_bytes), candidate.device_data_size))
+  {
+    return false;
+  }
+
+  size_t device_row_size;
+  if (!checked_size_mul(size_t(width), size_t(device_texel_bytes), device_row_size) ||
+      device_row_size > std::numeric_limits<uint32_t>::max())
+  {
+    return false;
+  }
+  candidate.bytes_per_row = uint32_t(device_row_size);
+
+  const size_t source_width = unpack_row_length != 0 ? size_t(unpack_row_length) : size_t(width);
+  size_t tight_source_row;
+  if (!checked_size_mul(source_width, host_texel_bytes, candidate.source_row_stride) ||
+      !checked_size_mul(size_t(width), host_texel_bytes, tight_source_row))
+  {
+    return false;
+  }
+  size_t last_row_offset;
+  if (!checked_size_mul(candidate.row_count - 1, candidate.source_row_stride, last_row_offset) ||
+      !checked_size_add(last_row_offset, tight_source_row, candidate.source_data_size))
+  {
+    return false;
+  }
+
+  result = candidate;
+  return true;
+}
