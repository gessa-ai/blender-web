+#ifdef WITH_WEBGPU_BACKEND
+
+static bool wait_for_readback_tickets(WGPUContext &context,
+                                      std::initializer_list<webgpu::readback::Ticket> tickets,
+                                      int pending_baseline)
+{
+  for (int attempt = 0; attempt < 1000; attempt++) {
+    bool terminal = true;
+    for (const webgpu::readback::Ticket ticket : tickets) {
+      terminal = terminal &&
+                 webgpu::readback::ticket_status(ticket) !=
+                     webgpu::readback::TicketStatus::Pending;
+    }
+    if (terminal && webgpu::readback::pending_count() == pending_baseline) {
+      return true;
+    }
+    context.instance_get().ProcessEvents();
+    std::this_thread::sleep_for(std::chrono::milliseconds(2));
+  }
+  return false;
+}
+
+static void expect_invalid_ticket(webgpu::readback::Ticket ticket)
+{
+  ASSERT_NE(ticket, webgpu::readback::kInvalidTicket);
+  EXPECT_EQ(webgpu::readback::ticket_status(ticket),
+            webgpu::readback::TicketStatus::Failed);
+  EXPECT_EQ(webgpu::readback::ticket_error(ticket),
+            webgpu::readback::TicketError::InvalidArgument);
+  webgpu::readback::free_ticket(ticket);
+}
+
+static void test_webgpu_readback_ticket_hardening()
+{
+  WGPUContext *context = static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
+  ASSERT_NE(context, nullptr);
+  const wgpu::Device device = context->device_get();
+  const wgpu::Queue queue = context->queue_get();
+  const int pending_baseline = webgpu::readback::pending_count();
+
+  /* Canceled Cache work must neither be reused nor emit a capture. */
+  const char *capture_path = "/tmp/bw_prod_readback_0.bin";
+  ::unlink(capture_path);
+  ASSERT_EQ(::setenv("BW_READBACK_CAPTURE", "1", 1), 0);
+  {
+    const uint32_t value = 0x01020304u;
+    webgpu::Buffer cache_source;
+    ASSERT_TRUE(cache_source.create(device,
+                                    webgpu::BufferKind::Storage,
+                                    webgpu::UsageType::Dynamic,
+                                    sizeof(value),
+                                    &value,
+                                    true));
+    const webgpu::readback::SourceKey key{
+        webgpu::readback::SourceKind::Buffer, &cache_source, 0, sizeof(value)};
+    const webgpu::readback::Ticket canceled = webgpu::readback::kick_buffer(
+        device,
+        queue,
+        cache_source.handle(),
+        key,
+        0,
+        sizeof(value),
+        sizeof(value),
+        webgpu::readback::RequestMode::Cache);
+    ASSERT_NE(canceled, webgpu::readback::kInvalidTicket);
+    EXPECT_TRUE(webgpu::readback::cancel_ticket(canceled));
+
+    const webgpu::readback::Ticket replacement = webgpu::readback::kick_buffer(
+        device,
+        queue,
+        cache_source.handle(),
+        key,
+        0,
+        sizeof(value),
+        sizeof(value),
+        webgpu::readback::RequestMode::Cache);
+    ASSERT_NE(replacement, webgpu::readback::kInvalidTicket);
+    EXPECT_NE(replacement, canceled);
+    EXPECT_TRUE(webgpu::readback::cancel_ticket(replacement));
+    ASSERT_TRUE(
+        wait_for_readback_tickets(*context, {canceled, replacement}, pending_baseline));
+    EXPECT_EQ(::access(capture_path, F_OK), -1);
+  }
+  ASSERT_EQ(::unsetenv("BW_READBACK_CAPTURE"), 0);
+
+  /* Ready Cache cancel/free must also retire the source-keyed settled payload. */
+  {
+    const uint32_t values[2] = {0x11121314u, 0x21222324u};
+    webgpu::Buffer cache_source;
+    ASSERT_TRUE(cache_source.create(device,
+                                    webgpu::BufferKind::Storage,
+                                    webgpu::UsageType::Dynamic,
+                                    sizeof(values),
+                                    values,
+                                    true));
+    const webgpu::readback::SourceKey cancel_key{
+        webgpu::readback::SourceKind::Buffer, &cache_source, 0, sizeof(uint32_t)};
+    const webgpu::readback::Ticket ready_cancel = webgpu::readback::kick_buffer(
+        device,
+        queue,
+        cache_source.handle(),
+        cancel_key,
+        0,
+        sizeof(uint32_t),
+        sizeof(uint32_t),
+        webgpu::readback::RequestMode::Cache);
+    ASSERT_TRUE(wait_for_readback_tickets(*context, {ready_cancel}, pending_baseline));
+    uint32_t actual = 0;
+    ASSERT_TRUE(webgpu::readback::take_settled(cancel_key, &actual, sizeof(actual)));
+    EXPECT_EQ(actual, values[0]);
+    EXPECT_TRUE(webgpu::readback::cancel_ticket(ready_cancel));
+    EXPECT_FALSE(webgpu::readback::take_settled(cancel_key, &actual, sizeof(actual)));
+
+    const webgpu::readback::SourceKey free_key{
+        webgpu::readback::SourceKind::Buffer, &cache_source, 4, sizeof(uint32_t)};
+    const webgpu::readback::Ticket ready_free = webgpu::readback::kick_buffer(
+        device,
+        queue,
+        cache_source.handle(),
+        free_key,
+        4,
+        sizeof(uint32_t),
+        sizeof(uint32_t),
+        webgpu::readback::RequestMode::Cache);
+    ASSERT_TRUE(wait_for_readback_tickets(*context, {ready_free}, pending_baseline));
+    ASSERT_TRUE(webgpu::readback::take_settled(free_key, &actual, sizeof(actual)));
+    EXPECT_EQ(actual, values[1]);
+    webgpu::readback::free_ticket(ready_free);
+    EXPECT_FALSE(webgpu::readback::take_settled(free_key, &actual, sizeof(actual)));
+  }
+
+  /* The temporary 24-byte budget makes the second 16-byte payload evict the first. */
+  {
+    uint32_t values[8];
+    for (uint32_t i = 0; i < 8; i++) {
+      values[i] = 0xa0000000u + i;
+    }
+    webgpu::Buffer budget_source;
+    ASSERT_TRUE(budget_source.create(device,
+                                     webgpu::BufferKind::Storage,
+                                     webgpu::UsageType::Dynamic,
+                                     sizeof(values),
+                                     values,
+                                     true));
+    const webgpu::readback::SourceKey key_a{
+        webgpu::readback::SourceKind::Buffer, &budget_source, 0, 16};
+    const webgpu::readback::SourceKey key_b{
+        webgpu::readback::SourceKind::Buffer, &budget_source, 16, 16};
+    const webgpu::readback::Ticket cache_a = webgpu::readback::kick_buffer(
+        device,
+        queue,
+        budget_source.handle(),
+        key_a,
+        0,
+        16,
+        16,
+        webgpu::readback::RequestMode::Cache);
+    ASSERT_TRUE(wait_for_readback_tickets(*context, {cache_a}, pending_baseline));
+    uint32_t actual[4] = {};
+    ASSERT_TRUE(webgpu::readback::take_settled(key_a, actual, sizeof(actual)));
+    EXPECT_EQ(std::memcmp(actual, values, sizeof(actual)), 0);
+
+    const webgpu::readback::Ticket cache_b = webgpu::readback::kick_buffer(
+        device,
+        queue,
+        budget_source.handle(),
+        key_b,
+        16,
+        16,
+        16,
+        webgpu::readback::RequestMode::Cache);
+    ASSERT_TRUE(wait_for_readback_tickets(*context, {cache_b}, pending_baseline));
+    EXPECT_FALSE(webgpu::readback::take_settled(key_a, actual, sizeof(actual)));
+    ASSERT_TRUE(webgpu::readback::take_settled(key_b, actual, sizeof(actual)));
+    EXPECT_EQ(std::memcmp(actual, values + 4, sizeof(actual)), 0);
+  }
+
+  /* Exact snapshots remain distinct across a queued source mutation. */
+  wgpu::BufferDescriptor descriptor = {};
+  descriptor.size = sizeof(uint32_t);
+  descriptor.usage = wgpu::BufferUsage::CopySrc | wgpu::BufferUsage::CopyDst;
+  descriptor.mappedAtCreation = true;
+  wgpu::Buffer source = device.CreateBuffer(&descriptor);
+  ASSERT_NE(source, nullptr);
+  const uint32_t value_a = 0x11223344u;
+  const uint32_t value_b = 0xa1b2c3d4u;
+  std::memcpy(source.GetMappedRange(), &value_a, sizeof(value_a));
+  source.Unmap();
+  const webgpu::readback::SourceKey key{
+      webgpu::readback::SourceKind::Buffer, &source, 0, sizeof(uint32_t)};
+  const webgpu::readback::Ticket ticket_a = webgpu::readback::kick_buffer(
+      device,
+      queue,
+      source,
+      key,
+      0,
+      sizeof(uint32_t),
+      sizeof(uint32_t),
+      webgpu::readback::RequestMode::Exact);
+  queue.WriteBuffer(source, 0, &value_b, sizeof(value_b));
+  const webgpu::readback::Ticket ticket_b = webgpu::readback::kick_buffer(
+      device,
+      queue,
+      source,
+      key,
+      0,
+      sizeof(uint32_t),
+      sizeof(uint32_t),
+      webgpu::readback::RequestMode::Exact);
+  ASSERT_NE(ticket_a, ticket_b);
+  ASSERT_TRUE(wait_for_readback_tickets(*context, {ticket_a, ticket_b}, pending_baseline));
+  uint32_t actual_a = 0;
+  uint32_t actual_b = 0;
+  EXPECT_EQ(webgpu::readback::consume_ticket(ticket_a, &actual_a, sizeof(actual_a)),
+            sizeof(actual_a));
+  EXPECT_EQ(webgpu::readback::consume_ticket(ticket_b, &actual_b, sizeof(actual_b)),
+            sizeof(actual_b));
+  EXPECT_EQ(actual_a, value_a);
+  EXPECT_EQ(actual_b, value_b);
+  EXPECT_EQ(webgpu::readback::consume_ticket(ticket_a, &actual_a, sizeof(actual_a)), 0u);
+
+  /* Invalid direct copies must become terminal failures before Dawn submission. */
+  wgpu::BufferDescriptor no_copy_buffer_desc = {};
+  no_copy_buffer_desc.size = 4;
+  no_copy_buffer_desc.usage = wgpu::BufferUsage::CopyDst;
+  wgpu::Buffer no_copy_buffer = device.CreateBuffer(&no_copy_buffer_desc);
+  expect_invalid_ticket(webgpu::readback::kick_buffer(device,
+                                                       queue,
+                                                       no_copy_buffer,
+                                                       key,
+                                                       0,
+                                                       4,
+                                                       4,
+                                                       webgpu::readback::RequestMode::Exact));
+
+  wgpu::BufferDescriptor mapped_buffer_desc = {};
+  mapped_buffer_desc.size = 4;
+  mapped_buffer_desc.usage = wgpu::BufferUsage::CopySrc;
+  mapped_buffer_desc.mappedAtCreation = true;
+  wgpu::Buffer mapped_buffer = device.CreateBuffer(&mapped_buffer_desc);
+  ASSERT_NE(mapped_buffer, nullptr);
+  expect_invalid_ticket(webgpu::readback::kick_buffer(device,
+                                                       queue,
+                                                       mapped_buffer,
+                                                       key,
+                                                       0,
+                                                       4,
+                                                       4,
+                                                       webgpu::readback::RequestMode::Exact));
+  mapped_buffer.Unmap();
+
+  wgpu::TextureDescriptor no_copy_texture_desc = {};
+  no_copy_texture_desc.size = {2, 2, 1};
+  no_copy_texture_desc.mipLevelCount = 1;
+  no_copy_texture_desc.sampleCount = 1;
+  no_copy_texture_desc.dimension = wgpu::TextureDimension::e2D;
+  no_copy_texture_desc.format = wgpu::TextureFormat::RGBA8Unorm;
+  no_copy_texture_desc.usage = wgpu::TextureUsage::CopyDst;
+  wgpu::Texture no_copy_texture = device.CreateTexture(&no_copy_texture_desc);
+  const webgpu::readback::TextureRegion rgba_region{
+      0, 0, 0, 0, 2, 2, 1, wgpu::TextureAspect::All};
+  const webgpu::readback::SourceKey texture_key{
+      webgpu::readback::SourceKind::Texture, &no_copy_texture, 0, 16};
+  expect_invalid_ticket(webgpu::readback::kick_texture(device,
+                                                        queue,
+                                                        no_copy_texture,
+                                                        texture_key,
+                                                        rgba_region,
+                                                        4,
+                                                        256,
+                                                        8,
+                                                        webgpu::readback::RequestMode::Exact));
+
+  wgpu::TextureDescriptor multisample_desc = no_copy_texture_desc;
+  multisample_desc.sampleCount = 4;
+  multisample_desc.usage = wgpu::TextureUsage::RenderAttachment |
+                           wgpu::TextureUsage::CopySrc;
+  wgpu::Texture multisample_texture = device.CreateTexture(&multisample_desc);
+  ASSERT_NE(multisample_texture, nullptr);
+  EXPECT_NE(multisample_texture.GetUsage() & wgpu::TextureUsage::CopySrc,
+            wgpu::TextureUsage::None);
+  expect_invalid_ticket(webgpu::readback::kick_texture(device,
+                                                        queue,
+                                                        multisample_texture,
+                                                        texture_key,
+                                                        rgba_region,
+                                                        4,
+                                                        256,
+                                                        8,
+                                                        webgpu::readback::RequestMode::Exact));
+
+  no_copy_texture_desc.usage = wgpu::TextureUsage::CopySrc | wgpu::TextureUsage::CopyDst;
+  wgpu::Texture rgba_texture = device.CreateTexture(&no_copy_texture_desc);
+  expect_invalid_ticket(webgpu::readback::kick_texture(device,
+                                                        queue,
+                                                        rgba_texture,
+                                                        texture_key,
+                                                        rgba_region,
+                                                        1,
+                                                        256,
+                                                        2,
+                                                        webgpu::readback::RequestMode::Exact));
+  webgpu::readback::TextureRegion out_of_bounds = rgba_region;
+  out_of_bounds.origin_x = 1;
+  expect_invalid_ticket(webgpu::readback::kick_texture(device,
+                                                        queue,
+                                                        rgba_texture,
+                                                        texture_key,
+                                                        out_of_bounds,
+                                                        4,
+                                                        256,
+                                                        8,
+                                                        webgpu::readback::RequestMode::Exact));
+  webgpu::readback::TextureRegion bad_aspect = rgba_region;
+  bad_aspect.aspect = wgpu::TextureAspect::DepthOnly;
+  expect_invalid_ticket(webgpu::readback::kick_texture(device,
+                                                        queue,
+                                                        rgba_texture,
+                                                        texture_key,
+                                                        bad_aspect,
+                                                        4,
+                                                        256,
+                                                        8,
+                                                        webgpu::readback::RequestMode::Exact));
+
+  wgpu::TextureDescriptor opaque_depth_desc = no_copy_texture_desc;
+  opaque_depth_desc.format = wgpu::TextureFormat::Depth24Plus;
+  opaque_depth_desc.usage = wgpu::TextureUsage::CopySrc |
+                            wgpu::TextureUsage::RenderAttachment;
+  wgpu::Texture opaque_depth = device.CreateTexture(&opaque_depth_desc);
+  const webgpu::readback::TextureRegion depth_region{
+      0, 0, 0, 0, 2, 2, 1, wgpu::TextureAspect::DepthOnly};
+  expect_invalid_ticket(webgpu::readback::kick_texture(device,
+                                                        queue,
+                                                        opaque_depth,
+                                                        texture_key,
+                                                        depth_region,
+                                                        4,
+                                                        256,
+                                                        8,
+                                                        webgpu::readback::RequestMode::Exact));
+}
+GPU_WEBGPU_TEST(webgpu_readback_ticket_hardening);
