--- a/source/blender/gpu/webgpu/wgpu_context.cc
+++ b/source/blender/gpu/webgpu/wgpu_context.cc
@@ -470,6 +470,15 @@ wgpu::BindGroup WGPUContext::create_bind_group_checked(
   return device_.CreateBindGroup(&bgd);
 }
 
+void WGPUContext::apply_stencil_reference(const wgpu::RenderPassEncoder &pass) const
+{
+  /* Mirror vk_context.cc: the reference is dynamic state only when a stencil test is bound.
+   * The frontend records it via GPU_stencil_reference_set -> mutable_state.stencil_reference. */
+  if (state_manager != nullptr && state_manager->state.stencil_test != GPU_STENCIL_NONE) {
+    pass.SetStencilReference(state_manager->mutable_state.stencil_reference);
+  }
+}
