+/** Encode one short-lived pass and submit it only after every fallible command handle succeeds.
+ * The pass body is not called after a failed encoder/pass, and a failed finished command buffer
+ * is never submitted. Templated so the complete transaction remains device-free testable. */
+template<typename DeviceT, typename QueueT, typename BeginPassFn, typename EncodeFn>
+inline bool command_pass_encode_submit_if_valid(const DeviceT &device,
+                                                const QueueT &queue,
+                                                BeginPassFn &&begin_pass,
+                                                EncodeFn &&encode)
+{
+  auto encoder = device.CreateCommandEncoder();
+  if (encoder == nullptr) {
+    return false;
+  }
+  auto pass = std::forward<BeginPassFn>(begin_pass)(encoder);
+  if (pass == nullptr) {
+    return false;
+  }
+  std::forward<EncodeFn>(encode)(pass);
+  pass.End();
+  auto command_buffer = encoder.Finish();
+  if (command_buffer == nullptr) {
+    return false;
+  }
+  queue.Submit(1, &command_buffer);
+  return true;
+}
