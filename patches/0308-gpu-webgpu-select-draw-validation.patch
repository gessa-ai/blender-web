+  uint64_t draw_validation_failure_generation = 0;
 #endif
 };

@@ -73,6 +75,7 @@ struct GPUSelectAsyncState {
   /** A dropped attempt has no valid result; wait for a later resource-readiness edge. */
   bool retry_pending = false;
   uint64_t retry_generation = 0;
