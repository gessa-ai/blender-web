+/** Compare the unique group-0 bindings assembled from live resources with the shader's exact
+ * sorted surviving WGSL binding set. An empty assembled set is valid only for a genuinely empty
+ * shader layout; missing, partial, and extra resource sets fail before command encoding begins. */
+inline bool bind_group_binding_ids_complete(const std::vector<uint32_t> &expected_bindings,
+                                            std::vector<uint32_t> assembled_bindings)
+{
+  std::sort(assembled_bindings.begin(), assembled_bindings.end());
+  assembled_bindings.erase(
+      std::unique(assembled_bindings.begin(), assembled_bindings.end()),
+      assembled_bindings.end());
+  return assembled_bindings == expected_bindings;
+}
