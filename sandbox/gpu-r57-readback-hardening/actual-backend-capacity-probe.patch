diff --git a/source/blender/gpu/tests/texture_test.cc b/source/blender/gpu/tests/texture_test.cc
--- a/source/blender/gpu/tests/texture_test.cc
+++ b/source/blender/gpu/tests/texture_test.cc
@@ -1239,6 +1239,16 @@ static void expect_invalid_ticket(webgpu::readback::Ticket ticket)
   webgpu::readback::free_ticket(ticket);
 }
 
+static void expect_capacity_ticket(webgpu::readback::Ticket ticket)
+{
+  ASSERT_NE(ticket, webgpu::readback::kInvalidTicket);
+  EXPECT_EQ(webgpu::readback::ticket_status(ticket),
+            webgpu::readback::TicketStatus::Failed);
+  EXPECT_EQ(webgpu::readback::ticket_error(ticket),
+            webgpu::readback::TicketError::CapacityExceeded);
+  webgpu::readback::free_ticket(ticket);
+}
+
 static void test_webgpu_readback_ticket_hardening()
 {
   WGPUContext *context = static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
@@ -1428,6 +1438,29 @@ static void test_webgpu_readback_ticket_hardening()
   EXPECT_EQ(actual_b, value_b);
   EXPECT_EQ(webgpu::readback::consume_ticket(ticket_a, &actual_a, sizeof(actual_a)), 0u);
 
+  /* Reservation precedes staging allocation: with temporary 24-byte in-flight and exact
+   * caps, one otherwise-valid 32-byte snapshot is CapacityExceeded before CreateBuffer. */
+  {
+    constexpr uint64_t over_cap_size = 32;
+    wgpu::BufferDescriptor over_cap_desc = {};
+    over_cap_desc.size = over_cap_size;
+    over_cap_desc.usage = wgpu::BufferUsage::CopySrc;
+    wgpu::Buffer over_cap_source = device.CreateBuffer(&over_cap_desc);
+    ASSERT_NE(over_cap_source, nullptr);
+    const webgpu::readback::SourceKey over_cap_key{
+        webgpu::readback::SourceKind::Buffer, &over_cap_source, 0, over_cap_size};
+    const webgpu::readback::Ticket over_cap = webgpu::readback::kick_buffer(
+        device,
+        queue,
+        over_cap_source,
+        over_cap_key,
+        0,
+        over_cap_size,
+        over_cap_size,
+        webgpu::readback::RequestMode::Exact);
+    expect_capacity_ticket(over_cap);
+  }
+
   /* Invalid direct copies must become terminal failures before Dawn submission. */
   wgpu::BufferDescriptor no_copy_buffer_desc = {};
   no_copy_buffer_desc.size = 4;
