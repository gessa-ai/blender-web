@@ -0,0 +1,84 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * M4.T29 - WGSL translation cache (warm-boot shader latency).
+ *
+ * The web build runs the M3 shader chain (shaderc GLSL->SPIR-V, then Tint
+ * SPIR-V->WGSL) INLINE on the WM worker for the whole first-draw shader set,
+ * because `use_main_context_workaround=true` bypasses the async ShaderCompiler
+ * worker. Measured (notes/gpu-r51-shader-latency.md, Phase 1): that CPU
+ * translation is ~86% of the ~16 s boot compile block, and shaderc alone is
+ * ~81% - a pure-CPU, device-free cost that produces the exact same WGSL every
+ * boot for an unchanged shader.
+ *
+ * This cache mirrors the intent of the Vulkan backend's shader disk cache
+ * (notes/gpu-webgpu-architecture.md D-2: "mirror the .spv+sidecar disk cache
+ * onto OPFS ... for WGSL we cache the WGSL, since the browser device consumes
+ * WGSL"). On a warm boot we read the already-translated WGSL back and hand it
+ * straight to createShaderModule, skipping shaderc+Tint entirely. The browser's
+ * own shader/pipeline caches then handle repeats at ITS layer (WebGPU exposes no
+ * pipeline-binary serialization to JS, so we cache OUR CPU work, not GPU
+ * binaries).
+ *
+ * Storage: plain synchronous file I/O under the persistent OPFS mount at
+ * `/projects/.shadercache` (the M7 store proved synchronous WasmFS-OPFS I/O from
+ * the WM worker). The cache is INERT wherever that mount is absent (e.g. the
+ * native gpu build): `cache_available()` returns false and every entry point is
+ * a no-op, so cold behaviour is byte-for-byte unchanged.
+ *
+ * Key = 128-bit content address of {salt (exact pinned shaderc and Tint/Dawn
+ * revisions plus translation policy), name, per-stage GLSL (which already
+ * contains all #defines), optimize flag, sampler_base, sampler_mappings} -
+ * everything that determines the emitted WGSL. A source, define, resource, or
+ * toolchain change flips the key and misses. The file header also bounds stage
+ * lengths and checksums the WGSL payload, so accidental cache corruption misses
+ * and re-translates instead of reaching createShaderModule. */
+
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "wgpu_shader_interface_map.hh"
+
+namespace blender::gpu::webgpu {
+
+struct ShaderStageSources;  /* wgpu_shader_compiler.hh */
+
+/** Opaque 128-bit content key for a translated shader. */
+struct ShaderCacheKey {
+  uint64_t hi = 0;
+  uint64_t lo = 0;
+};
+
+/** True once, when the OPFS-backed cache directory is present/creatable. Cheap
+ * after the first call (memoised). False on any platform without the mount, in
+ * which case every other entry point is a no-op and the caller runs the full
+ * translation exactly as before. Honours `BW_SHADER_CACHE=0` to force-disable. */
+bool cache_available();
+
+/** Compute the content key from the translation inputs. */
+ShaderCacheKey cache_key(const ShaderStageSources &sources,
+                         bool optimize,
+                         uint32_t sampler_base,
+                         const std::vector<SamplerRemap> &sampler_mappings);
+
+/** Read a cached translation. On a hit, fills the three WGSL strings (empty for
+ * an absent stage, matching the fresh path) and returns true. On any miss /
+ * corruption / version-mismatch returns false and leaves the strings untouched. */
+bool cache_lookup(const ShaderCacheKey &key,
+                  std::string &vertex_wgsl,
+                  std::string &fragment_wgsl,
+                  std::string &compute_wgsl);
+
+/** Persist a freshly-translated shader. Best-effort: failures are swallowed (the
+ * next warm boot simply misses and re-translates). */
+void cache_store(const ShaderCacheKey &key,
+                 const std::string &vertex_wgsl,
+                 const std::string &fragment_wgsl,
+                 const std::string &compute_wgsl);
+
+}  // namespace blender::gpu::webgpu
