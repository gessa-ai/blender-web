    *   - Depth32FloatStencil8: Blender's D32F/S8 combined depth-stencil format.
    *   - TextureFormatsTier1: extended write-only storage texture formats.
    *   - TextureFormatsTier2: extended read-write storage texture formats.
@@ -117,6 +119,9 @@ GHOST_TSuccess GHOST_ContextWGPU::initializeDrawingContext()
   if (adapter_.HasFeature(wgpu::FeatureName::Float32Filterable)) {
     required_features.push_back(wgpu::FeatureName::Float32Filterable);
   }
+  if (adapter_.HasFeature(wgpu::FeatureName::TextureComponentSwizzle)) {
+    required_features.push_back(wgpu::FeatureName::TextureComponentSwizzle);
+  }
   if (adapter_.HasFeature(wgpu::FeatureName::Depth32FloatStencil8)) {
     required_features.push_back(wgpu::FeatureName::Depth32FloatStencil8);
   }
diff --git a/source/blender/gpu/webgpu/wgpu_texture_format.hh b/source/blender/gpu/webgpu/wgpu_texture_format.hh
--- a/source/blender/gpu/webgpu/wgpu_texture_format.hh
