diff --git a/source/blender/draw/engines/eevee/eevee_storage_format.hh b/source/blender/draw/engines/eevee/eevee_storage_format.hh
new file mode 100644
index 0000000000000000000000000000000000000000..8f48c34ed36355aa7240980b3cdd1586db78671d
--- /dev/null
+++ b/source/blender/draw/engines/eevee/eevee_storage_format.hh
@@ -0,0 +1,42 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include "GPU_context.hh"
+#include "GPU_texture.hh"
+
+namespace blender::eevee {
+
+/**
+ * Return the physical format used for an EEVEE storage image.
+ *
+ * Some of EEVEE's native storage formats cannot support every usage required by WebGPU. Keep the
+ * logical shader format unchanged for the other backends, but promote the matching WebGPU
+ * allocation and shader interface together:
+ *
+ * - RG11B10Ufloat has no read-write storage access, so use RGBA16Float.
+ * - RG16Float has no read-write storage access, so use RGBA16Float.
+ * - RG16Unorm can be a storage texture with TextureFormatsTier1 but is not renderable. RG32Float
+ *   is renderable but cannot use read-write storage access. The GBuffer normal texture needs all
+ *   three usages, so use RGBA32Float. The extra channels are ignored and 32-bit floats preserve
+ *   at least the original normalized 16-bit precision.
+ */
+inline gpu::TextureFormat eevee_storage_format(gpu::TextureFormat format)
+{
+  if (GPU_backend_get_type() == GPU_BACKEND_WEBGPU) {
+    if (format == gpu::TextureFormat::UFLOAT_11_11_10) {
+      return gpu::TextureFormat::SFLOAT_16_16_16_16;
+    }
+    if (format == gpu::TextureFormat::SFLOAT_16_16) {
+      return gpu::TextureFormat::SFLOAT_16_16_16_16;
+    }
+    if (format == gpu::TextureFormat::UNORM_16_16) {
+      return gpu::TextureFormat::SFLOAT_32_32_32_32;
+    }
+  }
+  return format;
+}
+
+}  // namespace blender::eevee
