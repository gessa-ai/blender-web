+static void test_texture_webgpu_pooled_render_target_reacquire()
+{
+  using namespace shader;
+  GPU_render_begin();
+
+  constexpr int2 extent(4, 4);
+  constexpr gpu::TextureFormat format = gpu::TextureFormat::SFLOAT_16_16_16_16;
+  constexpr eGPUTextureUsage usage = GPU_TEXTURE_USAGE_ATTACHMENT |
+                                     GPU_TEXTURE_USAGE_HOST_READ;
+  constexpr float4 first_color(0.25f, 0.5f, 0.75f, 1.0f);
+  constexpr float4 second_color(0.75f, 0.25f, 0.5f, 1.0f);
+
+  ShaderCreateInfo info("pyGPU_Shader");
+  info.push_constant(Type::float4_t, "draw_color");
+  info.builtins(BuiltinBits::VERTEX_ID);
+  info.fragment_out(0, Type::float4_t, "out_color");
+  info.vertex_source_generated =
+      "void main() {\n"
+      "  float x = float((gl_VertexID << 1) & 2);\n"
+      "  float y = float(gl_VertexID & 2);\n"
+      "  gl_Position = vec4(x * 2.0 - 1.0, y * 2.0 - 1.0, 0.0, 1.0);\n"
+      "}\n";
+  info.fragment_source_generated =
+      "void main() {\n"
+      "  out_color = draw_color;\n"
+      "}\n";
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+  gpu::Batch *batch = GPU_batch_create_procedural(GPU_PRIM_TRIS, 3);
+  ASSERT_NE(batch, nullptr);
+  GPU_batch_set_shader(batch, shader);
+
+  for (const bool retain_between_passes : {false, true}) {
+    draw::TextureFromPool target(__func__);
+    gpu::FrameBuffer *framebuffer = nullptr;
+
+    auto acquire_target = [&]() {
+      return target.acquire_2d(extent, format, usage);
+    };
+    auto draw_target = [&](const float4 &color) {
+      GPU_framebuffer_ensure_config(
+          &framebuffer, {GPU_ATTACHMENT_NONE, GPU_ATTACHMENT_TEXTURE(target)});
+      GPU_framebuffer_bind(framebuffer);
+      GPU_framebuffer_clear_color(framebuffer, double4(0.0));
+      GPU_batch_uniform_4fv(batch, "draw_color", color);
+      GPU_batch_draw(batch);
+      GPU_framebuffer_restore();
+    };
+
+    EXPECT_TRUE(acquire_target());
+    float4 *debug_clear = target.read<float4>(GPU_DATA_FLOAT);
+    ASSERT_NE(debug_clear, nullptr);
+    for (const float4 pixel : Span<float4>(debug_clear, extent.x * extent.y)) {
+      EXPECT_TRUE(std::isnan(pixel.x));
+      EXPECT_TRUE(std::isnan(pixel.y));
+      EXPECT_TRUE(std::isnan(pixel.z));
+      EXPECT_TRUE(std::isnan(pixel.w));
+    }
+    MEM_delete(debug_clear);
+    draw_target(first_color);
+
+    if (retain_between_passes) {
+      target.retain();
+    }
+    else {
+      target.release();
+    }
+
+    EXPECT_EQ(acquire_target(), !retain_between_passes);
+    draw_target(second_color);
+
+    GPU_finish();
+    float4 *readback = static_cast<float4 *>(GPU_texture_read(target, GPU_DATA_FLOAT, 0));
+    ASSERT_NE(readback, nullptr);
+    for (const float4 pixel : Span<float4>(readback, extent.x * extent.y)) {
+      EXPECT_EQ(pixel, second_color);
+    }
+    MEM_delete(readback);
+
+    GPU_framebuffer_free(framebuffer);
+    target.release();
+  }
+
+  GPU_batch_discard(batch);
+  GPU_shader_unbind();
+  GPU_shader_free(shader);
+  GPU_render_end();
+}
