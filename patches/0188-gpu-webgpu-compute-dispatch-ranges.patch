+/** Validated unsigned workgroup counts for one direct WebGPU compute dispatch. */
+struct ComputeDispatchPlan {
+  uint32_t groups_x = 0;
+  uint32_t groups_y = 0;
+  uint32_t groups_z = 0;
+};
+
+/** Validate the signed backend parameters against the limits published to Blender's
+ * frontend before converting them to WebGPU's unsigned API. Zero counts remain valid
+ * no-op dimensions, matching Dawn. Failure leaves `result` unchanged. */
+inline bool compute_dispatch_plan(int groups_x,
+                                  int groups_y,
+                                  int groups_z,
+                                  int max_groups_x,
+                                  int max_groups_y,
+                                  int max_groups_z,
+                                  ComputeDispatchPlan &result)
+{
+  if (groups_x < 0 || groups_y < 0 || groups_z < 0 || max_groups_x <= 0 ||
+      max_groups_y <= 0 || max_groups_z <= 0 || groups_x > max_groups_x ||
+      groups_y > max_groups_y || groups_z > max_groups_z)
+  {
+    return false;
+  }
+
+  ComputeDispatchPlan candidate;
+  candidate.groups_x = uint32_t(groups_x);
+  candidate.groups_y = uint32_t(groups_y);
+  candidate.groups_z = uint32_t(groups_z);
+  result = candidate;
+  return true;
+}
+
+/** WebGPU's fixed DispatchWorkgroupsIndirect command is three uint32_t counts. */
+constexpr uint64_t kComputeIndirectCommandSize = 3u * sizeof(uint32_t);
+
+/** Validate the aligned indirect command span before beginning a compute pass. The
+ * subtraction form cannot overflow for adversarial uint64_t offsets. */
+inline bool compute_indirect_dispatch_range(uint64_t offset, uint64_t buffer_size)
+{
+  return (offset % kCopyAlignment) == 0 && offset <= buffer_size &&
+         kComputeIndirectCommandSize <= buffer_size - offset;
+}
+
 /** Validate one texture allocation against the live device's dimension, array-layer, and
