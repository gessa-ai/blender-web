# M2.5b — fix the wasm32 .blend read: DNA_struct_reconstruct's TARGET member offsets.
# Extends patch 0002 (which fixed the makesdna *tool*'s offset model). The runtime
# reconstruction (dna_genfile.cc create_reconstruct_steps_for_struct) computed target
# offsets with an INDEPENDENT unpadded running sum, which mis-places fields after an
# 8-aligned member on wasm32 (Scene.master_collection read NULL -> layer_utils.cc:205
# abort at factory-startup boot). See notes/m2-dna-reconstruct-diagnosis.md.
#
# Single source of truth (no second model, no recursive re-derivation, no read-side
# hacks, no Scene special-case, no old/file-side change): the WASM makesdna emits its
# already-verified wasm32-padded per-member offsets (the same values dna_verify.cc
# certifies) as a runtime table (DNA_reconstruct_member_offsets_wasm32[] +
# _start_wasm32[], indexed identically to the SDNA structs) appended to the generated
# dna_verify.cc; dna_genfile.cc consumes it on the target side. All changes are under
# #ifdef __EMSCRIPTEN__ / if(EMSCRIPTEN): the NATIVE makesdna never emits the table and
# native dna_genfile never references it, so native (LP64, where unpadded==padded) is
# byte-identical. A wasm-only BLI_assert guards table/SDNA member-count desync.
#
# Verified: table == compiled offsets for all 9831 members across all 993 structs
# (0 divergence vs both the alignment model and dna_verify's offsetof asserts);
# dna_verify green; boot reaches past scene load (master_collection non-NULL).
diff --git a/source/blender/makesdna/intern/makesdna.cc b/source/blender/makesdna/intern/makesdna.cc
--- a/source/blender/makesdna/intern/makesdna.cc
+++ b/source/blender/makesdna/intern/makesdna.cc
@@ -883,6 +883,56 @@
   }
 }
 
+#ifdef __EMSCRIPTEN__
+/* blender-web: emit makesdna's verified wasm32-padded member offsets as a runtime
+ * table so DNA_struct_reconstruct's TARGET side (dna_genfile.cc) consumes the SINGLE
+ * verified model instead of re-accumulating unpadded offsets — which mis-place fields
+ * after 8-aligned members on wasm32 (e.g. Scene.master_collection reads NULL). See
+ * notes/m2-dna-reconstruct-diagnosis.md. This whole function is under __EMSCRIPTEN__
+ * and is only called by the wasm makesdna, so the NATIVE tool's generated output is
+ * byte-identical (it never emits this table, and dna_genfile never references it).
+ *
+ * Index scheme mirrors the SDNA STRC order written by write_sdna_blob(): struct 0 =
+ * the synthetic `raw_data` (0 members), struct i>=1 = parsed_structs[i-1]; members in
+ * declaration order. `_start[s]` is the index of struct s's first member in the flat
+ * offsets array; its length is num_structs+1 (final entry = total member count), so
+ * struct s owns members `[_start[s], _start[s+1])`. The per-member offset uses the
+ * exact padded computation write_sdna_verify() certifies. */
+static void write_sdna_member_offsets(FILE *file,
+                                      const TypeTable &table,
+                                      const Span<dna::ParsedStruct> parsed_structs)
+{
+  Vector<int> starts;
+  int running = 0;
+  fprintf(file,
+          "\n/* blender-web: wasm32 runtime member offsets (single source of truth for "
+          "DNA_struct_reconstruct). */\n");
+  fprintf(file, "extern const int DNA_reconstruct_member_offsets_wasm32[];\n");
+  fprintf(file, "const int DNA_reconstruct_member_offsets_wasm32[] = {\n");
+  starts.append(running); /* struct 0: synthetic raw_data, 0 members. */
+  for (const dna::ParsedStruct &parsed_struct : parsed_structs) {
+    starts.append(running);
+    int offset = 0;
+    for (const dna::ParsedMember &parsed_member : parsed_struct.members) {
+      const TypeInfo &member_type = table.lookup(parsed_member.type_name);
+      offset = dna_align_up(offset, member_align_native(member_type, parsed_member));
+      fprintf(file, "%d,", offset);
+      offset += member_size_native(member_type, parsed_member);
+      running++;
+    }
+    fprintf(file, "\n");
+  }
+  fprintf(file, "};\n");
+  starts.append(running); /* sentinel: total member count. */
+  fprintf(file, "extern const int DNA_reconstruct_member_offsets_start_wasm32[];\n");
+  fprintf(file, "const int DNA_reconstruct_member_offsets_start_wasm32[] = {\n");
+  for (const int start : starts) {
+    fprintf(file, "%d,", start);
+  }
+  fprintf(file, "\n};\n");
+}
+#endif /* __EMSCRIPTEN__ */
+
 /** \} */
 
 /* -------------------------------------------------------------------- */
