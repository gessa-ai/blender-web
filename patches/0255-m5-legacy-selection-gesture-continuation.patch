+#ifdef __EMSCRIPTEN__
+enum class View3DGestureAsyncKind : uint8_t {
+  Box,
+  Lasso,
+};
+
+struct View3DGestureAsyncData {
+  wmTimer *timer = nullptr;
+  int tick_count = 0;
+  View3DGestureAsyncKind kind = View3DGestureAsyncKind::Box;
+};
+
+using View3DGestureExecFn = wmOperatorStatus (*)(bContext *, wmOperator *);
+
+static bool view3d_gesture_bitmap_async_eligible(bContext *C)
+{
+  const Object *obedit = CTX_data_edit_object(C);
+  const View3D *v3d = CTX_wm_view3d(C);
+  return obedit != nullptr && obedit->type == OB_MESH && v3d != nullptr &&
+         !XRAY_FLAG_ENABLED(v3d);
+}
+
+static bool view3d_gesture_bitmap_async_waiting()
+{
+  if (!DRW_select_buffer_bitmap_session_is_active()) {
+    return false;
+  }
+  const eGPUReadbackStatus status = DRW_select_buffer_bitmap_session_status();
+  return status == GPU_READBACK_PENDING ||
+         (status == GPU_READBACK_READY &&
+          DRW_select_buffer_bitmap_session_needs_replay());
+}
+
+static wmOperatorStatus view3d_gesture_bitmap_async_result(wmOperator *op,
+                                                           const wmOperatorStatus result)
+{
+  if (!DRW_select_buffer_bitmap_session_is_active()) {
+    return result;
+  }
+  const eGPUReadbackStatus status = DRW_select_buffer_bitmap_session_status();
+  if (status == GPU_READBACK_PENDING ||
+      (status == GPU_READBACK_READY && DRW_select_buffer_bitmap_session_needs_replay()))
+  {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (status == GPU_READBACK_FAILED) {
+    BKE_reportf(op->reports,
+                RPT_ERROR,
+                "WebGPU gesture selection readback failed (error %d)",
+                int(DRW_select_buffer_bitmap_session_error()));
+    return OPERATOR_CANCELLED;
+  }
+  return result;
+}
+
+static void view3d_gesture_bitmap_async_data_begin(bContext *C,
+                                                   wmOperator *op,
+                                                   const View3DGestureAsyncKind kind)
+{
+  BLI_assert(op->customdata == nullptr);
+  View3DGestureAsyncData *data = MEM_new<View3DGestureAsyncData>(__func__);
+  data->kind = kind;
+  data->timer = WM_event_timer_add(CTX_wm_manager(C), CTX_wm_window(C), TIMER, 0.01f);
+  op->customdata = data;
+}
+
+static void view3d_gesture_bitmap_async_data_end(bContext *C, wmOperator *op)
+{
+  View3DGestureAsyncData *data = static_cast<View3DGestureAsyncData *>(op->customdata);
+  if (data != nullptr) {
+    if (data->timer != nullptr) {
+      WM_event_timer_remove(CTX_wm_manager(C), CTX_wm_window(C), data->timer);
+    }
+    MEM_delete(data);
+    op->customdata = nullptr;
+  }
+  DRW_select_buffer_bitmap_session_end();
+}
+
+static wmOperatorStatus view3d_gesture_bitmap_async_after_gesture(
+    bContext *C,
+    wmOperator *op,
+    const wmOperatorStatus result,
+    const View3DGestureAsyncKind kind)
+{
+  if (!DRW_select_buffer_bitmap_session_is_active()) {
+    return result;
+  }
+  if (view3d_gesture_bitmap_async_waiting()) {
+    if (op->customdata == nullptr) {
+      view3d_gesture_bitmap_async_data_begin(C, op, kind);
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (DRW_select_buffer_bitmap_session_status() == GPU_READBACK_FAILED) {
+    BKE_reportf(op->reports,
+                RPT_ERROR,
+                "WebGPU gesture selection readback failed (error %d)",
+                int(DRW_select_buffer_bitmap_session_error()));
+    DRW_select_buffer_bitmap_session_end();
+    return OPERATOR_CANCELLED;
+  }
+  if ((result & OPERATOR_RUNNING_MODAL) && op->customdata != nullptr) {
+    return result;
+  }
+  DRW_select_buffer_bitmap_session_end();
+  return result;
+}
+
+static wmOperatorStatus view3d_gesture_bitmap_async_modal(bContext *C,
+                                                          wmOperator *op,
+                                                          const wmEvent *event,
+                                                          const View3DGestureExecFn exec)
+{
+  View3DGestureAsyncData *data = static_cast<View3DGestureAsyncData *>(op->customdata);
+  if ((event->type == EVT_ESCKEY && event->val == KM_PRESS) ||
+      (event->type == EVT_MODAL_MAP && event->val == GESTURE_MODAL_CANCEL))
+  {
+    view3d_gesture_bitmap_async_data_end(C, op);
+    return OPERATOR_CANCELLED;
+  }
+  if (data == nullptr || event->type != TIMER || event->customdata != data->timer) {
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++data->tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for WebGPU gesture selection readback");
+    view3d_gesture_bitmap_async_data_end(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const eGPUReadbackStatus status = DRW_select_buffer_bitmap_session_status();
+  if (status == GPU_READBACK_PENDING) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (status != GPU_READBACK_READY ||
+      !DRW_select_buffer_bitmap_session_needs_replay())
+  {
+    if (status != GPU_READBACK_READY) {
+      BKE_reportf(op->reports,
+                  RPT_ERROR,
+                  "WebGPU gesture selection readback failed (error %d)",
+                  int(DRW_select_buffer_bitmap_session_error()));
+    }
+    view3d_gesture_bitmap_async_data_end(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const wmOperatorStatus result = exec(C, op);
+  if (result == OPERATOR_RUNNING_MODAL) {
+    return result;
+  }
+  view3d_gesture_bitmap_async_data_end(C, op);
+  return result;
+}
