+#ifdef __EMSCRIPTEN__
+    /* wasm32: size_t is 32-bit, so std::string::npos (0xFFFFFFFF) is not equal to the
+     * int64_t not_found (-1) that StringRefBase::find() returns (on 64-bit hosts they
