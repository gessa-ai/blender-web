+static wmOperatorStatus object_transform_axis_target_invoke(bContext *C,
+                                                            wmOperator *op,
+                                                            const wmEvent *event)
+{
+  Depsgraph *depsgraph = CTX_data_ensure_evaluated_depsgraph(C);
+  ViewContext vc = ED_view3d_viewcontext_init(C, depsgraph);
+
+  if (vc.obact == nullptr || !object_is_target_compat(vc.obact)) {
+    /* Falls back to texture space transform. */
+    return OPERATOR_PASS_THROUGH;
+  }
+
+  XFormAxisData *xfd = MEM_new<XFormAxisData>(__func__);
+  op->customdata = xfd;
+  xfd->vc = vc;
+
+#ifdef USE_RENDER_OVERRIDE
+  eView3D_Flag2 flag2_prev = vc.v3d->flag2;
+  vc.v3d->flag2 |= V3D_HIDE_OVERLAYS;
+#endif
+
+  ED_view3d_depth_override_prepare(
+      vc.depsgraph, vc.region, vc.v3d, nullptr, V3D_DEPTH_NO_GPENCIL, false);
+
+#ifdef USE_RENDER_OVERRIDE
+  vc.v3d->flag2 = flag2_prev;
+#endif
+
+  if (!xfd->depth_cache_session.init(vc.region)) {
+    BKE_report(op->reports, RPT_WARNING, "Unable to access depth buffer, using view plane");
+    object_transform_axis_target_free_data(op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const ViewportDepthCacheSession::ReadbackState depth_state =
+      xfd->depth_cache_session.state();
+  if (depth_state == ViewportDepthCacheSession::ReadbackState::Ready) {
+    xfd->depths = xfd->depth_cache_session.take(vc.region);
+    if (xfd->depths == nullptr) {
+      BKE_report(op->reports, RPT_WARNING, "Unable to access depth buffer, using view plane");
+      object_transform_axis_target_free_data(op);
+      return OPERATOR_CANCELLED;
+    }
+    object_transform_axis_target_initialize_ready(C, op, event);
+  }
+  else {
+    if (depth_state != ViewportDepthCacheSession::ReadbackState::Pending ||
+        !object_transform_axis_target_depth_wait_begin(C, xfd, event))
+    {
+      BKE_report(op->reports, RPT_ERROR, "Unable to retain axis-target depth request");
+      object_transform_axis_target_free_data(op);
+      return OPERATOR_CANCELLED;
+    }
+  }
 
   WM_event_add_modal_handler(C, op);
 
   return OPERATOR_RUNNING_MODAL;
 }
 
