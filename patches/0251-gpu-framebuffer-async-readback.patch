+                                        attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot] :
+                                        depth_attachment();
+  WGPUFramebufferReadPlan plan;
+  if (r_data == nullptr ||
+      !create_framebuffer_read_plan(attachment, format, area, channel_len, plan))
+  {
+    return;
+  }
+  std::vector<uint8_t> source(plan.layout.source_data_size);
+  plan.texture->read_sub(plan.mip, plan.layer, plan.format, source.data());
+  extract_read_result(plan.layout,
+                      plan.one_component,
+                      source.data(),
+                      source.size(),
+                      static_cast<unsigned char *>(r_data),
+                      plan.layout.destination_data_size);
