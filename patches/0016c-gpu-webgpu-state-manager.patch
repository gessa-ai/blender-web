+/* SPDX-FileCopyrightText: 2023 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_state_manager.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WGPUStateManager — the WebGPU `StateManager` implementation. Every context needs
+ * one: the gpu frontend dereferences `Context::get()->state_manager` unconditionally
+ * (e.g. `GPU_memory_barrier` → `state_manager->issue_barrier`, gpu_state.cc:312), so
+ * a null `state_manager` crashes before any draw. This bootstrap version is a set of
+ * honest no-ops: WebGPU's implicit memory model needs no barrier, pipeline state is
+ * baked into the render-pipeline descriptor at creation (not applied globally), and
+ * resource bindings are resolved into a `wgpu::BindGroup` at draw-time assembly
+ * (wgpu_batch / wgpu_pipeline — the draw path, not yet landed). Real BindSpace
+ * tracking (mirroring VKStateManager) arrives with that path. */
+
+#pragma once
+
+#include "gpu_state_private.hh"
+
+namespace blender::gpu {
+
+class WGPUStateManager : public StateManager {
+ public:
+  WGPUStateManager() = default;
+  ~WGPUStateManager() override = default;
+
+  void apply_state() override;
+  void force_state() override;
+
+  void issue_barrier(GPUBarrier barrier_bits) override;
+
+  void texture_bind(Texture *tex, GPUSamplerState sampler, int unit) override;
+  void texture_unbind(Texture *tex) override;
+  void texture_unbind_all() override;
+
+  void image_bind(Texture *tex, int unit) override;
+  void image_unbind(Texture *tex) override;
+  void image_unbind_all() override;
+};
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_state_manager.cc b/source/blender/gpu/webgpu/wgpu_state_manager.cc
