 #include <vector>

 #include "wgpu_buffer.hh"
@@ -76,6 +78,7 @@ class SelectionDrawAdmission {
 #ifdef __EMSCRIPTEN__
     shader_ = shader;
     armed_ = shader != nullptr && (G.f & G_FLAG_PICKSEL) != 0;
+    selection_ = armed_;
 #else
     (void)shader;
 #endif
@@ -113,11 +116,37 @@ class SelectionDrawAdmission {
 #endif
   }

+  std::function<void(bool)> validation_completion() const
+  {
+#ifdef __EMSCRIPTEN__
+    if (!selection_) {
+      return {};
+    }
+    ghost_web::note_selection_draw_validation_begin();
+    const std::string shader_name = shader_->name_get();
+    return [shader_name](const bool valid) {
+      if (!valid) {
+        note_webgpu_draw_drop();
+        request_webgpu_redraw_retry();
+        static std::atomic<uint32_t> log_count{0};
+        if (log_count.fetch_add(1u, std::memory_order_relaxed) < 128u) {
+          std::printf("[bw] WGPUWeb-select-draw-drop shader=%s stage=validation\n",
+                      shader_name.c_str());
+        }
+      }
+      ghost_web::note_selection_draw_validation_complete(valid);
+    };
+#else
+    return {};
+#endif
+  }
+
  private:
 #ifdef __EMSCRIPTEN__
   WGPUShader *shader_ = nullptr;
   const char *stage_ = "module";
   bool armed_ = false;
+  bool selection_ = false;
 #endif
 };

