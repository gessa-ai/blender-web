diff --git a/source/blender/gpu/intern/gpu_readback.cc b/source/blender/gpu/intern/gpu_readback.cc
new file mode 100644
index 0000000000000000000000000000000000000000..be5eb114de7570905433622df4fb169bb3bcc126
--- /dev/null
+++ b/source/blender/gpu/intern/gpu_readback.cc
@@ -0,0 +1,223 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ */
+
+#include "gpu_readback_private.hh"
+
+#include <cstring>
+#include <utility>
+
+#include "MEM_guardedalloc.h"
+
+namespace blender {
+
+namespace {
+
+class ImmediateReadback final : public GPUReadback {
+ private:
+  std::vector<unsigned char> bytes_;
+  size_t final_size_ = 0;
+  eGPUReadbackError error_ = GPU_READBACK_ERROR_NONE;
+
+ public:
+  explicit ImmediateReadback(std::vector<unsigned char> &&bytes)
+      : bytes_(std::move(bytes)), final_size_(bytes_.size())
+  {
+  }
+  ImmediateReadback(eGPUReadbackError error, const size_t final_size)
+      : final_size_(final_size), error_(error)
+  {
+  }
+
+  eGPUReadbackStatus status() override
+  {
+    return error_ == GPU_READBACK_ERROR_NONE ? GPU_READBACK_READY : GPU_READBACK_FAILED;
+  }
+
+  eGPUReadbackError error() override
+  {
+    return error_;
+  }
+
+  size_t size() override
+  {
+    return final_size_;
+  }
+
+  bool consume(void *dst, const size_t dst_len) override
+  {
+    if (status() != GPU_READBACK_READY || dst == nullptr || dst_len < final_size_) {
+      return false;
+    }
+    if (!bytes_.empty()) {
+      std::memcpy(dst, bytes_.data(), bytes_.size());
+    }
+    return true;
+  }
+};
+
+class TransformReadback final : public GPUReadback {
+ private:
+  GPUReadback *source_ = nullptr;
+  size_t source_size_ = 0;
+  size_t final_size_ = 0;
+  GPUReadbackTransform transform_;
+  eGPUReadbackStatus status_ = GPU_READBACK_PENDING;
+  eGPUReadbackError error_ = GPU_READBACK_ERROR_NONE;
+  std::vector<unsigned char> bytes_;
+
+  void fail(const eGPUReadbackError error)
+  {
+    error_ = error;
+    status_ = GPU_READBACK_FAILED;
+    GPU_readback_cancel(source_);
+    bytes_.clear();
+  }
+
+  void refresh()
+  {
+    if (status_ != GPU_READBACK_PENDING) {
+      return;
+    }
+    const eGPUReadbackStatus source_status = GPU_readback_status(source_);
+    if (source_status == GPU_READBACK_PENDING) {
+      return;
+    }
+    if (source_status != GPU_READBACK_READY) {
+      const eGPUReadbackError source_error = GPU_readback_error(source_);
+      fail(source_error == GPU_READBACK_ERROR_NONE ? GPU_READBACK_ERROR_BACKEND_FAILURE :
+                                                    source_error);
+      return;
+    }
+    if (GPU_readback_size(source_) != source_size_) {
+      fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+      return;
+    }
+
+    std::vector<unsigned char> source_bytes(source_size_);
+    if (!GPU_readback_consume(source_, source_bytes.data(), source_bytes.size())) {
+      fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+      return;
+    }
+    bytes_.resize(final_size_);
+    if (!transform_(source_bytes.data(),
+                    source_bytes.size(),
+                    bytes_.data(),
+                    bytes_.size()))
+    {
+      fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+      return;
+    }
+    status_ = GPU_READBACK_READY;
+  }
+
+ public:
+  TransformReadback(GPUReadback *source,
+                    const size_t source_size,
+                    const size_t final_size,
+                    GPUReadbackTransform transform)
+      : source_(source),
+        source_size_(source_size),
+        final_size_(final_size),
+        transform_(std::move(transform))
+  {
+  }
+
+  ~TransformReadback() override
+  {
+    GPU_readback_cancel(source_);
+  }
+
+  eGPUReadbackStatus status() override
+  {
+    refresh();
+    return status_;
+  }
+
+  eGPUReadbackError error() override
+  {
+    refresh();
+    return error_;
+  }
+
+  size_t size() override
+  {
+    return final_size_;
+  }
+
+  bool consume(void *dst, const size_t dst_len) override
+  {
+    refresh();
+    if (status_ != GPU_READBACK_READY || dst == nullptr || dst_len < final_size_) {
+      return false;
+    }
+    if (!bytes_.empty()) {
+      std::memcpy(dst, bytes_.data(), bytes_.size());
+    }
+    return true;
+  }
+};
+
+}  // namespace
+
+GPUReadback *gpu_readback_create_ready(std::vector<unsigned char> &&bytes)
+{
+  return MEM_new<ImmediateReadback>(__func__, std::move(bytes));
+}
+
+GPUReadback *gpu_readback_create_failed(const eGPUReadbackError error, const size_t final_size)
+{
+  return MEM_new<ImmediateReadback>(__func__, error, final_size);
+}
+
+GPUReadback *gpu_readback_create_transform(GPUReadback *source,
+                                           const size_t source_size,
+                                           const size_t final_size,
+                                           GPUReadbackTransform transform)
+{
+  if (source == nullptr || !transform) {
+    GPU_readback_cancel(source);
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT, final_size);
+  }
+  return MEM_new<TransformReadback>(
+      __func__, source, source_size, final_size, std::move(transform));
+}
+
+eGPUReadbackStatus GPU_readback_status(GPUReadback *readback)
+{
+  return readback != nullptr ? readback->status() : GPU_READBACK_INVALID;
+}
+
+eGPUReadbackError GPU_readback_error(GPUReadback *readback)
+{
+  return readback != nullptr ? readback->error() : GPU_READBACK_ERROR_INVALID_ARGUMENT;
+}
+
+size_t GPU_readback_size(GPUReadback *readback)
+{
+  return readback != nullptr ? readback->size() : 0;
+}
+
+bool GPU_readback_consume(GPUReadback *&readback, void *dst, const size_t dst_len)
+{
+  if (readback == nullptr || !readback->consume(dst, dst_len)) {
+    return false;
+  }
+  MEM_delete(readback);
+  readback = nullptr;
+  return true;
+}
+
+void GPU_readback_cancel(GPUReadback *&readback)
+{
+  if (readback != nullptr) {
+    MEM_delete(readback);
+    readback = nullptr;
+  }
+}
+
+}  // namespace blender
