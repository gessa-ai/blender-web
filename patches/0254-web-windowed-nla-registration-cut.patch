From: blender-web contributors
Subject: editors: let the windowed web profile omit NLA registration

The NLA editor is outside the launch-critical browser path, while its
space-type and macro registration retain a leaf editor implementation closure.
Keep NLA data, DNA/RNA, blend loading, core animation, and stock
desktop/headless behavior, but let the windowed profile leave those two editor
roots unreachable.

diff --git a/source/blender/editors/space_api/CMakeLists.txt b/source/blender/editors/space_api/CMakeLists.txt
--- a/source/blender/editors/space_api/CMakeLists.txt
+++ b/source/blender/editors/space_api/CMakeLists.txt
@@ -117,3 +117,17 @@ if(WITH_BLENDER_WEB_CLIP)
 if(WITH_BLENDER_WEB_CLIP)
   target_compile_definitions(bf_editor_space_api PRIVATE WITH_BLENDER_WEB_CLIP)
 endif()
+
+# Keep Blender's stock behavior for every non-web or headless build. The
+# windowed browser profile can omit non-launch NLA editor registration while
+# retaining NLA data, DNA/RNA, blend loading, and core animation paths.
+if(NOT DEFINED WITH_BLENDER_WEB_NLA)
+  if(WITH_BLENDER_WEB_WINDOWED)
+    set(WITH_BLENDER_WEB_NLA OFF)
+  else()
+    set(WITH_BLENDER_WEB_NLA ON)
+  endif()
+endif()
+if(WITH_BLENDER_WEB_NLA)
+  target_compile_definitions(bf_editor_space_api PRIVATE WITH_BLENDER_WEB_NLA)
+endif()
diff --git a/source/blender/editors/space_api/spacetypes.cc b/source/blender/editors/space_api/spacetypes.cc
--- a/source/blender/editors/space_api/spacetypes.cc
+++ b/source/blender/editors/space_api/spacetypes.cc
@@ -76,7 +76,9 @@ void ED_spacetypes_init()
   ED_spacetype_info();
   ED_spacetype_file();
   ED_spacetype_action();
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_NLA)
   ED_spacetype_nla();
+#endif
   ED_spacetype_script();
   ED_spacetype_text();
 #if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_VSE)
@@ -191,7 +193,9 @@ void ED_spacemacros_init()
 #if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_GREASE_PENCIL)
   ED_operatormacros_grease_pencil();
 #endif
+#if !defined(__EMSCRIPTEN__) || defined(WITH_BLENDER_WEB_NLA)
   ED_operatormacros_nla();
+#endif

   /* Register dropboxes (can use macros). */
   ui::dropboxes_ui();
