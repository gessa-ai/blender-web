   bool completed_ = false;
 };
 
+/** Join materialized clear commands and their dependent draw into one logical load-action
+ * completion. Each issued callback is idempotent because a synchronous helper rejection can be
+ * reported both by its return value and by release of the retained asynchronous callback. */
+class FramebufferLoadActionCompletionGroup {
+ private:
+  struct State {
+    State(std::shared_ptr<FramebufferLoadActionTransaction> transaction,
+          const uint32_t pending)
+        : transaction(std::move(transaction)), pending(pending)
+    {
+    }
+
+    ~State()
+    {
+      if (transaction) {
+        transaction->complete(false);
+      }
+    }
+
+    void complete(const bool operation_valid)
+    {
+      std::shared_ptr<FramebufferLoadActionTransaction> completed_transaction;
+      bool completed_valid = false;
+      {
+        std::lock_guard lock(mutex);
+        if (pending == 0) {
+          return;
+        }
+        valid = valid && operation_valid;
+        pending--;
+        if (pending != 0) {
+          return;
+        }
+        completed_valid = valid;
+        completed_transaction = std::move(transaction);
+      }
+      if (completed_transaction) {
+        completed_transaction->complete(completed_valid);
+      }
+    }
+
+    std::mutex mutex;
+    std::shared_ptr<FramebufferLoadActionTransaction> transaction;
+    uint32_t pending;
+    bool valid = true;
+  };
+
+ public:
+  FramebufferLoadActionCompletionGroup(
+      std::shared_ptr<FramebufferLoadActionTransaction> transaction,
+      const uint32_t operation_count)
+      : state_(std::make_shared<State>(std::move(transaction), operation_count))
+  {
+  }
+
+  std::function<void(bool)> completion() const
+  {
+    auto completed = std::make_shared<std::atomic<bool>>(false);
+    return [state = state_, completed = std::move(completed)](const bool valid) {
+      if (!completed->exchange(true, std::memory_order_acq_rel)) {
+        state->complete(valid);
+      }
+    };
+  }
+
+ private:
+  std::shared_ptr<State> state_;
+};
