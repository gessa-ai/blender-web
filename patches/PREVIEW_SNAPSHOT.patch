+static void test_texture_webgpu_film_history_ping_pong_bindings()
+{
+  using namespace shader;
+  GPU_render_begin();
+
+  /* Match the binding pressure and overlapping sampler/image slot numbers of the EEVEE Film
+   * accumulate pass. In particular, sampler slot 5 is the sampled current combined texture while
+   * image slot 3 is its storage-image next texture. */
+  ShaderCreateInfo info("pyGPU_Shader");
+  info.sampler(0, ImageType::Float2D, "sample0_tx");
+  info.sampler(1, ImageType::Float2D, "sample1_tx");
+  info.sampler(2, ImageType::Float2D, "sample2_tx");
+  info.sampler(3, ImageType::Float2D, "sample3_tx");
+  info.sampler(4, ImageType::Float2D, "sample4_tx");
+  info.sampler(6, ImageType::Float2D, "sample6_tx");
+  /* Film declares cryptomatte slot 6 before its history sampler at slot 5. Keep that declaration
+   * order here because resource declaration order must not affect dense WebGPU bindings. */
+  info.sampler(5, ImageType::Float2D, "history_tx");
+  info.image(0,
+             TextureFormat::SFLOAT_16_16_16_16,
+             Qualifier::read,
+             ImageReadWriteType::image2D,
+             "image0_img");
+  info.image(1,
+             TextureFormat::SFLOAT_16_16_16_16,
+             Qualifier::read,
+             ImageReadWriteType::image2D,
+             "image1_img");
+  info.image(2,
+             TextureFormat::SFLOAT_16_16_16_16,
+             Qualifier::read,
+             ImageReadWriteType::image2D,
+             "image2_img");
+  info.image(3,
+             TextureFormat::SFLOAT_16_16_16_16,
+             Qualifier::write,
+             ImageReadWriteType::image2D,
+             "history_out_img");
+  info.image(4,
+             TextureFormat::SFLOAT_16_16_16_16,
+             Qualifier::read,
+             ImageReadWriteType::image2D,
+             "image4_img");
+  info.image(5,
+             TextureFormat::SFLOAT_16_16_16_16,
+             Qualifier::read,
+             ImageReadWriteType::image2D,
+             "image5_img");
+  info.image(6,
+             TextureFormat::SFLOAT_16_16_16_16,
+             Qualifier::read,
+             ImageReadWriteType::image2D,
+             "image6_img");
+  info.local_group_size(1, 1, 1);
+  info.compute_source_generated =
+      "void main() {\n"
+      "  ivec2 texel = ivec2(0);\n"
+      "  vec4 history = texelFetch(history_tx, texel, 0);\n"
+      /* Slot-weighted signatures make a stale or crossed binding visible while preserving the
+       * film-like history recurrence in the red channel. Values stay exactly representable in
+       * binary16 through all 64 dispatches. */
+      "  float sampler_signature = texelFetch(sample0_tx, texel, 0).x * 1.0 +\n"
+      "                            texelFetch(sample1_tx, texel, 0).x * 2.0 +\n"
+      "                            texelFetch(sample2_tx, texel, 0).x * 4.0 +\n"
+      "                            texelFetch(sample3_tx, texel, 0).x * 8.0 +\n"
+      "                            texelFetch(sample4_tx, texel, 0).x * 16.0 +\n"
+      "                            texelFetch(sample6_tx, texel, 0).x * 32.0;\n"
+      "  float image_signature = imageLoad(image0_img, texel).x * 1.0 +\n"
+      "                          imageLoad(image1_img, texel).x * 2.0 +\n"
+      "                          imageLoad(image2_img, texel).x * 4.0 +\n"
+      "                          imageLoad(image4_img, texel).x * 8.0 +\n"
+      "                          imageLoad(image5_img, texel).x * 16.0 +\n"
+      "                          imageLoad(image6_img, texel).x * 32.0;\n"
+      "  imageStore(history_out_img, texel, vec4(history.x + 1.0,\n"
+      "                                            sampler_signature,\n"
+      "                                            image_signature,\n"
+      "                                            1.0));\n"
+      "}\n";
+
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+  GPU_shader_bind(shader);
+
+  constexpr eGPUTextureUsage sampled_usage = GPU_TEXTURE_USAGE_SHADER_READ;
+  constexpr eGPUTextureUsage image_usage = GPU_TEXTURE_USAGE_SHADER_READ |
+                                             GPU_TEXTURE_USAGE_SHADER_WRITE;
+  constexpr eGPUTextureUsage history_usage = image_usage | GPU_TEXTURE_USAGE_HOST_READ;
+  const char *sampler_names[7] = {
+      "sample0_tx", "sample1_tx", "sample2_tx", "sample3_tx", "sample4_tx", "history_tx", "sample6_tx"};
+  const char *image_names[7] = {"image0_img",
+                                "image1_img",
+                                "image2_img",
+                                "history_out_img",
+                                "image4_img",
+                                "image5_img",
+                                "image6_img"};
+  gpu::Texture *sampled[7] = {};
+  gpu::Texture *images[7] = {};
+  gpu::Texture *history[2] = {};
+
+  for (int slot = 0; slot < 7; slot++) {
+    if (slot != 5) {
+      const float4 value(float(slot + 1), 0.0f, 0.0f, 1.0f);
+      sampled[slot] = GPU_texture_create_2d(__func__,
+                                            1,
+                                            1,
+                                            1,
+                                            TextureFormat::SFLOAT_16_16_16_16,
+                                            sampled_usage,
+                                            value);
+      ASSERT_NE(sampled[slot], nullptr);
+    }
+    if (slot != 3) {
+      const float4 value(float(slot + 11), 0.0f, 0.0f, 1.0f);
+      images[slot] = GPU_texture_create_2d(__func__,
+                                           1,
+                                           1,
+                                           1,
+                                           TextureFormat::SFLOAT_16_16_16_16,
+                                           image_usage,
+                                           value);
+      ASSERT_NE(images[slot], nullptr);
+    }
+  }
+  for (int i = 0; i < 2; i++) {
+    history[i] = GPU_texture_create_2d(__func__,
+                                       1,
+                                       1,
+                                       1,
+                                       TextureFormat::SFLOAT_16_16_16_16,
+                                       history_usage,
+                                       nullptr);
+    ASSERT_NE(history[i], nullptr);
+  }
+
+  auto run_dispatches = [&](const int dispatch_len) {
+    const float4 initial(1.0f, 0.0f, 0.0f, 1.0f);
+    const float4 next_sentinel(127.0f, 0.0f, 0.0f, 1.0f);
+    GPU_texture_clear(history[0], GPU_DATA_FLOAT, initial);
+    GPU_texture_clear(history[1], GPU_DATA_FLOAT, next_sentinel);
+    GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
+
+    int current = 0;
+    for (int dispatch = 0; dispatch < dispatch_len; dispatch++) {
+      for (int slot = 0; slot < 7; slot++) {
+        gpu::Texture *texture = (slot == 5) ? history[current] : sampled[slot];
+        GPU_texture_bind(texture, GPU_shader_get_sampler_binding(shader, sampler_names[slot]));
+      }
+      for (int slot = 0; slot < 7; slot++) {
+        gpu::Texture *texture = (slot == 3) ? history[current ^ 1] : images[slot];
+        GPU_texture_image_bind(texture,
+                               GPU_shader_get_sampler_binding(shader, image_names[slot]));
+      }
+      GPU_compute_dispatch(shader, 1, 1, 1);
+      GPU_memory_barrier(GPU_BARRIER_TEXTURE_FETCH | GPU_BARRIER_SHADER_IMAGE_ACCESS);
+      current ^= 1;
+    }
+    GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE | GPU_BARRIER_SHADER_IMAGE_ACCESS);
+    float4 *result = static_cast<float4 *>(GPU_texture_read(history[current], GPU_DATA_FLOAT, 0));
+    EXPECT_NE(result, nullptr);
+    if (result != nullptr) {
+      EXPECT_FLOAT_EQ(result->x, float(dispatch_len + 1));
+      EXPECT_FLOAT_EQ(result->y, 353.0f);
+      EXPECT_FLOAT_EQ(result->z, 1007.0f);
+      EXPECT_FLOAT_EQ(result->w, 1.0f);
+    }
+    MEM_delete(result);
+  };
+
+  run_dispatches(2);
+  run_dispatches(64);
+
+  for (gpu::Texture *texture : sampled) {
+    if (texture != nullptr) {
+      GPU_texture_unbind(texture);
+      GPU_texture_free(texture);
+    }
+  }
+  for (gpu::Texture *texture : images) {
+    if (texture != nullptr) {
+      GPU_texture_image_unbind(texture);
+      GPU_texture_free(texture);
+    }
+  }
+  for (gpu::Texture *texture : history) {
+    GPU_texture_unbind(texture);
+    GPU_texture_image_unbind(texture);
+    GPU_texture_free(texture);
+  }
+  GPU_shader_unbind();
+  GPU_shader_free(shader);
+  GPU_render_end();
+}
