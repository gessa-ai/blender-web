+      case ResourceKind::StorageImage: {
+        /* Blender assigns one shader-wide Vertex|Fragment mask to every graphics
+         * resource, even when only fragment code uses it. WebGPU forbids writable
+         * storage textures in the vertex stage, so remove that over-declared stage
+         * while retaining the fragment and compute stages that may write. */
+        wgpu::ShaderStage svis = vis;
+        if (r.image_access == wgpu::StorageTextureAccess::WriteOnly ||
+            r.image_access == wgpu::StorageTextureAccess::ReadWrite)
+        {
+          svis = vis & (wgpu::ShaderStage::Fragment | wgpu::ShaderStage::Compute);
+        }
+        map.entries.push_back(make_storage_image_entry(r.binding, svis, r));
