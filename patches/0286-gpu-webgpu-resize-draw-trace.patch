diff --git a/source/blender/gpu/webgpu/wgpu_framebuffer.cc b/source/blender/gpu/webgpu/wgpu_framebuffer.cc
--- a/source/blender/gpu/webgpu/wgpu_framebuffer.cc
+++ b/source/blender/gpu/webgpu/wgpu_framebuffer.cc
@@ -27,3 +27,7 @@
+#ifdef __EMSCRIPTEN__
+#  include "GHOST_WebDisplayState.hh"
+#endif
+
 #include <algorithm>
 #include <array>
 #include <atomic>
@@ -1192,3 +1196,39 @@
+void WGPUFrameBuffer::debug_note_draw(const char *shader_name) const
+{
+#ifdef __EMSCRIPTEN__
+  if (!ghost_web::redraw_trace_capturing() || multi_viewport_) {
+    return;
+  }
+  webgpu::FramebufferViewportPlan draw_viewport;
+  if (!load_pass_viewport_plan(draw_viewport)) {
+    return;
+  }
+  ghost_web::RedrawTracePass pass = ghost_web::RedrawTracePass::Other;
+  if (shader_name != nullptr && std::strcmp(shader_name, "overlay_background") == 0) {
+    pass = ghost_web::RedrawTracePass::OverlayBackground;
+  }
+  else if (shader_name != nullptr && std::strcmp(shader_name, "OCIO_Display") == 0) {
+    pass = ghost_web::RedrawTracePass::OcioDisplay;
+  }
+  WGPUContext *wctx = active_context();
+  ghost_web::redraw_trace_note(pass,
+                               wctx != nullptr && wctx->is_window_backbuffer(this),
+                               width_,
+                               height_,
+                               draw_viewport.viewport.viewport_x,
+                               draw_viewport.viewport.viewport_y,
+                               draw_viewport.viewport.viewport_width,
+                               draw_viewport.viewport.viewport_height,
+                               draw_viewport.scissor_enabled,
+                               draw_viewport.scissor_x,
+                               draw_viewport.scissor_y,
+                               draw_viewport.scissor_width,
+                               draw_viewport.scissor_height);
+#else
+  (void)shader_name;
+#endif
+}
+
