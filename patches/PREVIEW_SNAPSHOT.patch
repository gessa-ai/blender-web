+static void test_select_next_async_replay()
+{
+  GPU_render_begin();
+
+  const uint raw[] = {0x00003000u, 0x00001000u, 0xFFFFFFFFu, 0xFFFFFFFFu};
+  const uint select_ids[] = {101u, 202u};
+  const bool in_front[] = {false, false};
+  gpu::StorageBuf *buffer = GPU_storagebuf_create_ex(
+      sizeof(raw), raw, GPU_USAGE_DYNAMIC, "select-next-async-replay");
+  ASSERT_NE(buffer, nullptr);
+  GPU_memory_barrier(GPU_BARRIER_BUFFER_UPDATE);
+
+  rcti rect{10, 20, 30, 40};
+  GPUSelectBuffer initial_buffer;
+  GPU_select_async_session_begin();
+  gpu_select_next_begin(&initial_buffer, &rect, 0, GPU_SELECT_PICK_NEAREST);
+  gpu_select_next_async_readback_begin(
+      GPU_storagebuf_read_async(buffer),
+      Span<uint>(select_ids, ARRAY_SIZE(select_ids)),
+      Span<bool>(in_front, ARRAY_SIZE(in_front)));
+
+#ifdef __EMSCRIPTEN__
+  EXPECT_EQ(GPU_select_async_status(), GPU_READBACK_PENDING);
+#else
+  EXPECT_EQ(GPU_select_async_status(), GPU_READBACK_READY);
+
+  GPUSelectBuffer replay;
+  int hits = -1;
+  EXPECT_TRUE(
+      GPU_select_async_result_replay(&replay, &rect, 0, GPU_SELECT_PICK_NEAREST, &hits));
+  ASSERT_EQ(hits, 1);
+  ASSERT_EQ(replay.storage.size(), 1);
+  EXPECT_EQ(replay.storage[0].id, 202u);
+  EXPECT_EQ(replay.storage[0].depth, raw[1]);
+
+  /* Re-entry is deliberately repeatable until the logical WM operation ends. */
+  GPUSelectBuffer replay_again;
+  hits = -1;
+  EXPECT_TRUE(
+      GPU_select_async_result_replay(&replay_again, &rect, 0, GPU_SELECT_PICK_NEAREST, &hits));
+  EXPECT_EQ(hits, 1);
+  EXPECT_EQ(replay_again.storage[0].id, 202u);
+
+  rcti wrong_rect = rect;
+  wrong_rect.xmin++;
+  EXPECT_FALSE(
+      GPU_select_async_result_replay(&replay_again, &wrong_rect, 0, GPU_SELECT_PICK_NEAREST, &hits));
+#endif
+
+  GPU_storagebuf_free(buffer);
+  GPU_select_async_session_end();
+  EXPECT_FALSE(GPU_select_async_session_is_active());
+  EXPECT_EQ(GPU_select_async_status(), GPU_READBACK_INVALID);
+  GPU_render_end();
+}
+GPU_TEST(select_next_async_replay)
+
+}  // namespace blender::gpu::tests
