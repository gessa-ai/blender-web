+class TransformReadback final : public GPUReadback {
+ private:
+  GPUReadback *source_ = nullptr;
+  size_t source_size_ = 0;
+  size_t final_size_ = 0;
+  GPUReadbackTransform transform_;
+  eGPUReadbackStatus status_ = GPU_READBACK_PENDING;
+  eGPUReadbackError error_ = GPU_READBACK_ERROR_NONE;
+  std::vector<unsigned char> bytes_;
+
+  void fail(const eGPUReadbackError error)
+  {
+    error_ = error;
+    status_ = GPU_READBACK_FAILED;
+    GPU_readback_cancel(source_);
+    bytes_.clear();
+  }
+
+  void refresh()
+  {
+    if (status_ != GPU_READBACK_PENDING) {
+      return;
+    }
+    const eGPUReadbackStatus source_status = GPU_readback_status(source_);
+    if (source_status == GPU_READBACK_PENDING) {
+      return;
+    }
+    if (source_status != GPU_READBACK_READY) {
+      const eGPUReadbackError source_error = GPU_readback_error(source_);
+      fail(source_error == GPU_READBACK_ERROR_NONE ? GPU_READBACK_ERROR_BACKEND_FAILURE :
+                                                    source_error);
+      return;
+    }
+    if (GPU_readback_size(source_) != source_size_) {
+      fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+      return;
+    }
+
+    std::vector<unsigned char> source_bytes(source_size_);
+    if (!GPU_readback_consume(source_, source_bytes.data(), source_bytes.size())) {
+      fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+      return;
+    }
+    bytes_.resize(final_size_);
+    if (!transform_(source_bytes.data(),
+                    source_bytes.size(),
+                    bytes_.data(),
+                    bytes_.size()))
+    {
+      fail(GPU_READBACK_ERROR_BACKEND_FAILURE);
+      return;
+    }
+    status_ = GPU_READBACK_READY;
+  }
+
+ public:
+  TransformReadback(GPUReadback *source,
+                    const size_t source_size,
+                    const size_t final_size,
+                    GPUReadbackTransform transform)
+      : source_(source),
+        source_size_(source_size),
+        final_size_(final_size),
+        transform_(std::move(transform))
+  {
+  }
+
+  ~TransformReadback() override
+  {
+    GPU_readback_cancel(source_);
+  }
+
+  eGPUReadbackStatus status() override
+  {
+    refresh();
+    return status_;
+  }
+
+  eGPUReadbackError error() override
+  {
+    refresh();
+    return error_;
+  }
+
+  size_t size() override
+  {
+    return final_size_;
+  }
+
+  bool consume(void *dst, const size_t dst_len) override
+  {
+    refresh();
+    if (status_ != GPU_READBACK_READY || dst == nullptr || dst_len < final_size_) {
+      return false;
+    }
+    if (!bytes_.empty()) {
+      std::memcpy(dst, bytes_.data(), bytes_.size());
+    }
+    return true;
+  }
+};
