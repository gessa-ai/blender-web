   write_sdna_type_offsets(file_offsets, parsed_structs);
   write_sdna_struct_ids(file_ids, parsed_structs);
   write_sdna_verify(file_verify, table, parsed_structs, base_directory);
+#ifdef __EMSCRIPTEN__
+  /* blender-web: append the wasm32 runtime member-offset table to dna_verify.cc (a
+   * compiled bf_dna TU). Wasm makesdna only; native output unchanged. */
+  write_sdna_member_offsets(file_verify, table, parsed_structs);
+#endif
 
   DEBUG_PRINTF(0, "done.\n");
 
