index 0000000..c25cedb
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_readback.hh
@@ -0,0 +1,181 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * New for the web port (no upstream equivalent). */
+
+/** \file
+ * \ingroup gpu
+ *
+ * Production GPU readback primitive (M5 lane L-A) - the caller-facing "kick on request,
+ * latch on tick, consume on settle" contract adopted in
+ * notes/m5-sync-readback-contract-design.md.
+ *
+ * WHY THIS EXISTS. In the windowed WM-worker profile a WebGPU map future cannot be
+ * waited on synchronously: `instance.WaitAny` needs asyncify/JSPI (dropped per ADR-006)
+ * and a same-thread blocking wait halts the very event loop that would deliver the map
+ * completion (ADR-007). So the historic `WGPUTexture::read` / `webgpu::Buffer::read`
+ * path (a `MapAsync(WaitAnyOnly)` + `WaitAny(f, UINT64_MAX)`) returns all-zero buffers
+ * on the web. Worse, its completion lambda captured the caller's stack BY REFERENCE and
+ * could fire spontaneously AFTER `read()` returned - a dangling write through a reused
+ * wasm function-table slot, the suspected `table index is out of bounds` crash after
+ * back-to-back snapshot ops (r25). See the design note section 4 (M5.readback-callback-
+ * lifetime).
+ *
+ * The proven lever (patches 0117/0125, twice) is `CallbackMode::AllowSpontaneous`: the
+ * map completion fires on the WM worker's own event loop BETWEEN main-loop ticks with no
+ * `ProcessEvents` dependency, provided the C++ stack has returned to the browser loop.
+ * This module promotes that lever to production quality behind ONE registry shared by
+ * both backend seams:
+ *
+ *   KICK    - a request submits the copy + `MapAsync(AllowSpontaneous)` and registers a
+ *             HEAP-OWNED pending record (the staging buffer lives in the record, never on
+ *             the caller stack). The callback captures only a plain integer ticket, so it
+ *             can never dangle.
+ *   LATCH   - when the map resolves (a later tick) the callback strips row padding into a
+ *             per-source settled record, keyed so a later read of the SAME source finds it.
+ *   CONSUME - `take_settled()` returns the latched device bytes when present. The two
+ *             `read()` seams use it for the design's "return the latched bytes when
+ *             settled; on first-call-unsettled return the conservative interim (zeros)"
+ *             contract (kick-now, fill-one-tick-late).
+ *
+ * NATIVE PATH IS UNTOUCHED. Everything here is `__EMSCRIPTEN__`-scoped: on native Dawn the
+ * blocking `WaitAny` works, so `read()` keeps its verbatim synchronous path and never
+ * calls into this module (`pending_count()` stays 0, the API compiles to trivial stubs).
+ *
+ * POLL / SETTLE for later lanes. `pending_count()` and `pump()` are the internal hooks a
+ * WM-loop "settle barrier" (L-C `wait_for_gpu_idle`) drives: advance ticks (returning to
+ * the loop so AllowSpontaneous can fire) until `pending_count()` reaches zero or a bounded
+ * frame budget is hit. The PUBLIC `GPU_*_read_async` API is deliberately NOT here - that
+ * is lane L-B (upstream-shared gpu/intern). This lane ships only the backend mechanics. */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+#ifdef __EMSCRIPTEN__
+#  include "webgpu/webgpu_cpp.h"
+#endif
+
+namespace blender::gpu::webgpu {
+class WGPUTexture;
+}
+
+namespace blender::gpu::webgpu::readback {
+
+/** A readback ticket. 0 is never a valid ticket. Returned by the kick entry points and
+ * accepted by the poll/consume entry points; the later async GPU API (L-B) will surface
+ * these to callers. */
+using Ticket = uint64_t;
+constexpr Ticket kInvalidTicket = 0;
+
+/** Which backend seam a source key belongs to (a texture handle or a buffer handle can
+ * share a raw address across kinds, so the kind is part of the identity). */
+enum class SourceKind : uint8_t {
+  Texture = 0,
+  Buffer = 1,
+};
+
+/** Stable identity of a readback source, used both to de-duplicate in-flight kicks and to
+ * serve a settled result on a later read of the same source. `obj` is the wrapper/handle
+ * pointer (see the two seams for exactly which), `sub` disambiguates mip (texture) or
+ * byte offset (buffer), and `span` disambiguates differently-sized reads of one buffer
+ * region. */
+struct SourceKey {
+  SourceKind kind = SourceKind::Texture;
+  const void *obj = nullptr;
+  uint64_t sub = 0;
+  uint64_t span = 0;
+};
+
+#ifdef __EMSCRIPTEN__
+
+/** KICK a texture readback: submit `CopyTextureToBuffer` of mip `key.sub` into a fresh
+ * MapRead staging buffer, then `MapAsync(AllowSpontaneous)` and RETURN. The completion
+ * (a later tick) strips the 256-byte row padding to a tight `row_bytes` pitch and latches
+ * the device bytes under `key`. Heap-owned throughout; nothing is captured from the
+ * caller stack. An identical in-flight key returns its existing ticket. Otherwise returns
+ * a new ticket, or kInvalidTicket if the kick could not be issued (no context, staging
+ * alloc failed, or the in-flight cap was hit). `depth_only` selects the depth aspect for
+ * depth textures. */
+Ticket kick_texture(const wgpu::Device &device,
+                    const wgpu::Queue &queue,
+                    const wgpu::Texture &tex,
+                    SourceKey key,
+                    uint32_t ex,
+                    uint32_t ey,
+                    uint32_t ez,
+                    uint32_t texel_bytes,
+                    uint32_t bytes_per_row,
+                    uint32_t row_bytes,
+                    bool depth_only);
+
+/** KICK a buffer readback: `CopyBufferToBuffer(handle, offset, staging, 0, copy)` +
+ * `MapAsync(AllowSpontaneous)`. `want` (<= copy) bytes are latched under `key` when the
+ * map resolves. The underlying buffer handle is pinned in the record so its raw address
+ * cannot be reused while a result for it is live (no stale key hits). An identical
+ * in-flight key returns its existing ticket; otherwise returns a new ticket or
+ * kInvalidTicket. */
+Ticket kick_buffer(const wgpu::Device &device,
+                   const wgpu::Queue &queue,
+                   const wgpu::Buffer &handle,
+                   SourceKey key,
+                   uint64_t offset,
+                   uint64_t copy,
+                   uint64_t want);
+
+/** CONSUME the latched device bytes for `key`, if a settled record exists whose payload
+ * is exactly `dst_len` bytes. Copies into `dst` and returns true (the record is kept so
+ * repeated reads keep hitting until the source is forgotten or the slot is evicted).
+ * Returns false when nothing is settled for `key` (the caller then sees the conservative
+ * interim: zeros/empty). This is the "return the latched bytes when settled" half. */
+bool take_settled(SourceKey key, void *dst, size_t dst_len);
+
+/** True once the kick with this ticket has latched its result. */
+bool is_ready(Ticket ticket);
+
+/** Copy this exact ticket's immutable bytes into `dst` (up to `dst_len`) if ready; returns
+ * the number of bytes copied, or 0 if not ready / unknown ticket. A later kick for the same
+ * source cannot change this result. Ticket-addressed consume for the async GPU API (L-B). */
+size_t consume_ticket(Ticket ticket, void *dst, size_t dst_len);
+
+/** Number of kicks whose map completion has not fired yet. A settle barrier pumps ticks
+ * until this reaches 0 (or a bounded budget). */
+int pending_count();
+
+/** Per-tick maintenance hook a WM-loop settle barrier may call: evicts stale settled
+ * records beyond the retention cap. The AllowSpontaneous completions do NOT need this to
+ * fire (they ride the loop on their own); it is bookkeeping only. Safe to never call. */
+void pump();
+
+/** Drop every pending/settled record that references the exact (`kind`, `obj`) source.
+ * In-flight pending records are marked orphaned so their completion discards instead of
+ * latching a result for a dead key. Kind is required because texture-wrapper and buffer-
+ * handle addresses may coincide. Called when a texture is destroyed or re-adopted. */
+void forget_source(SourceKind kind, const void *obj);
+
+#else /* !__EMSCRIPTEN__ : native keeps the verbatim blocking read; this is all inert. */
+
+inline bool take_settled(SourceKey /*key*/, void * /*dst*/, size_t /*dst_len*/)
+{
+  return false;
+}
+inline bool is_ready(Ticket /*ticket*/)
+{
+  return false;
+}
+inline size_t consume_ticket(Ticket /*ticket*/, void * /*dst*/, size_t /*dst_len*/)
+{
+  return 0;
+}
+inline int pending_count()
+{
+  return 0;
+}
+inline void pump() {}
+inline void forget_source(SourceKind /*kind*/, const void * /*obj*/) {}
+
+#endif /* __EMSCRIPTEN__ */
+
+}  // namespace blender::gpu::webgpu::readback
