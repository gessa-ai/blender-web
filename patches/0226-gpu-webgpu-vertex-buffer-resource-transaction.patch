+/** Resolve every buffer required by a vertex plan before command encoding begins. A missing
+ * real or dummy buffer invalidates the whole draw; WebGPU requires every pipeline-declared
+ * vertex-buffer slot to be set. Failure leaves the caller-owned result unchanged. */
+template<typename BindingRangeT, typename HandleT, typename ResolveFn>
+inline bool vertex_buffer_handles_resolve_if_valid(const BindingRangeT &bindings,
+                                                   ResolveFn &&resolve,
+                                                   std::vector<HandleT> &result)
+{
+  std::vector<HandleT> candidate;
+  candidate.reserve(bindings.size());
+  for (const auto &binding : bindings) {
+    HandleT handle = resolve(binding);
+    if (handle == nullptr) {
+      return false;
+    }
+    candidate.push_back(std::move(handle));
+  }
+  result = std::move(candidate);
+  return true;
+}
