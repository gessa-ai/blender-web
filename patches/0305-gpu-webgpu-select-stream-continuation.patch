@@ -4051,8 +4051,43 @@
   wmWindow *window = nullptr;
   int tick_count = 0;
   ParticleEditDepthCacheSession *particle_depth_session = nullptr;
+#ifdef __EMSCRIPTEN__
+  Vector<wmEvent> queued_events;
+#endif
 };
 
+#ifdef __EMSCRIPTEN__
+static bool view3d_select_async_event_push(View3DSelectAsyncData *data, const wmEvent *event)
+{
+  constexpr int max_queued_events = 512;
+  if (data->queued_events.size() >= max_queued_events) {
+    return false;
+  }
+  wmEvent queued = *event;
+  queued.next = nullptr;
+  queued.prev = nullptr;
+  queued.custom = 0;
+  queued.customdata_free = 0;
+  queued.customdata = nullptr;
+  data->queued_events.append(queued);
+  return true;
+}
+
+static void view3d_select_async_events_requeue(bContext *C, View3DSelectAsyncData *data)
+{
+  if (CTX_wm_manager(C) != data->manager || CTX_wm_window(C) != data->window) {
+    return;
+  }
+  /* These inputs originally preceded anything still in the WM queue. Add each copy normally,
+   * then move it to the head in reverse order so the exact captured FIFO is restored. */
+  for (int64_t index = data->queued_events.size() - 1; index >= 0; index--) {
+    wmEvent *queued = WM_event_add(data->window, &data->queued_events[index]);
+    BLI_remlink(&data->window->runtime->event_queue, queued);
+    BLI_addhead(&data->window->runtime->event_queue, queued);
+  }
+}
+#endif
+
