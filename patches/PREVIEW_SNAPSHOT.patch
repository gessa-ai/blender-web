+/* SPDX-FileCopyrightText: 2022 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_framebuffer.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WGPUFrameBuffer. See wgpu_framebuffer.hh. */
+
+
+#include "wgpu_framebuffer.hh"
+
+#include "wgpu_context.hh"
+#include "wgpu_common.hh"
+#include "wgpu_state_manager.hh"
+#include "wgpu_texture.hh"
+
+#include "GPU_context.hh"
+#include "gpu_context_private.hh"
+#include "gpu_readback_private.hh"
+
+#include "BLI_math_vector_types.hh"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <functional>
+#include <limits>
+#include <memory>
+#include <vector>
+
+
+namespace blender::gpu {
+
+static WGPUContext *active_context()
+{
+  return static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
+}
+
+static webgpu::WGPUTexture *as_wgpu(Texture *tex)
+{
+  return static_cast<webgpu::WGPUTexture *>(tex);
+}
+
+/** A render-attachment view for one Blender attachment (its mip / layer / cube
+ * face). Default view for the common mip-0, whole-texture 2D case. */
+static wgpu::TextureView attachment_view(
+    const GPUAttachment &att,
+    int force_layer = -1,
+    const webgpu::TextureViewValidationScope validation_scope =
+        webgpu::TextureViewValidationScope::Standalone)
+{
+  webgpu::WGPUTexture *wt = as_wgpu(att.tex);
+  /* Render passes always bind one exact layer. A negative frontend layer denotes
+   * layered rendering; the WebGPU pass-per-layer emulation supplies force_layer,
+   * otherwise the first layer of this view's own subset is used. */
+  const int layer = (force_layer >= 0) ? force_layer : std::max(att.layer, 0);
+  return wt->attachment_view(std::max(att.mip, 0), layer, validation_scope);
+}
+
+static uint32_t attachment_depth_slice(const GPUAttachment &att, int force_layer = -1)
+{
+  webgpu::WGPUTexture *wt = as_wgpu(att.tex);
+  const int layer = (force_layer >= 0) ? force_layer : std::max(att.layer, 0);
+  return wt->attachment_depth_slice(std::max(att.mip, 0), layer);
+}
+
+WGPUFrameBuffer::WGPUFrameBuffer(const char *name) : FrameBuffer(name)
+{
+  /* Default: LOAD + store. WebGPU lazily zero-initializes attachments, so LOAD on
+   * an untouched fb reads zeros — identical to a zero-clear but WITHOUT erasing
+   * content when begin_load_pass honors these actions (a CLEAR default wiped
+   * region buffers that draw once and are then only composited, e.g. the status
+   * bar). Passes that need clears record them via attachment_set_loadstore_op. */
+  for (int i = 0; i < GPU_FB_MAX_ATTACHMENT; i++) {
+    load_store_[i] = {GPU_LOADACTION_LOAD, GPU_STOREACTION_STORE, {0.0, 0.0, 0.0, 0.0}};
+  }
+}
+
+WGPUFrameBuffer::~WGPUFrameBuffer()
+{
+  empty_render_attachment_view_ = nullptr;
+  empty_render_attachment_ = nullptr;
+}
+
+bool WGPUFrameBuffer::needs_empty_render_attachment() const
+{
+  for (int slot = 0; slot < GPU_FB_MAX_COLOR_ATTACHMENT; slot++) {
+    const bool active = (color_attachments_bits_ & (1u << slot)) != 0;
+    if (color_tex(slot) != nullptr && active) {
+      return false;
+    }
+  }
+  return depth_tex() == nullptr && width_ > 0 && height_ > 0;
+}
+
+bool WGPUFrameBuffer::ensure_empty_render_attachment() const
+{
+  if (!needs_empty_render_attachment()) {
+    return false;
+  }
+  const int2 size(width_, height_);
+  if (empty_render_attachment_ != nullptr && empty_render_attachment_view_ != nullptr &&
+      empty_render_attachment_size_ == size)
+  {
+    return true;
+  }
+
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr || ctx->instance_get() == nullptr || ctx->device_get() == nullptr) {
+    return false;
+  }
+
+  wgpu::TextureDescriptor texture_desc = {};
+  texture_desc.label = "Blender empty framebuffer compatibility attachment";
+  texture_desc.usage = wgpu::TextureUsage::RenderAttachment;
+  texture_desc.dimension = wgpu::TextureDimension::e2D;
+  texture_desc.size = {uint32_t(width_), uint32_t(height_), 1};
+  texture_desc.format = wgpu::TextureFormat::R8Unorm;
+  texture_desc.mipLevelCount = 1;
+  texture_desc.sampleCount = 1;
+  wgpu::TextureViewDescriptor view_desc = {};
+  view_desc.label = "Blender empty framebuffer compatibility view";
+  view_desc.format = wgpu::TextureFormat::R8Unorm;
+  view_desc.dimension = wgpu::TextureViewDimension::e2D;
+  view_desc.baseMipLevel = 0;
+  view_desc.mipLevelCount = 1;
+  view_desc.baseArrayLayer = 0;
+  view_desc.arrayLayerCount = 1;
+  view_desc.aspect = wgpu::TextureAspect::All;
+  const uint64_t cache_key = (uint64_t(uint32_t(width_)) << 32) | uint32_t(height_);
+  const EmptyRenderAttachment candidate = empty_render_attachment_cache_.get_or_create(
+      ctx->instance_get(),
+      ctx->device_get(),
+      cache_key,
+      "empty framebuffer compatibility attachment creation",
+      [&]() {
+        EmptyRenderAttachment result;
+        result.texture = ctx->device_get().CreateTexture(&texture_desc);
+        if (result.texture == nullptr) {
+          return EmptyRenderAttachment{};
+        }
+        result.view = result.texture.CreateView(&view_desc);
+        if (result.view == nullptr) {
+          return EmptyRenderAttachment{};
+        }
+        result.size = size;
+        return result;
+      });
+  if (candidate == nullptr) {
+    return false;
+  }
+
+  empty_render_attachment_ = candidate.texture;
+  empty_render_attachment_view_ = candidate.view;
+  empty_render_attachment_size_ = candidate.size;
+  /* The accepted pair is now held directly. Retire this one-shot cache state so a future resize
+   * cannot accumulate one backing allocation per historical extent. */
+  empty_render_attachment_cache_ = {};
+  return true;
+}
+
+void WGPUFrameBuffer::update_size()
+{
+  for (int i = 0; i < GPU_FB_MAX_ATTACHMENT; i++) {
+    if (attachments_[i].tex != nullptr) {
+      const GPUAttachment &att = attachments_[i];
+      webgpu::WGPUTexture::ResolvedReadRegion region;
+      if (as_wgpu(att.tex)->resolve_subresource(std::max(att.mip, 0),
+                                                std::max(att.layer, 0),
+                                                region))
+      {
+        width_ = int(region.width);
+        height_ = int(region.height);
+      }
+      return;
+    }
+  }
+}
+
+void WGPUFrameBuffer::bind(bool /*enabled_srgb*/)
+{
+  /* WebGPU has no persistent bound framebuffer; record this as the context's active
+   * one (the frontend reads Context::active_fb) and refresh derived state. The
+   * render pass itself is built per clear / per draw. */
+  Context *ctx = Context::get();
+  if (ctx != nullptr) {
+    ctx->active_fb = this;
+  }
+  if (dirty_attachments_) {
+    update_size();
+    dirty_attachments_ = false;
+  }
+  if (!needs_empty_render_attachment() && empty_render_attachment_ != nullptr) {
+    empty_render_attachment_view_ = nullptr;
+    empty_render_attachment_ = nullptr;
+    empty_render_attachment_size_ = int2(0);
+  }
+  viewport_reset();
+  scissor_reset();
+}
+
+bool WGPUFrameBuffer::check(char err_out[256])
+{
+  for (const GPUAttachment &attachment : attachments_) {
+    if (attachment.tex != nullptr && attachment_view(attachment) == nullptr) {
+      if (err_out != nullptr) {
+        std::strcpy(err_out,
+                    "WebGPU framebuffer attachment lacks RenderAttachment capability");
+      }
+      return false;
+    }
+  }
+  /* Remaining attachment size/format consistency is validated by WebGPU at
+   * render-pass creation. */
+  return true;
+}
+
+bool WGPUFrameBuffer::submit_scissored_color_clear(
+    const GPUAttachment &attachment,
+    int force_layer,
+    const double4 &clear_value,
+    const webgpu::FramebufferClearPlan &plan)
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr || attachment.tex == nullptr || plan.width == 0 || plan.height == 0) {
+    return false;
+  }
+  webgpu::WGPUTexture *texture = as_wgpu(attachment.tex);
+  wgpu::TextureView view = attachment_view(attachment, force_layer);
+  if (view == nullptr || !texture->subresource_range().valid()) {
+    return false;
+  }
+
+  const GPUTextureFormatFlag format_flags = attachment.tex->format_flag_get();
+  const webgpu::FramebufferClearShaderType shader_type =
+      webgpu::framebuffer_clear_color_shader_type(bool(format_flags & GPU_FORMAT_INTEGER),
+                                                  bool(format_flags & GPU_FORMAT_SIGNED));
+  if (shader_type == webgpu::FramebufferClearShaderType::Depth) {
+    return false;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  const uint32_t module_key = uint32_t(shader_type);
+  const wgpu::ShaderModule module = scissored_clear_modules_.get_or_create(
+      ctx->instance_get(),
+      device,
+      module_key,
+      "scissored color-clear shader-module creation",
+      [&]() {
+        wgpu::ShaderSourceWGSL source = {};
+        source.code = webgpu::framebuffer_clear_shader_source(shader_type);
+        wgpu::ShaderModuleDescriptor descriptor = {};
+        descriptor.nextInChain = &source;
+        return device.CreateShaderModule(&descriptor);
+      });
+  if (module == nullptr) {
+    return false;
+  }
+
+  const wgpu::TextureFormat format = texture->wgpu_format();
+  const uint32_t sample_count = texture->subresource_range().texture.GetSampleCount();
+  if (format == wgpu::TextureFormat::Undefined || sample_count == 0) {
+    return false;
+  }
+  const uint64_t pipeline_key = uint64_t(uint32_t(format)) | (uint64_t(sample_count) << 32);
+  const wgpu::RenderPipeline pipeline = scissored_color_clear_pipelines_.get_or_create(
+      ctx->instance_get(),
+      device,
+      pipeline_key,
+      "scissored color-clear render-pipeline creation",
+      [&]() {
+        wgpu::ColorTargetState target = {};
+        target.format = format;
+        target.writeMask = wgpu::ColorWriteMask::All;
+        wgpu::FragmentState fragment = {};
+        fragment.module = module;
+        fragment.entryPoint = "fs_main";
+        fragment.targetCount = 1;
+        fragment.targets = &target;
+        wgpu::RenderPipelineDescriptor descriptor = {};
+        descriptor.layout = nullptr;
+        descriptor.vertex.module = module;
+        descriptor.vertex.entryPoint = "vs_main";
+        descriptor.primitive.topology = wgpu::PrimitiveTopology::TriangleList;
+        descriptor.multisample.count = sample_count;
+        descriptor.fragment = &fragment;
+        return device.CreateRenderPipeline(&descriptor);
+      });
+  if (pipeline == nullptr) {
+    return false;
+  }
+
+  uint32_t clear_payload[4] = {};
+  if (shader_type == webgpu::FramebufferClearShaderType::Uint) {
+    for (int component = 0; component < 4; component++) {
+      clear_payload[component] = uint32_t(clear_value[component]);
+    }
+  }
+  else if (shader_type == webgpu::FramebufferClearShaderType::Sint) {
+    int32_t signed_payload[4];
+    for (int component = 0; component < 4; component++) {
+      signed_payload[component] = int32_t(clear_value[component]);
+    }
+    std::memcpy(clear_payload, signed_payload, sizeof(clear_payload));
+  }
+  else {
+    float float_payload[4];
+    for (int component = 0; component < 4; component++) {
+      float_payload[component] = float(clear_value[component]);
+    }
+    std::memcpy(clear_payload, float_payload, sizeof(clear_payload));
+  }
+
+  wgpu::BufferDescriptor uniform_descriptor = {};
+  uniform_descriptor.size = sizeof(clear_payload);
+  uniform_descriptor.usage = wgpu::BufferUsage::Uniform;
+  uniform_descriptor.mappedAtCreation = true;
+  wgpu::Buffer uniform = device.CreateBuffer(&uniform_descriptor);
+  if (uniform == nullptr) {
+    return false;
+  }
+  void *mapped = uniform.GetMappedRange(0, sizeof(clear_payload));
+  if (mapped == nullptr) {
+    uniform.Unmap();
+    return false;
+  }
+  std::memcpy(mapped, clear_payload, sizeof(clear_payload));
+  uniform.Unmap();
+
+  wgpu::BindGroupEntry entry = {};
+  entry.binding = 0;
+  entry.buffer = uniform;
+  entry.offset = 0;
+  entry.size = sizeof(clear_payload);
+  wgpu::BindGroupDescriptor bind_descriptor = {};
+  bind_descriptor.layout = pipeline.GetBindGroupLayout(0);
+  bind_descriptor.entryCount = 1;
+  bind_descriptor.entries = &entry;
+  wgpu::BindGroup bind_group = webgpu::transient_resource_create_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_scheduler_get(),
+      "scissored color-clear bind group",
+      [&]() { return device.CreateBindGroup(&bind_descriptor); },
+      [](bool) {});
+  if (bind_group == nullptr) {
+    return false;
+  }
+
+  wgpu::RenderPassColorAttachment color = {};
+  color.view = view;
+  color.depthSlice = attachment_depth_slice(attachment, force_layer);
+  color.loadOp = wgpu::LoadOp::Load;
+  color.storeOp = wgpu::StoreOp::Store;
+  color.clearValue = {0.0, 0.0, 0.0, 0.0};
+  wgpu::RenderPassDescriptor pass_descriptor = {};
+  pass_descriptor.colorAttachmentCount = 1;
+  pass_descriptor.colorAttachments = &color;
+  webgpu::command_pass_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "scissored color clear",
+      [&](auto &encoder) { return encoder.BeginRenderPass(&pass_descriptor); },
+      [&](auto &pass) {
+        pass.SetPipeline(pipeline);
+        pass.SetScissorRect(plan.x, plan.y, plan.width, plan.height);
+        pass.SetBindGroup(0, bind_group);
+        pass.Draw(3, 1, 0, 0);
+      },
+      [](bool) {});
+  return true;
+}
+
+bool WGPUFrameBuffer::submit_scissored_depth_stencil_clear(
+    const GPUAttachment &attachment,
+    int force_layer,
+    bool clear_depth,
+    float clear_depth_value,
+    bool clear_stencil,
+    uint clear_stencil_value,
+    const webgpu::FramebufferClearPlan &plan)
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr || attachment.tex == nullptr || (!clear_depth && !clear_stencil) ||
+      plan.width == 0 || plan.height == 0)
+  {
+    return false;
+  }
+  webgpu::WGPUTexture *texture = as_wgpu(attachment.tex);
+  wgpu::TextureView view = attachment_view(attachment, force_layer);
+  if (view == nullptr || !texture->subresource_range().valid()) {
+    return false;
+  }
+  const wgpu::TextureFormat format = texture->wgpu_format();
+  const bool combined = ELEM(format,
+                             wgpu::TextureFormat::Depth24PlusStencil8,
+                             wgpu::TextureFormat::Depth32FloatStencil8);
+  if (clear_stencil && !combined) {
+    return false;
+  }
+  const uint32_t sample_count = texture->subresource_range().texture.GetSampleCount();
+  if (format == wgpu::TextureFormat::Undefined || sample_count == 0) {
+    return false;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  const uint32_t module_key = uint32_t(webgpu::FramebufferClearShaderType::Depth);
+  const wgpu::ShaderModule module = scissored_clear_modules_.get_or_create(
+      ctx->instance_get(),
+      device,
+      module_key,
+      "scissored depth-stencil-clear shader-module creation",
+      [&]() {
+        wgpu::ShaderSourceWGSL source = {};
+        source.code = webgpu::framebuffer_clear_shader_source(
+            webgpu::FramebufferClearShaderType::Depth);
+        wgpu::ShaderModuleDescriptor descriptor = {};
+        descriptor.nextInChain = &source;
+        return device.CreateShaderModule(&descriptor);
+      });
+  if (module == nullptr) {
+    return false;
+  }
+
+  const uint64_t pipeline_key = uint64_t(uint32_t(format)) | (uint64_t(sample_count) << 32) |
+                                (uint64_t(clear_depth ? 1u : 0u) << 48) |
+                                (uint64_t(clear_stencil ? 1u : 0u) << 49);
+  const wgpu::RenderPipeline pipeline = scissored_depth_clear_pipelines_.get_or_create(
+      ctx->instance_get(),
+      device,
+      pipeline_key,
+      "scissored depth-stencil-clear render-pipeline creation",
+      [&]() {
+        wgpu::FragmentState fragment = {};
+        fragment.module = module;
+        fragment.entryPoint = "fs_main";
+        wgpu::DepthStencilState depth_stencil = {};
+        depth_stencil.format = format;
+        depth_stencil.depthWriteEnabled = clear_depth ? wgpu::OptionalBool::True :
+                                                       wgpu::OptionalBool::False;
+        depth_stencil.depthCompare = wgpu::CompareFunction::Always;
+        if (combined) {
+          depth_stencil.stencilFront.compare = wgpu::CompareFunction::Always;
+          depth_stencil.stencilFront.failOp = wgpu::StencilOperation::Keep;
+          depth_stencil.stencilFront.depthFailOp = clear_stencil ?
+                                                       wgpu::StencilOperation::Replace :
+                                                       wgpu::StencilOperation::Keep;
+          depth_stencil.stencilFront.passOp = clear_stencil ? wgpu::StencilOperation::Replace :
+                                                             wgpu::StencilOperation::Keep;
+          depth_stencil.stencilBack = depth_stencil.stencilFront;
+          depth_stencil.stencilReadMask = 0xffu;
+          depth_stencil.stencilWriteMask = clear_stencil ? 0xffu : 0u;
+        }
+        wgpu::RenderPipelineDescriptor descriptor = {};
+        descriptor.layout = nullptr;
+        descriptor.vertex.module = module;
+        descriptor.vertex.entryPoint = "vs_main";
+        descriptor.primitive.topology = wgpu::PrimitiveTopology::TriangleList;
+        descriptor.multisample.count = sample_count;
+        descriptor.fragment = &fragment;
+        descriptor.depthStencil = &depth_stencil;
+        return device.CreateRenderPipeline(&descriptor);
+      });
+  if (pipeline == nullptr) {
+    return false;
+  }
+
+  const float depth_payload[4] = {
+      std::isfinite(clear_depth_value) ? clear_depth_value : 1.0f, 0.0f, 0.0f, 0.0f};
+  wgpu::BufferDescriptor uniform_descriptor = {};
+  uniform_descriptor.size = sizeof(depth_payload);
+  uniform_descriptor.usage = wgpu::BufferUsage::Uniform;
+  uniform_descriptor.mappedAtCreation = true;
+  wgpu::Buffer uniform = device.CreateBuffer(&uniform_descriptor);
+  if (uniform == nullptr) {
+    return false;
+  }
+  void *mapped = uniform.GetMappedRange(0, sizeof(depth_payload));
+  if (mapped == nullptr) {
+    uniform.Unmap();
+    return false;
+  }
+  std::memcpy(mapped, depth_payload, sizeof(depth_payload));
+  uniform.Unmap();
+
+  wgpu::BindGroupEntry entry = {};
+  entry.binding = 0;
+  entry.buffer = uniform;
+  entry.offset = 0;
+  entry.size = sizeof(depth_payload);
+  wgpu::BindGroupDescriptor bind_descriptor = {};
+  bind_descriptor.layout = pipeline.GetBindGroupLayout(0);
+  bind_descriptor.entryCount = 1;
+  bind_descriptor.entries = &entry;
+  wgpu::BindGroup bind_group = webgpu::transient_resource_create_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_scheduler_get(),
+      "scissored depth-stencil-clear bind group",
+      [&]() { return device.CreateBindGroup(&bind_descriptor); },
+      [](bool) {});
+  if (bind_group == nullptr) {
+    return false;
+  }
+
+  wgpu::RenderPassDepthStencilAttachment depth_stencil = {};
+  depth_stencil.view = view;
+  depth_stencil.depthLoadOp = wgpu::LoadOp::Load;
+  depth_stencil.depthStoreOp = wgpu::StoreOp::Store;
+  depth_stencil.depthClearValue = 1.0f;
+  if (combined) {
+    depth_stencil.stencilLoadOp = wgpu::LoadOp::Load;
+    depth_stencil.stencilStoreOp = wgpu::StoreOp::Store;
+    depth_stencil.stencilClearValue = 0u;
+  }
+  wgpu::RenderPassDescriptor pass_descriptor = {};
+  pass_descriptor.depthStencilAttachment = &depth_stencil;
+  webgpu::command_pass_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "scissored depth-stencil clear",
+      [&](auto &encoder) { return encoder.BeginRenderPass(&pass_descriptor); },
+      [&](auto &pass) {
+        pass.SetPipeline(pipeline);
+        pass.SetScissorRect(plan.x, plan.y, plan.width, plan.height);
+        pass.SetBindGroup(0, bind_group);
+        if (clear_stencil) {
+          pass.SetStencilReference(clear_stencil_value);
+        }
+        pass.Draw(3, 1, 0, 0);
+      },
+      [](bool) {});
+  return true;
+}
+
+bool WGPUFrameBuffer::submit_scissored_clear(GPUFrameBufferBits buffers,
+                                              Span<double4> colors,
+                                              float clear_depth,
+                                              uint clear_stencil,
+                                              const webgpu::FramebufferClearPlan &plan)
+{
+  uint32_t pass_count = 1;
+  for (int index = 0; index < GPU_FB_MAX_ATTACHMENT; index++) {
+    const GPUAttachment &attachment = attachments_[index];
+    if (attachment.tex != nullptr && attachment.layer < 0) {
+      pass_count = std::max(
+          pass_count,
+          as_wgpu(attachment.tex)->attachment_layer_count(std::max(attachment.mip, 0)));
+    }
+  }
+
+  for (uint32_t pass_layer = 0; pass_layer < pass_count; pass_layer++) {
+    if (buffers & GPU_COLOR_BIT) {
+      if (colors.is_empty()) {
+        return false;
+      }
+      for (int slot = 0; slot < GPU_FB_MAX_COLOR_ATTACHMENT; slot++) {
+        Texture *texture = color_tex(slot);
+        if (texture == nullptr) {
+          continue;
+        }
+        const GPUAttachment &attachment = attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot];
+        int force_layer;
+        const webgpu::FramebufferClearPassStatus status =
+            webgpu::framebuffer_clear_pass_layer(
+                attachment.layer,
+                as_wgpu(texture)->attachment_layer_count(std::max(attachment.mip, 0)),
+                pass_layer,
+                force_layer);
+        if (status == webgpu::FramebufferClearPassStatus::Invalid) {
+          return false;
+        }
+        if (status == webgpu::FramebufferClearPassStatus::Inactive) {
+          continue;
+        }
+        const double4 &color =
+            colors[(colors.size() == 1) ? 0 : std::min<int>(slot, colors.size() - 1)];
+        if (!submit_scissored_color_clear(attachment, force_layer, color, plan)) {
+          return false;
+        }
+      }
+    }
+
+    Texture *depth_texture = depth_tex();
+    if (depth_texture == nullptr || !(buffers & (GPU_DEPTH_BIT | GPU_STENCIL_BIT))) {
+      continue;
+    }
+    const GPUAttachment &attachment = depth_attachment();
+    int force_layer;
+    const webgpu::FramebufferClearPassStatus status = webgpu::framebuffer_clear_pass_layer(
+        attachment.layer,
+        as_wgpu(depth_texture)->attachment_layer_count(std::max(attachment.mip, 0)),
+        pass_layer,
+        force_layer);
+    if (status == webgpu::FramebufferClearPassStatus::Invalid) {
+      return false;
+    }
+    if (status == webgpu::FramebufferClearPassStatus::Inactive) {
+      continue;
+    }
+    const wgpu::TextureAspect selected_aspect =
+        as_wgpu(depth_texture)->subresource_range().aspect;
+    const bool clear_depth_aspect = selected_aspect != wgpu::TextureAspect::StencilOnly &&
+                                    bool(buffers & GPU_DEPTH_BIT);
+    const bool clear_stencil_aspect = selected_aspect != wgpu::TextureAspect::DepthOnly &&
+                                      bool(buffers & GPU_STENCIL_BIT) &&
+                                      depth_texture->format_get() ==
+                                          TextureFormat::SFLOAT_32_DEPTH_UINT_8;
+    if ((clear_depth_aspect || clear_stencil_aspect) &&
+        !submit_scissored_depth_stencil_clear(attachment,
+                                               force_layer,
+                                               clear_depth_aspect,
+                                               clear_depth,
+                                               clear_stencil_aspect,
+                                               clear_stencil,
+                                               plan))
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool WGPUFrameBuffer::submit_clear(GPUFrameBufferBits buffers,
+                                   Span<double4> colors,
+                                   float clear_depth,
+                                   uint clear_stencil,
+                                   bool force_full_attachment,
+                                   std::function<void(bool)> completion)
+{
+  const auto reject = [&completion]() {
+    if (completion) {
+      completion(false);
+    }
+    return false;
+  };
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return reject();
+  }
+
+  uint8_t clear_aspects = 0;
+  clear_aspects |= (buffers & GPU_COLOR_BIT) ?
+                       uint8_t(webgpu::FramebufferClearAspect::Color) :
+                       0u;
+  clear_aspects |= (buffers & GPU_DEPTH_BIT) ?
+                       uint8_t(webgpu::FramebufferClearAspect::Depth) :
+                       0u;
+  clear_aspects |= (buffers & GPU_STENCIL_BIT) ?
+                       uint8_t(webgpu::FramebufferClearAspect::Stencil) :
+                       0u;
+  webgpu::FramebufferClearPlan clear_plan;
+  if (force_full_attachment) {
+    if (width_ <= 0 || height_ <= 0 || clear_aspects == 0) {
+      return reject();
+    }
+    clear_plan.method = webgpu::FramebufferClearMethod::FullAttachmentLoadOp;
+    clear_plan.aspects = clear_aspects;
+    clear_plan.width = uint32_t(width_);
+    clear_plan.height = uint32_t(height_);
+  }
+  else {
+    int scissor[4];
+    const int *active_scissor = nullptr;
+    if (scissor_test_get()) {
+      scissor_get(scissor);
+      active_scissor = scissor;
+    }
+    if (!webgpu::framebuffer_clear_plan(active_scissor,
+                                        width_,
+                                        height_,
+                                        clear_aspects,
+                                        clear_plan) ||
+        clear_plan.method == webgpu::FramebufferClearMethod::NoOp)
+    {
+      return reject();
+    }
+  }
+  if (clear_plan.method == webgpu::FramebufferClearMethod::ScissoredDraw) {
+    const bool accepted = submit_scissored_clear(
+        buffers, colors, clear_depth, clear_stencil, clear_plan);
+    if (completion) {
+      completion(accepted);
+    }
+    return accepted;
+  }
+
+  wgpu::Device device = ctx->device_get();
+
+  /* A negative attachment layer means the frontend selected every layer. WebGPU
+   * render attachments are single-layer, so submit one exact pass per layer. */
+  uint32_t pass_count = 1;
+  for (int i = 0; i < GPU_FB_MAX_ATTACHMENT; i++) {
+    const GPUAttachment &att = attachments_[i];
+    if (att.tex != nullptr && att.layer < 0) {
+      pass_count = std::max(
+          pass_count,
+          as_wgpu(att.tex)->attachment_layer_count(std::max(att.mip, 0)));
+    }
+  }
+
+  struct ClearPass {
+    std::vector<wgpu::RenderPassColorAttachment> colors;
+    wgpu::RenderPassDepthStencilAttachment depth_stencil = {};
+    bool has_depth = false;
+  };
+  std::vector<ClearPass> clear_passes;
+  clear_passes.reserve(pass_count);
+  for (uint32_t pass_layer = 0; pass_layer < pass_count; pass_layer++) {
+    ClearPass clear_pass;
+    std::vector<wgpu::RenderPassColorAttachment> color_atts;
+    for (int slot = 0; slot < GPU_FB_MAX_COLOR_ATTACHMENT; slot++) {
+      Texture *tex = color_tex(slot);
+      if (tex == nullptr) {
+        continue;
+      }
+      const GPUAttachment &att = attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot];
+      const uint32_t layer_count =
+          as_wgpu(att.tex)->attachment_layer_count(std::max(att.mip, 0));
+      int force_layer;
+      const webgpu::FramebufferClearPassStatus clear_status =
+          webgpu::framebuffer_clear_pass_layer(
+              att.layer, layer_count, pass_layer, force_layer);
+      if (clear_status == webgpu::FramebufferClearPassStatus::Invalid) {
+        return reject();
+      }
+      if (clear_status == webgpu::FramebufferClearPassStatus::Inactive) {
+        continue;
+      }
+      wgpu::RenderPassColorAttachment ca = {};
+      ca.view = attachment_view(att, force_layer);
+      if (ca.view == nullptr) {
+        return reject();
+      }
+      ca.depthSlice = attachment_depth_slice(att, force_layer);
+      ca.loadOp = (buffers & GPU_COLOR_BIT) ? wgpu::LoadOp::Clear : wgpu::LoadOp::Load;
+      ca.storeOp = wgpu::StoreOp::Store;
+      /* Keep the unused Load clear value explicitly finite across native and web
+       * descriptor marshalling. */
+      ca.clearValue = {0.0, 0.0, 0.0, 0.0};
+      if (buffers & GPU_COLOR_BIT) {
+        const double4 &c =
+            colors[(colors.size() == 1) ? 0 : std::min<int>(slot, colors.size() - 1)];
+        ca.clearValue = {c[0], c[1], c[2], c[3]};
+      }
+      color_atts.push_back(ca);
+    }
+
+    Texture *dtex = depth_tex();
+    wgpu::RenderPassDepthStencilAttachment dsa = {};
+    bool has_depth = false;
+    if (dtex != nullptr) {
+      const GPUAttachment &att = depth_attachment();
+      const uint32_t layer_count =
+          as_wgpu(att.tex)->attachment_layer_count(std::max(att.mip, 0));
+      int force_layer;
+      const webgpu::FramebufferClearPassStatus clear_status =
+          webgpu::framebuffer_clear_pass_layer(
+              att.layer, layer_count, pass_layer, force_layer);
+      if (clear_status == webgpu::FramebufferClearPassStatus::Invalid) {
+        return reject();
+      }
+      if (clear_status == webgpu::FramebufferClearPassStatus::Active) {
+        has_depth = true;
+        const wgpu::TextureAspect selected_aspect =
+            as_wgpu(dtex)->subresource_range().aspect;
+        const bool permits_depth = selected_aspect != wgpu::TextureAspect::StencilOnly;
+        const bool permits_stencil = selected_aspect != wgpu::TextureAspect::DepthOnly;
+        dsa.view = attachment_view(att, force_layer);
+        if (dsa.view == nullptr) {
+          return reject();
+        }
+        dsa.depthLoadOp = (permits_depth && (buffers & GPU_DEPTH_BIT)) ?
+                              wgpu::LoadOp::Clear :
+                              wgpu::LoadOp::Load;
+        dsa.depthStoreOp = wgpu::StoreOp::Store;
+        dsa.depthClearValue = std::isfinite(clear_depth) ? clear_depth : 1.0f;
+        if (dtex->format_get() == TextureFormat::SFLOAT_32_DEPTH_UINT_8) {
+          dsa.stencilLoadOp = (permits_stencil && (buffers & GPU_STENCIL_BIT)) ?
+                                  wgpu::LoadOp::Clear :
+                                  wgpu::LoadOp::Load;
+          dsa.stencilStoreOp = wgpu::StoreOp::Store;
+          dsa.stencilClearValue = clear_stencil;
+        }
+      }
+    }
+
+    /* WebGPU rejects attachment-less render passes. Blender can transiently bind an
+     * empty framebuffer while rebuilding EEVEE pass state; clearing it is a no-op. */
+    if (color_atts.empty() && !has_depth) {
+      return reject();
+    }
+    clear_pass.colors = std::move(color_atts);
+    clear_pass.depth_stencil = dsa;
+    clear_pass.has_depth = has_depth;
+    clear_passes.push_back(std::move(clear_pass));
+  }
+
+  struct CompletionState {
+    std::atomic<uint32_t> pending{0};
+    std::atomic<bool> valid{true};
+    std::atomic<bool> completed{false};
+    std::function<void(bool)> complete;
+  };
+  std::shared_ptr<CompletionState> completion_state;
+  if (completion) {
+    completion_state = std::make_shared<CompletionState>();
+    completion_state->pending.store(uint32_t(clear_passes.size()), std::memory_order_release);
+    completion_state->complete = std::move(completion);
+  }
+
+  for (ClearPass &clear_pass : clear_passes) {
+    wgpu::RenderPassDescriptor rp = {};
+    rp.colorAttachmentCount = clear_pass.colors.size();
+    rp.colorAttachments = clear_pass.colors.empty() ? nullptr : clear_pass.colors.data();
+    rp.depthStencilAttachment = clear_pass.has_depth ? &clear_pass.depth_stencil : nullptr;
+    webgpu::command_pass_encode_submit_scoped(ctx->instance_get(),
+                                              device,
+                                              ctx->queue_get(),
+                                              ctx->queue_scheduler_get(),
+                                              "framebuffer full clear",
+                                              [&](auto &encoder) {
+                                                return encoder.BeginRenderPass(&rp);
+                                              },
+                                              [](auto & /*pass*/) {},
+                                              [completion_state](const bool valid) {
+                                                if (!completion_state) {
+                                                  return;
+                                                }
+                                                if (!valid) {
+                                                  completion_state->valid.store(
+                                                      false, std::memory_order_release);
+                                                }
+                                                if (completion_state->pending.fetch_sub(
+                                                        1, std::memory_order_acq_rel) == 1 &&
+                                                    !completion_state->completed.exchange(
+                                                        true, std::memory_order_acq_rel))
+                                                {
+                                                  completion_state->complete(
+                                                      completion_state->valid.load(
+                                                          std::memory_order_acquire));
+                                                }
+                                              });
+  }
+  return true;
+}
+
+void WGPUFrameBuffer::clear(GPUFrameBufferBits buffers,
+                            const double4 clear_color,
+                            float clear_depth,
+                            uint clear_stencil)
+{
+  double4 c = clear_color;
+  submit_clear(buffers, Span<double4>(&c, 1), clear_depth, clear_stencil);
+}
+
+void WGPUFrameBuffer::clear_multi(Span<double4> clear_cols)
+{
+  submit_clear(GPU_COLOR_BIT, clear_cols, 0.0f, 0u);
+}
+
+void WGPUFrameBuffer::clear_attachment(GPUAttachmentType type, const double4 clear_value)
+{
+  WGPUContext *ctx = active_context();
+  uint8_t clear_aspects = 0;
+  if (type == GPU_FB_DEPTH_ATTACHMENT || type == GPU_FB_DEPTH_STENCIL_ATTACHMENT) {
+    if (Texture *depth_texture = depth_tex()) {
+      const wgpu::TextureAspect aspect = as_wgpu(depth_texture)->subresource_range().aspect;
+      if (aspect != wgpu::TextureAspect::StencilOnly) {
+        clear_aspects |= uint8_t(webgpu::FramebufferClearAspect::Depth);
+      }
+      if (type == GPU_FB_DEPTH_STENCIL_ATTACHMENT &&
+          aspect != wgpu::TextureAspect::DepthOnly)
+      {
+        clear_aspects |= uint8_t(webgpu::FramebufferClearAspect::Stencil);
+      }
+    }
+  }
+  else if (type >= GPU_FB_COLOR_ATTACHMENT0 && type < GPU_FB_MAX_ATTACHMENT) {
+    clear_aspects = uint8_t(webgpu::FramebufferClearAspect::Color);
+  }
+  if (ctx == nullptr || clear_aspects == 0) {
+    return;
+  }
+
+  int scissor[4];
+  const int *active_scissor = nullptr;
+  if (scissor_test_get()) {
+    scissor_get(scissor);
+    active_scissor = scissor;
+  }
+  webgpu::FramebufferClearPlan clear_plan;
+  if (!webgpu::framebuffer_clear_plan(active_scissor,
+                                      width_,
+                                      height_,
+                                      clear_aspects,
+                                      clear_plan) ||
+      clear_plan.method == webgpu::FramebufferClearMethod::NoOp)
+  {
+    return;
+  }
+  if (clear_plan.method == webgpu::FramebufferClearMethod::FullAttachmentLoadOp) {
+    clear_attachment_full(type, clear_value);
+    return;
+  }
+
+  if (type == GPU_FB_DEPTH_ATTACHMENT || type == GPU_FB_DEPTH_STENCIL_ATTACHMENT) {
+    GPUFrameBufferBits bits = GPUFrameBufferBits(0);
+    if (clear_aspects & uint8_t(webgpu::FramebufferClearAspect::Depth)) {
+      bits |= GPU_DEPTH_BIT;
+    }
+    if (clear_aspects & uint8_t(webgpu::FramebufferClearAspect::Stencil)) {
+      bits |= GPU_STENCIL_BIT;
+    }
+    submit_scissored_clear(
+        bits, Span<double4>(), float(clear_value[0]), uint(clear_value[1]), clear_plan);
+    return;
+  }
+
+  const int slot = type - GPU_FB_COLOR_ATTACHMENT0;
+  Texture *texture = color_tex(slot);
+  if (texture == nullptr) {
+    return;
+  }
+  const GPUAttachment &attachment = attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot];
+  const uint32_t layer_count =
+      as_wgpu(texture)->attachment_layer_count(std::max(attachment.mip, 0));
+  const uint32_t pass_count = attachment.layer < 0 ? layer_count : 1u;
+  for (uint32_t pass_layer = 0; pass_layer < pass_count; pass_layer++) {
+    int force_layer;
+    const webgpu::FramebufferClearPassStatus status = webgpu::framebuffer_clear_pass_layer(
+        attachment.layer, layer_count, pass_layer, force_layer);
+    if (status == webgpu::FramebufferClearPassStatus::Invalid) {
+      return;
+    }
+    if (status == webgpu::FramebufferClearPassStatus::Active &&
+        !submit_scissored_color_clear(attachment, force_layer, clear_value, clear_plan))
+    {
+      return;
+    }
+  }
+}
+
+bool WGPUFrameBuffer::clear_attachment_full(GPUAttachmentType type,
+                                            const double4 clear_value,
+                                            std::function<void(bool)> completion)
+{
+  const auto reject = [&completion]() {
+    if (completion) {
+      completion(false);
+    }
+    return false;
+  };
+  /* Clear a single attachment via a scoped render pass touching only it. */
+  if (type == GPU_FB_DEPTH_ATTACHMENT || type == GPU_FB_DEPTH_STENCIL_ATTACHMENT) {
+    GPUFrameBufferBits bits = GPUFrameBufferBits(0);
+    if (Texture *dtex = depth_tex()) {
+      const wgpu::TextureAspect aspect = as_wgpu(dtex)->subresource_range().aspect;
+      if (aspect != wgpu::TextureAspect::StencilOnly) {
+        bits |= GPU_DEPTH_BIT;
+      }
+      if (type == GPU_FB_DEPTH_STENCIL_ATTACHMENT &&
+          aspect != wgpu::TextureAspect::DepthOnly)
+      {
+        bits |= GPU_STENCIL_BIT;
+      }
+    }
+    if (bits != GPUFrameBufferBits(0)) {
+      return submit_clear(
+          bits,
+          Span<double4>(),
+          float(clear_value[0]),
+          uint(clear_value[1]),
+          true,
+          std::move(completion));
+    }
+    return reject();
+  }
+  /* Colour: reuse submit_clear, but only the requested slot should clear. Simplest
+   * correct approach — clear just that slot by binding it alone is not possible
+   * without disturbing others, so clear the whole colour set to their stored value
+   * is wrong; instead issue a colour clear with this slot's value broadcast is also
+   * wrong. Clear only the target slot via a dedicated pass with the others on Load. */
+  const int slot = type - GPU_FB_COLOR_ATTACHMENT0;
+  WGPUContext *ctx = active_context();
+  Texture *tex = color_tex(slot);
+  if (ctx == nullptr || tex == nullptr) {
+    return reject();
+  }
+  wgpu::Device device = ctx->device_get();
+  const GPUAttachment &att = attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot];
+  const int layers = (att.layer < 0) ?
+                         int(as_wgpu(att.tex)->attachment_layer_count(std::max(att.mip, 0))) :
+                         1;
+  std::vector<wgpu::RenderPassColorAttachment> clear_layers;
+  clear_layers.reserve(layers);
+  for (int layer = 0; layer < layers; layer++) {
+    const int force_layer = (att.layer < 0) ? layer : -1;
+    wgpu::RenderPassColorAttachment ca = {};
+    ca.view = attachment_view(att, force_layer);
+    if (ca.view == nullptr) {
+      return reject();
+    }
+    ca.depthSlice = attachment_depth_slice(att, force_layer);
+    ca.loadOp = wgpu::LoadOp::Clear;
+    ca.storeOp = wgpu::StoreOp::Store;
+    ca.clearValue = {clear_value[0], clear_value[1], clear_value[2], clear_value[3]};
+
+    clear_layers.push_back(std::move(ca));
+  }
+
+  struct CompletionState {
+    std::atomic<uint32_t> pending{0};
+    std::atomic<bool> valid{true};
+    std::atomic<bool> completed{false};
+    std::function<void(bool)> complete;
+  };
+  std::shared_ptr<CompletionState> completion_state;
+  if (completion) {
+    completion_state = std::make_shared<CompletionState>();
+    completion_state->pending.store(uint32_t(clear_layers.size()), std::memory_order_release);
+    completion_state->complete = std::move(completion);
+  }
+
+  for (wgpu::RenderPassColorAttachment &ca : clear_layers) {
+    wgpu::RenderPassDescriptor rp = {};
+    rp.colorAttachmentCount = 1;
+    rp.colorAttachments = &ca;
+    webgpu::command_pass_encode_submit_scoped(ctx->instance_get(),
+                                              device,
+                                              ctx->queue_get(),
+                                              ctx->queue_scheduler_get(),
+                                              "framebuffer attachment clear",
+                                              [&](auto &encoder) {
+                                                return encoder.BeginRenderPass(&rp);
+                                              },
+                                              [](auto & /*pass*/) {},
+                                              [completion_state](const bool valid) {
+                                                if (!completion_state) {
+                                                  return;
+                                                }
+                                                if (!valid) {
+                                                  completion_state->valid.store(
+                                                      false, std::memory_order_release);
+                                                }
+                                                if (completion_state->pending.fetch_sub(
+                                                        1, std::memory_order_acq_rel) == 1 &&
+                                                    !completion_state->completed.exchange(
+                                                        true, std::memory_order_acq_rel))
+                                                {
+                                                  completion_state->complete(
+                                                      completion_state->valid.load(
+                                                          std::memory_order_acquire));
+                                                }
+                                              });
+  }
+  return true;
+}
+
+void WGPUFrameBuffer::attachment_set_loadstore_op(GPUAttachmentType type, GPULoadStore ls)
+{
+  if (type >= 0 && type < GPU_FB_MAX_ATTACHMENT) {
+    load_store_[type] = ls;
+    load_action_tracker_.record(uint32_t(type), ls.load_action == GPU_LOADACTION_CLEAR);
+  }
+}
+
+bool WGPUFrameBuffer::load_action_transaction_prepare(
+    const std::shared_ptr<webgpu::FramebufferLoadActionTransaction> &load_action,
+    std::function<void(bool)> &draw_completion)
+{
+  draw_completion = {};
+  if (!load_action) {
+    return false;
+  }
+  webgpu::FramebufferViewportPlan draw_viewport;
+  if (!load_pass_viewport_plan(draw_viewport)) {
+    load_action->complete(false);
+    return false;
+  }
+
+  uint32_t materialize_mask = 0;
+  for (int index = 0; index < GPU_FB_MAX_ATTACHMENT; index++) {
+    const GPUAttachment &attachment = attachments_[index];
+    if (attachment.tex == nullptr || !load_action_tracker_.requires_clear(uint32_t(index))) {
+      continue;
+    }
+    const webgpu::FramebufferLoadClearScope scope = webgpu::framebuffer_load_clear_scope(
+        attachment.layer,
+        as_wgpu(attachment.tex)->attachment_layer_count(std::max(attachment.mip, 0)));
+    if (scope == webgpu::FramebufferLoadClearScope::Invalid) {
+      load_action->complete(false);
+      return false;
+    }
+    if (scope == webgpu::FramebufferLoadClearScope::MaterializeAllLayers) {
+      materialize_mask |= 1u << index;
+    }
+  }
+
+  uint32_t staged_mask = 0;
+  uint32_t staged_count = 0;
+  for (int index = 0; index < GPU_FB_MAX_ATTACHMENT; index++) {
+    if ((materialize_mask & (1u << index)) == 0) {
+      continue;
+    }
+    if (load_action->stage(uint32_t(index))) {
+      staged_mask |= 1u << index;
+      staged_count++;
+    }
+  }
+
+  webgpu::FramebufferLoadActionCompletionGroup completions(load_action, staged_count + 1);
+  draw_completion = completions.completion();
+  for (int index = 0; index < GPU_FB_MAX_ATTACHMENT; index++) {
+    if ((staged_mask & (1u << index)) == 0) {
+      continue;
+    }
+    const GPULoadStore &load_store = load_store_[index];
+    double4 clear_value(load_store.clear_value[0],
+                        load_store.clear_value[1],
+                        load_store.clear_value[2],
+                        load_store.clear_value[3]);
+    if (index < GPU_FB_COLOR_ATTACHMENT0) {
+      /* begin_load_pass() uses zero for the shared depth/stencil load action's
+       * stencil value; retain that established backend behavior here. */
+      clear_value[1] = 0.0;
+    }
+    std::function<void(bool)> clear_completion = completions.completion();
+    if (!clear_attachment_full(
+            static_cast<GPUAttachmentType>(index),
+            clear_value,
+            clear_completion))
+    {
+      clear_completion(false);
+      draw_completion(false);
+      draw_completion = {};
+      return false;
+    }
+  }
+  return true;
+}
+
+bool WGPUFrameBuffer::load_pass_viewport_plan(
+    webgpu::FramebufferViewportPlan &draw_viewport) const
+{
+  if (multi_viewport_) {
+    return true;
+  }
+  int viewport[4];
+  viewport_get(viewport);
+  int scissor[4];
+  const int *active_scissor = nullptr;
+  if (scissor_test_get()) {
+    scissor_get(scissor);
+    active_scissor = scissor;
+  }
+  WGPUContext *wctx = active_context();
+  wgpu::Limits limits = {};
+  if (wctx == nullptr || !wctx->device_get().GetLimits(&limits)) {
+    return false;
+  }
+  if (wctx->is_window_backbuffer(this)) {
+    return webgpu::window_viewport_scissor_plan(viewport,
+                                                active_scissor,
+                                                width_,
+                                                height_,
+                                                limits.maxTextureDimension2D,
+                                                draw_viewport);
+  }
+  return webgpu::offscreen_viewport_scissor_plan(viewport,
+                                                 active_scissor,
+                                                 width_,
+                                                 height_,
+                                                 limits.maxTextureDimension2D,
+                                                 draw_viewport);
+}
+
+struct WGPUFramebufferReadPlan {
+  webgpu::WGPUTexture *texture = nullptr;
+  int mip = 0;
+  int layer = 0;
+  eGPUDataFormat format = GPU_DATA_FLOAT;
+  webgpu::FramebufferReadLayout layout;
+  std::array<uint8_t, 4> one_component = {};
+};
+
+static bool create_framebuffer_read_plan(const GPUAttachment &attachment,
+                                         const eGPUDataFormat format,
+                                         const int area[4],
+                                         const int channel_len,
+                                         WGPUFramebufferReadPlan &r_plan)
+{
+  Texture *tex = attachment.tex;
+  if (tex == nullptr || area == nullptr) {
+    return false;
+  }
+  const int x = area[0], y = area[1], w = area[2], h = area[3];
+  const int mip = std::max(attachment.mip, 0);
+  const int layer = std::max(attachment.layer, 0);
+  webgpu::WGPUTexture *wtex = as_wgpu(tex);
+  webgpu::WGPUTexture::ResolvedReadRegion region;
+  if (!wtex->resolve_subresource(mip, layer, region)) {
+    return false;
+  }
+
+  const bool packed_format = ELEM(format,
+                                  GPU_DATA_UINT_24_8_DEPRECATED,
+                                  GPU_DATA_10_11_11_REV,
+                                  GPU_DATA_2_10_10_10_REV);
+  if (channel_len < 1 || channel_len > 4 || (packed_format && channel_len != 1)) {
+    return false;
+  }
+  const uint32_t source_components = packed_format ? 1u :
+                                                     uint32_t(to_component_len(tex->format_get()));
+  const uint32_t destination_components = packed_format ? 1u : uint32_t(channel_len);
+  const size_t component_bytes = to_bytesize(format);
+  webgpu::FramebufferReadLayout layout;
+  if (!webgpu::framebuffer_read_layout(region.width,
+                                       region.height,
+                                       x,
+                                       y,
+                                       w,
+                                       h,
+                                       source_components,
+                                       destination_components,
+                                       component_bytes,
+                                       layout))
+  {
+    return false;
+  }
+
+  r_plan = {};
+  r_plan.texture = wtex;
+  r_plan.mip = mip;
+  r_plan.layer = layer;
+  r_plan.format = format;
+  r_plan.layout = layout;
+
+  switch (format) {
+    case GPU_DATA_UBYTE:
+      r_plan.one_component[0] = 0xff;
+      break;
+    case GPU_DATA_HALF_FLOAT: {
+      const uint16_t one = 0x3c00;
+      std::memcpy(r_plan.one_component.data(), &one, sizeof(one));
+      break;
+    }
+    case GPU_DATA_FLOAT: {
+      const float one = 1.0f;
+      std::memcpy(r_plan.one_component.data(), &one, sizeof(one));
+      break;
+    }
+    case GPU_DATA_INT: {
+      const int32_t one = 1;
+      std::memcpy(r_plan.one_component.data(), &one, sizeof(one));
+      break;
+    }
+    case GPU_DATA_UINT:
+    case GPU_DATA_UINT_24_8_DEPRECATED:
+    case GPU_DATA_10_11_11_REV:
+    case GPU_DATA_2_10_10_10_REV: {
+      const uint32_t one = 1;
+      std::memcpy(r_plan.one_component.data(), &one, sizeof(one));
+      break;
+    }
+  }
+  return true;
+}
+
+static bool extract_read_result(const webgpu::FramebufferReadLayout &layout,
+                                const std::array<uint8_t, 4> &one_component,
+                                const unsigned char *source,
+                                const size_t source_size,
+                                unsigned char *destination,
+                                const size_t destination_size)
+{
+  /* ADR-005 decision 3 (render-target readback row-flip). WebGPU stores the rendered
+   * texture top-down (row 0 = top); lane A's vertex-shader clip-space Y-flip (decision
+   * 1) additionally mirrors the geometry vertically. To return GL-convention bottom-up
+   * rows (matching the Vulkan/Metal reference the tests encode), reverse the source
+   * rows here. This is the RENDER-TARGET readback path only — WGPUTexture::read (pure
+   * upload->read, no render pass) stays symmetric and is NOT flipped, so the texture_*
+   * suite is untouched. `y` (area origin) is in GL bottom-up coordinates: after the
+   * whole attachment is flipped to bottom-up, cropping [y, y+h) is a direct copy. */
+  return webgpu::framebuffer_read_extract(source,
+                                          source_size,
+                                          destination,
+                                          destination_size,
+                                          one_component.data(),
+                                          layout);
+}
+
+void WGPUFrameBuffer::read(GPUFrameBufferBits planes,
+                           eGPUDataFormat format,
+                           const int area[4],
+                           int channel_len,
+                           int slot,
+                           void *r_data)
+{
+  if ((planes & GPU_COLOR_BIT) && (slot < 0 || slot >= GPU_FB_MAX_COLOR_ATTACHMENT)) {
+    return;
+  }
+  const GPUAttachment &attachment = (planes & GPU_COLOR_BIT) ?
+                                        attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot] :
+                                        depth_attachment();
+  WGPUFramebufferReadPlan plan;
+  if (r_data == nullptr ||
+      !create_framebuffer_read_plan(attachment, format, area, channel_len, plan))
+  {
+    return;
+  }
+  std::vector<uint8_t> source(plan.layout.source_data_size);
+  plan.texture->read_sub(plan.mip, plan.layer, plan.format, source.data());
+  extract_read_result(plan.layout,
+                      plan.one_component,
+                      source.data(),
+                      source.size(),
+                      static_cast<unsigned char *>(r_data),
+                      plan.layout.destination_data_size);
+}
+
+GPUReadback *WGPUFrameBuffer::read_async(GPUFrameBufferBits planes,
+                                         eGPUDataFormat format,
+                                         const int area[4],
+                                         int channel_len,
+                                         int slot)
+{
+  if ((planes & GPU_COLOR_BIT) && (slot < 0 || slot >= GPU_FB_MAX_COLOR_ATTACHMENT)) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  const GPUAttachment &attachment = (planes & GPU_COLOR_BIT) ?
+                                        attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot] :
+                                        depth_attachment();
+  WGPUFramebufferReadPlan plan;
+  if (!create_framebuffer_read_plan(attachment, format, area, channel_len, plan)) {
+    return gpu_readback_create_failed(GPU_READBACK_ERROR_INVALID_ARGUMENT);
+  }
+  GPUReadback *source = plan.texture->read_sub_async(plan.mip, plan.layer, plan.format);
+  const webgpu::FramebufferReadLayout layout = plan.layout;
+  const std::array<uint8_t, 4> one_component = plan.one_component;
+  return gpu_readback_create_transform(
+      source,
+      layout.source_data_size,
+      layout.destination_data_size,
+      [layout, one_component](const unsigned char *source_bytes,
+                              const size_t source_size,
+                              unsigned char *destination,
+                              const size_t destination_size) {
+        return extract_read_result(layout,
+                                   one_component,
+                                   source_bytes,
+                                   source_size,
+                                   destination,
+                                   destination_size);
+      });
+}
+
+void WGPUFrameBuffer::blit_to(GPUFrameBufferBits planes,
+                              int src_slot,
+                              FrameBuffer *dst,
+                              int dst_slot,
+                              int dst_offset_x,
+                              int dst_offset_y)
+{
+  WGPUFrameBuffer *dst_fb = static_cast<WGPUFrameBuffer *>(dst);
+  Texture *stex = (planes & GPU_COLOR_BIT) ? color_tex(src_slot) : depth_tex();
+  Texture *dtex = (planes & GPU_COLOR_BIT) ? dst_fb->color_tex(dst_slot) : dst_fb->depth_tex();
+  if (stex == nullptr || dtex == nullptr) {
+    return;
+  }
+  /* These signed offsets are backend-internal. All native-visible production
+   * callers at this pin provide non-negative screen/copy origins, while Metal,
+   * Vulkan, and GL disagree on negative behavior (uint conversion, clamp/scale,
+   * and clip respectively). Reject the unsupported internal input explicitly;
+   * do not invent a cross-backend source-origin transform. */
+  if (dst_offset_x < 0 || dst_offset_y < 0) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  const GPUAttachment &src_att = (planes & GPU_COLOR_BIT) ?
+                                     attachments_[GPU_FB_COLOR_ATTACHMENT0 + src_slot] :
+                                     depth_attachment();
+  const GPUAttachment &dst_att = (planes & GPU_COLOR_BIT) ?
+                                     dst_fb->attachments_[GPU_FB_COLOR_ATTACHMENT0 + dst_slot] :
+                                     dst_fb->depth_attachment();
+  const int src_layer = std::max(src_att.layer, 0);
+  const int dst_layer = std::max(dst_att.layer, 0);
+  webgpu::WGPUTexture::ResolvedReadRegion src_region;
+  webgpu::WGPUTexture::ResolvedReadRegion dst_region;
+  webgpu::WGPUTexture *wsrc = as_wgpu(stex);
+  webgpu::WGPUTexture *wdst = as_wgpu(dtex);
+  if (!wsrc->resolve_subresource(std::max(src_att.mip, 0), src_layer, src_region) ||
+      !wdst->resolve_subresource(std::max(dst_att.mip, 0), dst_layer, dst_region))
+  {
+    return;
+  }
+  const uint32_t w = uint32_t(std::min(uint64_t(src_region.width),
+                                      uint64_t((dst_offset_x < int(dst_region.width)) ?
+                                                   int(dst_region.width) - dst_offset_x :
+                                                   0)));
+  const uint32_t h = uint32_t(std::min(uint64_t(src_region.height),
+                                      uint64_t((dst_offset_y < int(dst_region.height)) ?
+                                                   int(dst_region.height) - dst_offset_y :
+                                                   0)));
+  if (w == 0 || h == 0) {
+    return;
+  }
+  const bool depth = (planes & (GPU_DEPTH_BIT | GPU_STENCIL_BIT)) != 0;
+  const wgpu::TextureFormat src_backing = wsrc->backing_format();
+  const wgpu::TextureFormat dst_backing = wdst->backing_format();
+  const auto is_combined_depth_stencil = [](wgpu::TextureFormat format) {
+    return format == wgpu::TextureFormat::Depth32FloatStencil8 ||
+           format == wgpu::TextureFormat::Depth24PlusStencil8;
+  };
+  const bool src_combined = is_combined_depth_stencil(src_backing);
+  const bool dst_combined = is_combined_depth_stencil(dst_backing);
+  wgpu::TextureAspect aspect = wgpu::TextureAspect::All;
+  if (depth) {
+    const bool copy_depth = bool(planes & GPU_DEPTH_BIT);
+    const bool copy_stencil = bool(planes & GPU_STENCIL_BIT);
+    aspect = (copy_depth && copy_stencil) ? wgpu::TextureAspect::All :
+             copy_stencil                 ? wgpu::TextureAspect::StencilOnly :
+                                            wgpu::TextureAspect::DepthOnly;
+    if (aspect == wgpu::TextureAspect::All && !src_combined && !dst_combined) {
+      /* Native Vulkan intersects requested planes with each image's supported
+       * aspects. Preserve that public behavior: Depth|Stencil between pure-depth
+       * attachments means DepthOnly, not an invalid aspect-all WebGPU copy. */
+      aspect = wgpu::TextureAspect::DepthOnly;
+    }
+    /* A single-aspect Blender view cannot be widened by a framebuffer copy. */
+    if ((src_region.aspect != wgpu::TextureAspect::All && src_region.aspect != aspect) ||
+        (dst_region.aspect != wgpu::TextureAspect::All && dst_region.aspect != aspect))
+    {
+      return;
+    }
+  }
+
+  const bool formats_copy_compatible =
+      src_backing == dst_backing ||
+      webgpu::srgb_view_format_pair(src_backing) == dst_backing;
+  const auto aspect_supported = [](wgpu::TextureFormat format, wgpu::TextureAspect wanted) {
+    const bool combined = format == wgpu::TextureFormat::Depth32FloatStencil8 ||
+                          format == wgpu::TextureFormat::Depth24PlusStencil8;
+    if (wanted == wgpu::TextureAspect::StencilOnly || wanted == wgpu::TextureAspect::All) {
+      return combined;
+    }
+    return wanted != wgpu::TextureAspect::DepthOnly ||
+           combined || format == wgpu::TextureFormat::Depth32Float ||
+           format == wgpu::TextureFormat::Depth16Unorm ||
+           format == wgpu::TextureFormat::Depth24Plus;
+  };
+  if (depth && (dst_offset_x != 0 || dst_offset_y != 0 || w != src_region.width ||
+                h != src_region.height || w != dst_region.width || h != dst_region.height))
+  {
+    /* Dawn requires depth/stencil copies to cover the complete selected x/y
+     * subresource. The public API has no filtered depth fallback; a partial or
+     * offset depth/stencil blit is therefore an explicit safe no-op (0147 owns
+     * the dependent fallback) rather than a validation-invalid copy. */
+    return;
+  }
+
+  if (depth && aspect != wgpu::TextureAspect::All &&
+      (src_combined || dst_combined || src_backing != dst_backing))
+  {
+    /* CopyTextureToTexture only accepts aspect=All for a combined D/S format and
+     * cannot cross pure depth formats. DepthOnly uses a representation-independent
+     * render pass; StencilOnly uses a one-byte GPU-only buffer bridge. Both preserve
+     * the sibling aspect without ever mapping to the host. */
+    const bool depth_bridge =
+        aspect == wgpu::TextureAspect::DepthOnly &&
+        ELEM(src_backing,
+             wgpu::TextureFormat::Depth16Unorm,
+             wgpu::TextureFormat::Depth24Plus,
+             wgpu::TextureFormat::Depth24PlusStencil8,
+             wgpu::TextureFormat::Depth32Float,
+             wgpu::TextureFormat::Depth32FloatStencil8) &&
+        ELEM(dst_backing,
+             wgpu::TextureFormat::Depth16Unorm,
+             wgpu::TextureFormat::Depth24Plus,
+             wgpu::TextureFormat::Depth24PlusStencil8,
+             wgpu::TextureFormat::Depth32Float,
+             wgpu::TextureFormat::Depth32FloatStencil8);
+    const bool stencil_bridge = aspect == wgpu::TextureAspect::StencilOnly && src_combined &&
+                                dst_combined;
+    if (!depth_bridge && !stencil_bridge) {
+      /* No representation-independent single-aspect path exists for this pair. */
+      return;
+    }
+    if (depth_bridge) {
+      ctx->blit_depth_render(wsrc,
+                             std::max(src_att.mip, 0),
+                             src_layer,
+                             wdst,
+                             std::max(dst_att.mip, 0),
+                             dst_layer,
+                             w,
+                             h);
+      return;
+    }
+    if (src_region.texture.GetSampleCount() != 1 ||
+        dst_region.texture.GetSampleCount() != 1 ||
+        src_region.texture.GetDimension() != dst_region.texture.GetDimension())
+    {
+      return;
+    }
+    const uint32_t texel_bytes = 1u;
+    const uint64_t row_bytes = uint64_t(w) * texel_bytes;
+    const uint64_t bytes_per_row = (row_bytes + 255u) & ~uint64_t(255u);
+    if (row_bytes == 0 ||
+        bytes_per_row > uint64_t(std::numeric_limits<uint32_t>::max()) ||
+        uint64_t(h) > std::numeric_limits<uint64_t>::max() / bytes_per_row)
+    {
+      return;
+    }
+    const uint64_t staging_size = bytes_per_row * h;
+    wgpu::Device device = ctx->device_get();
+    wgpu::Limits limits = {};
+    if (device == nullptr || !device.GetLimits(&limits) || staging_size > limits.maxBufferSize) {
+      return;
+    }
+    wgpu::BufferDescriptor buffer_desc = {};
+    buffer_desc.size = staging_size;
+    buffer_desc.usage = wgpu::BufferUsage::CopySrc | wgpu::BufferUsage::CopyDst;
+    wgpu::Buffer staging = device.CreateBuffer(&buffer_desc);
+    if (staging == nullptr) {
+      return;
+    }
+
+    wgpu::TexelCopyTextureInfo bridge_src = {};
+    bridge_src.texture = src_region.texture;
+    bridge_src.mipLevel = src_region.mip_level;
+    bridge_src.origin = {src_region.origin_x, src_region.origin_y, src_region.origin_z};
+    bridge_src.aspect = aspect;
+    wgpu::TexelCopyBufferInfo bridge_buffer_dst = {};
+    bridge_buffer_dst.buffer = staging;
+    bridge_buffer_dst.layout.bytesPerRow = uint32_t(bytes_per_row);
+    bridge_buffer_dst.layout.rowsPerImage = h;
+
+    wgpu::TexelCopyBufferInfo bridge_buffer_src = {};
+    bridge_buffer_src.buffer = staging;
+    bridge_buffer_src.layout.bytesPerRow = uint32_t(bytes_per_row);
+    bridge_buffer_src.layout.rowsPerImage = h;
+    wgpu::TexelCopyTextureInfo bridge_dst = {};
+    bridge_dst.texture = dst_region.texture;
+    bridge_dst.mipLevel = dst_region.mip_level;
+    bridge_dst.origin = {dst_region.origin_x, dst_region.origin_y, dst_region.origin_z};
+    bridge_dst.aspect = aspect;
+
+    wgpu::Extent3D bridge_size = {w, h, 1};
+    webgpu::command_encode_submit_scoped(
+        ctx->instance_get(),
+        device,
+        ctx->queue_get(),
+        ctx->queue_scheduler_get(),
+        "framebuffer stencil bridge",
+        [&](auto &encoder) {
+          encoder.CopyTextureToBuffer(&bridge_src, &bridge_buffer_dst, &bridge_size);
+          encoder.CopyBufferToTexture(&bridge_buffer_src, &bridge_dst, &bridge_size);
+        },
+        [](bool) {});
+    return;
+  }
+  /* Colour blits across incompatible formats or dimensions cannot use
+   * CopyTextureToTexture. Fall back to a textured-quad render pass. Public
+   * offscreen blits use straight top-left texel mapping. Region offscreens copied
+   * to the window retain Blender's established bottom-up content convention and
+   * convert their GL bottom-origin destination offset to WebGPU top-origin here.
+   * Same-format/same-dimension colour blits keep the raw copy below. */
+  if (!depth) {
+    const wgpu::TextureFormat sfmt = wsrc->wgpu_format();
+    const wgpu::TextureFormat dfmt = wdst->wgpu_format();
+    const bool dimension_mismatch =
+        src_region.texture.GetDimension() != dst_region.texture.GetDimension();
+    if (sfmt != dfmt || dimension_mismatch) {
+      const bool window_backbuffer = ctx->is_window_backbuffer(dst_fb);
+      uint32_t dy = uint32_t(dst_offset_y);
+      if (window_backbuffer) {
+        const int flipped = int(dst_region.height) - dst_offset_y - int(h);
+        dy = uint32_t(std::max(flipped, 0));
+      }
+      ctx->blit_color_render(wsrc,
+                             std::max(src_att.mip, 0),
+                             src_layer,
+                             wdst,
+                             std::max(dst_att.mip, 0),
+                             dst_layer,
+                             w,
+                             h,
+                             uint32_t(dst_offset_x),
+                             dy,
+                             !window_backbuffer);
+      return;
+    }
+  }
+
+  /* The remaining path is a raw WebGPU texture copy. Validate every descriptor
+   * invariant before encoding so a frontend mismatch becomes a safe no-op rather
+   * than a device validation error. Cross-format color blits returned above. */
+  if (!formats_copy_compatible ||
+      src_region.texture.GetSampleCount() != dst_region.texture.GetSampleCount() ||
+      src_region.texture.GetSampleCount() != 1 ||
+      src_region.texture.GetDimension() != dst_region.texture.GetDimension() ||
+      (depth && (!aspect_supported(src_backing, aspect) ||
+                 !aspect_supported(dst_backing, aspect))))
+  {
+    return;
+  }
+
+  const wgpu::TextureAspect raw_aspect =
+      (depth && aspect == wgpu::TextureAspect::DepthOnly && !src_combined && !dst_combined) ?
+          wgpu::TextureAspect::All :
+          aspect;
+  wgpu::TexelCopyTextureInfo s = {};
+  s.texture = src_region.texture;
+  s.mipLevel = src_region.mip_level;
+  s.origin = {src_region.origin_x, src_region.origin_y, src_region.origin_z};
+  s.aspect = raw_aspect;
+
+  wgpu::TexelCopyTextureInfo d = {};
+  d.texture = dst_region.texture;
+  d.mipLevel = dst_region.mip_level;
+  d.origin = {dst_region.origin_x + uint32_t(dst_offset_x),
+              dst_region.origin_y + uint32_t(dst_offset_y),
+              dst_region.origin_z};
+  d.aspect = raw_aspect;
+
+  wgpu::Extent3D size = {w, h, 1};
+  wgpu::Device device = ctx->device_get();
+  webgpu::command_encode_submit_scoped(ctx->instance_get(),
+                                       device,
+                                       ctx->queue_get(),
+                                       ctx->queue_scheduler_get(),
+                                       "framebuffer texture copy",
+                                       [&](auto &encoder) {
+                                         encoder.CopyTextureToTexture(&s, &d, &size);
+                                       },
+                                       [](bool) {});
+}
+
+int WGPUFrameBuffer::attachment_layer_count() const
+{
+  /* A fixed-layer attachment participates in every emulated pass but does not
+   * determine their count. All layered attachments must agree before any draw is
+   * encoded; returning zero makes the batch fail closed instead of drawing only a
+   * prefix and then reaching a validation-invalid attachment view. */
+  webgpu::FramebufferDrawPassCount passes;
+  for (int slot = 0; slot < GPU_FB_MAX_COLOR_ATTACHMENT; slot++) {
+    Texture *tex = color_tex(slot);
+    const bool active = (color_attachments_bits_ & (1u << slot)) != 0;
+    if (tex != nullptr && active) {
+      webgpu::WGPUTexture *wt = as_wgpu(tex);
+      const GPUAttachment &att = attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot];
+      if (!webgpu::framebuffer_draw_pass_count_update(
+              att.layer,
+              wt->attachment_layer_count(std::max(att.mip, 0)),
+              passes))
+      {
+        return 0;
+      }
+    }
+  }
+  if (Texture *tex = depth_tex()) {
+    webgpu::WGPUTexture *wt = as_wgpu(tex);
+    const GPUAttachment &att = depth_attachment();
+    if (!webgpu::framebuffer_draw_pass_count_update(
+            att.layer,
+            wt->attachment_layer_count(std::max(att.mip, 0)),
+            passes))
+    {
+      return 0;
+    }
+  }
+  return int(passes.count);
+}
+
+bool WGPUFrameBuffer::target_formats(wgpu::TextureFormat colors[8],
+                                     int &color_count,
+                                     wgpu::TextureFormat &depth) const
+{
+  /* Preserve attachment SLOTS - do NOT compact. A workbench TransparentDepthPass
+   * framebuffer carries GPU_ATTACHMENT_NONE gaps BELOW a populated slot, e.g.
+   * ensure(depth, NONE, NONE, object_id) -> object_id (R16Uint) at colour slot 2,
+   * slots 0/1 empty. Compacting it (colors[color_count++], skipping NONE) put
+   * R16Uint at targets[0], where wgpu_pipeline paired it against the WGSL float
+   * @location(0) output (the prepass frag writes material@0/normal@1/object_id@2) ->
+   * Dawn "R16Uint base type Uint doesn't match fragment output Float", dropping the
+   * whole pipeline. Native Vulkan keeps the gap (VK_ATTACHMENT_UNUSED) and discards
+   * the unmatched outputs; Dawn likewise accepts a NULL colour target at an unused
+   * slot with its fragment output discarded (verified: sandbox/gpu-r52 probe Q1/Q6).
+   * So index each format by its real slot (a gap == TextureFormat::Undefined, which
+   * wgpu_pipeline maps to a null colour target) and report the highest populated slot
+   * + 1. A fully-contiguous framebuffer (the common window/offscreen case) is
+   * byte-identical to the old compaction. */
+  for (int i = 0; i < 8; i++) {
+    colors[i] = wgpu::TextureFormat::Undefined;
+  }
+  color_count = 0;
+  for (int slot = 0; slot < GPU_FB_MAX_COLOR_ATTACHMENT && slot < 8; slot++) {
+    Texture *tex = color_tex(slot);
+    const bool active = (color_attachments_bits_ & (1u << slot)) != 0;
+    if (tex != nullptr && active) {
+      colors[slot] = as_wgpu(tex)->wgpu_format();
+      color_count = slot + 1;
+    }
+  }
+  Texture *dtex = depth_tex();
+  depth = (dtex != nullptr) ? as_wgpu(dtex)->wgpu_format() : wgpu::TextureFormat::Undefined;
+  if (color_count == 0 && depth == wgpu::TextureFormat::Undefined &&
+      needs_empty_render_attachment())
+  {
+    colors[0] = wgpu::TextureFormat::R8Unorm;
+    color_count = 1;
+    return true;
+  }
+  return false;
+}
+
+wgpu::RenderPassEncoder WGPUFrameBuffer::begin_load_pass(
+    const wgpu::CommandEncoder &encoder,
+    const std::shared_ptr<webgpu::FramebufferLoadActionTransaction> &load_action,
+    int force_layer)
+{
+  if (!load_action) {
+    return nullptr;
+  }
+  const bool apply_ordinary_viewport = !multi_viewport_;
+  webgpu::FramebufferViewportPlan draw_viewport;
+  if (!load_pass_viewport_plan(draw_viewport)) {
+    return nullptr;
+  }
+  /* NOTE: the local attachment vectors + views only need to outlive BeginRenderPass
+   * (it captures ref-counted handles). */
+  /* Preserve colour SLOTS through to the render-pass descriptor so its colour layout
+   * matches the slot-indexed pipeline targets (target_formats): a gap slot below a
+   * populated one (TransparentDepthPass NONE gaps) becomes a NULL-view colour
+   * attachment, which Dawn accepts (probe Q6) exactly as Vulkan keeps a
+   * VK_ATTACHMENT_UNUSED slot. Only emit up to the highest populated slot; a
+   * contiguous framebuffer (window/offscreen) is unchanged. */
+  std::vector<wgpu::RenderPassColorAttachment> color_atts;
+  int highest_color_slot = -1;
+  for (int slot = 0; slot < GPU_FB_MAX_COLOR_ATTACHMENT; slot++) {
+    const bool active = (color_attachments_bits_ & (1u << slot)) != 0;
+    if (color_tex(slot) != nullptr && active) {
+      highest_color_slot = slot;
+    }
+  }
+  for (int slot = 0; slot <= highest_color_slot; slot++) {
+    Texture *tex = color_tex(slot);
+    const bool active = (color_attachments_bits_ & (1u << slot)) != 0;
+    if (tex == nullptr || !active) {
+      /* Gap slot: a null colour attachment (view + loadOp/storeOp left Undefined). */
+      color_atts.push_back(wgpu::RenderPassColorAttachment{});
+      continue;
+    }
+    const GPUAttachment &att = attachments_[GPU_FB_COLOR_ATTACHMENT0 + slot];
+    int attachment_force_layer = force_layer;
+    if (force_layer >= 0) {
+      const webgpu::FramebufferClearPassStatus draw_status =
+          webgpu::framebuffer_draw_pass_layer(
+              att.layer,
+              as_wgpu(att.tex)->attachment_layer_count(std::max(att.mip, 0)),
+              uint32_t(force_layer),
+              attachment_force_layer);
+      if (draw_status != webgpu::FramebufferClearPassStatus::Active) {
+        return nullptr;
+      }
+    }
+    wgpu::RenderPassColorAttachment ca = {};
+    ca.view = attachment_view(att,
+                              attachment_force_layer,
+                              webgpu::TextureViewValidationScope::EnclosingCommand);
+    if (ca.view == nullptr) {
+      return nullptr;
+    }
+    ca.depthSlice = attachment_depth_slice(att, attachment_force_layer);
+    /* Honor the frontend's recorded load-action (GPU_framebuffer_bind_loadstore ->
+     * attachment_set_loadstore_op). Single-subresource actions are staged by the first pass and
+     * committed only after submission; all-layer array clears were reserved before the outer draw
+     * command so every selected layer is initialized first. */
+    const int attachment_index = GPU_FB_COLOR_ATTACHMENT0 + slot;
+    const GPULoadStore &ls = load_store_[attachment_index];
+    if (load_action->stage(uint32_t(attachment_index))) {
+      ca.loadOp = wgpu::LoadOp::Clear;
+      ca.clearValue = {ls.clear_value[0], ls.clear_value[1], ls.clear_value[2], ls.clear_value[3]};
+    }
+    else {
+      ca.loadOp = wgpu::LoadOp::Load;
+    }
+    ca.storeOp = wgpu::StoreOp::Store;
+    color_atts.push_back(ca);
+  }
+
+  Texture *dtex = depth_tex();
+  wgpu::RenderPassDepthStencilAttachment dsa = {};
+  const bool has_depth = dtex != nullptr;
+  if (has_depth) {
+    const GPUAttachment &att = depth_attachment();
+    int attachment_force_layer = force_layer;
+    if (force_layer >= 0) {
+      const webgpu::FramebufferClearPassStatus draw_status =
+          webgpu::framebuffer_draw_pass_layer(
+              att.layer,
+              as_wgpu(att.tex)->attachment_layer_count(std::max(att.mip, 0)),
+              uint32_t(force_layer),
+              attachment_force_layer);
+      if (draw_status != webgpu::FramebufferClearPassStatus::Active) {
+        return nullptr;
+      }
+    }
+    dsa.view = attachment_view(att,
+                               attachment_force_layer,
+                               webgpu::TextureViewValidationScope::EnclosingCommand);
+    if (dsa.view == nullptr) {
+      return nullptr;
+    }
+    const wgpu::TextureAspect selected_aspect =
+        as_wgpu(dtex)->subresource_range().aspect;
+    const bool permits_depth = selected_aspect != wgpu::TextureAspect::StencilOnly;
+    const bool permits_stencil = selected_aspect != wgpu::TextureAspect::DepthOnly;
+    /* Same one-shot consume for the depth attachment's recorded load-action.
+     * load_store_ is indexed by GPUAttachmentType — resolve the same slot
+     * depth_attachment() picked. */
+    const GPUAttachmentType depth_type = (attachments_[GPU_FB_DEPTH_ATTACHMENT].tex != nullptr) ?
+                                             GPU_FB_DEPTH_ATTACHMENT :
+                                             GPU_FB_DEPTH_STENCIL_ATTACHMENT;
+    const GPULoadStore &dls = load_store_[depth_type];
+    const bool depth_clears = load_action->stage(uint32_t(depth_type));
+    dsa.depthLoadOp = (depth_clears && permits_depth) ? wgpu::LoadOp::Clear :
+                                                       wgpu::LoadOp::Load;
+    dsa.depthStoreOp = wgpu::StoreOp::Store;
+    /* Even with loadOp=Load the value is required to be finite: emdawnwebgpu's JS
+     * binding reads depthClearValue when marshalling the descriptor and rejects the
+     * default WGPU_DEPTH_CLEAR_VALUE_UNDEFINED (NaN) — a browser-only trap native Dawn
+     * doesn't hit (it ignores the value on Load). Clamp to a finite far value. */
+    dsa.depthClearValue = (depth_clears && std::isfinite(dls.clear_value[0])) ?
+                              dls.clear_value[0] :
+                              1.0f;
+    if (dtex->format_get() == TextureFormat::SFLOAT_32_DEPTH_UINT_8) {
+      dsa.stencilLoadOp = (depth_clears && permits_stencil) ? wgpu::LoadOp::Clear :
+                                                             wgpu::LoadOp::Load;
+      dsa.stencilStoreOp = wgpu::StoreOp::Store;
+      dsa.stencilClearValue = 0u;
+    }
+  }
+
+  wgpu::RenderPassDescriptor rp = {};
+  wgpu::RenderPassColorAttachment empty_color_att = {};
+  if (color_atts.empty() && !has_depth && ensure_empty_render_attachment()) {
+    empty_color_att.view = empty_render_attachment_view_;
+    empty_color_att.loadOp = wgpu::LoadOp::Load;
+    empty_color_att.storeOp = wgpu::StoreOp::Store;
+    color_atts.push_back(empty_color_att);
+  }
+  rp.colorAttachmentCount = color_atts.size();
+  rp.colorAttachments = color_atts.empty() ? nullptr : color_atts.data();
+  rp.depthStencilAttachment = has_depth ? &dsa : nullptr;
+
+  /* Dawn returns an error render-pass object rather than a null handle for an
+   * attachment-less descriptor, so callers cannot reliably guard it afterwards.
+   * A positive default size normally takes the private compatibility path above. */
+  if (color_atts.empty() && !has_depth) {
+    return nullptr;
+  }
+
+  wgpu::RenderPassEncoder pass;
+  if (!webgpu::transient_handle_publish_if_valid(encoder.BeginRenderPass(&rp), pass))
+  {
+    return nullptr;
+  }
+
+  /* Ordinary passes always convert the frontend's lower-left viewport and optional scissor to
+   * WebGPU's top-left render coordinates. Offscreen shader/readback Y flips preserve content
+   * orientation and row order, but do not relocate a partial rectangle. Multi-viewport emulation
+   * owns its per-pass rectangles in WGPUBatch and therefore skips this single-viewport state.
+   * The same ordinary rectangle was validated before layered-clear reservation and is rebuilt
+   * synchronously here before pass allocation. */
+  if (apply_ordinary_viewport) {
+    pass.SetViewport(float(draw_viewport.viewport.viewport_x),
+                     float(draw_viewport.viewport.viewport_y),
+                     float(draw_viewport.viewport.viewport_width),
+                     float(draw_viewport.viewport.viewport_height),
+                     0.0f,
+                     1.0f);
+    if (draw_viewport.scissor_enabled) {
+      pass.SetScissorRect(draw_viewport.scissor_x,
+                          draw_viewport.scissor_y,
+                          draw_viewport.scissor_width,
+                          draw_viewport.scissor_height);
+    }
+  }
+
+  return pass;
+}
+
+void WGPUFrameBuffer::subpass_transition_impl(const GPUAttachmentState /*depth_attachment_state*/,
+                                              Span<GPUAttachmentState> color_attachment_states)
+{
+  /* Each WebGPU draw opens a standalone render pass. The base FrameBuffer state already
+   * removed READ/IGNORE slots from color_attachments_bits_; target_formats() and
+   * begin_load_pass() use that mask so an attachment can be sampled by the next draw.
+   * If a READ transition happens before any draw consumed a pending CLEAR, materialize
+   * that clear now so the sampler cannot observe stale pooled texture contents. */
+  for (const int slot : color_attachment_states.index_range()) {
+    if (color_attachment_states[slot] != GPU_ATTACHMENT_READ || color_tex(slot) == nullptr) {
+      continue;
+    }
+    const GPUAttachmentType type = GPU_FB_COLOR_ATTACHMENT0 + slot;
+    const GPULoadStore &ls = load_store_[type];
+    if (load_action_tracker_.requires_clear(uint32_t(type))) {
+      const std::shared_ptr<webgpu::FramebufferLoadActionTransaction> load_action =
+          load_action_transaction();
+      if (load_action->stage(uint32_t(type)) &&
+          !clear_attachment_full(
+              type,
+              double4(
+                  ls.clear_value[0], ls.clear_value[1], ls.clear_value[2], ls.clear_value[3]),
+              [load_action](const bool valid) { load_action->complete(valid); }))
+      {
+        load_action->complete(false);
+        continue;
+      }
+    }
+    /* The following shader exposes subpass input index N as sampler slot N.
+     * Record the attachment in the normal texture bind-space; bind-group
+     * assembly remaps that frontend slot to the shader's dense binding. */
+    WGPUContext *ctx = active_context();
+    if (ctx != nullptr && ctx->state_manager != nullptr) {
+      static_cast<WGPUStateManager *>(ctx->state_manager)
+          ->texture_bind(color_tex(slot), GPUSamplerState::default_sampler(), slot);
+    }
+  }
+}
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_framebuffer.hh b/source/blender/gpu/webgpu/wgpu_framebuffer.hh
new file mode 100644
index 0000000000000000000000000000000000000000..1edac01565ad6c4fd317bdb485a3507533068d57
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_framebuffer.hh
@@ -0,0 +1,217 @@
+/* SPDX-FileCopyrightText: 2022 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_framebuffer.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WGPUFrameBuffer — the WebGPU `gpu::FrameBuffer` implementation. WebGPU has no
+ * persistent framebuffer object: attachments are bound into a transient
+ * `wgpu::RenderPassDescriptor` at pass-begin. `bind()` just records this as the
+ * context's active framebuffer. Full clears use one-shot render passes with
+ * per-attachment loadOp=Clear / storeOp=Store; scissored clears use typed draws over
+ * loadOp=Load. The draw path (wgpu_batch) reuses the transient-pass model. Depth
+ * aspect handling comes from WGPUTexture. */
+
+#pragma once
+
+#include "gpu_framebuffer_private.hh"
+
+#include "GPU_common_types.hh" /* GPULoadOp / GPUStoreOp */
+
+#include "wgpu_common.hh"
+
+#include "webgpu/webgpu_cpp.h"
+
+#include "MEM_guardedalloc.h"
+
+#include <functional>
+#include <memory>
+
+namespace blender::gpu {
+
+namespace webgpu {
+struct FramebufferClearPlan;
+}
+
+static_assert(GPU_FB_MAX_ATTACHMENT <= webgpu::FramebufferLoadActionState::kMaxAttachments);
+
+class WGPUFrameBuffer : public FrameBuffer {
+ public:
+  WGPUFrameBuffer(const char *name);
+  ~WGPUFrameBuffer() override;
+
+  void bind(bool enabled_srgb) override;
+  bool check(char err_out[256]) override;
+
+  void clear(GPUFrameBufferBits buffers,
+             const double4 clear_color,
+             float clear_depth,
+             uint clear_stencil) override;
+  void clear_multi(Span<double4> clear_cols) override;
+  void clear_attachment(GPUAttachmentType type, const double4 clear_value) override;
+
+  void attachment_set_loadstore_op(GPUAttachmentType type, GPULoadStore ls) override;
+
+  void read(GPUFrameBufferBits planes,
+            eGPUDataFormat format,
+            const int area[4],
+            int channel_len,
+            int slot,
+            void *r_data) override;
+  GPUReadback *read_async(GPUFrameBufferBits planes,
+                          eGPUDataFormat format,
+                          const int area[4],
+                          int channel_len,
+                          int slot) override;
+
+  void blit_to(GPUFrameBufferBits planes,
+               int src_slot,
+               FrameBuffer *dst,
+               int dst_slot,
+               int dst_offset_x,
+               int dst_offset_y) override;
+
+  /* --- Draw-path helpers (wgpu_batch) --- */
+  /** The bound attachments' WebGPU formats, for render-pipeline target selection.
+   * `depth` is Undefined when there is no depth attachment. */
+  /** Returns true when the advertised color target is the private compatibility
+   * attachment and all fragment color outputs must be discarded. */
+  bool target_formats(wgpu::TextureFormat colors[8],
+                      int &color_count,
+                      wgpu::TextureFormat &depth) const;
+  /** Create one transaction that stages CLEAR actions until its draw submission completes. */
+  std::shared_ptr<webgpu::FramebufferLoadActionTransaction>
+  load_action_transaction() const
+  {
+    return load_action_tracker_.transaction();
+  }
+  /** Validate the load pass and reserve every required all-layer clear before callers reserve the
+   * dependent draw. The returned callback joins clear and draw validation into one transaction. */
+  bool load_action_transaction_prepare(
+      const std::shared_ptr<webgpu::FramebufferLoadActionTransaction> &load_action,
+      std::function<void(bool)> &draw_completion);
+  /** Open a render pass over the bound attachments with recorded load operations and
+   * storeOp=Store. Caller owns the encoder and must complete `load_action` with the checked
+   * command submission result. When
+   * `force_layer >= 0` every attachment view is pinned to that single array layer
+   * (the M3.F7 multi-viewport / layered emulation renders one pass per layer). */
+  wgpu::RenderPassEncoder begin_load_pass(const wgpu::CommandEncoder &encoder,
+                                          const std::shared_ptr<
+                                              webgpu::FramebufferLoadActionTransaction> &load_action,
+                                          int force_layer = -1);
+
+  /* --- Multi-viewport / layered emulation (M3.F7), read by wgpu_batch --- */
+  /** Whether GPU_framebuffer_multi_viewports_set() is active on this framebuffer. */
+  bool is_multi_viewport() const
+  {
+    return multi_viewport_;
+  }
+  /** Array-layer count of the colour attachment (1 for a plain 2D target). The
+   * emulation issues one render pass per layer. */
+  int attachment_layer_count() const;
+  /** Copy viewport rect `i` (x, y, w, h) out of the base FrameBuffer state. */
+  void get_viewport(int i, int r_rect[4]) const
+  {
+    for (int k = 0; k < 4; k++) {
+      r_rect[k] = viewport_[i][k];
+    }
+  }
+
+ protected:
+  void subpass_transition_impl(const GPUAttachmentState depth_attachment_state,
+                               Span<GPUAttachmentState> color_attachment_states) override;
+
+ private:
+  struct EmptyRenderAttachment {
+    wgpu::Texture texture;
+    wgpu::TextureView view;
+    int2 size = int2(0);
+
+    bool operator==(std::nullptr_t) const
+    {
+      return texture == nullptr || view == nullptr;
+    }
+    bool operator!=(std::nullptr_t) const
+    {
+      return !(*this == nullptr);
+    }
+  };
+
+  /**
+   * WebGPU does not permit attachment-less render passes, while Blender uses
+   * default-sized framebuffers with no public attachments for fragment-shader
+   * side effects (for example EEVEE surfel capture into an SSBO). Keep the
+   * compatibility attachment backend-private so it cannot affect framebuffer
+   * read/blit/clear or frontend attachment ownership.
+   */
+  mutable wgpu::Texture empty_render_attachment_;
+  mutable wgpu::TextureView empty_render_attachment_view_;
+  mutable int2 empty_render_attachment_size_ = int2(0);
+  /** Pending replacement pair. The accepted fields above remain unchanged until both candidate
+   * handles pass one complete validation/OOM/internal scope set. */
+  mutable webgpu::ScopedHandleCache<uint64_t, EmptyRenderAttachment>
+      empty_render_attachment_cache_;
+
+  /** Per-attachment load/store op (explicit-loadstore binds); default = clear+store. */
+  /* Clear values remain here while the transaction tracker owns logical CLEAR/LOAD state. An
+   * all-layer array CLEAR is materialized first because WebGPU render passes expose one layer at
+   * a time. */
+  mutable GPULoadStore load_store_[GPU_FB_MAX_ATTACHMENT];
+  mutable webgpu::FramebufferLoadActionTracker load_action_tracker_;
+
+  /** Recompute width_/height_ from the first bound attachment. */
+  void update_size();
+  /** Validate and resolve the ordinary viewport/scissor before any layered clear is scheduled. */
+  bool load_pass_viewport_plan(webgpu::FramebufferViewportPlan &draw_viewport) const;
+
+  /** True when the active render-pass layout has no public color/depth target. */
+  bool needs_empty_render_attachment() const;
+  /** Ensure the private compatibility attachment matches the default framebuffer size. */
+  bool ensure_empty_render_attachment() const;
+
+  /** Build + submit a one-shot clear render pass. `colors` is either one colour
+   * (broadcast to every colour attachment) or one per colour attachment slot. */
+  bool submit_clear(GPUFrameBufferBits buffers,
+                    Span<double4> colors,
+                    float clear_depth,
+                    uint clear_stencil,
+                    bool force_full_attachment = false,
+                    std::function<void(bool)> completion = {});
+  /** Internal full-attachment clear used to materialize a WebGPU load action. It deliberately
+   * ignores dynamic scissor state because attachment load operations are whole-subresource.
+   * Returns true only after every selected layer's clear reached the queue. */
+  bool clear_attachment_full(GPUAttachmentType type,
+                             const double4 clear_value,
+                             std::function<void(bool)> completion = {});
+
+  /** Emulate a proper-subrectangle clear with a fullscreen draw clipped to `plan`. Full
+   * attachment clears never enter this path and retain loadOp=Clear. */
+  bool submit_scissored_clear(GPUFrameBufferBits buffers,
+                              Span<double4> colors,
+                              float clear_depth,
+                              uint clear_stencil,
+                              const webgpu::FramebufferClearPlan &plan);
+  bool submit_scissored_color_clear(const GPUAttachment &attachment,
+                                    int force_layer,
+                                    const double4 &clear_value,
+                                    const webgpu::FramebufferClearPlan &plan);
+  bool submit_scissored_depth_stencil_clear(const GPUAttachment &attachment,
+                                            int force_layer,
+                                            bool clear_depth,
+                                            float clear_depth_value,
+                                            bool clear_stencil,
+                                            uint clear_stencil_value,
+                                            const webgpu::FramebufferClearPlan &plan);
+
+  webgpu::ScopedHandleCache<uint32_t, wgpu::ShaderModule> scissored_clear_modules_;
+  webgpu::ScopedHandleCache<uint64_t, wgpu::RenderPipeline> scissored_color_clear_pipelines_;
+  webgpu::ScopedHandleCache<uint64_t, wgpu::RenderPipeline> scissored_depth_clear_pipelines_;
+
+  MEM_CXX_CLASS_ALLOC_FUNCS("WGPUFrameBuffer")
+};
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_immediate.cc b/source/blender/gpu/webgpu/wgpu_immediate.cc
new file mode 100644
index 0000000000000000000000000000000000000000..bd0570cfd3113aa7e1cf1a63a2afd5f5ee64737a
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_immediate.cc
@@ -0,0 +1,278 @@
+/* SPDX-FileCopyrightText: 2023 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_immediate.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ */
+
+#include "wgpu_immediate.hh"
+
+#include "wgpu_buffer.hh"
+#include "wgpu_context.hh"
+#include "wgpu_framebuffer.hh"
+#include "wgpu_pipeline.hh"
+#include "wgpu_shader.hh"
+
+#include "GPU_context.hh"
+#include "GPU_matrix.hh"
+#include "gpu_context_private.hh"
+#include "gpu_state_private.hh"
+#include "gpu_vertex_format_private.hh"
+
+#include <cstdint>
+#include <cstring>
+#include <vector>
+
+namespace blender::gpu {
+
+static WGPUContext *active_context()
+{
+  return static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
+}
+
+/** Immediate shares the render-pipeline cache shape with wgpu_batch; a dedicated
+ * pool here avoids cross-file coupling (the cache is just a memo — a few duplicate
+ * pipelines at worst). TODO: fold both into a context-owned pool. */
+static webgpu::WGPUPipelinePool &pipeline_pool()
+{
+  static webgpu::WGPUPipelinePool pool;
+  return pool;
+}
+
+uchar *WGPUImmediate::begin()
+{
+  const uint extra_vertex = prim_type == GPU_PRIM_LINE_LOOP ? 1 : 0;
+  const size_t bytes_needed = vertex_buffer_size(&vertex_format, vertex_len + extra_vertex);
+  if (cpu_buffer_.size() < bytes_needed) {
+    cpu_buffer_.resize(bytes_needed);
+  }
+  return cpu_buffer_.data();
+}
+
+void WGPUImmediate::end()
+{
+  BLI_assert_msg(prim_type != GPU_PRIM_NONE, "Illegal state: not between an immBegin/End pair.");
+  if (vertex_idx == 0) {
+    return;
+  }
+
+  /* WebGPU has no line-loop topology. Close the loop explicitly, then use the
+   * native line-strip topology for both ordinary and expanded-polyline draws. */
+  if (prim_type == GPU_PRIM_LINE_LOOP) {
+    const size_t vertex_stride = vertex_format.stride;
+    std::memcpy(
+        cpu_buffer_.data() + vertex_stride * vertex_idx, cpu_buffer_.data(), vertex_stride);
+    prim_type = GPU_PRIM_LINE_STRIP;
+    vertex_idx++;
+  }
+
+  WGPUContext *ctx = active_context();
+  Context *base_ctx = Context::get();
+  if (ctx == nullptr || base_ctx == nullptr) {
+    return;
+  }
+  WGPUFrameBuffer *fb = static_cast<WGPUFrameBuffer *>(base_ctx->active_fb);
+  WGPUShader *shader = static_cast<WGPUShader *>(base_ctx->shader);
+  if (fb == nullptr || shader == nullptr) {
+    return;
+  }
+  if (!shader->ensure_shader_modules(ctx->instance_get(), ctx->device_get()) ||
+      shader->vertex_module() == nullptr || shader->fragment_module() == nullptr)
+  {
+    return;
+  }
+
+  /* Push the current matrix stack into the shader's uniforms (matches the other
+   * backends): immediate draws rely on ModelViewProjectionMatrix. */
+  GPU_matrix_bind(base_ctx->shader);
+
+  /* WebGPU has no triangle-fan topology. Build a transient triangle-list index
+   * buffer while preserving fan winding and the original vertex identities:
+   * (0, i, i + 1). Keeping the VBO unchanged also preserves gl_VertexID. */
+  GPUPrimType draw_prim_type = prim_type;
+  std::vector<uint32_t> fan_indices;
+  webgpu::Buffer fan_index_buffer;
+  if (prim_type == GPU_PRIM_TRI_FAN) {
+    if (vertex_idx < 3) {
+      return;
+    }
+    const uint64_t fan_count = uint64_t(vertex_idx - 2) * 3;
+    if (fan_count > UINT32_MAX || fan_count > SIZE_MAX / sizeof(uint32_t)) {
+      return;
+    }
+    draw_prim_type = GPU_PRIM_TRIS;
+    fan_indices.reserve(size_t(vertex_idx - 2) * 3);
+    for (uint i = 1; i + 1 < vertex_idx; i++) {
+      fan_indices.push_back(0);
+      fan_indices.push_back(i);
+      fan_indices.push_back(i + 1);
+    }
+    if (!fan_index_buffer.create_transient(ctx->instance_get(),
+                                           ctx->device_get(),
+                                           ctx->queue_scheduler_get(),
+                                           webgpu::BufferKind::Index,
+                                           webgpu::UsageType::Static,
+                                           fan_indices.size() * sizeof(uint32_t),
+                                           fan_indices.data(),
+                                           false,
+                                           "immediate triangle-fan index buffer"))
+    {
+      return;
+    }
+  }
+
+  wgpu::Buffer index_buffer;
+  if (!webgpu::index_buffer_handle_resolve_if_required(
+          prim_type == GPU_PRIM_TRI_FAN, fan_index_buffer.handle(), index_buffer))
+  {
+    return;
+  }
+
+  /* Upload the recorded vertices to a transient vertex buffer. */
+  const size_t data_size = vertex_buffer_size(&vertex_format, vertex_idx);
+  webgpu::Buffer vbo;
+  if (!vbo.create_transient(ctx->instance_get(),
+                            ctx->device_get(),
+                            ctx->queue_scheduler_get(),
+                            webgpu::BufferKind::Vertex,
+                            webgpu::UsageType::Static,
+                            data_size,
+                            cpu_buffer_.data(),
+                            false,
+                            "immediate vertex buffer"))
+  {
+    return;
+  }
+
+  /* Wide lines use the shared polyline workaround: the immediate VBO is read as
+   * position/color storage and a procedural triangle batch expands every line.
+   * The index binding is unused when gpu_index_no_buffer is true, but WebGPU still
+   * requires every binding declared by the shader to be present. */
+  if (shader->is_polyline) {
+    ctx->buffer_ssbo_bind(
+        GPU_SSBO_POLYLINE_POS_BUF_SLOT, &vbo, WGPUContext::BufferSSBOBindKind::Storage);
+    ctx->buffer_ssbo_bind(
+        GPU_SSBO_POLYLINE_COL_BUF_SLOT, &vbo, WGPUContext::BufferSSBOBindKind::Storage);
+    ctx->buffer_ssbo_bind(GPU_SSBO_INDEX_BUF_SLOT, &vbo, WGPUContext::BufferSSBOBindKind::Storage);
+    this->polyline_draw_workaround(0);
+    ctx->buffer_ssbo_unbind(&vbo);
+    return;
+  }
+
+  /* Select the pipeline for (shader, immediate vertex format, state, targets, prim). */
+  webgpu::PipelineInfo info(shader, shader->pipeline_cache_identity());
+  if (const shader::SpecializationConstants *constants =
+          shader->bound_specialization_constants())
+  {
+    info.specialization_values.assign(constants->values.begin(), constants->values.end());
+  }
+  info.vertex_formats[0] = &vertex_format;
+  info.vertex_lens[0] = int64_t(vertex_idx);
+  info.vertex_formats_len = 1;
+  if (base_ctx->state_manager != nullptr) {
+    info.state = base_ctx->state_manager->state;
+    info.mutable_state = base_ctx->state_manager->mutable_state;
+  }
+  info.empty_render_attachment = fb->target_formats(
+      info.color_formats, info.color_count, info.depth_format);
+  if (info.color_count == 0 && info.depth_format == wgpu::TextureFormat::Undefined) {
+    return;
+  }
+  info.prim_type = draw_prim_type;
+  info.flip_y = !ctx->is_window_backbuffer(fb);
+
+  wgpu::RenderPipeline pipeline = pipeline_pool().get(
+      ctx->instance_get(), ctx->device_get(), info);
+  if (pipeline == nullptr) {
+    return;
+  }
+
+  const webgpu::VertexPlan vplan = webgpu::build_vertex_plan(
+      info.vertex_formats, info.vertex_lens, info.vertex_formats_len, *shader);
+  std::vector<wgpu::Buffer> vertex_buffers;
+  if (!webgpu::vertex_buffer_handles_resolve_if_valid(
+          vplan,
+          [&](const webgpu::VertexBinding &binding) -> wgpu::Buffer {
+            if (binding.is_dummy) {
+              return ctx->dummy_vertex_buffer();
+            }
+            return binding.vbo_index == 0 ? vbo.handle() : nullptr;
+          },
+          vertex_buffers))
+  {
+    return;
+  }
+
+  std::vector<wgpu::BindGroupEntry> entries;
+  if (shader->push_constants_survive_compilation()) {
+    shader->push_constants_flush();
+    const webgpu::Buffer &pc = shader->push_constants_buffer();
+    if (pc.valid()) {
+      wgpu::BindGroupEntry entry = {};
+      entry.binding = shader->push_constants_binding();
+      entry.buffer = pc.handle();
+      entry.offset = 0;
+      entry.size = pc.size();
+      entries.push_back(entry);
+    }
+  }
+  ctx->append_resource_bind_entries(shader, entries);
+  if (!shader->bind_group_entries_complete(entries)) {
+    return;
+  }
+
+  wgpu::Device device = ctx->device_get();
+  const auto load_action = fb->load_action_transaction();
+  std::function<void(bool)> load_action_completion;
+  if (!fb->load_action_transaction_prepare(load_action, load_action_completion)) {
+    return;
+  }
+  webgpu::command_encode_submit_scoped(
+      ctx->instance_get(),
+      device,
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      "immediate draw",
+      [&](auto &enc) {
+        wgpu::RenderPassEncoder pass = fb->begin_load_pass(enc, load_action);
+        if (pass == nullptr) {
+          return false;
+        }
+        pass.SetPipeline(pipeline);
+        ctx->apply_stencil_reference(pass);
+        for (uint32_t s = 0; s < vplan.size(); s++) {
+          const webgpu::VertexBinding &b = vplan[s];
+          pass.SetVertexBuffer(s, vertex_buffers[s], b.buffer_offset);
+        }
+
+        if (!entries.empty()) {
+          const wgpu::BindGroupLayout bgl = shader->has_explicit_layout() ?
+                                                shader->explicit_bind_group_layout() :
+                                                pipeline.GetBindGroupLayout(0);
+          wgpu::BindGroup bind_group;
+          if (!webgpu::transient_handle_publish_if_valid(
+                  ctx->create_bind_group_checked(bgl, entries), bind_group))
+          {
+            return false;
+          }
+          pass.SetBindGroup(0, bind_group);
+        }
+
+        if (!fan_indices.empty()) {
+          pass.SetIndexBuffer(index_buffer, wgpu::IndexFormat::Uint32, 0);
+          pass.DrawIndexed(uint32_t(fan_indices.size()), 1, 0, 0, 0);
+        }
+        else {
+          pass.Draw(uint32_t(vertex_idx), 1, 0, 0);
+        }
+        pass.End();
+        return true;
+      },
+      [load_action_completion](const bool valid) { load_action_completion(valid); });
+}
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_immediate.hh b/source/blender/gpu/webgpu/wgpu_immediate.hh
new file mode 100644
index 0000000000000000000000000000000000000000..fb405f61591c478d5a8772a203921ee0eacd7be4
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_immediate.hh
@@ -0,0 +1,39 @@
+/* SPDX-FileCopyrightText: 2023 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_immediate.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WGPUImmediate — old-style immediate-mode drawing on WebGPU. `begin()` hands the
+ * frontend a CPU staging buffer to write the current primitive's vertices into;
+ * `end()` uploads them to a transient vertex buffer and draws them through the
+ * shared render-pipeline path (same assembly wgpu_batch uses). Must be constructed
+ * by the context ctor (`imm = new WGPUImmediate()`), as every backend does. */
+
+#pragma once
+
+#include "gpu_immediate_private.hh"
+
+#include "MEM_guardedalloc.h"
+
+#include <vector>
+
+namespace blender::gpu {
+
+class WGPUImmediate : public Immediate {
+ public:
+  uchar *begin() override;
+  void end() override;
+
+ private:
+  /** CPU staging for the current primitive; grown on demand, uploaded in end(). */
+  std::vector<uchar> cpu_buffer_;
+
+  MEM_CXX_CLASS_ALLOC_FUNCS("WGPUImmediate")
+};
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_index_buffer.cc b/source/blender/gpu/webgpu/wgpu_index_buffer.cc
new file mode 100644
index 0000000000000000000000000000000000000000..81c0d4cf71872b15f211cbd9cbdb895481380b5f
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_index_buffer.cc
@@ -0,0 +1,174 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_index_buffer.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ */
+
+#include "wgpu_index_buffer.hh"
+
+#include "GPU_context.hh"
+#include "gpu_context_private.hh"
+
+#include "wgpu_context.hh"
+
+#include "MEM_guardedalloc.h"
+
+#include <cstring>
+#include <vector>
+
+namespace blender::gpu {
+
+/** The active WebGPU context. */
+static WGPUContext *active_context()
+{
+  return static_cast<WGPUContext *>(unwrap(GPU_context_active_get()));
+}
+
+void WGPUIndexBuffer::allocate()
+{
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+  buffer_.create_scoped(ctx->instance_get(),
+                        ctx->device_get(),
+                        webgpu::BufferKind::Index,
+                        webgpu::UsageType::Static,
+                        size_get(),
+                        nullptr,
+                        true);
+}
+
+void WGPUIndexBuffer::upload_data()
+{
+  if (is_subrange_) {
+    src_->upload_data();
+    return;
+  }
+  if (buffer_.valid()) {
+    if (initial_upload_pending_) {
+      MEM_SAFE_DELETE_VOID(data_);
+      data_uploaded_ = true;
+      initial_upload_pending_ = false;
+    }
+    return; /* already uploaded (update_sub handles later edits). */
+  }
+
+  WGPUContext *ctx = active_context();
+  if (ctx == nullptr) {
+    return;
+  }
+
+  if (data_ == nullptr) {
+    /* Build-on-device index buffer: allocate empty, filled by a compute pass. */
+    allocate();
+    return;
+  }
+
+  /* Upload via mappedAtCreation so an odd U16 byte size (not a multiple of 4)
+   * still copies exactly. readable=true so read() can stage it back. */
+  initial_upload_pending_ = true;
+  if (!buffer_.create_scoped(ctx->instance_get(),
+                             ctx->device_get(),
+                             webgpu::BufferKind::Index,
+                             webgpu::UsageType::Static,
+                             size_get(),
+                             data_,
+                             true))
+  {
+    return;
+  }
+
+  /* Ownership of the index data was transferred to this IndexBuf; free it now
+   * (and null it) so the base destructor does not double-free. */
+  MEM_SAFE_DELETE_VOID(data_);
+  data_uploaded_ = true;
+  initial_upload_pending_ = false;
+}
+
+const webgpu::Buffer &WGPUIndexBuffer::buffer() const
+{
+  return is_subrange_ ? unwrap(src_)->buffer() : buffer_;
+}
+
+void WGPUIndexBuffer::read(uint32_t *data) const
+{
+  const webgpu::Buffer &buf = buffer();
+  if (!buf.valid()) {
+    return;
+  }
+  WGPUContext *ctx = active_context();
+  std::vector<uint8_t> bytes = buf.read(
+      ctx->instance_get(),
+      ctx->device_get(),
+      ctx->queue_get(),
+      ctx->queue_scheduler_get(),
+      0,
+      size_get());
+  if (!bytes.empty()) {
+    std::memcpy(data, bytes.data(), bytes.size());
+  }
+}
+
+WGPUIndexBuffer::~WGPUIndexBuffer()
+{
+  /* Drop any SSBO binding this buffer holds so a freed IBO can never leave a
+   * dangling pointer for the next dispatch/draw (the buffer_ member is released by
+   * the base destructor after this). */
+  if (WGPUContext *ctx = active_context()) {
+    ctx->buffer_ssbo_unbind(&buffer_);
+  }
+}
+
+/* Bind this index buffer as a read/write storage buffer at the given WGSL @binding
+ * (GPU_indexbuf_bind_as_ssbo — a compute pass builds the index data, e.g. the
+ * compute_ibo test / subdiv). Index buffers are allocated Index|Storage
+ * (wgpu_buffer.cc); ensure the device buffer exists (a build-on-device IBO is created
+ * empty by upload_data) and record it in the context's SSBO bind-space for the
+ * bind-group builder. Subranges bind the parent's buffer. */
+void WGPUIndexBuffer::bind_as_ssbo(uint binding)
+{
+  if (is_subrange_) {
+    unwrap(src_)->bind_as_ssbo(binding);
+    return;
+  }
+  if (!buffer_.valid()) {
+    upload_data();
+  }
+  if (!buffer_.valid()) {
+    return;
+  }
+  if (WGPUContext *ctx = active_context()) {
+    ctx->buffer_ssbo_bind(
+        int(binding), &buffer_, WGPUContext::BufferSSBOBindKind::Storage);
+  }
+}
+
+void WGPUIndexBuffer::update_sub(uint /*start*/, uint /*len*/, const void * /*data*/)
+{
+  /* Not implemented (the Vulkan backend leaves this NOT_YET_IMPLEMENTED too). */
+}
+
+void WGPUIndexBuffer::strip_restart_indices()
+{
+  /* WebGPU primitive restart is available only for strip topologies through
+   * RenderPipelineDescriptor::primitive.stripIndexFormat. Point lists cannot
+   * consume restart markers, so compact them before IndexBuf::init() squeezes
+   * the 32-bit source data to its final index representation. */
+  uint32_t *indices = static_cast<uint32_t *>(data_);
+  uint32_t write_index = 0;
+  for (uint32_t read_index = 0; read_index < index_len_; read_index++) {
+    if (indices[read_index] != RESTART_INDEX) {
+      indices[write_index] = indices[read_index];
+      write_index++;
+    }
+  }
+  index_len_ = write_index;
+}
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_index_buffer.hh b/source/blender/gpu/webgpu/wgpu_index_buffer.hh
new file mode 100644
index 0000000000000000000000000000000000000000..83c56ca794607d1f959297e526054415d1897896
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_index_buffer.hh
@@ -0,0 +1,98 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_index_buffer.hh @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * `IndexBuf` on the WebGPU backend, backed by the common `webgpu::Buffer`
+ * (Index | Storage | Copy* usage). Uploaded on first use via `mappedAtCreation`
+ * (so odd U16 buffer sizes upload without the 4-byte writeBuffer constraint).
+ * Blender uses both 16- and 32-bit index buffers; U16 buffers carry an
+ * `index_base_` applied at draw time, handled by the draw encoder (lane B).
+ * `update_sub` remains unimplemented as on Vulkan. Point-list primitive-restart
+ * markers are removed before index squeezing because WebGPU supports restart
+ * only for strip topologies.
+ */
+
+#pragma once
+
+#include <cstdint>
+
+#include "GPU_index_buffer.hh"
+
+#include "wgpu_buffer.hh"
+
+#include "MEM_guardedalloc.h"
+
+namespace blender::gpu {
+
+namespace webgpu {
+
+/** Complete WebGPU indexed-draw binding state derived from IndexBuf metadata.
+ *
+ * Direct draws bind a subrange window and use batch-relative first-index values.
+ * Blender's indirect-command generator instead writes the absolute index_start_get()
+ * and index_base_get() into every DrawCommandIndexed, so those draws must bind the
+ * complete parent allocation at offset zero. Keeping the mode and base vertex in one
+ * plan prevents alternate pass encoders from applying subrange metadata twice. */
+struct IndexBindingPlan {
+  uint64_t byte_offset = 0;
+  int32_t base_vertex = 0;
+};
+
+enum class IndexBindingMode {
+  Direct,
+  Indirect,
+};
+
+inline IndexBindingPlan index_binding_plan(const IndexBuf &index_buffer,
+                                           const IndexBindingMode mode)
+{
+  const uint64_t index_size = index_buffer.is_32bit() ? sizeof(uint32_t) : sizeof(uint16_t);
+  return {mode == IndexBindingMode::Direct ?
+              uint64_t(index_buffer.index_start_get()) * index_size :
+              0,
+          int32_t(index_buffer.index_base_get())};
+}
+
+}  // namespace webgpu
+
+class WGPUIndexBuffer : public IndexBuf {
+ public:
+  ~WGPUIndexBuffer() override;
+
+  void upload_data() override;
+  void bind_as_ssbo(uint binding) override;
+  void read(uint32_t *data) const override;
+  void update_sub(uint start, uint len, const void *data) override;
+
+  /** WebGPU index format for this buffer (Uint16 / Uint32). */
+  wgpu::IndexFormat index_format() const
+  {
+    return webgpu::to_wgpu_index_format(is_32bit());
+  }
+
+  const webgpu::Buffer &buffer() const;
+
+ private:
+  void strip_restart_indices() override;
+  void allocate();
+
+  webgpu::Buffer buffer_;
+  /** Initial mapped upload has begun but its resource scopes have not yet committed. */
+  bool initial_upload_pending_ = false;
+  bool data_uploaded_ = false;
+
+  MEM_CXX_CLASS_ALLOC_FUNCS("WGPUIndexBuffer")
+};
+
+static inline WGPUIndexBuffer *unwrap(IndexBuf *index_buffer)
+{
+  return static_cast<WGPUIndexBuffer *>(index_buffer);
+}
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_pipeline.cc b/source/blender/gpu/webgpu/wgpu_pipeline.cc
new file mode 100644
index 0000000000000000000000000000000000000000..99e080986fafe071c3d710f77e21f648733fadac
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_pipeline.cc
@@ -0,0 +1,608 @@
+/* SPDX-FileCopyrightText: 2024 Blender Authors
+ * SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later
+ *
+ * Ported for the web from source/blender/gpu/vulkan/vk_pipeline.cc @ fbe6228777e7 */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WebGPU render-pipeline assembly + cache. See wgpu_pipeline.hh. Fixed-function
+ * state is mapped by B2's wgpu_state_table (pure functions); the pipeline layout is
+ * inferred by Dawn from the WGSL modules (auto layout) so it matches the Tint output
+ * exactly — wgpu_batch obtains the bind-group layout via GetBindGroupLayout(). */
+
+#include "wgpu_pipeline.hh"
+
+#include "wgpu_shader.hh"
+#include "wgpu_state_table.hh"
+
+#include "gpu_shader_interface.hh"
+
+#include "GPU_common_types.hh" /* shader::Type (dummy attribute format) */
+
+#include "BLI_assert.h"
+
+#include <cstring>
+#include <vector>
+
+namespace blender::gpu::webgpu {
+
+wgpu::PrimitiveTopology to_wgpu_topology(GPUPrimType prim)
+{
+  switch (prim) {
+    case GPU_PRIM_POINTS:
+      return wgpu::PrimitiveTopology::PointList;
+    case GPU_PRIM_LINES:
+      return wgpu::PrimitiveTopology::LineList;
+    case GPU_PRIM_LINE_STRIP:
+    case GPU_PRIM_LINE_LOOP: /* WebGPU has no loop; strip is the closest (batch closes it). */
+      return wgpu::PrimitiveTopology::LineStrip;
+    case GPU_PRIM_TRI_STRIP:
+      return wgpu::PrimitiveTopology::TriangleStrip;
+    case GPU_PRIM_TRI_FAN:
+      /* Immediate and direct batch paths must translate fans before pipeline lookup.
+       * Keep unhandled paths visible rather than silently misrendering as strips. */
+      BLI_assert_unreachable();
+      return wgpu::PrimitiveTopology::TriangleList;
+    case GPU_PRIM_TRIS:
+    default:
+      return wgpu::PrimitiveTopology::TriangleList;
+  }
+}
+
+wgpu::IndexFormat to_wgpu_strip_index_format(const GPUPrimType prim,
+                                             const wgpu::IndexFormat index_format)
+{
+  if (index_format == wgpu::IndexFormat::Undefined) {
+    return wgpu::IndexFormat::Undefined;
+  }
+  switch (prim) {
+    case GPU_PRIM_LINE_STRIP:
+    case GPU_PRIM_LINE_LOOP:
+    case GPU_PRIM_TRI_STRIP:
+      return index_format;
+    default:
+      /* Dawn requires Undefined for every non-strip topology. */
+      return wgpu::IndexFormat::Undefined;
+  }
+}
+
+bool indirect_draw_span(const int count,
+                        const intptr_t offset,
+                        const intptr_t stride,
+                        const bool indexed,
+                        const uint64_t buffer_size,
+                        IndirectDrawSpan &r_span)
+{
+  if (count <= 0 || offset < 0 || stride < 0) {
+    return false;
+  }
+
+  IndirectDrawSpan candidate;
+  candidate.first_offset = uint64_t(offset);
+  candidate.command_size = indexed ? 5u * sizeof(uint32_t) : 4u * sizeof(uint32_t);
+  /* Blender's API follows glMultiDraw*Indirect: zero means tightly packed. */
+  candidate.command_stride = (stride == 0) ? candidate.command_size : uint64_t(stride);
+  if ((candidate.first_offset & 3u) != 0 || (candidate.command_stride & 3u) != 0) {
+    return false;
+  }
+
+  /* First reserve the final command's fixed byte span inside the allocation. The
+   * remaining quotient then bounds (count - 1) * stride without overflowing. */
+  if (candidate.command_size > buffer_size ||
+      candidate.first_offset > buffer_size - candidate.command_size)
+  {
+    return false;
+  }
+  const uint64_t last_start_capacity =
+      buffer_size - candidate.command_size - candidate.first_offset;
+  const uint64_t steps = uint64_t(count - 1);
+  if (steps > last_start_capacity / candidate.command_stride) {
+    return false;
+  }
+  candidate.end_offset = candidate.first_offset + steps * candidate.command_stride +
+                         candidate.command_size;
+  r_span = candidate;
+  return true;
+}
+
+/** Map a Blender vertex component (type, count, fetch) to the WGSL vertex format.
+ * WebGPU allows only x2/x4 for 8-/16-bit and scalar…x4 for 32-bit. */
+wgpu::VertexFormat to_wgpu_vertex_format(GPUVertCompType comp_type,
+                                         int comp_len,
+                                         GPUVertFetchMode fetch)
+{
+  using VF = wgpu::VertexFormat;
+  const bool norm = (fetch == GPU_FETCH_INT_TO_FLOAT_UNIT);
+  const int n = comp_len;
+  switch (comp_type) {
+    case GPU_COMP_F32:
+      return (n == 1) ? VF::Float32 : (n == 2) ? VF::Float32x2 : (n == 3) ? VF::Float32x3 :
+                                                                            VF::Float32x4;
+    case GPU_COMP_I32:
+      return (n == 1) ? VF::Sint32 : (n == 2) ? VF::Sint32x2 : (n == 3) ? VF::Sint32x3 :
+                                                                          VF::Sint32x4;
+    case GPU_COMP_U32:
+      return (n == 1) ? VF::Uint32 : (n == 2) ? VF::Uint32x2 : (n == 3) ? VF::Uint32x3 :
+                                                                          VF::Uint32x4;
+    case GPU_COMP_I16:
+      if (norm) {
+        return (n <= 2) ? VF::Snorm16x2 : VF::Snorm16x4;
+      }
+      return (n <= 2) ? VF::Sint16x2 : VF::Sint16x4;
+    case GPU_COMP_U16:
+      if (norm) {
+        return (n <= 2) ? VF::Unorm16x2 : VF::Unorm16x4;
+      }
+      return (n <= 2) ? VF::Uint16x2 : VF::Uint16x4;
+    case GPU_COMP_I8:
+      if (norm) {
+        return (n <= 2) ? VF::Snorm8x2 : VF::Snorm8x4;
+      }
+      return (n <= 2) ? VF::Sint8x2 : VF::Sint8x4;
+    case GPU_COMP_U8:
+      if (norm) {
+        return (n <= 2) ? VF::Unorm8x2 : VF::Unorm8x4;
+      }
+      return (n <= 2) ? VF::Uint8x2 : VF::Uint8x4;
+    case GPU_COMP_I10:
+      /* Packed signed normals (2_10_10_10, always GPU_FETCH_INT_TO_FLOAT_UNIT). WebGPU
+       * has NO signed snorm 10_10_10_2 vertex format (only the unsigned Unorm10_10_10_2),
+       * so the packed data is transcoded to Snorm8x4 at upload (same 4-byte stride, see
+       * wgpu_vertex_buffer.cc `transcode_i10_attrs`) and reported as Snorm8x4 here to
+       * match. The pre-r37 mapping to the UNSIGNED Unorm10_10_10_2 decoded every negative
+       * normal component as positive, sign-flipping the normal of any face whose object
+       * normal had a negative component (e.g. the default cube's -Y face read as +Y),
+       * which inverted its workbench studio-light shading. Vulkan uses the native signed
+       * A2B10G10R10_SNORM_PACK32 (vk_common.cc:244); Snorm8x4 is the closest WebGPU
+       * equivalent (8-bit precision, exact for the axis normals; ample for workbench). */
+      return norm ? VF::Snorm8x4 : VF::Unorm10_10_10_2;
+    default:
+      return VF::Float32x4;
+  }
+}
+
+/* --- Cache key -------------------------------------------------------------- */
+
+static void hash_bytes(uint64_t &h, const void *data, size_t len)
+{
+  const uint8_t *p = static_cast<const uint8_t *>(data);
+  for (size_t i = 0; i < len; i++) {
+    h ^= p[i];
+    h *= 1099511628211ull; /* FNV-1a prime */
+  }
+}
+
+static void hash_shader_identity(uint64_t &h, const void *shader, const uint64_t identity)
+{
+  hash_bytes(h, &shader, sizeof(shader));
+  hash_bytes(h, &identity, sizeof(identity));
+}
+
+static uint64_t pipeline_hash(const PipelineInfo &info)
+{
+  uint64_t h = 1469598103934665603ull; /* FNV offset basis */
+  hash_shader_identity(h, info.shader, info.shader_cache_identity);
+  hash_bytes(h, &info.state.data, sizeof(info.state.data));
+  hash_bytes(h, info.mutable_state.data, sizeof(info.mutable_state.data));
+  hash_bytes(h, info.color_formats, sizeof(wgpu::TextureFormat) * info.color_count);
+  hash_bytes(h, &info.color_count, sizeof(info.color_count));
+  hash_bytes(h, &info.empty_render_attachment, sizeof(info.empty_render_attachment));
+  hash_bytes(h, &info.depth_format, sizeof(info.depth_format));
+  hash_bytes(h, &info.prim_type, sizeof(info.prim_type));
+  hash_bytes(h, &info.strip_index_format, sizeof(info.strip_index_format));
+  const uint32_t specialization_count = uint32_t(info.specialization_values.size());
+  hash_bytes(h, &specialization_count, sizeof(specialization_count));
+  for (const shader::SpecializationConstant::Value &value : info.specialization_values) {
+    /* Raw bits distinguish every override value, including float bit patterns.
+     * The shader pointer above fixes the ordered types. */
+    hash_bytes(h, &value.u, sizeof(value.u));
+  }
+  hash_bytes(h, &info.flip_y, sizeof(info.flip_y));
+  /* The vertex plan (hence the pipeline VertexState) is a pure function of the shader
+   * (hashed above) and the bound formats — attribute comp signature, offset, name (the
+   * name drives which @location it matches) and the deinterleaved flag. vertex_len is a
+   * binding-time value only (deinterleaved buffer offset) and never affects the layout. */
+  hash_bytes(h, &info.vertex_formats_len, sizeof(info.vertex_formats_len));
+  for (int v = 0; v < info.vertex_formats_len; v++) {
+    const GPUVertFormat *f = info.vertex_formats[v];
+    uint8_t present = (f != nullptr) ? 1u : 0u;
+    hash_bytes(h, &present, 1);
+    if (f == nullptr) {
+      continue;
+    }
+    uint32_t stride = f->stride;
+    uint32_t attr_len = f->attr_len;
+    uint32_t deint = f->deinterleaved;
+    hash_bytes(h, &stride, sizeof(stride));
+    hash_bytes(h, &attr_len, sizeof(attr_len));
+    hash_bytes(h, &deint, sizeof(deint));
+    for (uint i = 0; i < f->attr_len; i++) {
+      const GPUVertAttr &a = f->attrs[i];
+      uint16_t off = uint16_t(a.offset);
+      uint8_t sig[3] = {uint8_t(a.type.comp_type()), uint8_t(a.type.comp_len()),
+                        uint8_t(a.type.fetch_mode())};
+      hash_bytes(h, sig, sizeof(sig));
+      hash_bytes(h, &off, sizeof(off));
+      hash_bytes(h, &a.name_len, sizeof(a.name_len));
+      for (uint nidx = 0; nidx < a.name_len; nidx++) {
+        const char *nm = GPU_vertformat_attr_name_get(f, &a, nidx);
+        const uint32_t name_length = nm != nullptr ? uint32_t(std::strlen(nm)) : UINT32_MAX;
+        hash_bytes(h, &name_length, sizeof(name_length));
+        if (nm != nullptr) {
+          hash_bytes(h, nm, name_length);
+        }
+      }
+    }
+  }
+  return h;
+}
+
+/* --- Build ------------------------------------------------------------------ */
+
+static wgpu::RenderPipeline build_pipeline(const wgpu::Instance &instance,
+                                           const wgpu::Device &device,
+                                           const PipelineInfo &info)
+{
+  WGPUShader *shader = info.shader;
+  if (shader->explicit_layout_required() &&
+      !shader->ensure_explicit_layout(instance, device))
+  {
+    return nullptr;
+  }
+
+  auto specialization_entries = [&](const uint32_t stage,
+                                    std::vector<std::string> &r_keys,
+                                    std::vector<wgpu::ConstantEntry> &r_entries) {
+    if (info.specialization_values.empty()) {
+      return;
+    }
+    const int count = int(info.specialization_values.size());
+    r_keys.reserve(count);
+    r_entries.reserve(count + 1);
+    for (int i = 0; i < count; i++) {
+      if (!shader->specialization_constant_used(uint32_t(i), stage)) {
+        continue;
+      }
+      r_keys.push_back(std::to_string(i));
+      const shader::SpecializationConstant::Value &value = info.specialization_values[i];
+      const bool is_int = shader->specialization_constant_type(uint32_t(i)) ==
+                          blender::gpu::shader::Type::int_t;
+      wgpu::ConstantEntry entry = {};
+      entry.key = r_keys.back().c_str();
+      /* Float constants are emitted as uint bit-pattern overrides and converted
+       * inside WGSL; bool and uint are likewise represented by Value::u. */
+      entry.value = is_int ? double(value.i) : double(value.u);
+      r_entries.push_back(entry);
+    }
+  };
+
+  std::vector<std::string> vertex_constant_keys;
+  std::vector<wgpu::ConstantEntry> vertex_constants;
+  specialization_entries(
+      uint32_t(STAGE_VERTEX), vertex_constant_keys, vertex_constants);
+  std::vector<std::string> fragment_constant_keys;
+  std::vector<wgpu::ConstantEntry> fragment_constants;
+  specialization_entries(
+      uint32_t(STAGE_FRAGMENT), fragment_constant_keys, fragment_constants);
+
+  /* Vertex buffer layouts: one WebGPU slot per source VBO (all its matched attributes,
+   * interleaved) plus a dummy slot per shader-required-but-unbound location. The plan is
+   * a pure function of (shader interface, formats) and the identical plan is rebuilt at
+   * draw time to bind buffers to matching slots (wgpu_batch / wgpu_immediate). Holds the
+   * attribute vectors alive for CreateRenderPipeline below. */
+  const VertexPlan plan = build_vertex_plan(
+      info.vertex_formats, info.vertex_lens, info.vertex_formats_len, *shader);
+  std::vector<wgpu::VertexBufferLayout> vbo_layouts;
+  vbo_layouts.reserve(plan.size());
+  for (const VertexBinding &b : plan) {
+    wgpu::VertexBufferLayout layout = {};
+    layout.arrayStride = b.array_stride;
+    layout.stepMode = b.step_mode;
+    layout.attributeCount = uint32_t(b.attributes.size());
+    layout.attributes = b.attributes.data();
+    vbo_layouts.push_back(layout);
+  }
+
+  wgpu::VertexState vertex = {};
+  vertex.module = shader->vertex_module();
+  vertex.bufferCount = uint32_t(vbo_layouts.size());
+  vertex.buffers = vbo_layouts.empty() ? nullptr : vbo_layouts.data();
+
+  /* Present-path Y-flip (M4.T14a): render the surface backbuffer upright by overriding
+   * the vertex clip-space Y sign to +1.0f (constant_id 1000, uint bit pattern). Offscreen
+   * pipelines leave the override unset so it keeps its -1.0f default, byte-identical to
+   * before this change. `y_sign_override` must outlive CreateRenderPipeline below. */
+  wgpu::ConstantEntry y_sign_override = {};
+  if (!info.flip_y) {
+    y_sign_override.key = "1000";
+    y_sign_override.value = double(0x3F800000u); /* +1.0f bit pattern (uint override) */
+    vertex_constants.push_back(y_sign_override);
+  }
+  vertex.constantCount = vertex_constants.size();
+  vertex.constants = vertex_constants.empty() ? nullptr : vertex_constants.data();
+
+  /* Colour targets: one per bound colour attachment; blend + write mask from B2. */
+  const BlendMapping bm = to_blend(GPUBlend(info.state.blend));
+  wgpu::BlendState blend = {};
+  blend.color = bm.color;
+  blend.alpha = bm.alpha;
+  const wgpu::ColorWriteMask write_mask = to_color_write_mask(GPUWriteMask(info.state.write_mask));
+
+  std::vector<wgpu::ColorTargetState> targets(info.color_count);
+  for (int i = 0; i < info.color_count; i++) {
+    targets[i].format = info.color_formats[i];
+    if (info.color_formats[i] == wgpu::TextureFormat::Undefined) {
+      /* Gap slot (GPU_ATTACHMENT_NONE preserved by WGPUFrameBuffer::target_formats):
+       * a null colour target. WebGPU requires it carry no blend and writeMask None;
+       * the matching fragment output (if the shader writes one) is discarded, exactly
+       * as native Vulkan does at a VK_ATTACHMENT_UNUSED slot (probe Q1/Q6). */
+      targets[i].blend = nullptr;
+      targets[i].writeMask = wgpu::ColorWriteMask::None;
+      continue;
+    }
+    targets[i].blend = (bm.enabled && !info.empty_render_attachment) ? &blend : nullptr;
+    targets[i].writeMask = info.empty_render_attachment ? wgpu::ColorWriteMask::None : write_mask;
+  }
+
+  wgpu::FragmentState fragment = {};
+  fragment.module = shader->fragment_module();
+  fragment.targetCount = targets.size();
+  fragment.targets = targets.empty() ? nullptr : targets.data();
+  fragment.constantCount = fragment_constants.size();
+  fragment.constants = fragment_constants.empty() ? nullptr : fragment_constants.data();
+
+  /* Primitive. */
+  wgpu::PrimitiveState primitive = {};
+  primitive.topology = to_wgpu_topology(info.prim_type);
+  primitive.stripIndexFormat = info.strip_index_format;
+  /* ADR-005 decision 2 (winding compensation): lane A's vertex-shader clip-space
+   * Y-flip (decision 1) inverts effective triangle winding in framebuffer space, so
+   * swap the front-face (CW<->CCW) here to keep Blender's GL-convention facing. The
+   * base mapping (to_front_face: GL CCW default, invert_facing -> CW) is negated. */
+  const wgpu::FrontFace base_front = to_front_face(info.state.invert_facing);
+  const wgpu::FrontFace swapped_front = (base_front == wgpu::FrontFace::CCW) ?
+                                            wgpu::FrontFace::CW :
+                                            wgpu::FrontFace::CCW;
+  /* The winding swap is paired with the clip-space Y-flip: apply it only when the flip is
+   * active (offscreen). The window backbuffer renders un-flipped (M4.T14a), so its winding
+   * is not inverted and the base facing is correct. */
+  primitive.frontFace = info.flip_y ? swapped_front : base_front;
+  primitive.cullMode = to_cull_mode(GPUFaceCullTest(info.state.culling_test));
+
+  /* Depth / stencil (only when a depth attachment is bound). */
+  wgpu::DepthStencilState depth_stencil = {};
+  const bool has_depth = info.depth_format != wgpu::TextureFormat::Undefined;
+  if (has_depth) {
+    const DepthMapping dm = to_depth(GPUDepthTest(info.state.depth_test));
+    const StencilMapping sm = to_stencil(GPUStencilTest(info.state.stencil_test),
+                                         GPUStencilOp(info.state.stencil_op));
+    depth_stencil.format = info.depth_format;
+    depth_stencil.depthCompare = dm.compare;
+    /* Per B2's contract: depthWriteEnabled follows the WRITE mask, not the test. */
+    depth_stencil.depthWriteEnabled = (info.state.write_mask & GPU_WRITE_DEPTH) ?
+                                          wgpu::OptionalBool::True :
+                                          wgpu::OptionalBool::False;
+    const bool has_stencil = ELEM(info.depth_format,
+                                  wgpu::TextureFormat::Stencil8,
+                                  wgpu::TextureFormat::Depth24PlusStencil8,
+                                  wgpu::TextureFormat::Depth32FloatStencil8);
+    if (sm.enabled && has_stencil) {
+      depth_stencil.stencilFront = sm.front;
+      depth_stencil.stencilBack = sm.back;
+      depth_stencil.stencilReadMask = info.mutable_state.stencil_compare_mask;
+      depth_stencil.stencilWriteMask = info.mutable_state.stencil_write_mask;
+    }
+  }
+
+  wgpu::RenderPipelineDescriptor desc = {};
+  /* Explicit group-0 layout when the shader has full interface-map coverage — its
+   * resource types (depth reads as UnfilterableFloat, sampler/comparison, view dim) are
+   * correct where Dawn's WGSL-inferred auto layout is not. Fall back to auto layout for
+   * a shader that logged incomplete coverage (never a silent per-binding mix). */
+  desc.layout = shader->has_explicit_layout() ? shader->explicit_pipeline_layout() : nullptr;
+  desc.vertex = vertex;
+  desc.primitive = primitive;
+  desc.depthStencil = has_depth ? &depth_stencil : nullptr;
+  desc.fragment = &fragment;
+
+  return device.CreateRenderPipeline(&desc);
+}
+
+/** Map a shader vertex-input Type to a WebGPU vertex format (+ its byte size) for a dummy
+ * slot. Only the base kind (float/uint/sint) must match the WGSL input; missing components
+ * are filled (0,0,0,1) by WebGPU exactly as GL fills a disabled attribute. */
+static wgpu::VertexFormat dummy_vertex_format(uint8_t type_byte, uint32_t &r_size)
+{
+  using T = blender::gpu::shader::Type;
+  using VF = wgpu::VertexFormat;
+  switch (T(type_byte)) {
+    case T::float_t:              r_size = 4;  return VF::Float32;
+    case T::float2_t:             r_size = 8;  return VF::Float32x2;
+    case T::float3_t:
+    case T::float3_10_10_10_2_t:  r_size = 12; return VF::Float32x3;
+    case T::float4_t:
+    case T::float3x3_t:
+    case T::float4x4_t:           r_size = 16; return VF::Float32x4;
+    case T::uint_t:
+    case T::bool_t:
+    case T::uchar_t:
+    case T::ushort_t:             r_size = 4;  return VF::Uint32;
+    case T::uint2_t:
+    case T::uchar2_t:
+    case T::ushort2_t:            r_size = 8;  return VF::Uint32x2;
+    case T::uint3_t:
+    case T::uchar3_t:
+    case T::ushort3_t:            r_size = 12; return VF::Uint32x3;
+    case T::uint4_t:
+    case T::uchar4_t:
+    case T::ushort4_t:            r_size = 16; return VF::Uint32x4;
+    case T::int_t:
+    case T::char_t:
+    case T::short_t:              r_size = 4;  return VF::Sint32;
+    case T::int2_t:
+    case T::char2_t:
+    case T::short2_t:             r_size = 8;  return VF::Sint32x2;
+    case T::int3_t:
+    case T::char3_t:
+    case T::short3_t:             r_size = 12; return VF::Sint32x3;
+    case T::int4_t:
+    case T::char4_t:
+    case T::short4_t:             r_size = 16; return VF::Sint32x4;
+    default:                      r_size = 16; return VF::Float32x4;
+  }
+}
+
+static VertexBinding dummy_vertex_binding(const uint32_t location, const uint8_t type_byte)
+{
+  uint32_t attribute_size = 0;
+  const wgpu::VertexFormat format = dummy_vertex_format(type_byte, attribute_size);
+  BLI_assert(attribute_size <= 16);
+
+  VertexBinding binding;
+  binding.vbo_index = -1;
+  binding.is_dummy = true;
+  binding.buffer_offset = 0;
+  /* Pinned Dawn accepts zero array stride and validates only the attribute's fixed byte span.
+   * Match Vulkan's constant-attribute binding so firstVertex/firstInstance and draw counts can
+   * never walk past the shared 16-byte zero buffer. */
+  binding.array_stride = 0;
+  binding.step_mode = wgpu::VertexStepMode::Vertex;
+  wgpu::VertexAttribute attribute = {};
+  attribute.format = format;
+  attribute.offset = 0;
+  attribute.shaderLocation = location;
+  binding.attributes.push_back(attribute);
+  return binding;
+}
+
+VertexPlan build_vertex_plan(const GPUVertFormat *const *formats,
+                             const int64_t *vertex_lens,
+                             int formats_len,
+                             WGPUShader &shader)
+{
+  VertexPlan plan;
+  const ShaderInterface *itf = shader.interface;
+  if (itf == nullptr) {
+    return plan;
+  }
+  uint32_t occupied = 0; /* @location bitmask already fed by a real VBO. */
+
+  auto match_location = [&](const GPUVertFormat *f, const GPUVertAttr &a) -> int {
+    for (uint nidx = 0; nidx < a.name_len; nidx++) {
+      const char *nm = GPU_vertformat_attr_name_get(f, &a, nidx);
+      const ShaderInput *in = itf->attr_get(nm);
+      if (in != nullptr && in->location >= 0) {
+        return in->location;
+      }
+    }
+    return -1;
+  };
+
+  for (int v = 0; v < formats_len; v++) {
+    const GPUVertFormat *f = formats[v];
+    if (f == nullptr || f->attr_len == 0) {
+      continue;
+    }
+    const int64_t vlen = (vertex_lens != nullptr) ? vertex_lens[v] : 0;
+
+    if (!f->deinterleaved) {
+      /* One interleaved slot for the whole VBO — its matched attributes at their real
+       * offsets, stride = format stride. Keeps a single-VBO batch byte-identical to the
+       * pre-multi-buffer path (one slot). */
+      VertexBinding b;
+      b.vbo_index = v;
+      b.buffer_offset = 0;
+      b.array_stride = f->stride;
+      b.step_mode = wgpu::VertexStepMode::Vertex;
+      for (uint i = 0; i < f->attr_len; i++) {
+        const GPUVertAttr &a = f->attrs[i];
+        const int loc = match_location(f, a);
+        if (loc < 0 || loc >= 32 || (occupied & (1u << loc)) != 0u) {
+          continue;
+        }
+        occupied |= (1u << loc);
+        wgpu::VertexAttribute va = {};
+        va.format = to_wgpu_vertex_format(
+            a.type.comp_type(), a.type.comp_len(), a.type.fetch_mode());
+        va.offset = a.offset;
+        va.shaderLocation = uint32_t(loc);
+        b.attributes.push_back(va);
+      }
+      if (!b.attributes.empty()) {
+        plan.push_back(std::move(b));
+      }
+    }
+    else {
+      /* Deinterleaved: each attribute is its own tightly-packed block within the VBO,
+       * bound at a running byte offset (mirrors VKVertexAttributeObject). */
+      uint64_t buf_off = 0;
+      for (uint i = 0; i < f->attr_len; i++) {
+        const GPUVertAttr &a = f->attrs[i];
+        if (i > 0) {
+          buf_off += uint64_t(f->attrs[i - 1].type.size()) * uint64_t(vlen);
+        }
+        const int loc = match_location(f, a);
+        if (loc < 0 || loc >= 32 || (occupied & (1u << loc)) != 0u) {
+          continue;
+        }
+        occupied |= (1u << loc);
+        uint32_t stride = uint32_t(a.type.size());
+        stride = (stride + 3u) & ~3u; /* WebGPU: arrayStride multiple of 4. */
+        VertexBinding b;
+        b.vbo_index = v;
+        b.buffer_offset = buf_off;
+        b.array_stride = stride;
+        b.step_mode = wgpu::VertexStepMode::Vertex;
+        wgpu::VertexAttribute va = {};
+        va.format = to_wgpu_vertex_format(
+            a.type.comp_type(), a.type.comp_len(), a.type.fetch_mode());
+        va.offset = 0;
+        va.shaderLocation = uint32_t(loc);
+        b.attributes.push_back(va);
+        plan.push_back(std::move(b));
+      }
+    }
+  }
+
+  /* Dummy-fill: any @location the vertex module consumes but no VBO provided. Dawn accepts
+   * arrayStride zero and applies one fixed attribute span to the whole draw, so this remains
+   * the constant 0 an unbound GL attribute yields for arbitrary vertex and instance ranges. */
+  const uint32_t enabled = itf->enabled_attr_mask_;
+  for (int loc = 0; loc < 16; loc++) {
+    const uint32_t m = (1u << loc);
+    if ((enabled & m) == 0u || (occupied & m) != 0u) {
+      continue;
+    }
+    plan.push_back(dummy_vertex_binding(uint32_t(loc), itf->attr_types_[loc]));
+  }
+
+  return plan;
+}
+
+wgpu::RenderPipeline WGPUPipelinePool::get(const wgpu::Instance &instance,
+                                           const wgpu::Device &device,
+                                           const PipelineInfo &info)
+{
+  BLI_assert(info.shader != nullptr);
+  BLI_assert(info.shader_cache_identity != 0);
+  BLI_assert(info.shader_cache_identity == info.shader->pipeline_cache_identity());
+  if (!info.shader->ensure_shader_modules(instance, device)) {
+    return nullptr;
+  }
+  if (info.shader->explicit_layout_required() &&
+      !info.shader->ensure_explicit_layout(instance, device))
+  {
+    return nullptr;
+  }
+  const uint64_t key = pipeline_hash(info);
+  return cache_.get_or_create(instance,
+                              device,
+                              key,
+                              "render pipeline creation",
+                              [&]() { return build_pipeline(instance, device, info); });
+}
+
+}  // namespace blender::gpu::webgpu
