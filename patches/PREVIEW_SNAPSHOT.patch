+    /* op_log2 is `log(a) / log(b)`: either logarithm may itself have a pole, and a base of one
+     * makes the final division's denominator zero. The latter is a pole only for a finite,
+     * non-zero numerator; 0/0 and infinity/infinity are invalid operations instead. */
+    if (arg_a == 0.0 || arg_b == 0.0 ||
+        (arg_b == 1.0 && arg_a > 0.0 && std::isfinite(arg_a) && arg_a != 1.0))
+    {
