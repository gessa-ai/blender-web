+void on_texture_read(WGPUTexture *tex)
+{
+  /* ensure_enabled() latches on the first frame BW_DIAG is observed; on_texture_read may
+   * run before poll_and_pump's first call, so it re-checks here too (cheap getenv until
+   * latched). A no-op with BW_DIAG unset, so production and the pixel goldens read back
+   * exactly as before. */
+  if (!ensure_enabled() || tex == nullptr) {
+    return;
+  }
+  if (g_read_captures >= kMaxReadCaptures) {
+    if (g_read_captures == kMaxReadCaptures) {
+      g_read_captures++; /* latch the cap message once */
+      stderr_line("BW_DIAG on_texture_read: capture cap reached, further reads not kicked\n");
+    }
+    return;
+  }
+  /* Kick BEFORE read()'s own copy+WaitAny runs: the CopyTextureToBuffer is queued while
+   * the source texture still holds the render result, so the staging buffer retains the
+   * true bytes even after the transient render texture is pooled/freed (Dawn keeps a
+   * texture alive until submitted commands complete). The completion rides a later tick
+   * via AllowSpontaneous (ADR-007), landing the bytes in /tmp/bw_readback_<seq>.bin. */
+  char label[32];
+  std::snprintf(label, sizeof(label), "texread_%d", g_read_captures);
+  g_read_captures++;
+  tex->diag_kick_readback(label);
+}
