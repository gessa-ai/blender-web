diff --git a/source/blender/gpu/webgpu/wgpu_index_buffer.cc b/source/blender/gpu/webgpu/wgpu_index_buffer.cc
--- a/source/blender/gpu/webgpu/wgpu_index_buffer.cc
+++ b/source/blender/gpu/webgpu/wgpu_index_buffer.cc
@@ -66,11 +66,14 @@ void WGPUIndexBuffer::upload_data()
   /* Upload via mappedAtCreation so an odd U16 byte size (not a multiple of 4)
