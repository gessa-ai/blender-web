+   * truncation, up front, before any partial state is built. */
+  if (blo_wasm32_pointer_collision_refuse(fd)) {
+    return nullptr;
+  }
+#endif
+
   const bool is_undo = (fd->flags & FD_FLAGS_IS_MEMFILE) != 0;
   if (is_undo) {
     CLOG_DEBUG(&LOG_UNDO, "UNDO: read step");
