+/** Publish a short-lived WebGPU handle only after creation succeeds. Failure leaves the
+ * caller-owned result unchanged. Templated so transient resource failure remains device-free
+ * testable on native and Wasm. */
+template<typename HandleT>
+inline bool transient_handle_publish_if_valid(HandleT candidate, HandleT &result)
+{
+  if (candidate == nullptr) {
+    return false;
+  }
+  result = std::move(candidate);
+  return true;
+}
