+enum class AnnotationDepthCacheState {
+  Ready,
+  Pending,
+  Failed,
+};
+
+static eV3DDepthOverrideMode annotation_depth_cache_mode_get(const tGPsdata *p)
+{
+  if (p->paintmode == GP_PAINTMODE_ERASER) {
+    return V3D_DEPTH_NO_GPENCIL;
+  }
+
+  const ToolSettings *ts = p->scene->toolsettings;
+  if (ts->annotate_v3d_align & GP_PROJECT_DEPTH_VIEW) {
+    return (ts->annotate_v3d_align & GP_PROJECT_DEPTH_ONLY_SELECTED) ?
+               V3D_DEPTH_SELECTED_ONLY :
+               V3D_DEPTH_ALL;
+  }
+  return V3D_DEPTH_GPENCIL_ONLY;
+}
+
+static void annotation_depth_cache_discard(tGPsdata *p)
+{
+  if (p->depths != nullptr) {
+    ED_view3d_depths_free(p->depths);
+    p->depths = nullptr;
+  }
+  p->depth_cache_region_view = nullptr;
+  p->depth_cache_region_size[0] = 0;
+  p->depth_cache_region_size[1] = 0;
+  p->depth_cache_valid = false;
+}
+
+static bool annotation_depth_cache_matches(const tGPsdata *p,
+                                           const eV3DDepthOverrideMode mode)
+{
+  if (!p->depth_cache_valid || p->depths == nullptr || p->region == nullptr ||
+      p->region->regiondata == nullptr || p->depth_cache_mode != mode ||
+      p->region->regiondata != p->depth_cache_region_view ||
+      p->region->winx != p->depth_cache_region_size[0] ||
+      p->region->winy != p->depth_cache_region_size[1])
+  {
+    return false;
+  }
+
+  const RegionView3D *region_view = static_cast<const RegionView3D *>(p->region->regiondata);
+  return equals_m4m4(region_view->viewinv, p->depth_cache_viewinv) &&
+         equals_m4m4(region_view->winmat, p->depth_cache_winmat);
+}
+
+static void annotation_depth_timer_remove(tGPsdata *p)
+{
+  if (p->depth_cache_timer != nullptr) {
+    WM_event_timer_remove(p->depth_cache_manager, p->win, p->depth_cache_timer);
+    p->depth_cache_timer = nullptr;
+  }
+  p->depth_cache_tick_count = 0;
+}
+
+static void annotation_depth_wait_cancel(tGPsdata *p)
+{
+  annotation_depth_timer_remove(p);
+  MEM_SAFE_DELETE(p->depth_cache_events);
+  MEM_SAFE_DELETE(p->depth_cache_session);
+  p->depth_cache_pending = false;
+  p->depth_cache_resume_apply_event = false;
+  p->depth_cache_manager = nullptr;
+  p->depth_cache_screen = nullptr;
+}
+
+static bool annotation_depth_event_push(tGPsdata *p, const wmEvent *event)
+{
+  constexpr int max_queued_events = 256;
+  if (event == nullptr || event->type == TIMER || event->custom != 0 ||
+      event->customdata != nullptr || p->depth_cache_events == nullptr ||
+      p->depth_cache_events->size() >= max_queued_events)
+  {
+    return false;
+  }
+
+  wmEvent queued = *event;
+  queued.next = nullptr;
+  queued.prev = nullptr;
+  queued.custom = 0;
+  queued.customdata = nullptr;
+  queued.customdata_free = false;
+  p->depth_cache_events->append(queued);
+  return true;
+}
+
+static bool annotation_depth_cache_take(tGPsdata *p)
+{
+  ViewDepths *depths = p->depth_cache_session->take(p->region);
+  if (depths == nullptr) {
+    return false;
+  }
+
+  annotation_depth_cache_discard(p);
+  p->depths = depths;
+  p->depth_cache_region_view = static_cast<RegionView3D *>(p->region->regiondata);
+  p->depth_cache_region_size[0] = p->region->winx;
+  p->depth_cache_region_size[1] = p->region->winy;
+  copy_m4_m4(p->depth_cache_viewinv, p->depth_cache_region_view->viewinv);
+  copy_m4_m4(p->depth_cache_winmat, p->depth_cache_region_view->winmat);
+  p->depth_cache_valid = true;
+  MEM_SAFE_DELETE(p->depth_cache_session);
+  return true;
+}
+
+static AnnotationDepthCacheState annotation_depth_cache_begin(
+    bContext *C, tGPsdata *p, const eV3DDepthOverrideMode mode)
+{
+  if (annotation_depth_cache_matches(p, mode)) {
+    return AnnotationDepthCacheState::Ready;
+  }
+  if (p->depth_cache_pending) {
+    return p->depth_cache_mode == mode ? AnnotationDepthCacheState::Pending :
+                                         AnnotationDepthCacheState::Failed;
+  }
+  if (!p->depth_cache_interactive || p->area == nullptr ||
+      p->area->spacetype != SPACE_VIEW3D || p->region == nullptr ||
+      p->region->regiondata == nullptr || CTX_wm_window(C) != p->win ||
+      CTX_wm_area(C) != p->area || CTX_wm_region(C) != p->region)
+  {
+    return AnnotationDepthCacheState::Failed;
+  }
+
+  wmWindowManager *manager = CTX_wm_manager(C);
+  bScreen *screen = CTX_wm_screen(C);
+  View3D *v3d = CTX_wm_view3d(C);
+  if (ELEM(nullptr, manager, screen, v3d) ||
+      v3d != static_cast<View3D *>(p->area->spacedata.first))
+  {
+    return AnnotationDepthCacheState::Failed;
+  }
+
+  view3d_region_operator_needs_gpu(p->region);
+  ED_view3d_depth_override_prepare(
+      p->depsgraph, p->region, v3d, nullptr, mode, false);
+
+  p->depth_cache_mode = mode;
+  p->depth_cache_valid = false;
+  p->depth_cache_session = MEM_new<ViewportDepthCacheSession>(__func__);
+  if (!p->depth_cache_session->init(p->region)) {
+    MEM_SAFE_DELETE(p->depth_cache_session);
+    return AnnotationDepthCacheState::Failed;
+  }
+
+  const ViewportDepthCacheSession::ReadbackState state = p->depth_cache_session->state();
+  if (state == ViewportDepthCacheSession::ReadbackState::Ready) {
+    return annotation_depth_cache_take(p) ? AnnotationDepthCacheState::Ready :
+                                            AnnotationDepthCacheState::Failed;
+  }
+  if (state != ViewportDepthCacheSession::ReadbackState::Pending) {
+    MEM_SAFE_DELETE(p->depth_cache_session);
+    return AnnotationDepthCacheState::Failed;
+  }
+
+  p->depth_cache_events = MEM_new<Vector<wmEvent>>(__func__);
+  p->depth_cache_manager = manager;
+  p->depth_cache_screen = screen;
+  p->depth_cache_timer = WM_event_timer_add(manager, p->win, TIMER, 0.01f);
+  if (p->depth_cache_timer == nullptr) {
+    annotation_depth_wait_cancel(p);
+    return AnnotationDepthCacheState::Failed;
+  }
+  p->depth_cache_pending = true;
+  p->depth_cache_tick_count = 0;
+  return AnnotationDepthCacheState::Pending;
+}
+
+static AnnotationDepthCacheState annotation_depth_cache_defer_event(
+    bContext *C,
+    tGPsdata *p,
+    const wmEvent *event,
+    const eV3DDepthOverrideMode mode)
+{
+  const AnnotationDepthCacheState state = annotation_depth_cache_begin(C, p, mode);
+  if (state == AnnotationDepthCacheState::Pending && !annotation_depth_event_push(p, event)) {
+    annotation_depth_wait_cancel(p);
+    return AnnotationDepthCacheState::Failed;
+  }
+  return state;
+}
+
+static bool annotation_depth_event_requires_cache(const tGPsdata *p, const wmEvent *event)
+{
+  if (!p->depth_cache_interactive || p->status != GP_STATUS_PAINTING || event == nullptr ||
+      p->area == nullptr || p->area->spacetype != SPACE_VIEW3D)
+  {
+    return false;
+  }
+
+  if (p->paintmode == GP_PAINTMODE_ERASER) {
+    return (p->flags & GP_PAINTFLAG_V3D_ERASER_DEPTH) &&
+           (ISMOUSE_MOTION(event->type) || (p->flags & GP_PAINTFLAG_FIRSTRUN));
+  }
+  if (!annotation_project_check(p)) {
+    return false;
+  }
+
+  const bool terminal_key = event->val == KM_PRESS &&
+                            ELEM(event->type,
+                                 EVT_RETKEY,
+                                 EVT_PADENTER,
+                                 EVT_ESCKEY,
+                                 EVT_SPACEKEY,
+                                 EVT_EKEY);
+  const bool terminal_mouse = ISMOUSE_BUTTON(event->type) && event->type != MIDDLEMOUSE &&
+                              ELEM(event->val, KM_PRESS, KM_RELEASE);
+  const bool polyline_update = p->paintmode == GP_PAINTMODE_DRAW_POLY &&
+                               annotation_stroke_added_check(p) &&
+                               (ISMOUSE_MOTION(event->type) ||
+                                (p->flags & GP_PAINTFLAG_FIRSTRUN));
+  return terminal_key || terminal_mouse || polyline_update;
+}
