+/** Shared logical state for render-pass load actions. WebGPU error scopes settle after command
+ * encoding in the browser, so a CLEAR must be reserved while the command is pending without
+ * becoming permanently consumed until the matching submission succeeds. */
+struct FramebufferLoadActionState {
+  static constexpr uint32_t kMaxAttachments = 32;
+
+  std::mutex mutex;
+  uint32_t clear_mask = 0;
+  std::array<uint64_t, kMaxAttachments> generations{};
+  std::array<uint64_t, kMaxAttachments> pending_generations{};
+};
+
+/** One command's provisional CLEAR reservations. A later same-epoch command sees those
+ * attachments as LOAD; rejecting this command releases its reservations so a later epoch can
+ * retry. Generation matching prevents a stale callback from consuming a newer load-store bind. */
+class FramebufferLoadActionTransaction {
+ public:
+  ~FramebufferLoadActionTransaction()
+  {
+    complete(false);
+  }
+
+  bool stage(const uint32_t attachment)
+  {
+    if (attachment >= FramebufferLoadActionState::kMaxAttachments) {
+      return false;
+    }
+    std::lock_guard transaction_lock(mutex_);
+    if (completed_) {
+      return false;
+    }
+    std::lock_guard state_lock(state_->mutex);
+    const uint32_t bit = 1u << attachment;
+    if ((state_->clear_mask & bit) == 0 || state_->pending_generations[attachment] != 0) {
+      return false;
+    }
+    const uint64_t generation = state_->generations[attachment];
+    state_->pending_generations[attachment] = generation;
+    generations_[attachment] = generation;
+    attachment_mask_ |= bit;
+    return true;
+  }
+
+  void complete(const bool valid)
+  {
+    std::lock_guard transaction_lock(mutex_);
+    if (completed_) {
+      return;
+    }
+    completed_ = true;
+    std::lock_guard state_lock(state_->mutex);
+    for (uint32_t attachment = 0;
+         attachment < FramebufferLoadActionState::kMaxAttachments;
+         attachment++)
+    {
+      const uint32_t bit = 1u << attachment;
+      if ((attachment_mask_ & bit) == 0 ||
+          state_->pending_generations[attachment] != generations_[attachment])
+      {
+        continue;
+      }
+      state_->pending_generations[attachment] = 0;
+      if (valid && state_->generations[attachment] == generations_[attachment]) {
+        state_->clear_mask &= ~bit;
+      }
+    }
+  }
+
+ private:
+  friend class FramebufferLoadActionTracker;
+  explicit FramebufferLoadActionTransaction(std::shared_ptr<FramebufferLoadActionState> state)
+      : state_(std::move(state))
+  {
+  }
+
+  std::shared_ptr<FramebufferLoadActionState> state_;
+  std::mutex mutex_;
+  uint32_t attachment_mask_ = 0;
+  std::array<uint64_t, FramebufferLoadActionState::kMaxAttachments> generations_{};
+  bool completed_ = false;
+};
+
+class FramebufferLoadActionTracker {
+ public:
+  void record(const uint32_t attachment, const bool clear)
+  {
+    if (attachment >= FramebufferLoadActionState::kMaxAttachments) {
+      return;
+    }
+    std::lock_guard lock(state_->mutex);
+    uint64_t &generation = state_->generations[attachment];
+    generation++;
+    if (generation == 0) {
+      generation = 1;
+    }
+    state_->pending_generations[attachment] = 0;
+    const uint32_t bit = 1u << attachment;
+    if (clear) {
+      state_->clear_mask |= bit;
+    }
+    else {
+      state_->clear_mask &= ~bit;
+    }
+  }
+
+  bool requires_clear(const uint32_t attachment) const
+  {
+    if (attachment >= FramebufferLoadActionState::kMaxAttachments) {
+      return false;
+    }
+    std::lock_guard lock(state_->mutex);
+    return (state_->clear_mask & (1u << attachment)) != 0;
+  }
+
+  std::shared_ptr<FramebufferLoadActionTransaction> transaction() const
+  {
+    return std::shared_ptr<FramebufferLoadActionTransaction>(
+        new FramebufferLoadActionTransaction(state_));
+  }
+
+ private:
+  std::shared_ptr<FramebufferLoadActionState> state_ =
+      std::make_shared<FramebufferLoadActionState>();
+};
