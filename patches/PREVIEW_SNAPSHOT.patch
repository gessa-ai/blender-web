+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ */
+
+#include "wgpu_pixel_buffer.hh"
+
+#include "BLI_assert.h"
+
+namespace blender::gpu {
+
+WGPUPixelBuffer::WGPUPixelBuffer(const size_t size) : PixelBuffer(size), data_(size) {}
+
+void *WGPUPixelBuffer::map()
+{
+  BLI_assert_msg(!is_mapped_, "WebGPU pixel buffer is already mapped");
+  if (is_mapped_) {
+    return nullptr;
+  }
+  is_mapped_ = true;
+  return data_.data();
+}
+
+void WGPUPixelBuffer::unmap()
+{
+  BLI_assert_msg(is_mapped_, "WebGPU pixel buffer is not mapped");
+  is_mapped_ = false;
+}
+
+GPUPixelBufferNativeHandle WGPUPixelBuffer::get_native_handle()
+{
+  /* Browser WebGPU has no portable external-memory handle. An entirely empty
+   * handle advertises that graphics interop is unavailable; get_size() remains
+   * the authoritative allocation-size query. */
+  return {};
+}
+
+size_t WGPUPixelBuffer::get_size()
+{
+  return size_;
+}
+
+const void *WGPUPixelBuffer::data_for_upload(const size_t required_size) const
+{
+  BLI_assert_msg(!is_mapped_, "Unmap a WebGPU pixel buffer before uploading it");
+  BLI_assert_msg(required_size <= size_, "WebGPU pixel buffer is too small for texture upload");
+  if (is_mapped_ || required_size > size_) {
+    return nullptr;
+  }
+  return data_.data();
+}
+
+}  // namespace blender::gpu
diff --git a/source/blender/gpu/webgpu/wgpu_pixel_buffer.hh b/source/blender/gpu/webgpu/wgpu_pixel_buffer.hh
new file mode 100644
index 0000000000000000000000000000000000000000..1ba3dacd94db32e0e66808ec089ce901aacaf4f6
--- /dev/null
+++ b/source/blender/gpu/webgpu/wgpu_pixel_buffer.hh
@@ -0,0 +1,53 @@
+/* SPDX-FileCopyrightText: 2026 blender-web contributors
+ *
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/** \file
+ * \ingroup gpu
+ *
+ * WebGPU pixel-upload buffer. WebGPU cannot synchronously map a GPU buffer in a
+ * browser worker: `mapAsync()` must yield to the event loop. Keep the CPU-written
+ * pixels in host memory instead and let WGPUTexture upload them with
+ * `Queue::WriteTexture` after unmap. This also preserves Blender's tightly-packed
+ * PixelBuffer rows, which need not satisfy CopyBufferToTexture's 256-byte row
+ * alignment.
+ */
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+#include "gpu_texture_private.hh"
+
+#include "MEM_guardedalloc.h"
+
+namespace blender::gpu {
+
+class WGPUPixelBuffer : public PixelBuffer {
+ public:
+  explicit WGPUPixelBuffer(size_t size);
+
+  void *map() override;
+  void unmap() override;
+  GPUPixelBufferNativeHandle get_native_handle() override;
+  size_t get_size() override;
+
+  /** Return tightly-packed host pixels for a texture upload. The public API
+   * requires the buffer to be unmapped before a GPU-side operation. */
+  const void *data_for_upload(size_t required_size) const;
+
+ private:
+  std::vector<uint8_t> data_;
+  bool is_mapped_ = false;
+
+  MEM_CXX_CLASS_ALLOC_FUNCS("WGPUPixelBuffer")
+};
+
+static inline WGPUPixelBuffer *unwrap_webgpu(GPUPixelBuffer *pixel_buffer)
+{
+  return static_cast<WGPUPixelBuffer *>(unwrap(pixel_buffer));
+}
+
+}  // namespace blender::gpu
