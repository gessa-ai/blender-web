diff --git a/intern/cycles/CMakeLists.txt b/intern/cycles/CMakeLists.txt
index 6a2fe36e3fe..1b27ff586ae 100644
--- a/intern/cycles/CMakeLists.txt
+++ b/intern/cycles/CMakeLists.txt
@@ -73,6 +73,18 @@ elseif(SUPPORTS_NEON_BUILD AND SSE2NEON_FOUND)
   set(CXX_HAS_SSE42 FALSE)
   set(CXX_HAS_AVX2 FALSE)
   set(CXX_HAS_F16C FALSE)
+elseif(EMSCRIPTEN)
+  # Emscripten maps SSE1-SSE4.2 intrinsics onto portable wasm SIMD128. Keep
+  # AVX/F16C disabled: the web runtime has only 128-bit vectors, and Cycles'
+  # regular CPU kernel is the native SSE4.2-equivalent path we need here.
+  check_cxx_compiler_flag("-msimd128 -msse4.2" CXX_HAS_WASM_SIMD_SSE42)
+  set(CXX_HAS_SSE42 ${CXX_HAS_WASM_SIMD_SSE42})
+  set(CXX_HAS_AVX2 FALSE)
+  set(CXX_HAS_F16C FALSE)
+  if(CXX_HAS_SSE42)
+    set(CYCLES_SSE42_FLAGS
+      "-msimd128 -msse -msse2 -msse3 -mssse3 -msse4.1 -msse4.2 -include immintrin.h")
+  endif()
 elseif(WIN32 AND MSVC AND NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
   set(CXX_HAS_SSE42 TRUE)
   set(CXX_HAS_AVX2 TRUE)
