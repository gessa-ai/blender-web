+static bool screenshot_preview_readback_context_store(bContext *C,
+                                                      ScreenshotOperatorData *data)
+{
+  const asset_system::AssetRepresentation *asset_handle = CTX_wm_asset(C);
+  if (asset_handle == nullptr) {
+    return false;
+  }
+  data->readback_manager = CTX_wm_manager(C);
+  data->readback_window = CTX_wm_window(C);
+  data->readback_screen = CTX_wm_screen(C);
+  data->readback_main = CTX_data_main(C);
+  data->readback_id_type = asset_handle->get_id_type();
+  data->readback_asset_reference = asset_handle->make_weak_reference();
+  return data->readback_manager != nullptr && data->readback_window != nullptr &&
+         data->readback_screen != nullptr && data->readback_main != nullptr;
+}
+
+static bool screenshot_preview_readback_context_matches(const bContext *C,
+                                                        const ScreenshotOperatorData *data)
+{
+  if (CTX_wm_manager(C) != data->readback_manager || CTX_wm_window(C) != data->readback_window ||
+      CTX_wm_screen(C) != data->readback_screen || CTX_data_main(C) != data->readback_main ||
+      !data->readback_id_type || !data->readback_asset_reference)
+  {
+    return false;
+  }
+  const asset_system::AssetRepresentation *asset_handle = CTX_wm_asset(C);
+  return asset_handle != nullptr && asset_handle->get_id_type() == *data->readback_id_type &&
+         asset_handle->make_weak_reference() == *data->readback_asset_reference;
+}
+
+static wmOperatorStatus screenshot_preview_apply(bContext *C,
+                                                 wmOperator *op,
+                                                 ImBuf *image_buffer,
+                                                 const ScreenshotOperatorData *data)
+{
+  const asset_system::AssetRepresentation *asset_handle = CTX_wm_asset(C);
+  if (image_buffer == nullptr || asset_handle == nullptr ||
+      (data != nullptr && !screenshot_preview_readback_context_matches(C, data)))
+  {
+    if (image_buffer != nullptr) {
+      IMB_freeImBuf(image_buffer);
+    }
+    BKE_report(op->reports, RPT_ERROR, "Screenshot preview context changed");
+    return OPERATOR_CANCELLED;
+  }
+
+  const AssetWeakReference asset_reference = data != nullptr ?
+                                                 *data->readback_asset_reference :
+                                                 asset_handle->make_weak_reference();
+  const ID_Type id_type = data != nullptr ? *data->readback_id_type :
+                                           asset_handle->get_id_type();
+  Main *bmain = data != nullptr ? data->readback_main : CTX_data_main(C);
+  ID *id = bke::asset_edit_id_from_weak_reference(*bmain, id_type, asset_reference);
+  if (id == nullptr) {
+    IMB_freeImBuf(image_buffer);
+    BKE_report(op->reports, RPT_ERROR, "Screenshot preview asset is no longer available");
+    return OPERATOR_CANCELLED;
+  }
+
+  ED_preview_kill_jobs_for_id(CTX_wm_manager(C), id);
+
+  generate_previewimg_from_buffer(id, image_buffer);
+  IMB_freeImBuf(image_buffer);
+
+  if (bke::asset_edit_id_is_writable(*id)) {
+    const bool saved = bke::asset_edit_id_save(*bmain, *id, *op->reports);
+    if (!saved) {
+      BKE_report(op->reports, RPT_ERROR, "Saving failed");
+    }
+  }
+
+  asset::list::storage_tag_main_data_dirty();
+  asset::refresh_asset_library_from_asset(C, *asset_handle);
+
+  WM_main_add_notifier(NC_ASSET | ND_ASSET_LIST | NA_EDITED, nullptr);
+
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus screenshot_preview_readback_poll(bContext *C,
+                                                        wmOperator *op,
+                                                        ScreenshotOperatorData *data)
+{
+  if (!screenshot_preview_readback_context_matches(C, data)) {
+    BKE_report(op->reports, RPT_ERROR, "Screenshot preview context changed during capture");
+    screenshot_preview_exit(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const WMWindowPixelsReadStatus status = WM_window_pixels_read_async_status(data->readback);
+  if (status == WMWindowPixelsReadStatus::Pending) {
+    if (data->readback_timer == nullptr) {
+      data->readback_timer = WM_event_timer_add(
+          data->readback_manager, data->readback_window, TIMER, 0.01);
+      data->readback_tick_count = 0;
+      if (!data->interactive) {
+        WM_event_add_modal_handler(C, op);
+      }
+    }
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (status != WMWindowPixelsReadStatus::Ready) {
+    BKE_report(op->reports, RPT_ERROR, "Screenshot preview capture failed");
+    screenshot_preview_exit(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  int dumprect_size[2];
+  uint8_t *dumprect = WM_window_pixels_read_async_consume(data->readback, dumprect_size);
+  ImBuf *image_buffer = take_screenshot_crop(dumprect, dumprect_size, data->readback_crop);
+  if (image_buffer == nullptr) {
+    BKE_report(op->reports, RPT_ERROR, "Invalid screenshot area selection");
+    screenshot_preview_exit(C, op);
+    return OPERATOR_CANCELLED;
+  }
+
+  const wmOperatorStatus result = screenshot_preview_apply(C, op, image_buffer, data);
+  screenshot_preview_exit(C, op);
+  return result;
+}
