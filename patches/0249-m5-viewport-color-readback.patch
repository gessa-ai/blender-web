   GPU_texture_copy(tex, color_tex);
   GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE);
-  data = static_cast<ushort4 *>(GPU_texture_read(tex, GPU_DATA_HALF_FLOAT, 0));
+  readback = GPU_texture_read_async(tex, GPU_DATA_HALF_FLOAT, 0);
+  readback_state = ReadbackState::Pending;
 
-  return true;
+  /* Native backends complete here immediately. Browser WebGPU deliberately
+   * leaves the owned request pending for later modal event-loop ticks. */
+  return state() != ReadbackState::Failed;
+}
+
+ViewportColorSampleSession::ReadbackState ViewportColorSampleSession::state()
+{
+  if (readback_state != ReadbackState::Pending) {
+    return readback_state;
+  }
+
+  const eGPUReadbackStatus status = GPU_readback_status(readback);
+  if (status == GPU_READBACK_PENDING) {
+    return readback_state;
+  }
+  if (status != GPU_READBACK_READY) {
+    GPU_readback_cancel(readback);
+    readback_state = ReadbackState::Failed;
+    return readback_state;
+  }
+
+  if (tex_w <= 0 || tex_h <= 0 ||
+      size_t(tex_w) > std::numeric_limits<size_t>::max() / size_t(tex_h))
+  {
+    GPU_readback_cancel(readback);
+    readback_state = ReadbackState::Failed;
+    return readback_state;
+  }
+  const size_t pixel_len = size_t(tex_w) * size_t(tex_h);
+  if (pixel_len > std::numeric_limits<size_t>::max() / sizeof(ushort4)) {
+    GPU_readback_cancel(readback);
+    readback_state = ReadbackState::Failed;
+    return readback_state;
+  }
+  const size_t byte_size = pixel_len * sizeof(ushort4);
+  if (GPU_readback_size(readback) != byte_size) {
+    GPU_readback_cancel(readback);
+    readback_state = ReadbackState::Failed;
+    return readback_state;
+  }
+
+  ushort4 *result = MEM_new_array_uninitialized<ushort4>(pixel_len, __func__);
+  if (result == nullptr || !GPU_readback_consume(readback, result, byte_size)) {
+    MEM_delete(result);
+    GPU_readback_cancel(readback);
+    readback_state = ReadbackState::Failed;
+    return readback_state;
+  }
+  data = result;
+  readback_state = ReadbackState::Ready;
+  return readback_state;
 }
 
