+    std::forward<BeginScopeFn>(begin_scope)();
+    HandleT candidate = std::forward<CreateFn>(create)();
+    const bool handle_valid = candidate != nullptr;
+    {
+      std::lock_guard lock(state_->mutex);
+      auto pending = state_->ordered_pending.find(key);
+      if (pending != state_->ordered_pending.end() && pending->second == ordered_pending) {
+        ordered_pending->candidate = candidate;
+      }
+    }
+
+    const std::shared_ptr<State> state = state_;
+    std::forward<EndScopeFn>(end_scope)(
+        [state, key, candidate, ordered_pending, handle_valid](const bool scope_valid) mutable {
+          const bool valid = handle_valid && scope_valid;
+          {
+            std::lock_guard lock(state->mutex);
+            state->pending.erase(key);
+            const auto pending = state->ordered_pending.find(key);
+            if (pending != state->ordered_pending.end() && pending->second == ordered_pending) {
+              state->ordered_pending.erase(pending);
+            }
+            if (valid && candidate != nullptr) {
+              state->handles.emplace(key, std::move(candidate));
+            }
+          }
+          ordered_pending->validation->settle(valid);
+        });
