+
+bool PaintOperation::depth_cache_context_matches(const bContext &C) const
+{
+  if (CTX_wm_manager(&C) != depth_cache_manager_ ||
+      CTX_wm_window(&C) != depth_cache_window_ ||
+      CTX_wm_screen(&C) != depth_cache_screen_ || CTX_wm_area(&C) != depth_cache_area_ ||
+      CTX_wm_region(&C) != depth_cache_region_ ||
+      CTX_wm_region_view3d(&C) != depth_cache_region_view_ ||
+      CTX_wm_view3d(&C) != depth_cache_view3d_ ||
+      CTX_data_depsgraph_pointer(&C) != depth_cache_depsgraph_ ||
+      CTX_data_scene(&C) != depth_cache_scene_ ||
+      CTX_data_active_object(&C) != depth_cache_object_ ||
+      depth_cache_scene_->r.cfra != depth_cache_frame_number_)
+  {
+    return false;
+  }
+
+  if (DEG_get_evaluated(depth_cache_depsgraph_, depth_cache_object_) != depth_cache_eval_object_) {
+    return false;
+  }
+  const GreasePencil *grease_pencil = id_cast<const GreasePencil *>(depth_cache_object_->data);
+  return grease_pencil == depth_cache_grease_pencil_ && grease_pencil->has_active_layer() &&
+         grease_pencil->get_active_layer() == depth_cache_layer_;
+}
+
+GreasePencilStrokeOperationAsyncState PaintOperation::poll_async(const bContext &C)
+{
+  if (async_state_ != GreasePencilStrokeOperationAsyncState::Pending) {
+    return async_state_;
+  }
+  if (!this->depth_cache_context_matches(C)) {
+    this->cancel_async();
+    return async_state_;
+  }
+
+  constexpr int max_tick_count = 240;
+  if (++depth_cache_tick_count_ > max_tick_count) {
+    this->cancel_async();
+    return async_state_;
+  }
+
+  const ed::greasepencil::DrawingPlacementDepthCacheState state =
+      placement_.poll_viewport_depths(depth_cache_region_);
+  if (state == ed::greasepencil::DrawingPlacementDepthCacheState::Pending) {
+    return async_state_;
+  }
+  if (state == ed::greasepencil::DrawingPlacementDepthCacheState::Failed ||
+      !depth_cache_start_sample_)
+  {
+    this->cancel_async();
+    return async_state_;
+  }
+
+  const InputSample start_sample = *depth_cache_start_sample_;
+  Vector<InputSample> queued_samples = std::move(depth_cache_samples_);
+  depth_cache_start_sample_.reset();
+  depth_cache_manager_ = nullptr;
+  depth_cache_window_ = nullptr;
+  depth_cache_screen_ = nullptr;
+  depth_cache_area_ = nullptr;
+  depth_cache_region_ = nullptr;
+  depth_cache_region_view_ = nullptr;
+  depth_cache_view3d_ = nullptr;
+  depth_cache_depsgraph_ = nullptr;
+  depth_cache_scene_ = nullptr;
+  depth_cache_object_ = nullptr;
+  depth_cache_eval_object_ = nullptr;
+  depth_cache_grease_pencil_ = nullptr;
+  depth_cache_layer_ = nullptr;
+  depth_cache_tick_count_ = 0;
+  async_state_ = GreasePencilStrokeOperationAsyncState::Running;
+
+  this->on_stroke_begin_ready(C, start_sample);
+  for (const InputSample &sample : queued_samples) {
+    this->on_stroke_extended(C, sample);
+  }
+  return async_state_;
+}
+
+void PaintOperation::cancel_async()
+{
+  placement_.cancel_viewport_depths();
+  depth_cache_start_sample_.reset();
+  depth_cache_samples_.clear();
+  depth_cache_manager_ = nullptr;
