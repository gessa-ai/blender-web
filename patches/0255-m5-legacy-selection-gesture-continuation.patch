+struct DRWSelectBufferQueryContext {
+  Vector<Object *> objects;
+  Map<Object *, ElemIndexRanges> elem_ranges;
+  uint max_index_drawn_len = 0;
+  short select_mode = 0;
+};
+
+static DRWSelectBufferQueryContext drw_select_buffer_query_context_capture()
+{
+  DRWSelectBufferQueryContext snapshot;
+  const SELECTID_Context *select_ctx = DRW_select_engine_context_get();
+  if (select_ctx == nullptr) {
+    return snapshot;
+  }
+  snapshot.objects.extend(select_ctx->objects);
+  for (const auto &item : select_ctx->elem_ranges.items()) {
+    snapshot.elem_ranges.add(item.key, item.value);
+  }
+  snapshot.max_index_drawn_len = select_ctx->max_index_drawn_len;
+  snapshot.select_mode = select_ctx->select_mode;
+  return snapshot;
+}
+
+static void drw_select_buffer_query_context_restore(const DRWSelectBufferQueryContext &snapshot)
+{
+  SELECTID_Context *select_ctx = DRW_select_engine_context_get();
+  if (select_ctx == nullptr) {
+    return;
+  }
+  select_ctx->objects.clear();
+  select_ctx->objects.extend(snapshot.objects);
+  select_ctx->elem_ranges.clear();
+  for (const auto &item : snapshot.elem_ranges.items()) {
+    select_ctx->elem_ranges.add(item.key, item.value);
+  }
+  select_ctx->max_index_drawn_len = snapshot.max_index_drawn_len;
+  select_ctx->select_mode = snapshot.select_mode;
+}
+
+enum class DRWSelectBufferBitmapKind : uint8_t {
+  Rect,
+  Circle,
+  Poly,
+};
