{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blender-web.invalid/schemas/m7-cross-browser-fallback-v3.json",
  "title": "M7 branded Firefox/Safari fallback technical receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "label", "nonce", "createdUtc", "immutable", "verdict",
    "evidenceRoot", "sourceFreeze", "producer", "server", "bundleArtifacts", "browsers"],
  "properties": {
    "schema": {"const": "blender-web.m7-cross-browser-fallback.v4"},
    "label": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "createdUtc": {"type": "string", "format": "date-time"},
    "immutable": {"const": true}, "verdict": {"const": "PASS"},
    "evidenceRoot": {"type": "string", "minLength": 1},
    "sourceFreeze": {"$ref": "#/$defs/file"}, "producer": {"$ref": "#/$defs/file"},
    "server": {"$ref": "#/$defs/server"}, "bundleArtifacts": {"$ref": "#/$defs/artifacts"},
    "browsers": {"type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"$ref": "#/$defs/browser"}, {"$ref": "#/$defs/browser"}], "items": false}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {"type": "object", "additionalProperties": false,
      "required": ["path", "bytes", "sha256"], "properties": {
        "path": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha"}}},
    "httpArtifact": {"type": "object", "additionalProperties": false,
      "required": ["url", "status", "bytes", "sha256", "bundleSha256"], "properties": {
        "url": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+/"},
        "status": {"const": 200}, "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha"}, "bundleSha256": {"$ref": "#/$defs/sha"}}},
    "browserHttpArtifact": {"type": "object", "additionalProperties": false,
      "required": ["name", "url", "status", "bytes", "sha256", "headerBytes",
        "headerSha256", "bundleSha256"], "properties": {
        "name": {"type": "string", "minLength": 1}, "url": {"type": "string", "minLength": 1},
        "status": {"const": 200}, "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha"}, "headerBytes": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "headerSha256": {"$ref": "#/$defs/sha"}, "bundleSha256": {"$ref": "#/$defs/sha"}}},
    "artifacts": {"type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/file"}},
    "server": {"type": "object", "additionalProperties": false,
      "required": ["baseUrl", "servedBundleSha256", "artifacts"], "properties": {
        "baseUrl": {"type": "string", "pattern": "^http://(127\\.0\\.0\\.1|localhost|\\[::1\\]):[0-9]+$"},
        "servedBundleSha256": {"$ref": "#/$defs/sha"},
        "artifacts": {"type": "object", "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/httpArtifact"}}}},
    "signing": {"type": "object", "additionalProperties": false,
      "required": ["identifier", "team", "valid"], "properties": {
        "identifier": {"type": "string", "minLength": 1}, "team": {"type": "string", "minLength": 1},
        "valid": {"const": true}}},
    "scene": {"type": "object", "additionalProperties": false,
      "required": ["active", "objectCount", "objects", "meshVertices", "mode", "renderEngine"],
      "properties": {"active": {"const": "Cube"}, "objectCount": {"const": 3},
        "objects": {"const": ["Camera", "Cube", "Light"]}, "meshVertices": {"const": 8},
        "mode": {"const": "OBJECT"}, "renderEngine": {"type": "string", "minLength": 1}}},
    "pixels": {"type": "object", "additionalProperties": false,
      "required": ["width", "height", "nonblackRatio", "quantizedColors", "pngBytes", "pngSha256", "pass"],
      "properties": {"width": {"type": "integer", "minimum": 1000}, "height": {"type": "integer", "minimum": 600},
        "nonblackRatio": {"type": "number", "exclusiveMinimum": 0.1},
        "quantizedColors": {"type": "integer", "exclusiveMinimum": 128},
        "pngBytes": {"type": "integer", "minimum": 1}, "pngSha256": {"$ref": "#/$defs/sha"},
        "pass": {"const": true}}},
    "driver": {"type": "object", "additionalProperties": false,
      "required": ["artifact", "version", "signing", "launchCommand", "launchCommandSha256", "processId", "serviceLog"],
      "properties": {"artifact": {"$ref": "#/$defs/file"}, "version": {"type": "string", "minLength": 1},
        "signing": {"$ref": "#/$defs/signing"}, "launchCommand": {"type": "array", "minItems": 3,
          "items": {"type": "string", "minLength": 1}}, "launchCommandSha256": {"$ref": "#/$defs/sha"},
        "processId": {"type": "integer", "minimum": 1}, "serviceLog": {"$ref": "#/$defs/file"}}},
    "browser": {"type": "object", "additionalProperties": false,
      "required": ["family", "product", "version", "platform", "officialBrandedBinary", "binary", "signing",
        "session", "environment", "renderer", "storage", "download", "requests", "errors", "input",
        "automationDriver", "webdriverTranscript", "verdict"],
      "properties": {
        "family": {"enum": ["firefox", "safari"]}, "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}, "platform": {"type": "string", "minLength": 1},
        "officialBrandedBinary": {"const": true}, "binary": {"$ref": "#/$defs/file"},
        "signing": {"$ref": "#/$defs/signing"},
        "session": {"type": "object", "additionalProperties": false,
          "required": ["requestedCapabilitiesSha256", "observedBrowserName", "observedBrowserVersion",
            "observedPlatform", "navigationUrl", "sessionIdSha256"], "properties": {
            "requestedCapabilitiesSha256": {"$ref": "#/$defs/sha"},
            "observedBrowserName": {"type": "string", "minLength": 1},
            "observedBrowserVersion": {"type": "string", "minLength": 1},
            "observedPlatform": {"type": "string"}, "navigationUrl": {"type": "string", "minLength": 1},
            "sessionIdSha256": {"$ref": "#/$defs/sha"}}},
        "environment": {"type": "object", "additionalProperties": false,
          "required": ["secureContext", "crossOriginIsolated", "sharedArrayBuffer", "opfs",
            "fileSystemAccessPickers", "earlyObserverInstalled"], "properties": {
            "secureContext": {"const": true}, "crossOriginIsolated": {"const": true},
            "sharedArrayBuffer": {"const": true}, "opfs": {"const": true},
            "fileSystemAccessPickers": {"const": false}, "earlyObserverInstalled": {"const": true}}},
        "renderer": {"type": "object", "additionalProperties": false,
          "required": ["status", "webgpuBackend", "productWorkerDevice", "presentedFrame", "initialScreenshot",
            "interactionScreenshot", "initialPixels",
            "interactionPixels", "interactionMeanAbsoluteDifference", "initialScene", "reloadScene"], "properties": {
            "status": {"const": "editor_booted"}, "webgpuBackend": {"const": "WebGPU"},
            "productWorkerDevice": {"const": true}, "presentedFrame": {"const": true},
            "initialScreenshot": {"$ref": "#/$defs/file"}, "interactionScreenshot": {"$ref": "#/$defs/file"},
            "initialPixels": {"$ref": "#/$defs/pixels"}, "interactionPixels": {"$ref": "#/$defs/pixels"},
            "interactionMeanAbsoluteDifference": {"type": "number", "exclusiveMinimum": 0.5},
            "initialScene": {"$ref": "#/$defs/scene"}, "reloadScene": {"$ref": "#/$defs/scene"}}},
        "storage": {"type": "object", "additionalProperties": false,
          "required": ["nonceName", "absentBefore", "singleEntryAfterOpen", "reloadCount", "openBytes", "semanticReloadEqual"],
          "properties": {"nonceName": {"type": "string", "pattern": "^fallback-[A-Za-z0-9._-]+-[0-9a-f]{32}\\.blend$"},
            "absentBefore": {"const": true}, "singleEntryAfterOpen": {"const": true}, "reloadCount": {"const": 1},
            "openBytes": {"type": "integer", "minimum": 1001}, "semanticReloadEqual": {"const": true}}},
        "download": {"type": "object", "additionalProperties": false,
          "required": ["suggestedName", "completed", "ackBytes", "browserDownloadPath",
            "movedIntoEvidence", "artifact", "semanticReopen"], "properties": {
            "suggestedName": {"type": "string", "pattern": "^fallback-save-[A-Za-z0-9._-]+-[0-9a-f]{32}\\.blend$"},
            "completed": {"const": true}, "ackBytes": {"type": "integer", "minimum": 1001},
            "browserDownloadPath": {"type": "string", "minLength": 1},
            "movedIntoEvidence": {"type": "boolean"},
            "artifact": {"$ref": "#/$defs/file"},
            "semanticReopen": {"type": "object", "additionalProperties": false,
              "required": ["nonceName", "absentBefore", "singleEntryAfter", "openBytes", "scene"],
              "properties": {
                "nonceName": {"type": "string", "pattern": "^fallback-save-[A-Za-z0-9._-]+-[0-9a-f]{32}\\.blend$"},
                "absentBefore": {"const": true}, "singleEntryAfter": {"const": true},
                "openBytes": {"type": "integer", "minimum": 1001},
                "scene": {"$ref": "#/$defs/scene"}}}}},
        "requests": {"type": "object", "additionalProperties": false,
          "required": ["browserLoadedArtifacts", "externalRequestCount"], "properties": {
            "browserLoadedArtifacts": {"type": "array", "minItems": 1,
              "items": {"$ref": "#/$defs/browserHttpArtifact"}}, "externalRequestCount": {"const": 0}}},
        "errors": {"type": "object", "additionalProperties": false,
          "required": ["page", "gpu", "driver"], "properties": {
            "page": {"const": []}, "gpu": {"const": []}, "driver": {"const": []}}},
        "input": {"$ref": "#/$defs/file"}, "automationDriver": {"$ref": "#/$defs/driver"},
        "webdriverTranscript": {"$ref": "#/$defs/file"}, "verdict": {"const": "PASS"}
      }
    }
  }
}
