+     * original argument cannot hide an invalid logarithm in the other argument. */
+    const double log_a = log(arg_a);
+    const double log_b = log(arg_b);
+    const double log_args[2] = {log_a, log_b};
+    flags |= wasm_float_invalid(&arg_a, 1, log_a);
+    flags |= wasm_float_invalid(&arg_b, 1, log_b);
+    flags |= wasm_float_invalid(log_args, 2, log_a / log_b);
+  }
