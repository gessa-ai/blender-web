+struct WMWindowPixelsRead;
+
+enum class WMWindowPixelsReadStatus {
+  Invalid = 0,
+  Pending,
+  Ready,
+  Failed,
+};
+
+/**
+ * Draw the window into an owned offscreen and start a non-blocking RGBA8 readback.
+ *
+ * The returned object retains the offscreen until the backend request reaches a terminal state.
+ * Native backends may be immediately ready. Browser callers must poll across event-loop ticks.
+ */
+WMWindowPixelsRead *WM_window_pixels_read_async(bContext *C, wmWindow *win);
+WMWindowPixelsReadStatus WM_window_pixels_read_async_status(WMWindowPixelsRead *readback);
+/**
+ * Consume an exact ready result. On success the request is freed, `readback` becomes null, and the
+ * returned pixel array transfers to the caller. Pending and failed requests remain owned.
+ */
+uint8_t *WM_window_pixels_read_async_consume(WMWindowPixelsRead *&readback, int r_size[2]);
+/**
+ * Cancel or release an owned request. Backend work is retired before its offscreen texture.
+ */
+void WM_window_pixels_read_async_cancel(WMWindowPixelsRead *&readback);
+
 /**
  * Read from the screen.
