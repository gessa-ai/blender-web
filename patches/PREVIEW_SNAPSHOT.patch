+/* Draw-time pipeline binding runs through lane B's pipeline assembly. Capture the
+ * specialization constants so compute_pipeline() can build the matching variant
+ * (WebGPU applies overrides at pipeline creation). */
+void WGPUShader::bind(const shader::SpecializationConstants *constants_state)
+{
+  bound_constants_ = constants_state;
+}
+void WGPUShader::unbind() {}
+
+wgpu::ComputePipeline WGPUShader::compute_pipeline(const wgpu::Instance &instance,
+                                                   const wgpu::Device &device)
+{
+  if (!ensure_shader_modules(instance, device)) {
+    return nullptr;
+  }
+  const wgpu::ShaderModule compute_module = this->compute_module();
+  if (compute_module == nullptr) {
+    return nullptr;
+  }
+  if (explicit_layout_required() && !ensure_explicit_layout(instance, device)) {
+    return nullptr;
+  }
+  /* Specialization key = the raw override bit patterns of the currently-bound
+   * constants (empty when the shader declares none). WebGPU applies `override`
+   * constants per pipeline, so each distinct value set needs its own variant. */
+  std::vector<uint32_t> key;
+  if (bound_constants_ != nullptr) {
+    for (const SpecializationConstant::Value &v : bound_constants_->values) {
+      key.push_back(v.u);
+    }
+  }
+  std::string cache_key;
+  if (!key.empty()) {
+    cache_key.assign(reinterpret_cast<const char *>(key.data()), key.size() * sizeof(uint32_t));
+  }
+
+  /* Miss: build the variant. Each create-info specialization constant became a WGSL
+   * `override` whose id is its constant_id (Tint's SPIR-V reader sets it from the
+   * SpecId), so the ConstantEntry key is that id as a decimal string — Dawn matches
+   * @id-specified overrides by std::to_string(id) (ShaderModule.cpp:816). The value
+   * is a double; for a float spec constant the override is the uint bit pattern (see
+   * resources_declare), which is exactly Value::u, so only int_t reads the signed
+   * field. */
+  std::vector<wgpu::ConstantEntry> constants;
+  std::vector<std::string> key_strings;
+  if (bound_constants_ != nullptr) {
+    const int count = int(bound_constants_->values.size());
+    key_strings.reserve(count);
+    constants.reserve(count);
+    for (int i = 0; i < count; i++) {
+      if (!specialization_constant_used(uint32_t(i), uint32_t(wgi::STAGE_COMPUTE))) {
+        continue;
+      }
+      key_strings.push_back(std::to_string(i));
+      const SpecializationConstant::Value &v = bound_constants_->values[i];
+      const bool is_int = (i < int(bound_constants_->types.size())) &&
+                          (bound_constants_->types[i] == Type::int_t);
+      wgpu::ConstantEntry entry = {};
+      entry.key = key_strings.back().c_str();
+      entry.value = is_int ? double(v.i) : double(v.u);
+      constants.push_back(entry);
+    }
+  }
+
+  wgpu::ComputePipelineDescriptor desc = {};
+  /* Explicit group-0 layout (interface-map-derived, correct resource types) when the
+   * shader has full coverage; else Dawn's auto layout inferred from the compute WGSL. */
+  desc.layout = has_explicit_layout() ? explicit_pipeline_layout() : nullptr;
+  desc.compute.module = compute_module;
+  /* Tint names the compute entry point "main" (from the GLSL main); the standalone
+   * T7.pre proof created its compute pipeline with the same explicit entry point. */
+  desc.compute.entryPoint = "main";
+  desc.compute.constantCount = constants.size();
+  desc.compute.constants = constants.empty() ? nullptr : constants.data();
+  return compute_pipeline_cache_.get_or_create(
+      instance,
+      device,
+      cache_key,
+      "compute pipeline creation",
+      [&]() { return device.CreateComputePipeline(&desc); });
+}
+
+/* -------------------------------------------------------------------------- */
+/** \name Explicit pipeline layout
+ * \{ */
+
+bool WGPUShader::bind_group_entries_complete(
+    const std::vector<wgpu::BindGroupEntry> &entries) const
+{
+  std::vector<uint32_t> assembled_bindings;
+  assembled_bindings.reserve(entries.size());
+  for (const wgpu::BindGroupEntry &entry : entries) {
+    if (entry.buffer != nullptr || entry.textureView != nullptr || entry.sampler != nullptr) {
+      assembled_bindings.push_back(entry.binding);
+    }
+  }
+  if (webgpu::bind_group_binding_ids_complete(surviving_bindings_,
+                                               std::move(assembled_bindings)))
+  {
+    return true;
+  }
+  CLOG_WARN(&LOG,
+            "WGPUShader '%s': assembled group-0 resources do not match surviving WGSL bindings",
+            name_get().c_str());
+  return false;
+}
+
+bool WGPUShader::build_explicit_layout(const wgpu::Instance &instance,
+                                       const wgpu::Device &device,
+                                       const std::vector<uint32_t> &vertex_resource_bindings,
+                                       const std::vector<uint32_t> &fragment_resource_bindings,
+                                       const std::vector<uint32_t> &compute_resource_bindings,
+                                       const std::vector<uint32_t> &sampled_texture_bindings)
+{
+  explicit_layout_required_ = false;
+  explicit_layout_cache_ = {};
+  explicit_entries_.clear();
+  surviving_bindings_.clear();
+  if (device == nullptr) {
+    return false;
+  }
+
+  blender::Map<uint32_t, uint32_t> survivors;
+  auto add_stage_bindings = [&](const std::vector<uint32_t> &bindings, uint32_t stage_bit) {
+    for (const uint32_t binding : bindings) {
+      survivors.add_overwrite(binding, survivors.lookup_default(binding, 0u) | stage_bit);
+    }
+  };
+  add_stage_bindings(vertex_resource_bindings, uint32_t(wgi::STAGE_VERTEX));
+  add_stage_bindings(fragment_resource_bindings, uint32_t(wgi::STAGE_FRAGMENT));
+  add_stage_bindings(compute_resource_bindings, uint32_t(wgi::STAGE_COMPUTE));
+  for (auto item : survivors.items()) {
+    surviving_bindings_.push_back(item.key);
+  }
+  std::sort(surviving_bindings_.begin(), surviving_bindings_.end());
+
+  auto to_visibility = [](uint32_t mask) {
+    wgpu::ShaderStage v = wgpu::ShaderStage::None;
+    if (mask & uint32_t(wgi::STAGE_VERTEX)) {
+      v |= wgpu::ShaderStage::Vertex;
+    }
+    if (mask & uint32_t(wgi::STAGE_FRAGMENT)) {
+      v |= wgpu::ShaderStage::Fragment;
+    }
+    if (mask & uint32_t(wgi::STAGE_COMPUTE)) {
+      v |= wgpu::ShaderStage::Compute;
+    }
+    return v;
+  };
+
+  std::vector<wgpu::BindGroupLayoutEntry> entries;
+  entries.reserve(survivors.size());
+  for (auto item : survivors.items()) {
+    const uint32_t binding = item.key;
+    const wgpu::ShaderStage vis = to_visibility(item.value);
+
+    /* Prefer the interface-map entry (correct sampleType / sampler.type / view dim /
+     * buffer.type); override visibility with the WGSL-measured stage set. */
+    const wgpu::BindGroupLayoutEntry *src = nullptr;
+    for (const wgpu::BindGroupLayoutEntry &e : interface_map_.entries) {
+      if (e.binding == binding) {
+        src = &e;
+        break;
+      }
+    }
+    if (src != nullptr) {
+      wgpu::BindGroupLayoutEntry e = *src;
+      e.visibility = vis;
+      /* Dawn's auto layout calls every texture_*<f32> filterable Float, which
+       * rejects formats such as RG16Unorm (EEVEE's gbuffer normals). A float
+       * texture used only by textureLoad/textureDimensions is valid as
+       * UnfilterableFloat. Use Tint Inspector's transitive sampler/texture pairs,
+       * not textual sampler-variable references: unoptimized WGSL can pass the
+       * otherwise-unused sampler half through helper functions. */
+      if (e.texture.sampleType == wgpu::TextureSampleType::Float &&
+          !std::binary_search(
+              sampled_texture_bindings.begin(), sampled_texture_bindings.end(), binding))
+      {
+        e.texture.sampleType = wgpu::TextureSampleType::UnfilterableFloat;
+      }
+      /* Re-apply the interface map's RW-storage rule AFTER the WGSL-visibility
+       * override: Tint can retain a read-write SSBO's module-scope declaration in
+       * the vertex WGSL even when no vertex code touches it, so the scanned stage
+       * set carries Vertex — and WebGPU rejects any RW-storage entry visible to
+       * Vertex, collapsing the whole layout (the workbench-prepass killer). Same
+       * rationale as the strip in wgpu_shader_interface_map.cc. */
+      if (e.buffer.type == wgpu::BufferBindingType::Storage) {
+        e.visibility = e.visibility & (wgpu::ShaderStage::Fragment | wgpu::ShaderStage::Compute);
+      }
+      /* Blender's shader-wide declaration can likewise survive in vertex WGSL
+       * when only fragment code uses a writable storage texture. */
+      if (e.storageTexture.access == wgpu::StorageTextureAccess::WriteOnly ||
+          e.storageTexture.access == wgpu::StorageTextureAccess::ReadWrite)
+      {
+        e.visibility = e.visibility & (wgpu::ShaderStage::Fragment | wgpu::ShaderStage::Compute);
+      }
+      entries.push_back(e);
+      continue;
+    }
+    /* The one codegen-injected binding not in the interface map: the multi-viewport
+     * pass-state UBO (patch 0083), a plain uniform buffer. */
+    if (has_multi_viewport_ && binding == multi_viewport_binding_) {
+      wgpu::BindGroupLayoutEntry e = {};
+      e.binding = binding;
+      e.visibility = vis;
+      e.buffer.type = wgpu::BufferBindingType::Uniform;
+      entries.push_back(e);
+      continue;
+    }
+    /* Any other uncovered binding means the interface map does not describe this
+     * shader's real WGSL. Do NOT guess — fall back to Dawn's auto layout for the whole
+     * shader (loud, so an unexpected codegen-injected resource is caught, not masked). */
+    CLOG_WARN(&LOG,
+              "WGPUShader '%s': WGSL @binding(%u) not covered by interface map; auto layout",
+              name_get().c_str(),
+              binding);
+    return true;
+  }
+
+  explicit_entries_ = std::move(entries);
+  explicit_layout_required_ = true;
+  /* Native Dawn settles synchronously; browser Dawn leaves this pending. Either way the shader
+   * remains compiled, and pipeline lookup refuses auto-layout fallback until this exact pair is
+   * accepted. A rejected pair is recreated from explicit_entries_ on the next lookup. */
+  ensure_explicit_layout(instance, device);
+  return true;
+}
+
+bool WGPUShader::ensure_explicit_layout(const wgpu::Instance &instance,
+                                        const wgpu::Device &device)
+{
+  if (!explicit_layout_required_) {
+    return true;
+  }
+  if (instance == nullptr || device == nullptr) {
+    return false;
+  }
+  if (explicit_layout_cache_.lookup(kExplicitLayoutKey) != nullptr) {
+    return true;
+  }
+  if (explicit_layout_cache_.pending(kExplicitLayoutKey)) {
+    return false;
+  }
+
+  const std::string label = name_get();
+  const ExplicitLayoutHandles handles = explicit_layout_cache_.get_or_create(
+      instance,
+      device,
+      kExplicitLayoutKey,
+      "shader explicit bind-group/pipeline-layout creation",
+      [&]() {
+        wgpu::BindGroupLayoutDescriptor bind_group_descriptor = {};
+        bind_group_descriptor.label = label.c_str();
+        bind_group_descriptor.entryCount = explicit_entries_.size();
+        bind_group_descriptor.entries = explicit_entries_.empty() ? nullptr :
+                                                                    explicit_entries_.data();
+        ExplicitLayoutHandles candidate;
+        candidate.bind_group_layout = device.CreateBindGroupLayout(&bind_group_descriptor);
+        if (candidate.bind_group_layout == nullptr) {
+          return ExplicitLayoutHandles{};
+        }
+        wgpu::PipelineLayoutDescriptor pipeline_descriptor = {};
+        pipeline_descriptor.label = label.c_str();
+        pipeline_descriptor.bindGroupLayoutCount = 1;
+        pipeline_descriptor.bindGroupLayouts = &candidate.bind_group_layout;
+        candidate.pipeline_layout = device.CreatePipelineLayout(&pipeline_descriptor);
+        return candidate;
+      });
+  return handles != nullptr;
+}
+
+/** \} */
+
+/* -------------------------------------------------------------------------- */
+/** \name Push-constant UBO plumbing
+ * \{ */
+
+void WGPUShader::build_interface(const shader::ShaderCreateInfo &info)
+{
+  WGPUShaderInterface *iface = new WGPUShaderInterface();
+  iface->init(info);
+  this->interface = iface;
+
+  /* std140 layout of the push-constant block (offset per push-constant, keyed by
+   * the interface location 1024 + i). */
+  push_constants_.clear();
+  uint32_t offset = 0;
+  int32_t location = PUSH_CONSTANT_LOCATION_BASE;
+  for (const ShaderCreateInfo::PushConst &pc : info.push_constants_) {
+    uint32_t align, size;
+    std140_align_size(pc.type, pc.array_size, align, size);
+    offset = (offset + (align - 1)) & ~(align - 1);
+    push_constants_.push_back({location++, offset, size});
+    offset += size;
+  }
+  push_constants_size_ = (offset + 15u) & ~15u;
+  push_constants_data_.assign(push_constants_size_, 0);
+
+  /* UBO binding = the dense binding after the last resource (matches
+   * resources_declare / the ResourceDesc list). Keep the full (bind_type,slot)->dense
+   * map for remap_*_binding (frontend slot -> dense group-0 binding). */
+  dense_bindings_.clear();
+  push_constants_binding_ = build_dense_bindings(info, dense_bindings_);
+
+  /* Multi-viewport emulation pass-state UBO (M3.F7): binding just after the push-constant
+   * fallback, matching the resources_declare formula. */
+  has_multi_viewport_ = flag_is_set(info.builtins_, BuiltinBits::VIEWPORT_INDEX);
+  multi_viewport_binding_ = push_constants_binding_ + (info.push_constants_.is_empty() ? 0u : 1u);
+}
+
+/* Frontend create-info slot -> this shader's dense group-0 binding. Since r44r2 BOTH bind
+ * flavors reach these in the SAME namespace: (a) fixed create-info slots (DRW-style) and
+ * (b) name-resolved binds (build_interface now returns the create-info slot, matching the
+ * Vulkan backend). A slot this shader declares is found in dense_bindings_ and translated to
+ * its dense binding (MAPPED); a slot it does not declare (a stale context-wide bind) misses
+ * the map and takes the identity fallback. The bind-group builder assembles MAPPED slots
+ * first and identity-fallback slots only into bindings nothing mapped has claimed
+ * (slot_is_mapped below + the two-pass loops in append_resource_bind_entries), so a stale
+ * bind can never displace a real resource (the r18-r26 blank-viewport root cause). */
+int WGPUShader::remap_ssbo_binding(int slot) const
+{
+  const uint32_t key = (uint32_t(shader::ShaderCreateInfo::Resource::BindType::STORAGE_BUFFER)
+                        << 24) |
+                       uint32_t(slot);
+  return int(dense_bindings_.lookup_default(key, uint32_t(slot)));
+}
+int WGPUShader::remap_ubo_binding(int slot) const
+{
+  const uint32_t key = (uint32_t(shader::ShaderCreateInfo::Resource::BindType::UNIFORM_BUFFER)
+                        << 24) |
+                       uint32_t(slot);
+  return int(dense_bindings_.lookup_default(key, uint32_t(slot)));
+}
+int WGPUShader::remap_sampler_binding(int slot) const
+{
+  const uint32_t key = (uint32_t(shader::ShaderCreateInfo::Resource::BindType::SAMPLER) << 24) |
+                       uint32_t(slot);
+  return int(dense_bindings_.lookup_default(key, uint32_t(slot)));
+}
+uint32_t WGPUShader::sampler_half_binding(uint32_t texture_binding) const
+{
+  for (const wgi::SamplerRemap &mapping : interface_map_.sampler_mappings) {
+    if (mapping.from.group == 0 && mapping.from.binding == texture_binding) {
+      return mapping.to.binding;
+    }
+  }
+  return interface_map_.sampler_base + texture_binding;
+}
+int WGPUShader::remap_image_binding(int slot) const
+{
+  const uint32_t key = (uint32_t(shader::ShaderCreateInfo::Resource::BindType::IMAGE) << 24) |
+                       uint32_t(slot);
+  return int(dense_bindings_.lookup_default(key, uint32_t(slot)));
+}
+
+bool WGPUShader::slot_is_mapped(shader::ShaderCreateInfo::Resource::BindType type, int slot) const
+{
+  const uint32_t key = (uint32_t(type) << 24) | uint32_t(slot);
+  return dense_bindings_.contains(key);
+}
+
+void WGPUShader::push_constant_set(int location, int comp_len, int array_size, const void *data)
+{
+  for (const PushConstantSlot &slot : push_constants_) {
+    if (slot.location != location) {
+      continue;
+    }
+    /* A float3x3 arrives as nine tightly packed floats, but std140 stores it as three float3
+     * columns with a 16-byte column stride. Mirror Vulkan's inner-row padding before handling
+     * ordinary arrays: a single matrix still needs 12 padding bytes. */
+    if (comp_len == 9) {
+      constexpr uint32_t source_column_size = 3u * sizeof(float);
+      constexpr uint32_t destination_column_stride = 4u * sizeof(float);
+      constexpr uint32_t column_count = 3;
+      constexpr uint32_t source_matrix_size = column_count * source_column_size;
+      constexpr uint32_t destination_matrix_stride = column_count * destination_column_stride;
+      const uint32_t matrix_count = uint32_t(std::max(array_size, 1));
+      const uint32_t destination_size = matrix_count * destination_matrix_stride;
+      if (destination_size <= slot.size &&
+          slot.offset + destination_size <= push_constants_data_.size())
+      {
+        const uint8_t *src = static_cast<const uint8_t *>(data);
+        for (uint32_t matrix = 0; matrix < matrix_count; matrix++) {
+          for (uint32_t column = 0; column < column_count; column++) {
+            std::memcpy(push_constants_data_.data() + slot.offset +
+                            matrix * destination_matrix_stride +
+                            column * destination_column_stride,
+                        src + matrix * source_matrix_size + column * source_column_size,
+                        source_column_size);
+          }
+        }
+        push_constants_dirty_ = true;
+      }
+      return;
+    }
+
+    /* The frontend hands us arrays tightly packed (`comp_len * 4` bytes per element), but the
+     * shader block is std140 (`slot.size` reserved by std140_align_size), where an array element's
+     * stride is rounded up to 16 bytes. Mirror Vulkan's std140 push-constant buffer by writing
+     * each element at that stride. Scalars, single vectors, and vec4/mat4 arrays (stride == src)
+     * fall through to the fast contiguous copy. */
+    const uint32_t src_stride = uint32_t(comp_len) * 4u;
+    /* std140 array-element stride: the element size rounded up to 16 (matches
+     * std140_align_size). vec4/mat4 arrays already satisfy this (stride == src). */
+    const uint32_t dst_stride = (src_stride + 15u) & ~15u;
+    if (array_size > 1 && dst_stride != src_stride) {
+      const uint8_t *src = static_cast<const uint8_t *>(data);
+      for (int e = 0; e < array_size; e++) {
+        const uint32_t dst_off = slot.offset + uint32_t(e) * dst_stride;
+        if (dst_off + src_stride <= push_constants_data_.size()) {
+          std::memcpy(
+              push_constants_data_.data() + dst_off, src + uint32_t(e) * src_stride, src_stride);
+        }
+      }
+      push_constants_dirty_ = true;
+      return;
+    }
+    const uint32_t n = src_stride * uint32_t(std::max(array_size, 1));
+    const uint32_t copy = std::min(n, slot.size);
+    if (slot.offset + copy <= push_constants_data_.size()) {
+      std::memcpy(push_constants_data_.data() + slot.offset, data, copy);
+      push_constants_dirty_ = true;
+    }
+    return;
+  }
+}
+
+void WGPUShader::uniform_float(int location, int comp_len, int array_size, const float *data)
+{
+  push_constant_set(location, comp_len, array_size, data);
+}
+void WGPUShader::uniform_int(int location, int comp_len, int array_size, const int *data)
+{
+  push_constant_set(location, comp_len, array_size, data);
+}
+
+void WGPUShader::push_constants_flush()
+{
+  if (push_constants_size_ == 0) {
+    return;
+  }
+  WGPUContext *ctx = static_cast<WGPUContext *>(Context::get());
+  if (ctx == nullptr) {
+    return;
+  }
+  wgpu::Device device = ctx->device_get();
+  wgpu::Queue queue = ctx->queue_get();
+  if (!push_constants_buffer_.valid()) {
+    if (!push_constants_buffer_.create_scoped(ctx->instance_get(),
+                                              device,
+                                              webgpu::BufferKind::Uniform,
+                                              webgpu::UsageType::Dynamic,
+                                              push_constants_size_,
+                                              nullptr,
+                                              false))
+    {
+      return;
+    }
+    push_constants_dirty_ = true;
+  }
+  push_constants_buffer_.retry_pending_updates();
+  if (push_constants_dirty_) {
+    push_constants_buffer_.update_sub(
+        ctx->instance_get(),
+        device,
+        queue,
+        ctx->queue_scheduler_get(),
+        0,
+        push_constants_data_.data(),
+        push_constants_size_);
+    push_constants_dirty_ = false;
+  }
+}
+
