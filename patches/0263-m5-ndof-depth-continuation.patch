+static wmOperatorStatus ndof_depth_modal_cancel(bContext *C,
+                                                wmOperator *op,
+                                                ViewOpsData *vod,
+                                                const char *message)
+{
+  if (message != nullptr) {
+    BKE_report(op->reports, RPT_ERROR, message);
+  }
+  vod->state_restore();
+  viewops_data_free(C, vod);
+  op->customdata = nullptr;
+  return OPERATOR_CANCELLED;
+}
+
+static wmOperatorStatus ndof_replay_owned_event(bContext *C,
+                                                wmOperator *op,
+                                                ViewOpsData *vod,
+                                                const wmEvent &owned_event,
+                                                wmNDOFMotionData &owned_motion)
+{
+  wmEvent event = owned_event;
+  event.next = nullptr;
+  event.prev = nullptr;
+  event.custom = EVT_DATA_NDOF_MOTION;
+  event.customdata = &owned_motion;
+  event.customdata_free = false;
+  return vod->nav_type->init_fn(C, vod, &event, op->ptr);
+}
+
+static wmOperatorStatus ndof_replay_queued_event(bContext *C,
+                                                 wmOperator *op,
+                                                 ViewOpsData *vod,
+                                                 const NdofQueuedMotion &queued)
+{
+  wmEvent event = queued.event;
+  wmNDOFMotionData motion = queued.motion;
+  event.next = nullptr;
+  event.prev = nullptr;
+  event.custom = EVT_DATA_NDOF_MOTION;
+  event.customdata = &motion;
+  event.customdata_free = false;
+
+  const ViewOpsType *nav_type = vod->nav_type;
+  vod->init_context(C);
+  const ViewOpsDataInitResult init_result = vod->init_navigation(
+      C, &event, nav_type, nullptr, false, false);
+  if (init_result != ViewOpsDataInitResult::Ready) {
+    return OPERATOR_CANCELLED;
+  }
+  ED_view3d_smooth_view_force_finish(C, vod->v3d, vod->region);
+  return nav_type->init_fn(C, vod, &event, op->ptr);
+}
+
+wmOperatorStatus view3d_ndof_depth_modal(bContext *C,
+                                         wmOperator *op,
+                                         const wmEvent *event)
+{
+  ViewOpsData *vod = static_cast<ViewOpsData *>(op->customdata);
+  if (!view3d_ndof_depth_is_pending(vod)) {
+    return OPERATOR_CANCELLED;
+  }
+  NdofDepthRead *read = vod->ndof_depth_read;
+
+  if (!ndof_depth_context_matches(C, vod, read)) {
+    return ndof_depth_modal_cancel(C, op, vod, "View changed while waiting for NDOF depth");
+  }
+  if (event->type == EVT_ESCKEY && event->val == KM_PRESS) {
+    return ndof_depth_modal_cancel(C, op, vod, nullptr);
+  }
+
+  if (event->type == NDOF_MOTION) {
+    if (event->customdata == nullptr || event->custom != EVT_DATA_NDOF_MOTION) {
+      return ndof_depth_modal_cancel(C, op, vod, "Invalid queued NDOF motion payload");
+    }
+    constexpr int max_queued_motions = 256;
+    if (read->queued_motions.size() >= max_queued_motions) {
+      return ndof_depth_modal_cancel(C, op, vod, "Too many queued NDOF motions");
+    }
+    read->queued_motions.append(ndof_motion_copy(*event));
+    return OPERATOR_RUNNING_MODAL;
+  }
+
+  if (event->type != TIMER || event->customdata != read->timer) {
+    return OPERATOR_RUNNING_MODAL | OPERATOR_PASS_THROUGH;
+  }
+
+  /* Roughly 2.4 seconds at 10 ms. A lost completion must not move the view late. */
+  constexpr int max_tick_count = 240;
+  if (++read->tick_count > max_tick_count) {
+    BKE_report(op->reports, RPT_ERROR, "Timed out waiting for NDOF depth");
+    return ndof_depth_modal_cancel(C, op, vod, nullptr);
+  }
+
+  const eGPUReadbackStatus status = ndof_depth_read_status(read);
+  if (status == GPU_READBACK_PENDING) {
+    return OPERATOR_RUNNING_MODAL;
+  }
+  if (status != GPU_READBACK_READY) {
+    BKE_report(op->reports, RPT_ERROR, "NDOF depth readback failed");
+    return ndof_depth_modal_cancel(C, op, vod, nullptr);
+  }
+
+  std::optional<float3> min_depth_point;
+  if (!ndof_depth_read_consume(read, min_depth_point)) {
+    BKE_report(op->reports, RPT_ERROR, "NDOF depth readback failed");
+    return ndof_depth_modal_cancel(C, op, vod, nullptr);
+  }
+  read->min_depth_point = min_depth_point;
+  read->resolved = true;
+
+  wmEvent invoke_event = read->invoke_event;
+  wmNDOFMotionData invoke_motion = read->invoke_motion;
+  Vector<NdofQueuedMotion> queued_motions = std::move(read->queued_motions);
+  if (read->timer != nullptr) {
+    WM_event_timer_remove(CTX_wm_manager(C), read->window, read->timer);
+    read->timer = nullptr;
+  }
+
+  wmOperatorStatus result = ndof_replay_owned_event(C, op, vod, invoke_event, invoke_motion);
+  if (result == OPERATOR_RUNNING_MODAL) {
+    return ndof_depth_modal_cancel(C, op, vod, "NDOF depth replay remained pending");
+  }
+  vod->end_navigation(C);
+
+  for (int index = 0; index < queued_motions.size(); index++) {
+    result = ndof_replay_queued_event(C, op, vod, queued_motions[index]);
+    if (result == OPERATOR_RUNNING_MODAL) {
+      NdofDepthRead *next_read = vod->ndof_depth_read;
+      if (next_read == nullptr) {
+        return ndof_depth_modal_cancel(C, op, vod, "NDOF replay lost its pending request");
+      }
+      for (int remaining = index + 1; remaining < queued_motions.size(); remaining++) {
+        next_read->queued_motions.append(std::move(queued_motions[remaining]));
+      }
+      return OPERATOR_RUNNING_MODAL;
+    }
+    vod->end_navigation(C);
+  }
+
+  viewops_data_free(C, vod);
+  op->customdata = nullptr;
+  return OPERATOR_FINISHED;
+}
