+inline void queue_write_buffer_scoped(const InstanceT &instance,
+                                      const DeviceT &device,
+                                      const QueueT &queue,
+                                      OrderedQueueScheduler &scheduler,
+                                      BufferT buffer,
+                                      const uint64_t offset,
+                                      const void *data,
+                                      const size_t size,
+                                      const char *label,
+                                      CompleteFn &&complete)
