+static void test_texture_1d_array_webgpu_sample_fetch_size_and_storage()
+{
+  using namespace shader;
+  GPU_render_begin();
+  constexpr int width = 4;
+  constexpr int layers = 3;
+
+  Vector<float4> float_data(width * layers);
+  Vector<uint> uint_data(width * layers);
+  Vector<int> int_data(width * layers);
+  for (int layer = 0; layer < layers; layer++) {
+    const float values[width] = {0.0f, 0.2f, 0.8f, 1.0f};
+    for (int x = 0; x < width; x++) {
+      float_data[layer * width + x] = float4(values[x]);
+      uint_data[layer * width + x] = uint(8 + x + layer);
+      int_data[layer * width + x] = 20 + x + 2 * layer;
+    }
+  }
+  gpu::Texture *float_tex = GPU_texture_create_1d_array(__func__,
+                                                        width,
+                                                        layers,
+                                                        1,
+                                                        TextureFormat::SFLOAT_16_16_16_16,
+                                                        GPU_TEXTURE_USAGE_SHADER_READ,
+                                                        reinterpret_cast<const float *>(
+                                                            float_data.data()));
+  gpu::Texture *uint_tex = GPU_texture_create_1d_array(__func__,
+                                                       width,
+                                                       layers,
+                                                       1,
+                                                       TextureFormat::UINT_32,
+                                                       GPU_TEXTURE_USAGE_SHADER_READ,
+                                                       nullptr);
+  gpu::Texture *out_tex = GPU_texture_create_1d_array(__func__,
+                                                      width,
+                                                      layers,
+                                                      1,
+                                                      TextureFormat::UINT_32,
+                                                      GPU_TEXTURE_USAGE_SHADER_WRITE |
+                                                          GPU_TEXTURE_USAGE_HOST_READ,
+                                                      nullptr);
+  gpu::Texture *int_tex = GPU_texture_create_1d_array(__func__,
+                                                       width,
+                                                       layers,
+                                                       1,
+                                                       TextureFormat::SINT_32,
+                                                       GPU_TEXTURE_USAGE_SHADER_READ,
+                                                       nullptr);
+  ASSERT_NE(float_tex, nullptr);
+  ASSERT_NE(uint_tex, nullptr);
+  ASSERT_NE(out_tex, nullptr);
+  ASSERT_NE(int_tex, nullptr);
+  GPU_texture_update(uint_tex, GPU_DATA_UINT, uint_data.data());
+  GPU_texture_update(int_tex, GPU_DATA_INT, int_data.data());
+  GPU_texture_filter_mode(float_tex, true);
+
+  ShaderCreateInfo info("pyGPU_Shader");
+  info.sampler(0, ImageType::Float1DArray, "float_map");
+  info.sampler(1, ImageType::Uint1DArray, "uint_map");
+  info.sampler(2, ImageType::Int1DArray, "int_map");
+  info.image(3,
+             TextureFormat::UINT_32,
+             Qualifier::write,
+             ImageReadWriteType::Uint1DArray,
+             "out_img");
+  info.local_group_size(1, 1, 1);
+  info.compute_source_generated =
+      "void main() {\n"
+      "  int layer = int(gl_GlobalInvocationID.x);\n"
+      "  float filtered = textureLod(float_map, vec2(0.5, float(layer)), 0.0).x;\n"
+      "  uint fetched = texelFetch(uint_map, ivec2(2, layer), 0).x;\n"
+      "  uint nearest_u = texture(uint_map, vec2(0.625, float(layer) + 0.49)).x;\n"
+      "  uint lod_u = textureLod(uint_map, vec2(0.125, float(layer) + 0.51), 0.0).x;\n"
+      "  uint offset_u = textureOffset(uint_map, vec2(0.125, float(layer)), 1).x;\n"
+      "  uint lod_offset_u = "
+      "textureLodOffset(uint_map, vec2(0.125, float(layer)), 0.0, 2).x;\n"
+      "  uint grad_u = textureGrad(uint_map, vec2(0.875, float(layer)), 0.25, 0.25).x;\n"
+      "  uint grad_offset_u = "
+      "textureGradOffset(uint_map, vec2(0.125, float(layer)), 0.25, 0.25, 3).x;\n"
+      "  int nearest_i = texture(int_map, vec2(0.375, float(layer) + 0.49)).x;\n"
+      "  int lod_i = textureLod(int_map, vec2(0.875, float(layer) - 0.51), 0.0).x;\n"
+      "  int offset_i = textureOffset(int_map, vec2(0.125, float(layer)), 1).x;\n"
+      "  int grad_offset_i = "
+      "textureGradOffset(int_map, vec2(0.125, float(layer)), 0.25, 0.25, 2).x;\n"
+      "  ivec2 size = textureSize(uint_map, 0);\n"
+      "  uint result = uint(round(filtered * 100.0)) + fetched + nearest_u + lod_u +\n"
+      "                offset_u + lod_offset_u + grad_u + grad_offset_u +\n"
+      "                uint(nearest_i + lod_i + offset_i + grad_offset_i +\n"
+      "                     size.x + size.y);\n"
+      "  imageStore(out_img, ivec2(0, layer), uvec4(result));\n"
+      "  imageStore(out_img, ivec2(1, layer), uvec4(uint(round(filtered * 100.0))));\n"
+      "}\n";
+  gpu::Shader *shader = GPU_shader_create_from_info_python(
+      reinterpret_cast<GPUShaderCreateInfo *>(&info));
+  ASSERT_NE(shader, nullptr);
+  GPU_shader_bind(shader);
+  GPU_texture_bind(float_tex, GPU_shader_get_sampler_binding(shader, "float_map"));
+  GPU_texture_bind(uint_tex, GPU_shader_get_sampler_binding(shader, "uint_map"));
+  GPU_texture_bind(int_tex, GPU_shader_get_sampler_binding(shader, "int_map"));
+  GPU_texture_image_bind(out_tex, GPU_shader_get_sampler_binding(shader, "out_img"));
+  GPU_compute_dispatch(shader, layers, 1, 1);
+  GPU_memory_barrier(GPU_BARRIER_TEXTURE_UPDATE | GPU_BARRIER_SHADER_IMAGE_ACCESS);
+
+  uint *out = static_cast<uint *>(GPU_texture_read(out_tex, GPU_DATA_UINT, 0));
+  ASSERT_NE(out, nullptr);
+  for (int layer = 0; layer < layers; layer++) {
+    const int next_layer = std::min(layer + 1, layers - 1);
+    const int previous_layer = std::max(layer - 1, 0);
+    const uint expected = uint((67 + layer) + (10 + layer) + (8 + next_layer) +
+                               (21 + 2 * layer) + (23 + 2 * previous_layer) +
+                               (41 + 4 * layer) + (43 + 4 * layer));
+    EXPECT_EQ(out[layer * width], expected);
+    EXPECT_EQ(out[layer * width + 1], 50u);
+  }
+  MEM_delete(out);
+
+  GPU_shader_unbind();
+  GPU_texture_unbind(float_tex);
+  GPU_texture_unbind(uint_tex);
+  GPU_texture_unbind(int_tex);
+  GPU_texture_image_unbind(out_tex);
+  GPU_texture_free(int_tex);
+  GPU_texture_free(out_tex);
+  GPU_texture_free(uint_tex);
+  GPU_texture_free(float_tex);
+  GPU_shader_free(shader);
+  GPU_render_end();
+}
