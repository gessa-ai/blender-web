+bool render_attachment_supported(F f, const RenderAttachmentFeatures &features)
+{
+  switch (f) {
+    /* Either feature exposes the 16-bit normalized formats as render targets.
+     * TextureFormatsTier1 also adds the renderable 8-bit signed-normalized set. */
+    case F::R16Unorm:
+    case F::RG16Unorm:
+    case F::RGBA16Unorm:
+      return features.unorm16_texture_formats || features.texture_formats_tier1;
+    case F::R8Snorm:
+    case F::RG8Snorm:
+    case F::RGBA8Snorm:
+      return features.texture_formats_tier1;
+    case F::RG11B10Ufloat:
+      return features.rg11b10_ufloat_renderable;
+    case F::Depth32FloatStencil8:
+      return features.depth32_float_stencil8;
+    default:
+      return caps_of(f).renderable;
+  }
+}
